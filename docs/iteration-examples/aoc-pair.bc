-- T6c (Advent of Code 2020, day 1): the product of the two entries that sum to 2020. Nested
-- loops with an exit across both. Candidate D's style today: two nested counted loops, each
-- carrying the answer found so far to the end of its count (no early exit). The steps are `!`
-- closures that capture nothing, so the view, the outer entry and the answer are all state.
-- Total.
include slice

fn entry(i: i32) -> i32 =
  if i == 0 { 1721 } else { if i == 1 { 979 } else { if i == 2 { 366 } else {
  if i == 3 { 299 } else { if i == 4 { 675 } else { 1456 } } } } }

total fn solve() -> i32 =
  let a = array_new[i32] (6, entry);
  let r = borrow imm a { 'x, v ->
    let (v, w) = array_copy['x, i32](v);
    let n = len(w);
    let (_, (_, found)) = count_fold[array_imm 'x i32 * (i32 * (i32 + 1))] (!{ (i, (v, (n, found))) ->
        match found {
          inl p -> (v, (n, inl p))
        | inr u ->
            let (v, w) = array_copy['x, i32](v);
            let xi = at(w, i, 0);
            let (v, (_, (_, f))) = count_fold[array_imm 'x i32 * (i32 * (i32 * (i32 + 1)))] (!{ (j, (v, (i, (xi, f)))) ->
                match f {
                  inl p -> (v, (i, (xi, inl p)))
                | inr u ->
                    let (v, w) = array_copy['x, i32](v);
                    let xj = at(w, j, 0);
                    if i < j && xi + xj == 2020 { (v, (i, (xi, inl (xi * xj)))) } else { (v, (i, (xi, inr u))) }
                } }, n, 0, (v, (i, (xi, inr ()))));
            (v, (n, f))
        } }, n, 0, (v, (n, inr ())));
    match found { inl p -> p | inr u -> 0 } };
  r

main -> i32 = solve()
