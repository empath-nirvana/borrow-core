-- AWFY DeltaBlue, arena form: the incremental planner (incrementalAdd, satisfy, chooseMethod,
-- addPropagate, makePlan, extractPlanFromConstraints) and AWFY's `chainTest(n)`.
--
-- The cyclic graph: a variable lists its constraints and a constraint names its variables, and
-- each variable's `determinedBy` names a constraint. All of them are integer handles:
--   variables `va : array i32`, five fields at 5*(v+1): value, determinedBy, mark, walkStrength,
--     stay; va[0] is the planner's currentMark;
--   constraints `ca : array i32`, five fields at 5*c: kind (0 stay, 1 edit, 2 equality),
--     strength, v1 (the output of a unary one), v2, direction (0 NONE / unsatisfied,
--     1 FORWARD / satisfied, 2 BACKWARD);
--   each variable's constraint list, `vc : array (buf i32)`, a growable buffer per variable.
-- Strengths are AWFY's arithmetic values: REQUIRED 0 … WEAKEST 6; `stronger(a, b)` is `a < b`.
-- Answer: the number of plan executions whose last variable came out right (100), and the plan's
-- length (n + 1).

include slice
include buf

type G = array i32 * (array i32 * array (buf i32))

fn g(a: array i32, i: i32) -> array i32 * i32 = let mut a = a; let x = at(&a, i, 0); (a, x)

fn vg(s: G, v: i32, f: i32) -> G * i32 = let (va, r) = s; let (va, x) = g(va, 5 * (v + 1) + f); ((va, r), x)
fn vs(s: G, v: i32, f: i32, x: i32) -> G = let (va, r) = s; (array_set(va, 5 * (v + 1) + f, x), r)
fn cg(s: G, c: i32, f: i32) -> G * i32 =
  let (va, (ca, vc)) = s; let (ca, x) = g(ca, 5 * c + f); ((va, (ca, vc)), x)
fn cs(s: G, c: i32, f: i32, x: i32) -> G = let (va, (ca, vc)) = s; (va, (array_set(ca, 5 * c + f, x), vc))

fn bget(b: buf i32, i: i32) -> buf i32 * i32 = let (a, n) = b; let (a, x) = g(a, i); ((a, n), x)

fn new_mark(s: G) -> G * i32 =
  let (va, r) = s; let (va, m) = g(va, 0); ((array_set(va, 0, m + 1), r), m + 1)

fn weakest(a: i32, b: i32) -> i32 = if a > b { a } else { b }

fn c_output(s: G, c: i32) -> G * i32 =
  let (s, k) = cg(s, c, 0);
  let (s, d) = cg(s, c, 4);
  if k == 2 && d == 1 { cg(s, c, 3) } else { cg(s, c, 2) }

fn c_input(s: G, c: i32) -> G * i32 =
  let (s, d) = cg(s, c, 4);
  if d == 1 { cg(s, c, 2) } else { cg(s, c, 3) }

fn choose_method(s: G, c: i32, mark: i32) -> G =
  let (s, k) = cg(s, c, 0);
  let (s, st) = cg(s, c, 1);
  let (s, v1) = cg(s, c, 2);
  let (s, m1) = vg(s, v1, 2);
  let (s, w1) = vg(s, v1, 3);
  if k < 2 {
    let d = if m1 != mark && st < w1 { 1 } else { 0 };
    cs(s, c, 4, d)
  } else {
    let (s, v2) = cg(s, c, 3);
    let (s, m2) = vg(s, v2, 2);
    let (s, w2) = vg(s, v2, 3);
    let d0 = 0;
    let d1 = if m1 == mark { if m2 != mark && st < w2 { 1 } else { 0 } } else { d0 };
    let d2 = if m2 == mark { if m1 != mark && st < w1 { 2 } else { 0 } } else { d1 };
    let d3 = if w1 > w2 { if st < w1 { 2 } else { 0 } } else { if st < w2 { 1 } else { 2 } };
    cs(s, c, 4, d3)
  }

-- Every satisfied constraint on `v` other than the one that determines it, onto `todo`.
fn add_consuming(s: G, v: i32, todo: buf i32) -> G * buf i32 =
  let (s, det) = vg(s, v, 1);
  let (va, (ca, vc)) = s;
  let (vc, o) = array_replace[buf i32](vc, v, filler[buf i32]);
  let l = match o { inl l -> l | inr l -> l };
  let (la, ln) = l;
  let mut la = la;
  let mut ca = ca;
  let mut todo = todo;
  for j in 0..ln {
    let c = at(&la, j, 0);
    let d = at(&ca, 5 * c + 4, 0);
    if c != det && d != 0 { let (t, _) = push(todo, c); todo = t } else { () }
  };
  let (vc, _) = array_replace[buf i32](vc, v, (la, ln));
  ((va, (ca, vc)), todo)

fn recalculate(s: G, c: i32) -> G =
  let (s, k) = cg(s, c, 0);
  let (s, st) = cg(s, c, 1);
  let (s, out) = c_output(s, c);
  if k < 2 {
    let s = vs(s, out, 3, st);
    let y = if k == 0 { 1 } else { 0 };
    vs(s, out, 4, y)
  } else {
    let (s, inp) = c_input(s, c);
    let (s, iw) = vg(s, inp, 3);
    let (s, istay) = vg(s, inp, 4);
    let s = vs(s, out, 3, weakest(st, iw));
    let s = vs(s, out, 4, istay);
    if istay == 1 { let (s, x) = vg(s, inp, 0); vs(s, out, 0, x) } else { s }
  }

-- Whether the walk from `c` reaches no variable marked `mark` (no cycle).
fn add_propagate(s: G, c: i32, mark: i32) -> G * bool =
  let (todo, _) = push(box buf[i32](8), c);
  let mut todo = todo;
  let mut s = s;
  let mut head = 0;
  let mut ok = true;
  for i in 0..1000000 {
    let (t, n) = len_of(todo);
    todo = t;
    if head >= n { break } else { () };
    let (t, d) = bget(todo, head);
    todo = t;
    head = head + 1;
    let (s1, out) = c_output(s, d);
    let (s1, m) = vg(s1, out, 2);
    s = s1;
    if m == mark { ok = false; break } else { () };
    let s2 = recalculate(s, d);
    let (s3, t) = add_consuming(s2, out, todo);
    s = s3;
    todo = t
  };
  (s, ok)

-- The constraint it overrides, or -1.
fn satisfy(s: G, c: i32, mark: i32) -> G * i32 =
  let s = choose_method(s, c, mark);
  let (s, d) = cg(s, c, 4);
  if d == 0 { (s, 0 - 1) } else {
    let (s, k) = cg(s, c, 0);
    let s = if k == 2 { let (s, i) = c_input(s, c); vs(s, i, 2, mark) } else { s };
    let (s, out) = c_output(s, c);
    let (s, ov) = vg(s, out, 1);
    let s = if ov >= 0 { cs(s, ov, 4, 0) } else { s };
    let s = vs(s, out, 1, c);
    let (s, ok) = add_propagate(s, c, mark);
    (vs(s, out, 2, mark), ov)
  }

fn incremental_add(s: G, c: i32) -> G =
  let (s, mark) = new_mark(s);
  let (s, ov) = satisfy(s, c, mark);
  let mut s = s;
  let mut ov = ov;
  for i in 0..1000000 {
    if ov < 0 { break } else { () };
    let (s1, o) = satisfy(s, ov, mark);
    s = s1;
    ov = o
  };
  s

fn attach(s: G, v: i32, c: i32) -> G =
  let (va, (ca, vc)) = s;
  let (vc, o) = array_replace[buf i32](vc, v, filler[buf i32]);
  let l = match o { inl l -> l | inr l -> l };
  let (l, _) = push(l, c);
  let (vc, _) = array_replace[buf i32](vc, v, l);
  (va, (ca, vc))

fn constraint(s: G, c: i32, kind: i32, st: i32, v1: i32, v2: i32) -> G =
  let s = cs(s, c, 0, kind);
  let s = cs(s, c, 1, st);
  let s = cs(s, c, 2, v1);
  let s = cs(s, c, 3, v2);
  let s = cs(s, c, 4, 0);
  let s = attach(s, v1, c);
  let s = if kind == 2 { attach(s, v2, c) } else { s };
  incremental_add(s, c)

fn inputs_known(s: G, c: i32, mark: i32) -> G * bool =
  let (s, k) = cg(s, c, 0);
  if k < 2 { (s, true) } else {
    let (s, i) = c_input(s, c);
    let (s, m) = vg(s, i, 2);
    let (s, st) = vg(s, i, 4);
    let (s, det) = vg(s, i, 1);
    (s, m == mark || st == 1 || det < 0)
  }

fn make_plan(s: G, todo: buf i32) -> G * buf i32 =
  let (s, mark) = new_mark(s);
  let mut s = s;
  let mut todo = todo;
  let mut plan = box buf[i32](8);
  let mut head = 0;
  for i in 0..1000000 {
    let (t, n) = len_of(todo);
    todo = t;
    if head >= n { break } else { () };
    let (t, c) = bget(todo, head);
    todo = t;
    head = head + 1;
    let (s1, out) = c_output(s, c);
    let (s1, m) = vg(s1, out, 2);
    let (s1, known) = inputs_known(s1, c, mark);
    s = s1;
    if m != mark && known {
      let (p, _) = push(plan, c);
      plan = p;
      let s2 = vs(s, out, 2, mark);
      let (s3, t) = add_consuming(s2, out, todo);
      s = s3;
      todo = t
    } else { () }
  };
  (s, plan)

fn execute(s: G, plan: buf i32) -> G * buf i32 =
  let (pa, pn) = plan;
  let mut pa = pa;
  let mut s = s;
  for j in 0..pn {
    let c = at(&pa, j, 0);
    let (s1, k) = cg(s, c, 0);
    s = s1;
    if k == 2 {
      let (s1, i) = c_input(s, c);
      let (s1, o) = c_output(s1, c);
      let (s1, x) = vg(s1, i, 0);
      s = vs(s1, o, 0, x)
    } else { () }
  };
  (s, (pa, pn))

fn chain_test(n: i32) -> i32 * i32 =
  let va = array_new[i32](5 * (n + 2), !{ i -> 0 });
  let ca = array_new[i32](5 * (n + 2), !{ i -> 0 });
  let vc = array_new[buf i32](n + 1, !{ i -> box buf[i32](2) });
  let mut s = (va, (ca, vc));
  for v in 0..n + 1 {
    let s1 = vs(s, v, 1, 0 - 1);
    s = vs(s1, v, 3, 6)
  };
  for i in 0..n { s = constraint(s, i, 2, 0, i, i + 1) };
  let s = constraint(s, n, 0, 3, n, 0);
  let edit = n + 1;
  let s = constraint(s, edit, 1, 2, 0, 0);
  let (s, d) = cg(s, edit, 4);
  let (src, _) = push(box buf[i32](8), edit);
  let src = if d != 0 { src } else { box buf[i32](8) };
  let (s, plan) = make_plan(s, src);
  let mut s = s;
  let mut plan = plan;
  let mut good = 0;
  for i in 0..100 {
    let s1 = vs(s, 0, 0, i);
    let (s1, p) = execute(s1, plan);
    plan = p;
    let (s1, x) = vg(s1, n, 0);
    s = s1;
    if x == i { good = good + 1 } else { () }
  };
  let (plan, len) = len_of(plan);
  (good, len)

main -> i32 * i32 = chain_test(100)
