-- AWFY Permute as written: the recursion inside a counted `for` that threads the array.
include rec
include buf
include slice
fn swp(v: array i32, i: i32, j: i32) -> array i32 =
  let mut v = v;
  let a = at(&v, i, 0);
  let b = at(&v, j, 0);
  array_set(array_set(v, i, b), j, a)
fn permute(v: array i32, n: i32, count: i32) -> array i32 * i32 with Exhausted =
  let count = count + 1;
  if n == 0 { (v, count) } else {
    let n1 = n - 1;
    let (v, c) = permute(v, n1, count);
    let mut v = v;
    let mut c = c;
    for k in 0..n {
      let i = n1 - k;
      let (v2, c2) = permute(swp(v, n1, i), n1, c);
      v = swp(v2, n1, i);
      c = c2
    };
    (v, c)
  }
main -> i32 = with on_exhausted(!{ u -> 0 - 1 }) {
  let (v, c) = permute(array_new[i32](6, !{ i -> 0 }), 6, 0); c }
