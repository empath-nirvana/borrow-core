-- AWFY Richards, owned-packet form. Task control blocks stay in an i32 arena `t` (stride 10:
-- link, id, pri, -, packetPending, taskWaiting, taskHolding, kind, data1, data2; globals at 60..).
-- Packets are owned values, `id * (kind * (datum * data))`, and each queue is an owned
-- `mu X. 1 + (Pkt * X)`: a packet is in exactly one queue at a time, so it is moved, never shared.
-- The queues live in `qs : array Q`, three per task: 3*id the input queue, 3*id+1 the handler's
-- workIn (and the device's pending packet), 3*id+2 the handler's deviceIn.
-- Answer: (queuePacketCount, holdCount) = (23246, 9297).

include slice
include buf
include rec

type Pkt = i32 * (i32 * (i32 * array i32))
type Q = mu X. 1 + (Pkt * X)
type S = array i32 * array Q

fn g(a: array i32, i: i32) -> array i32 * i32 = let mut a = a; let x = at(&a, i, 0); (a, x)

fn nil() -> Q = roll inl ()

fn add_last(q: Q, k: Pkt) -> Q with Exhausted =
  match unroll q {
    inl u -> roll inr (k, roll inl ())
  | inr (x, rest) -> roll inr (x, add_last(rest, k))
  }

fn take_q(qs: array Q, i: i32) -> array Q * Q =
  let (qs, o) = array_replace[Q](qs, i, nil());
  match o { inl q -> (qs, q) | inr q -> (qs, q) }

fn put_q(qs: array Q, i: i32, q: Q) -> array Q = let (qs, o) = array_replace[Q](qs, i, q); qs

fn task(t: array i32, id: i32, pri: i32, pp: i32, tw: i32, kind: i32, d1: i32, d2: i32) -> array i32 =
  let b = 10 * id;
  let (t, list) = g(t, 60);
  let t = array_set(t, b, list);
  let t = array_set(t, b + 1, id);
  let t = array_set(t, b + 2, pri);
  let t = array_set(t, b + 4, pp);
  let t = array_set(t, b + 5, tw);
  let t = array_set(t, b + 6, 0);
  let t = array_set(t, b + 7, kind);
  let t = array_set(t, b + 8, d1);
  let t = array_set(t, b + 9, d2);
  array_set(t, 60, b)

fn mkpkt(id: i32, kind: i32) -> Pkt = (id, (kind, (0, array_new[i32](4, !{ i -> 0 }))))

fn hold_self(t: array i32) -> array i32 * i32 =
  let (t, hc) = g(t, 64);
  let t = array_set(t, 64, hc + 1);
  let (t, c) = g(t, 61);
  let t = array_set(t, c + 6, 1);
  g(t, c)

fn mark_waiting(t: array i32) -> array i32 * i32 =
  let (t, c) = g(t, 61);
  (array_set(t, c + 5, 1), c)

fn release(t: array i32, id: i32) -> array i32 * i32 =
  let b = 10 * id;
  let t = array_set(t, b + 6, 0);
  let (t, pr) = g(t, b + 2);
  let (t, c) = g(t, 61);
  let (t, cp) = g(t, c + 2);
  if pr > cp { (t, b) } else { (t, c) }

fn queue_packet(s: S, k: Pkt) -> S * i32 with Exhausted =
  let (t, qs) = s;
  let (id, rest) = k;
  let (t, n) = g(t, 63);
  let t = array_set(t, 63, n + 1);
  let (t, cid) = g(t, 62);
  let k = (cid, rest);
  let b = 10 * id;
  let (t, c) = g(t, 61);
  let (qs, q) = take_q(qs, 3 * id);
  match unroll q {
    inl u ->
      let qs = put_q(qs, 3 * id, roll inr (k, roll inl ()));
      let t = array_set(t, b + 4, 1);
      let (t, pr) = g(t, b + 2);
      let (t, cp) = g(t, c + 2);
      if pr > cp { ((t, qs), b) } else { ((t, qs), c) }
  | inr p -> ((t, put_q(qs, 3 * id, add_last((roll inr p : Q), k))), c)
  }

fn idler(t: array i32, b: i32) -> array i32 * i32 =
  let (t, count) = g(t, b + 9);
  let t = array_set(t, b + 9, count - 1);
  if count - 1 == 0 { hold_self(t) } else {
    let (t, control) = g(t, b + 8);
    if control % 2 == 0 {
      let t = array_set(t, b + 8, control / 2);
      release(t, 4)
    } else {
      let t = array_set(t, b + 8, host[xor32](control / 2, 53256));
      release(t, 5)
    }
  }

fn worker(s: S, b: i32, w: 1 + Pkt) -> S * i32 with Exhausted =
  let (t, qs) = s;
  match w {
    inl u -> let (t, n) = mark_waiting(t); ((t, qs), n)
  | inr k ->
    let (id, (kind, (datum, data))) = k;
    let (t, dst) = g(t, b + 8);
    let d = if dst == 2 { 3 } else { 2 };
    let t = array_set(t, b + 8, d);
    let mut t = t;
    let mut data = data;
    for i in 0..4 {
      let (t1, c) = g(t, b + 9);
      let c1 = if c + 1 > 26 { 1 } else { c + 1 };
      t = array_set(t1, b + 9, c1);
      data = array_set(data, i, c1)
    };
    queue_packet((t, qs), (d, (kind, (0, data))))
  }

fn handler_t(s: S, b: i32, w: 1 + Pkt) -> S * i32 with Exhausted =
  let (t, qs) = s;
  let (t, id) = g(t, b + 1);
  let qs = match w {
    inl u -> qs
  | inr k ->
      let (pid, (kind, rest)) = k;
      let slot = if kind == 1 { 3 * id + 1 } else { 3 * id + 2 };
      let (qs, q) = take_q(qs, slot);
      put_q(qs, slot, add_last(q, (pid, (kind, rest))))
  };
  let (qs, q) = take_q(qs, 3 * id + 1);
  match unroll q {
    inl u -> let qs = put_q(qs, 3 * id + 1, roll inl ()); let (t, n) = mark_waiting(t); ((t, qs), n)
  | inr (wk, wrest) ->
      let (wid, (wkind, (count, wdata))) = wk;
      if count < 4 {
        let (qs, dq) = take_q(qs, 3 * id + 2);
        match unroll dq {
          inl u ->
            let qs = put_q(qs, 3 * id + 2, roll inl ());
            let qs = put_q(qs, 3 * id + 1, roll inr ((wid, (wkind, (count, wdata))), wrest));
            let (t, n) = mark_waiting(t); ((t, qs), n)
        | inr (dv, drest) ->
            let qs = put_q(qs, 3 * id + 2, drest);
            let mut wdata = wdata;
            let x = at(&wdata, count, 0);
            let qs = put_q(qs, 3 * id + 1, roll inr ((wid, (wkind, (count + 1, wdata))), wrest));
            let (did, (dkind, (ddatum, ddata))) = dv;
            queue_packet((t, qs), (did, (dkind, (x, ddata))))
        }
      } else {
        let qs = put_q(qs, 3 * id + 1, wrest);
        queue_packet((t, qs), (wid, (wkind, (count, wdata))))
      }
  }

fn device(s: S, b: i32, w: 1 + Pkt) -> S * i32 with Exhausted =
  let (t, qs) = s;
  let (t, id) = g(t, b + 1);
  match w {
    inl u ->
      let (qs, q) = take_q(qs, 3 * id + 1);
      match unroll q {
        inl u -> let qs = put_q(qs, 3 * id + 1, roll inl ()); let (t, n) = mark_waiting(t); ((t, qs), n)
      | inr (k, rest) -> let qs = put_q(qs, 3 * id + 1, rest); queue_packet((t, qs), k)
      }
  | inr k ->
      let qs = put_q(qs, 3 * id + 1, roll inr (k, roll inl ()));
      let (t, n) = hold_self(t);
      ((t, qs), n)
  }

fn run_task(s: S, b: i32) -> S * i32 with Exhausted =
  let (t, qs) = s;
  let (t, id) = g(t, b + 1);
  let (t, pp) = g(t, b + 4);
  let (t, tw) = g(t, b + 5);
  let (t, th) = g(t, b + 6);
  let (t, qs, msg) = if pp == 1 && tw == 1 && th == 0 {
    let (qs, q) = take_q(qs, 3 * id);
    let (m, rest) = match unroll q { inl u -> ((inl () : 1 + Pkt), (roll inl () : Q)) | inr (x, rest) -> (inr x, rest) };
    let (more, rest) = match unroll rest { inl u -> (false, (roll inl () : Q)) | inr p -> (true, (roll inr p : Q)) };
    let qs = put_q(qs, 3 * id, rest);
    let t = if more { array_set(t, b + 4, 1) } else { array_set(t, b + 4, 0) };
    let t = array_set(t, b + 5, 0);
    let t = array_set(t, b + 6, 0);
    (t, qs, m)
  } else { (t, qs, (inl () : 1 + Pkt)) };
  let (t, kind) = g(t, b + 7);
  if kind == 0 { let (t, n) = idler(t, b); ((t, qs), n) } else {
    if kind == 1 { worker((t, qs), b, msg) } else {
      if kind == 2 { handler_t((t, qs), b, msg) } else { device((t, qs), b, msg) } } }


fn schedule(s: S) -> S =
  let (t, qs) = s;
  let (t, l) = g(t, 60);
  let mut s = (t, qs);
  let mut cur = l;
  while 0 <= cur {
    let (t, qs) = s;
    let (t, pp) = g(t, cur + 4);
    let (t, tw) = g(t, cur + 5);
    let (t, th) = g(t, cur + 6);
    if th == 1 || (pp == 0 && tw == 1) {
      let (t, nx) = g(t, cur);
      s = (t, qs);
      cur = nx
    } else {
      let (t, id) = g(t, cur + 1);
      let t = array_set(t, 62, id);
      let t = array_set(t, 61, cur);
      let (s1, nx) = with on_exhausted(!{ u -> ((array_new[i32](0, !{ i -> 0 }), array_new[Q](0, !{ i -> roll inl () })), 0 - 1) }) { run_task((t, qs), cur) };
      s = s1;
      cur = nx
    }
  };
  s

fn two(a: i32, b: i32) -> Q = roll inr (mkpkt(a, b), roll inr (mkpkt(a, b), roll inl ()))
fn three(a: i32, b: i32) -> Q = roll inr (mkpkt(a, b), roll inr (mkpkt(a, b), roll inr (mkpkt(a, b), roll inl ())))

main -> i32 * i32 =
  let t = array_new[i32](70, !{ i -> 0 - 1 });
  let t = array_set(t, 63, 0);
  let t = array_set(t, 64, 0);
  let qs = array_new[Q](18, !{ i -> roll inl () });
  let t = task(t, 0, 0, 0, 0, 0, 1, 10000);
  let qs = put_q(qs, 3, two(1, 1));
  let t = task(t, 1, 1000, 1, 1, 1, 2, 0);
  let qs = put_q(qs, 6, three(4, 0));
  let t = task(t, 2, 2000, 1, 1, 2, 0 - 1, 0 - 1);
  let qs = put_q(qs, 9, three(5, 0));
  let t = task(t, 3, 3000, 1, 1, 2, 0 - 1, 0 - 1);
  let t = task(t, 4, 4000, 0, 1, 3, 0 - 1, 0);
  let t = task(t, 5, 5000, 0, 1, 3, 0 - 1, 0);
  let (t, qs) = schedule((t, qs));
  let (t, q) = g(t, 63);
  let (t, h) = g(t, 64);
  (q, h)
