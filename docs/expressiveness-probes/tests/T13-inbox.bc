-- T13: async tellers, each holding a `mut` borrow of its account across `await`s.
-- Workaround: the transactions live in the account cell with the balance (the `async-bank-inbox`
-- shape): a borrow block held across `await` may use only its view (R1, SPEC §29), so the body
-- may not read `txs` (T13-txs-outside.bc), nor even the count `n` ("this borrow block's body uses
-- `n`, which is outside it, and performs the operation 1.0, which resumes"), so `n` is in the cell too. Each step takes the next transaction out through the
-- borrow with `modify`.
include async

fn step(s: i32 * List[i32]) -> (i32 * List[i32]) * i32 =
  let (b, txs) = s;
  match unroll txs {
    inl u -> ((b, nil()), 0)
  | inr (t, rest) -> if b + t < 0 { ((b, rest), 1) } else { ((b + t, rest), 0) }
  }

fn teller(acct: i32, txs: List[i32], n: i32) -> i32 * i32 with Async =
  let cell = alloc((n, (acct, txs)));
  let refused = borrow mut cell { a ->
    let n = modify a { s -> let (n, rest) = s; ((n, rest), n) };
    let mut r = 0;
    for _ in 0..n {
      let k = modify a { s -> let (n, rest) = s; let (rest, k) = step(rest); ((n, rest), k) };
      r = r + k;
      await()
    };
    r };
  let (n, (balance, rest)) = free(cell);
  (balance, refused)

main -> List[i32 * i32] =
  let q = queue[i32 * i32]();
  let q = push(q, with spawn { teller(100, cons(50, cons(0 - 20, nil())), 2) });
  let q = push(q, with spawn { teller(50, cons(0 - 30, cons(0 - 40, nil())), 2) });
  run_until_empty(q)
