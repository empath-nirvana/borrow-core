-- Priority queues beyond lib/buf.bc's heap (which orders by an `i32` priority beside a persistent
-- element): (1) a binary min-heap over any element type ordered by its `order` case
-- (lib/key.bc), the elements compared through views, so owned elements (strings) work; (2) the
-- same heap ordered by a comparator closure, for persistent elements.
include textio
include buf
include key

-- How elements `i` and `j` compare by `order`, read in place through views.
fn cmp_at[A](a: array A, i: i32, j: i32) -> array A * i32 =
  let mut a = a;
  let r = borrow imm a { 'x, v ->
    let (v, w) = array_copy['x, A](v);
    match get(v, i) {
      inl gi -> match get(w, j) {
          inl gj -> borrow imm *gi { 'y, xi -> borrow imm *gj { 'z, xj -> order[A](xi, xj) } }
        | inr u -> forget_imm['x, A](gi); 0 }
    | inr u -> array_forget['x, A](w); 0
    } };
  (a, r)

fn swap_slots[A](a: array A, i: i32, j: i32) -> array A =
  let mut a = a;
  borrow mut a { v -> discard_mut(swap_at(v, i, j)) };
  a

fn heap_up[A](a: array A, k: i32) -> array A =
  let mut a = a;
  let mut i = k;
  for _ in 0..32 {
    if i == 0 { break } else { () };
    let p = host[shr_u32](i - 1, 1);
    let (b, c) = cmp_at(a, i, p);
    if c < 0 { a = swap_slots(b, i, p); i = p } else { a = b; break }
  };
  a

fn heap_down[A](a: array A, m: i32) -> array A =
  let mut a = a;
  let mut i = 0;
  for _ in 0..32 {
    let l = 2 * i + 1;
    let r = l + 1;
    if m <= l { break } else { () };
    let (b, c) = if r < m { cmp_at(a, r, l) } else { (a, 1) };
    let s = if c < 0 { r } else { l };
    let (b, d) = cmp_at(b, s, i);
    if d < 0 { a = swap_slots(b, i, s); i = s } else { a = b; break }
  };
  a

fn pq_push[A](h: buf A, x: A) -> buf A =
  let (h, _) = push(h, x);
  let (a, n) = h;
  (heap_up(a, n - 1), n)

-- The least element taken out.
fn pq_pop[A](h: buf A) -> buf A * (A + 1) =
  let (a, n) = h;
  if n == 0 { ((a, n), inr ()) } else {
    let a = swap_slots(a, 0, n - 1);
    let (a, o) = array_replace[A] (a, n - 1, filler[A]);
    let a = heap_down(a, n - 1);
    match o { inl x -> ((a, n - 1), inl x) | inr x -> ((a, n - 1), inr ()) }
  }

-- ### By a comparator, for persistent elements

fn pqc_push[A](h: buf A, x: A, c: !(A * A => i32)) -> buf A =
  let (h, _) = push(h, x);
  let (a, n) = h;
  let mut a = a;
  let mut i = n - 1;
  for _ in 0..32 {
    if i == 0 { break } else { () };
    let p = host[shr_u32](i - 1, 1);
    let xi = at(&a, i, filler[A]);
    let xp = at(&a, p, filler[A]);
    if c(xi, xp) < 0 { a = swap_slots(a, i, p); i = p } else { break }
  };
  (a, n)

fn pqc_pop[A](h: buf A, c: !(A * A => i32)) -> buf A * (A + 1) =
  let (a, n) = h;
  if n == 0 { ((a, n), inr ()) } else {
    let least = at(&a, 0, filler[A]);
    let a = swap_slots(a, 0, n - 1);
    let mut a = a;
    let m = n - 1;
    let mut i = 0;
    for _ in 0..32 {
      let l = 2 * i + 1;
      let r = l + 1;
      if m <= l { break } else { () };
      let xl = at(&a, l, filler[A]);
      let xr = at(&a, r, filler[A]);
      let xi = at(&a, i, filler[A]);
      let s = if r < m && c(xr, xl) < 0 { r } else { l };
      let xs = if s == r { xr } else { xl };
      if c(xs, xi) < 0 { a = swap_slots(a, i, s); i = s } else { break }
    };
    ((a, m), inl least)
  }

-- Pairs, largest second field first.
fn by_second_desc(x: i32 * i32, y: i32 * i32) -> i32 =
  let (a1, a2) = x;
  let (b1, b2) = y;
  if b2 < a2 { 0 - 1 } else { if a2 < b2 { 1 } else { 0 } }

main -> i32 =
  -- owned strings by `order`
  let mut h = box buf[string](4);
  h = pq_push(h, string_of_lit("pear"));
  h = pq_push(h, string_of_lit("apple"));
  h = pq_push(h, string_of_lit("zucchini"));
  h = pq_push(h, string_of_lit("fig"));
  for _ in 0..4 {
    let (h2, o) = pq_pop(h);
    h = h2;
    match o { inl s -> let s = print_string(s); print_byte(b' ') | inr u -> () }
  };
  print_byte(b'\n');
  -- integers by `order`, 1000 of them, checked ascending
  let mut g = box buf[i32](4);
  let mut x = 7;
  for i in 0..1000 { x = host[and32](host[add32](host[mul32](x, 1103515245), 12345), 2147483647); g = pq_push(g, host[shr_u32](x, 16)) };
  let mut last = 0 - 1;
  let mut bad = 0;
  for _ in 0..1000 {
    let (g2, o) = pq_pop(g);
    g = g2;
    match o { inl v -> if v < last { bad = bad + 1 } else { () }; last = v | inr u -> bad = bad + 1 }
  };
  print_dec(bad); print_byte(b'\n');
  -- pairs by a comparator closure
  let mut q = box buf[i32 * i32](4);
  for i in 0..10 { q = pqc_push(q, (i, host[and32](i * 7, 7)), !{ (a, b) -> by_second_desc(a, b) }) };
  for _ in 0..4 {
    let (q2, o) = pqc_pop(q, !{ (a, b) -> by_second_desc(a, b) });
    q = q2;
    match o { inl (a, b) -> print_dec(a); print_byte(b'/'); print_dec(b); print_byte(b' ') | inr u -> () }
  };
  print_byte(b'\n');
  0
