-- A B-tree in the natural shape: a node owns a buffer of keys and a buffer of its children.
include textio
include rec

type BT = mu X. buf i32 * buf (1 + X)

fn bt_leaf() -> BT = roll (box buf[i32](4), box buf[1 + BT](4))

-- The number of keys.
fn size(t: BT) -> i32 =
  let (ks, cs) = unroll t;
  let (ks, n) = len_of(ks);
  let (cs, m) = len_of(cs);
  let mut cs = cs;
  let mut s = n;
  for i in 0..m {
    let (c2, o) = take(cs, i);
    cs = c2;
    match o { inl oc -> match oc { inl u -> () | inr c -> s = s + size(c) } | inr u -> () }
  };
  s

main -> i32 =
  let t = bt_leaf();
  let s = with on_exhausted(!{ u -> 0 - 1 }) { size(t) };
  print_dec(s);
  0
