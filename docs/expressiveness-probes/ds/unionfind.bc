-- Union-find: parent and rank arrays, find with full path compression (two passes, both counted
-- loops of at most `n` steps), union by rank. A growable form: `uf_add` pushes a new singleton.
include textio
include buf

type UF = buf i32 * buf i32

fn gi(b: buf i32, i: i32) -> buf i32 * i32 = let (a, n) = b; let x = at(&a, i, 0); ((a, n), x)
fn si(b: buf i32, i: i32, x: i32) -> buf i32 = let (a, n) = b; (array_set(a, i, x), n)

fn uf_new(n: i32) -> UF = (buf_of_array(array_new[i32](n, !{ i -> i })), buf_of_array(array_new[i32](n, !{ i -> 0 })))

-- A new singleton; its index.
fn uf_add(u: UF) -> UF * i32 =
  let (p, r) = u;
  let (p, i) = len_of(p);
  let (p, _) = push(p, i);
  let (r, _) = push(r, 0);
  ((p, r), i)

-- The root of `x`; every node on the path then points at it.
fn uf_find(u: UF, x: i32) -> UF * i32 =
  let (p, r) = u;
  let (p, n) = len_of(p);
  let mut p = p;
  let mut root = x;
  for _ in 0..n {
    let (p2, q) = gi(p, root);
    p = p2;
    if q == root { break } else { root = q }
  };
  let mut y = x;
  for _ in 0..n {
    let (p2, q) = gi(p, y);
    if q == root { p = p2; break } else { p = si(p2, y, root); y = q }
  };
  ((p, r), root)

-- `x`'s and `y`'s sets joined; whether they were apart.
fn uf_union(u: UF, x: i32, y: i32) -> UF * bool =
  let (u, a) = uf_find(u, x);
  let (u, b) = uf_find(u, y);
  if a == b { (u, false) } else {
    let (p, r) = u;
    let (r, ra) = gi(r, a);
    let (r, rb) = gi(r, b);
    if ra < rb { ((si(p, a, b), r), true) } else {
      if rb < ra { ((si(p, b, a), r), true) } else { ((si(p, b, a), si(r, a, ra + 1)), true) } }
  }

main -> i32 =
  let n = 1000;
  let mut u = uf_new(n);
  let mut comps = n;
  -- join i and 2i+1 (mod n)
  for i in 0..n {
    let j = (2 * i + 1) - ((2 * i + 1) / n) * n;
    let (u2, joined) = uf_union(u, i, j);
    u = u2;
    if joined { comps = comps - 1 } else { () }
  };
  let (u, extra) = uf_add(u);
  let (u, r1) = uf_find(u, extra);
  let (u, r2) = uf_find(u, 0);
  let (u, r3) = uf_find(u, 999);
  print_dec(comps); print_byte(b' ');
  print_dec(extra); print_byte(b' ');
  print_dec(r1); print_byte(b' ');
  let same = if r2 == r3 { 1 } else { 0 };
  print_dec(same); print_byte(b'\n');
  0
