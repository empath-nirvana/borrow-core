-- Dispatch-loop cost probe: bytecode [0 LOAD_N, 1 DEC, 2 JNZ 1, 3 HALT] on an accumulator VM;
-- the while loop runs 2N+2 dispatches. Counts at two N give the per-dispatch cost.
include slice
include buf
main -> i32 =
  let code = array_new[u8] (5, !{ i -> if i == 0 { to_u8(0) } else { if i == 1 { to_u8(1) } else { if i == 2 { to_u8(2) } else { if i == 3 { to_u8(1) } else { to_u8(3) } } } } });
  let mut ip = 0;
  let mut acc = 0;
  let mut steps = 0;
  let mut running = true;
  while running {
    steps = steps + 1;
    let b = at(&code, ip, 3);
    let op = to_i32(b);
    if op == 0 { acc = 2000; ip = ip + 1 } else {
    if op == 1 { acc = acc - 1; ip = ip + 1 } else {
    if op == 2 { let t = at(&code, ip + 1, 0); if acc != 0 { ip = to_i32(t) } else { ip = ip + 2 } } else {
    running = false } } }
  };
  steps
