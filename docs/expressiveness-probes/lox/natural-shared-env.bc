-- Natural shape of jlox's shared environment: two closures that both capture the one mutable
-- environment cell `i` (Rust: Rc<RefCell<Env>>), each call bumping it. Here a closure that
-- mutates a captured variable holds a `mut` borrow of it (aff-capture.bc's `logger`); two such
-- closures over one cell need the borrow twice.
include aff

fn counter<'x, 'w < 'x>(ml: mut 'x i32) -> box 'w Aff[i32, i32]<'w> =
  aff_new_boxed[mut 'x i32, i32, i32]['w](ml, !thunkv fun (m : mut 'x i32) ->
    < fun (a : i32) ->
        q <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) -> return (v + a, v + a)));
        let (m, t) = q;
        return (t, m),
      return (forget_mut['x, i32] m) >)

main -> i32 =
  let i = alloc(0);
  let d = alloc(());
  let (d, r) = borrow mut i { 'x, ml ->
    let r = borrow mut d { 'w, e ->
      let c1 = counter(ml);
      let c2 = counter(ml);
      let (a, c1) = aff_call(c1, 1);
      let (b, c2) = aff_call(c2, 1);
      aff_close(c1);
      aff_close(c2);
      a * 10 + b };
    (d, r) };
  let u = free(d);
  r + free(i) * 100
