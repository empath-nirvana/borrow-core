-- Driving program 1 of docs/type-declarations-design.md §10.1: the JSON value type with a parser
-- and an encoder, hand-lowered. `proposed/json.bc` declares
--
--   data Json = Null | Bool(bool) | Num(i32) | Str(Txt) | Arr(Vec[Json]) | Obj(Vec[Member])
--   data Member = { key: Txt, value: Json }
--
-- `Arr(Vec[Json])` puts the recursion under an array, which is outside `FShape` (SPEC §6), so
-- the declared type would have no fold and no destructor until the kernel entry of design §4.5
-- lands. This file uses the encoding available today, one `mu` in `FShape`: every node carries
-- its key (inside an object) and its next sibling, and an array or object points at its first
-- child ("left child, right sibling").
--
-- The parser is plain recursive descent over an owned byte list (SPEC §20): `value`,
-- `elem_list` and `member_list` are one recursive group, driven by `bounded`, and a malformed
-- input raises `Fail[i32]`. Its members take owned input and return the rest, because a
-- recursive group's members take no lifetime parameters.
--
-- The encoder is what a derived `encode[Json]` over a borrowed value specialises to: a
-- `fold_imm`, total, whose carrier is text as a byte list. A `fold_imm`'s result must outlive
-- every lifetime and a thunk does not, so it cannot return a writer (design §9.3).
--
-- Answer: the line `{"a":[1,true,"hi"],"b":null,"c":{}}`, then (i32[0], i32[4]): the first
-- input parses and is written back; the second, `[1,}`, raises 4 where a value was expected.

include rec
include fail
include textio

-- Bytes, first byte first: a string's text, and the encoder's result.
type Txt = mu X. 1 + (i32 * X)

-- One node: (key inside an object, (kind, next sibling)); a kind is
-- Null | Bool(bool) | Num(i32) | Str(Txt) | Arr(first child) | Obj(first child).
type J = mu X. (1 + Txt) * ((1 + ((1 + 1) + (i32 + (Txt + ((1 + ref X) + (1 + ref X)))))) * (1 + ref X))
type Kind = 1 + ((1 + 1) + (i32 + (Txt + ((1 + ref J) + (1 + ref J)))))
type Sib = 1 + ref J

def nil : Txt = roll inl ()
fn cons(x: i32, t: Txt) -> Txt = roll inr (x, t)

-- The constructors, as the declaration's iso would name them.
fn mk(k: 1 + Txt, kind: Kind, sib: Sib) -> J = roll (k, (kind, sib))

-- ---------------------------------------------------------------------------------------------
-- The parser.
-- ---------------------------------------------------------------------------------------------

fn rev_onto(a: Txt, acc: Txt) -> Txt =
  match unroll a { inl u -> acc | inr (c, r) -> rev_onto(r, cons(c, acc)) }

fn expect(c: i32, ts: Txt) -> Txt with Fail[i32] =
  match unroll ts { inl u -> raise(1) | inr (d, r) -> if d == c { r } else { raise(2) } }

-- `n` bytes dropped: the rest of a `null`, `true` or `false`.
fn skip(n: i32, ts: Txt) -> Txt =
  if n == 0 { ts } else { match unroll ts { inl u -> nil | inr (c, r) -> skip(n - 1, r) } }

-- A string's bytes after its opening quote, and the input after its closing one.
fn str_body(ts: Txt) -> Txt * Txt with Fail[i32], Exhausted =
  match unroll ts {
    inl u -> raise(3)
  | inr (c, r) -> if c == 34 { (nil, r) } else { let (s, r) = str_body(r); (cons(c, s), r) }
  }

fn digits(acc: i32, ts: Txt) -> i32 * Txt =
  match unroll ts {
    inl u -> (acc, nil)
  | inr (c, r) -> if 48 <= c && c <= 57 { digits(acc * 10 + c - 48, r) } else { (acc, cons(c, r)) }
  }

fn value(ts: Txt) -> Kind * Txt with Fail[i32], Exhausted =
  match unroll ts {
    inl u -> raise(1)
  | inr (c, r) ->
      if c == 110 { (inl (), skip(3, r)) }
      else { if c == 116 { (inr (inl (inr ())), skip(3, r)) }
      else { if c == 102 { (inr (inl (inl ())), skip(4, r)) }
      else { if c == 34 { let (s, r) = str_body(r); (inr (inr (inr (inl s))), r) }
      else { if c == 91 { let (first, r) = elems(r); (inr (inr (inr (inr (inl first)))), r) }
      else { if c == 123 { let (first, r) = members(r); (inr (inr (inr (inr (inr first)))), r) }
      else { if 48 <= c && c <= 57 { let (n, r) = digits(c - 48, r); (inr (inr (inl n)), r) }
      else { raise(4) } } } } } } }
  }

-- After `[`: the first element with its siblings chained, and the input after `]`.
fn elems(ts: Txt) -> Sib * Txt with Fail[i32], Exhausted =
  match unroll ts {
    inl u -> raise(1)
  | inr (c, r) -> if c == 93 { (inl (), r) } else { elem_list(cons(c, r)) }
  }

fn elem_list(ts: Txt) -> Sib * Txt with Fail[i32], Exhausted =
  let (kind, r) = value(ts);
  match unroll r {
    inl u -> raise(1)
  | inr (c, r) ->
      if c == 44 { let (sib, r) = elem_list(r); (inr (alloc(mk(inl (), kind, sib))), r) }
      else { if c == 93 { (inr (alloc(mk(inl (), kind, inl ()))), r) } else { raise(5) } }
  }

-- After `{`: the first member with its siblings chained, and the input after `}`.
fn members(ts: Txt) -> Sib * Txt with Fail[i32], Exhausted =
  match unroll ts {
    inl u -> raise(1)
  | inr (c, r) -> if c == 125 { (inl (), r) } else { member_list(cons(c, r)) }
  }

fn member_list(ts: Txt) -> Sib * Txt with Fail[i32], Exhausted =
  let (k, r) = str_body(expect(34, ts));
  let (kind, r) = value(expect(58, r));
  match unroll r {
    inl u -> raise(1)
  | inr (c, r) ->
      if c == 44 { let (sib, r) = member_list(r); (inr (alloc(mk(inr k, kind, sib))), r) }
      else { if c == 125 { (inr (alloc(mk(inr k, kind, inl ()))), r) } else { raise(6) } }
  }

fn parse(ts: Txt) -> J with Fail[i32], Exhausted =
  let (kind, rest) = value(rev_onto(ts, nil));
  mk(inl (), kind, inl ())

-- The input as a byte list, last byte first (`parse` turns it round).
fn bytes_of<'a>(t: text 'a) -> Txt =
  let mut acc = nil;
  for c in t { acc = cons(to_i32(*c), acc) };
  acc

-- ---------------------------------------------------------------------------------------------
-- The encoder: `encode[Json]` at a borrowed value.
-- ---------------------------------------------------------------------------------------------

-- `a ++ b`, by an owned fold into a function of the tail.
type App = U (Txt -o F Txt)
fn app_alg(r: 1 + i32 * App) -> App =
  match r { inl _ -> { b -> b } | inr (x, k) -> { b -> t <- k!(b); cons(x, t) } }
def app_fold : !(Txt => App) = fold_own[1 + i32 * X, App] app_alg
fn app(a: Txt, b: Txt) -> Txt = let k = app_fold(a); k!(b)

-- A number from 0 to 99, in decimal, before `t`.
fn num(n: i32, t: Txt) -> Txt =
  if n < 10 { cons(48 + n, t) }
  else { match host[div_u32] (n, 10) {
           inl q -> match host[rem_u32] (n, 10) { inl r -> cons(48 + q, cons(48 + r, t)) | inr _ -> t }
         | inr _ -> t } }

fn quoted(s: Txt, t: Txt) -> Txt = cons(34, app(s, cons(34, t)))

-- The algebra: one node, with its first child's and its sibling's encodings in place.
fn enc_alg<'y>(r: (1 + Txt) * ((1 + ((1 + 1) + (i32 + (Txt + ((1 + Txt) + (1 + Txt)))))) * (1 + Txt))) -> Txt =
  let (key, rest) = r;
  let (kind, sib) = rest;
  let after = match sib { inl _ -> nil | inr s -> cons(44, s) };
  let body = match kind {
    inl _ -> cons(110, cons(117, cons(108, cons(108, after))))
  | inr k1 -> match k1 {
      inl b -> match b { inl _ -> cons(102, cons(97, cons(108, cons(115, cons(101, after)))))
                       | inr _ -> cons(116, cons(114, cons(117, cons(101, after)))) }
    | inr k2 -> match k2 {
        inl n -> num(n, after)
      | inr k3 -> match k3 {
          inl s -> quoted(s, after)
        | inr k4 -> match k4 {
            inl a -> match a { inl _ -> cons(91, cons(93, after)) | inr c -> cons(91, app(c, cons(93, after))) }
          | inr o -> match o { inl _ -> cons(123, cons(125, after)) | inr c -> cons(123, app(c, cons(125, after))) } } } } } };
  match key { inl _ -> body | inr k -> quoted(k, cons(58, body)) }

def encode : !(all 'a < top. imm 'a J => Txt) =
  fold_imm[(1 + Txt) * ((1 + ((1 + 1) + (i32 + (Txt + ((1 + ref X) + (1 + ref X)))))) * (1 + ref X)), 'b, top, Txt] enc_alg

-- Writing text: an owned fold into a function of the output (`corpus/gen-lines.bc`).
type Run = U (Out -o F (Out * 1))
fn run_alg(r: 1 + i32 * Run) -> Run =
  match r { inl _ -> { o -> (o, ()) } | inr (x, k) -> { o -> let (o, _) = putb(o, to_u8(x)); k!(o) } }
def run_txt : !(Txt => Run) = fold_own[1 + i32 * X, Run] run_alg

fn enc(j: J) -> Txt = let cell = alloc(j); borrow imm cell { 'x, v -> encode(v) }

main -> i32 * i32 =
  let good = borrow imm "{\"a\":[1,true,\"hi\"],\"b\":null,\"c\":{}}" { 'x, t -> bytes_of(t) };
  let bad = borrow imm "[1,}" { 'x, t -> bytes_of(t) };
  let r : (J + i32) * (J + i32) + 1 = with on_exhausted(!{ u -> inr () }) {
    let a : J + i32 = with to_result { parse(good) };
    let b : J + i32 = with to_result { parse(bad) };
    let res : (J + i32) * (J + i32) + 1 = inl (a, b);
    res
  };
  let (out, codes) = match r {
    inl (a, b) ->
      let eb = match b { inl j -> 0 | inr e -> e };
      match a { inl j -> (enc(j), (0, eb)) | inr e -> (nil, (e, eb)) }
  | inr u -> (nil, (0 - 1, 0 - 1))
  };
  let w = run_txt(app(out, cons(10, nil)));
  r <- w!(stdout);
  let (stdout, _) = r;
  codes
