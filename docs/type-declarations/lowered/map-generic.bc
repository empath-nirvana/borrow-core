-- EXPECTED TO BE REJECTED today; kept as the evidence for design §4.1. An association-list map
-- generic in `K, V`, as the template `data Map[K, V] = Empty | Entry(key: K, value: V, rest:
-- box Map[K, V])` would elaborate its functions: a generic `fn` whose signature has a type
-- parameter inside a `mu`. Its call at `[i32, i32]` is rejected:
--
--   this argument of `insert` has type `mu X. 1 + (i32 * i32) * X`, which is not
--   `mu X. 1 + (K * V) * X`
--
-- First-order matching (decision 45) does not look inside a `mu`, so `K` and `V` are not read off
-- the argument. With declarations the parameter's type is the named `Map[K, V]`, which matches
-- `Map[i32, i32]` by name and arguments (design §3.2), and the instance is elaborated at the
-- substituted structure. There are no `type` parameters today, so every signature writes the
-- `mu` out.
--
-- Once it is accepted: i32[3] (entries) * (i32[20] (the newest value of key 1) * i32[0]).

fn empty[K, V]() -> mu X. 1 + ((K * V) * X) = roll inl ()

fn insert[K, V](m: mu X. 1 + ((K * V) * X), k: K, v: V) -> mu X. 1 + ((K * V) * X) =
  roll inr ((k, v), m)

fn size_alg<'y>(r: 1 + ((i32 * i32) * i32)) -> i32 = match r { inl _ -> 0 | inr (e, n) -> n + 1 }
def size : !(all 'a < top. imm 'a (mu X. 1 + ((i32 * i32) * X)) => i32) =
  fold_imm[1 + ((i32 * i32) * X), 'b, top, i32] size_alg

fn get_alg<'y>(r: 1 + ((i32 * i32) * !(i32 => i32 + 1))) -> !(i32 => i32 + 1) =
  match r {
    inl _ -> !{ q -> inr () }
  | inr (e, rest) -> let (k, v) = e; !{ q -> if q == k { inl v } else { (unbang rest)(q) } }
  }
def get : !(all 'a < top. imm 'a (mu X. 1 + ((i32 * i32) * X)) => !(i32 => i32 + 1)) =
  fold_imm[1 + ((i32 * i32) * X), 'b, top, !(i32 => i32 + 1)] get_alg

main -> i32 * (i32 * i32) =
  let m = insert(insert(insert(empty[i32, i32](), 1, 10), 2, 5), 1, 20);
  let cell = alloc(m);
  borrow imm cell { 'x, v ->
    let (v, w) = copy['x, mu X. 1 + ((i32 * i32) * X)](v);
    let n = size(v);
    let f = get(w);
    let a = match (unbang f)(1) { inl x -> x | inr _ -> 0 - 1 };
    let b = match (unbang f)(9) { inl x -> x | inr _ -> 0 };
    (n, (a, b)) }
