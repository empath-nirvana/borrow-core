-- Driving program 5 (design §10.5): an Intcode-style VM, in the proposed surface. Does not parse
-- today. `../lowered/intcode.bc` runs a five-instruction subset.

data Param derives eq, debug = Pos(i32) | Imm(i32) | Rel(i32)

data Instr derives eq, debug =
    Add(a: Param, b: Param, to: Param)
  | Mul(a: Param, b: Param, to: Param)
  | Input(to: Param)
  | Output(a: Param)
  | JumpIfTrue(c: Param, to: Param)
  | JumpIfFalse(c: Param, to: Param)
  | Less(a: Param, b: Param, to: Param)
  | Equals(a: Param, b: Param, to: Param)
  | AdjustBase(a: Param)
  | Halt

-- The machine: a record of places. `let mut m` with `m.pc = …` assigns one field (design §5.3).
data Machine = { mem: buf i64, pc: i32, base: i32, input: buf i64, output: buf i64 }

data Stop derives debug = Halted | NeedInput | BadOpcode(i64)

fn run(m: &mut Machine) -> Stop =                       -- div: an Intcode program may loop
  loop {
    match decode(&m.mem, m.pc) {
      None -> return BadOpcode(m.mem[m.pc])
    | Some((ins, n)) ->
        m.pc += n;
        match ins {
          Add(a, b, to) -> store(m, to, load(m, a) + load(m, b))
        | Mul(a, b, to) -> store(m, to, load(m, a) * load(m, b))
        | Input(to) -> match pop_front(&mut m.input) { Some(x) -> store(m, to, x) | None -> { m.pc -= n; return NeedInput } }
        | Output(a) -> push(&mut m.output, load(m, a))
        | JumpIfTrue(c, to) -> if load(m, c) != 0 { m.pc = load(m, to) }
        | JumpIfFalse(c, to) -> if load(m, c) == 0 { m.pc = load(m, to) }
        | Less(a, b, to) -> store(m, to, if load(m, a) < load(m, b) { 1 } else { 0 })
        | Equals(a, b, to) -> store(m, to, if load(m, a) == load(m, b) { 1 } else { 0 })
        | AdjustBase(a) -> m.base += load(m, a)
        | Halt -> return Halted
        }
    }
  }

-- Elaboration: `Param` is `i32 + (i32 + i32)`, `Instr` a right-nested `+` of ten summands whose
-- payloads are right-nested `*` of `Param`s (the last, `Halt`, is `1`). No `mu`, no `box`: an
-- `Instr` is a value.
--
-- Layout (design §7.2):
--   today's backend (`Backend/README.md`, `|A ⊕ B| = 1 + max |A| |B|`): nested sums nest tag
--   words, so `Param` is 1 + max(1, 1 + max(1, 1)) = 3 words and `Instr` is
--   1 + max(9, 1 + max(9, 1 + max(3, …))) = 17 words (the ninth summand's payload sits under
--   nine tag words);
--   with the recommended n-ary tag (one word per maximal `+` nest): `Param` is 2 words and
--   `Instr` 1 + 3 × 2 = 7;
--   with a tag packed beside a 32-bit payload in one word (design §7.3): `Param` is 1 word and
--   `Instr` 1 + 3 = 4.
--
-- `debug[Instr]` prints `Mul(Pos(4), Imm(3), Pos(4))`: the constructor name, then the fields.
-- `eq[Instr]` compares tags, then payloads field by field.
