-- Target 8 (design §9.8): a declared codata iterator, in the proposed surface. Does not parse
-- today. `../lowered/codata.bc` runs the same type written as a `nu` with `unfold`.

-- Observations, not constructors. `Self` is the rest of the object (`U X` in SPEC §7). The
-- declaration must satisfy `NuOk`: at least two observations, each returning an `F A` in which
-- `Self` occurs only under `*` and `+`.
codata Countdown {
  next      : F (i32 * Self + 1)
  remaining : F (i32 * Self)
  close     : F 1
}

-- Construction is coiteration (SPEC §7's `unfold`), one arm per observation, over an explicit
-- state `s`; each arm returns the next state where the type says `Self`.
fn countdown(n: i32) -> Countdown =
  unfold n { s ->
    next      -> if s == 0 { None } else { Some((s, s - 1)) }
    remaining -> (s, s)
    close     -> ()
  }

fn demo() -> i32 * (i32 * i32) =
  let c = countdown(3);
  let Some((a, c)) <- c.next;            -- an observation is a surviving force: `<-`
  let (left, c) <- c.remaining;
  let Some((b, c)) <- c.next;
  c.close;
  (a, (left, b - 1))

-- The library's iterator and generator types become declarations of the same kind, in
-- `lib/gen.bc`, and the frontend's built-in abbreviations (`VTy`/`CTy` nodes `delay`,
-- `stream`, `iter`, `loop`, `gen`) are deleted (design §4.3):
codata Iter[A, R, R2]   { next: F (A * Self + R)           close: F R2 }
codata Gen[A, B, R]     { next: F (A * Self + (B + Self))  close: F R }
codata Loop[A, B]       { next: F (A + Self)               close: F B }

-- `for x in e { … }` accepts any codata whose structure, through its iso, is `Iter`'s or
-- `Gen`'s (observations `next` and `close` of those shapes); `Countdown` has a third
-- observation, so it is not iterable by `for` unless it provides a view as an `Iter`:
impl iterate[Countdown] = fn(c: Countdown) -> Iter[i32, 1, 1] = unfold c { c ->
  next  -> match c.next { None -> inr () | Some((x, c)) -> inl (x, c) }
  close -> c.close
}
