-- As `move-join.bc`, the other arm taken: the slot is full at its release, and its content is
-- destroyed there.
-- Answer: i32[0].
fn consume(v: array i32 * i32) -> i32 =
  let (a, n) = v;
  array_free[i32](!{ x -> () }, a);
  n

main -> i32 =
  let mut s = (array_new[i32](2, !{ i -> 0 }), 5);
  let k = 0;
  let r = if k == 1 { consume(s) } else { 0 };
  r
