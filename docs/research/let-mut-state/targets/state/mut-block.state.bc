-- `mut-block.bc` with its `let mut`s as instances of the ordinary control effect `State`, the state the
-- handler's parameter: the form #611's translation would give before its state-passing transformation.
effect State[T] { must_resume ctl get() -> T; must_resume ctl put(v: T) }

handler state[T, A](mut s: T): State[T], A -> A * T = {
  return(a) = (a, s);
  get(k) = k(s);
  put(v, k) = { s = v; k(()) }
}

fn ap(f: !(i32 => i32)) -> i32 = f(1)

main -> i32 =
  let (v, x) = with x = state[i32, i32](1) {
    let a = ap(!{ u -> x.put(5); u + 1 });
    x.get() * 10 + a
  };
  v
