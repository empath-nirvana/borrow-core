-- `mut-heads.bc` with its `let mut`s as instances of the ordinary control effect `State`, the state the
-- handler's parameter: the form #611's translation would give before its state-passing transformation.
effect State[T] { must_resume ctl get() -> T; must_resume ctl put(v: T) }

handler state[T, A](mut s: T): State[T], A -> A * T = {
  return(a) = (a, s);
  get(k) = k(s);
  put(v, k) = { s = v; k(()) }
}

main -> i32 =
  let (r, y) = with y = state[i32, i32 * i32](1) {
    with x = state[i32, i32](1) {
      let a = if x.get() == 1 { let t = match (inl () : 1 + 1) { inl u -> x.put(5); 2 | inr u -> 3 }; t * 10 } else { y.put(8); 4 };
      x.get() * 1000 + y.get() * 100 + a
    }
  };
  let (v, x) = r;
  v
