-- `mut-for-acc.bc` with its `let mut`s as instances of the ordinary control effect `State`, the state the
-- handler's parameter: the form #611's translation would give before its state-passing transformation.
effect State[T] { linear ctl get() -> T; linear ctl put(v: T) }

handler state[T, A](mut s: T): State[T], A -> A * T = {
  return(a) = (a, s);
  get(k) = k(s);
  put(v, k) = { s = v; k(()) }
}

main -> i32 =
  let (v, s) = with acc = state[i32, i32](0) { for i in 0..5 { acc.put(acc.get() + i) }; acc.get() };
  v
