-- `mut-modify.bc` as its elaboration should read: written by hand in core.
main : F (i32 * i32) =
  x <- return i32[5];
  n <- return i32[0];
  r <- return run (let (c, n) = withbor2['l, top, i32, i32] (alloc[i32] x) (thunkv Fun 'l < dom.
        return (thunkv fun (m : mut 'l i32) ->
            w <- return withswap['l, i32, i32] m (thunkv fun (v : i32) ->
                  n <- return i32[7];
                  return ((unbang host[add32]) (v, i32[1]), n));
            let (m, n) = w;
            return boxed['l] n));
    return (free[i32] c, n));
  let (x, n) = r;
  return (x, n)
