-- A `let mut` in a function served by a stateful answering handler (handlers-di's shape).
-- Target: `mut-service.core.bc`: the loop's state is the capability and the accumulator.
-- Answer: (i32[10], i32[6]).
effect Log { fn log(x: i32) }

handler summing(mut s: i32): Log = { log(x) = { s = s + x; () } }

fn work(n: i32) -> i32 with Log =
  let mut acc = 0;
  for i in 0..n {
    if host[and32](i, 1) == 0 { log(i) } else { () };
    acc = acc + i
  };
  acc

main -> i32 * i32 =
  let mut c = alloc(0);
  let a = with summing(&mut c) { work(5) };
  (a, free(c))
