-- A fuelled recursive function that reports "ran out". Provisional spellings (README §2).
-- Hand-lowered: 26-fuel.bc, 27-fuel-layer-not-total.bc.

fn ack(m: i32, n: i32) -> i32 =
  if m == 0 { n + 1 } else if n == 0 { ack(m - 1, 1) } else { ack(m - 1, ack(m, n - 1)) }

total fn ack_within(m: i32, n: i32, f: i32) -> i32 + RanOut =
  (ack |> fuel(f) |> fix)(m, n)

main = (ack_within(2, 3, 1000), ack_within(3, 3, 1000))    -- (9, ran out)

-- ELABORATION
--   Three `rec`s: two in tail position, the inner one of the last clause not (frame: m - 1).
--   `fuel(f)` counts `rec`s and stops the recursion with "ran out" at zero, visibly: the result
--   type gains `RanOut`.
--   Which composition is total: `fuel |> fix` with fuel adjacent to the driver is a fuelled
--   driver, total. A fuel layer with the div `fix` under it counts correctly but the driver is
--   still a loop: as lowered, marking that `total` is refused (27: "`ack_fuel` is declared
--   `total`, but it calls a div function (SPEC §14)"). Lowered total (26): the fuel layer inside
--   `deep_fuel` with 2f + 2 observations (each call is at most two observations), so the
--   layer's "ran out" is what the caller sees and the driver's cut-off is unreachable, but in
--   the type.
--
-- DRIVER, TOTALITY, STACK
--   fuel |> fix: total; host stack as deep as the recursion (fix) or heap frames (deep). 529
--   allocations (frames) across the three runs, 0 dispatched calls.
--
-- CHECKER REPORTS (intended)
--   ack: recursive, 1 non-tail `rec`; ack_within: total (fuel), result gains RanOut
