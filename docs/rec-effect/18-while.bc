-- A `while` loop (while.rec): the Collatz steps from n, which may not end (open problem), so the
-- loop is honestly div; and a total wrapper with fuel, which reports "ran out".
--
-- Under the design, `while c { M }` is `rec` in tail position driven by `fix`: div. Today a
-- `while` is refused outside a generator (`19-while-in-fn.bc`), so it is lowered as a drain of a
-- generator that never ends, with `break`: the same loop, the same div. The fuelled form is
-- `div_fuel` over the call, as `corpus/io-fuel.bc` writes it in core.
--
-- Answer: (i32[111], (inl i32[111], inr ())): 111 steps from 27; within 200 observations it
-- finishes, within 50 it runs out.

gen fn forever() -> 1 =
  while true { yield () };
  ()

fn rem2(n: i32) -> i32 = match host[rem_u32] (n, 2) { inl r -> r | inr u -> 0 }
fn half(n: i32) -> i32 = match host[div_u32] (n, 2) { inl r -> r | inr u -> 0 }

fn collatz(n: i32) -> i32 =
  let mut n = n;
  let mut k = 0;
  for u in forever() {
    if n == 1 { break } else { () };
    if rem2(n) == 0 { n = half(n) } else { n = 3 * n + 1 };
    k = k + 1
  };
  k

total fn collatz_within(n: i32, fuel: i32) -> i32 + 1 = div_fuel[i32, 1] (collatz(n), fuel)

main -> i32 * ((i32 + 1) * (i32 + 1)) = (collatz(27), (collatz_within(27, 200), collatz_within(27, 50)))
