-- uses: rec.bc
-- A recursive-descent parser and evaluator (parser.rec), with an error effect escaping it:
--   expr   := term ('+' term)*
--   term   := factor ('*' factor)*
--   factor := digit | '(' expr ')'
-- expr, term and factor are one mutually recursive group, so one `rec`: a request is a member
-- (0 expr, 1 term, 2 factor) and a position; an answer is a value and the position after it.
--
-- Each `while peek == '+' { … term … }` loop has a `rec` in its body, so its accumulator lives
-- in the frame: `inl acc` "in expr's loop, acc so far", `inr inl acc` in term's, `inr inr ()`
-- "in factor, after `(` expr, expecting `)`". A byte that fits nowhere performs `raise(pos)`:
-- the machine stops with `inr pos`, the pending frames are dropped, and the error comes out of
-- the driver as the definition's own result. The input is an array in the state, lent `imm`
-- per step; 0 marks its end.
--
-- Answer: (inl i32[44], inr i32[6]): 2*(3+4)+5*6 is 44; `2*(3+4` fails at 6, where `)` was
-- expected. Div.
include slice

fn in_good(i: i32) -> i32 = if i == 0 { 50 } else { if i == 1 { 42 } else { if i == 2 { 40 } else { if i == 3 { 51 } else { if i == 4 { 43 } else { if i == 5 { 52 } else { if i == 6 { 41 } else { if i == 7 { 43 } else { if i == 8 { 53 } else { if i == 9 { 42 } else { if i == 10 { 54 } else { 0 } } } } } } } } } } }
fn in_bad(i: i32) -> i32 = if i == 0 { 50 } else { if i == 1 { 42 } else { if i == 2 { 40 } else { if i == 3 { 51 } else { if i == 4 { 43 } else { if i == 5 { 52 } else { 0 } } } } } }

fn byte_at(s: array i32, p: i32) -> array i32 * i32 =
  let c = borrow imm s { 'x, v -> at(v, p, 0) };
  (s, c)

-- Frames, and what a step answers.
type K = i32 + (i32 + 1)
type Out = (i32 * i32) + (((i32 * i32) * (K + 1)) + i32)

fn call(nt: i32, p: i32, k: K) -> Out = inr (inl ((nt, p), (inl k : K + 1)))

fn start(q: array i32 * (i32 * i32)) -> array i32 * Out =
  let (s, np) = q;
  let (nt, p) = np;
  if nt == 0 { (s, call(1, p, inl 0)) } else {
    if nt == 1 { (s, call(2, p, inr (inl 1))) } else {
      let (s, c) = byte_at(s, p);
      if 48 <= c && c <= 57 { (s, inl (c - 48, p + 1)) } else {
        if c == 40 { (s, call(0, p + 1, inr (inr ()))) } else { (s, inr (inr p)) }
      }
    }
  }

fn resume(q: array i32 * (K * (i32 * i32))) -> array i32 * Out =
  let (s, kb) = q;
  let (k, b) = kb;
  let (v, p) = b;
  let (s, c) = byte_at(s, p);
  match k {
    inl acc -> if c == 43 { (s, call(1, p + 1, inl (acc + v))) } else { (s, inl (acc + v, p)) }
  | inr k2 -> match k2 {
      inl acc -> if c == 42 { (s, call(2, p + 1, inr (inl (acc * v)))) } else { (s, inl (acc * v, p)) }
    | inr u -> if c == 41 { (s, inl (v, p + 1)) } else { (s, inr (inr p)) }
    }
  }

-- Parse the whole input as an expr: the value, or the position of the error.
fn parse(s: array i32) -> i32 + i32 =
  let (s, r) = deep[i32 * i32, i32 * i32, K, array i32, i32](start, (resume, (s, (0, 0))));
  match r {
    inl vp -> let (v, p) = vp; let (s, c) = byte_at(s, p); if c == 0 { inl v } else { inr p }
  | inr e -> inr e
  }

main -> (i32 + i32) * (i32 + i32) =
  let a = parse(array_new[i32] (12, in_good));
  let b = parse(array_new[i32] (7, in_bad));
  (a, b)
