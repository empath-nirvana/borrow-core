-- fib |> memo(cache) |> fix, on the host stack, at n = 3000 (fib.rec, README §3.2). The open
-- form, with the state threaded: `rec` takes and hands back the state, so the memo layer's cache
-- travels through every call (`S * A => S * B`) instead of being captured, which F5 forbids
-- (`07-memo-capture.bc`). `fib_step` is generic in the state it threads, so the layer can put its
-- cache there. The fixed point is unrolled to depth n + 1 as in `02-fib-host.bc`: total, one
-- native call per level of recursion.
--
-- Answer: inl i32[885303321], fib(3000) mod 1 000 000 007. Total. The host stack bounds the depth:
-- 3000 runs and 3500 exhausts wasmtime's call stack ("wasm trap: call stack exhausted"), so
-- `05-fib-memo-host-deep.bc` at a million fails.
include slice

fn addp(x: i32, y: i32) -> i32 = let s = x + y; if s >= 1000000007 { s - 1000000007 } else { s }

-- The open step, generic in the state it threads.
fn fib_step[S](rec: !(S * i32 => S * (i32 + 1)), p: S * i32) -> S * (i32 + 1) =
  let (s, n) = p;
  if n < 2 { (s, inl n) } else {
    let (s, r1) = rec(s, n - 1);
    match r1 {
      inl a ->
        let (s, r2) = rec(s, n - 2);
        match r2 { inl b -> (s, inl (addp(a, b))) | inr u -> (s, inr u) }
    | inr u -> (s, inr u)
    }
  }

fn empty(i: i32) -> i32 = 0 - 1

fn cache_get(c: array i32, n: i32) -> array i32 * (i32 + 1) =
  let v = borrow imm c { 'x, w -> at(w, n, 0 - 1) };
  if v < 0 { (c, inr ()) } else { (c, inl v) }

fn cache_put(c: array i32, n: i32, v: i32) -> array i32 =
  borrow mut c { 'x, w -> discard_mut(set(w, n, v)) };
  c

-- The memo layer, step to step: a hit answers; a miss runs the inner step, whose `rec` is the
-- whole layered function, then stores.
fn memo_open(inner: !(!(array i32 * i32 => array i32 * (i32 + 1)) * (array i32 * i32)
                      => array i32 * (i32 + 1)),
             rec: !(array i32 * i32 => array i32 * (i32 + 1)),
             p: array i32 * i32) -> array i32 * (i32 + 1) =
  let (c, n) = p;
  let (c, h) = cache_get(c, n);
  match h {
    inl v -> (c, inl v)
  | inr u ->
      let (c, r) = inner(rec, (c, n));
      match r { inl v -> (cache_put(c, n, v), inl v) | inr u -> (c, inr u) }
  }

fn bottom(p: array i32 * i32) -> array i32 * (i32 + 1) = let (c, n) = p; (c, inr ())

fn tie(f: !(array i32 * i32 => array i32 * (i32 + 1))) -> !(array i32 * i32 => array i32 * (i32 + 1)) =
  !{ p -> memo_open(fib_step[array i32], f, p) }

fn unroll_once(i: i32, f: !(array i32 * i32 => array i32 * (i32 + 1)))
    -> !(array i32 * i32 => array i32 * (i32 + 1)) = tie(f)

total fn fib_memo(n: i32) -> i32 + 1 =
  let f = count_fold[!(array i32 * i32 => array i32 * (i32 + 1))] (unroll_once, n + 1, 0, bottom);
  let (c, r) = f(array_new[i32] (n + 1, empty), n);
  r

main -> i32 + 1 = fib_memo(3000)
