-- `corpus/aff-higher.bc` under K1, E1 and B1. Scopes: none (was `'x` and `'y`, with a cell `d`).
-- `boxed[…]`: 2, in `doubler` (was 6), for the reason `aff-drop.bc` gives for `nest`. `doubler`
-- bounds its closure by its argument's bound (K1), and `runner` needs one lifetime, not two.

include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  aff_new_boxed[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, c1),
      n <- return (free[i32] s); return () >)

-- A closure capturing a closure.
fn doubler<'c>(k: box 'c Aff[i32, i32]<'c>) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[box 'c Aff[i32, i32]<'c>, i32, i32]['c](k, !thunkv fun (s : box 'c Aff[i32, i32]<'c>) ->
    < fun (a : i32) ->
        p <- return (aff_call(s, a));
        let (b, r) = p;
        return (b * 2, boxed['c] r),
      return (aff_close(s)) >)

-- A closure taking a closure.
fn runner<'c>() -> box 'c Aff[box 'c Aff[i32, i32]<'c>, i32]<'c> =
  aff_new_boxed[i32, box 'c Aff[i32, i32]<'c>, i32]['c](0, !thunkv fun (t : i32) ->
    < fun (f : box 'c Aff[i32, i32]<'c>) ->
        p <- return (aff_call(f, 5));
        let (b, r) = p;
        u <- return (aff_close(r));
        return (t + b, t + b),
      return () >)

main -> i32 =
  let o = doubler(counter(0));
  let (a, o) = aff_call(o, 1);
  let (b, o) = aff_call(o, 2);
  aff_close(o);
  let rn = runner();
  let (u, rn) = aff_call(rn, counter(100));
  let (v, rn) = aff_call(rn, aff_of_fn[i32, i32](!thunkv fun (x : i32) -> return (x * 3)));
  aff_close(rn);
  a + b * 10 + v * 100
