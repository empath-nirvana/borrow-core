-- `corpus/aff-drop.bc` under K1, the box rule of the outlives judgment non-strict
-- (`docs/outlives-strictness.md` §3.1): `nest` bounds the closure it makes by the
-- bound `'c` of the closure it holds, which `[]I` now admits (`box 'c … ⊐ 'c`). Its second
-- lifetime and the scope `'y` are gone.
-- Checked by `bcc` built with `experiments/Outlives/k1.patch` applied; it prints the corpus golden.
--
include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, boxed['c] c1),
      n <- return (free[i32] s); return () >)

fn nest<'c>(k: box 'c Aff[i32, i32]<'c>) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[box 'c Aff[i32, i32]<'c>, i32, i32]['c](k, !thunkv fun (s : box 'c Aff[i32, i32]<'c>) ->
    < fun (a : i32) ->
        p <- return (aff_call(s, a));
        let (b, r) = p;
        return (b, boxed['c] r),
      return (aff_close(s)) >)

main -> i32 =
  let d = alloc(0);
  let r = borrow mut d { 'x, e ->
    let k = counter ['x](7);
    let k2 = counter ['x](1);
    let (a, k2) = aff_call(k2, 2);
    let o = nest ['x](counter ['x](5));
    a };
  free(d) + r
