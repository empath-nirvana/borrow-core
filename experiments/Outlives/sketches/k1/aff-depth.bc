-- `corpus/aff-depth.bc` under K1, the box rule of the outlives judgment non-strict
-- (`docs/outlives-strictness.md` §3.1): as `aff-counter.bc`, the scope `'y` is gone.
-- Checked by `bcc` built with `experiments/Outlives/k1.patch` applied; it prints the corpus golden.
--
include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, boxed['c] c1),
      n <- return (free[i32] s); return () >)

fn inner<'a, 'c>(m: mut 'a (box 'c Aff[i32, i32]<'c>), k: i32) -> mut 'a (box 'c Aff[i32, i32]<'c>) * i32 =
  aff_call_mut(m, k)

fn middle<'a, 'c>(m: mut 'a (box 'c Aff[i32, i32]<'c>), k: i32) -> mut 'a (box 'c Aff[i32, i32]<'c>) * i32 =
  let (m, x) = inner(m, k);
  let (m, y) = inner(m, k + 1);
  (m, x * 100 + y)

fn outer<'a, 'c>(m: mut 'a (box 'c Aff[i32, i32]<'c>)) -> i32 =
  let x = borrow mut m { 'v, n -> let (n, x) = middle(n, 1); x };
  let (m, y) = middle(m, 3);
  x * 10000 + y

main -> i32 =
  let d = alloc(0);
  let r = borrow mut d { 'x, e ->
    let c = alloc(counter ['x](0));
    let t = borrow mut c { 'w, m -> outer(m) };
    let k = free[box 'x Aff[i32, i32]<'x>] c;
    aff_close(k);
    t
  };
  free(d) + r
