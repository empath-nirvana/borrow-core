-- `corpus/aff-counter.bc` under K1, the box rule of the outlives judgment non-strict
-- (`docs/outlives-strictness.md` §3.1): the closure, bounded by `'x`, is lent
-- `mut` directly in `'x`'s scope: `withbor`'s side condition `box 'x … ⊐ 'x /\ top` holds.
-- The scope `'y` is gone.
-- Checked by `bcc` built with `experiments/Outlives/k1.patch` applied; it prints the corpus golden.
--
include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, boxed['c] c1),
      n <- return (free[i32] s); return () >)

fn twice<'a, 'c>(m: mut 'a (box 'c Aff[i32, i32]<'c>)) -> mut 'a (box 'c Aff[i32, i32]<'c>) * i32 =
  let (m, x) = aff_call_mut(m, 1);
  let (m, y) = aff_call_mut(m, 2);
  (m, x + y)

main -> i32 =
  let d = alloc(0);
  let r = borrow mut d { 'x, e ->
    let c = alloc(counter ['x](10));
    let t = borrow mut c { 'w, m -> let (m, t) = twice(m); t };
    let k = free[box 'x Aff[i32, i32]<'x>] c;
    aff_close(k);
    t
  };
  free(d) + r
