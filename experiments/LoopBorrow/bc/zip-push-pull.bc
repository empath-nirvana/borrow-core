-- O1, zip of a lending source (push) with an ordinary generator (pull). Each observation of
-- the zip pulls the next element `b` of a counter generator, then lends one entry of an array to
-- the body as a view `imm 'z i32` together with `b`. The pull happens before the lend: the
-- counter's rest goes back into the zip's state outside the borrow, since a thunk has no
-- outlives rule and cannot leave the borrow's box.
--
-- Answer: i32[200]: entries 40, 30, 20, 10 through their views, times the counter's 1, 2, 3, 4:
-- 40 + 60 + 60 + 40 = 200. Pairing in the wrong order gives 300; ignoring the counter gives 100.

def drive_alg[A, Q] :
    !(1 + !(U (loop A Q) => A + Q) => !(U (loop A Q) => A + Q)) =
  !thunkv fun (r : 1 + !(U (loop A Q) => A + Q)) ->
    case r {
      inl u ->
        let () = u;
        return (!thunkv fun (l : U (loop A Q)) ->
          q <- (nu_out (force l)).2;
          return (inr q))
    | inr k ->
        return (!thunkv fun (l : U (loop A Q)) ->
          o <- (nu_out (force l)).1;
          case o {
            inl a -> return (inl a)
          | inr l2 -> return ((unbang k) l2)
          })
    }

def z0 : mu X. 1 + X = roll (inl ())
def z1 : mu X. 1 + X = roll (inr z0)
def z2 : mu X. 1 + X = roll (inr z1)
def z3 : mu X. 1 + X = roll (inr z2)
def z4 : mu X. 1 + X = roll (inr z3)
def z5 : mu X. 1 + X = roll (inr z4)
def z6 : mu X. 1 + X = roll (inr z5)
def z7 : mu X. 1 + X = roll (inr z6)
def z8 : mu X. 1 + X = roll (inr z7)

fn tab(i: i32) -> i32 = i * 10

-- The counter 1, 2, 3, …: a generator that never finishes or skips.
type UC = U (gen i32 1 1)
def counter : !U (i32 -o gen i32 1 1) =
  unfold[gen i32 1 1, i32]
    (!thunkv fun (n : i32) -> < return (inl (n, n + 1)), return () >)

-- The consumer's body: an element view, the pulled element and the running sum.
def body : !(all 'z < top. imm 'z i32 * (i32 * i32) => box 'z i32) =
  !thunkv Fun 'z < top. return (thunkv fun (p : imm 'z i32 * (i32 * i32)) ->
    let (e, q) = p;
    let (c, acc) = q;
    let v = *e;
    boxed['z] (acc + v * c))

type T = array i32
type St = ref T * (i32 * (i32 * UC))
type ULp = U (loop (ref T * i32) (ref T * 1))

def zip_lend : !U (St -o loop (ref T * i32) (ref T * 1)) =
  unfold[loop (ref T * i32) (ref T * 1), St]
    (!thunkv fun (p : St) ->
      < let (r, s) = p;
        let (n, s1) = s;
        let (acc, g) = s1;
        if n == 0 { q <- (nu_out (force g)).2; let () = q; return (inl (r, acc)) }
        else {
          o <- (nu_out (force g)).1;
          case o {
            inl y ->
              let (c, g2) = y;
              q <- return (withbor1['x, T, i32] r (thunkv Fun 'x < dom. return (thunkv fun (b : imm 'x T) ->
                     v <- return (withload['x, 'z, T, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
                            match array_get['z, i32] (xs, n) {
                              inl e -> return ((unbang body) ['z] (e, (c, acc)))
                            | inr _ -> boxed['z] acc
                            })));
                     boxed['x] v)));
              let (r2, acc2) = q;
              return (inr (r2, ((unbang host[sub32]) (n, 1), (acc2, g2))))
          | inr d ->
              case d {
                inl u -> let () = u; return (inl (r, acc))
              | inr g2 -> return (inr (r, (n, (acc, g2))))
              }
          }
        },
        let (r, s) = p;
        let (n, s1) = s;
        let (acc, g) = s1;
        q <- (nu_out (force g)).2;
        let () = q;
        return (r, ()) >)

main : F i32 =
  a <- return (array_new[i32] (i32[10], tab));
  t <- return (alloc[T] a);
  cf <- return (unbang counter);
  c0 : i32 <- return i32[1];
  g : UC <- return (thunkv nu_in < (nu_out (force cf c0)).1, (nu_out (force cf c0)).2 >);
  f <- return (unbang zip_lend);
  s0 : St <- return (t, (i32[4], (i32[0], g)));
  l : ULp <- return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >);
  d <- return ((unbang (fold_own[1 + X, !(ULp => (ref T * i32) + (ref T * 1))]
         drive_alg[ref T * i32, ref T * 1])) z8);
  o <- return ((unbang d) l);
  case o {
    inl p -> let (t2, n) = p; return n
  | inr q -> let (t2, u) = q; let () = u; return i32[0]
  }
