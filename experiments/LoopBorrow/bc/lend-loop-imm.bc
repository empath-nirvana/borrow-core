-- O1, the coalgebraic form: a loop whose state holds the lender, and each observation lends
-- it `imm` for that observation. The core of `corpus/pending/borrow-across-loop.bc`: a table
-- borrowed on every step of a loop, here over the indices 4, 3, 2, 1 instead of the input.
--
-- Answer: i32[100]: the table holds 10 * i, and 40 + 30 + 20 + 10 = 100. A loop that lent the
-- table once and lost it could not return it; a step that dropped its state gives 40.

-- A driver: observe a loop at most `n` times (a unary count), and close it if it has not
-- finished. `div_fuel`'s algebra (`lib/div.bc`) over a count written out.
def drive_alg[A, Q] :
    !(1 + !(U (loop A Q) => A + Q) => !(U (loop A Q) => A + Q)) =
  !thunkv fun (r : 1 + !(U (loop A Q) => A + Q)) ->
    case r {
      inl u ->
        let () = u;
        return (!thunkv fun (l : U (loop A Q)) ->
          q <- (nu_out (force l)).2;
          return (inr q))
    | inr k ->
        return (!thunkv fun (l : U (loop A Q)) ->
          o <- (nu_out (force l)).1;
          case o {
            inl a -> return (inl a)
          | inr l2 -> return ((unbang k) l2)
          })
    }

def z0 : mu X. 1 + X = roll (inl ())
def z1 : mu X. 1 + X = roll (inr z0)
def z2 : mu X. 1 + X = roll (inr z1)
def z3 : mu X. 1 + X = roll (inr z2)
def z4 : mu X. 1 + X = roll (inr z3)
def z5 : mu X. 1 + X = roll (inr z4)
def z6 : mu X. 1 + X = roll (inr z5)
def z7 : mu X. 1 + X = roll (inr z6)
def z8 : mu X. 1 + X = roll (inr z7)

-- The lend over a loop, `imm`: the step sees the lender borrowed at `'x` for one observation,
-- and returns a result or the next state, both outliving `'x`.
def lend_loop_imm[A, S, B, R] :
    !(all 'x < top. imm 'x A * S => box 'x (B + S)) * !(all 'x < top. imm 'x A * S => box 'x R) =>
    !U (ref A * S -o loop (ref A * B) (ref A * R)) =
  thunkv fun (st : !(all 'x < top. imm 'x A * S => box 'x (B + S)) *
                   !(all 'x < top. imm 'x A * S => box 'x R)) ->
    let (nx, cl) = st;
    return (unfold[loop (ref A * B) (ref A * R), ref A * S]
      (!thunkv fun (p : ref A * S) ->
        < let (r, s) = p;
          q <- return (withbor1['x, A, B + S] r (thunkv Fun 'x < dom. return (thunkv fun (b : imm 'x A) ->
                 return ((unbang nx) ['x] (b, s)))));
          let (r, o) = q;
          case o { inl v -> return (inl (r, v)) | inr s2 -> return (inr (r, s2)) },
          let (r, s) = p;
          withbor1['x, A, R] r (thunkv Fun 'x < dom. return (thunkv fun (b : imm 'x A) ->
            return ((unbang cl) ['x] (b, s)))) >))

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

-- One step over `(n, acc)`: finish with `acc` at `n = 0`, else add the entry at `n`.
def step : !(all 'x < top. imm 'x (array i32) * (i32 * i32) => box 'x (i32 + i32 * i32)) =
  !thunkv Fun 'x < top. return (thunkv fun (p : imm 'x (array i32) * (i32 * i32)) ->
    let (b, s) = p;
    let (n, acc) = s;
    if n == 0 { boxed['x] (inl acc) }
    else { let v = (unbang get) ['x] (b, n); boxed['x] (inr ((unbang host[sub32]) (n, 1), acc + v)) })

def stop : !(all 'x < top. imm 'x (array i32) * (i32 * i32) => box 'x 1) =
  !thunkv Fun 'x < top. return (thunkv fun (p : imm 'x (array i32) * (i32 * i32)) ->
    let (b, s) = p;
    boxed['x] ())

type T = array i32
type St = ref T * (i32 * i32)
type ULp = U (loop (ref T * i32) (ref T * 1))

main : F i32 =
  a <- return (array_new[i32] (i32[10], tab));
  t <- return (alloc[T] a);
  f <- return (unbang (lend_loop_imm[T, i32 * i32, i32, 1] (step, stop)));
  s0 : St <- return (t, (i32[4], i32[0]));
  l : ULp <- return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >);
  d <- return ((unbang (fold_own[1 + X, !(ULp => (ref T * i32) + (ref T * 1))]
         drive_alg[ref T * i32, ref T * 1])) z8);
  o <- return ((unbang d) l);
  case o {
    inl p -> let (t2, n) = p; return n
  | inr q -> let (t2, u) = q; let () = u; return i32[0]
  }
