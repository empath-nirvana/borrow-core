/-! ### Every allocator -/

/-- **Totality under every allocator.**  A closed computation of `F A`, run from the empty memory
under any allocator from any allocation count, reaches a value.  `[spec §14]` -/
theorem total_every_alloc {e : Expr} {A : VTy} (h : CDerives LifeCtx.empty [] e (.comp (.ret A)))
    (Al : Alloc) (k : Nat) :
    ∃ (k' : Nat) (μ' : Heap) (v : Val), ARun (ℍ := ℍ) Al k Adequacy.emptyMem e k' μ' (.val v) := by
  have hwp := fundamentalC (ℍ := ℍ) h LSub.empty [] [] PMap.empty Adequacy.models_empty
    (gDenC_nil _ _)
  have he : substAll [] e = e := Adequacy.psub_nil 0 e
  rw [he] at hwp
  have htg : Tagged (PMap.empty : WRes) [] [] := fun x hx => absurd hx (by simp)
  obtain ⟨-, -, -, -, -, v, μ, μ', -, -, -, -, -, h4, -, -, ⟨k', hrun⟩, -⟩ :=
    hwp PMap.empty PMap.empty [] Fig16.LogRel.hash_empty (ResU.comp_empty_right _) DtorUnwind.SI.TWNC.empty htg
      Al k
  obtain rfl : μ = (fun _ => none) := ResU.Lower.functional h4 Fig16.BoLo.lower_empty
  exact ⟨k', μ', v, hrun⟩

/-- **Every run under an allocator is bounded**: it is a prefix of the value run, which it
continues to.  `[spec §14]` -/
theorem total_run_prefix {e : Expr} {A : VTy} (h : CDerives LifeCtx.empty [] e (.comp (.ret A)))
    (Al : Alloc) {k j : Nat} {μ₁ : Heap} {e₁ : Expr}
    (hr : ARun (ℍ := ℍ) Al k Adequacy.emptyMem e j μ₁ e₁) :
    ∃ (k' : Nat) (μ' : Heap) (v : Val), ARun (ℍ := ℍ) Al j μ₁ e₁ k' μ' (.val v) := by
  obtain ⟨k', μ', v, hv⟩ := total_every_alloc (ℍ := ℍ) h Al k
  exact ⟨k', μ', v, hr.rest hv⟩

/-- **Every run continues to a value.**  `[spec §14]` -/
theorem total_every_run {e : Expr} {A : VTy} (h : CDerives LifeCtx.empty [] e (.comp (.ret A)))
    {μ₁ : Heap} {e₁ : Expr} (hs : Steps (ℍ := ℍ) Adequacy.emptyMem e μ₁ e₁) :
    ∃ (μ' : Heap) (v : Val), Steps (ℍ := ℍ) μ₁ e₁ μ' (.val v) := by
  obtain ⟨cs, hcs⟩ := steps_replay hs
  obtain ⟨_, μ', v, hv⟩ := total_run_prefix h (Alloc.replay cs) (hcs _ 0 (Alloc.replay_agree cs))
  exact ⟨μ', v, hv.toSteps⟩

/-! ### No infinite run -/

section OfRun
variable {f : ℕ → Heap × Expr} (hf : InfRun (ℍ := ℍ) f)

open Classical

end OfRun

/-- **No infinite run.**  A closed computation of `F A` has no infinite run from the empty
memory: every run of it terminates.  `[spec §14]` -/
theorem total_no_infinite_run {e : Expr} {A : VTy}
    (h : CDerives LifeCtx.empty [] e (.comp (.ret A))) :
    ¬ ∃ f : ℕ → Heap × Expr, f 0 = (Adequacy.emptyMem, e) ∧
      ∀ n, Step1 (ℍ := ℍ) (f n).1 (f n).2 (f (n + 1)).1 (f (n + 1)).2 := by
  rintro ⟨f, h0, hf⟩
  obtain ⟨_, _, _, hv⟩ := total_every_alloc (ℍ := ℍ) h (Alloc.ofRun (ℍ := ℍ) hf) 0
  refine ARun.no_infinite hv (fun n => ((InfRun.cnt hf n), (f n).1, (f n).2)) ?_ ?_
  · simp [InfRun.cnt, countTrue, h0]
  · intro n
    exact InfRun.astep hf n

/-! ### One call

`willreturn` (SPEC §50) is about one call, not a closed program. A computation at the empty row
over related arguments terminates under every allocator (`total_open`, `total_call`). A closed
program's run lets each redex it reaches in a plain context return (`total_subrun`). -/

/-- **Totality of an open computation.**  A computation of `F B` (the empty row) in a context `Γ`,
closed by values `γ` in the relation at a tagged typed world whose completion lowers to `μ`,
reaches a value under every allocator from every count.  `[spec §14]` -/
theorem total_open {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {B : VTy}
    (h : CDerives Δ Γ e (.comp (.ret B)))
    {δ : LSub} {γ : List Val} {ls : List SRec} {ρ ρf fρ : WRes} {ps : List FrameRec} {μ : Heap}
    (hδ : Δ.Models δ) (hγ : gDenC ls δ Γ γ ρ)
    (h1 : ResU.Hash ρf ρ) (h2 : ResU.CompS ρf ρ fρ) (h3 : DtorUnwind.SI.TWNC fρ ps (rsOf ls))
    (h4 : Tagged fρ ps ls) (hμ : ResU.Lower fρ μ) (Al : Alloc) (k : Nat) :
    ∃ (k' : Nat) (μ' : Heap) (v : Val), ARun (ℍ := ℍ) Al k μ (substAll γ e) k' μ' (.val v) := by
  have hwp := fundamentalC (ℍ := ℍ) h δ γ ls ρ hδ hγ
  obtain ⟨-, -, -, -, -, v, μ₀, μ', -, -, -, -, -, h0, -, -, ⟨k', hrun⟩, -⟩ :=
    hwp ρf fρ ps h1 h2 h3 h4 Al k
  obtain rfl : μ₀ = μ := ResU.Lower.functional h0 hμ
  exact ⟨k', μ', v, hrun⟩

/-- **A call returns.**  A computation of `F B` at the empty row over one argument `x : A` (a
function's body, or the call `f x` of a closed `f : U(A ⊸ F B)`), at an argument in the
relation, returns under every allocator: `total_open` at `[x]`.  `[spec §14]` -/
theorem total_call {Δ : LifeCtx} {A B : VTy} {e : Expr}
    (h : CDerives Δ [⟨A, true⟩] e (.comp (.ret B)))
    {δ : LSub} {x : Val} {ls : List SRec} {ρ ρf fρ : WRes} {ps : List FrameRec} {μ : Heap}
    (hδ : Δ.Models δ) (hx : gDenC ls δ [⟨A, true⟩] [x] ρ)
    (h1 : ResU.Hash ρf ρ) (h2 : ResU.CompS ρf ρ fρ) (h3 : DtorUnwind.SI.TWNC fρ ps (rsOf ls))
    (h4 : Tagged fρ ps ls) (hμ : ResU.Lower fρ μ) (Al : Alloc) (k : Nat) :
    ∃ (k' : Nat) (μ' : Heap) (v : Val), ARun (ℍ := ℍ) Al k μ (substAll [x] e) k' μ' (.val v) :=
  total_open (ℍ := ℍ) h hδ hx h1 h2 h3 h4 hμ Al k

/-- **Every redex a closed program reaches in a plain context returns.**  A configuration reached
from a closed computation of `F A`, whose next redex `a` sits in a plain context `K` (no handler
or catch frame), runs `a` to a value: `total_every_run`, then `steps_plug_inv`.  `[spec §14]` -/
theorem total_subrun {e : Expr} {A : VTy} (h : CDerives LifeCtx.empty [] e (.comp (.ret A)))
    {μ₁ : Heap} (K : Kont) (hK : K.Plain = true) {a : Expr}
    (hs : Steps (ℍ := ℍ) Adequacy.emptyMem e μ₁ (K.plug a)) :
    ∃ (μm : Heap) (v : Val), Steps (ℍ := ℍ) μ₁ a μm (.val v) := by
  obtain ⟨μ', w, hw⟩ := total_every_run (ℍ := ℍ) h hs
  obtain ⟨μm, v, hv, -⟩ := steps_plug_inv K hK hw rfl (w := w) rfl
  exact ⟨μm, v, hv⟩

