/-- The semantic judgment at a judgment form.  `[spec §3]` -/
def SemJ (Δ : LifeCtx) (Γ : Ctx VTy) (e : Expr) : Jdg → Prop
  | .val A => SemV Δ Γ e A
  | .comp C => SemC Δ Γ e C

