        simp [Expr.subst, Expr.shift]
      rw [eG]
      refine wpTS_1 _ _ _ _ ?_
      exact wpTS_val ls'' (.inj₂ (.loc ℓ)) _ _ (vC_roll listPBody_noMut listP_closed
        (Or.inr ⟨.loc ℓ, pure_sep_iff.mpr ⟨rfl, ℓ, .pair (num (k + 1)) tl',
