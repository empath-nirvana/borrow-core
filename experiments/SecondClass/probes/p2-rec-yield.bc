-- Probe P2: a recursion that performs a resuming operation (`yield`, affine) before and after
-- its call of itself, with `exhausted` (abortive) when the budget is spent. The self-reference
-- is called directly (no `rec` site), so no continuation is cancelled. Answer: the sum of the
-- yielded values, 5+4+3+2+1+0 + 10*(0+1+2+3+4+5) = 165. With a budget of 3 the recursion raises
-- `exhausted`, whose handler answers 99999.
main : F i32 =
  er : !U (i32 -o F i32) <- return (!thunkv fun (a : i32) -> return a);
  ec : !U (1 -o F i32) * 1 <- return (!thunkv fun (u : 1) -> return i32[99999], ());
  handle_with[2](er, ec) (
    hr : !U (1 -o F[2.0 aff 1 ~> 0] i32) <- return (!thunkv fun (u : 1) -> return i32[0]);
    hc : !U (i32 * U ((1 -o F[2.0 aff 1 ~> 0] i32) & F[2.0 aff 1 ~> 0] 1) -o F[2.0 aff 1 ~> 0] i32) * 1 <- return (!thunkv fun (q : i32 * U ((1 -o F[2.0 aff 1 ~> 0] i32) & F[2.0 aff 1 ~> 0] 1)) ->
          let (v, k) = q;
          w <- return ();
          r <- force k.1 w;
          return (unbang host[add32]) (v, r), ());
    handle_with[1](hr, hc) (
      st : !U ((1 + !U (i32 -o F[1.0 aff i32 ~> 1, 2.0 aff 1 ~> 0] 1)) * i32 -o F[1.0 aff i32 ~> 1, 2.0 aff 1 ~> 0] 1) <- return (!thunkv fun (p : (1 + !U (i32 -o F[1.0 aff i32 ~> 1, 2.0 aff 1 ~> 0] 1)) * i32) ->
          let (self, n) = p;
          u <- perform[1.0] n;
          let () = u;
          case (unbang host[lt_s32]) (n, i32[1]) {
            inl no -> (b <- case self {
                  inl e -> (abort[2.0] () : F[1.0 aff i32 ~> 1, 2.0 aff 1 ~> 0] 1)
                | inr g -> (f <- return unbang g; x <- return ((unbang host[sub32]) (n, i32[1]) : i32); force f x)
                };
              let () = b;
              u <- perform[1.0] ((unbang host[mul32]) (n, i32[10]) : i32);
              let () = u;
              return ())
          | inr yes -> return ()
          });
      bf <- return unbang bounded_fix[i32, F[1.0 aff i32 ~> 1, 2.0 aff 1 ~> 0] 1];
      a <- return (st, (i32[100], i32[5]));
      force bf a))
