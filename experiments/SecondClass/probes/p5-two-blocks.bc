-- Probe P5: System C's `twoBlocks`. Two closures, held together in one pair, each performing
-- `flip` on one stateful handler. The capability is the handler's static name (SPEC §19), not
-- its state, so a closure that uses it captures nothing and is `!`. The state `1 + 1` is the
-- handler's parameter, threaded through the state-passing answer `U (1 + 1 -o F (R * (1 + 1)))`.
-- `flip` answers the old state and stores its negation. Starting from `inl ()`, the first
-- closure sees `inl ()` and the second `inr ()`. Answer: i32[1] when the two answers differ.
main : F i32 =
  g : U (1 + 1 -o F (((1 + 1) * (1 + 1)) * (1 + 1))) <- handle_with[1](
      ((!thunkv fun (r : (1 + 1) * (1 + 1)) ->
        return (thunkv fun (s : 1 + 1) -> return (r, s))) : !U ((1 + 1) * (1 + 1) -o F (U (1 + 1 -o F (((1 + 1) * (1 + 1)) * (1 + 1)))))),
      ((!thunkv fun (qk : 1 * U (((1 + 1) -o F (U (1 + 1 -o F (((1 + 1) * (1 + 1)) * (1 + 1))))) & F 1)) ->
        let (u, k) = qk;
        let () = u;
        return (thunkv fun (s : 1 + 1) ->
            s2 : 1 + 1 <- case s { inl a -> return inr () | inr b -> return inl () };
            g <- force k.1 s;
            force g s2), ()) : !U ((1 * U (((1 + 1) -o F (U (1 + 1 -o F (((1 + 1) * (1 + 1)) * (1 + 1))))) & F 1)) -o F (U (1 + 1 -o F (((1 + 1) * (1 + 1)) * (1 + 1))))) * 1)) (
      blocks : !U (1 -o F[1.0 aff 1 ~> 1 + 1] (1 + 1)) * !U (1 -o F[1.0 aff 1 ~> 1 + 1] (1 + 1)) <- return
        (!thunkv fun (u : 1) -> perform[1.0] u, !thunkv fun (u : 1) -> perform[1.0] u);
      let (f1, f2) = blocks;
      h1 <- return unbang f1;
      x <- return ();
      a <- force h1 x;
      h2 <- return unbang f2;
      y <- return ();
      b <- force h2 y;
      return (a, b));
  s0 : 1 + 1 <- return inl ();
  res <- force g s0;
  let (ab, s) = res;
  let (a, b) = ab;
  case a {
    inl a1 -> case b { inl b1 -> return i32[0] | inr b2 -> return i32[1] }
  | inr a2 -> case b { inl b1 -> return i32[1] | inr b2 -> return i32[0] }
  }
