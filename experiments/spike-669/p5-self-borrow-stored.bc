-- #669 spike: `corpus/reject/gen-self-borrow.bc` as a STORED generator, effect-free. Expected to
-- be refused, and kept as the machine-checked evidence of where.
--
-- With `κ` defunctionalised, the stored generator's state at the `yield` holds the borrow `b` of
-- the generator's own cell. The borrow exists only inside `withbor1`'s callback, so the machine
-- that holds it must be returned out of the callback, boxed at the borrow's lifetime, and its
-- owner handed back beside it. The box rule refuses the result. Here it refuses at the let-bound
-- thunk `g` (the hazard of `p7-box-let-bound.bc`); boxed as a value form
-- (`p5c-self-borrow-stored-inline.bc`) it refuses at the borrow itself: `s0 : imm 'x i32 + 1`
-- cannot be shown to outlive `'x`. Typing it needs a lend whose scope is the codata's
-- lifetime (SPEC §7 *Open*, lifetime-indexed iteration; §14 *Borrow scopes over loops*, the
-- spanning lend of `experiments/LoopBorrow`), with the owner inside the machine: a self-borrow.

type Pull = U (nu X. F (i32 * U X + (0 + U X)) & F 1)

main : F i32 =
  v0 : i32 <- return i32[5];
  c <- return alloc[i32] v0;
  lend <- return withbor1['x, i32, Pull] c (thunkv Fun 'x < dom.
        return (thunkv fun (b : imm 'x i32) ->
            st <- return (!thunkv fun (s : imm 'x i32 + 1) ->
                < case s {
                    inl b2 -> v <- return withload['x, 'y, i32, i32] b2 (thunkv Fun 'y < dom.
                          return (thunkv fun (dv : view 'y i32) -> return boxed['y] dv));
                      return (inl (v, (inr () : imm 'x i32 + 1)) : i32 * (imm 'x i32 + 1) + (0 + (imm 'x i32 + 1)))
                  | inr u -> return (inr (inr (inr () : imm 'x i32 + 1)) : i32 * (imm 'x i32 + 1) + (0 + (imm 'x i32 + 1)))
                  },
                  case s { inl b2 -> return () | inr u -> return () } >);
            f <- return unbang unfold[nu X. F (i32 * U X + (0 + U X)) & F 1, imm 'x i32 + 1] st;
            s0 : imm 'x i32 + 1 <- return inl b;
            g : Pull <- return (thunkv nu_in < (nu_out force f s0).1, (nu_out force f s0).2 >);
            return boxed['x] g));
  let (c, g) = lend;
  o <- (nu_out force g).1;
  d <- return free[i32] c;
  case o {
    inl p -> let (x, g2) = p;
      e <- (nu_out force g2).2;
      return x
  | inr q -> case q { inl z -> absurd z | inr g2 -> e <- (nu_out force g2).2; return i32[0] }
  }
