-- T1e (W-tick, P1's kernel shape with no `await`): a `mut` lend of `c` held across a kernel `Div`
-- loop whose turns write through the view; the body's row is `Div`'s `tick` alone. #743's P1
-- (`while` inside `with count(&mut c)`) is this shape once loops elaborate to `Div` (B2).
--
-- Answer: i32[6].
def plus : i32 * i32 => i32 = unbang host[add32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]

main : F i32 =
  c <- return (alloc[i32] i32[0]);
  t <- return (thunkv fun (u0 : 1) ->
    withbor2rt['x, dom, i32, i32, [4294967295.0 lin 1 ~> 1 + 1]](c, m) (
      st <- return ((!thunkv fun (v : mut 'x i32) ->
        < q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) ->
              return (plus (a, i32[1]), plus (a, i32[1]))));
          let (v, r) = q;
          g <- return (lt (r, i32[3]));
          case g {
            inl ge -> let () = forget_mut['x, i32] v; return (inl r)
          | inr lo -> return (inr v)
          },
          let () = forget_mut['x, i32] v; return i32[4294967295] >) :
          !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1] (i32 + mut 'x i32)
            & F[4294967295.0 lin 1 ~> 1 + 1] i32));
      f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1], mut 'x i32, i32, i32]);
      a0 <- return (st, m);
      o <- force f a0;
      case o { inl b -> return (boxed['x] b) | inr z -> return (boxed['x] z) }));
  df <- return (unbang div_fuel_k[[], ref i32 * i32]);
  a1 <- return (t, i32[100]);
  p <- force df a1;
  let (c, v) = p; w <- return (free[i32] c); return (plus (v, w))
