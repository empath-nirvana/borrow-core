-- T1f (W-tick, nested): each turn of the outer loop (a `mut` relaxed lend of `c` across a `Div`
-- loop that awaits) runs `inner`, which allocates its own cell and lends it `mut` across a `Div`
-- loop of its own that awaits and writes; the inner lend ends inside the outer turn, and the turn
-- adds the inner result to `c` through the outer view.
--
-- `inner` answers 8 (its loop's 4, plus its cell's 4), so the outer loop runs three turns.
-- Answer: i32[48]: the outer loop's 24, plus the cell's 24.
def plus : i32 * i32 => i32 = unbang host[add32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]

def inner : !U (1 -o F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] i32) =
  !thunkv fun (z : 1) ->
    d <- return (alloc[i32] i32[0]);
    p <- withbor2rt['y, dom, i32, i32, [4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1]](d, n) (
      st <- return ((!thunkv fun (v : mut 'y i32) ->
        < q <- return (withswap['y, i32, i32] v (thunkv fun (a : i32) ->
              return (plus (a, i32[2]), plus (a, i32[2]))));
          let (v, r) = q;
          u <- perform[1.0] ();
          let () = u;
          g <- return (lt (r, i32[4]));
          case g {
            inl ge -> let () = forget_mut['y, i32] v; return (inl r)
          | inr lo -> return (inr v)
          },
          let () = forget_mut['y, i32] v; return i32[0] >) :
          !U (mut 'y i32 -o F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] (i32 + mut 'y i32)
            & F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] i32));
      f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1], mut 'y i32, i32, i32]);
      a0 <- return (st, n);
      o <- force f a0;
      case o { inl b -> return (boxed['y] b) | inr z -> return (boxed['y] z) });
    let (d, v) = p;
    w <- return (free[i32] d);
    return (plus (v, w))

main : F i32 =
  c <- return (alloc[i32] i32[0]);
  t <- return (thunkv fun (u0 : 1) ->
    withbor2rt['x, dom, i32, i32, [4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1]](c, m) (
      st <- return ((!thunkv fun (v : mut 'x i32) ->
        < u <- perform[1.0] ();
          let () = u;
          ig <- return (unbang inner);
          z0 <- return ();
          iv <- force ig z0;
          q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) ->
              return (plus (a, iv), plus (a, iv))));
          let (v, r) = q;
          g <- return (lt (r, i32[24]));
          case g {
            inl ge -> let () = forget_mut['x, i32] v; return (inl r)
          | inr lo -> return (inr v)
          },
          let () = forget_mut['x, i32] v; return i32[4294967295] >) :
          !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] (i32 + mut 'x i32)
            & F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] i32));
      f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1], mut 'x i32, i32, i32]);
      a0 <- return (st, m);
      o <- force f a0;
      case o { inl b -> return (boxed['x] b) | inr z -> return (boxed['x] z) }));
  handle_with[1](
      ((!thunkv fun (p : ref i32 * i32) ->
        let (c, v) = p; w <- return (free[i32] c); return (plus (v, w))) : !U (ref i32 * i32 -o F i32)),
      (((!thunkv fun (q : 1 * U ((1 -o F i32) & F 1)) ->
        let (x, k) = q; (force k).1 x), ()) : !U (1 * U ((1 -o F i32) & F 1) -o F i32) * 1)) (
    df <- return (unbang div_fuel_k[[1.0 cancel 1 ~> 1], ref i32 * i32]);
    a1 <- return (t, i32[100]);
    force df a1)
