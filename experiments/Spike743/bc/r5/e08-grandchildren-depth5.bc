-- Round 5, nesting: t2e (the W-hold nursery over `req`, its second child spawning a grandchild
-- over a copy of the view) with the grandchild chain four deep: each level copies its view,
-- spawns the next level under its own `sub` handler (an unboxed task holding the copy), pauses,
-- and finishes the next level after its own resumption. Five tasks hold copies of one `imm` view
-- across their stops, at depths 1 (child) to 5 (`g4`). As in t2e, the grandchild's handler
-- answers `inr` at its first resume, so `sfinish` cancels it: the cancel drops its task `t` by
-- the derived destructor, which cancels `g2`, whose destructor cancels `g3`, then `g4`: a cancel
-- cascading through four levels of tasks holding the view. (Finishing a task twice is refused:
-- `t` is linear.)
-- Answer: i32[27]: 14 + (-1 + 7) + 7; live 0.
include async

fn child<'r>(k: imm 'r i32, n: i32) -> i32 with Async =
  let a = *k;
  await();
  a * n

effect Sub { ctl pause() }
type SubT = U (nu X. F (i32 + (U X * i32)) & F 1)
handler sub: Sub, i32 -> SubT = {
  return(v) = (thunkv nu_in < return (inl v), return () >);
  pause(k) = (thunkv nu_in <
    u <- return (); t <- (force k).1 u; return (inr (t, 1)),
    (force k).2 >)
}
fn sresume(t: SubT) -> i32 + (SubT * i32) = (nu_out (force t)).1
fn scancel(t: SubT) -> 1 = (nu_out (force t)).2
fn sfinish(t: SubT) -> i32 = match sresume(t) { inl v -> v | inr (t2, c) -> scancel(t2); 0 - c }

fn g4<'r>(k: imm 'r i32) -> i32 with Sub =
  pause();
  *k * 1000

fn spawn_g4<'r>(k: imm 'r i32) -> SubT = with sub { g4(k) }

fn g3<'r>(k: imm 'r i32) -> i32 with Sub =
  let (k1, k2) = copy['r, i32] k;
  let t = spawn_g4(k1);
  pause();
  sfinish(t) + *k2 * 100

fn spawn_g3<'r>(k: imm 'r i32) -> SubT = with sub { g3(k) }

fn g2<'r>(k: imm 'r i32) -> i32 with Sub =
  let (k1, k2) = copy['r, i32] k;
  let t = spawn_g3(k1);
  pause();
  sfinish(t) + *k2 * 10

fn spawn_g2<'r>(k: imm 'r i32) -> SubT = with sub { g2(k) }

fn grand<'r>(k: imm 'r i32) -> i32 with Sub =
  let (k1, k2) = copy['r, i32] k;
  let t = spawn_g2(k1);
  pause();
  sfinish(t) + *k2

fn spawn_grand<'r>(k: imm 'r i32) -> SubT = with sub { grand(k) }

fn parent_child<'r>(k: imm 'r i32) -> i32 with Async =
  let (k1, k2) = copy['r, i32] k;
  let g = spawn_grand(k1);
  await();
  sfinish(g) + *k2

fn start<'r, 'n < 'r>(k1: imm 'r i32, k2: imm 'r i32) -> QueueIn[i32]<'n /\ 'r /\ top> =
  let q = queue_in[i32]['n /\ 'r /\ top]();
  let t1 = with spawn_in { child(k1, 2) };
  let q = push_in[i32]['n /\ 'r /\ top](q, t1);
  let t2 = with spawn_in { parent_child(k2) };
  push_in[i32]['n /\ 'r /\ top](q, t2)

-- One round of the children in queue order: the queue, and whether a child is still pending.
fn one_round<'n>(q: QueueIn[i32]<'n>) -> QueueIn[i32]<'n> * (1 + 1) =
  let (n, s) = q;
  let (b, p) = round_in(n, rev_in(n, s));
  ((n, rev_in(n, b)), p)

-- The children's values summed, a child still pending cancelled (and counted -100).
fn finish<'n>(q: QueueIn[i32]<'n>) -> i32 =
  let (n, s) = q;
  let (vs, cut) = values_in(n, rev_in(n, s));
  let mut acc = 0;
  let mut cur = vs;
  for _ in 0..n {
    match unroll cur { inl u -> cur = (roll inl () : List[i32]) | inr (x, r) -> acc = acc + x; cur = r }
  };
  match unroll cur { inl u -> () | inr (x, r) -> () };
  if cut { acc - 100 } else { acc }

fn cancel_all<'n>(q: QueueIn[i32]<'n>) -> 1 = let _ = finish(q); ()

fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]

main : F i32 =
  req <- return (alloc[i32] i32[7]);
  t <- return (thunkv fun (u0 : 1) ->
    withbor1rh['r, dom, i32, i32, [4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1]](req, k) (
      kk <- return (copy['r, i32] k);
      let (k1, k) = kk;
      kk2 <- return (copy['r, i32] k);
      let (k2, k) = kk2;
      sf <- return ((unbang start) ['r] ['r_n]);
      a2 <- return (k1, k2);
      q0 <- force sf a2;
      st <- return ((!thunkv fun (q : QueueIn[i32]<'r_n /\ 'r /\ top>) ->
        < u <- perform[9.0] () unwind (
            cf <- return ((unbang cancel_all) ['r_n /\ 'r /\ top]);
            force cf q);
          let () = u;
          rf <- return ((unbang one_round) ['r_n /\ 'r /\ top]);
          o <- force rf q;
          let (q2, p) = o;
          case p {
            inl done -> ff <- return ((unbang finish) ['r_n /\ 'r /\ top]); s <- force ff q2; return (inl s)
          | inr more -> let () = more; return (inr q2)
          },
          ff <- return ((unbang finish) ['r_n /\ 'r /\ top]); force ff q >) :
          !U (QueueIn[i32]<'r_n /\ 'r /\ top> -o F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] (i32 + QueueIn[i32]<'r_n /\ 'r /\ top>)
            & F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] i32));
      f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1], QueueIn[i32]<'r_n /\ 'r /\ top>, i32, i32]);
      a0 <- return (st, q0);
      o <- force f a0;
      s <- (case o { inl b -> return b | inr z -> return z });
      y <- return ((unbang rd) ['r] k);
      x <- return (plus (s, y));
      return (boxed['r] x)));
  handle_with[9](
      ((!thunkv fun (p : ref i32 * i32) ->
        let (c, v) = p; w <- return (free[i32] c); return v) : !U (ref i32 * i32 -o F i32)),
      (((!thunkv fun (q : 1 * U ((1 -o F i32) & F 1)) ->
        let (x, k) = q; (force k).1 x), ()) : !U (1 * U ((1 -o F i32) & F 1) -o F i32) * 1)) (
    df <- return (unbang div_fuel_k[[9.0 cancel 1 ~> 1], ref i32 * i32]);
    a1 <- return (t, i32[100]);
    force df a1)
