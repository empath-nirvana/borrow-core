-- Round 5: `[await-c]` emitted by the checker (`perform[1.0] ()` of the cancellable `1.0` is
-- `await_1`), inside R1 at `Row.ResumeOCE`. The handler cancels the first `await` (`inr ()`):
-- `cancelled` (`1.1`) is raised past the lend, whose finaliser frees the place; its clause
-- answers 7.
-- Answer: inl i32[7]; live 0.
def plus : i32 * i32 => i32 = unbang host[add32]

main : F (i32 + i32) =
  c <- return (alloc[i32] i32[10]);
  handle_with[1](
      ((!thunkv fun (p : ref i32 * i32) ->
        let (c, v) = p; w <- return (free[i32] c); return (inr (plus (v, w)))) : !U (ref i32 * i32 -o F (i32 + i32))),
      (((!thunkv fun (q : 1 * U ((1 + 1 -o F (i32 + i32)) & top)) ->
          let (x, k) = q; let () = x;
          w <- return (inr () : 1 + 1); (force k).1 w) : !U (1 * U ((1 + 1 -o F (i32 + i32)) & top) -o F (i32 + i32))),
       (((!thunkv fun (e : 1) -> let () = e; return (inl i32[7])) : !U (1 -o F (i32 + i32))), ()))) (
    withbor2r['x, dom, i32, i32, [1.0 lin 1 ~> 1 + 1, 1.1 cancel 1 ~> 0]](c, m) (
      u <- perform[1.0] ();
      let () = u;
      q <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) ->
        return (plus (v, i32[1]), plus (v, i32[1]))));
      let (m, r2) = q;
      let () = forget_mut['x, i32] m;
      return (boxed['x] r2)))
