-- Round 5: was corpus/reject/async-r1-raise-across.bc (SPEC §29, docs/async-capabilities.md
-- §6.2 row 11, `n4`): an abortive operation crossing a relaxed lend, the block's body yielding
-- (resuming) and raising (abortive), the handler of `Fail` outside the block. Accepted under
-- error escape (R1 at `Row.ResumeOCE`). `main` closes the generator at its first `yield`, so the
-- raise is not reached; e02-e05 reach it.
-- Answer: i32[0]; live 0.
include yield
include fail

fn mixed() -> i32 with Yield[i32], Fail[i32] =
  let c = alloc(1);
  let v = borrow mut c { m ->
    let p = (m, 1);
    yield(1);
    let (m, k) = p;
    let x = modify m { v -> (v, v) };
    if x == 1 { raise(x) } else { () };
    x + k
  };
  let _ = free(c);
  v

fn stop(it: U (pull i32 (i32 + i32) 1)) -> 1 = (nu_out (force it)).2

fn guarded() -> i32 + i32 with Yield[i32] = with to_result[i32, i32] { mixed() }

main -> i32 =
  let g : U (pull i32 (i32 + i32) 1) = guarded();
  stop(g);
  0
