-- A2 ([handle] of the lender's name; a stored κ holding the view inside the lend): inside a
-- relaxed lend, a `spawn_in` sub-task captures the view and suspends at its own `await`; the
-- lend body then performs the outer `await` while the sub-task (a stored continuation holding
-- the view) sits in its frame. One outer task is cancelled at that point.
include async

effect Sub { ctl pause() }
type SubT<'d> = box 'd U (nu X. F (i32 + box 'd U X) & F 1)
handler sub<'d>: Sub, i32 -> SubT<'d> = {
  return(v) = boxed['d] (thunkv nu_in < return (inl v), return () >);
  pause(k) = boxed['d] (thunkv nu_in <
    kk <- return (unbox k); u <- return (); t <- (force kk).1 u; return (inr t),
    kk <- return (unbox k); (force kk).2 >)
}
fn sresume<'d>(t: SubT<'d>) -> i32 + SubT<'d> = g <- return (unbox t); (nu_out (force g)).1
fn scancel<'d>(t: SubT<'d>) -> 1 = g <- return (unbox t); (nu_out (force g)).2

fn done(v: i32) -> Task[i32] = with spawn { v }
fn step(t: Task[i32]) -> Task[i32] = match resume(t) { inl v -> done(v) | inr t2 -> t2 }
fn fin(t: Task[i32]) -> i32 = match resume(t) { inl v -> v | inr t2 -> cancel(t2); 0 - 1 }

fn mk<'x>(m: mut 'x i32) -> SubT<'x> =
  with sub { modify m { x -> x + 1 }; pause(); modify m { x -> (x * 3, x * 3) } }

fn worker() -> i32 with Async =
  let c = alloc(10);
  let v = borrow mut c { m ->
    let t = mk(m);
    await();
    match sresume(t) { inl r -> r | inr t2 -> scancel(t2); 0 }
  };
  let _ = free(c);
  v

main -> i32 =
  let a = with spawn { worker() };
  let b = with spawn { worker() };
  let a = step(a);
  cancel(b);
  fin(a)
