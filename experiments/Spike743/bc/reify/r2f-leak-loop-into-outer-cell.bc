-- R2 leak (round 4, refused): r2e's loop put in a cell owned outside `'y`'s lend (captured by the
-- callback, refilled with the loop, handed back as the callback's answer). Refused: `ref U(..)`
-- outlives no lifetime.
fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]



main : F i32 =
  c <- return (alloc[i32] i32[0]);
  d <- return (alloc[i32] i32[0]);
  s <- return (alloc[1] ());
  r <- return (withbor2['y, top, i32, ref U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))] d (thunkv Fun 'y < dom. return (thunkv fun (m : mut 'y i32) ->
      t <- return ((thunkv fun (u0 : 1) ->
        p <- withbor2rt['x, dom, i32, i32 + i32, [4294967295.0 lin 1 ~> 1 + 1]](c, m) (
          st <- return ((!thunkv fun (v : mut 'x i32) ->
            < q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (plus (a, i32[1]), plus (a, i32[1]))));
              let (v, r) = q;
              g <- return (lt (r, i32[50]));
              case g { inl ge -> let () = forget_mut['x, i32] v; return (inl r) | inr lo -> return (inr v) },
              q2 <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (a, a)));
              let (v, r2) = q2; let () = forget_mut['x, i32] v; return r2 >) :
              !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1] (i32 + mut 'x i32) & F[4294967295.0 lin 1 ~> 1 + 1] i32));
          f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1], mut 'x i32, i32, i32]);
          a0 <- return (st, m);
          o <- force f a0;
          case o { inl b -> return (boxed['x] (inl b)) | inr z -> return (boxed['x] (inr z)) });
        let (c, o) = p;
        q7 <- return (withswap['y, i32, 1] m (thunkv fun (a : i32) -> return (i32[1], ()))); let (m, u7) = q7; let () = u7; let () = forget_mut['y, i32] m;
        case o { inl b -> return (inl (c, b)) | inr z -> return (inr (c, z)) }) :
        U (1 -o F[4294967295.0 lin 1 ~> 1 + 1] ((ref i32 * i32) + (ref i32 * i32))));
      rf <- return (unbang reify_k[[], ref i32 * i32]);
      l0 <- force rf t;
      u <- return (free[1] s); let () = u; s2 <- return (alloc[U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))] l0); return (boxed['y] s2))));
  let (d, s2) = r;
  e <- return (free[i32] d);
  e2 <- return (alloc[i32] i32[0]);
  r2 <- return (withbor2['z, top, i32, i32] e2 (thunkv Fun 'z < dom. return (thunkv fun (m2 : mut 'z i32) ->
    let () = forget_mut['z, i32] m2;
    l <- return (free[U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))] s2);
    q <- (nu_out (force l)).2; let (c, v) = q; w <- return (free[i32] c); return (boxed['z] (plus (v, w))))));
  let (e2, v) = r2;
  e3 <- return (free[i32] e2);
  return (plus (v, e))
