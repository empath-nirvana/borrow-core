-- P6's kernel shape (round 4): an endless generator borrowing its own local `mut` across every
-- `yield` (`2.0`) and every step: a W-tick lend of its cell across a `Div` loop that never
-- finishes, made a first-class loop value by `reify_k` at the row `yield`. The consumer observes
-- it three times under a handler of `yield` that sums what is yielded, then closes it.
--
-- Answer: i32[414]: the close's residual 4 * 100 + the cell's 4, plus the yields 1 + 2 + 3 + 4
-- (turn 1 at `reify`, one per *next*), which the deep handler of `yield` adds to the answer.
fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]

def mk : !U (1 -o F[2.0 cancel i32 ~> 1] U (nu X. F[2.0 cancel i32 ~> 1] ((ref i32 * i32) + U X) & F[2.0 cancel i32 ~> 1] (ref i32 * i32))) =
  !thunkv fun (z : 1) ->
    c <- return (alloc[i32] i32[0]);
    t <- return ((thunkv fun (u0 : 1) ->
      p <- withbor2rt['x, dom, i32, i32 + i32, [4294967295.0 lin 1 ~> 1 + 1, 2.0 cancel i32 ~> 1]](c, m) (
        st <- return ((!thunkv fun (v : mut 'x i32) ->
          < q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (plus (a, i32[1]), plus (a, i32[1]))));
            let (v, r) = q;
            u <- perform[2.0] r; let () = u;
            return (inr v),
            q2 <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (a, a)));
            let (v, r2) = q2; let () = forget_mut['x, i32] v; return r2 >) :
            !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1, 2.0 cancel i32 ~> 1] (i32 + mut 'x i32) & F[4294967295.0 lin 1 ~> 1 + 1, 2.0 cancel i32 ~> 1] i32));
        f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 2.0 cancel i32 ~> 1], mut 'x i32, i32, i32]);
        a0 <- return (st, m);
        o <- force f a0;
        case o { inl b -> return (boxed['x] (inl b)) | inr z -> return (boxed['x] (inr z)) });
      let (c, o) = p;
      case o { inl b -> return (inl (c, b)) | inr z -> return (inr (c, z)) }) :
      U (1 -o F[4294967295.0 lin 1 ~> 1 + 1, 2.0 cancel i32 ~> 1] ((ref i32 * i32) + (ref i32 * i32))));
    rf <- return (unbang reify_k[[2.0 cancel i32 ~> 1], ref i32 * i32]);
    force rf t

main : F i32 =
  handle_with[2](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (q : i32 * U ((1 -o F i32) & F 1)) ->
        let (y, k) = q; u <- return (); r <- (force k).1 u; return (plus (y, r))), ()) :
        !U (i32 * U ((1 -o F i32) & F 1) -o F i32) * 1)) (
    g <- return (unbang mk); z <- return (); l0 <- force g z;
    o1 <- (nu_out (force l0)).1;
    case o1 { inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w)) | inr l1 ->
      o2 <- (nu_out (force l1)).1;
      case o2 { inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w)) | inr l2 ->
        o3 <- (nu_out (force l2)).1;
        case o3 { inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w)) | inr l3 -> q <- (nu_out (force l3)).2; let (c, v) = q; w <- return (free[i32] c); return (plus (mul (v, i32[100]), w)) } } })
