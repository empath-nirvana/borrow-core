-- R1 (round 4): an `imm` W-tick lend reified, its turns awaiting (the loop's row is `await`), the
-- consumer under an await handler that resumes at once, observing it to its end. Turn `j` reads
-- the cell (3) and answers 3 + j; the first segment (at `reify`) runs turn 1, each *next* one
-- more; turn 4 finishes, so the third *next* answers `inl (c, 7)`.
--
-- Answer: i32[7003]: 7 * 1000 + the cell's 3.
fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]

def mk : !U (1 -o F[1.0 cancel 1 ~> 1] U (nu X. F[1.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[1.0 cancel 1 ~> 1] (ref i32 * i32))) =
  !thunkv fun (z : 1) ->
    c <- return (alloc[i32] i32[3]);
    t <- return ((thunkv fun (u0 : 1) ->
      p <- withbor1rt['x, dom, i32, i32 + i32, [4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1]](c, m) (
        st <- return ((!thunkv fun (sq : imm 'x i32 * i32) ->
          < let (v, j) = sq;
            cp <- return (copy['x, i32] v); let (v1, v) = cp;
            rv <- return ((unbang rd) ['x] v1);
            r <- return (plus (rv, j));
            u <- perform[1.0] (); let () = u;
            g <- return (lt (j, i32[4]));
            case g { inl ge -> let () = forget_imm['x, i32] v; return (inl r) | inr lo -> return (inr (v, plus (j, i32[1]))) },
            let (v, j) = sq; let () = forget_imm['x, i32] v; return (plus (i32[1000], j)) >) :
            !U (imm 'x i32 * i32 -o F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] (i32 + imm 'x i32 * i32) & F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] i32));
        f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1], imm 'x i32 * i32, i32, i32]);
        a0 <- return (st, (m, i32[1]));
        o <- force f a0;
        case o { inl b -> return (boxed['x] (inl b)) | inr z -> return (boxed['x] (inr z)) });
      let (c, o) = p;
      case o { inl b -> return (inl (c, b)) | inr z -> return (inr (c, z)) }) :
      U (1 -o F[4294967295.0 lin 1 ~> 1 + 1, 1.0 cancel 1 ~> 1] ((ref i32 * i32) + (ref i32 * i32))));
    rf <- return (unbang reify_k[[1.0 cancel 1 ~> 1], ref i32 * i32]);
    force rf t

main : F i32 =
  handle_with[1](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (q : 1 * U ((1 -o F i32) & F 1)) ->
        let (x, k) = q; (force k).1 x), ()) : !U (1 * U ((1 -o F i32) & F 1) -o F i32) * 1)) (
    g <- return (unbang mk); z <- return (); l0 <- force g z;
    o1 <- (nu_out (force l0)).1;
    case o1 {
      inl p -> return i32[1]
    | inr l1 ->
        o2 <- (nu_out (force l1)).1;
        case o2 {
          inl p -> return i32[2]
        | inr l2 ->
            o3 <- (nu_out (force l2)).1;
            case o3 { inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w)) | inr l3 -> q <- (nu_out (force l3)).2; let (c, v) = q; w <- return (free[i32] c); return i32[4] }
        }
    })
