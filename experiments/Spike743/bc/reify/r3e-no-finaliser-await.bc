-- R3 (round 4, refused): r3a's consumer with no finaliser at its `await`: the loop (which owns a
-- cell and an open lend) would be abandoned if the task were cancelled there. Refused.
fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]

def mk : !U (1 -o F U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))) =
  !thunkv fun (z : 1) ->
    c <- return (alloc[i32] i32[0]);
    t <- return ((thunkv fun (u0 : 1) ->
      p <- withbor2rt['x, dom, i32, i32 + i32, [4294967295.0 lin 1 ~> 1 + 1]](c, m) (
        st <- return ((!thunkv fun (v : mut 'x i32) ->
          < q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (plus (a, i32[1]), plus (a, i32[1]))));
            let (v, r) = q;
            g <- return (lt (r, i32[50]));
            case g { inl ge -> let () = forget_mut['x, i32] v; return (inl r) | inr lo -> return (inr v) },
            q2 <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (a, a)));
            let (v, r2) = q2; let () = forget_mut['x, i32] v; return r2 >) :
            !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1] (i32 + mut 'x i32) & F[4294967295.0 lin 1 ~> 1 + 1] i32));
        f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1], mut 'x i32, i32, i32]);
        a0 <- return (st, m);
        o <- force f a0;
        case o { inl b -> return (boxed['x] (inl b)) | inr z -> return (boxed['x] (inr z)) });
      let (c, o) = p;
      case o { inl b -> return (inl (c, b)) | inr z -> return (inr (c, z)) }) :
      U (1 -o F[4294967295.0 lin 1 ~> 1 + 1] ((ref i32 * i32) + (ref i32 * i32))));
    rf <- return (unbang reify_k[[], ref i32 * i32]);
    force rf t
def cons : !U (1 -o F[1.0 cancel 1 ~> 1] i32) =
  !thunkv fun (z : 1) ->
    g <- return (unbang mk); z1 <- return (); l0 <- force g z1;
    u1 <- perform[1.0] ();
    let () = u1;
    o1 <- (nu_out (force l0)).1;
    case o1 {
      inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (v, w))
    | inr l1 ->
        u2 <- perform[1.0] () unwind (q <- (nu_out (force l1)).2; let (c, v) = q; w <- return (free[i32] c); return ());
        let () = u2;
        o2 <- (nu_out (force l1)).1;
        case o2 {
          inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (v, w))
        | inr l2 -> q <- (nu_out (force l2)).2; let (c, v) = q; w <- return (free[i32] c); return (plus (mul (v, i32[100]), w))
        }
    }

main : F i32 =
  tk <- handle_with[1](
      ((!thunkv fun (v : i32) -> return (thunkv nu_in < return (inl v), return () >)) : !U (i32 -o F U (nu X. F (i32 + U X) & F 1))),
      (((!thunkv fun (q : 1 * U ((1 -o F U (nu X. F (i32 + U X) & F 1)) & F 1)) ->
        let (x, k) = q; let () = x;
        return (thunkv nu_in < u <- return (); t <- (force k).1 u; return (inr t), (force k).2 >)), ()) :
        !U (1 * U ((1 -o F U (nu X. F (i32 + U X) & F 1)) & F 1) -o F U (nu X. F (i32 + U X) & F 1)) * 1)) (
    cg <- return (unbang cons); z <- return (); force cg z);
  s1 <- (nu_out (force tk)).1;
  case s1 {
    inl v -> return v
  | inr tk2 -> c9 <- (nu_out (force tk2)).2; let () = c9; return i32[9]
  }
