-- R2 (round 4): the reified loop is stored in a cell, the consumer lends another cell `d` (`'y`,
-- after the loop's lend opened), takes the loop out of its cell inside that lend and observes it
-- there to its end: the loop's lend ends inside `'y`'s. Turn n leaves the cell at n; the loop
-- finishes at 3 on the second *next*, and the consumer writes 3 * 10 through its view of `d`.
--
-- Answer: i32[330]: the cell's 3 (freed inside `'y`) * 100, plus `d`'s 30.
fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]

def mk : !U (1 -o F U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))) =
  !thunkv fun (z : 1) ->
    c <- return (alloc[i32] i32[0]);
    t <- return ((thunkv fun (u0 : 1) ->
      p <- withbor2rt['x, dom, i32, i32 + i32, [4294967295.0 lin 1 ~> 1 + 1]](c, m) (
        st <- return ((!thunkv fun (v : mut 'x i32) ->
          < q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (plus (a, i32[1]), plus (a, i32[1]))));
            let (v, r) = q;
            g <- return (lt (r, i32[3]));
            case g { inl ge -> let () = forget_mut['x, i32] v; return (inl r) | inr lo -> return (inr v) },
            q2 <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (a, a)));
            let (v, r2) = q2; let () = forget_mut['x, i32] v; return r2 >) :
            !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1] (i32 + mut 'x i32) & F[4294967295.0 lin 1 ~> 1 + 1] i32));
        f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1], mut 'x i32, i32, i32]);
        a0 <- return (st, m);
        o <- force f a0;
        case o { inl b -> return (boxed['x] (inl b)) | inr z -> return (boxed['x] (inr z)) });
      let (c, o) = p;
      case o { inl b -> return (inl (c, b)) | inr z -> return (inr (c, z)) }) :
      U (1 -o F[4294967295.0 lin 1 ~> 1 + 1] ((ref i32 * i32) + (ref i32 * i32))));
    rf <- return (unbang reify_k[[], ref i32 * i32]);
    force rf t

main : F i32 =
  g <- return (unbang mk); z <- return (); l0 <- force g z;
  s <- return (alloc[U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))] l0);
  d <- return (alloc[i32] i32[0]);
  r <- return (withbor2['y, top, i32, i32] d (thunkv Fun 'y < dom. return (thunkv fun (m : mut 'y i32) ->
    l <- return (free[U (nu X. F ((ref i32 * i32) + U X) & F (ref i32 * i32))] s);
    o1 <- (nu_out (force l)).1;
    case o1 {
      inl p -> let (c, v) = p; w <- return (free[i32] c); q7 <- return (withswap['y, i32, 1] m (thunkv fun (a : i32) -> return (v, ()))); let (m, u7) = q7; let () = u7; let () = forget_mut['y, i32] m; return (boxed['y] w)
    | inr l1 ->
        o2 <- (nu_out (force l1)).1;
        case o2 {
          inl p -> let (c, v) = p; w <- return (free[i32] c); q7 <- return (withswap['y, i32, 1] m (thunkv fun (a : i32) -> return (mul (v, i32[10]), ()))); let (m, u7) = q7; let () = u7; let () = forget_mut['y, i32] m; return (boxed['y] w)
        | inr l2 -> q <- (nu_out (force l2)).2; let (c, v) = q; w <- return (free[i32] c); q7 <- return (withswap['y, i32, 1] m (thunkv fun (a : i32) -> return (v, ()))); let (m, u7) = q7; let () = u7; let () = forget_mut['y, i32] m; return (boxed['y] (plus (w, i32[1000])))
        }
    })));
  let (d, x) = r;
  e <- return (free[i32] d);
  return (plus (mul (x, i32[100]), e))
