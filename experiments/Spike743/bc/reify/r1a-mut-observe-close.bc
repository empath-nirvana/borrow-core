-- R1 (round 4, W-tick under `reify`): a `mut` W-tick lend of `c` held across a kernel `Div` loop
-- (`div_iterate`) whose turns add 1 to the cell through the view; the computation is made a
-- first-class loop value by `reify_k`, which owns `c` while the lend is open. The consumer
-- observes it twice (*next*, *next*) and then closes it: the tick is answered *close*, `iterate`
-- runs its close step (reading the cell through the view), the lend ends, and the residual
-- hands back `(c, v)`.
--
-- Answer: i32[303]: the first segment (at the `reify`) and the two *next*s run three turns, so
-- the close step reads 3 and the cell holds 3: 3 * 100 + 3.
def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]

main : F i32 =
  c <- return (alloc[i32] i32[0]);
  t <- return ((thunkv fun (u0 : 1) ->
    p <- withbor2rt['x, dom, i32, i32 + i32, [4294967295.0 lin 1 ~> 1 + 1]](c, m) (
      st <- return ((!thunkv fun (v : mut 'x i32) ->
        < q <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) ->
              return (plus (a, i32[1]), plus (a, i32[1]))));
          let (v, r) = q;
          g <- return (lt (r, i32[10]));
          case g {
            inl ge -> let () = forget_mut['x, i32] v; return (inl r)
          | inr lo -> return (inr v)
          },
          q2 <- return (withswap['x, i32, i32] v (thunkv fun (a : i32) -> return (a, a)));
          let (v, r2) = q2;
          let () = forget_mut['x, i32] v; return r2 >) :
          !U (mut 'x i32 -o F[4294967295.0 lin 1 ~> 1 + 1] (i32 + mut 'x i32)
            & F[4294967295.0 lin 1 ~> 1 + 1] i32));
      f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1], mut 'x i32, i32, i32]);
      a0 <- return (st, m);
      o <- force f a0;
      case o { inl b -> return (boxed['x] (inl b)) | inr z -> return (boxed['x] (inr z)) });
    let (c, o) = p;
    case o { inl b -> return (inl (c, b)) | inr z -> return (inr (c, z)) }) :
    U (1 -o F[4294967295.0 lin 1 ~> 1 + 1] ((ref i32 * i32) + (ref i32 * i32))));
  rf <- return (unbang reify_k[[], ref i32 * i32]);
  l0 <- force rf t;
  o1 <- (nu_out (force l0)).1;
  case o1 {
    inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w))
  | inr l1 ->
      o2 <- (nu_out (force l1)).1;
      case o2 {
        inl p -> let (c, v) = p; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w))
      | inr l2 ->
          q <- (nu_out (force l2)).2;
          let (c, v) = q;
          w <- return (free[i32] c);
          return (plus (mul (v, i32[100]), w))
      }
  }
