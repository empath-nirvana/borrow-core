-- R5 (round 4): r5d's reified nursery closed at its first stop (the back edge after the first
-- round, both children pending, each holding a copy of the view): the tick is answered *close*,
-- the nursery's close step (`finish`) cancels the pending children (the cut counts -100), the
-- request is read through the view (7), and the W-hold lend ends: the residual is (req, -93).
--
-- Answer: i32[4294874303]: -93 * 1000 + the request's 7, modulo 2^32.
include async

fn child<'r>(k: imm 'r i32, n: i32) -> i32 with Async =
  let a = *k;
  await();
  a * n

fn start<'r, 'n < 'r>(k1: imm 'r i32, k2: imm 'r i32) -> QueueIn[i32]<'n /\ 'r /\ top> =
  let q = queue_in[i32]['n /\ 'r /\ top]();
  let t1 = with spawn_in { child(k1, 2) };
  let q = push_in[i32]['n /\ 'r /\ top](q, t1);
  let t2 = with spawn_in { child(k2, 3) };
  push_in[i32]['n /\ 'r /\ top](q, t2)

-- One round of the children in queue order: the queue, and whether a child is still pending.
fn one_round<'n>(q: QueueIn[i32]<'n>) -> QueueIn[i32]<'n> * (1 + 1) =
  let (n, s) = q;
  let (b, p) = round_in(n, rev_in(n, s));
  ((n, rev_in(n, b)), p)

-- The children's values summed, a child still pending cancelled (and counted -100).
fn finish<'n>(q: QueueIn[i32]<'n>) -> i32 =
  let (n, s) = q;
  let (vs, cut) = values_in(n, rev_in(n, s));
  let mut acc = 0;
  let mut cur = vs;
  for _ in 0..n {
    match unroll cur { inl u -> cur = (roll inl () : List[i32]) | inr (x, r) -> acc = acc + x; cur = r }
  };
  match unroll cur { inl u -> () | inr (x, r) -> () };
  if cut { acc - 100 } else { acc }

fn cancel_all<'n>(q: QueueIn[i32]<'n>) -> 1 = let _ = finish(q); ()

fn rd<'r>(k: imm 'r i32) -> i32 = *k

def plus : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]

def drive : !U (U (nu X. F[9.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[9.0 cancel 1 ~> 1] (ref i32 * i32)) -o F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] ((ref i32 * i32) + (ref i32 * i32))) =
  !thunkv fun (l0 : U (nu X. F[9.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[9.0 cancel 1 ~> 1] (ref i32 * i32))) ->
    st <- return ((!thunkv fun (l : U (nu X. F[9.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[9.0 cancel 1 ~> 1] (ref i32 * i32))) ->
      < o <- (nu_out (force l)).1;
        case o { inl p -> return (inl p) | inr l2 -> return (inr l2) },
        (nu_out (force l)).2 >) :
      !U (U (nu X. F[9.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[9.0 cancel 1 ~> 1] (ref i32 * i32)) -o F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] ((ref i32 * i32) + U (nu X. F[9.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[9.0 cancel 1 ~> 1] (ref i32 * i32))) & F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] (ref i32 * i32)));
    f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1], U (nu X. F[9.0 cancel 1 ~> 1] ((ref i32 * i32) + U X) & F[9.0 cancel 1 ~> 1] (ref i32 * i32)), ref i32 * i32, ref i32 * i32]);
    a0 <- return (st, l0);
    force f a0

main : F i32 =
  req <- return (alloc[i32] i32[7]);
  t <- return ((thunkv fun (u0 : 1) ->
    p <- withbor1rh['r, dom, i32, i32, [4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1]](req, k) (
      kk <- return (copy['r, i32] k);
      let (k1, k) = kk;
      kk2 <- return (copy['r, i32] k);
      let (k2, k) = kk2;
      sf <- return ((unbang start) ['r] ['r_n]);
      a2 <- return (k1, k2);
      q0 <- force sf a2;
      st <- return ((!thunkv fun (q : QueueIn[i32]<'r_n /\ 'r /\ top>) ->
        < u <- perform[9.0] () unwind (
            cf <- return ((unbang cancel_all) ['r_n /\ 'r /\ top]);
            force cf q);
          let () = u;
          rf <- return ((unbang one_round) ['r_n /\ 'r /\ top]);
          o <- force rf q;
          let (q2, p) = o;
          case p {
            inl done -> ff <- return ((unbang finish) ['r_n /\ 'r /\ top]); s <- force ff q2; return (inl s)
          | inr more -> let () = more; return (inr q2)
          },
          ff <- return ((unbang finish) ['r_n /\ 'r /\ top]); force ff q >) :
          !U (QueueIn[i32]<'r_n /\ 'r /\ top> -o F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] (i32 + QueueIn[i32]<'r_n /\ 'r /\ top>)
            & F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] i32));
      f <- return (unbang div_iterate[[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1], QueueIn[i32]<'r_n /\ 'r /\ top>, i32, i32]);
      a0 <- return (st, q0);
      o <- force f a0;
      s <- (case o { inl b -> return b | inr z -> return z });
      y <- return ((unbang rd) ['r] k);
      x <- return (plus (s, y));
      return (boxed['r] x));
    return (inl p)) : U (1 -o F[4294967295.0 lin 1 ~> 1 + 1, 9.0 cancel 1 ~> 1] ((ref i32 * i32) + (ref i32 * i32))));
  handle_with[9](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (q : 1 * U ((1 -o F i32) & F 1)) ->
        let (x, k) = q; (force k).1 x), ()) : !U (1 * U ((1 -o F i32) & F 1) -o F i32) * 1)) (
    rf <- return (unbang reify_k[[9.0 cancel 1 ~> 1], ref i32 * i32]);
    l0 <- force rf t;
    o <- (nu_out (force l0)).2;
    let (c, v) = o; w <- return (free[i32] c); return (plus (mul (v, i32[1000]), w)))
