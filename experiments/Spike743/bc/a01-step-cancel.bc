-- A2: a task holding a relaxed lend, stepped through a helper and cancelled mid-lend.
include async

fn done(v: i32) -> Task[i32] = with spawn { v }

fn step(t: Task[i32]) -> Task[i32] =
  match resume(t) { inl v -> done(v) | inr t2 -> t2 }

fn fin(t: Task[i32]) -> i32 =
  match resume(t) { inl v -> v | inr t2 -> cancel(t2); 0 - 1 }

fn worker(n: i32) -> i32 with Async =
  let c = alloc(n);
  let v = borrow mut c { m ->
    modify m { x -> x + 1 };
    await();
    let d = alloc(100);
    let w = borrow mut d { k ->
      modify k { x -> x + 3 };
      await();
      modify k { x -> x * 2 };
      await();
      modify k { x -> (x, x) }
    };
    let e = free(d);
    await();
    modify m { x -> (x + w + e, x + w + e) }
  };
  let _ = free(c);
  v

main -> i32 =
  let a = with spawn { worker(1) };
  let b = with spawn { worker(2) };
  let a = step(a);
  let b = step(b);
  let a = step(a);
  cancel(b);
  let a = step(a);
  let a = step(a);
  fin(a)
