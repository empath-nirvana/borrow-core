# AsyncCap — the extended judgment `PDerives`

GENERATED by `experiments/AsyncCap/scripts/gen.py` from `Core/Fundamental.lean` and
`scripts/Derives.tmpl.lean`. Edit the template, not this file.

`PDerives` is `Core.CDerives` with every premise read in `PDerives`, and the relaxed rules of
`docs/async-capabilities.md` §3 added:

* `lendR` (R1): the unwinding lend of an owned place, `Ref T` lent as `Mut 'x T`, to a callback
  whose row has resuming operations (`await`, `yield`). Core types the callback of every lend at a
  row of abortive operations only (`Row.Unwind`, the typing side of T1). `lendR`'s premise is the
  callback's own derivation, in `PDerives`, so a relaxed lend may hold another.
* `lendLoopR` (R2): the per-observation `imm` lend of `lib/lend.bc` (`loop_lend_imm`), its state
  at a type that mentions the lend's lifetime. Core's elaboration (`LoopLend`, SPEC §14) requires the
  state to outlive the lend.

The rules add no machine step: `lendR`'s term is Core's `withborU d` applied to a callback, and
`lendLoopR`'s is `loop_lend_imm`'s erasure. Their soundness is `PinLaw` (`PinLaw.lean`).
-/

noncomputable section

namespace BoCa.Fig16.LogRel.Core.AsyncCap
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.BoLo (Heap Steps Step1 Head Kont eLoad eStore)
open BoCa.Lifetime (LSub LifeCtx LifeVar)

/-- A value type with no `U` at a position read componentwise (`Law2`'s `NoThunkT`, on the
`law2-typed-world` branch): an answer read back at the kernel's relation after a re-lend. -/
def NoThunkT : VTy → Prop
  | .tensor A B => NoThunkT A ∧ NoThunkT B
  | .sum A B => NoThunkT A ∧ NoThunkT B
  | .thunk _ => False
  | .bang A => NoThunkT A
  | .ref A => NoThunkT A
  | .box _ A => NoThunkT A
  | .fam L => NoThunkT L
  | _ => True

/-- **The row a relaxed lend's callback may stop at.** Every operation resumes (none abortive),
none is unrestricted, its cancel row is empty, it answers `1`, its name is not `⊥`, and its
argument is closed data: free of `'x`, outliving every lifetime, with no `U` in it. GhostEnd's
`Row.Resume` with affine operations admitted (`ResumeAff`, `GhostEnd/Drop.lean`), and Law 2's
`ResumeOp` conditions on the argument. -/
def Row.ResumeO (S : Row) (x : LifeVar) : Prop :=
  ∀ o ∈ S, o.abort = false ∧ o.q ≠ .unr ∧ o.fin = .ret .unit ∧ o.B = .unit ∧ o.n ≠ 0 ∧
    ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A

/-- A lend's callback `Λ. λm. M`. -/
def lendCb (M : Expr) : Val := ⟨.lam (.lam M), .lam⟩

/-! ### R2's term: `loop_lend_imm` / `loop_lend_mut`

`lendLoopE C` is the erasure of the per-observation lend (`lib/lend.bc`, `LoopBorrow`), at the
loop body `C` that `unfold` coiterates. The `imm` and `mut` combinators erase to this one term:
`withbor` (1) and (2) differ only in typing. `LoopTerm.lean` checks that it is `bcc`'s erasure of
both at a monomorphic instance (`experiments/AsyncCap/bc/lend-loop-term.bc`). -/

/-- `withbor`'s body, `λr. λf. (r, f () r)`, as the elaborator inlines it. -/
def wbInl : Expr :=
  .lam (.lam (.pair (.var 1) (.app (.app (.var 0) .unit) (.var 1))))

/-- The step `λp. λo. case o {inj₁ _. next | inj₂ _. close}` of `unfold`, under `(nx, cl)`. -/
def lendStepE : Expr :=
  .lam (.lam (.case (.var 0)
    (.seq (.var 0) (.letpair (.var 2)
      (.app
        (.lam (.letpair (.var 0) (.case (.var 0)
          (.inj₁ (.pair (.var 2) (.var 0)))
          (.inj₂ (.pair (.var 2) (.var 0))))))
        (.app (.app wbInl (.var 1))
          (.lam (.lam (.app (.app (.var 8) .unit) (.pair (.var 0) (.var 2)))))))))
    (.seq (.var 0) (.letpair (.var 2)
      (.app (.app wbInl (.var 1))
        (.lam (.lam (.app (.app (.var 7) .unit) (.pair (.var 0) (.var 2))))))))))

/-- `λ(nx, cl). unfold_C step`: the per-observation lend, at `unfold`'s body `C`. -/
def lendLoopE (C : CTy) : Expr :=
  .lam (.letpair (.var 0) (.app (unfoldV C).1 lendStepE))

/-- The loop body of R2's result, `F((Ref A ⊗ B) ⊕ X) & F (Ref A ⊗ R)`. -/
abbrev lendLoopBody (A B R : VTy) : CTy := CTy.loopBody (.tensor (.ref A) B) (.tensor (.ref A) R)

/-- R2's term at `r : Ref A`: `f ← lend_loop (Λ. λp. N, Λ. λp. K); q ← return (r, s₀); f q`. -/
def lendLoopApp (A B R : VTy) (N K s0 : Expr) : Expr :=
  bindE (.app (lendLoopE (lendLoopBody A B R)) (.pair (lendCb N).1 (lendCb K).1))
    (bindE (.pair (.var 1) s0) (.app (.var 1) (.var 0)))

/-- The extended judgment: `CDerives`, every premise in `PDerives`, and the relaxed rules. -/
inductive PDerives : LifeCtx → Ctx VTy → Expr → Jdg → Prop where
  | var {Δ Γ i A} (h : Ctx.SoloP Γ i A) : PDerives Δ Γ (.var i) (.val A)
  | unitI {Δ Γ} (h : Ctx.DeadP Γ) : PDerives Δ Γ (.val .unit) (.val .unit)
  | tensorI {Δ Γ Γ₁ Γ₂ e₁ e₂ A B} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (h₁ : PDerives Δ Γ₁ e₁ (.val A)) (h₂ : PDerives Δ Γ₂ e₂ (.val B)) :
      PDerives Δ Γ (.pair e₁ e₂) (.val (.tensor A B))
  | sumI₁ {Δ Γ e A B} (h : PDerives Δ Γ e (.val A)) :
      PDerives Δ Γ (.inj₁ e) (.val (.sum A B))
  | sumI₂ {Δ Γ e A B} (h : PDerives Δ Γ e (.val B)) :
      PDerives Δ Γ (.inj₂ e) (.val (.sum A B))
  /-- `thunk M : U (F A)`, `M` under a dead binder. -/
  | thunkF {Δ Γ M A} (h : PDerives Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A))) :
      PDerives Δ Γ (.val (.lam M)) (.val (.thunk (.ret A)))
  /-- `thunk V : U C` for a λ-value `V : C`, `C` not an `F`. -/
  | thunkV {Δ Γ N C} (hC : C.isRet = false) (h : PDerives Δ Γ (.val (.lam N)) (.comp C)) :
      PDerives Δ Γ (.val (.lam N)) (.val (.thunk C))
  /-- `return V : F A`. -/
  | ret {Δ Γ V A} (h : PDerives Δ Γ V (.val A)) : PDerives Δ Γ V (.comp (.ret A))
  /-- `M to x. N`, written `(λx. N) M`. -/
  | bind {Δ Γ Γ₁ Γ₂ M N A C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hM : PDerives Δ Γ₁ M (.comp (.ret A))) (hN : PDerives Δ (⟨A, true⟩ :: Γ₂) N (.comp C)) :
      PDerives Δ Γ (.app (.val (.lam N)) M) (.comp C)
  /-- `force x`: `x ()` at `F A`, `x` itself at any other computation type. -/
  | force {Δ Γ i C} (h : Ctx.SoloP Γ i (.thunk C)) :
      PDerives Δ Γ (forceE C (.var i)) (.comp C)
  | lam {Δ Γ M A C} (h : PDerives Δ (⟨A, true⟩ :: Γ) M (.comp C)) :
      PDerives Δ Γ (.val (.lam M)) (.comp (.arr A C))
  /-- `[λ-dead]`: `λx. M : 1 ⊸ F_Σ B` with `x`'s slot dead, `M` not using it.  `[spec §26]` -/
  | lamDead {Δ Γ M} {S : Row} {B : VTy}
      (h : PDerives Δ (⟨.unit, false⟩ :: Γ) M (.comp (CTy.effOf S B))) :
      PDerives Δ Γ (.val (.lam M)) (.comp (.arr .unit (CTy.effOf S B)))
  | app {Δ Γ Γ₁ Γ₂ M i A C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hM : PDerives Δ Γ₁ M (.comp (.arr A C))) (hx : Ctx.SoloP Γ₂ i A) :
      PDerives Δ Γ (.app M (.var i)) (.comp C)
  /-- `⟨M, N⟩ : C & D`, both components in the same context. -/
  | withI {Δ Γ M N C D} (hM : PDerives Δ (withCtx Γ) M (.comp C))
      (hN : PDerives Δ (withCtx Γ) N (.comp D)) :
      PDerives Δ Γ (withPair M N) (.comp (.amp C D))
  | proj₁ {Δ Γ M C D} (h : PDerives Δ Γ M (.comp (.amp C D))) :
      PDerives Δ Γ (.app M (.val (.inj₁ .unit))) (.comp C)
  | proj₂ {Δ Γ M C D} (h : PDerives Δ Γ M (.comp (.amp C D))) :
      PDerives Δ Γ (.app M (.val (.inj₂ .unit))) (.comp D)
  /-- `⟨⟩ : ⊤` at any context. -/
  | topI {Δ Γ} : PDerives Δ Γ (.val .unit) (.comp .top)
  | unitE {Δ Γ Γ₁ Γ₂ V M C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hV : PDerives Δ Γ₁ V (.val .unit)) (hM : PDerives Δ Γ₂ M (.comp C)) :
      PDerives Δ Γ (.seq V M) (.comp C)
  | tensorE {Δ Γ Γp Γb V M A B C} (hs : Ctx.SplitP Γ Γp Γb)
      (hV : PDerives Δ Γp V (.val (.tensor A B)))
      (hM : PDerives Δ (⟨B, true⟩ :: ⟨A, true⟩ :: Γb) M (.comp C)) :
      PDerives Δ Γ (.letpair V M) (.comp C)
  | sumE {Δ Γ Γs Γb V M₁ M₂ A B C} (hs : Ctx.SplitP Γ Γs Γb)
      (hV : PDerives Δ Γs V (.val (.sum A B)))
      (h₁ : PDerives Δ (⟨A, true⟩ :: Γb) M₁ (.comp C))
      (h₂ : PDerives Δ (⟨B, true⟩ :: Γb) M₂ (.comp C)) :
      PDerives Δ Γ (.case V M₁ M₂) (.comp C)
  /-- `absurd V : C` for `V : 0`, at any rest of the context. -/
  | zeroE {Δ Γ Γ₁ Γ₂ V C} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hV : PDerives Δ Γ₁ V (.val .zero)) :
      PDerives Δ Γ (absurdE V) (.comp C)
  /-- `Λ. M : ∀'x ⊏ @b. C`, written `λ_. M`; the binder's slot is dead, at any type. -/
  | allI {Δ Γ x b M S C} (hbx : b.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hΓx : ∀ s ∈ Γ, s.live = true → ¬ VFree x s.ty)
      (h : PDerives (Δ.extend x b) (⟨S, false⟩ :: Γ) M (.comp C)) :
      PDerives Δ Γ (.val (.lam M)) (.comp (.all x b C))
  /-- `M [] : C[@a/'x]`. -/
  | allE {Δ Γ M x b a C} (h : PDerives Δ Γ M (.comp (.all x b C))) (hlt : Δ.EntailsLt a b) :
      PDerives Δ Γ (.app M (.val .unit)) (.comp (C.instLife x a))
  /-- Promotion of `thunk M : U (F A)` over `!Γ`. -/
  | bangThunkF {Δ Γ M A} (hp : Persistent Γ)
      (h : PDerives Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A))) :
      PDerives Δ Γ (.val (.lam M)) (.val (.bang (.thunk (.ret A))))
  /-- Promotion of a λ-value `V : C` over `!Γ`. -/
  | bangThunkV {Δ Γ N C} (hp : Persistent Γ) (hC : C.isRet = false)
      (h : PDerives Δ Γ (.val (.lam N)) (.comp C)) :
      PDerives Δ Γ (.val (.lam N)) (.val (.bang (.thunk C)))
  /-- Dereliction. -/
  | bangE {Δ Γ e A} (h : PDerives Δ Γ e (.val (.bang A))) : PDerives Δ Γ e (.val A)
  | copyBang {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ copy (.val (.thunk (.arr (.bang A) (.ret (.tensor (.bang A) (.bang A))))))
  | forgetBang {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ forget (.val (.thunk (.arr (.bang A) (.ret .unit))))
  /-- `[]I`. -/
  | boxI {Δ Γ e a A} (h : PDerives Δ Γ e (.val A)) (hΓ : CtxOutlives Δ Γ a) :
      PDerives Δ Γ e (.val (.box a A))
  | boxE {Δ Γ e a A} (h : PDerives Δ Γ e (.val (.box a A))) : PDerives Δ Γ e (.val A)
  | immSub {Δ Γ e a b A} (h : PDerives Δ Γ e (.val (.imm b A))) (hle : Δ.EntailsLe a b) :
      PDerives Δ Γ e (.val (.imm a A))
  | mutSub {Δ Γ e a b A} (h : PDerives Δ Γ e (.val (.mut b A))) (hle : Δ.EntailsLe a b) :
      PDerives Δ Γ e (.val (.mut a A))
  /-- The borrow axioms, at arbitrary value-type payloads. -/
  | alloc {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .alloc)) (.val (.lolli A (.ref A)))
  | free {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .free)) (.val (.lolli (.ref A) A))
  | swap {Δ Γ A B} (hΓ : Ctx.DeadP Γ) : PDerives Δ Γ swap (.val (axSwapTy A B))
  | copy {Δ Γ a A} (hΓ : Ctx.DeadP Γ) : PDerives Δ Γ copy (.val (axCopyTy a A))
  | forgetImm {Δ Γ a A} (hΓ : Ctx.DeadP Γ) : PDerives Δ Γ forget (.val (axForgetImmTy a A))
  | forgetMut {Δ Γ a A} (hΓ : Ctx.DeadP Γ) : PDerives Δ Γ forget (.val (axForgetMutTy a A))
  | forgetUnk {Δ Γ} (hΓ : Ctx.DeadP Γ) : PDerives Δ Γ forget (.val axForgetUnkTy)
  /-- An integer literal at its width.  `[spec §8]` -/
  | lit {Δ Γ} (c : IntLit) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val ⟨.prim (.lit c), .prim⟩) (.val (.int c.width))
  /-- A host operation at `!(A ⊸ F B)`, its signature in `SPEC.md` §8.  `[spec §8]` -/
  | hostOp {Δ Γ} (op : HostOp) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim (.host op))) (.val (.bang (hostSig op)))
  /-- `array_new : !(I32 ⊗ !(I32 ⇒ A) ⇒ Array A)`, the step `tab`.  `[spec §9]` -/
  | arrNew {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .tab)) (.val (arrNewTy A))
  /-- `array_free : !(!(A ⇒ 1) ⊗ Array A ⇒ 1)`, the step `drop`.  `[spec §9]` -/
  | arrFree {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .drop)) (.val (arrFreeTy A))
  /-- `array_size : !(Array A ⇒ Array A ⊗ I32)`.  `[spec §9]` -/
  | arrSize {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) : PDerives Δ Γ (.val sizeV) (.val (arrSizeTy A))
  /-- `array_replace : !(Array A ⊗ (I32 ⊗ A) ⇒ Array A ⊗ (A ⊕ A))`.  `[spec §9]` -/
  | arrReplace {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val replaceV) (.val (arrReplaceTy A))
  /-- `array_len : !(ArrayImm @a A ⇒ I32)`.  `[spec §9]` -/
  | arrLen {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val arrLenV) (.val (arrLenTy a A))
  /-- `array_get : !(ArrayImm @a A ⊗ I32 ⇒ Imm @a A ⊕ 1)`, the step `idx`.  `[spec §9]` -/
  | arrGet {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .idx)) (.val (arrGetTy a A))
  /-- `array_copy : !(ArrayImm @a A ⇒ ArrayImm @a A ⊗ ArrayImm @a A)`.  `[spec §9]` -/
  | arrCopy {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val copyV) (.val (arrCopyTy a A))
  /-- `array_forget : !(ArrayImm @a A ⇒ 1)`.  `[spec §9]` -/
  | arrForget {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val forgetV) (.val (arrForgetTy a A))
  /-- `count_fold : !(!(I32 ⊗ S ⇒ S) ⊗ (I32 ⊗ (I32 ⊗ S)) ⇒ S)`, the step `count`: the counted
  loop, total at every host.  `[spec §16]` -/
  | countFold {Δ Γ} (S : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .count)) (.val (countFoldTy S))
  /-- `count_try : !(!(I32 ⊗ S ⇒ S ⊕ E) ⊗ (I32 ⊗ (I32 ⊗ S)) ⇒ S ⊕ E)`, the step `countTry`: the
  counted loop with an exit, total at every host.  `[spec §16]` -/
  | countTry {Δ Γ} (S E : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .countTry)) (.val (countTryTy S E))
  /-- `bounded_fix : !U(!U((1 ⊕ !U(A ⊸ C)) ⊗ A ⊸ C) ⊗ (I32 ⊗ A) ⊸ C)`, the step
  `boundedFix`: the fixed point with a budget of depth, total at every host and every
  computation type.  `[spec §20]` -/
  | boundedFix {Δ Γ} (A : VTy) (C : CTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .boundedFix)) (.val (boundedFixTy A C))
  /-- `slice_borrow_mut : Array A ⊸ (∀'x ⊏ ⊓Δ. [Mut 'x A] ⊸ ['x] B) ⊸ Array A ⊗ B`, the term
  `withbor`'s: an owned array lent as a family of `mut` leaves, with no cell; its side conditions
  non-strict.  `[spec §9, §23]` -/
  | sliceBorrowM {Δ Γ A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ)
      (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      PDerives Δ Γ withbor (.val (sliceBorrowMTy x Δ.meetOfDom A B))
  /-- `slice_borrow_imm : Array A ⊸ (∀'x ⊏ ⊓Δ. [Imm 'x A] ⊸ ['x] B) ⊸ Array A ⊗ B`, the term
  `withbor`'s: an owned array lent as a family of `imm` leaves, with no cell; its side conditions
  non-strict.  `[spec §9, §23]` -/
  | sliceBorrowI {Δ Γ A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hsc : VScoped Δ A)
      (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      PDerives Δ Γ withbor (.val (sliceBorrowITy x Δ.meetOfDom A B))
  /-- `slice_get_mut : !([Mut @a A] ⊗ I32 ⇒ Mut @a A ⊕ 1)`, the step `idx`.  `[spec §9]` -/
  | sliceGetM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .idx)) (.val (sliceGetMTy a A))
  /-- `slice_len_mut : !([Mut @a A] ⇒ [Mut @a A] ⊗ I32)`.  `[spec §9]` -/
  | sliceLenM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val sizeV) (.val (sliceLenMTy a A))
  /-- `slice_split_imm : !([Imm @a A] ⊗ I32 ⇒ ([Imm @a A] ⊗ [Imm @a A]) ⊕ [Imm @a A])`, the step
  `split`.  `[spec §9]` -/
  | sliceSplitI {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .split)) (.val (sliceSplitITy a A))
  /-- `slice_split_mut : !([Mut @a A] ⊗ I32 ⇒ ([Mut @a A] ⊗ [Mut @a A]) ⊕ [Mut @a A])`, the step
  `split`.  `[spec §9]` -/
  | sliceSplitM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (.prim .split)) (.val (sliceSplitMTy a A))
  /-- `slice_empty_imm : [Imm @a A]`, the family `(0, 0)`.  `[spec §9]` -/
  | sliceEmptyI {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val emptyFamV) (.val (.arrayImm a A))
  /-- `slice_empty_mut : [Mut @a A]`, the family `(0, 0)`.  `[spec §9]` -/
  | sliceEmptyM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val emptyFamV) (.val (.sliceMut a A))
  /-- `slice_replace_mut : !([Mut @a A] ⊗ (I32 ⊗ A) ⇒ [Mut @a A] ⊗ (A ⊕ A))`, `array_replace`'s
  term.  `[spec §9]` -/
  | sliceReplaceM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val replaceV) (.val (sliceReplaceMTy a A))
  /-- `slice_swap_mut : !([Mut @a A] ⊗ (I32 ⊗ I32) ⇒ [Mut @a A])`.  `[spec §9]` -/
  | sliceSwapM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val swapV) (.val (sliceSwapMTy a A))
  | withbor1 {Δ Γ A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hsc₁ : VScoped Δ A) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      PDerives Δ Γ withbor (.val (axWithbor1Ty x Δ.meetOfDom A B))
  /-- `withbor` (2): `Ref A` lent as `Mut 'x A`, its side condition `Δ ⊢ A ⊒ @b` non-strict.
  `[spec §23]` -/
  | withbor2 {Δ Γ A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hside : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      PDerives Δ Γ withbor (.val (axWithbor2Ty x Δ.meetOfDom A B))
  | withbor3 {Δ Γ a A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      PDerives Δ Γ withbor (.val (axWithbor3Ty a x Δ.meetOfDom A B))
  | withload {Δ Γ a A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      PDerives Δ Γ withload (.val (axWithloadTy a x Δ.meetOfDom A B))
  | withswap {Δ Γ a A B} (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ withswap (.val (axWithswapTy a A B))
  /-- The unwinding form of `withbor` (1): `Ref A` lent as `Imm 'x A` to a callback at a row of
  abortive operations; when it unwinds, the finaliser `d` runs on the source.  `[spec §19]` -/
  | withbor1U {Δ Γ A B d} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hsc₁ : VScoped Δ A) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x)
      (hdc : closedAt 0 d = true) (hd : PDerives Δ Γ d (.val (.lolli (.ref A) .unit))) :
      PDerives Δ Γ (withborUE d) (.val (withbor1UTy x Δ.meetOfDom A B S))
  /-- The unwinding form of `withbor` (2): `Ref A` lent as `Mut 'x A`, its side condition
  non-strict.  `[spec §19, §23]` -/
  | withbor2U {Δ Γ A B d} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hside : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x)
      (hdc : closedAt 0 d = true) (hd : PDerives Δ Γ d (.val (.lolli (.ref A) .unit))) :
      PDerives Δ Γ (withborUE d) (.val (withbor2UTy x Δ.meetOfDom A B S))
  /-- The unwinding form of `withbor` (3): `Mut @a A` reborrowed as `Mut 'x A`.  `[spec §19]` -/
  | withbor3U {Δ Γ a A B d} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x)
      (hdc : closedAt 0 d = true) (hd : PDerives Δ Γ d (.val (.lolli (.mut a A) .unit))) :
      PDerives Δ Γ (withborUE d) (.val (withbor3UTy a x Δ.meetOfDom A B S))
  /-- The unwinding form of `withload`: its own term, the source consumed by the load.
  `[spec §19]` -/
  | withloadU {Δ Γ a A B} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x) :
      PDerives Δ Γ withload (.val (withloadUTy a x Δ.meetOfDom A B S))
  /-- The unwinding form of `slice_borrow_mut`: an owned array lent as a family of `mut` leaves.
  `[spec §19]` -/
  | sliceBorrowMU {Δ Γ A B d} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ)
      (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x)
      (hdc : closedAt 0 d = true) (hd : PDerives Δ Γ d (.val (.lolli (.array A) .unit))) :
      PDerives Δ Γ (withborUE d) (.val (sliceBorrowMUTy x Δ.meetOfDom A B S))
  /-- The unwinding form of `slice_borrow_imm`: an owned array lent as a family of `imm` leaves.
  `[spec §19]` -/
  | sliceBorrowIU {Δ Γ A B d} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hsc : VScoped Δ A)
      (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x)
      (hdc : closedAt 0 d = true) (hd : PDerives Δ Γ d (.val (.lolli (.array A) .unit))) :
      PDerives Δ Γ (withborUE d) (.val (sliceBorrowIUTy x Δ.meetOfDom A B S))
  -- Call-by-value derived forms: BoLo's application and `∀E` on arbitrary subterms, and the
  -- reading of a computation of `F A` as a value-judged expression at `A`.
  /-- Call-by-value application `f a`, both arbitrary, at `VTy.lolli` (`lolliE_compatX`).  `[spec §3]` -/
  | lolliE {Δ Γ Γ₁ Γ₂ f a A B} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (ha : PDerives Δ Γ₁ a (.val A)) (hf : PDerives Δ Γ₂ f (.val (.lolli A B))) :
      PDerives Δ Γ (.app f a) (.val B)
  /-- Call-by-value `∀E`: `e []` for `e` at `VTy.all x b A` (`allE_compatX`).  `[spec §3]` -/
  | allEV {Δ Γ e x b a A} (h : PDerives Δ Γ e (.val (.all x b A))) (hlt : Δ.EntailsLt a b) :
      PDerives Δ Γ (.app e (.val .unit)) (.val (A.instLife x a))
  /-- A computation of `F A` is a value-judged expression at `A`: `SemV` is `SemC` at `F A`.  `[spec §3]` -/
  | ofRet {Δ Γ e A} (h : PDerives Δ Γ e (.comp (.ret A))) : PDerives Δ Γ e (.val A)
  /-- `roll`: a value of `A[μX. A/X]` is a value of `μX. A`, at a closed `μ` whose variable is
  outside `A`'s `Mut` payloads (`docs/scope-recursion.md` §2.2).  `[spec §6]` -/
  | roll {Δ Γ e A} (hA : A.NoMut 0) (hc : (VTy.mu A).Cl 0)
      (h : PDerives Δ Γ e (.val (VTy.inst (.mu A) A))) : PDerives Δ Γ e (.val (.mu A))
  /-- `unroll`: a value of `μX. A` is a value of `A[μX. A/X]`.  `[spec §6]` -/
  | unroll {Δ Γ e A} (h : PDerives Δ Γ e (.val (.mu A))) :
      PDerives Δ Γ e (.val (VTy.inst (.mu A) A))
  /-- The borrowed fold, a constant:
  `foldImm : !U(∀'y ⊏ ⊤. A_R ⊸ F R) ⊸ !U(∀'y ⊏ @c. Imm 'y (μX. T) ⊸ F R)`, for `T` built by
  `⊗`/`⊕` from closed leaves, `Ref X` and `X` (not `X` itself), `A_R = Imm̲ 'y T` with `R` at
  every recursive position, `R` outliving every lifetime, `'y` free in neither `μX. T` nor
  `R`.  `[spec §6]` -/
  | foldImm {Δ Γ} (F : FShape) (y : LifeVar) (c : Lifetime.Life) (R : VTy) (hΓ : Ctx.DeadP Γ)
      (hF : F.WF) (hG : F.Guarded) (hyM : ¬ VFree y (.mu F.ty)) (hyR : ¬ VFree y R)
      (hR : ∀ Δ' a, VOutlives Δ' a R) :
      PDerives Δ Γ (.val (foldImmV F)) (.val (.lolli (algTy F y R) (foldTy F y c R)))
  /-- The owned fold, a constant: `foldOwn : !U(A′_R ⊸ F R) ⊸ !U(μX. T ⊸ F R)`, for `T` of the
  same class, `A′_R = T` with `R` at every recursive position, any `R`.  `[spec §6]` -/
  | foldOwn {Δ Γ} (F : FShape) (R : VTy) (hΓ : Ctx.DeadP Γ) (hF : F.WF) (hG : F.Guarded) :
      PDerives Δ Γ (.val (foldOwnV F)) (.val (.lolli (algOTy F R) (foldOTy F R)))
  /-- The owned fold with reuse, a constant: `foldReuse : !U(A″_R ⊸ F R) ⊸ !U(μX. T ⊸ F R)`,
  for `T` of the same class, `A″_R = T` with `R` at a head `X` and `Ref 1 ⊗ R` at every `Ref X`
  (the emptied cell and the result on its content), any `R`.  `[spec §6]` -/
  | foldReuse {Δ Γ} (F : FShape) (R : VTy) (hΓ : Ctx.DeadP Γ) (hF : F.WF) (hG : F.Guarded) :
      PDerives Δ Γ (.val (foldReuseV F)) (.val (.lolli (algRTy F R) (foldOTy F R)))
  /-- `νX. C` is its unrolling `C[U(νX. C)/X]` (`cC_nu_iff`), on the same term, at a positive
  `C`.  `[spec §7]` -/
  | nuIn {Δ Γ e C} (hC : C.NuOk) (h : PDerives Δ Γ e (.comp C.unroll)) :
      PDerives Δ Γ e (.comp (.nu C))
  | nuOut {Δ Γ e C} (hC : C.NuOk) (h : PDerives Δ Γ e (.comp (.nu C))) :
      PDerives Δ Γ e (.comp C.unroll)
  /-- Coiteration, a constant: `unfold : !U(S ⊸ C[S/X]) ⊸ !U(S ⊸ νX. C)` (`Nu.lean`), at a
  positive `C`.  `[spec §7]` -/
  | unfoldN {Δ Γ} (C : CTy) (S : VTy) (hC : C.NuOk) (hΓ : Ctx.DeadP Γ) :
      PDerives Δ Γ (.val (unfoldV C)) (.val (unfoldTy C S))
  /-- `[sub]`: `F_Σ A ≤ F_Σ′ A` for `Σ ⊆ Σ′`; `F A = F_∅ A`.  `[spec §19]` -/
  | effSub {Δ Γ e} {S S' : Row} {A : VTy} (hle : RowLe S S')
      (h : PDerives Δ Γ e (.comp (CTy.effOf S A))) : PDerives Δ Γ e (.comp (CTy.effOf S' A))
  /-- `[perform]`: a non-abortive operation of the row.  `[spec §19]` -/
  | effPerform {Δ Γ V} {S : Row} {o : OpSig} (hf : Row.find S o.n o.i = some o)
      (hna : o.abort = false) (h : PDerives Δ Γ V (.val o.A)) :
      PDerives Δ Γ (BoCa.BoLo.performE (opArgE o.n o.i V)) (.comp (CTy.effOf S o.B))
  /-- `[raise]`: an abortive operation of the row, at any answer, its argument dropping.
  `[spec §19]` -/
  | effRaise {Δ Γ V} {S : Row} {o : OpSig} {B : VTy} (hf : Row.find S o.n o.i = some o)
      (ha : o.abort = true) (hd : o.A.Drop) (h : PDerives Δ Γ V (.val o.A)) :
      PDerives Δ Γ (BoCa.BoLo.raiseE (opArgE o.n o.i V)) (.comp (CTy.effOf S B))
  /-- `[let]`: `M to x. N` at a row; `N`'s context drops at a row with weakening and is
  persistent at an unrestricted row.  `[spec §19]` -/
  | effLet {Δ Γ Γ₁ Γ₂ M N A B} {S : Row} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hW : S.Weak → Γ₂.Drops) (hU : S.Unr → Persistent Γ₂)
      (hM : PDerives Δ Γ₁ M (.comp (CTy.effOf S A)))
      (hN : PDerives Δ (⟨A, true⟩ :: Γ₂) N (.comp (CTy.effOf S B))) :
      PDerives Δ Γ (.app (.val (.lam N)) M) (.comp (CTy.effOf S B))
  /-- `[then]`: `M then x. N unwind D`, `M` at `Σ_M ≤ Σ` and the finaliser at `Σ_D ≤ Σ`, each
  capturable operation of `Σ_M` with `Σ(o).fin ≥ Σ_M(o).fin ⋈ Σ_D`: what the finaliser may raise or
  perform when a continuation captured in `M` is cancelled is recorded in that operation's cancel
  row.  `Γ₂` is persistent where `Σ` has an unrestricted operation at some depth of its cancel
  rows (`Row.UnrD`), since the finaliser runs in the cancels below it, and the errors pending at the
  finaliser are persistent where `Σ_D` has one.  `[then]` at option A, the finaliser at `F 1`, is
  `PDerives.effThenA`.  `[spec §19, §24, §27]` -/
  | effThen {Δ Γ Γ₁ Γ₂ M N D A B} {S SM SD : Row} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hNZ : S.NZ)
      (hUq : S.Uniq) (hU : S.UnrD → Persistent Γ₂) (hMS : RowLe SM S) (hDS : RowLe SD S)
      (hfin : ∀ n i o o', Row.find SM n i = some o → Row.find S n i = some o' →
        capB o.q o.B = true → ThenLe o.fin SD o'.fin)
      (hP : SD.UnrD → SM.PendPers)
      (hM : PDerives Δ Γ₁ M (.comp (CTy.effOf SM A)))
      (hN : PDerives Δ (⟨A, true⟩ :: Γ₂) N (.comp (CTy.effOf S B)))
      (hD : PDerives Δ (⟨.unit, false⟩ :: Γ₂) D (.comp (CTy.effOf SD .unit))) :
      PDerives Δ Γ (thenE N D M) (.comp (CTy.effOf S B))
  /-- `[handle]`: `handle_n e with H`, the handler's pair `H = (h_ret, hs)` a value form over a
  part of the context whose live slots are persistent, `n` not in `Σ`.  The `j`-th operation's
  cancel row is `fs j`, and its clause's `κ` has its cancel branch at `cancelTy Σ (fs j)`.  At two
  variables and empty cancel rows it is `hndTerm` (`PDerives.effHandle`).  `[spec §19, §24, §27]` -/
  | effHandleV {Δ Γ Γ₁ Γ₂ H e} {S : Row} {E : List (Qual × VTy × VTy)} {fs : Nat → CTy}
      {n : UInt32} {A R : VTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hd : Ctx.DeadP Γ₁) (hH : H.ValFormIn Γ₁)
      (hc : PDerives Δ Γ₁ H (.val (.tensor (retTy S A R) (clausesTy S R E fs))))
      (hn0 : n ≠ 0) (hnS : ∀ o ∈ S, o.n ≠ n) (hlen : E.length ≤ 2 ^ 32)
      (he : PDerives Δ Γ₂ e (.comp (CTy.effOf (Row.ofEff n E 0 fs ++ S) A))) :
      PDerives Δ Γ (hndExpr n (E.map Prod.fst) H e) (.comp (CTy.effOf S R))
  /-- BOXED-κ (`CDerives.effHandleVB`).  `[spec §28]` -/
  | effHandleVB {Δ Γ Γ₁ Γ₂ H e} {S : Row} {E : List (Qual × VTy × VTy)} {fs : Nat → CTy}
      {n : UInt32} {A R : VTy} {d : Lifetime.Life} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hd : Ctx.DeadP Γ₁)
      (hH : H.ValFormIn Γ₁)
      (hc : PDerives Δ Γ₁ H (.val (.tensor (retTy S A R) (clausesTyB S R d E fs))))
      (hn0 : n ≠ 0) (hnS : ∀ o ∈ S, o.n ≠ n) (hlen : E.length ≤ 2 ^ 32)
      (he : PDerives Δ Γ₂ e (.comp (CTy.effOf (Row.ofEff n E 0 fs ++ S) A)))
      (hΓd : CtxOutlives Δ Γ₂ d) (hSd : Row.AnsOutlives Δ d (Row.ofEff n E 0 fs ++ S)) :
      PDerives Δ Γ (hndExpr n (E.map Prod.fst) H e) (.comp (CTy.effOf S R))
  /-- `[let-poly]`: `let x = λy. b in N` for a closed λ-value, from `N` with the λ-value for `x`,
  `x`'s slot dead.  Each occurrence of the λ-value in `N` is typed on its own, at its own row: the
  kernel's row polymorphism, with the value restriction.  `[spec §24]` -/
  | letPoly {Δ Γ N C} {j : Jdg} (b : Expr) (hcl : closedAt 0 (Val.lam b).1 = true)
      (hV : PDerives Δ [] (.val (.lam b)) j)
      (hN : PDerives Δ (⟨.unit, false⟩ :: Γ) ((N.subst 0 (Val.lam b)).shift 1 0) (.comp C)) :
      PDerives Δ Γ (.app (.val (.lam N)) (.val (.lam b))) (.comp C)
  /-- **R1, the relaxed lend.** `r : Ref T ⊢ withborU d r (Λ. λm. M) : F_Σ (Ref T ⊗ B)`, the
  callback `M` at a row `Σ` of resuming operations (`Row.ResumeO`), typed in `PDerives` with the
  view `m : Mut 'x T` alone in its context. `d : Ref T ⊸ 1` is the owner's finaliser, run when a
  continuation captured inside the callback is cancelled. The side conditions are
  `withbor2U`'s, with the callback's row resuming instead of unwinding. -/
  | lendR {Δ : LifeCtx} {x : LifeVar} {b : Lifetime.Life} {T B : VTy} {d M : Expr} {S : Row}
      (hb : Δ.Defines b) (hx : Δ.find? x = none) (hbx : b.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hT : ¬ VFree x T) (hB : ¬ VFree x B) (hBn : NoThunkT B)
      (hside : ∃ b', Δ.Defines b' ∧ VOutlivesLe Δ b' T)
      (hS : Row.ResumeO S x) (hM1 : closedAt 1 M = true) (hcb : closedAt 0 (lendCb M).1 = true)
      (hdc : closedAt 0 d = true) (hd : PDerives Δ [] d (.val (.lolli (.ref T) .unit)))
      (hM : PDerives (Δ.extend x b) [⟨.mut (.var x) T, true⟩] M
        (.comp (CTy.effOf S (.box (.var x) B)))) :
      PDerives Δ [⟨.ref T, true⟩] (.app (.app (.val (withborUV d)) (.var 0)) (.val (lendCb M)))
        (.comp (CTy.effOf S (.tensor (.ref T) B)))
  /-- **R2, the shared lend over a loop whose state holds the borrow.** `r : Ref A ⊢` the
  per-observation lend of `r` (`lendLoopApp`) `: U(Loop (Ref A ⊗ B) (Ref A ⊗ R))`. At each
  observation `r` is lent `Imm 'x A` at a fresh `'x` below `⊓Δ`, and the step `N` (to continue,
  `B ⊕ S`) or `K` (to close, `R`) runs on the view and the state. The state's type `S` **may
  mention `'x`**: the state holds `imm` views of the place, and what is built from them, between
  observations. `LoopLend` (SPEC §14) requires `S` to outlive `'x`. The steps and the first state
  `s₀` are typed in `PDerives`; the steps see only the pair `(view, state)`.

  Only the `imm` lend: each observation hands the step a fresh view beside the state's, and two
  `imm` views of one place are sound together; two `mut` views are not. -/
  | lendLoopR {Δ : LifeCtx} {x : LifeVar} {A S B R : VTy} {N K s0 : Expr}
      (hx : Δ.find? x = none) (hbx : Δ.meetOfDom.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hA : ¬ VFree x A) (hB : ¬ VFree x B) (hR : ¬ VFree x R) (hBn : NoThunkT B)
      (hRn : NoThunkT R) (hsc : VScoped Δ A)
      (hN1 : closedAt 1 N = true) (hK1 : closedAt 1 K = true) (hs0c : closedAt 0 s0 = true)
      (hN : PDerives (Δ.extend x Δ.meetOfDom) [⟨.tensor (.imm (.var x) A) S, true⟩] N
        (.comp (.ret (.sum B S))))
      (hK : PDerives (Δ.extend x Δ.meetOfDom) [⟨.tensor (.imm (.var x) A) S, true⟩] K
        (.comp (.ret R)))
      (hs0 : PDerives (Δ.extend x Δ.meetOfDom) [] s0 (.val S)) :
      PDerives Δ [⟨.ref A, true⟩] (lendLoopApp A B R N K s0)
        (.comp (CTy.loop (.tensor (.ref A) B) (.tensor (.ref A) R)))

end BoCa.Fig16.LogRel.Core.AsyncCap

