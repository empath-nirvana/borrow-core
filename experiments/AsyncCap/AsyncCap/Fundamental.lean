  | withswap hΓ => exact withswap_compatX hΓ
  | withbor1U x hΓ _ hsc₁ hf₁ hf₂ hS hdc _ ihd => exact withbor1U_compatX x hΓ hsc₁ hf₁ hf₂ hS hdc ihd
  | withbor2U x hΓ _ hside hf₁ hf₂ hS hdc _ ihd =>
      exact withbor2U_compatX x hΓ hside hf₁ hf₂ hS hdc ihd
  | withbor3U x hΓ _ hf₁ hf₂ hS hdc _ ihd => exact withbor3U_compatX x hΓ hf₁ hf₂ hS hdc ihd
  | withloadU x hΓ _ hf₁ hf₂ hS => exact withloadU_compatX x hΓ hf₁ hf₂ hS
  | sliceBorrowMU x hΓ hA hB hf₁ hf₂ hS hdc _ ihd =>
      exact sliceBorrowMU_compatX x hΓ hA hB hf₁ hf₂ hS hdc ihd
  | sliceBorrowIU x hΓ hsc hA hB hf₁ hf₂ hS hdc _ ihd =>
      exact sliceBorrowIU_compatX x hΓ hsc hA hB hf₁ hf₂ hS hdc ihd
  | lolliE hs _ _ iha ihf => exact lolliE_compatX hs iha ihf
  | allEV _ hlt ih => exact allE_compatX ih hlt
  | ofRet _ ih => exact ih
  | roll hA hc _ ih => exact roll_compatX hA hc ih
  | unroll _ ih => exact unroll_compatX ih
  | foldImm F y c R hΓ hF hG hyM hyR hR => exact foldImm_compatX F hF hG y c R hΓ hyM hyR hR
  | foldOwn F R hΓ hF hG => exact foldOwn_compatX F hF hG R hΓ
  | foldReuse F R hΓ hF hG => exact foldReuse_compatX F hF hG R hΓ
  | nuIn hC _ ih => exact nuIn_compatX hC ih
  | nuOut hC _ ih => exact nuOut_compatX hC ih
  | unfoldN C S hC hΓ => exact unfold_compatX hC S hΓ
  | effSub hle _ ih => exact sub_compatC hle ih
  | effPerform hf hna _ ih => exact perform_compatC hf hna ih
  | effRaise hf ha hd _ ih => exact raise_compatC hf ha (fun _ _ _ _ h => vC_noOwn_of_drop hd h) ih
  | effLet hs hW hU _ _ ihM ihN => exact let_compatC hs hW hU ihM ihN
  | effThen hs hNZ _ hU hMS hDS hfin hP _ _ _ ihM ihN ihD =>
      exact then_compatC hs hNZ hU hMS hDS hfin hP ihM ihN ihD
  | effHandleV hs hd hH _ hn0 hnS hlen _ ihc ihe =>
      exact handleV_compatC hs hd hH ihc hn0 hnS hlen ihe
  | letPoly b hcl _ _ _ ihN => exact letPoly_compatC (Val.lam b) hcl ihN
  | lendR hb hx hbx hΔx hT hB hBn hside hS hM1 hcb hdc _ hM ihd _ =>
      exact hPin.stop _ _ _ _ _ _ _ _ hb hx hbx hΔx hT hB hBn hside hS hM1 hcb hdc ihd hM
  | lendLoopR hx hbx hΔx hA hB hR hBn hRn hsc hN1 hK1 hs0c hN hK hs0 _ _ _ =>
      exact hPin.loop _ _ _ _ _ _ _ _ _ hx hbx hΔx hA hB hR hBn hRn hsc hN1 hK1 hs0c hN hK hs0

/-- **Adequacy under `PinLaw`**: a closed `PDerives` computation of `F 1` runs from the empty
memory to `()` and the empty memory. -/
theorem adequacyC_pin (hPin : PinLaw (ℍ := ℍ)) {e : Expr}
    (h : PDerives LifeCtx.empty [] e (.comp (.ret .unit))) :
    BoCa.BoLo.Steps Adequacy.emptyMem e Adequacy.emptyMem (.val .unit) :=
  corollary33 e (fundamentalC_pin hPin h)

/-- **Adequacy on every run, under `PinLaw`**: every run of a closed `PDerives` computation of
`F 1` from the empty memory continues to `()` at the empty memory. -/
theorem adequacyD_pin (hPin : PinLaw (ℍ := ℍ)) {e : Expr}
    (h : PDerives LifeCtx.empty [] e (.comp (.ret .unit)))
    {μ₁ : Heap} {e₁ : Expr} (hs : Steps Adequacy.emptyMem e μ₁ e₁) :
    Steps μ₁ e₁ Adequacy.emptyMem (.val .unit) := by
  have hwp := fundamentalC_pin hPin h LSub.empty [] [] PMap.empty Adequacy.models_empty
    (gDenC_nil _ _)
  have hwp' : wpTS [] e (fun _ v => Fig16.BoLo.pure (v = Val.unit)) (PMap.empty : WRes) := by
    have he : substAll [] e = e := Adequacy.psub_nil 0 e
    rw [he] at hwp
    exact hwp
  obtain ⟨v, hsteps, rfl⟩ := theorem32D e (· = Val.unit) hwp' hs
  exact hsteps

/-- **No stuck state, under `PinLaw`.** -/
theorem adequacyD_pin_safe (hPin : PinLaw (ℍ := ℍ)) {e : Expr}
    (h : PDerives LifeCtx.empty [] e (.comp (.ret .unit)))
    {μ₁ : Heap} {e₁ : Expr} (hs : Steps Adequacy.emptyMem e μ₁ e₁) :
    IsVal e₁ ∨ ∃ μ₂ e₂, Step1 μ₁ e₁ μ₂ e₂ := by
  cases adequacyD_pin hPin h hs with
  | refl => exact .inl Val.unit.2
  | more h _ => exact .inr ⟨_, _, h⟩

