-- S2 (SEMANTIC): the wrong round's value added at `K_right`. A patch of `a1b-async-tree-array.bc` (`h3/bugs.py`).
-- H1 (iii), variant b: `a1-async-tree.bc` with the frames in an owned array (`array Frame` and
-- its height) in place of the `mu` list: a push is `array_replace` at the height, a pop at the
-- height less one, and a full array is moved into one twice its size (`grow`). The choice of
-- representation is made in core, so the kernel checks it: the array is owned by the state,
-- moved, never borrowed across an `await`. No new type former.
--
-- Rule sketch: as `a1-async-tree.bc`, with
--   [frames-array] the frame list of a machine ↦ `array Frame * i32`, push/pop by `array_replace`,
--                  growth by doubling (`count_fold` of moves).
--
-- Answer: as `src-async-tree.bc`.

def value : !(i32 * i32 => i32) =
  !thunkv fun (p : i32 * i32) ->
      let (k, r) = p;
      x <- return (unbang host[add32]) ((unbang host[mul32]) (k, i32[7919]), r);
      case (unbang host[rem_s32]) (x, i32[1000]) { inl q -> return q | inr u -> return i32[0] }

type Frame = (i32 * (i32 * i32)) + (i64 * (i32 * i32))
type Stack = array Frame * i32

def zf : !(i32 => Frame) = !thunkv fun (i : i32) -> return (inl (i32[0], (i32[0], i32[0])) : Frame)

-- Move slot `i` of the old array into the new one.
def mv : !(i32 * (array Frame * array Frame) => array Frame * array Frame) =
  !thunkv fun (p : i32 * (array Frame * array Frame)) ->
      let (i, q) = p;
      let (o, n) = q;
      t <- return (unbang array_replace[Frame]) (o, (i, (inl (i32[0], (i32[0], i32[0])) : Frame)));
      let (o2, x) = t;
      case x {
        inl fr -> t2 <- return (unbang array_replace[Frame]) (n, (i, fr));
          let (n2, y) = t2;
          return (o2, n2)
      | inr fr -> return (o2, n)
      }

-- `fr` pushed; a full array first moved into one twice its size.
def push : !(Stack * Frame => Stack) =
  !thunkv fun (p : Stack * Frame) ->
      let (st, fr) = p;
      let (a, sp) = st;
      sz <- return (unbang array_size[Frame]) a;
      let (a1, len) = sz;
      a2 <- case (unbang host[lt_s32]) (sp, len) {
          inl full -> n0 <- return (unbang array_new[Frame]) ((unbang host[mul32]) (len, i32[2]), zf);
            r <- return (unbang count_fold[array Frame * array Frame]) (mv, (len, (i32[0], (a1, n0))));
            let (o, n) = r;
            return n
        | inr room -> return a1
        };
      t <- return (unbang array_replace[Frame]) (a2, (sp, fr));
      let (a3, old) = t;
      return (a3, (unbang host[add32]) (sp, i32[1]))

-- The top frame popped, or `inr` the empty stack.
def pop : !(Stack => Frame * Stack + Stack) =
  !thunkv fun (st : Stack) ->
      let (a, sp) = st;
      case (unbang host[lt_s32]) (i32[0], sp) {
        inl empty -> return (inr (a, sp) : Frame * Stack + Stack)
      | inr some -> sp1 <- return (unbang host[sub32]) (sp, i32[1]);
          t <- return (unbang array_replace[Frame]) (a, (sp1, (inl (i32[0], (i32[0], i32[0])) : Frame)));
          let (a2, x) = t;
          case x {
            inl fr -> return (inl (fr, (a2, sp1)) : Frame * Stack + Stack)
          | inr fr -> return (inr (a2, sp1) : Frame * Stack + Stack)
          }
      }
-- The task at its `await`: (a, (m, (hi, (r, frames)))).
type St = i64 * (i32 * (i32 * (i32 * Stack)))
-- The drive's argument: run `tsum(lo, hi, r)` under the frames, or return `v` to them.
type D = (i32 * (i32 * (i32 * Stack))) + (i64 * Stack)
-- The drive's answer: finished with a value, at an `await`, or the budget spent.
type Out = i64 + (St + 1)

def drive_step : !U ((1 + !U (1 -o D -o F Out)) * 1 -o D -o F Out) =
  !thunkv fun (sp0 : (1 + !U (1 -o D -o F Out)) * 1) ->
      let (self, u) = sp0;
      let () = u;
      fun (d : D) ->
        case self {
          inl x -> return (inr (inr () : St + 1) : Out)
        | inr g -> case d {
              inl go -> let (lo, q) = go;
                let (hi, q2) = q;
                let (r, stk) = q2;
                case (unbang host[lt_s32]) (lo, hi) {
                  inl e -> a : D <- return inr (i64[0], stk);
                    f <- return unbang g;
                    z <- return ();
                    force f z a
                | inr t -> h2 <- case (unbang host[div_s32]) ((unbang host[sub32]) (hi, lo), i32[2]) {
                        inl dd -> return dd
                      | inr dd -> return i32[0]
                      };
                    m <- return (unbang host[add32]) (lo, h2);
                    fr : Frame <- return inl (m, (hi, r));
                    stk2 <- return (unbang push) (stk, fr);
                    a : D <- return inl (lo, (m, (r, stk2)));
                    f <- return unbang g;
                    z <- return ();
                    force f z a
                }
            | inr rt -> let (v, stk) = rt;
                case (unbang pop) stk {
                  inl fs -> let (fr, rest) = fs;
                    case fr {
                      inl kl -> let (m, q) = kl;
                        let (hi, r) = q;
                        return (inr (inl (v, (m, (hi, (r, rest)))) : St + 1) : Out)
                    | inr kr -> let (a, q) = kr;
                        let (m, r) = q;
                        w <- return (unbang host[add64]) ((unbang host[add64]) (a, (unbang host[extend_s]) ((unbang value) (m, i32[0]))), v);
                        a2 : D <- return inr (w, rest);
                        f <- return unbang g;
                        z <- return ();
                        force f z a2
                    }
                | inr e -> return (inl v : Out)
                }
            }
        }

def drive : !U (D -o F Out) =
  !thunkv fun (d : D) ->
      st <- return drive_step;
      bf <- return unbang bounded_fix[1, D -o F Out];
      ba <- return (st, (i32[10000], ()));
      force bf ba d

-- The task's state after a step: its value (`-1` at the budget's end, `on_exhausted`) or its `await`.
def settle : !(Out => i64 + St) =
  !thunkv fun (o : Out) ->
      case o {
        inl v -> return (inl v : i64 + St)
      | inr w -> case w {
          inl k -> return (inr k : i64 + St)
        | inr u -> return (inl (unbang host[sub64]) (i64[0], i64[1]) : i64 + St)
        }
      }

-- `κ`'s resume: the rest after the `await`: the right call under `K_right (a, m, r)`.
def adv : !(St => i64 + St) =
  !thunkv fun (k : St) ->
      let (a, q) = k;
      let (m, q2) = q;
      let (hi, q3) = q2;
      let (r, stk) = q3;
      fr : Frame <- return inr (a, (m, r));
      stk2 <- return (unbang push) (stk, fr);
      dv : D <- return inl ((unbang host[add32]) (m, i32[1]), (hi, (r, stk2)));
      dr <- return unbang drive;
      o <- force dr dv;
      return (unbang settle) o

-- `with spawn { task(n, r) }`: the task run to its first `await`.
def spawn0 : !(i32 * i32 => i64 + St) =
  !thunkv fun (p : i32 * i32) ->
      let (n, r) = p;
      dv : D <- return inl (i32[0], (n, (r, ((unbang array_new[Frame]) (i32[64], zf), i32[0]))));
      dr <- return unbang drive;
      o <- force dr dv;
      return (unbang settle) o

fn spawn_r(r: i32) -> i64 + St = spawn0(200, r)

-- Round robin over the slots until none is pending, then the values summed (p3c's scheduler).
main -> i64 =
  let tasks = 3;
  let mut ts = array_new[i64 + St] (tasks, spawn_r);
  let mut more = true;
  while more {
    more = false;
    for i in 0..tasks {
      let (t2, old) = array_replace[i64 + St] (ts, i, (inl i64[0] : i64 + St));
      ts = t2;
      match old {
        inl cur -> match cur {
            inl v -> let (t3, _) = array_replace[i64 + St] (ts, i, (inl v : i64 + St)); ts = t3
          | inr k -> match adv(k) {
              inl v -> let (t3, _) = array_replace[i64 + St] (ts, i, (inl v : i64 + St)); ts = t3
            | inr k2 -> more = true; let (t3, _) = array_replace[i64 + St] (ts, i, (inr k2 : i64 + St)); ts = t3
            }
          }
      | inr back -> ()
      }
    }
  };
  let mut acc = i64[0];
  for i in 0..tasks {
    let (t2, old) = array_replace[i64 + St] (ts, i, (inl i64[0] : i64 + St));
    ts = t2;
    match old {
      inl cur -> match cur { inl v -> acc = acc + v | inr k -> () }
    | inr back -> ()
    }
  };
  acc
