-- bug SEMANTIC wrong-winner: b's win reported as a's
-- H4a: `corpus/async-race.bc` as effect-free core, tasks of different bodies (`lookup`, `sleeper`)
-- in one type `Task[i32]`, through the existential `ν` already provides: each body's `κ` is
-- defunctionalised into an `unfold` at ITS OWN state type (`lookup`: the buffer it owns and the
-- awaits left; `sleeper`: the awaits left), and `unfold`'s value at `nu X. F (i32 + box top U X) &
-- F 1` hides that type. `race` resumes and cancels them through the observations alone, so one
-- `race` serves both bodies, and a resume is an indirect call (a closure of one of two codes).
--
-- Rules, one per construct:
-- * `with spawn { M }`: run `M` to its first `await`; `inl v` gives a finished task, `inr κ`
--   `boxed[top]` of the body's machine (`unfold` at the body's state, `kappa_resume_steps`).
-- * `for _ in 0..steps { await() }` at the row `Async`: the counter is in the state; each
--   observation is one turn up to the next `await` (§14 loop as `unfold`).
-- * The body's owned `buf`, live across the `await`s: owned by the state; `close` frees it
--   (`kappa_cancel_steps`: its destructor, the region's finaliser).
-- * `race`'s recursion under `on_exhausted`: `bounded_fix` with the abort a summand `+ 1`
--   (`catch_abort`); the `with on_exhausted` is a `case` on it.
-- * `race[A]` at `A = i32`: the template's instance (§15).
--
-- Answer: `(inl i32[30], inr ())`, `live 0`.
include async

def plus : i32 * i32 => i32 = unbang host[add32]
def minus : i32 * i32 => i32 = unbang host[sub32]

type TaskU = U (nu X. F (i32 + box top U X) & F 1)

-- `lookup(key, steps)`: state (buf, awaits left after this one).
type LS = ref i32 * i32
def lookup_step : !U (LS -o F (i32 + box top LS) & F 1) =
  !thunkv fun (s : LS) ->
      < let (buf, left) = s;
        case (unbang host[lt_s32]) (i32[0], left) {
          inl ge -> v <- return (free[i32] buf);
            return (inl (unbang host[mul32]) (v, i32[10]) : i32 + box top LS)
        | inr lt -> return (inr boxed[top] ((buf, minus (left, i32[1])) : LS) : i32 + box top LS)
        },
        let (buf, left) = s;
        w <- return (free[i32] buf);
        return () >

def finished : !(i32 => Task[i32]) =
  !thunkv fun (v : i32) ->
      return boxed[top] (thunkv nu_in < return (inl v : i32 + box top TaskU), return () >)

def spawn_lookup : !(i32 * i32 => Task[i32]) =
  !thunkv fun (p : i32 * i32) ->
      let (key, steps) = p;
      buf <- return (alloc[i32] key);
      case (unbang host[lt_s32]) (i32[0], steps) {
        inl ge -> v <- return (free[i32] buf); return (unbang finished) ((unbang host[mul32]) (v, i32[10]))
      | inr lt -> s0 : LS <- return (buf, minus (steps, i32[1]));
          f <- return unfold[nu X. F (i32 + box top U X) & F 1, LS] lookup_step;
          return boxed[top] (thunkv nu_in < fu <- return unbang f; (nu_out force fu s0).1,
              fu <- return unbang f; (nu_out force fu s0).2 >)
      }

-- `sleeper(steps)`: state (awaits left after this one).
def sleeper_step : !U (i32 -o F (i32 + box top i32) & F 1) =
  !thunkv fun (left : i32) ->
      < case (unbang host[lt_s32]) (i32[0], left) {
          inl ge -> return (inl i32[0] : i32 + box top i32)
        | inr lt -> return (inr boxed[top] minus (left, i32[1]) : i32 + box top i32)
        },
        return () >

def sleeping : !(i32 => Task[i32]) =
  !thunkv fun (steps : i32) ->
      case (unbang host[lt_s32]) (i32[0], steps) {
        inl ge -> return (unbang finished) i32[0]
      | inr lt -> s0 : i32 <- return minus (steps, i32[1]);
          f <- return unfold[nu X. F (i32 + box top U X) & F 1, i32] sleeper_step;
          return boxed[top] (thunkv nu_in < fu <- return unbang f; (nu_out force fu s0).1,
              fu <- return unbang f; (nu_out force fu s0).2 >)
      }

def resume_t : !(Task[i32] => i32 + Task[i32]) =
  !thunkv fun (t : Task[i32]) -> g <- return (unbox t); (nu_out (force g)).1

def cancel_t : !(Task[i32] => 1) =
  !thunkv fun (t : Task[i32]) -> g <- return (unbox t); (nu_out (force g)).2

type RA = Task[i32] * (Task[i32] * i32)
type RR = i32 + (i32 + 1)

-- `race`'s generator: its recursive call is the self-reference; the end of the budget is `inr ()`.
def race_step : !U ((1 + !U (1 -o RA -o F (RR + 1))) * 1 -o RA -o F (RR + 1)) =
  !thunkv fun (sp0 : (1 + !U (1 -o RA -o F (RR + 1))) * 1) ->
      let (self, u) = sp0;
      let () = u;
      fun (p : RA) ->
        let (a, q) = p;
        let (b, turns) = q;
        case (unbang host[eq32]) (turns, i32[0]) {
          inl ne -> ra <- return (unbang resume_t) a;
            case ra {
              inl v -> x <- return (unbang cancel_t) b; return (inl (inl v : RR) : RR + 1)
            | inr a2 -> rb <- return (unbang resume_t) b;
                case rb {
                  inl w -> x <- return (unbang cancel_t) a2; return (inl (inl w : RR) : RR + 1)
                | inr b2 -> case self {
                    inl z -> x <- return (unbang cancel_t) a2; y <- return (unbang cancel_t) b2;
                      return (inr () : RR + 1)
                  | inr g -> f <- return unbang g;
                      z <- return ();
                      n <- return (a2, (b2, minus (turns, i32[1])));
                      force f z n
                  }
                }
            }
        | inr eq -> x <- return (unbang cancel_t) a; y <- return (unbang cancel_t) b;
            return (inl (inr (inr () : i32 + 1) : RR) : RR + 1)
        }

def race : !U (RA -o F (RR + 1)) =
  !thunkv fun (p : RA) ->
      st <- return race_step;
      bf <- return unbang bounded_fix[1, RA -o F (RR + 1)];
      ba <- return (st, (i32[10000], ()));
      force bf ba p

def timeout : !(Task[i32] * i32 => (i32 + 1) + 1) =
  !thunkv fun (p : Task[i32] * i32) ->
      let (t, steps) = p;
      s <- return (unbang sleeping) steps;
      rc <- return unbang race;
      a <- return (t, (s, plus (steps, i32[1])));
      r <- force rc a;
      case r {
        inl rr -> case rr {
            inl v -> return (inl (inl v : i32 + 1) : (i32 + 1) + 1)
          | inr e -> return (inl (inr () : i32 + 1) : (i32 + 1) + 1)
          }
      | inr x -> return (inr () : (i32 + 1) + 1)
      }

main : F (RR * (i32 + 1)) =
  a <- return (unbang spawn_lookup) (i32[3], i32[3]);
  b <- return (unbang spawn_lookup) (i32[4], i32[6]);
  c <- return (unbang spawn_lookup) (i32[5], i32[3]);
  rc <- return unbang race;
  ab <- return (a, (b, i32[10]));
  first <- force rc ab;
  case first {
    inl fr -> late <- return (unbang timeout) (c, i32[2]);
      case late {
        inl lt -> return (fr, lt)
      | inr x -> return ((inr (inr () : i32 + 1) : RR), (inr () : i32 + 1))
      }
  | inr x -> return ((inr (inr () : i32 + 1) : RR), (inr () : i32 + 1))
  }
