-- Union-find with path compression, the parent table an owned array threaded through every
-- operation (the `&mut self` API). Rust's `find(&self)` with `Vec<Cell<usize>>` becomes
-- `find : A * i32 => A * i32`: the caller hands the table in and gets it back.
--
-- Unions (0,1), (1,2), (2,3), (4,5), (6,7), (5,7) over 8 elements, linking root to root, build
-- the chain 0 -> 1 -> 2 -> 3. `find 0` returns 3 and compresses: parent[0] is 1 before and 3
-- after. Then same(0,3), same(0,4), same(4,6) and the number of components.
--
-- Answer: (1, (3, (1, (0, (1, 2))))) as i32s. Every walk is bounded by the table's size (a
-- path is shorter than the table), so each is a fixed composition of its step and every
-- function here is total. `uf-fuel.bc` is the same program with the walks as loops under
-- `div_fuel`.

type A = array i32

def ident : !(i32 => i32) = !thunkv fun (i : i32) -> return i

-- Slot `i` read by taking it out and putting it back; 0 out of range.
def get : A * i32 => A * i32 =
  thunkv fun (p : A * i32) ->
    let (a, i) = p;
    q <- return ((unbang array_replace[i32]) (a, (i, i32[0])));
    let (a1, o) = q;
    case o {
      inl x ->
        q2 <- return ((unbang array_replace[i32]) (a1, (i, x)));
        let (a2, o2) = q2;
        return (a2, x)
    | inr z -> return (a1, i32[0])
    }

def set : A * (i32 * i32) => A =
  thunkv fun (p : A * (i32 * i32)) ->
    q <- return ((unbang array_replace[i32]) p);
    let (a, o) = q;
    return a

-- Bounded iteration without a loop: `twice` composes a step with itself, so `eight f` is f
-- applied 8 times, the table's size. Each step is the identity once its walk is done.
type S = A * (i32 * i32)

def twice : !(S => S) => !(S => S) =
  thunkv fun (f : !(S => S)) -> return (!thunkv fun (s : S) -> return ((unbang f) ((unbang f) s)))

def eight : !(S => S) => !(S => S) =
  thunkv fun (f : !(S => S)) -> return (twice (twice (twice f)))

-- Walk to the root: (table, (x, _)) moves x to its parent; at the root it stays.
def root_step : !(S => S) =
  !thunkv fun (s : S) ->
    let (a, r) = s;
    let (x, z) = r;
    q <- return (get (a, x));
    let (a1, p) = q;
    return (a1, (p, z))

-- Compress: (table, (x, root)) points x at the root and moves to its old parent.
def comp_step : !(S => S) =
  !thunkv fun (s : S) ->
    let (a, r) = s;
    let (x, root) = r;
    case (unbang host[eq32]) (x, root) {
      inl ne ->
        q <- return (get (a, x));
        let (a1, p) = q;
        a2 <- return (set (a1, (x, root)));
        return (a2, (p, root))
    | inr eq -> return (a, (x, root))
    }

def find : A * i32 => A * i32 =
  thunkv fun (p : A * i32) ->
    let (a, x) = p;
    r <- return ((unbang (eight root_step)) (a, (x, i32[0])));
    let (a1, r1) = r;
    let (root, z) = r1;
    q <- return ((unbang (eight comp_step)) (a1, (x, root)));
    let (a2, r2) = q;
    return (a2, root)

def union : A * (i32 * i32) => A =
  thunkv fun (p : A * (i32 * i32)) ->
    let (a, r) = p;
    let (x, y) = r;
    q1 <- return (find (a, x));
    let (a1, rx) = q1;
    q2 <- return (find (a1, y));
    let (a2, ry) = q2;
    a3 <- return (set (a2, (rx, ry)));
    return a3

def bit : 1 + 1 => i32 =
  thunkv fun (b : 1 + 1) -> case b { inl u -> return i32[0] | inr u -> return i32[1] }

def same : A * (i32 * i32) => A * i32 =
  thunkv fun (p : A * (i32 * i32)) ->
    let (a, r) = p;
    let (x, y) = r;
    q1 <- return (find (a, x));
    let (a1, rx) = q1;
    q2 <- return (find (a1, y));
    let (a2, ry) = q2;
    return (a2, bit ((unbang host[eq32]) (rx, ry)))

-- Components: (table, (i, count)) over i < 8, counting the roots.
def count_step : !(S => S) =
  !thunkv fun (s : S) ->
    let (a, r) = s;
    let (i, n) = r;
    q <- return (get (a, i));
    let (a1, p) = q;
    n2 <- return ((unbang host[add32]) (n, bit ((unbang host[eq32]) (p, i))));
    return (a1, ((unbang host[add32]) (i, i32[1]), n2))

main : F (i32 * (i32 * (i32 * (i32 * (i32 * i32))))) =
  a <- return ((unbang array_new[i32]) (i32[8], ident));
  a1 <- return (union (a, (i32[0], i32[1])));
  a2 <- return (union (a1, (i32[1], i32[2])));
  a3 <- return (union (a2, (i32[2], i32[3])));
  a4 <- return (union (a3, (i32[4], i32[5])));
  a5 <- return (union (a4, (i32[6], i32[7])));
  a6 <- return (union (a5, (i32[5], i32[7])));
  q0 <- return (get (a6, i32[0]));
  let (a7, before) = q0;
  q1 <- return (find (a7, i32[0]));
  let (a8, r0) = q1;
  q2 <- return (get (a8, i32[0]));
  let (a9, after) = q2;
  q3 <- return (same (a9, (i32[0], i32[3])));
  let (a10, s03) = q3;
  q4 <- return (same (a10, (i32[0], i32[4])));
  let (a11, s04) = q4;
  q5 <- return (same (a11, (i32[4], i32[6])));
  let (a12, s46) = q5;
  q6 <- return ((unbang (eight count_step)) (a12, (i32[0], i32[0])));
  let (a13, r6) = q6;
  let (i, n) = r6;
  return (before, (after, (s03, (s04, (s46, n)))))
