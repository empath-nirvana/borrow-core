-- A tree with parent pointers as an arena with typed indices. Rust's `Rc<Node>` with a
-- `RefCell<Weak<Node>>` parent and `RefCell<Vec<Rc<Node>>>` children becomes one array of
-- nodes `(parent, value)`, a node's id being its index and the root's parent -1, with the
-- number of nodes in use. Adding a node writes the next slot; walking to the root follows
-- parent indices. There is no reference count and no `Weak`: a parent link is an index, and
-- the arena owns every node. Children are not stored; a node's children are the slots whose
-- parent is its id (Rust keeps both directions, and each is a `RefCell` for that reason).
--
-- Nodes 0..5 with values 1..6: 0 is the root, 1 and 2 its children, 3 a child of 1, 4 of 3,
-- 5 of 4. Answer: (i32[4], (i32[18], i32[4])), as `rs/tree.rs`: node 5's depth, the sum of
-- the values from it to the root, and its parent's id.

type N = i32 * i32
type Ar = array N * i32
type Id = i32
type W = Ar * (Id * (i32 * i32))

def add : i32 * i32 => i32 = unbang host[add32]
def empty : !(i32 => N) = !thunkv fun (i : i32) -> return (i32[4294967295], i32[0])

-- Node `i`, read by taking it out and putting it back; a detached node out of range.
def node_at : Ar * Id => Ar * N =
  thunkv fun (p : Ar * Id) ->
    let (ar, i) = p;
    let (a, len) = ar;
    q <- return ((unbang array_replace[N]) (a, (i, (i32[4294967295], i32[0]))));
    let (a1, o) = q;
    case o {
      inl x ->
        q2 <- return ((unbang array_replace[N]) (a1, (i, x)));
        let (a2, o2) = q2;
        return ((a2, len), x)
    | inr z -> return ((a1, len), (i32[4294967295], i32[0]))
    }

-- A new node under `parent`; its id is the next free slot.
def new_node : Ar * (Id * i32) => Ar * Id =
  thunkv fun (p : Ar * (Id * i32)) ->
    let (ar, r) = p;
    let (a, len) = ar;
    q <- return ((unbang array_replace[N]) (a, (len, r)));
    let (a1, o) = q;
    return ((a1, add (len, i32[1])), len)

-- One step towards the root at (arena, (cur, (depth, sum))); at -1 it stays.
def up_step : !(W => W) =
  !thunkv fun (w : W) ->
    let (ar, r) = w;
    let (cur, r2) = r;
    let (d, s) = r2;
    case (unbang host[lt_s32]) (cur, i32[0]) {
      inl live ->
        q <- return (node_at (ar, cur));
        let (ar2, n) = q;
        let (par, v) = n;
        return (ar2, (par, (add (d, i32[1]), add (s, v))))
    | inr done -> return (ar, (cur, (d, s)))
    }

def twice : !(W => W) => !(W => W) =
  thunkv fun (f : !(W => W)) -> return (!thunkv fun (w : W) -> return ((unbang f) ((unbang f) w)))

-- Depth and path sum, for trees of depth below 8.
def depth_and_sum : Ar * Id => Ar * (i32 * i32) =
  thunkv fun (p : Ar * Id) ->
    let (ar, id) = p;
    w <- return ((unbang (twice (twice (twice up_step)))) (ar, (id, (i32[4294967295], i32[0]))));
    let (ar2, r) = w;
    let (cur, ds) = r;
    return (ar2, ds)

main : F (i32 * (i32 * i32)) =
  a <- return ((unbang array_new[N]) (i32[8], empty));
  q0 <- return (new_node ((a, i32[0]), (i32[4294967295], i32[1])));
  let (ar0, n0) = q0;
  q1 <- return (new_node (ar0, (n0, i32[2])));
  let (ar1, n1) = q1;
  q2 <- return (new_node (ar1, (n0, i32[3])));
  let (ar2, n2) = q2;
  q3 <- return (new_node (ar2, (n1, i32[4])));
  let (ar3, n3) = q3;
  q4 <- return (new_node (ar3, (n3, i32[5])));
  let (ar4, n4) = q4;
  q5 <- return (new_node (ar4, (n4, i32[6])));
  let (ar5, n5) = q5;
  q6 <- return (depth_and_sum (ar5, n5));
  let (ar6, ds) = q6;
  let (d, s) = ds;
  q7 <- return (node_at (ar6, n5));
  let (ar7, n) = q7;
  let (par, v) = n;
  return (d, (s, par))
