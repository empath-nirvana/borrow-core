-- Breadth-first search with the visited marks in an owned array threaded through the loop.
-- Rust's nodes carry `visited: Cell<bool>` and `dist: Cell<i32>`, so the search needs only
-- `&Graph`; here the graph (an adjacency matrix), the distances (-1 for unvisited: the visited
-- flag and the distance in one slot) and the queue are arrays the search owns and hands back.
-- The outer loop pops a node, the inner one scans its row; each is a fixed composition of its
-- step (8 pops, 8 columns), which covers these six nodes.
--
-- Edges 0-1, 0-2, 1-3, 2-3, 3-4; node 5 is unreachable. Answer: (i32[3], (i32[5], i32[7])),
-- as `rs/bfs.rs`: the distance to 4, the nodes reached, and the sum of their distances.

type A = array i32
type B = A * (A * (A * (i32 * i32)))
type IS = B * (i32 * i32)
type CS = A * (i32 * (i32 * i32))

def add : i32 * i32 => i32 = unbang host[add32]
def mul : i32 * i32 => i32 = unbang host[mul32]
def zero : !(i32 => i32) = !thunkv fun (i : i32) -> return i32[0]
def unvisited : !(i32 => i32) = !thunkv fun (i : i32) -> return i32[4294967295]

def get : A * i32 => A * i32 =
  thunkv fun (p : A * i32) ->
    let (a, i) = p;
    q <- return ((unbang array_replace[i32]) (a, (i, i32[0])));
    let (a1, o) = q;
    case o {
      inl x ->
        q2 <- return ((unbang array_replace[i32]) (a1, (i, x)));
        let (a2, o2) = q2;
        return (a2, x)
    | inr z -> return (a1, i32[0])
    }

def set : A * (i32 * i32) => A =
  thunkv fun (p : A * (i32 * i32)) ->
    q <- return ((unbang array_replace[i32]) p);
    let (a, o) = q;
    return a

def edge : A * (i32 * i32) => A =
  thunkv fun (p : A * (i32 * i32)) ->
    let (g, r) = p;
    let (x, y) = r;
    g1 <- return (set (g, (add (mul (x, i32[6]), y), i32[1])));
    return (set (g1, (add (mul (y, i32[6]), x), i32[1])))

-- Column v of row u: if u-v is an edge and v is unvisited, v gets dist[u] + 1 and is queued.
def scan_step : !(IS => IS) =
  !thunkv fun (s : IS) ->
    let (b, uv) = s;
    let (u, v) = uv;
    let (g, r) = b;
    let (d, r2) = r;
    let (q, ht) = r2;
    let (h, t) = ht;
    case (unbang host[lt_s32]) (v, i32[6]) {
      inl past -> return ((g, (d, (q, (h, t)))), (u, v))
    | inr col ->
        e <- return (get (g, add (mul (u, i32[6]), v)));
        let (g1, isEdge) = e;
        x <- return (get (d, v));
        let (d1, dv) = x;
        y <- return (get (d1, u));
        let (d2, du) = y;
        case (unbang host[eqz32]) isEdge {
          inl edge_ ->
            case (unbang host[lt_s32]) (dv, i32[0]) {
              inl seen -> return ((g1, (d2, (q, (h, t)))), (u, add (v, i32[1])))
            | inr fresh ->
                d3 <- return (set (d2, (v, add (du, i32[1]))));
                q1 <- return (set (q, (t, v)));
                return ((g1, (d3, (q1, (h, add (t, i32[1]))))), (u, add (v, i32[1])))
            }
        | inr none -> return ((g1, (d2, (q, (h, t)))), (u, add (v, i32[1])))
        }
    }

def twiceI : !(IS => IS) => !(IS => IS) =
  thunkv fun (f : !(IS => IS)) -> return (!thunkv fun (s : IS) -> return ((unbang f) ((unbang f) s)))

-- Pop the next queued node, if any, and scan its row.
def pop_step : !(B => B) =
  !thunkv fun (b : B) ->
    let (g, r) = b;
    let (d, r2) = r;
    let (q, ht) = r2;
    let (h, t) = ht;
    case (unbang host[lt_s32]) (h, t) {
      inl empty -> return (g, (d, (q, (h, t))))
    | inr more ->
        x <- return (get (q, h));
        let (q1, u) = x;
        s <- return ((unbang (twiceI (twiceI (twiceI scan_step))))
               ((g, (d, (q1, (add (h, i32[1]), t)))), (u, i32[0])));
        let (b2, uv) = s;
        return b2
    }

def twiceB : !(B => B) => !(B => B) =
  thunkv fun (f : !(B => B)) -> return (!thunkv fun (s : B) -> return ((unbang f) ((unbang f) s)))

-- (dist, (i, (reached, sum))) over the six nodes.
def count_step : !(CS => CS) =
  !thunkv fun (c : CS) ->
    let (d, r) = c;
    let (i, r2) = r;
    let (n, sum) = r2;
    case (unbang host[lt_s32]) (i, i32[6]) {
      inl past -> return (d, (i, (n, sum)))
    | inr node_ ->
        x <- return (get (d, i));
        let (d1, di) = x;
        case (unbang host[lt_s32]) (di, i32[0]) {
          inl reached -> return (d1, (add (i, i32[1]), (add (n, i32[1]), add (sum, di))))
        | inr not -> return (d1, (add (i, i32[1]), (n, sum)))
        }
    }

def twiceC : !(CS => CS) => !(CS => CS) =
  thunkv fun (f : !(CS => CS)) -> return (!thunkv fun (s : CS) -> return ((unbang f) ((unbang f) s)))

main : F (i32 * (i32 * i32)) =
  g0 <- return ((unbang array_new[i32]) (i32[36], zero));
  g1 <- return (edge (g0, (i32[0], i32[1])));
  g2 <- return (edge (g1, (i32[0], i32[2])));
  g3 <- return (edge (g2, (i32[1], i32[3])));
  g4 <- return (edge (g3, (i32[2], i32[3])));
  g <- return (edge (g4, (i32[3], i32[4])));
  d0 <- return ((unbang array_new[i32]) (i32[6], unvisited));
  d <- return (set (d0, (i32[0], i32[0])));
  q0 <- return ((unbang array_new[i32]) (i32[8], zero));
  b <- return ((unbang (twiceB (twiceB (twiceB pop_step)))) (g, (d, (q0, (i32[0], i32[1])))));
  let (g5, r) = b;
  let (d5, r2) = r;
  x <- return (get (d5, i32[4]));
  let (d6, d4) = x;
  c <- return ((unbang (twiceC (twiceC (twiceC count_step)))) (d6, (i32[0], (i32[0], i32[0]))));
  let (d7, r3) = c;
  let (i, ns) = r3;
  return (d4, ns)
