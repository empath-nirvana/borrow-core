# Development tools. Install with `brew bundle`.
# The Lean version is pinned by `lean-toolchain`; elan fetches it on first use.

brew "elan-init"  # Lean toolchain manager: provides `lean` and `lake`
brew "wasmtime"   # runs compiled programs (`bcc run`, scripts/compile-corpus.sh)
brew "mdbook"     # builds and doc-tests `book/` (optional)
