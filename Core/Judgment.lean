      CDerivesX I Δ Γ (.app M (.val (.inj₁ .unit))) (.comp C)
  | proj₂ {Δ Γ M C D} (h : CDerivesX I Δ Γ M (.comp (.amp C D))) :
      CDerivesX I Δ Γ (.app M (.val (.inj₂ .unit))) (.comp D)
  /-- `⟨⟩ : ⊤` at any context. -/
  | topI {Δ Γ} : CDerivesX I Δ Γ (.val .unit) (.comp .top)
