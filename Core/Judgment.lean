/-!
# Core — the typing judgment  `[spec §3, §19, §83]`

`CDerivesX I Δ Γ e j`: the CBPV typing judgment on BoLo expressions, each rule once, at a
judgment index `I` (`JIdx`), a parameter.  A field of the index is a premise that is the same
across a rule's premises and its conclusion:

* `ties`: at `some Ξ`, the ten rules that read an operation's signature off a row (`iterate`,
  `divFuel`, `reify`, `effPerform`, `effAwait`, `effRaise`, `effHandleV`, `effHandleVB`,
  `effHandleT`, `effHandleL`) hold that row tied to the effect context `Ξ` (`RowAt`, decision R);
  at `none` the premise is `True`.
* `pin`: the relaxed rules `lendR` (R1), `lendLoopR` (R2) and `nilDead` (SPEC §29) take
  `hPin : I.pin = true`; their soundness is `PinLaw` (`Core/PinLaw.lean`), a hypothesis of
  `fundamentalX` at `I.pin = true` only.

The judgments are its instances:
* `CDerives := CDerivesX {}`, the kernel's judgment (`Core/Fundamental.lean`);
* `CDerivesAt Ξ := CDerivesX {ties := some Ξ}`, a derivation tied to its program's effect context
  (`Core/Tied.lean`);
* `CDerivesP := CDerivesX {pin := true}`, the extended judgment of SPEC §29.

`Core/JudgmentElim.lean` (generated by `scripts/gen-pin.py` from this file) gives each instance its
eliminator with the instance's own cases (`CDerives.induct`, `CDerivesAt.induct`,
`CDerivesP.induct`), each rule under each instance's name with the instance's premises
(`CDerives.effPerform`, `CDerivesAt.effPerform`, `CDerivesP.lendR`, …), and `CDerivesX.mono`: a
derivation at `I` is one at every `I' ≥ I`.
-/

namespace BoCa.Fig16.LogRel.Core
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.Lifetime (LSub LifeCtx LifeVar)

/-! ### Effect contexts and tied rows -/

/-- An effect context: each name's signature, its operations numbered from `0`.  `[spec §19]` -/
abbrev EffCtx := UInt32 → List (Qual × VTy × VTy)

/-- An operation at an effect context's entry: its qualifier, its argument and answer the entry's
up to the names of lifetime binders (`[α]`, SPEC §3).  `[spec §3, §19]` -/
def OpSig.AtEntry (o : OpSig) (p : Qual × VTy × VTy) : Prop :=
  p.1 = o.q ∧ VTy.alphaB [] p.2.1 o.A = true ∧ VTy.alphaB [] p.2.2 o.B = true

/-- **A row tied to the effect context**: every operation the row finds is of a nonzero name with
at most `2³²` operations, at the signature `Ξ` gives it up to α.  `[spec §3, §19]` -/
def RowAt (Ξ : EffCtx) (S : Row) : Prop :=
  ∀ n i o, Row.find S n i = some o →
    n ≠ 0 ∧ (Ξ n).length ≤ 2 ^ 32 ∧ ∃ p, (Ξ n)[i.toNat]? = some p ∧ o.AtEntry p

/-! ### The judgment index -/

/-- A judgment index: the gating premises of `CDerivesX`.  `ties`: the effect context the
operation and handler rules' rows are tied to, if any.  `pin`: whether the relaxed rules
`lendR`, `lendLoopR` and `nilDead` (SPEC §29) are admitted.  `[spec §3, §19, §29, §83]` -/
structure JIdx where
  ties : Option EffCtx := none
  pin : Bool := false

/-- The tie premise at a row: `RowAt Ξ S` at `ties = some Ξ`, `True` at `none`.  `[spec §19, §83]` -/
def JIdx.RowOK (I : JIdx) (S : Row) : Prop :=
  match I.ties with
  | none => True
  | some Ξ => RowAt Ξ S

/-- `I ≤ I'`: every derivation at `I` is one at `I'`, field by field: a tie may be dropped
(`some Ξ ≤ none`), a pin rule admitted (`false ≤ true`).  `[spec §3, §19, §83]` -/
structure JIdx.Le (I I' : JIdx) : Prop where
  ties : I'.ties = none ∨ I'.ties = I.ties
  pin : I.pin = true → I'.pin = true

instance : LE JIdx := ⟨JIdx.Le⟩

theorem JIdx.Le.rowOK {I I' : JIdx} (h : I ≤ I') {S : Row} (hS : I.RowOK S) : I'.RowOK S := by
  rcases h.ties with h | h
  · rw [JIdx.RowOK, h]; trivial
  · rw [JIdx.RowOK, h]; exact hS

theorem JIdx.Le.pinOK {I I' : JIdx} (h : I ≤ I') (hPin : I.pin = true) : I'.pin = true :=
  h.pin hPin

theorem JIdx.le_pin (I : JIdx) : I ≤ {pin := true} := ⟨.inl rfl, fun _ => rfl⟩

/-- Every index ties the empty row: no operation is found in it.  `[spec §19, §83]` -/
theorem JIdx.rowOK_nil : ∀ I : JIdx, I.RowOK []
  | ⟨none, _⟩ => trivial
  | ⟨some _, _⟩ => fun _ _ _ h => nomatch h

/-! ### The relaxed rules' terms and rows  `[spec §29]`

What `lendR` (R1) and `lendLoopR` (R2) are stated at. -/

noncomputable section

/-- A value type with no `U` and no `Code⟨N; E⟩ C` at a position read componentwise (`Law2`'s
`NoThunkT`, on the `law2-typed-world` branch): an answer read back at the kernel's relation after a
re-lend. -/
def NoThunkT : VTy → Prop
  | .tensor A B => NoThunkT A ∧ NoThunkT B
  | .sum A B => NoThunkT A ∧ NoThunkT B
  | .thunk _ => False
  | .code _ _ _ => False
  | .bang A => NoThunkT A
  | .ref A => NoThunkT A
  | .box _ A => NoThunkT A
  | .fam L => NoThunkT L
  | _ => True

/-- **The row a relaxed lend's callback may stop at.** Every operation resumes (none abortive),
none is unrestricted, its cancel row is empty, it answers `1`, its name is not `⊥`, and its
argument is closed data: free of `'x`, outliving every lifetime, with no `U` in it.  `[spec §29]` -/
def Row.ResumeO (S : Row) (x : LifeVar) : Prop :=
  ∀ o ∈ S, o.abort = false ∧ o.q ≠ .unr ∧ o.fin = .ret .unit ∧ o.B = .unit ∧ o.n ≠ 0 ∧
    ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A

/-- **The row a relaxed lend's callback may stop at, widened for the cancel path only.** Each
operation is one `Row.ResumeO` admits; or a cancellable wait (`OpSig.Cancellable`: marked, linear,
answering `1 ⊕ 1`) at operation `0` of a nonzero name, taking closed data, at any cancel row; or the
cancel target
(`OpSig.CancelTarget`) at operation `1` of a name whose operation `0` is a cancellable wait, which
`[await-c]` raises on `inr ()`. No other abortive operation is admitted, and the row does not hold
`Div`.  `[spec §29, §29a]` -/
def Row.ResumeOC (S : Row) (x : LifeVar) : Prop :=
  (∀ o ∈ S,
    (o.abort = false ∧ o.q ≠ .unr ∧ o.fin = .ret .unit ∧ o.B = .unit ∧ o.n ≠ 0 ∧
      ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A) ∨
    (o.Cancellable ∧ o.i = 0 ∧ o.n ≠ 0 ∧ ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A) ∨
    (o.CancelTarget ∧ o.i = 1 ∧ o.q = .cancel ∧ o.n ≠ 0 ∧
      ∃ a, Row.find S o.n 0 = some a ∧ a.Cancellable)) ∧
  Row.divB S = false

/-- `Row.ResumeO` admits no `Div`: every entry answers `1`, and `tick` answers `1 ⊕ 1`. -/
theorem Row.ResumeO.divB {S : Row} {x : LifeVar} (h : Row.ResumeO S x) : Row.divB S = false :=
  Row.divB_of_noTick fun o ho => by
    simp [tickB, (h o ho).2.2.2.1, VTy.isNextB]

/-- `Row.ResumeOC` widens `Row.ResumeO`: every row R1 admitted it still admits. -/
theorem Row.ResumeO.toC {S : Row} {x : LifeVar} (h : Row.ResumeO S x) : Row.ResumeOC S x :=
  ⟨fun o ho => .inl (h o ho), h.divB⟩

/-- A lend's callback `Λ. λm. M`. -/
def lendCb (M : Expr) : Val := ⟨.lam (.lam M), .lam⟩

/-! ### R2's term: `loop_lend_imm` / `loop_lend_mut`

`lendLoopE C` is the erasure of the per-observation lend (`lib/lend.bc`, `LoopBorrow`), at the
loop body `C` that `unfold` coiterates. The `imm` and `mut` combinators erase to this one term:
`withbor` (1) and (2) differ only in typing. `experiments/AsyncCap/AsyncCap/LoopTerm.lean` checks
that it is `bcc`'s erasure of both at a monomorphic instance. -/

/-- `withbor`'s body, `λr. λf. (r, f () r)`, as the elaborator inlines it. -/
def wbInl : Expr :=
  .lam (.lam (.pair (.var 1) (.app (.app (.var 0) .unit) (.var 1))))

/-- The step `λp. λo. case o {inj₁ _. next | inj₂ _. close}` of `unfold`, under `(nx, cl)`. -/
def lendStepE : Expr :=
  .lam (.lam (.case (.var 0)
    (.seq (.var 0) (.letpair (.var 2)
      (.app
        (.lam (.letpair (.var 0) (.case (.var 0)
          (.inj₁ (.pair (.var 2) (.var 0)))
          (.inj₂ (.pair (.var 2) (.var 0))))))
        (.app (.app wbInl (.var 1))
          (.lam (.lam (.app (.app (.var 8) .unit) (.pair (.var 0) (.var 2)))))))))
    (.seq (.var 0) (.letpair (.var 2)
      (.app (.app wbInl (.var 1))
        (.lam (.lam (.app (.app (.var 7) .unit) (.pair (.var 0) (.var 2))))))))))

/-- `λ(nx, cl). unfold_C step`: the per-observation lend, at `unfold`'s body `C`. -/
def lendLoopE (C : CTy) : Expr :=
  .lam (.letpair (.var 0) (.app (unfoldV C).1 lendStepE))

/-- The loop body of R2's result, `F((Ref A ⊗ B) ⊕ X) & F (Ref A ⊗ R)`. -/
abbrev lendLoopBody (A B R : VTy) : CTy := CTy.loopBody (.tensor (.ref A) B) (.tensor (.ref A) R)

/-- R2's term at `r : Ref A`: `f ← lend_loop (Λ. λp. N, Λ. λp. K); q ← return (r, s₀); f q`. -/
def lendLoopApp (A B R : VTy) (N K s0 : Expr) : Expr :=
  bindE (.app (lendLoopE (lendLoopBody A B R)) (.pair (lendCb N).1 (lendCb K).1))
    (bindE (.pair (.var 1) s0) (.app (.var 1) (.var 0)))

end

/-! ### The typing judgment -/

/-- A judgment form: a value at `A`, or a computation at `C`.  `[spec §3]` -/
inductive Jdg where
  | val (A : VTy)
  | comp (C : CTy)

/-- Judgment forms equal up to the names of their types' lifetime binders (`VTy.alphaB`,
`CTy.alphaB` at no binder pairs).  `[spec §3]` -/
def Jdg.alphaB : Jdg → Jdg → Bool
  | .val A, .val A' => VTy.alphaB [] A A'
  | .comp C, .comp C' => CTy.alphaB [] C C'
  | _, _ => false

/-- `!X` at `true`, `X` at `false`: the type of a value rule and of its promotion over a flat
context (`CDerivesX.thunkFb`, `thunkVb`, `codeIb`).  `[spec §10]` -/
def VTy.bangIf : Bool → VTy → VTy
  | true, X => .bang X
  | false, X => X

/-- **The same-term rules** (`[conv]`): which one, with the data its typed node holds.  Each
concludes with its premise's term; `JConv` gives its judgments and side premises.  `[spec §3]` -/
inductive ConvKind where
  /-- `return V : F A`. -/
  | ret (A : VTy)
  /-- A computation of `F A` read back as a value of `A`. -/
  | ofRet (A : VTy)
  /-- Dereliction. -/
  | bangE (A : VTy)
  /-- `[]I`. -/
  | boxI (a : Lifetime.Life) (A : VTy)
  /-- `[]E`. -/
  | boxE (a : Lifetime.Life) (A : VTy)
  /-- `⊑` at `Imm`. -/
  | immSub (a b : Lifetime.Life) (A : VTy)
  /-- `⊑` at `Mut`. -/
  | mutSub (a b : Lifetime.Life) (A : VTy)
  /-- `[erase]`. -/
  | codeErase (C : CTy) (E : VTy)
  /-- `[erase]` under `!`. -/
  | codeEraseB (C : CTy) (E : VTy)
  /-- `roll`. -/
  | roll (A : VTy)
  /-- `unroll`. -/
  | unroll (A : VTy)
  /-- `ν`'s unrolling read as the `ν`. -/
  | nuIn (m i : Nat) (C : CTy)
  /-- A `ν` read as its unrolling. -/
  | nuOut (m i : Nat) (C : CTy)
  /-- `[sub]`. -/
  | effSub (S S' : Row) (A : VTy)
  /-- `[α]`. -/
  | alpha
  deriving Inhabited

/-- **One same-term step**, with its side premises: a term at the first judgment is at the second
(the rule `conv`).  One case per same-term rule, each with exactly that rule's premises.
`[spec §3, §6, §7, §19, §68, §79]` -/
inductive JConv (Δ : LifeCtx) (Γ : Ctx VTy) : ConvKind → Jdg → Jdg → Prop
  /-- `return V : F A`. -/
  | ret {A : VTy} : JConv Δ Γ (.ret A) (.val A) (.comp (.ret A))
  /-- A computation of `F A` is a value-judged expression at `A`: `SemV` is `SemC` at `F A`.
  `[spec §3]` -/
  | ofRet {A : VTy} : JConv Δ Γ (.ofRet A) (.comp (.ret A)) (.val A)
  /-- Dereliction. -/
  | bangE {A : VTy} : JConv Δ Γ (.bangE A) (.val (.bang A)) (.val A)
  /-- `[]I`, at a context that outlives `a`. -/
  | boxI {a : Lifetime.Life} {A : VTy} (hΓ : CtxOutlives Δ Γ a) :
      JConv Δ Γ (.boxI a A) (.val A) (.val (.box a A))
  /-- `[]E`. -/
  | boxE {a : Lifetime.Life} {A : VTy} : JConv Δ Γ (.boxE a A) (.val (.box a A)) (.val A)
  /-- `⊑` at `Imm`: a borrow at `b` is one at every `a ⊑ b`. -/
  | immSub {a b : Lifetime.Life} {A : VTy} (hle : Δ.EntailsLe a b) :
      JConv Δ Γ (.immSub a b A) (.val (.imm b A)) (.val (.imm a A))
  /-- `⊑` at `Mut`. -/
  | mutSub {a b : Lifetime.Life} {A : VTy} (hle : Δ.EntailsLe a b) :
      JConv Δ Γ (.mutSub a b A) (.val (.mut b A)) (.val (.mut a A))
  /-- `[erase]` (§68's `erase`): a code type read at `U C`.  `[spec §68]` -/
  | codeErase {C : CTy} {N : Expr} {E : VTy} :
      JConv Δ Γ (.codeErase C E) (.val (.code N E C)) (.val (.thunk C))
  /-- `[erase]` under `!`.  `[spec §68]` -/
  | codeEraseB {C : CTy} {N : Expr} {E : VTy} :
      JConv Δ Γ (.codeEraseB C E) (.val (.bang (.code N E C))) (.val (.bang (.thunk C)))
  /-- `roll`: a value of `A[μX. A/X]` is a value of `μX. A`, at a closed `μ` whose variable is
  outside `A`'s `Mut` payloads (`docs/scope-recursion.md` §2.2).  `[spec §6]` -/
  | roll {A : VTy} (hA : A.NoMut 0) (hc : (VTy.mu A).Cl 0) :
      JConv Δ Γ (.roll A) (.val (VTy.inst (.mu A) A)) (.val (.mu A))
  /-- `unroll`: a value of `μX. A` is a value of `A[μX. A/X]`.  `[spec §6]` -/
  | unroll {A : VTy} : JConv Δ Γ (.unroll A) (.val (.mu A)) (.val (VTy.inst (.mu A) A))
  /-- `νᵢ` is its unrolling `Cᵢ[U ν₀/X₀, …]` (`cC_nuS_iff`; at one equation `C[U(νX. C)/X]`,
  `cC_nu_iff`), at a positive system (`CTy.SysOkAt`, today's `NuOk` at `νX. C`).
  `[spec §7, §79]` -/
  | nuIn {m i : Nat} {C : CTy} (hC : C.SysOkAt m i) :
      JConv Δ Γ (.nuIn m i C) (.comp (CTy.unrollS m i C)) (.comp (.nuSys m i C))
  /-- The converse of `nuIn`.  `[spec §7, §79]` -/
  | nuOut {m i : Nat} {C : CTy} (hC : C.SysOkAt m i) :
      JConv Δ Γ (.nuOut m i C) (.comp (.nuSys m i C)) (.comp (CTy.unrollS m i C))
  /-- `[sub]`: `F_Σ A ≤ F_Σ′ A` for `Σ ⊆ Σ′`; `F A = F_∅ A`.  `[spec §19]` -/
  | effSub {S S' : Row} {A : VTy} (hle : RowLe S S') :
      JConv Δ Γ (.effSub S S' A) (.comp (CTy.effOf S A)) (.comp (CTy.effOf S' A))
  /-- **Conversion** `[α]`: judgments equal up to the names of their types' lifetime binders
  (`Jdg.alphaB`).  `[spec §3]` -/
  | alpha {j j' : Jdg} (hα : j.alphaB j' = true) : JConv Δ Γ .alpha j j'

/-- The lifetime a step's side premise asks the context to outlive: `[]I`'s, the one step whose
premise reads `Γ`.  `[spec §3]` -/
def ConvKind.outl? : ConvKind → Option Lifetime.Life
  | .boxI a _ => some a
  | _ => none

/-- A step's side premises read at another context: only `[]I`'s outlives (at `k.outl?`) and
`⊑`'s entailment read `Δ` or `Γ`.  `[spec §3]` -/
theorem JConv.mono {Δ Δ' : LifeCtx} {Γ Γ' : Ctx VTy} {k : ConvKind} {j j' : Jdg}
    (hΓ : ∀ a, k.outl? = some a → CtxOutlives Δ Γ a → CtxOutlives Δ' Γ' a)
    (hΔ : ∀ a b, Δ.EntailsLe a b → Δ'.EntailsLe a b) (hc : JConv Δ Γ k j j') :
    JConv Δ' Γ' k j j' := by
  cases hc with
  | boxI h => exact .boxI (hΓ _ rfl h)
  | immSub h => exact .immSub (hΔ _ _ h)
  | mutSub h => exact .mutSub (hΔ _ _ h)
  | ret => exact .ret
  | ofRet => exact .ofRet
  | bangE => exact .bangE
  | boxE => exact .boxE
  | codeErase => exact .codeErase
  | codeEraseB => exact .codeEraseB
  | roll hA hc => exact .roll hA hc
  | unroll => exact .unroll
  | nuIn hC => exact .nuIn hC
  | nuOut hC => exact .nuOut hC
  | effSub hle => exact .effSub hle
  | alpha hα => exact .alpha hα

/-- The CBPV typing judgment.  Its context premises are `Ctx.SplitP`, `Ctx.DeadP` and
`Ctx.SoloP`: a live slot of persistent type may be duplicated and consumed.  `[spec §3, §10, §83]` -/
inductive CDerivesX (I : JIdx) : LifeCtx → Ctx VTy → Expr → Jdg → Prop where
  | var {Δ Γ i A} (h : Ctx.SoloP Γ i A) : CDerivesX I Δ Γ (.var i) (.val A)
  | tensorI {Δ Γ Γ₁ Γ₂ e₁ e₂ A B} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (h₁ : CDerivesX I Δ Γ₁ e₁ (.val A)) (h₂ : CDerivesX I Δ Γ₂ e₂ (.val B)) :
      CDerivesX I Δ Γ (.pair e₁ e₂) (.val (.tensor A B))
  | sumI₁ {Δ Γ e A B} (h : CDerivesX I Δ Γ e (.val A)) :
      CDerivesX I Δ Γ (.inj₁ e) (.val (.sum A B))
  | sumI₂ {Δ Γ e A B} (h : CDerivesX I Δ Γ e (.val B)) :
      CDerivesX I Δ Γ (.inj₂ e) (.val (.sum A B))
  /-- `thunk M : U (F A)`, `M` under a dead binder; at `b = true` its promotion `! U (F A)` over a
  flat `Γ` (`VTy.bangIf`).  At `false` it is `CDerivesX.thunkF`, at `true`
  `CDerivesX.bangThunkF`.  `[spec §10]` -/
  | thunkFb {Δ Γ M A T} (b : Bool) (hp : b = true → Ctx.FlatLive Γ)
      (h : CDerivesX I Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A)))
      (hT : T = VTy.bangIf b (.thunk (.ret A))) :
      CDerivesX I Δ Γ (.val (.lam M)) (.val T)
  /-- `thunk V : U C` for a λ-value `V : C`, `C` not an `F`; at `b = true` its promotion `! U C`
  over a flat `Γ`.  At `false` it is `CDerivesX.thunkV`, at `true` `CDerivesX.bangThunkV`.
  `[spec §10]` -/
  | thunkVb {Δ Γ N C T} (b : Bool) (hp : b = true → Ctx.FlatLive Γ) (hC : C.isRet = false)
      (h : CDerivesX I Δ Γ (.val (.lam N)) (.comp C))
      (hT : T = VTy.bangIf b (.thunk C)) :
      CDerivesX I Δ Γ (.val (.lam N)) (.val T)
  /-- **`[conv]`, the same-term rules**: a term at `j` is at `j'` by one step of `JConv` (`return`,
  `ofRet`, `!E`, `[]I`, `[]E`, `⊑`, `[erase]`, `roll`/`unroll`, `ν`'s two rules, `[sub]`, `[α]`).
  `[spec §3]` -/
  | conv {Δ Γ e} {j j' : Jdg} (k : ConvKind) (h : CDerivesX I Δ Γ e j) (hc : JConv Δ Γ k j j') :
      CDerivesX I Δ Γ e j'
  /-- `M to x. N`, written `(λx. N) M`. -/
  | bind {Δ Γ Γ₁ Γ₂ M N A C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hM : CDerivesX I Δ Γ₁ M (.comp (.ret A))) (hN : CDerivesX I Δ (⟨A, true⟩ :: Γ₂) N (.comp C)) :
      CDerivesX I Δ Γ (.app (.val (.lam N)) M) (.comp C)
  /-- `force x`: `x ()` at `F A`, `x` itself at any other computation type; `x` at `U C` or at
  `Code⟨N; E⟩ C` (`VTy.forceTy`).  `[spec §68]` -/
  | force {Δ Γ i T C} (h : Ctx.SoloP Γ i T) (hT : T.forceTy = some C) :
      CDerivesX I Δ Γ (forceE C (.var i)) (.comp C)
  | lam {Δ Γ M A C} (h : CDerivesX I Δ (⟨A, true⟩ :: Γ) M (.comp C)) :
      CDerivesX I Δ Γ (.val (.lam M)) (.comp (.arr A C))
  /-- `[λ-dead]`: `λx. M : 1 ⊸ F_Σ B` with `x`'s slot dead, `M` not using it.  `[spec §26]` -/
  | lamDead {Δ Γ M} {S : Row} {B : VTy}
      (h : CDerivesX I Δ (⟨.unit, false⟩ :: Γ) M (.comp (CTy.effOf S B))) :
      CDerivesX I Δ Γ (.val (.lam M)) (.comp (.arr .unit (CTy.effOf S B)))
  | app {Δ Γ Γ₁ Γ₂ M i A C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hM : CDerivesX I Δ Γ₁ M (.comp (.arr A C))) (hx : Ctx.SoloP Γ₂ i A) :
      CDerivesX I Δ Γ (.app M (.var i)) (.comp C)
  /-- `⟨M, N⟩ : C & D`, both components in the same context. -/
  | withI {Δ Γ M N C D} (hM : CDerivesX I Δ (withCtx Γ) M (.comp C))
