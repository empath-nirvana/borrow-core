  /-- **R2, the shared lend over a loop whose state holds the borrow.** `r : Ref A ⊢` the
  per-observation lend of `r` (`lendLoopApp`) `: U(Loop (Ref A ⊗ B) (Ref A ⊗ R))`. At each
  observation `r` is lent `Imm 'x A` at a fresh `'x` below `⊓Δ`, and the step `N` (to continue,
  `B ⊕ S`) or `K` (to close, `R`) runs on the view and the state. The state's type `S` **may
  mention `'x`**: the state holds `imm` views of the place, and what is built from them, between
  observations. `LoopLend` (SPEC §14) requires `S` to outlive `'x`. The steps and the first state
  `s₀` are typed in `CDerivesP`; the steps see only the pair `(view, state)`.

  Only the `imm` lend: each observation hands the step a fresh view beside the state's, and two
  `imm` views of one place are sound together; two `mut` views are not.  `[spec §29, §83]` -/
  | lendLoopR {Δ : LifeCtx} {x : LifeVar} {A S B R : VTy} {N K s0 : Expr}
      (hPin : I.pin = true)
      (hx : Δ.find? x = none) (hbx : Δ.meetOfDom.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hA : ¬ VFree x A) (hB : ¬ VFree x B) (hR : ¬ VFree x R) (hBn : NoThunkT B)
      (hRn : NoThunkT R) (hsc : VScoped Δ A)
      (hN1 : closedAt 1 N = true) (hK1 : closedAt 1 K = true) (hs0c : closedAt 0 s0 = true)
      (hN : CDerivesX I (Δ.extend x Δ.meetOfDom) [⟨.tensor (.imm (.var x) A) S, true⟩] N
        (.comp (.ret (.sum B S))))
      (hK : CDerivesX I (Δ.extend x Δ.meetOfDom) [⟨.tensor (.imm (.var x) A) S, true⟩] K
        (.comp (.ret R)))
      (hs0 : CDerivesX I (Δ.extend x Δ.meetOfDom) [] s0 (.val S)) :
      CDerivesX I Δ [⟨.ref A, true⟩] (lendLoopApp A B R N K s0)
        (.comp (CTy.loop (.tensor (.ref A) B) (.tensor (.ref A) R)))
  /-- **A derivation at the empty context is one at every consumed context.** R1 and R2 conclude
  at `r : Ref T` alone; under binders they are `(λr. lend) x`, the λ typed at `[]` and placed
  here.  `[spec §29, §83]` -/
  | nilDead {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {j : Jdg}
      (hPin : I.pin = true)
      (hΓ : Ctx.Dead Γ) (h : CDerivesX I Δ [] e j) : CDerivesX I Δ Γ e j

/-! ### Derived rules: the three unwinding lends, the kinds of `withborUD`

`scripts/gen-pin.py` gives each its instances' names (`CDerives.withbor1UD`, …), as it does the
rules. -/

/-- The unwinding form of `withbor` (1): `Ref A` lent as `Imm 'x A` (`withborUD` at `refImm`).
At `Σ_D = ∅`, `Σ_M = Σ` it is `CDerives.withbor1U`.  `[spec §19, §27, §72, §78]` -/
theorem CDerivesX.withbor1UD {I : JIdx} {Δ Γ A B d} {SM SD S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ)
    (hx : Δ.find? x = none) (hsc₁ : VScoped Δ A) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B)
    (hS : SM.Unwind x) (hMS : RowLe SM S) (hDS : RowLe SD S) (hSv : Row.divB S = false)
    (hP : SD.UnrD → SM.PendPers)
    (hd : CDerivesX I Δ Γ d (.val (.thunk (.arr (.ref A) (CTy.effOf SD .unit))))) :
    CDerivesX I Δ Γ (withborUE d) (.val (withbor1UTyD x Δ.meetOfDom A B SM S)) :=
  .withborUD .refImm x hΓ hx hsc₁ hfree₁ hfree₂ hS hMS hDS hSv hP hd

/-- The unwinding form of `withbor` (2): `Ref A` lent as `Mut 'x A`, its side condition
non-strict (`withborUD` at `refMut`).  `[spec §19, §23, §27, §78]` -/
theorem CDerivesX.withbor2UD {I : JIdx} {Δ Γ A B d} {SM SD S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ)
    (hx : Δ.find? x = none) (hside : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A)
    (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B)
    (hS : SM.Unwind x) (hMS : RowLe SM S) (hDS : RowLe SD S) (hSv : Row.divB S = false)
    (hP : SD.UnrD → SM.PendPers)
    (hd : CDerivesX I Δ Γ d (.val (.thunk (.arr (.ref A) (CTy.effOf SD .unit))))) :
    CDerivesX I Δ Γ (withborUE d) (.val (withbor2UTyD x Δ.meetOfDom A B SM S)) :=
  .withborUD .refMut x hΓ hx hside hfree₁ hfree₂ hS hMS hDS hSv hP hd

/-- The unwinding form of `withbor` (3): `Mut @a A` reborrowed as `Mut 'x A` (`withborUD` at
`reborrow a`).  `[spec §19, §27, §78]` -/
theorem CDerivesX.withbor3UD {I : JIdx} {Δ Γ a A B d} {SM SD S : Row} (x : LifeVar)
    (hΓ : Ctx.DeadP Γ) 
    (hx : Δ.find? x = none) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B)
    (hS : SM.Unwind x) (hMS : RowLe SM S) (hDS : RowLe SD S) (hSv : Row.divB S = false)
    (hP : SD.UnrD → SM.PendPers)
    (hd : CDerivesX I Δ Γ d (.val (.thunk (.arr (.mut a A) (CTy.effOf SD .unit))))) :
    CDerivesX I Δ Γ (withborUE d) (.val (withbor3UTyD a x Δ.meetOfDom A B SM S)) :=
  .withborUD (.reborrow a) x hΓ hx trivial hfree₁ hfree₂ hS hMS hDS hSv hP hd

