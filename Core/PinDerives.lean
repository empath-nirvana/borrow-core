namespace BoCa.Fig16.LogRel.Core
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.BoLo (Heap Steps Step1 Head Kont eLoad eStore)
open BoCa.Lifetime (LSub LifeCtx LifeVar)

/-- A value type with no `U` at a position read componentwise (`Law2`'s `NoThunkT`, on the
`law2-typed-world` branch): an answer read back at the kernel's relation after a re-lend. -/
def NoThunkT : VTy → Prop
  | .tensor A B => NoThunkT A ∧ NoThunkT B
  | .sum A B => NoThunkT A ∧ NoThunkT B
  | .thunk _ => False
  | .bang A => NoThunkT A
  | .ref A => NoThunkT A
  | .box _ A => NoThunkT A
  | .fam L => NoThunkT L
  | _ => True

/-- **The row a relaxed lend's callback may stop at.** Every operation resumes (none abortive),
none is unrestricted, its cancel row is empty, it answers `1`, its name is not `⊥`, and its
argument is closed data: free of `'x`, outliving every lifetime, with no `U` in it.  `[spec §29]` -/
def Row.ResumeO (S : Row) (x : LifeVar) : Prop :=
  ∀ o ∈ S, o.abort = false ∧ o.q ≠ .unr ∧ o.fin = .ret .unit ∧ o.B = .unit ∧ o.n ≠ 0 ∧
    ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A

/-- A lend's callback `Λ. λm. M`. -/
def lendCb (M : Expr) : Val := ⟨.lam (.lam M), .lam⟩

/-! ### R2's term: `loop_lend_imm` / `loop_lend_mut`

`lendLoopE C` is the erasure of the per-observation lend (`lib/lend.bc`, `LoopBorrow`), at the
loop body `C` that `unfold` coiterates. The `imm` and `mut` combinators erase to this one term:
`withbor` (1) and (2) differ only in typing. `experiments/AsyncCap/AsyncCap/LoopTerm.lean` checks
that it is `bcc`'s erasure of both at a monomorphic instance. -/

/-- `withbor`'s body, `λr. λf. (r, f () r)`, as the elaborator inlines it. -/
def wbInl : Expr :=
  .lam (.lam (.pair (.var 1) (.app (.app (.var 0) .unit) (.var 1))))

/-- The step `λp. λo. case o {inj₁ _. next | inj₂ _. close}` of `unfold`, under `(nx, cl)`. -/
def lendStepE : Expr :=
  .lam (.lam (.case (.var 0)
    (.seq (.var 0) (.letpair (.var 2)
      (.app
        (.lam (.letpair (.var 0) (.case (.var 0)
          (.inj₁ (.pair (.var 2) (.var 0)))
          (.inj₂ (.pair (.var 2) (.var 0))))))
        (.app (.app wbInl (.var 1))
          (.lam (.lam (.app (.app (.var 8) .unit) (.pair (.var 0) (.var 2)))))))))
    (.seq (.var 0) (.letpair (.var 2)
      (.app (.app wbInl (.var 1))
        (.lam (.lam (.app (.app (.var 7) .unit) (.pair (.var 0) (.var 2))))))))))

/-- `λ(nx, cl). unfold_C step`: the per-observation lend, at `unfold`'s body `C`. -/
def lendLoopE (C : CTy) : Expr :=
  .lam (.letpair (.var 0) (.app (unfoldV C).1 lendStepE))

/-- The loop body of R2's result, `F((Ref A ⊗ B) ⊕ X) & F (Ref A ⊗ R)`. -/
abbrev lendLoopBody (A B R : VTy) : CTy := CTy.loopBody (.tensor (.ref A) B) (.tensor (.ref A) R)

/-- R2's term at `r : Ref A`: `f ← lend_loop (Λ. λp. N, Λ. λp. K); q ← return (r, s₀); f q`. -/
def lendLoopApp (A B R : VTy) (N K s0 : Expr) : Expr :=
  bindE (.app (lendLoopE (lendLoopBody A B R)) (.pair (lendCb N).1 (lendCb K).1))
    (bindE (.pair (.var 1) s0) (.app (.var 1) (.var 0)))

/-- The extended judgment: `CDerives`, every premise in `CDerivesP`, and the relaxed rules. -/
inductive CDerivesP : LifeCtx → Ctx VTy → Expr → Jdg → Prop where
  | var {Δ Γ i A} (h : Ctx.SoloP Γ i A) : CDerivesP Δ Γ (.var i) (.val A)
  | unitI {Δ Γ} (h : Ctx.DeadP Γ) : CDerivesP Δ Γ (.val .unit) (.val .unit)
  | tensorI {Δ Γ Γ₁ Γ₂ e₁ e₂ A B} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (h₁ : CDerivesP Δ Γ₁ e₁ (.val A)) (h₂ : CDerivesP Δ Γ₂ e₂ (.val B)) :
      CDerivesP Δ Γ (.pair e₁ e₂) (.val (.tensor A B))
  | sumI₁ {Δ Γ e A B} (h : CDerivesP Δ Γ e (.val A)) :
      CDerivesP Δ Γ (.inj₁ e) (.val (.sum A B))
  | sumI₂ {Δ Γ e A B} (h : CDerivesP Δ Γ e (.val B)) :
      CDerivesP Δ Γ (.inj₂ e) (.val (.sum A B))
  /-- `thunk M : U (F A)`, `M` under a dead binder. -/
  | thunkF {Δ Γ M A} (h : CDerivesP Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A))) :
      CDerivesP Δ Γ (.val (.lam M)) (.val (.thunk (.ret A)))
  /-- `thunk V : U C` for a λ-value `V : C`, `C` not an `F`. -/
  | thunkV {Δ Γ N C} (hC : C.isRet = false) (h : CDerivesP Δ Γ (.val (.lam N)) (.comp C)) :
      CDerivesP Δ Γ (.val (.lam N)) (.val (.thunk C))
  /-- `return V : F A`. -/
  | ret {Δ Γ V A} (h : CDerivesP Δ Γ V (.val A)) : CDerivesP Δ Γ V (.comp (.ret A))
  /-- `M to x. N`, written `(λx. N) M`. -/
  | bind {Δ Γ Γ₁ Γ₂ M N A C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hM : CDerivesP Δ Γ₁ M (.comp (.ret A))) (hN : CDerivesP Δ (⟨A, true⟩ :: Γ₂) N (.comp C)) :
      CDerivesP Δ Γ (.app (.val (.lam N)) M) (.comp C)
  /-- `force x`: `x ()` at `F A`, `x` itself at any other computation type. -/
  | force {Δ Γ i C} (h : Ctx.SoloP Γ i (.thunk C)) :
      CDerivesP Δ Γ (forceE C (.var i)) (.comp C)
  | lam {Δ Γ M A C} (h : CDerivesP Δ (⟨A, true⟩ :: Γ) M (.comp C)) :
      CDerivesP Δ Γ (.val (.lam M)) (.comp (.arr A C))
  /-- `[λ-dead]`: `λx. M : 1 ⊸ F_Σ B` with `x`'s slot dead, `M` not using it.  `[spec §26]` -/
  | lamDead {Δ Γ M} {S : Row} {B : VTy}
      (h : CDerivesP Δ (⟨.unit, false⟩ :: Γ) M (.comp (CTy.effOf S B))) :
      CDerivesP Δ Γ (.val (.lam M)) (.comp (.arr .unit (CTy.effOf S B)))
  | app {Δ Γ Γ₁ Γ₂ M i A C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hM : CDerivesP Δ Γ₁ M (.comp (.arr A C))) (hx : Ctx.SoloP Γ₂ i A) :
      CDerivesP Δ Γ (.app M (.var i)) (.comp C)
  /-- `⟨M, N⟩ : C & D`, both components in the same context. -/
  | withI {Δ Γ M N C D} (hM : CDerivesP Δ (withCtx Γ) M (.comp C))
      (hN : CDerivesP Δ (withCtx Γ) N (.comp D)) :
      CDerivesP Δ Γ (withPair M N) (.comp (.amp C D))
  | proj₁ {Δ Γ M C D} (h : CDerivesP Δ Γ M (.comp (.amp C D))) :
      CDerivesP Δ Γ (.app M (.val (.inj₁ .unit))) (.comp C)
  | proj₂ {Δ Γ M C D} (h : CDerivesP Δ Γ M (.comp (.amp C D))) :
      CDerivesP Δ Γ (.app M (.val (.inj₂ .unit))) (.comp D)
  /-- `⟨⟩ : ⊤` at any context. -/
  | topI {Δ Γ} : CDerivesP Δ Γ (.val .unit) (.comp .top)
  | unitE {Δ Γ Γ₁ Γ₂ V M C} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hV : CDerivesP Δ Γ₁ V (.val .unit)) (hM : CDerivesP Δ Γ₂ M (.comp C)) :
      CDerivesP Δ Γ (.seq V M) (.comp C)
  | tensorE {Δ Γ Γp Γb V M A B C} (hs : Ctx.SplitP Γ Γp Γb)
      (hV : CDerivesP Δ Γp V (.val (.tensor A B)))
      (hM : CDerivesP Δ (⟨B, true⟩ :: ⟨A, true⟩ :: Γb) M (.comp C)) :
      CDerivesP Δ Γ (.letpair V M) (.comp C)
  | sumE {Δ Γ Γs Γb V M₁ M₂ A B C} (hs : Ctx.SplitP Γ Γs Γb)
      (hV : CDerivesP Δ Γs V (.val (.sum A B)))
      (h₁ : CDerivesP Δ (⟨A, true⟩ :: Γb) M₁ (.comp C))
      (h₂ : CDerivesP Δ (⟨B, true⟩ :: Γb) M₂ (.comp C)) :
      CDerivesP Δ Γ (.case V M₁ M₂) (.comp C)
  /-- `absurd V : C` for `V : 0`, at any rest of the context. -/
  | zeroE {Δ Γ Γ₁ Γ₂ V C} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hV : CDerivesP Δ Γ₁ V (.val .zero)) :
      CDerivesP Δ Γ (absurdE V) (.comp C)
  /-- `Λ. M : ∀'x ⊏ @b. C`, written `λ_. M`; the binder's slot is dead, at any type. -/
  | allI {Δ Γ x b M S C} (hbx : b.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hΓx : ∀ s ∈ Γ, s.live = true → ¬ VFree x s.ty)
      (h : CDerivesP (Δ.extend x b) (⟨S, false⟩ :: Γ) M (.comp C)) :
      CDerivesP Δ Γ (.val (.lam M)) (.comp (.all x b C))
  /-- `M [] : C[@a/'x]`. -/
  | allE {Δ Γ M x b a C} (h : CDerivesP Δ Γ M (.comp (.all x b C))) (hlt : Δ.EntailsLt a b) :
      CDerivesP Δ Γ (.app M (.val .unit)) (.comp (C.instLife x a))
  /-- Promotion of `thunk M : U (F A)` over `!Γ`. -/
  | bangThunkF {Δ Γ M A} (hp : Persistent Γ)
      (h : CDerivesP Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A))) :
      CDerivesP Δ Γ (.val (.lam M)) (.val (.bang (.thunk (.ret A))))
  /-- Promotion of a λ-value `V : C` over `!Γ`. -/
  | bangThunkV {Δ Γ N C} (hp : Persistent Γ) (hC : C.isRet = false)
      (h : CDerivesP Δ Γ (.val (.lam N)) (.comp C)) :
      CDerivesP Δ Γ (.val (.lam N)) (.val (.bang (.thunk C)))
  /-- Dereliction. -/
  | bangE {Δ Γ e A} (h : CDerivesP Δ Γ e (.val (.bang A))) : CDerivesP Δ Γ e (.val A)
  | copyBang {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ copy (.val (.thunk (.arr (.bang A) (.ret (.tensor (.bang A) (.bang A))))))
  | forgetBang {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ forget (.val (.thunk (.arr (.bang A) (.ret .unit))))
  /-- `[]I`. -/
  | boxI {Δ Γ e a A} (h : CDerivesP Δ Γ e (.val A)) (hΓ : CtxOutlives Δ Γ a) :
      CDerivesP Δ Γ e (.val (.box a A))
  | boxE {Δ Γ e a A} (h : CDerivesP Δ Γ e (.val (.box a A))) : CDerivesP Δ Γ e (.val A)
  | immSub {Δ Γ e a b A} (h : CDerivesP Δ Γ e (.val (.imm b A))) (hle : Δ.EntailsLe a b) :
      CDerivesP Δ Γ e (.val (.imm a A))
  | mutSub {Δ Γ e a b A} (h : CDerivesP Δ Γ e (.val (.mut b A))) (hle : Δ.EntailsLe a b) :
      CDerivesP Δ Γ e (.val (.mut a A))
  /-- The borrow axioms, at arbitrary value-type payloads. -/
  | alloc {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .alloc)) (.val (.lolli A (.ref A)))
  | free {Δ Γ A} (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .free)) (.val (.lolli (.ref A) A))
  | swap {Δ Γ A B} (hΓ : Ctx.DeadP Γ) : CDerivesP Δ Γ swap (.val (axSwapTy A B))
  | copy {Δ Γ a A} (hΓ : Ctx.DeadP Γ) : CDerivesP Δ Γ copy (.val (axCopyTy a A))
  | forgetImm {Δ Γ a A} (hΓ : Ctx.DeadP Γ) : CDerivesP Δ Γ forget (.val (axForgetImmTy a A))
  | forgetMut {Δ Γ a A} (hΓ : Ctx.DeadP Γ) : CDerivesP Δ Γ forget (.val (axForgetMutTy a A))
  | forgetUnk {Δ Γ} (hΓ : Ctx.DeadP Γ) : CDerivesP Δ Γ forget (.val axForgetUnkTy)
  /-- An integer literal at its width.  `[spec §8]` -/
  | lit {Δ Γ} (c : IntLit) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val ⟨.prim (.lit c), .prim⟩) (.val (.int c.width))
  /-- A host operation at `!(A ⊸ F B)`, its signature in `SPEC.md` §8.  `[spec §8]` -/
  | hostOp {Δ Γ} (op : HostOp) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim (.host op))) (.val (.bang (hostSig op)))
  /-- `array_new : !(I32 ⊗ !(I32 ⇒ A) ⇒ Array A)`, the step `tab`.  `[spec §9]` -/
  | arrNew {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .tab)) (.val (arrNewTy A))
  /-- `array_free : !(!(A ⇒ 1) ⊗ Array A ⇒ 1)`, the step `drop`.  `[spec §9]` -/
  | arrFree {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .drop)) (.val (arrFreeTy A))
  /-- `array_size : !(Array A ⇒ Array A ⊗ I32)`.  `[spec §9]` -/
  | arrSize {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) : CDerivesP Δ Γ (.val sizeV) (.val (arrSizeTy A))
  /-- `array_replace : !(Array A ⊗ (I32 ⊗ A) ⇒ Array A ⊗ (A ⊕ A))`.  `[spec §9]` -/
  | arrReplace {Δ Γ} (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val replaceV) (.val (arrReplaceTy A))
  /-- `array_len : !(ArrayImm @a A ⇒ I32)`.  `[spec §9]` -/
  | arrLen {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val arrLenV) (.val (arrLenTy a A))
  /-- `array_get : !(ArrayImm @a A ⊗ I32 ⇒ Imm @a A ⊕ 1)`, the step `idx`.  `[spec §9]` -/
  | arrGet {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .idx)) (.val (arrGetTy a A))
  /-- `array_copy : !(ArrayImm @a A ⇒ ArrayImm @a A ⊗ ArrayImm @a A)`.  `[spec §9]` -/
  | arrCopy {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val copyV) (.val (arrCopyTy a A))
  /-- `array_forget : !(ArrayImm @a A ⇒ 1)`.  `[spec §9]` -/
  | arrForget {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val forgetV) (.val (arrForgetTy a A))
  /-- `count_fold : !(!(I32 ⊗ S ⇒ S) ⊗ (I32 ⊗ (I32 ⊗ S)) ⇒ S)`, the step `count`: the counted
  loop, total at every host.  `[spec §16]` -/
  | countFold {Δ Γ} (S : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .count)) (.val (countFoldTy S))
  /-- `count_try : !(!(I32 ⊗ S ⇒ S ⊕ E) ⊗ (I32 ⊗ (I32 ⊗ S)) ⇒ S ⊕ E)`, the step `countTry`: the
  counted loop with an exit, total at every host.  `[spec §16]` -/
  | countTry {Δ Γ} (S E : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .countTry)) (.val (countTryTy S E))
  /-- `bounded_fix : !U(!U((1 ⊕ !U(A ⊸ C)) ⊗ A ⊸ C) ⊗ (I32 ⊗ A) ⊸ C)`, the step
  `boundedFix`: the fixed point with a budget of depth, total at every host and every
  computation type.  `[spec §20]` -/
  | boundedFix {Δ Γ} (A : VTy) (C : CTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .boundedFix)) (.val (boundedFixTy A C))
  /-- `iterate : !U(!U(S ⊸ F_Σ(B ⊕ S) & F_Σ R) ⊗ S ⊸ F_Σ(B ⊕ R))` at a row holding `Div`, the
  step `iterate`: the loop that ticks at each back edge.  `[spec §14]` -/
  | iterate {Δ Γ} (S : Row) (St B R : VTy) (hS : Row.divB S = true) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .iterate)) (.val (iterTy S St B R))
  /-- `div_fuel : !U(U(1 ⊸ F_{tick, Σ} A) ⊗ I32 ⊸ F_Σ A)`, `Σ` without `Div`'s name: the handler of
  `Div` that answers *next* to the first ticks, as many as the budget, and *close* after.
  `[spec §14]` -/
  | divFuel {Δ Γ} (S : Row) (A : VTy) (hS : ∀ o ∈ S, o.n ≠ divEff) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val divFuelV) (.val (divFuelTy S A))
  /-- `reify_res : !U(U(1 ⊸ F_{tick, Σ}(B ⊕ R)) ⊸ F_Σ U(Loop_Σ B R))`, `Σ` without `Div`'s name, at
  the residual of a result `res : !U(B ⊸ F_Σ R)`, a closed term: the handler of `Div` that makes
  a loop value of a computation.  `[spec §14]` -/
  | reify {Δ Γ} (S : Row) (B R : VTy) (res : Val) (hS : ∀ o ∈ S, o.n ≠ divEff)
      (hcl : closedAt 0 res.1 = true) (hres : CDerivesP Δ [] (.val res) (.val (resTy S B R)))
      (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (reifyV res)) (.val (reifyTy S B R))
  /-- `slice_borrow_mut : Array A ⊸ (∀'x ⊏ ⊓Δ. [Mut 'x A] ⊸ ['x] B) ⊸ Array A ⊗ B`, the term
  `withbor`'s: an owned array lent as a family of `mut` leaves, with no cell; its side conditions
  non-strict.  `[spec §9, §23]` -/
  | sliceBorrowM {Δ Γ A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ)
      (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      CDerivesP Δ Γ withbor (.val (sliceBorrowMTy x Δ.meetOfDom A B))
  /-- `slice_borrow_imm : Array A ⊸ (∀'x ⊏ ⊓Δ. [Imm 'x A] ⊸ ['x] B) ⊸ Array A ⊗ B`, the term
  `withbor`'s: an owned array lent as a family of `imm` leaves, with no cell; its side conditions
  non-strict.  `[spec §9, §23]` -/
  | sliceBorrowI {Δ Γ A B} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hsc : VScoped Δ A)
      (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B)
      (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) :
      CDerivesP Δ Γ withbor (.val (sliceBorrowITy x Δ.meetOfDom A B))
  /-- `slice_get_mut : !([Mut @a A] ⊗ I32 ⇒ Mut @a A ⊕ 1)`, the step `idx`.  `[spec §9]` -/
  | sliceGetM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .idx)) (.val (sliceGetMTy a A))
  /-- `slice_len_mut : !([Mut @a A] ⇒ [Mut @a A] ⊗ I32)`.  `[spec §9]` -/
  | sliceLenM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val sizeV) (.val (sliceLenMTy a A))
  /-- `slice_split_imm : !([Imm @a A] ⊗ I32 ⇒ ([Imm @a A] ⊗ [Imm @a A]) ⊕ [Imm @a A])`, the step
  `split`.  `[spec §9]` -/
  | sliceSplitI {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .split)) (.val (sliceSplitITy a A))
  /-- `slice_split_mut : !([Mut @a A] ⊗ I32 ⇒ ([Mut @a A] ⊗ [Mut @a A]) ⊕ [Mut @a A])`, the step
  `split`.  `[spec §9]` -/
  | sliceSplitM {Δ Γ} (a : Lifetime.Life) (A : VTy) (hΓ : Ctx.DeadP Γ) :
      CDerivesP Δ Γ (.val (.prim .split)) (.val (sliceSplitMTy a A))
  /-- `slice_empty_imm : [Imm @a A]`, the family `(0, 0)`.  `[spec §9]` -/
