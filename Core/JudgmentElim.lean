  induction h with
  | var a0 => exact var a0
  | tensorI a0 a1 a2 ih0 ih1 => exact tensorI a0 a1 a2 ih0 ih1
  | sumI₁ a0 ih0 => exact sumI₁ a0 ih0
  | sumI₂ a0 ih0 => exact sumI₂ a0 ih0
  | thunkFb a0 a1 a2 a3 ih0 => exact thunkFb a0 a1 a2 a3 ih0
  | thunkVb a0 a1 a2 a3 a4 ih0 => exact thunkVb a0 a1 a2 a3 a4 ih0
  | conv a0 a1 a2 ih0 => exact conv a0 a1 a2 ih0
  | bind a0 a1 a2 ih0 ih1 => exact bind a0 a1 a2 ih0 ih1
  | force a0 a1 => exact force a0 a1
  | lam a0 ih0 => exact lam a0 ih0
  | lamDead a0 ih0 => exact lamDead a0 ih0
  | app a0 a1 a2 ih0 => exact app a0 a1 a2 ih0
  | withI a0 a1 ih0 ih1 => exact withI a0 a1 ih0 ih1
  | proj₁ a0 ih0 => exact proj₁ a0 ih0
  | proj₂ a0 ih0 => exact proj₂ a0 ih0
  | topI => exact topI
  | unitE a0 a1 a2 ih0 ih1 => exact unitE a0 a1 a2 ih0 ih1
  | tensorE a0 a1 a2 ih0 ih1 => exact tensorE a0 a1 a2 ih0 ih1
  | sumE a0 a1 a2 a3 ih0 ih1 ih2 => exact sumE a0 a1 a2 a3 ih0 ih1 ih2
  | zeroE a0 a1 ih0 => exact zeroE a0 a1 ih0
  | allI a0 a1 a2 a3 ih0 => exact allI a0 a1 a2 a3 ih0
  | allE a0 a1 ih0 => exact allE a0 a1 ih0
  | codeIb a0 a1 a2 a3 a4 ih0 => exact codeIb a0 a1 a2 a3 a4 ih0
  | constK a0 a1 a2 a3 => exact constK a0 a1 a2 a3
  | reify a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 => exact reify a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0
  | withborUD a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 ih0 => exact withborUD a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 ih0
  | sliceBorrowMU a0 a1 a2 a3 a4 a5 a6 a7 ih0 => exact sliceBorrowMU a0 a1 a2 a3 a4 a5 a6 a7 ih0
  | sliceBorrowIU a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 => exact sliceBorrowIU a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0
  | lolliE a0 a1 a2 ih0 ih1 => exact lolliE a0 a1 a2 ih0 ih1
  | allEV a0 a1 ih0 => exact allEV a0 a1 ih0
  | nuOutK a0 a1 a2 a3 a4 => exact nuOutK a0 a1 a2 a3 a4
  | effOp a0 a1 a2 a3 a4 a5 a6 ih0 => exact effOp a0 a1 a2 a3 a4 a5 a6 ih0
  | effAwait a0 a1 a2 a3 a4 a5 a6 => exact effAwait a0 a1 a2 a3 a4 a5 a6
  | effLet a0 a1 a2 a3 a4 ih0 ih1 => exact effLet a0 a1 a2 a3 a4 ih0 ih1
  | effThenF a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1 ih2 => exact effThenF a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1 ih2
  | effHandleVO a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1 => exact effHandleVO a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1
  | effHandleT a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 ih0 ih1 => exact effHandleT a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 ih0 ih1
  | effHandleL a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 ih0 ih1 => exact effHandleL a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 ih0 ih1
  | letPoly a0 a1 a2 a3 ih0 ih1 => exact letPoly a0 a1 a2 a3 ih0 ih1
  | lendR a0 => exact absurd a0 Bool.false_ne_true
  | lendLoopR a0 => exact absurd a0 Bool.false_ne_true
  | nilDead a0 => exact absurd a0 Bool.false_ne_true

/-- `CDerivesP`'s eliminator: its cases are `CDerivesX`'s at `{pin := true}`, the tie premise dropped, the pin premise dropped. -/
@[elab_as_elim]
theorem CDerivesP.induct {motive : (Δ : LifeCtx) → (Γ : Ctx VTy) → (e : Expr) → (j : Jdg) → CDerivesP Δ Γ e j → Prop}
    (var : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {i : Nat} {A : VTy} (h : Ctx.SoloP Γ i A),
      motive Δ Γ (.var i) (.val A) (CDerivesX.var (I := {pin := true}) (Δ := Δ) (Γ := Γ) (i := i) (A := A) h))
    (tensorI : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γ₁ : Ctx VTy} {Γ₂ : Ctx VTy} {e₁ : Expr} {e₂ : Expr} {A : VTy} {B : VTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (h₁ : CDerivesP Δ Γ₁ e₁ (.val A)) (h₂ : CDerivesP Δ Γ₂ e₂ (.val B)) (h₁_ih : motive Δ Γ₁ e₁ (.val A) h₁) (h₂_ih : motive Δ Γ₂ e₂ (.val B) h₂),
      motive Δ Γ (.pair e₁ e₂) (.val (.tensor A B)) (CDerivesX.tensorI (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γ₁ := Γ₁) (Γ₂ := Γ₂) (e₁ := e₁) (e₂ := e₂) (A := A) (B := B) hs h₁ h₂))
    (sumI₁ : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {A : VTy} {B : VTy} (h : CDerivesP Δ Γ e (.val A)) (h_ih : motive Δ Γ e (.val A) h),
      motive Δ Γ (.inj₁ e) (.val (.sum A B)) (CDerivesX.sumI₁ (I := {pin := true}) (Δ := Δ) (Γ := Γ) (e := e) (A := A) (B := B) h))
    (sumI₂ : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {A : VTy} {B : VTy} (h : CDerivesP Δ Γ e (.val B)) (h_ih : motive Δ Γ e (.val B) h),
      motive Δ Γ (.inj₂ e) (.val (.sum A B)) (CDerivesX.sumI₂ (I := {pin := true}) (Δ := Δ) (Γ := Γ) (e := e) (A := A) (B := B) h))
    (thunkFb : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {A : VTy} {T : VTy} (b : Bool) (hp : b = true → Ctx.FlatLive Γ) (h : CDerivesP Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A))) (hT : T = VTy.bangIf b (.thunk (.ret A))) (h_ih : motive Δ (⟨.unit, false⟩ :: Γ) M (.comp (.ret A)) h),
      motive Δ Γ (.val (.lam M)) (.val T) (CDerivesX.thunkFb (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (A := A) (T := T) b hp h hT))
    (thunkVb : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {N : Expr} {C : CTy} {T : VTy} (b : Bool) (hp : b = true → Ctx.FlatLive Γ) (hC : C.isRet = false) (h : CDerivesP Δ Γ (.val (.lam N)) (.comp C)) (hT : T = VTy.bangIf b (.thunk C)) (h_ih : motive Δ Γ (.val (.lam N)) (.comp C) h),
      motive Δ Γ (.val (.lam N)) (.val T) (CDerivesX.thunkVb (I := {pin := true}) (Δ := Δ) (Γ := Γ) (N := N) (C := C) (T := T) b hp hC h hT))
    (conv : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {j j' : Jdg} (k : ConvKind) (h : CDerivesP Δ Γ e j) (hc : JConv Δ Γ k j j') (h_ih : motive Δ Γ e j h),
      motive Δ Γ e j' (CDerivesX.conv (I := {pin := true}) (Δ := Δ) (Γ := Γ) (e := e) (j := j) (j' := j') k h hc))
    (bind : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γ₁ : Ctx VTy} {Γ₂ : Ctx VTy} {M : Expr} {N : Expr} {A : VTy} {C : CTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hM : CDerivesP Δ Γ₁ M (.comp (.ret A))) (hN : CDerivesP Δ (⟨A, true⟩ :: Γ₂) N (.comp C)) (hM_ih : motive Δ Γ₁ M (.comp (.ret A)) hM) (hN_ih : motive Δ (⟨A, true⟩ :: Γ₂) N (.comp C) hN),
      motive Δ Γ (.app (.val (.lam N)) M) (.comp C) (CDerivesX.bind (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γ₁ := Γ₁) (Γ₂ := Γ₂) (M := M) (N := N) (A := A) (C := C) hs hM hN))
    (force : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {i : Nat} {T : VTy} {C : CTy} (h : Ctx.SoloP Γ i T) (hT : T.forceTy = some C),
      motive Δ Γ (forceE C (.var i)) (.comp C) (CDerivesX.force (I := {pin := true}) (Δ := Δ) (Γ := Γ) (i := i) (T := T) (C := C) h hT))
    (lam : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {A : VTy} {C : CTy} (h : CDerivesP Δ (⟨A, true⟩ :: Γ) M (.comp C)) (h_ih : motive Δ (⟨A, true⟩ :: Γ) M (.comp C) h),
      motive Δ Γ (.val (.lam M)) (.comp (.arr A C)) (CDerivesX.lam (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (A := A) (C := C) h))
    (lamDead : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {S : Row} {B : VTy} (h : CDerivesP Δ (⟨.unit, false⟩ :: Γ) M (.comp (CTy.effOf S B))) (h_ih : motive Δ (⟨.unit, false⟩ :: Γ) M (.comp (CTy.effOf S B)) h),
      motive Δ Γ (.val (.lam M)) (.comp (.arr .unit (CTy.effOf S B))) (CDerivesX.lamDead (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (S := S) (B := B) h))
    (app : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γ₁ : Ctx VTy} {Γ₂ : Ctx VTy} {M : Expr} {i : Nat} {A : VTy} {C : CTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hM : CDerivesP Δ Γ₁ M (.comp (.arr A C))) (hx : Ctx.SoloP Γ₂ i A) (hM_ih : motive Δ Γ₁ M (.comp (.arr A C)) hM),
      motive Δ Γ (.app M (.var i)) (.comp C) (CDerivesX.app (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γ₁ := Γ₁) (Γ₂ := Γ₂) (M := M) (i := i) (A := A) (C := C) hs hM hx))
    (withI : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {N : Expr} {C : CTy} {D : CTy} (hM : CDerivesP Δ (withCtx Γ) M (.comp C)) (hN : CDerivesP Δ (withCtx Γ) N (.comp D)) (hM_ih : motive Δ (withCtx Γ) M (.comp C) hM) (hN_ih : motive Δ (withCtx Γ) N (.comp D) hN),
      motive Δ Γ (withPair M N) (.comp (.amp C D)) (CDerivesX.withI (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (N := N) (C := C) (D := D) hM hN))
    (proj₁ : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {C : CTy} {D : CTy} (h : CDerivesP Δ Γ M (.comp (.amp C D))) (h_ih : motive Δ Γ M (.comp (.amp C D)) h),
      motive Δ Γ (.app M (.val (.inj₁ .unit))) (.comp C) (CDerivesX.proj₁ (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (C := C) (D := D) h))
    (proj₂ : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {C : CTy} {D : CTy} (h : CDerivesP Δ Γ M (.comp (.amp C D))) (h_ih : motive Δ Γ M (.comp (.amp C D)) h),
      motive Δ Γ (.app M (.val (.inj₂ .unit))) (.comp D) (CDerivesX.proj₂ (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (C := C) (D := D) h))
    (topI : ∀ {Δ : LifeCtx} {Γ : Ctx VTy},
      motive Δ Γ (.val .unit) (.comp .top) (CDerivesX.topI (I := {pin := true}) (Δ := Δ) (Γ := Γ)))
    (unitE : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γ₁ : Ctx VTy} {Γ₂ : Ctx VTy} {V : Expr} {M : Expr} {C : CTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hV : CDerivesP Δ Γ₁ V (.val .unit)) (hM : CDerivesP Δ Γ₂ M (.comp C)) (hV_ih : motive Δ Γ₁ V (.val .unit) hV) (hM_ih : motive Δ Γ₂ M (.comp C) hM),
      motive Δ Γ (.seq V M) (.comp C) (CDerivesX.unitE (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γ₁ := Γ₁) (Γ₂ := Γ₂) (V := V) (M := M) (C := C) hs hV hM))
    (tensorE : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γp : Ctx VTy} {Γb : Ctx VTy} {V : Expr} {M : Expr} {A : VTy} {B : VTy} {C : CTy} (hs : Ctx.SplitP Γ Γp Γb) (hV : CDerivesP Δ Γp V (.val (.tensor A B))) (hM : CDerivesP Δ (⟨B, true⟩ :: ⟨A, true⟩ :: Γb) M (.comp C)) (hV_ih : motive Δ Γp V (.val (.tensor A B)) hV) (hM_ih : motive Δ (⟨B, true⟩ :: ⟨A, true⟩ :: Γb) M (.comp C) hM),
      motive Δ Γ (.letpair V M) (.comp C) (CDerivesX.tensorE (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γp := Γp) (Γb := Γb) (V := V) (M := M) (A := A) (B := B) (C := C) hs hV hM))
    (sumE : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γs : Ctx VTy} {Γb : Ctx VTy} {V : Expr} {M₁ : Expr} {M₂ : Expr} {A : VTy} {B : VTy} {C : CTy} (hs : Ctx.SplitP Γ Γs Γb) (hV : CDerivesP Δ Γs V (.val (.sum A B))) (h₁ : CDerivesP Δ (⟨A, true⟩ :: Γb) M₁ (.comp C)) (h₂ : CDerivesP Δ (⟨B, true⟩ :: Γb) M₂ (.comp C)) (hV_ih : motive Δ Γs V (.val (.sum A B)) hV) (h₁_ih : motive Δ (⟨A, true⟩ :: Γb) M₁ (.comp C) h₁) (h₂_ih : motive Δ (⟨B, true⟩ :: Γb) M₂ (.comp C) h₂),
      motive Δ Γ (.case V M₁ M₂) (.comp C) (CDerivesX.sumE (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γs := Γs) (Γb := Γb) (V := V) (M₁ := M₁) (M₂ := M₂) (A := A) (B := B) (C := C) hs hV h₁ h₂))
    (zeroE : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γ₁ : Ctx VTy} {Γ₂ : Ctx VTy} {V : Expr} {C : CTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hV : CDerivesP Δ Γ₁ V (.val .zero)) (hV_ih : motive Δ Γ₁ V (.val .zero) hV),
      motive Δ Γ (absurdE V) (.comp C) (CDerivesX.zeroE (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γ₁ := Γ₁) (Γ₂ := Γ₂) (V := V) (C := C) hs hV))
    (allI : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {x : LifeVar} {b : Lifetime.Life} {M : Expr} {S : VTy} {C : CTy} (hbx : b.mentions x = false) (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false) (hΓx : ∀ s ∈ Γ, s.live = true → ¬ VFree x s.ty) (h : CDerivesP (Δ.extend x b) (⟨S, false⟩ :: Γ) M (.comp C)) (h_ih : motive (Δ.extend x b) (⟨S, false⟩ :: Γ) M (.comp C) h),
      motive Δ Γ (.val (.lam M)) (.comp (.all x b C)) (CDerivesX.allI (I := {pin := true}) (Δ := Δ) (Γ := Γ) (x := x) (b := b) (M := M) (S := S) (C := C) hbx hΔx hΓx h))
    (allE : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {x : LifeVar} {b : Lifetime.Life} {a : Lifetime.Life} {C : CTy} (h : CDerivesP Δ Γ M (.comp (.all x b C))) (hlt : Δ.EntailsLt a b) (h_ih : motive Δ Γ M (.comp (.all x b C)) h),
      motive Δ Γ (.app M (.val .unit)) (.comp (C.instLife x a)) (CDerivesX.allE (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (x := x) (b := b) (a := a) (C := C) h hlt))
    (codeIb : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {M : Expr} {C : CTy} {T : VTy} (b : Bool) (hp : b = true → Ctx.FlatLive Γ) (h : CDerivesP Δ Γ (.val (.lam M)) (.val (VTy.bangIf b (.thunk C)))) (hok : Ctx.CapOK Γ (.lam M)) (hT : T = VTy.bangIf b (.code (Expr.capNorm (.lam M)) (Ctx.capTy Γ (.lam M)) C)) (h_ih : motive Δ Γ (.val (.lam M)) (.val (VTy.bangIf b (.thunk C))) h),
      motive Δ Γ (.val (.lam M)) (.val T) (CDerivesX.codeIb (I := {pin := true}) (Δ := Δ) (Γ := Γ) (M := M) (C := C) (T := T) b hp h hok hT))
    (constK : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} (k : ConstKind) (hk : k.OK Δ) (hΓ : Ctx.DeadP Γ),
      motive Δ Γ k.E (.val (k.ty Δ.meetOfDom)) (CDerivesX.constK (I := {pin := true}) (Δ := Δ) (Γ := Γ) k trivial hk hΓ))
    (reify : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} (S : Row) (B R : VTy) (res : Val) (hS : ∀ o ∈ S, o.n ≠ divEff) (hcl : closedAt 0 res.1 = true) (hres : CDerivesP Δ [] (.val res) (.val (resTy S B R))) (hΓ : Ctx.DeadP Γ) (hres_ih : motive Δ [] (.val res) (.val (resTy S B R)) hres),
      motive Δ Γ (.val (reifyV res)) (.val (reifyTy S B R)) (CDerivesX.reify (I := {pin := true}) (Δ := Δ) (Γ := Γ) S B R res trivial hS hcl hres hΓ))
    (withborUD : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {A : VTy} {B : VTy} {d : Expr} {SM SD S : Row} (k : LendUKind) (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hx : Δ.find? x = none) (hk : k.OK Δ A) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : SM.Unwind x) (hMS : RowLe SM S) (hDS : RowLe SD S) (hSv : Row.divB S = false) (hP : SD.UnrD → SM.PendPers) (hd : CDerivesP Δ Γ d (.val (.thunk (.arr (k.src A) (CTy.effOf SD .unit))))) (hd_ih : motive Δ Γ d (.val (.thunk (.arr (k.src A) (CTy.effOf SD .unit)))) hd),
      motive Δ Γ (withborUE d) (.val (k.ty x Δ.meetOfDom A B SM S)) (CDerivesX.withborUD (I := {pin := true}) (Δ := Δ) (Γ := Γ) (A := A) (B := B) (d := d) (SM := SM) (SD := SD) (S := S) k x hΓ hx hk hfree₁ hfree₂ hS hMS hDS hSv hP hd))
    (sliceBorrowMU : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {A : VTy} {B : VTy} {d : Expr} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x) (hd : CDerivesP Δ Γ d (.val (.lolli (.array A) .unit))) (hd_ih : motive Δ Γ d (.val (.lolli (.array A) .unit)) hd),
      motive Δ Γ (withborUE d) (.val (sliceBorrowMUTy x Δ.meetOfDom A B S)) (CDerivesX.sliceBorrowMU (I := {pin := true}) (Δ := Δ) (Γ := Γ) (A := A) (B := B) (d := d) (S := S) x hΓ hsideA hsideB hfree₁ hfree₂ hS hd))
    (sliceBorrowIU : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {A : VTy} {B : VTy} {d : Expr} {S : Row} (x : LifeVar) (hΓ : Ctx.DeadP Γ) (hsc : VScoped Δ A) (hsideA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A) (hsideB : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b B) (hfree₁ : ¬ VFree x A) (hfree₂ : ¬ VFree x B) (hS : S.Unwind x) (hd : CDerivesP Δ Γ d (.val (.lolli (.array A) .unit))) (hd_ih : motive Δ Γ d (.val (.lolli (.array A) .unit)) hd),
      motive Δ Γ (withborUE d) (.val (sliceBorrowIUTy x Δ.meetOfDom A B S)) (CDerivesX.sliceBorrowIU (I := {pin := true}) (Δ := Δ) (Γ := Γ) (A := A) (B := B) (d := d) (S := S) x hΓ hsc hsideA hsideB hfree₁ hfree₂ hS hd))
    (lolliE : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {Γ₁ : Ctx VTy} {Γ₂ : Ctx VTy} {f : Expr} {a : Expr} {A : VTy} {B : VTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (ha : CDerivesP Δ Γ₁ a (.val A)) (hf : CDerivesP Δ Γ₂ f (.val (.lolli A B))) (ha_ih : motive Δ Γ₁ a (.val A) ha) (hf_ih : motive Δ Γ₂ f (.val (.lolli A B)) hf),
      motive Δ Γ (.app f a) (.val B) (CDerivesX.lolliE (I := {pin := true}) (Δ := Δ) (Γ := Γ) (Γ₁ := Γ₁) (Γ₂ := Γ₂) (f := f) (a := a) (A := A) (B := B) hs ha hf))
    (allEV : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {x : LifeVar} {b : Lifetime.Life} {a : Lifetime.Life} {A : VTy} (h : CDerivesP Δ Γ e (.val (.all x b A))) (hlt : Δ.EntailsLt a b) (h_ih : motive Δ Γ e (.val (.all x b A)) h),
      motive Δ Γ (.app e (.val .unit)) (.val (A.instLife x a)) (CDerivesX.allEV (I := {pin := true}) (Δ := Δ) (Γ := Γ) (e := e) (x := x) (b := b) (a := a) (A := A) h hlt))
    (nuOutK : ∀ {Δ : LifeCtx} {Γ : Ctx VTy} {i : Nat} {C : CTy} {G S : VTy} (hC : C.NuOk) (hG : G.forceTy = some (.arr S (C.instT S))) (hS : C.BindsFresh S) (hGf : C.BindsFresh G) (h : Ctx.SoloP Γ i (codeTy C G S)),
      motive Δ Γ (.var i) (.comp (C.instT (codeTy C G S))) (CDerivesX.nuOutK (I := {pin := true}) (Δ := Δ) (Γ := Γ) (i := i) (C := C) (G := G) (S := S) hC hG hS hGf h))
