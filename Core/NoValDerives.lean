  | effLet {Δ Γ Γ₁ Γ₂ M N A B} {S : Row} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hW : S.Cancels → Γ₂.OwnFree) (hU : S.Unr → Ctx.Banged Γ₂)
      (hM : CDerivesNV Δ Γ₁ M (.comp (CTy.effOf S A)))
      (hN : CDerivesNV Δ (⟨A, true⟩ :: Γ₂) N (.comp (CTy.effOf S B))) :
      CDerivesNV Δ Γ (.app (.val (.lam N)) M) (.comp (CTy.effOf S B))
  | effThen {Δ Γ Γ₁ Γ₂ M N D A B} {S SM SD : Row} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hNZ : S.NZ)
      (hUq : S.Uniq) (hU : S.UnrD → Ctx.Banged Γ₂) (hMS : RowLe SM S) (hDS : RowLe SD S)
      (hfin : ∀ n i o o', Row.find SM n i = some o → Row.find S n i = some o' →
        o.finRead = true → ThenLe o.fin SD o'.fin)
      (hP : SD.UnrD → SM.PendPers) (hSD : Row.divB SD = false)
      (hM : CDerivesNV Δ Γ₁ M (.comp (CTy.effOf SM A)))
      (hN : CDerivesNV Δ (⟨A, true⟩ :: Γ₂) N (.comp (CTy.effOf S B)))
      (hD : CDerivesNV Δ (⟨.unit, false⟩ :: Γ₂) D (.comp (CTy.effOf SD .unit))) :
      CDerivesNV Δ Γ (thenE N D M) (.comp (CTy.effOf S B))
  | effThenDiv {Δ Γ Γ₁ Γ₂ M N D A B} {S SM SD : Row} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hNZ : S.NZ)
      (hUq : S.Uniq) (hU : S.UnrD → Ctx.Banged Γ₂) (hMS : RowLe SM S) (hDS : RowLe SD S)
      (hfin : ∀ n i o o', Row.find SM n i = some o → Row.find S n i = some o' →
        o.finRead = true → ThenLe o.fin SD o'.fin)
      (hP : SD.UnrD → SM.PendPers) (hcap : ∀ o ∈ SM, capB o.q o.B = false)
      (hM : CDerivesNV Δ Γ₁ M (.comp (CTy.effOf SM A)))
      (hN : CDerivesNV Δ (⟨A, true⟩ :: Γ₂) N (.comp (CTy.effOf S B)))
      (hD : CDerivesNV Δ (⟨.unit, false⟩ :: Γ₂) D (.comp (CTy.effOf SD .unit))) :
      CDerivesNV Δ Γ (thenE N D M) (.comp (CTy.effOf S B))
  | effHandleT {Δ Γ Γ₁ Γ₂} {Hr Hc e : Expr} {S SN : Row} {E : List (Qual × VTy × VTy)} {fs : Nat → CTy}
      {n : UInt32} {A R : VTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂) (hd : Ctx.DeadP Γ₁)
      (hHr : Hr.ValFormIn Γ₁) (hHc : Hc.ValFormIn Γ₁)
      (hc : CDerivesNV Δ Γ₁ (.pair Hr Hc) (.val (.tensor (retTy S A R) (ansesTy S SN R E))))
      (hn0 : n ≠ 0) (hnd : n ≠ divEff) (hnS : ∀ o ∈ S, o.n ≠ n) (hlen : E.length ≤ 2 ^ 32)
      (hSN : RowLe SN S) (hLin : ∀ o ∈ SN, o.q = .lin ∧ o.abort = false)
      (he : CDerivesNV Δ Γ₂ e (.comp (CTy.effOf (Row.ofEff n E 0 fs ++ S) A))) :
      CDerivesNV Δ Γ (hndExpr n (E.map Prod.fst) (.pair Hr (tailTuple E 0 Hc)) e)
        (.comp (CTy.effOf S R))
  | effHandleL {Δ Γ Γ₁ Γ₂} {Hr Hw Hn e : Expr} {S SW : Row} {E : List (Qual × VTy × VTy)}
      {fs : Nat → CTy} {Xs : Nat → VTy} {n : UInt32} {A R : VTy} (hs : Ctx.SplitP Γ Γ₁ Γ₂)
      (hd : Ctx.DeadP Γ₁) (hHr : Hr.ValFormIn Γ₁) (hHw : Hw.ValFormIn Γ₁) (hHn : Hn.ValFormIn Γ₁)
      (hc : CDerivesNV Δ Γ₁ (.pair Hr (.pair Hw Hn))
        (.val (.tensor (retTy S A R) (.tensor (worksTy S SW R Xs E 0) (exitsTy S R Xs E 0)))))
      (hn0 : n ≠ 0) (hnd : n ≠ divEff) (hnS : ∀ o ∈ S, o.n ≠ n) (hlen : E.length ≤ 2 ^ 32)
      (hNZ : S.NZ) (hCancel : ∀ o ∈ E, o.1 = .cancel ∨ (o.2.2.isZero && o.1 != .lin) = true)
      (hSW : RowLe SW S) (hSu : ¬ S.UnrD)
      (hFin : ∀ j, j < E.length → LastFinOK S SW (fs j) (Xs j))
      (he : CDerivesNV Δ Γ₂ e (.comp (CTy.effOf (Row.ofEff n E 0 fs ++ S) A))) :
      CDerivesNV Δ Γ (hndExpr n (E.map Prod.fst) (.pair Hr (lastTuple E 0 Hw Hn)) e)
        (.comp (CTy.effOf S R))
  | letPoly {Δ Γ N C} {j : Jdg} (b : Expr) (hcl : closedAt 0 (Val.lam b).1 = true)
      (hV : CDerivesNV Δ [] (.val (.lam b)) j)
      (hN : CDerivesNV Δ (⟨.unit, false⟩ :: Γ) ((N.subst 0 (Val.lam b)).shift 1 0) (.comp C)) :
      CDerivesNV Δ Γ (.app (.val (.lam N)) (.val (.lam b))) (.comp C)
  | alpha {Δ Γ e} {j j' : Jdg} (h : CDerivesNV Δ Γ e j) (hα : j.alphaB j' = true) :
      CDerivesNV Δ Γ e j'

/-- **A `CDerivesNV` derivation is a `CDerives` one**, constructor for constructor. -/
theorem CDerivesNV.toC {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {j : Jdg}
    (h : CDerivesNV Δ Γ e j) : CDerives Δ Γ e j := by
  induction h with
  | var a0 => exact CDerives.var a0
  | unitI a0 => exact CDerives.unitI a0
  | tensorI a0 a1 a2 ih0 ih1 => exact CDerives.tensorI a0 ih0 ih1
  | sumI₁ a0 ih0 => exact CDerives.sumI₁ ih0
  | sumI₂ a0 ih0 => exact CDerives.sumI₂ ih0
  | thunkF a0 ih0 => exact CDerives.thunkF ih0
  | thunkV a0 a1 ih0 => exact CDerives.thunkV a0 ih0
  | ret a0 ih0 => exact CDerives.ret ih0
  | bind a0 a1 a2 ih0 ih1 => exact CDerives.bind a0 ih0 ih1
  | force a0 => exact CDerives.force a0
  | lam a0 ih0 => exact CDerives.lam ih0
  | lamDead a0 ih0 => exact CDerives.lamDead ih0
  | app a0 a1 a2 ih0 => exact CDerives.app a0 ih0 a2
  | withI a0 a1 ih0 ih1 => exact CDerives.withI ih0 ih1
  | proj₁ a0 ih0 => exact CDerives.proj₁ ih0
  | proj₂ a0 ih0 => exact CDerives.proj₂ ih0
  | topI => exact CDerives.topI
  | unitE a0 a1 a2 ih0 ih1 => exact CDerives.unitE a0 ih0 ih1
  | tensorE a0 a1 a2 ih0 ih1 => exact CDerives.tensorE a0 ih0 ih1
  | sumE a0 a1 a2 a3 ih0 ih1 ih2 => exact CDerives.sumE a0 ih0 ih1 ih2
  | zeroE a0 a1 ih0 => exact CDerives.zeroE a0 ih0
  | allI a0 a1 a2 a3 ih0 => exact CDerives.allI a0 a1 a2 ih0
  | allE a0 a1 ih0 => exact CDerives.allE ih0 a1
  | bangThunkF a0 a1 ih0 => exact CDerives.bangThunkF a0 ih0
  | bangThunkV a0 a1 a2 ih0 => exact CDerives.bangThunkV a0 a1 ih0
  | bangE a0 ih0 => exact CDerives.bangE ih0
  | copyBang a0 => exact CDerives.copyBang a0
  | releaseBang a0 => exact CDerives.releaseBang a0
  | boxI a0 a1 ih0 => exact CDerives.boxI ih0 a1
  | boxE a0 ih0 => exact CDerives.boxE ih0
  | immSub a0 a1 ih0 => exact CDerives.immSub ih0 a1
  | mutSub a0 a1 ih0 => exact CDerives.mutSub ih0 a1
  | alloc a0 => exact CDerives.alloc a0
  | free a0 => exact CDerives.free a0
  | tokMint a0 => exact CDerives.tokMint a0
  | tokBurn a0 => exact CDerives.tokBurn a0
  | swap a0 => exact CDerives.swap a0
  | copy a0 => exact CDerives.copy a0
  | releaseImm a0 => exact CDerives.releaseImm a0
  | releaseMut a0 => exact CDerives.releaseMut a0
  | releaseUnk a0 => exact CDerives.releaseUnk a0
  | lit a0 a1 => exact CDerives.lit a0 a1
  | hostOp a0 a1 => exact CDerives.hostOp a0 a1
  | arrNew a0 a1 => exact CDerives.arrNew a0 a1
  | arrFree a0 a1 => exact CDerives.arrFree a0 a1
  | arrSize a0 a1 => exact CDerives.arrSize a0 a1
  | arrReplace a0 a1 => exact CDerives.arrReplace a0 a1
  | arrLen a0 a1 a2 => exact CDerives.arrLen a0 a1 a2
  | arrGet a0 a1 a2 => exact CDerives.arrGet a0 a1 a2
  | arrCopy a0 a1 a2 => exact CDerives.arrCopy a0 a1 a2
  | arrRelease a0 a1 a2 => exact CDerives.arrRelease a0 a1 a2
  | countFold a0 a1 => exact CDerives.countFold a0 a1
  | countTry a0 a1 a2 => exact CDerives.countTry a0 a1 a2
  | boundedFix a0 a1 a2 => exact CDerives.boundedFix a0 a1 a2
  | iterate a0 a1 a2 a3 a4 a5 => exact CDerives.iterate a0 a1 a2 a3 a4 a5
  | divFuel a0 a1 a2 a3 => exact CDerives.divFuel a0 a1 a2 a3
  | sliceBorrowM a0 a1 a2 a3 a4 a5 => exact CDerives.sliceBorrowM a0 a1 a2 a3 a4 a5
  | sliceBorrowI a0 a1 a2 a3 a4 a5 a6 => exact CDerives.sliceBorrowI a0 a1 a2 a3 a4 a5 a6
  | sliceGetM a0 a1 a2 => exact CDerives.sliceGetM a0 a1 a2
  | sliceLenM a0 a1 a2 => exact CDerives.sliceLenM a0 a1 a2
  | sliceSplitI a0 a1 a2 => exact CDerives.sliceSplitI a0 a1 a2
  | sliceSplitM a0 a1 a2 => exact CDerives.sliceSplitM a0 a1 a2
  | sliceEmptyI a0 a1 a2 => exact CDerives.sliceEmptyI a0 a1 a2
  | sliceEmptyM a0 a1 a2 => exact CDerives.sliceEmptyM a0 a1 a2
  | arrEmpty a0 a1 => exact CDerives.arrEmpty a0 a1
  | sliceReplaceM a0 a1 a2 => exact CDerives.sliceReplaceM a0 a1 a2
  | sliceSwapM a0 a1 a2 => exact CDerives.sliceSwapM a0 a1 a2
  | withbor1 a0 a1 a2 a3 a4 a5 => exact CDerives.withbor1 a0 a1 a2 a3 a4 a5
  | withbor2 a0 a1 a2 a3 a4 a5 => exact CDerives.withbor2 a0 a1 a2 a3 a4 a5
  | withbor3 a0 a1 a2 a3 a4 => exact CDerives.withbor3 a0 a1 a2 a3 a4
  | withload a0 a1 a2 a3 a4 => exact CDerives.withload a0 a1 a2 a3 a4
  | withswap a0 => exact CDerives.withswap a0
  | withbor1U a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 => exact CDerives.withbor1U a0 a1 a2 a3 a4 a5 a6 a7 ih0
  | withbor2U a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 => exact CDerives.withbor2U a0 a1 a2 a3 a4 a5 a6 a7 ih0
  | withbor3U a0 a1 a2 a3 a4 a5 a6 a7 ih0 => exact CDerives.withbor3U a0 a1 a2 a3 a4 a5 a6 ih0
  | withloadU a0 a1 a2 a3 a4 a5 => exact CDerives.withloadU a0 a1 a2 a3 a4 a5
  | sliceBorrowMU a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 => exact CDerives.sliceBorrowMU a0 a1 a2 a3 a4 a5 a6 a7 ih0
  | sliceBorrowIU a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 ih0 => exact CDerives.sliceBorrowIU a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0
  | lolliE a0 a1 a2 ih0 ih1 => exact CDerives.lolliE a0 ih0 ih1
  | allEV a0 a1 ih0 => exact CDerives.allEV ih0 a1
  | ofRet a0 ih0 => exact CDerives.ofRet ih0
  | roll a0 a1 a2 ih0 => exact CDerives.roll a0 a1 ih0
  | unroll a0 ih0 => exact CDerives.unroll ih0
  | foldImm a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 => exact CDerives.foldImm a0 a1 a2 a3 a4 a5 a6 a7 a8 a9
  | foldOwn a0 a1 a2 a3 a4 => exact CDerives.foldOwn a0 a1 a2 a3 a4
  | foldReuse a0 a1 a2 a3 a4 => exact CDerives.foldReuse a0 a1 a2 a3 a4
  | foldOwnG a0 a1 a2 a3 => exact CDerives.foldOwnG a0 a1 a2 a3
  | nuIn a0 a1 ih0 => exact CDerives.nuIn a0 ih0
  | nuOut a0 a1 ih0 => exact CDerives.nuOut a0 ih0
  | unfoldN a0 a1 a2 a3 a4 => exact CDerives.unfoldN a0 a1 a2 a3 a4
  | effSub a0 a1 ih0 => exact CDerives.effSub a0 ih0
  | effPerform a0 a1 a2 a3 ih0 => exact CDerives.effPerform a0 a1 a2 ih0
  | effAwait a0 a1 a2 a3 a4 a5 => exact CDerives.effAwait a0 a1 a2 a3 a4 a5
  | effRaise a0 a1 a2 a3 a4 ih0 => exact CDerives.effRaise a0 a1 a2 a3 ih0
  | effLet a0 a1 a2 a3 a4 ih0 ih1 => exact CDerives.effLet a0 a1 a2 ih0 ih1
  | effThen a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1 ih2 => exact CDerives.effThen a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 ih1 ih2
  | effThenDiv a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1 ih2 => exact CDerives.effThenDiv a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 ih1 ih2
  | effHandleT a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 ih0 ih1 => exact CDerives.effHandleT a0 a1 a2 a3 ih0 a5 a6 a7 a8 a9 a10 ih1
  | effHandleL a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 ih0 ih1 => exact CDerives.effHandleL a0 a1 a2 a3 a4 ih0 a6 a7 a8 a9 a10 a11 a12 a13 a14 ih1
  | letPoly a0 a1 a2 a3 ih0 ih1 => exact CDerives.letPoly a0 a1 ih0 ih1
  | alpha a0 a1 ih0 => exact CDerives.alpha ih0 a1

end BoCa.Fig16.LogRel.Core
