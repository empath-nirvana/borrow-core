-- The slice library (SPEC §9, `docs/strings-slices-design.md` §4.2): functions on the views an
-- array lends, `array_imm 'a A` (shared) and `array_mut 'a A` (exclusive), written over the
-- family constants of SPEC §9 (`slice_split_*`, `slice_empty_*`, `slice_replace_mut`,
-- `slice_swap_mut`, `slice_get_mut`, `slice_len_mut`, `array_get`, `array_len`, …) and the
-- counted loop `count_fold` (SPEC §16). `include slice` puts them in scope.
--
-- Every function is generic in the element type `A` (`fn f[A]<'a>(…)`) and takes the view's
-- lifetime `'a`; a call writes neither: `reverse(v)`, `eq(a, b, eq_u8)`. A generic function is
-- a template, elaborated at each use at the types of that use (typed elaboration §7, generic
-- functions): the functions that copy an element (`at`, `peek`, `set`, `fill`, `copy_from`, and
-- every search and comparison) need a persistent `A`, such as `u8` or `i32`, and are rejected
-- at any other. A search or a comparison takes the element comparison as an argument (`eq_u8`,
-- `cmp_i32`, …, below): there are no traits.
--
-- A view is not copied or dropped by these functions without saying so: an exclusive view is
-- handed back, and a shared one is copied with `array_copy` where it is read twice. Loops are
-- `count_fold`s whose step is a closure `!{ … }` over the loop's state that captures nothing,
-- so a loop allocates nothing and calls its step directly. An index is checked where it is
-- dynamic: out of range, a read answers its default and a write does nothing.

-- ### Element comparisons

-- Equality and order of bytes (unsigned) and of `i32`s (signed). An order answers `-1`, `0` or
-- `1`.
fn eq_u8(x: u8, y: u8) -> bool = x == y

fn cmp_u8(x: u8, y: u8) -> i32 = if x < y { 0 - 1 } else { if y < x { 1 } else { 0 } }

fn eq_i32(x: i32, y: i32) -> bool = x == y

fn cmp_i32(x: i32, y: i32) -> i32 = if x < y { 0 - 1 } else { if y < x { 1 } else { 0 } }

-- ### Access

-- The length of a shared view.
fn len[A]<'a>(v: array_imm 'a A) -> i32 = array_len['a, A](v)

-- The length of a shared view, and the view back.
fn len_imm[A]<'a>(v: array_imm 'a A) -> array_imm 'a A * i32 =
  let (v, w) = array_copy['a, A](v);
  (v, array_len['a, A](w))

-- The length of an exclusive view, and the view back.
fn len_mut[A]<'a>(v: array_mut 'a A) -> array_mut 'a A * i32 = slice_len_mut['a, A](v)

-- The element at `i` as a shared borrow, or `inr ()` past the end.
fn get[A]<'a>(v: array_imm 'a A, i: i32) -> imm 'a A + 1 = array_get['a, A](v, i)

-- The element at `i` as an exclusive borrow, or `inr ()` past the end. The rest of the view is
-- given up.
fn get_mut[A]<'a>(v: array_mut 'a A, i: i32) -> mut 'a A + 1 = slice_get_mut['a, A](v, i)

-- A copy of the element a shared borrow points at.
fn read[A]<'a>(g: imm 'a A) -> A = *g

-- A copy of the element at `i`, or `d` past the end.
fn at[A]<'a>(v: array_imm 'a A, i: i32, d: A) -> A =
  match get(v, i) { inl g -> *g | inr u -> d }

-- `x` in slot `i`, and what was there: `inl old`, or `inr x` past the end.
fn replace[A]<'a>(v: array_mut 'a A, i: i32, x: A) -> array_mut 'a A * (A + A) =
  slice_replace_mut['a, A](v, i, x)

-- A copy of the element at `i` read through an exclusive view, or `d` past the end: the element
-- is taken out with `d` in its place and put back.
fn peek[A]<'a>(v: array_mut 'a A, i: i32, d: A) -> array_mut 'a A * A =
  let (v, o) = replace(v, i, d);
  match o {
    inl x -> let (v, _) = replace(v, i, x); (v, x)
  | inr _ -> (v, d)
  }

-- `x` in slot `i`; the element that was there is dropped. Past the end, nothing changes.
fn set[A]<'a>(v: array_mut 'a A, i: i32, x: A) -> array_mut 'a A =
  let (v, _) = replace(v, i, x);
  v

-- Slots `i` and `j` exchanged. If either is past the end, nothing changes.
fn swap_at[A]<'a>(v: array_mut 'a A, i: i32, j: i32) -> array_mut 'a A =
  slice_swap_mut['a, A](v, i, j)

-- The view given up.
fn discard_mut[A]<'a>(v: array_mut 'a A) -> 1 =
  match get_mut(v, 0 - 1) { inl m -> forget_mut['a, A](m) | inr u -> u }

-- ### Splitting

-- The empty views.
fn empty[A]<'a>() -> array_imm 'a A = slice_empty_imm['a, A]

fn empty_mut[A]<'a>() -> array_mut 'a A = slice_empty_mut['a, A]

-- The view cut at `i`: `inl` of the first `i` elements and the rest, both at the view's
-- lifetime, or `inr` of the view itself when `i` is past its length.
fn split_at[A]<'a>(v: array_imm 'a A, i: i32) -> array_imm 'a A * array_imm 'a A + array_imm 'a A =
  slice_split_imm['a, A](v, i)

fn split_at_mut[A]<'a>(v: array_mut 'a A, i: i32) -> array_mut 'a A * array_mut 'a A + array_mut 'a A =
  slice_split_mut['a, A](v, i)

-- The first element and the rest, or `inr ()` for the empty view.
fn split_first[A]<'a>(v: array_imm 'a A) -> imm 'a A * array_imm 'a A + 1 =
  match split_at(v, 1) {
    inl (h, t) -> match get(h, 0) {
                    inl e -> inl (e, t)
                  | inr u -> array_forget['a, A](t); inr u
                  }
  | inr w -> array_forget['a, A](w); inr ()
  }

fn split_first_mut[A]<'a>(v: array_mut 'a A) -> mut 'a A * array_mut 'a A + 1 =
  match split_at_mut(v, 1) {
    inl (h, t) -> match get_mut(h, 0) {
                    inl e -> inl (e, t)
                  | inr u -> discard_mut(t); inr u
                  }
  | inr w -> discard_mut(w); inr ()
  }

-- The last element and the rest, or `inr ()` for the empty view.
fn split_last[A]<'a>(v: array_imm 'a A) -> imm 'a A * array_imm 'a A + 1 =
  let (v, w) = array_copy['a, A](v);
  match split_at(v, len(w) - 1) {
    inl (t, h) -> match get(h, 0) {
                    inl e -> inl (e, t)
                  | inr u -> array_forget['a, A](t); inr u
                  }
  | inr w -> array_forget['a, A](w); inr ()
  }

fn split_last_mut[A]<'a>(v: array_mut 'a A) -> mut 'a A * array_mut 'a A + 1 =
  let (v, n) = len_mut(v);
  match split_at_mut(v, n - 1) {
    inl (t, h) -> match get_mut(h, 0) {
                    inl e -> inl (e, t)
                  | inr u -> discard_mut(t); inr u
                  }
  | inr w -> discard_mut(w); inr ()
  }

-- ### Writes

-- The elements in reverse order, in place: `n / 2` swaps.
fn reverse[A]<'a>(v: array_mut 'a A) -> array_mut 'a A =
  let (v, n) = len_mut(v);
  let (v, _) = count_fold[array_mut 'a A * i32](
    !{ (i, (v, n)) -> (swap_at(v, i, n - 1 - i), n) },
    host[shr_u32](n, 1), 0, (v, n));
  v

-- `x` in every slot.
fn fill[A]<'a>(v: array_mut 'a A, x: A) -> array_mut 'a A =
  let (v, n) = len_mut(v);
  let (v, _) = count_fold[array_mut 'a A * A](!{ (i, (v, x)) -> (set(v, i, x), x) }, n, 0, (v, x));
  v

-- The elements of `src` copied into `dst`, slot by slot, as far as the shorter of the two.
fn copy_from[A]<'a, 'b>(dst: array_mut 'a A, src: array_imm 'b A) -> array_mut 'a A =
  let (v, n) = len_mut(dst);
  let (w, r) = array_copy['b, A](src);
  let m = len(r);
  let k = if n < m { n } else { m };
  let (v, w) = count_fold[array_mut 'a A * array_imm 'b A](
    !{ (i, (v, w)) ->
      let (w, r) = array_copy['b, A](w);
      match get(r, i) { inl g -> (set(v, i, *g), w) | inr u -> (v, w) } },
    k, 0, (v, w));
  array_forget['b, A](w);
  v

-- ### Searching

-- The index of the first element equal to `x` under `eq`, or `inr ()`. The loop's state is the
-- view, the element sought, the equality, and the index found.
fn find[A]<'a>(v: array_imm 'a A, x: A, eq: !(A * A => bool)) -> i32 + 1 =
  let (v, w) = array_copy['a, A](v);
  let (v, (_, (_, r))) = count_fold[array_imm 'a A * (A * (!(A * A => bool) * (i32 + 1)))](
    !{ (i, (v, (x, (eq, r)))) ->
      match r {
        inl k -> (v, (x, (eq, inl k)))
      | inr n ->
          let (v, w) = array_copy['a, A](v);
          match get(w, i) {
            inl g -> if eq(read(g), x) { (v, (x, (eq, inl i))) } else { (v, (x, (eq, inr n))) }
          | inr m -> (v, (x, (eq, inr m)))
          }
      } },
    len(w), 0, (v, (x, (eq, inr ()))));
  array_forget['a, A](v);
  r

-- Whether an element equals `x` under `eq`.
fn contains[A]<'a>(v: array_imm 'a A, x: A, eq: !(A * A => bool)) -> bool =
  match find(v, x, eq) { inl i -> true | inr u -> false }

-- In a view sorted by `cmp`: `inl i` for an index of an element equal to `x`, or `inr i` for
-- the index where `x` would be inserted to keep it sorted. The range left, `[lo, hi)`, halves at
-- each of at most 32 steps.
fn binary_search[A]<'a>(v: array_imm 'a A, x: A, c: !(A * A => i32)) -> i32 + i32 =
  let (v, w) = array_copy['a, A](v);
  let (v, (_, (_, (lo, (_, r))))) =
    count_fold[array_imm 'a A * (A * (!(A * A => i32) * (i32 * (i32 * (i32 + 1)))))](
    !{ (k, (v, (x, (c, (lo, (hi, r)))))) ->
      match r {
        inl f -> (v, (x, (c, (lo, (hi, inl f)))))
      | inr n ->
          if lo < hi {
            let mid = lo + host[shr_u32](hi - lo, 1);
            let (v, z) = array_copy['a, A](v);
            match get(z, mid) {
              inl g -> let o = c(read(g), x);
                       if o < 0 { (v, (x, (c, (mid + 1, (hi, inr n))))) }
                       else { if 0 < o { (v, (x, (c, (lo, (mid, inr n))))) }
                              else { (v, (x, (c, (lo, (hi, inl mid))))) } }
            | inr m -> (v, (x, (c, (lo, (lo, inr m)))))
            }
          } else { (v, (x, (c, (lo, (hi, inr n))))) }
      } },
    32, 0, (v, (x, (c, (0, (len(w), inr ()))))));
  array_forget['a, A](v);
  match r { inl i -> inl i | inr m -> inr lo }

-- ### Comparing

-- The lexicographic order of two views under the element order `cmp`: `-1`, `0` or `1`. The
-- loop's state is both views, the order, and the order of the prefixes compared so far (`0`
-- while they are equal).
fn cmp[A]<'a, 'b>(v: array_imm 'a A, w: array_imm 'b A, c: !(A * A => i32)) -> i32 =
  let (v, v2) = array_copy['a, A](v);
  let (w, w2) = array_copy['b, A](w);
  let n = len(v2);
  let m = len(w2);
  let k = if n < m { n } else { m };
  let (v, (w, (_, r))) = count_fold[array_imm 'a A * (array_imm 'b A * (!(A * A => i32) * i32))](
    !{ (i, (v, (w, (c, r)))) ->
      if r == 0 {
        let (v, v2) = array_copy['a, A](v);
        let (w, w2) = array_copy['b, A](w);
        match get(v2, i) {
          inl g -> match get(w2, i) {
                     inl h -> (v, (w, (c, c(read(g), read(h)))))
                   | inr m -> (v, (w, (c, r)))
                   }
        | inr m -> (v, (w, (c, r)))
        }
      } else { (v, (w, (c, r))) } },
    k, 0, (v, (w, (c, 0))));
  array_forget['a, A](v);
  array_forget['b, A](w);
  if r == 0 { if n < m { 0 - 1 } else { if m < n { 1 } else { 0 } } } else { r }

-- Whether two views have the same elements under `eq`.
fn eq[A]<'a, 'b>(v: array_imm 'a A, w: array_imm 'b A, e: !(A * A => bool)) -> bool =
  let (v, v2) = array_copy['a, A](v);
  let (w, w2) = array_copy['b, A](w);
  let n = len(v2);
  if n == len(w2) {
    let (v, (w, (_, r))) = count_fold[array_imm 'a A * (array_imm 'b A * (!(A * A => bool) * bool))](
      !{ (i, (v, (w, (e, r)))) ->
        if r {
          let (v, v2) = array_copy['a, A](v);
          let (w, w2) = array_copy['b, A](w);
          match get(v2, i) {
            inl g -> match get(w2, i) {
                       inl h -> (v, (w, (e, e(read(g), read(h)))))
                     | inr m -> (v, (w, (e, false)))
                     }
          | inr m -> (v, (w, (e, false)))
          }
        } else { (v, (w, (e, r))) } },
      n, 0, (v, (w, (e, true))));
    array_forget['a, A](v);
    array_forget['b, A](w);
    r
  } else { array_forget['a, A](v); array_forget['b, A](w); false }

-- Whether `v` begins with the elements of `p` under `eq`.
fn starts_with[A]<'a, 'b>(v: array_imm 'a A, p: array_imm 'b A, e: !(A * A => bool)) -> bool =
  let (p, p2) = array_copy['b, A](p);
  match split_at(v, len(p2)) {
    inl (h, t) -> array_forget['a, A](t); eq(h, p, e)
  | inr w -> array_forget['a, A](w); array_forget['b, A](p); false
  }

-- Whether `v` ends with the elements of `p` under `eq`.
fn ends_with[A]<'a, 'b>(v: array_imm 'a A, p: array_imm 'b A, e: !(A * A => bool)) -> bool =
  let (p, p2) = array_copy['b, A](p);
  let m = len(p2);
  let (v, v2) = array_copy['a, A](v);
  let n = len(v2);
  if m <= n {
    match split_at(v, n - m) {
      inl (h, t) -> array_forget['a, A](h); eq(t, p, e)
    | inr w -> array_forget['a, A](w); array_forget['b, A](p); false
    }
  } else { array_forget['a, A](v); array_forget['b, A](p); false }

-- ### Sorting

-- The elements in the order `cmp`, in place: an insertion sort, stable. `d` is any element, put
-- in a slot while its element is read. Element `i` is inserted by steps at `j = i − k`: the pair
-- `(j − 1, j)` is exchanged when it is out of order, and the insertion stops at the first pair in
-- order.
fn sort[A]<'a>(v: array_mut 'a A, c: !(A * A => i32), d: A) -> array_mut 'a A =
  let (v, n) = len_mut(v);
  let (v, _) = count_fold[array_mut 'a A * (!(A * A => i32) * A)](
    !{ (i, (v, (c, d))) ->
      let (v, (c, (d, _))) = count_fold[array_mut 'a A * (!(A * A => i32) * (A * (i32 * bool)))](
        !{ (k, (v, (c, (d, (i, go))))) ->
          if go {
            let j = i - k;
            let (v, x) = peek(v, j - 1, d);
            let (v, y) = peek(v, j, d);
            if 0 < c(x, y) { (swap_at(v, j - 1, j), (c, (d, (i, true)))) }
            else { (v, (c, (d, (i, false)))) }
          } else { (v, (c, (d, (i, go)))) } },
        i, 0, (v, (c, (d, (i, true)))));
      (v, (c, d)) },
    n, 1, (v, (c, d)));
  v

-- ### Iteration

-- A generator over the elements of a view, each lent at the view's lifetime: its state is the
-- rest of the view, and each observation splits off the first element (`split_first`) and yields
-- it. Every observation yields an element but the last, which finishes, so a view of `n`
-- elements is done after `n + 1` observations: a `for` over it is total (SPEC §16, the total
-- `for`). Closed early, it gives the rest up.
gen fn iter_imm[A]<'a>(v: array_imm 'a A) -> imm 'a A =
  let mut rest = v;
  while true {
    match split_first(rest) {
      inl (e, t) -> rest = t; yield e
    | inr u -> rest = empty[A]['a](); break
    }
  };
  ()

-- The same over an exclusive view: each element is lent `mut`, one at a time, and the rest of
-- the view is the state.
gen fn iter_mut[A]<'a>(v: array_mut 'a A) -> mut 'a A =
  let mut rest = v;
  while true {
    match split_first_mut(rest) {
      inl (e, t) -> rest = t; yield e
    | inr u -> rest = empty_mut[A]['a](); break
    }
  };
  ()
