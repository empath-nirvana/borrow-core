-- Files (SPEC §34, *Files*; SPEC §62): the effect `Fs`, its handler over the platform, and the
-- raising library over it. `include fs` puts it in scope; a `main` that performs `Fs` is served by
-- `files` around its body, whose clauses perform `FsHost`, which the platform serves on the
-- capability `fs`, as the standard streams (`lib/wasi.bc`).
--
-- A `File` is the opaque `file`: a handle owning a cell that holds its descriptor. It has no
-- derived drop and holds an owned cell, so it is never dropped silently; its destructor is
-- `fs_close` (`dtor file = fs_close`). A `File` live across a computation that may abort, or whose
-- continuation may be cancelled, is closed by that destructor on the unwind, the one bound last
-- first (`[let-dtor]`, SPEC §62); on the normal exit the program closes it.
--
-- Every buffer is owned: a read or a write moves the `string` into the operation and gets it back
-- with the answer, error or not. The path is moved in and handed back the same way.
--
-- The laws, which every handler of `Fs` keeps (every operation may answer an error instead):
-- * `fs_open(p, Reading)` opens the existing file at `p` for reading; `fs_open(p, Writing)`
--   creates it, or truncates it, for writing. It answers the file, or why not.
-- * `fs_read(f, b)` reads into `b`'s spare capacity (from its length to its capacity), appending:
--   at most the room, at least one byte while the file has more. It answers the count: `0` only at
--   the end, or when the buffer has no room (then it reads nothing).
-- * `fs_write(f, b)` writes every byte of `b`, in order.
-- * `fs_size(f)` answers the file's size in bytes when it is asked; a size of `2^31 - 1` or more
--   is `TooBig`.
-- * `fs_close(f)` ends the file; an error there still ends it.
-- * Each hands back the path, the buffer and the file as given, but for what it does to the
--   buffer.

include text
include io

-- An open file's handle.
type File = file

-- How a file is opened: to read it (it must exist), or to write it (created, or truncated).
data Mode = Reading | Writing

-- Why a file operation failed. `TooBig`: a size, a path or a buffer past what an `i32` indexes, or
-- a loop over a file that ran out of reads. `Other(c)` carries the host's own error number, which
-- differs between hosts.
data FsError = NotFound | Denied | IsDir | BadFile | TooBig | Other(i32)

-- The operations on files. Each must resume: none of them ends the computation that performs it,
-- so a destructor may perform one (`hSDc`, SPEC §62).
effect Fs {
  must_resume ctl fs_open(path: string, mode: Mode) -> string * (File + FsError);
  must_resume ctl fs_read(f: File, b: string) -> File * (string * (i32 + FsError));
  must_resume ctl fs_write(f: File, b: string) -> File * (string * (1 + FsError));
  must_resume ctl fs_size(f: File) -> File * (i32 + FsError);
  must_resume ctl fs_close(f: File) -> 1 + FsError
}

-- A file's destructor: `fs_close`, its answer dropped.
dtor file = fs_close

-- The platform's side of files: the same operations, answering, served on the capability `fs`.
effect FsHost {
  fn host_open(path: string, mode: Mode) -> string * (File + FsError);
  fn host_read(f: File, b: string) -> File * (string * (i32 + FsError));
  fn host_write(f: File, b: string) -> File * (string * (1 + FsError));
  fn host_size(f: File) -> File * (i32 + FsError);
  fn host_close(f: File) -> 1 + FsError
}

-- `Fs` over the platform: each clause performs the platform's operation and resumes with its
-- answer.
handler files[A]: Fs, A -> A = {
  return(a) = a;
  fs_open(p, m, k) = { k(host_open(p, m)) };
  fs_read(f, b, k) = { k(host_read(f, b)) };
  fs_write(f, b, k) = { k(host_write(f, b)) };
  fs_size(f, k) = { k(host_size(f)) };
  fs_close(f, k) = { k(host_close(f)) }
}

-- ### The WASI platform's handler

-- The externs answer `n >= 0`, or an error: `-1` not found, `-2` denied, `-3` a directory, `-4` a
-- bad file, `-5` too big, `-(16 + c)` any other with the host's number `c`. Their contracts are
-- `Core/Stdio.lean`'s; `bcc trusted` lists them. `file_mk` puts a descriptor in a fresh handle and
-- `file_take` frees the handle, answering its descriptor.
extern file_open : !(all 'a < top. all 'b < top.
  mut 'a fs * (array_imm 'b u8 * i32) => mut 'a fs * i32)
extern file_read : !(all 'a < top. all 'b < top.
  mut 'a fs * (i32 * array_mut 'b u8) => mut 'a fs * (array_mut 'b u8 * i32))
extern file_write : !(all 'a < top. all 'b < top.
  mut 'a fs * (i32 * array_imm 'b u8) => mut 'a fs * i32)
extern file_size : !(all 'a < top. mut 'a fs * i32 => mut 'a fs * i32)
extern file_close : !(all 'a < top. mut 'a fs * i32 => mut 'a fs * i32)
extern file_mk : !(i32 => file)
extern file_take : !(file => i32)

-- An extern's negative answer as the error it names.
fn fs_error(n: i32) -> FsError =
  if n == 0 - 1 { NotFound }
  else if n == 0 - 2 { Denied }
  else if n == 0 - 3 { IsDir }
  else if n == 0 - 4 { BadFile }
  else if n == 0 - 5 { TooBig }
  else { Other(0 - n - 16) }

-- An extern's answer as the operation's.
fn fs_answer(n: i32) -> i32 + FsError = if n < 0 { inr fs_error(n) } else { inl n }

-- Each clause takes the handle's descriptor, lends the buffer or the path to its extern for the one
-- call, and puts the descriptor in a handle again.
handler wasi_fs(&mut c: fs): FsHost = {
  host_open(p, m) = {
    let code = match m { Reading -> 0 | Writing -> 1 };
    let r = borrow imm p { v -> let (d, r) = file_open(c, v, code); c = d; r };
    if r < 0 { (p, inr fs_error(r)) } else { (p, inl file_mk(r)) }
  };
  host_read(f, b) = {
    let fd = file_take(f);
    let (a, n) = b;
    let (a, room) = array_size[u8](a);
    -- No room: nothing read, and no call.
    let r = borrow mut a { v ->
      if n < room {
        match split_at_mut(v, n) {
          inl (h, t) -> let (d, (t, k)) = file_read(c, fd, t); c = d; k
        | inr v -> 0
        }
      } else { 0 } };
    let k = if r > 0 { r } else { 0 };
    (file_mk(fd), ((a, n + k), fs_answer(r)))
  };
  host_write(f, b) = {
    let fd = file_take(f);
    let r = borrow imm b { v -> let (d, r) = file_write(c, fd, v); c = d; r };
    let u = if r < 0 { (inr fs_error(r) : 1 + FsError) } else { (inl () : 1 + FsError) };
    (file_mk(fd), (b, u))
  };
  host_size(f) = {
    let fd = file_take(f);
    let (d, r) = file_size(c, fd);
    c = d;
    (file_mk(fd), fs_answer(r))
  };
  host_close(f) = {
    let fd = file_take(f);
    let (d, r) = file_close(c, fd);
    c = d;
    if r < 0 { inr fs_error(r) } else { inl () }
  }
}

-- ### The library: each raises the operation's error, `Fail[FsError]`

-- An operation's answer, or its error raised. A file the caller holds across it is closed by its
-- destructor on the unwind.
fn or_raise[T](r: T + FsError) -> T with Fail[FsError] =
  match r { inl x -> x | inr e -> raise(e) }

-- The file at `path`, opened in `mode`, and the path back.
fn open(path: string, mode: Mode) -> string * File with Fs, Fail[FsError] =
  let (p, r) = fs_open(path, mode);
  let f = or_raise[File](r);
  (p, f)

-- The file ended. Its error, if any, is raised after the file has ended.
fn close(f: File) -> 1 with Fs, Fail[FsError] =
  or_raise[1](fs_close(f))

-- `b` cleared, and bytes of `f` read into it, up to its capacity (4096 when it has none): the
-- file, the buffer and the count, `0` at the end.
fn read(f: File, b: string) -> File * (string * i32) with Fs, Fail[FsError] =
  let (a, n) = b;
  let (a, room) = array_size[u8](a);
  let b = if room == 0 { reserve((a, 0), 4096) } else { (a, 0) };
  let (f, (b, r)) = fs_read(f, b);
  let k = or_raise[i32](r);
  (f, (b, k))

-- The rest of `f`, into one buffer of its size plus one (the room that sees the end), read until a
-- read answers `0`. A full buffer grows (twice, and 4096 more), so a file that grew, or one whose
-- size reads `0`, is read to its end; a buffer that would pass `2^31 - 1` bytes raises `TooBig`.
fn read_all(f: File) -> File * string with Fs, Fail[FsError] =
  let (f, sz) = fs_size(f);
  let size = or_raise[i32](sz);
  read_rest(f, string_new(size + 1))

-- The most reads `read_rest` makes: a device or a pipe that never ends raises `TooBig`.
def fs_max_reads : i32 = 2147483647

-- The rest of `f` appended to `s`, read until a read answers `0`, growing `s` when it is full.
fn read_rest(f: File, s: string) -> File * string with Fs, Fail[FsError] =
  let mut f = f;
  let mut s = s;
  let r = for _ in 0..fs_max_reads {
    let (a, n) = s;
    let (a, room) = array_size[u8](a);
    let stuck = n == room && room == 2147483647;
    let want = if room > 1073739775 { 2147483647 } else { room * 2 + 4096 };
    let t = if n < room || stuck { (a, n) } else { grow((a, n), want) };
    let (f2, (s2, x)) = fs_read(f, t);
    f = f2;
    s = s2;
    match x {
      inl k ->
        if k == 0 {
          if stuck { break (inr TooBig : 1 + FsError) } else { break (inl () : 1 + FsError) }
        } else { () }
    | inr e -> break (inr e : 1 + FsError)
    }
  } else { (inr TooBig : 1 + FsError) };
  let u = or_raise[1](r);
  (f, s)

-- Every byte of `b` written to `f`: the file and the buffer back.
fn write(f: File, b: string) -> File * string with Fs, Fail[FsError] =
  let (f, (b, r)) = fs_write(f, b);
  let u = or_raise[1](r);
  (f, b)

-- The error's name, for a message.
fn fs_error_name(e: FsError) -> lit =
  match e {
    NotFound -> "not found"
  | Denied -> "permission denied"
  | IsDir -> "is a directory"
  | BadFile -> "bad file"
  | TooBig -> "too big"
  | Other(c) -> "error"
  }
