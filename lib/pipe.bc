-- Stream stages and the pipe connector (SPEC §75 Part B). `Stream[A, K]` is the item effect: a
-- **stage** is a function that performs it, keyed on this declaration and never on the name.
--
-- * `next()` answers an item `inl a`, or `inr k`: the upstream has ended, returning `k`;
-- * `stop()` closes the whole upstream at once, downstream-first, and answers its residual `K`.
--
-- A middle stage also performs `Yield[B]` (`lib/yield.bc`); a sink performs no `Yield`. A stage
-- returns at its stream's end, and a middle stage's result is the `K` of the wire below it.
-- One-item lookahead is a pushback slot the stage holds, not an operation.
--
-- A chain of stream edges (`src >| s₁ >| … `, or `|>` into a stage) is one connector, assembled per
-- chain from the pieces below, each over one stage's or one wire's types (Assembly(n) §1); the
-- elaboration writes only the glue: the tuple of stage states and a dispatching loop.

include yield

effect Stream[A, K] { ctl next() -> A + K; ctl stop() -> K }

-- ---- One stage's types ------------------------------------------------------------------------
--
-- Stage `i` reads wire `i` (items `A`, end `K`), writes wire `i+1` (items `B`), returns `R`, and may
-- perform one forwarded outer operation (argument `OA`, answer `1`). Its sites are the connector's,
-- fresh per stage: `y` its `Yield[B]`, `s` its `Stream[A, K]`, `f` the fresh name of its forwarded
-- operation. A component a stage does not have is never performed: a source's `A` is `0`, a sink's
-- `B` is `0`, and a stage that forwards nothing has `OA = 0`. Its rows: `sg`, what it performs
-- besides, which passes to the outer handler; `cr`, its cleanup row (each stage operation's cancel
-- row). `stop()` is provided at `K = 1` only (SPEC §75), so its entry answers `1`.
--
-- What the connector keeps across turns outlives `top`: a loop's next state is boxed at `top`, and
-- a rest is built from the continuation a BOXED-κ clause (SPEC §28) receives at `top`. A stage not
-- yet run is its loop boxed at `top`, made from a deferred call (`div_defer`'s shape). So the
-- connector's state can be kept across a lend per observation (SPEC §75 Part A).

-- The stage's loop: one turn performs the stage's operations and answers its result or its next
-- state.  `[spec §75]`
type PipeLoop[A, K, B, R, OA, row sg, row cr, site y, site s, site f] =
  U (nu X. F[y.0 cancel[..cr] B ~> 1, s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] (R + box top U X) & F[..cr] 1)

-- The events of one turn, over the rest `KR`: Yield(b, κ) | Return(r) | Skip(l) | Next(κ) | Stop(κ)
-- | Fwd(a, κ).  `[spec §75]`
type PipeEvt[A, K, B, R, OA, KR, row sg, row cr, site y, site s, site f] =
  (B * KR + (R + box top PipeLoop[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])) + ((KR + KR) + OA * KR)

-- A stored rest, resumed with the turn's input `1 + (A + K)`: at a `next()` with the item or the
-- end, at a `yield`, a `stop()` or a forwarded operation with `()` (SPEC §75 (One-frame)). One type
-- for every rest: a `nu` type's variable occurs under no inner `U`, so two rests cannot be
-- mutually recursive types.  `[spec §75]`
type PipeRest[A, K, B, R, OA, row sg, row cr, site y, site s, site f] =
  box top U (nu X. (1 + (A + K) -o F[..sg] PipeEvt[A, K, B, R, OA, box top U X, row (..sg), row (..cr), site y, site s, site f])
    & F[..cr, ..sg] 1)

-- A turn's event.  `[spec §75]`
type PipeEv[A, K, B, R, OA, row sg, row cr, site y, site s, site f] = PipeEvt[A, K, B, R, OA, PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], row (..sg), row (..cr), site y, site s, site f]

-- A stage's state: Ready(l) | AtNext(κ) | AtYield(κ), AtStop(κ) or AtFwd(κ) | Ended(r).
-- `[spec §75]`
type PipeSt[A, K, B, R, OA, row sg, row cr, site y, site s, site f] = box top PipeLoop[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] + (PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] + (PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] + R))

-- ---- The storing clauses of a stage's sites (Part A, class (c)) -------------------------------
--
-- Each clause receives `κ` boxed at `top` (BOXED-κ) and answers the event with the rest, which
-- re-installs the sites outside the one that captured it: `f` is outermost, then `s`, then `y`
-- (SPEC §75 (One-frame)). A rest's cancel runs under clauses that cancel: a stage's cleanup performs
-- none of its sites' operations (its row is `cr`).

def pipe_f_hr[A, K, B, R, OA, row sg, row cr, site y, site s, site f] : !U (PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] -o F[..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) =
  !thunkv fun (e : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) -> return e

def pipe_f_hc[A, K, B, R, OA, row sg, row cr, site y, site s, site f] :
    !U (OA * box top U ((1 -o F[..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, ..sg] 1) -o F[..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) * 1 =
  (!thunkv fun (q : OA * box top U ((1 -o F[..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, ..sg] 1)) ->
     let (a, bk) = q;
     ky : PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] <-
       return (boxed[top] (thunkv nu_in <
         fun (i : 1 + (A + K)) -> let _ = i; k <- return (unbox bk); w <- return (); (force k).1 w,
         k <- return (unbox bk); (force k).2 >));
     return (inr (inr (a, ky)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]), ())

def pipe_f_cr[OA, row sg, row cr] : !U (1 -o F[..cr, ..sg] 1) = !thunkv fun (v : 1) -> return v

def pipe_f_cc[OA, row sg, row cr] :
    !U (OA * U ((1 -o F[..cr, ..sg] 1) & F[..cr, ..cr, ..sg] 1) -o F[..cr, ..sg] 1) * 1 =
  (!thunkv fun (q : OA * U ((1 -o F[..cr, ..sg] 1) & F[..cr, ..cr, ..sg] 1)) ->
     let (a, k) = q; let _ = a; (force k).2, ())

-- A stage that only pulls, each turn dropping what `next()` answers: what a rest at a `next()`
-- becomes when resumed with no item, which `pipe_step` never does (it answers `Next` again).
def pipe_drain[A, K, B, R, OA, row sg, row cr, site y, site s, site f] :
    !U (1 -o F[y.0 cancel[..cr] B ~> 1, s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] (R + box top 1) & F[..cr] 1) =
  !thunkv fun (u : 1) ->
    < let () = u; x <- perform[s.0] (); let _ = x; return (inr (boxed[top] ())),
      let () = u; return () >

def pipe_s_hr[A, K, B, R, OA, row sg, row cr, site y, site s, site f] : !U (PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) =
  !thunkv fun (e : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) -> return e

def pipe_s_hc[A, K, B, R, OA, row sg, row cr, site y, site s, site f] :
    !U (1 * box top U ((A + K -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
    * (!U (1 * box top U ((1 -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) * 1) =
  (!thunkv fun (q : 1 * box top U ((A + K -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1)) ->
     let (u, bk) = q; let () = u;
     kn : PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] <-
       return (boxed[top] (thunkv nu_in <
         fun (i : 1 + (A + K)) -> handle_with[f](pipe_f_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_f_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) (case i {
             inl u -> let () = u; k <- return (unbox bk); c <- (force k).2; let () = c;
               return (inl (inr (inr (boxed[top] (thunkv nu_in <
                 g <- return (unbang (unfold[nu X. F[y.0 cancel[..cr] B ~> 1, s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] (R + box top U X) & F[..cr] 1, 1] pipe_drain[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])); z <- return (); (nu_out (force g z)).1,
                 g <- return (unbang (unfold[nu X. F[y.0 cancel[..cr] B ~> 1, s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] (R + box top U X) & F[..cr] 1, 1] pipe_drain[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])); z <- return (); (nu_out (force g z)).2 >)))) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
           | inr v -> k <- return (unbox bk); (force k).1 v
           }),
         handle_with[f](pipe_f_cr[OA, row (..sg), row (..cr)], pipe_f_cc[OA, row (..sg), row (..cr)]) (k <- return (unbox bk); (force k).2) >));
     return (inr (inl (inl kn)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]),
   !thunkv fun (q : 1 * box top U ((1 -o F[f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1)) ->
     let (u, bk) = q; let () = u;
     ky : PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] <-
       return (boxed[top] (thunkv nu_in <
         fun (i : 1 + (A + K)) -> let _ = i; w <- return (); handle_with[f](pipe_f_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_f_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) (k <- return (unbox bk); (force k).1 w),
         handle_with[f](pipe_f_cr[OA, row (..sg), row (..cr)], pipe_f_cc[OA, row (..sg), row (..cr)]) (k <- return (unbox bk); (force k).2) >));
     return (inr (inl (inr ky)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]),
   ())

def pipe_s_cr[A, K, OA, row sg, row cr, site f] : !U (1 -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) =
  !thunkv fun (v : 1) -> return v

def pipe_s_cc[A, K, OA, row sg, row cr, site f] :
    !U (1 * U ((A + K -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) & F[..cr, ..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1)
    * (!U (1 * U ((1 -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) & F[..cr, ..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) * 1) =
  (!thunkv fun (q : 1 * U ((A + K -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) & F[..cr, ..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1)) ->
     let (u, k) = q; let () = u; (force k).2,
   !thunkv fun (q : 1 * U ((1 -o F[..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1) & F[..cr, ..cr, f.0 cancel[..cr] OA ~> 1, ..sg] 1)) ->
     let (u, k) = q; let () = u; (force k).2,
   ())

def pipe_y_hr[A, K, B, R, OA, row sg, row cr, site y, site s, site f] : !U (R + box top PipeLoop[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] -o F[s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) =
  !thunkv fun (o : R + box top PipeLoop[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) ->
    case o {
      inl r -> return (inl (inr (inl r)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
    | inr bl -> return (inl (inr (inr bl)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
    }

def pipe_y_hc[A, K, B, R, OA, row sg, row cr, site y, site s, site f] :
    !U (B * box top U ((1 -o F[s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] 1) -o F[s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) * 1 =
  (!thunkv fun (q : B * box top U ((1 -o F[s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) & F[..cr, s.0 cancel[..cr] 1 ~> A + K, s.1 cancel[..cr] 1 ~> 1, f.0 cancel[..cr] OA ~> 1, ..sg] 1)) ->
     let (b, bk) = q;
     ky : PipeRest[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] <-
       return (boxed[top] (thunkv nu_in <
         fun (i : 1 + (A + K)) -> let _ = i; w <- return ();
           handle_with[f](pipe_f_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_f_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) (handle_with[s](pipe_s_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_s_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) (k <- return (unbox bk); (force k).1 w)),
         handle_with[f](pipe_f_cr[OA, row (..sg), row (..cr)], pipe_f_cc[OA, row (..sg), row (..cr)]) (handle_with[s](pipe_s_cr[A, K, OA, row (..sg), row (..cr), site f], pipe_s_cc[A, K, OA, row (..sg), row (..cr), site f]) (k <- return (unbox bk); (force k).2)) >));
     return (inl (inl (b, ky)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]), ())

-- ---- The pieces (Assembly(n) §1)  `[spec §75, §76]` -------------------------------------------

-- step_i: one observation of the stage's loop under its storing clauses, or one resume of its rest
-- with the turn's input `1 + (A + K)`. An input that does not fit the state is dropped: at a `next()`
-- the rest is answered again (`Next`), at any other rest it is resumed with `()`; at `Ended` the
-- result is answered again.
def pipe_step[A, K, B, R, OA, row sg, row cr, site y, site s, site f] : !U (PipeSt[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] * (1 + (A + K)) -o F[..sg] PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) =
  !thunkv fun (p : PipeSt[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] * (1 + (A + K))) ->
    let (st, inp) = p;
    case st {
      inl bl -> let _ = inp;
        handle_with[f](pipe_f_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_f_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) (handle_with[s](pipe_s_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_s_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) (handle_with[y](pipe_y_hr[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f], pipe_y_hc[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
          (l <- return (unbox bl); (nu_out (force l)).1)))
    | inr r1 -> case r1 {
        inl kn -> case inp {
            inl u -> let () = u; return (inr (inl (inl kn)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
          | inr v -> k <- return (unbox kn); w : 1 + (A + K) <- return (inr v); (nu_out (force k)).1 w
          }
      | inr r2 -> case r2 {
          inl ky -> k <- return (unbox ky); (nu_out (force k)).1 inp
        | inr r -> let _ = inp; return (inl (inr (inl r)) : PipeEv[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f])
        }
      }
    }

-- stop_i: cancels the stored rest; closes a loop not yet run; `()` at `Ended`.
def pipe_stop[A, K, B, R, OA, row sg, row cr, site y, site s, site f] : !U (PipeSt[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] -o F[..cr, ..sg] 1) =
  !thunkv fun (st : PipeSt[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]) ->
    case st {
      inl bl -> l <- return (unbox bl); (nu_out (force l)).2
    | inr r1 -> case r1 {
        inl kn -> k <- return (unbox kn); (nu_out (force k)).2
      | inr r2 -> case r2 {
          inl ky -> k <- return (unbox ky); (nu_out (force k)).2
        | inr r -> let _ = r; return ()
        }
      }
    }

-- withStop_i: the thunk inside one `unwind` frame whose finaliser is `pipe_stop`; a frame of one of
-- the three frame lists, each one cancel region at the site `c`. The ambient row `g` holds `cr` and
-- `sg`, since the stage is stopped on the normal path too.
def pipe_with_stop[A, K, B, R, OA, Q, row sg, row cr, row g, site y, site s, site f, site c] :
    !U (PipeSt[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] * U (1 -o F[c.0 cancel[..cr, ..sg] 1 ~> 1, ..g] Q)
        -o F[c.0 cancel[..cr, ..sg] 1 ~> 1, ..g] Q) =
  !thunkv fun (p : PipeSt[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f] * U (1 -o F[c.0 cancel[..cr, ..sg] 1 ~> 1, ..g] Q)) ->
    let (st, t) = p;
    w <- return ();
    a <- force t w unwind (fn1 <- return (unbang pipe_stop[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]); force fn1 st);
    u <- (fn2 <- return (unbang pipe_stop[A, K, B, R, OA, row (..sg), row (..cr), site y, site s, site f]); force fn2 st);
    return a

-- forward_i: performs the real outer operation `n.0` a non-last stage performed at its fresh name.
def pipe_forward[OA, row co, row g, site n] : !U (OA -o F[n.0 cancel[..co] OA ~> 1, ..g] 1) =
  !thunkv fun (a : OA) -> perform[n.0] a

-- finish: `run`'s end: the others closed by their frame list (the thunk), then `r`.
def pipe_finish[R, row g] : !U (R * U (1 -o F[..g] 1) -o F[..g] R) =
  !thunkv fun (p : R * U (1 -o F[..g] 1)) ->
    let (r, t) = p;
    w <- return ();
    u <- force t w;
    let () = u;
    return r

-- handoff_i: wire `i`, from stage `i−1` to stage `i`, at an upstream event `Yield(b, κ)` or
-- `Return(k)` (`B * KY + K`), with stage `i`'s state `S`, which it hands back as it is (stage `i` is
-- `AtNext`, Assembly(n)'s (I5)). Upstream becomes `AtYield(κ)` or `Ended(k)`, and stage `i`'s input
-- is `inl b` or `inr k`.  `[spec §75]`
def pipe_handoff[L, KN, KY, B, K, S] :
    !((B * KY + K) * S => (L + (KN + (KY + K))) * ((1 + (B + K)) * S)) =
  !thunkv fun (p : (B * KY + K) * S) ->
    let (e, s) = p;
    case e {
      inl yk ->
        let (b, ky) = yk;
        return ((inr (inr (inl ky)) : L + (KN + (KY + K))), ((inr (inl b) : 1 + (B + K)), s))
    | inr k -> return ((inr (inr (inr k)) : L + (KN + (KY + K))), ((inr (inr k) : 1 + (B + K)), s))
    }
