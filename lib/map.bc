-- The hash map and set (SPEC §36, #211's implementation note): open addressing, linear probing,
-- backward-shift deletion, and growth by doubling at half full. Keys are hashed and compared by
-- their type's case of `hash` and `equal` (`lib/key.bc`), one of each per type, so every map at
-- a key type agrees with every other. The hash is deterministic, so a run is reproducible.
--
-- A map is a plain value: `map_insert(&mut m, k, v)`, `map_lookup(&m, k)`, `map_len(&m)` take
-- it and hand it back (a lend at a parameter of the map's own type moves and rebinds it, SPEC
-- §15). `borrow imm m { 'x, r -> … }` lends it as a family, `r : MapRef[K, V]<'k, 'x>`, its keys
-- at a lifetime of their own and its values at `'x` (SPEC §36, a record lent fieldwise); then
-- `map_get(r, k)` is a view of the value at `k` at `'x`, as `get` of `lib/slice.bc` is of an
-- element, and `map_iter(r)` iterates the entries. The map cannot change while it is lent.
--
-- The representation: `keys` holds a slot per entry, `inl ()` empty or `inr (h, k)`, the key
-- with its hash; `vals` holds the value at the same index, and the filler of `V` where there is
-- none (`filler`, SPEC §17), so `V` has one: integers, views, arrays, buffers, and pairs and sums
-- of them. A key may be a view (`text 't`): the map's type then mentions its lifetime, and the
-- map does not outlive what its keys borrow. A linear `K` or `V` makes the map linear: it has a
-- destructor exactly when its keys and values do.
--
-- The key sought is given by value and dropped after the search (a persistent key or a view costs
-- nothing); it is lent to the search, a cell of the caller's frame. `map_insert` answers the
-- value it displaces; a key already present keeps its first key, and the new one is dropped.
--
-- Every loop is counted, at most the table's size; the table is at most half full, so a search
-- ends at an empty slot.
--
-- `include map` puts the map and set in scope, with `lib/key.bc`.

include key
include buf

type Map[K, V] = (array (1 + (i32 * K)) * array V) * i32

type MapRef[K, V]<'k, 'x> = (array_imm 'k (1 + (i32 * K)) * array_imm 'x V) * i32

type Set[K] = Map[K, 1]

-- ### Hashing and probing

-- A slot's hash of a key's hash: the high half of a Fibonacci multiply, whose low bits pick the
-- slot.
fn map_slot_hash(h: i64) -> i32 =
  host[wrap](host[shr_u64](host[mul64](h, i64[0x9e3779b97f4a7c15]), i64[32]))

-- The slot hash of the key `q` points at.
fn map_key_hash[K]<'q>(q: imm 'q K) -> i32 =
  let h = borrow imm *q { 'u, v -> hash[K](v) };
  map_slot_hash(h)

-- The table size for `n` entries: a power of two, at least twice `n` and at least 8.
fn map_table_size(n: i32) -> i32 =
  let mut c = 8;
  for _ in 0..31 { if c < 2 * n { c = c * 2 } else { break } };
  c

-- Where the key `q` points at (slot hash `h`) is among the slots `ks`: `inl i` at slot `i`, or
-- `inr i` the first empty slot of its map_probe sequence. A slot is compared by its hash first and
-- then by `equal` on the two keys' views.
fn map_probe[K]<'k, 'q>(ks: array_imm 'k (1 + (i32 * K)), q: imm 'q K, h: i32) -> i32 + i32 =
  let (ks, k0) = array_copy['k, 1 + (i32 * K)](ks);
  let cap = len(k0);
  let mut res : i32 + i32 = inr (0 - 1);
  let mut i = host[and32](h, cap - 1);
  let mut rest = ks;
  let mut key = q;
  for _ in 0..cap {
    let (r, r0) = array_copy['k, 1 + (i32 * K)](rest);
    rest = r;
    let (c, c0) = copy['q, K](key);
    key = c;
    match get(r0, i) {
      inl g ->
        let found = borrow imm *g { 'y, s -> match s {
            inl u -> forget_imm['q, K](c0); 0
          | inr (hs, kv) ->
              if hs == h { let same = borrow imm *c0 { 'u, qv -> equal[K](kv, qv) }; if same { 1 } else { 2 } }
              else { forget_imm['q, K](c0); 2 } } };
        if found == 0 { res = (inr i : i32 + i32); break } else {
          if found == 1 { res = (inl i : i32 + i32); break } else { i = host[and32](i + 1, cap - 1) } }
    | inr u -> forget_imm['q, K](c0); break
    }
  };
  res

-- `map_probe` for the key `q` points at, its hash computed.
fn map_probe_key[K]<'k, 'q>(ks: array_imm 'k (1 + (i32 * K)), q: imm 'q K) -> i32 + i32 =
  let (q, q0) = copy['q, K](q);
  map_probe(ks, q, map_key_hash(q0))

-- The map's own slots lent to `map_probe`: the slots handed back, the key's slot hash, and where it is.
fn map_locate[K]<'q>(keys: array (1 + (i32 * K)), q: imm 'q K) -> (array (1 + (i32 * K)) * i32) * (i32 + i32) =
  let (q, q0) = copy['q, K](q);
  let h = map_key_hash(q0);
  let mut keys = keys;
  let r = borrow imm keys { 'k, ks -> map_probe(ks, q, h) };
  ((keys, h), r)

-- The first empty slot from slot hash `h` on.
fn map_first_empty[K]<'k>(ks: array_imm 'k (1 + (i32 * K)), h: i32) -> i32 =
  let (ks, k0) = array_copy['k, 1 + (i32 * K)](ks);
  let cap = len(k0);
  let mut i = host[and32](h, cap - 1);
  let mut rest = ks;
  for _ in 0..cap {
    let (r, r0) = array_copy['k, 1 + (i32 * K)](rest);
    rest = r;
    match get(r0, i) {
      inl g ->
        let empty = borrow imm *g { 'y, s -> match s { inl u -> true | inr e -> false } };
        if empty { break } else { i = host[and32](i + 1, cap - 1) }
    | inr u -> break
    }
  };
  i

-- The slot hash of the entry at `i`, or `inr ()` where the slot is empty.
fn map_slot_at[K]<'k>(ks: array_imm 'k (1 + (i32 * K)), i: i32) -> i32 + 1 =
  match get(ks, i) {
    inl g ->
      let h = borrow imm *g { 'y, s ->
        match s { inl u -> (inr () : i32 + 1) | inr (hs, kv) -> (inl hs : i32 + 1) } };
      h
  | inr u -> inr ()
  }

-- ### Building

-- An empty map with room for `cap` entries before it grows.
fn map_new[K, V](cap: i32) -> Map[K, V] =
  let c = map_table_size(cap);
  ((array_new[1 + (i32 * K)] (c, !{ i -> inl () }), array_new[V] (c, !{ i -> filler[V] })), 0)

-- The entry `(h, k)`, `v` put in the empty slot `i`.
fn map_put_at[K, V](keys: array (1 + (i32 * K)), vals: array V, i: i32, h: i32, k: K, v: V)
    -> array (1 + (i32 * K)) * array V =
  let (keys, _) = array_replace[1 + (i32 * K)] (keys, i, inr (h, k));
  let (vals, _) = array_replace[V] (vals, i, v);
  (keys, vals)

-- Twice the table, every entry moved to the first empty slot from its hash.
fn map_grow[K, V](keys: array (1 + (i32 * K)), vals: array V) -> array (1 + (i32 * K)) * array V =
  let (keys, cap) = array_size[1 + (i32 * K)](keys);
  let mut old_k = keys;
  let mut old_v = vals;
  let mut nk = array_new[1 + (i32 * K)] (cap * 2, !{ i -> inl () });
  let mut nv = array_new[V] (cap * 2, !{ i -> filler[V] });
  for i in 0..cap {
    let (ok, s) = array_replace[1 + (i32 * K)] (old_k, i, inl ());
    let (ov, x) = array_replace[V] (old_v, i, filler[V]);
    old_k = ok;
    old_v = ov;
    match s {
      inl e -> match e {
        inl u -> ()
      | inr (h, k) -> match x {
          inl v ->
            let j = borrow imm nk { 'k, ks -> map_first_empty(ks, h) };
            let (k2, v2) = map_put_at(nk, nv, j, h, k, v);
            nk = k2;
            nv = v2
        | inr v -> () }
      }
    | inr e -> ()
    }
  };
  (nk, nv)

-- `v` at `k`, and the value it displaces.
fn map_insert[K, V](m: Map[K, V], k: K, v: V) -> Map[K, V] * (V + 1) =
  let ((keys, vals), n) = m;
  let (keys, cap) = array_size[1 + (i32 * K)](keys);
  let (keys, vals) = if cap < 2 * (n + 1) { map_grow(keys, vals) } else { (keys, vals) };
  let mut k = k;
  let ((keys, h), r) = map_locate(keys, &k);
  match r {
    inl i ->
      -- `i` is a slot, so `inr` (past the end) does not occur; it would answer `v` itself.
      let (vals, o) = array_replace[V] (vals, i, v);
      let old : V + 1 = match o { inl x -> inl x | inr x -> inl x };
      (((keys, vals), n), old)
  | inr i ->
      let (keys, vals) = map_put_at(keys, vals, i, h, k, v);
      (((keys, vals), n + 1), inr ())
  }

-- ### Reading

-- The number of entries.
fn map_len[K, V](m: Map[K, V]) -> Map[K, V] * i32 = let (kv, n) = m; ((kv, n), n)

-- Whether `k` has a value.
fn map_contains[K, V](m: Map[K, V], k: K) -> Map[K, V] * bool =
  let ((keys, vals), n) = m;
  let mut k = k;
  let ((keys, _), r) = map_locate(keys, &k);
  let found = match r { inl i -> true | inr i -> false };
  (((keys, vals), n), found)

-- A copy of the value at `k` (`V` persistent), or `inr ()`.
fn map_lookup[K, V](m: Map[K, V], k: K) -> Map[K, V] * (V + 1) =
  let ((keys, vals), n) = m;
  let mut k = k;
  let ((keys, _), r) = map_locate(keys, &k);
  match r {
    inl i -> let x = at(&vals, i, filler[V]); (((keys, vals), n), inl x)
  | inr i -> (((keys, vals), n), inr ())
  }

-- The value at `k` as a view at the map's lifetime `'x`, or `inr ()`.
fn map_get[K, V]<'k, 'x>(r: MapRef[K, V]<'k, 'x>, k: K) -> imm 'x V + 1 =
  let ((ks, vs), n) = r;
  let mut k = k;
  let o = map_probe_key(ks, &k);
  match o { inl i -> get(vs, i) | inr i -> array_forget['x, V](vs); inr () }

-- The number of entries of a lent map.
fn map_size[K, V]<'k, 'x>(r: MapRef[K, V]<'k, 'x>) -> i32 = let (d, n) = r; n

-- The entries of a lent map, in slot order: each key copied out of its slot (a key that is its
-- own view: an integer, a view, a pair of them) and a view of its value.
fn map_iter[K, V]<'k, 'x>(r: MapRef[K, V]<'k, 'x>)
    -> sized (array_imm 'k (1 + (i32 * K)) * array_imm 'x V) i32 (K * imm 'x V) =
  let (d, n) = r;
  (d, (0, !{ ((ks, vs), i) ->
    let (ks, k0) = array_copy['k, 1 + (i32 * K)](ks);
    let (vs, v0) = array_copy['x, V](vs);
    match get(k0, i) {
      inl g ->
        let o = borrow imm *g { 'y, s ->
          match s { inl u -> (inr () : K + 1) | inr (h, kv) -> (inl kv : K + 1) } };
        match o {
          inl key -> match get(v0, i) {
              inl vw -> (((ks, vs), i + 1), inl (key, vw))
            | inr u -> (((ks, vs), i + 1), inr (inl ())) }
        | inr u -> array_forget['x, V](v0); (((ks, vs), i + 1), inr (inl ()))
        }
    | inr u -> array_forget['x, V](v0); (((ks, vs), i), inr (inr ()))
    } }))

-- ### Removing

-- The entry at `k` taken out, and its value; the entries after it in its run are shifted back
-- over the hole, each one whose map_probe sequence passes the hole (Knuth's algorithm R).
fn map_remove[K, V](m: Map[K, V], k: K) -> Map[K, V] * (V + 1) =
  let ((keys, vals), n) = m;
  let mut k = k;
  let ((keys, _), r) = map_locate(keys, &k);
  match r {
    inl i ->
      let (keys, cap) = array_size[1 + (i32 * K)](keys);
      let mask = cap - 1;
      let (keys, _) = array_replace[1 + (i32 * K)] (keys, i, inl ());
      let (vals, o) = array_replace[V] (vals, i, filler[V]);
      let mut ks = keys;
      let mut vs = vals;
      let mut hole = i;
      let mut j = i;
      for _ in 0..cap {
        j = host[and32](j + 1, mask);
        let at_j = borrow imm ks { 'k, kv -> map_slot_at(kv, j) };
        let empty = match at_j { inl h -> false | inr u -> true };
        let h = match at_j { inl h -> h | inr u -> 0 };
        if empty { break } else {
          if host[and32](j - h, mask) >= host[and32](j - hole, mask) {
            let (k2, s) = array_replace[1 + (i32 * K)] (ks, j, inl ());
            let e = match s { inl e -> e | inr e -> e };
            let (k3, _) = array_replace[1 + (i32 * K)] (k2, hole, e);
            let (v2, x) = array_replace[V] (vs, j, filler[V]);
            let (v3, _) = match x {
              inl x -> array_replace[V] (v2, hole, x)
            | inr x -> array_replace[V] (v2, hole, x) };
            ks = k3;
            vs = v3;
            hole = j
          } else { () }
        }
      };
      let old : V + 1 = match o { inl x -> inl x | inr x -> inl x };
      (((ks, vs), n - 1), old)
  | inr i -> (((keys, vals), n), inr ())
  }

-- ### The set: a map to `1`

fn set_new[K](cap: i32) -> Set[K] = map_new[K, 1](cap)

-- `k` added, and whether it was not there before (Rust's `HashSet::insert`).
fn set_insert[K](s: Set[K], k: K) -> Set[K] * bool =
  let (s, o) = map_insert(s, k, ());
  let fresh = match o { inl u -> false | inr u -> true };
  (s, fresh)

fn set_contains[K](s: Set[K], k: K) -> Set[K] * bool = map_contains(s, k)

-- `k` taken out, and whether it was there.
fn set_remove[K](s: Set[K], k: K) -> Set[K] * bool =
  let (s, o) = map_remove(s, k);
  let had = match o { inl u -> true | inr u -> false };
  (s, had)

fn set_len[K](s: Set[K]) -> Set[K] * i32 = map_len(s)
