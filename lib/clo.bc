-- The closure `Clo` (SPEC §7, entry 22): codata with two observations, `call`, which takes an
-- `A`, answers a `B` and hands back the rest, and `close`, which ends it.
--
--     Clo[A, B]<'c>  =  U (nu X. (A -o F (B * box 'c U X)) & F 1)
--
-- The state the closure holds (its captures, owned cells and borrows included) is hidden by the
-- type, so a function over closures names no environment type. `'c` is the bound: a closure that
-- outlives `'c` is `box 'c Clo[A, B]<'c>`, the form in which one is stored, lent `mut` and
-- returned, and the rest every call hands back is again of that form. A closure is linear, with a
-- derived drop: dropping one runs its `close` (SPEC §12, group 2). The three kinds of function
-- (cf. Rust's `FnOnce`, `FnMut`, `Fn`):
--
--     linear, no derived drop      A => B                  called once
--     linear, with a derived drop  box 'c Clo[A, B]<'c>     called any number of times, then closed
--     unrestricted                 !(A => B)               copied and forgotten freely
--
-- with `clo_of_fn` (from `!(A => B)`) and `clo_once` (to `A => B`). The name `Clo` is
-- provisional (decision 60). `include clo` puts these in scope.

type Clo[A, B]<'c> = U (nu X. (A -o F (B * box 'c U X)) & F 1)

-- A closure over the state `s`, with the persistent step: the call's code over the state, and the
-- close's. It outlives `'c` when the state does: `boxed['c] clo_new(s, step)`, checked where it
-- is written, at the state's type. `clo_new_boxed` boxes it itself.
fn clo_new[S, A, B]<'c>(s: S, step: !U (S -o (A -o F (B * box 'c S)) & F 1)) -> Clo[A, B]<'c> =
  f <- return (unfold[nu X. (A -o F (B * box 'c U X)) & F 1, S] step);
  thunkv nu_in < g <- return (unbang f); (nu_out (force g s)).1,
                 g <- return (unbang f); (nu_out (force g s)).2 >

-- A closure over the state `s` that outlives `'c`, from a step that hands the state back as it is:
-- the closure and each rest are boxed here. The bound `S: 'c` makes each instance's `'c` lie
-- below the lifetimes of the state's type (SPEC §23), so the box is checked at the instance.
fn clo_new_boxed[S, A, B]<'c>(s: S, step: !U (S -o (A -o F (B * S)) & F 1)) -> box 'c Clo[A, B]<'c>
    where S: 'c =
  boxed['c] clo_new[S, A, B]['c](s, !thunkv fun (s0 : S) ->
    < fun (a : A) ->
        g <- return (unbang step);
        p <- (force g s0).1 a;
        let (b, s1) = p;
        return (b, boxed['c] s1),
      g <- return (unbang step);
      (force g s0).2 >)

-- One call: the answer and the rest.
fn clo_call[A, B]<'c>(f: box 'c Clo[A, B]<'c>, x: A) -> B * box 'c Clo[A, B]<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 x

-- One call through a `mut` borrow: the closure is taken out, called, and its rest put back, so
-- the state persists from call to call.
fn clo_call_mut[A, B]<'a, 'c>(m: mut 'a (box 'c Clo[A, B]<'c>), x: A) -> mut 'a (box 'c Clo[A, B]<'c>) * B =
  withswap['a, box 'c Clo[A, B]<'c>, B] m (thunkv fun (f : box 'c Clo[A, B]<'c>) ->
    g <- return (unbox f);
    p <- (nu_out (force g)).1 x;
    let (b, r) = p;
    return (r, b))

-- Close: the closure disposes of its state.
fn clo_close[A, B]<'c>(f: box 'c Clo[A, B]<'c>) -> 1 =
  g <- return (unbox f);
  (nu_out (force g)).2

-- From `!(A => B)`: a closure whose state is the function itself.
fn clo_of_fn[A, B]<'c>(h: !(A => B)) -> box 'c Clo[A, B]<'c> =
  clo_new_boxed[!(A => B), A, B]['c](h, !thunkv fun (h : !(A => B)) ->
    < fun (x : A) -> b <- return ((unbang h) x); return (b, h),
      return () >)

-- To `A => B`: call once, then close the rest.
fn clo_once[A, B]<'c>(f: box 'c Clo[A, B]<'c>) -> A => B =
  thunkv fun (x : A) ->
    g <- return (unbox f);
    p <- (nu_out (force g)).1 x;
    let (b, r) = p;
    h <- return (unbox r);
    u <- (nu_out (force h)).2;
    return b
