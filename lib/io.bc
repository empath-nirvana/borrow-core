-- The I/O library (SPEC §11, §34): over the system interface's effects (`lib/sys.bc`), and over
-- the streams' cells, each helper there the platform's handler (`lib/wasi.bc`) lent the cell around
-- one operation, so that an extern is called only by a platform handler. It is ordinary library
-- code, checked with the program, and in scope in a program whose `main` uses the streams
-- ambiently or that includes it. Each helper over a cell takes it and hands it back first, so
-- `&mut c` can lend it to one call.

include wasi

type In = ref input
type Out = ref output
type Bytes = mu X. 1 + (u8 * X)

-- The next byte of an input, or `inr ()` at its end.
fn getb(c: In) -> In * (u8 + 1) = let r = with wasi_stdin(&mut c) { input_byte() }; (c, r)

-- One byte to an output.
fn putb(o: Out, b: u8) -> Out * 1 = with wasi_stdout(&mut o) { print_byte(b) }; (o, ())

-- Decimal output. The state is (output, (n, (d, started))): `d` runs over 10^9, 10^8, …, 1, and
-- the digit `n / d` is written once a nonzero digit has been, or at `d = 1`.
def io_dec_step : !(Out * (i32 * (i32 * (1 + 1))) => Out * (i32 * (i32 * (1 + 1)))) =
  !thunkv fun (s : Out * (i32 * (i32 * (1 + 1)))) ->
    let (o, r) = s;
    let (n, r2) = r;
    let (d, st) = r2;
    case (unbang host[eqz32]) d {
      inl nz ->
        q <- return ((unbang host[div_u32]) (n, d));
        digit : i32 <- case q { inl x -> return x | inr u -> return i32[0] };
        n2 <- return ((unbang host[sub32]) (n, (unbang host[mul32]) (digit, d)));
        show : 1 + 1 <- case st {
          inl u ->
            case (unbang host[eqz32]) digit {
              inl u2 -> return (inr () : 1 + 1)
            | inr u3 -> return ((unbang host[eq32]) (d, i32[1]))
            }
        | inr u -> return (inr () : 1 + 1)
        };
        o2 : Out <- case show {
          inl u -> return o
        | inr u ->
            q2 <- return (putb (o, (unbang host[wrap8]) ((unbang host[add32]) (digit, i32[48]))));
            let (o3, v) = q2;
            return o3
        };
        q3 <- return ((unbang host[div_u32]) (d, i32[10]));
        d2 : i32 <- case q3 { inl x -> return x | inr u -> return i32[0] };
        return (o2, (n2, (d2, show)))
    | inr z -> return (o, (n, (d, st)))
    }

def io_dec_twice : !(Out * (i32 * (i32 * (1 + 1))) => Out * (i32 * (i32 * (1 + 1)))) =>
    !(Out * (i32 * (i32 * (1 + 1))) => Out * (i32 * (i32 * (1 + 1)))) =
  thunkv fun (f : !(Out * (i32 * (i32 * (1 + 1))) => Out * (i32 * (i32 * (1 + 1))))) ->
    return (!thunkv fun (s : Out * (i32 * (i32 * (1 + 1)))) ->
      return ((unbang f) ((unbang f) s)))

-- A number to an output, in unsigned decimal: sixteen steps cover its ten digits.
def put_dec : Out * i32 => Out * 1 =
  thunkv fun (p : Out * i32) ->
    let (o, n) = p;
    s <- return ((unbang (io_dec_twice (io_dec_twice (io_dec_twice (io_dec_twice io_dec_step)))))
                   (o, (n, (i32[1000000000], (inl () : 1 + 1)))));
    let (o2, r) = s;
    return (o2, ())

-- The bytes of a view to an output, in one write (`write_all`).
fn write_bytes<'b>(o: Out, v: array_imm 'b u8) -> Out * 1 =
  with wasi_stdout(&mut o) { print_bytes(v) }; (o, ())

-- Bytes of an input read into a view, until it is full or the input ends (`read_into`): the
-- view back, and the number of bytes read, which is less than its length only at the end.
fn read_bytes<'b>(c: In, v: array_mut 'b u8) -> In * (array_mut 'b u8 * i32) =
  let r = with wasi_stdin(&mut c) { input_into(v) }; (c, r)

-- The input as a stream of bytes, `iter u8 In In`: `next` reads a byte, and finishes with the
-- capability at the end of the input; `close` hands the capability back.
def io_bytes_step : !U (In -o F (u8 * In + In) & F In) =
  !thunkv fun (c : In) ->
    < q <- return (getb c);
      let (c2, x) = q;
      case x {
        inl b -> return (inl (b, c2))
      | inr u -> return (inr c2)
      },
      return c >

def bytes : In => U (iter u8 In In) =
  thunkv fun (c : In) ->
    f <- return (unbang (unfold[iter u8 In In, In] io_bytes_step));
    return (thunkv nu_in < (nu_out (force f c)).1, (nu_out (force f c)).2 >)

-- ### Over the effects  `[spec §34]`

-- The decimal digits of `x`, with a `-` when it is negative, each given to `put`.
fn dec_each(x: i32, put: !(u8 => 1)) -> 1 =
  let mut n = x;
  if x < 0 { put(b'-'); n = 0 - x } else { () };
  let mut d = 1000000000;
  let mut started = false;
  for _ in 0..10 {
    let q = match host[div_u32](n, d) { inl y -> y | inr u -> 0 };
    if started || q != 0 || d == 1 { put(to_u8(q + 48)); started = true } else { () };
    n = n - q * d;
    let d2 = match host[div_u32](d, 10) { inl y -> y | inr u -> 1 };
    d = d2
  };
  ()

-- `x` in decimal to standard output, with a `-` when it is negative.
fn print_dec(x: i32) -> 1 = dec_each(x, !{ b -> print_byte(b) })

-- `x` in decimal to standard error, with a `-` when it is negative.
fn eprint_dec(x: i32) -> 1 = dec_each(x, !{ b -> eprint_byte(b) })

-- `ms` milliseconds as the clock's nanoseconds (SPEC §34).
fn ns_of_ms(ms: i32) -> i64 = host[extend_s](ms) * 1000000
