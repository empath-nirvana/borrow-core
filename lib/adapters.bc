-- Generator adapters (SPEC §15). Each is a generic generator, written once and instantiated at the
-- types of each call: the instance is ordinary code at those types, so an adapter over a pure
-- source and one over a source that fails are two instances of one definition. Each body's loop
-- is `iterate` at its row (SPEC §14, §47), so a pipeline of adapters whose functions are known
-- makes no allocation; its dispatched calls are the loops' steps and resumes until B3 lowers
-- `iterate` natively.
--
-- A source is a stored generator `U (pull A K R)` (`lib/yield.bc`): it gives `A`s, returns `K`,
-- and, closed early, hands back `R`; the call of a generator at a parameter of that type is its
-- stored generator. An adapter that runs its source to the end returns the source's `K`. One that
-- may stop the source early (`take`, `take_until`, `zip`) needs a source that returns what it
-- hands back when closed, `U (pull A K K)`: a pure source (`1`). A source that fails returns an
-- error it hands back no part of when closed (`i32 + 1`, closed `1`): stopped early it has no
-- error to report, and it is rejected there (`corpus/reject/take-failing.bc`).
--
-- `include adapters` puts them in scope; only those a program calls are elaborated.

include yield

-- Each element `x` as `f(x)`.
fn map[A, B, K, R](it: U (pull A K R), f: !(A => B)) -> K with Yield[B] =
  let k = for x in it { yield(f(x)) };
  k

-- The elements for which `p` holds. `p` takes the element and `filter` yields it after, so the
-- element is copied: an `i32`, a `bool` or a tuple of them.
fn filter[A, K, R](it: U (pull A K R), p: !(A => bool)) -> K with Yield[A] =
  let k = for x in it { if p(x) { yield(x) } else { () } };
  k

-- The first `n` elements. The source is closed after the `n`-th, before it computes another.
fn take[A, K](it: U (pull A K K), n: i32) -> K with Yield[A] =
  if n <= 0 { k <- (nu_out (force it)).2; k } else {
    let mut i = 0;
    let k = for x in it { yield(x); i = i + 1; if i == n { break } else { () } };
    k
  }

-- The elements after the first `n`.
fn skip[A, K, R](it: U (pull A K R), n: i32) -> K with Yield[A] =
  let mut i = 0;
  let k = for x in it { if i < n { i = i + 1 } else { yield(x) } };
  k

-- Each element with its position, from 0.
fn enumerate[A, K, R](it: U (pull A K R)) -> K with Yield[i32 * A] =
  let mut i = 0;
  let k = for x in it { yield((i, x)); i = i + 1 };
  k

-- The elements of `a`, then those of `b`, which holds nothing (it is dropped, closed, if `a` is
-- closed first).
fn chain[A, K, R](a: U (pull A K R), b: U (pull A 1 1)) -> K with Yield[A] =
  let k = for x in a { yield(x) };
  for x in b { yield(x) };
  k

-- The elements of each `f(x)`, in order.
fn flat_map[A, B, K, R](it: U (pull A K R), f: !(A => U (pull B 1 1))) -> K with Yield[B] =
  let k = for x in it { for y in f(x) { yield(y) } };
  k

-- The elements before the first for which `p` holds; the source is closed there.
fn take_until[A, K](it: U (pull A K K), p: !(A => bool)) -> K with Yield[A] =
  let k = for x in it { if p(x) { break } else { yield(x) } };
  k

-- The successive states `f(s, x)` from `s` (a running total). The state is yielded and kept, so it
-- is copied.
fn scan[A, S, K, R](it: U (pull A K R), s: S, f: !(S * A => S)) -> K with Yield[S] =
  let mut s = s;
  let k = for x in it { s = f(s, x); yield(s) };
  k

-- Pairs of an element of `a` and one of `b`, until either ends; `b` holds nothing. Each turn
-- observes one source: `a` for the next element, then `b` for its partner, so that a skip of
-- either is a skip of `zip`, holding what it has.
fn zip[A, K, B](a: U (pull A K K), b: U (pull B 1 1)) -> K with Yield[A * B] =
  let mut st = (inl ((a, b), (inr () : A + 1)) : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K);
  loop {
    match st {
      inl abh ->
        let (ab, h) = abh;
        let (a, b) = ab;
        match h {
          inl x ->
            o <- (nu_out (force b)).1;
            match o {
              inl yb -> let (y, b) = yb;
                st = (inl ((a, b), (inr () : A + 1)) : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K);
                yield((x, y))
            | inr d -> match d {
                inl u -> k <- (nu_out (force a)).2; st = (inr k : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K)
              | inr b -> st = (inl ((a, b), (inl x : A + 1)) : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K)
              }
            }
        | inr u ->
            o <- (nu_out (force a)).1;
            match o {
              inl xa -> let (x, a) = xa; st = (inl ((a, b), (inl x : A + 1)) : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K)
            | inr d -> match d {
                inl k -> st = (inr k : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K)
              | inr a -> st = (inl ((a, b), (inr () : A + 1)) : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K)
              }
            }
        }
    | inr k -> st = (inr k : ((U (pull A K K) * U (pull B 1 1)) * (A + 1)) + K); break
    }
  };
  match st {
    inl abh -> let (ab, h) = abh; let (a, b) = ab; k <- (nu_out (force a)).2; k
  | inr k -> k
  }

-- The elements in lists of `n`, the last one shorter; each list holds its elements last first.
fn chunks[A, K, R](it: U (pull A K R), n: i32) -> K with Yield[mu X. 1 + (A * X)] =
  let mut acc = (roll inl () : mu X. 1 + (A * X));
  let mut m = 0;
  let k = for x in it {
    acc = (roll inr (x, acc) : mu X. 1 + (A * X));
    m = m + 1;
    if m == n { yield(acc); acc = (roll inl () : mu X. 1 + (A * X)); m = 0 } else { () }
  };
  if m > 0 { yield(acc) } else { () };
  k

-- A source of bytes split into lines, each a list of its bytes, last first, without its newline;
-- a last line without a newline is yielded too.
fn lines[K, R](it: U (pull u8 K R)) -> K with Yield[mu X. 1 + (u8 * X)] =
  let mut line = (roll inl () : mu X. 1 + (u8 * X));
  let mut any = false;
  let k = for b in it {
    if b == 10 {
      yield(line);
      line = (roll inl () : mu X. 1 + (u8 * X));
      any = false
    } else {
      line = (roll inr (b, line) : mu X. 1 + (u8 * X));
      any = true
    }
  };
  if any { yield(line) } else { () };
  k

-- Elements added into a state by `add`, which says when the state is full: then it is yielded and
-- the next starts again from `s0`; a last state that is not full is yielded if anything was added
-- to it. `chunks` is `batch` into lists by count; `batch` also groups by size or by a separator.
fn batch[A, S, K, R](it: U (pull A K R), s0: S, add: !(S * A => S * bool)) -> K with Yield[S] =
  let mut s = s0;
  let mut any = false;
  let k = for x in it {
    let (s2, full) = add(s, x);
    if full { yield(s2); s = s0; any = false } else { s = s2; any = true }
  };
  if any { yield(s) } else { () };
  k
