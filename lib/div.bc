-- Divergence (SPEC §14): the delay bind and the fuel handler, over loop values. A loop value of
-- `A` returning `B`, `U (loop B R)`, finishes with `B` or, closed early, hands back the residual
-- `R`. This is ordinary library code over `unfold` (SPEC §7), checked with the program and emitted
-- when the elaborated program names it. An elaborated div body is a computation at the row `div`
-- (SPEC §47), whose loop value is `reify` of it; the elaboration emits neither `div_bind` nor
-- `div_defer`, which stay for loop values written by hand.

-- The bind's state: in the first loop, with the continuation; or in the continuation's loop.
-- The continuation has two observations: go on with the first loop's result, or, when the
-- whole is closed during the first loop, turn that loop's residual into the whole's.
def div_bind_step[A, B, R1, R] :
    !U ((U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)
        -o F (B + ((U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)))
         & F R) =
  !thunkv fun (s : (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)) ->
    < case s {
        inl p ->
          let (m, k) = p;
          o <- (nu_out (force m)).1;
          case o {
            inl a ->
              l <- (force k).1 a;
              return (inr (inr l))
          | inr m2 -> return (inr (inl (m2, k)))
          }
      | inr l ->
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      },
      case s {
        inl p ->
          let (m, k) = p;
          r1 <- (nu_out (force m)).2;
          (force k).2 r1
      | inr l -> (nu_out (force l)).2
      } >

-- The delay bind: run the first loop, then the continuation on its result. If either never
-- finishes, neither does the whole.
def div_bind[A, B, R1, R] :
    U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R)) => U (loop B R) =
  thunkv fun (p : U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) ->
    f <- return (unbang (unfold[loop B R,
           (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)]
           div_bind_step[A, B, R1, R]));
    s0 : (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R) <-
      return (inl p);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

-- Fuel. One observation of a loop that has not finished, at each count: the state is the loop,
-- or once it has finished, its result.
def div_fuel_step[A, Q] : !(i32 * (U (loop A Q) + (A + Q)) => U (loop A Q) + (A + Q)) =
  !thunkv fun (p : i32 * (U (loop A Q) + (A + Q))) ->
    let (i, s) = p;
    case s {
      inl l ->
        o <- (nu_out (force l)).1;
        case o {
          inl a -> return (inr (inl a))
        | inr l2 -> return (inl l2)
        }
    | inr r -> return (inr r)
    }

-- The fuel handler: observe a loop at most `n` times, and close it if it has not finished.
-- It is `driveE n` (SPEC §7) with the count a value, counted by `count_fold` (SPEC §16): div
-- code under it is total, and the count allocates nothing.
def div_fuel[A, Q] : U (loop A Q) * i32 => A + Q =
  thunkv fun (p : U (loop A Q) * i32) ->
    let (l, n) = p;
    s <- return ((unbang count_fold[U (loop A Q) + (A + Q)])
           (div_fuel_step[A, Q], (n, (i32[0], inl l))));
    case s {
      inl l2 ->
        q <- (nu_out (force l2)).2;
        return (inr q)
    | inr r -> return r
    }

-- A loop that runs nothing until it is first observed: its state is the code to start it, `t`,
-- whose first observation runs the code up to the loop and returns the loop, and whose second
-- hands back the residual without running anything; or, once started, the loop.
def div_defer_step[B, R] :
    !U (U (F (U (loop B R)) & F R) + U (loop B R)
        -o F (B + (U (F (U (loop B R)) & F R) + U (loop B R))) & F R) =
  !thunkv fun (s : U (F (U (loop B R)) & F R) + U (loop B R)) ->
    < case s {
        inl t ->
          l <- (force t).1;
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      | inr l ->
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      },
      case s {
        inl t -> (force t).2
      | inr l -> (nu_out (force l)).2
      } >

def div_defer[B, R] : U (F (U (loop B R)) & F R) => U (loop B R) =
  thunkv fun (t : U (F (U (loop B R)) & F R)) ->
    f <- return (unbang (unfold[loop B R, U (F (U (loop B R)) & F R) + U (loop B R)]
           div_defer_step[B, R]));
    s0 : U (F (U (loop B R)) & F R) + U (loop B R) <- return (inl t);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)
