/-- **The erasure**: the term the node's rule concludes with. -/
def TExpr.erase : TExpr → Expr
  | .var _ _ i _ => (.var i)
  | .unitI _ _ => (.val .unit)
  | .tensorI _ _ _ _ _ t₁ t₂ => (.pair (t₁.erase) (t₂.erase))
  | .sumI₁ _ _ _ _ t => (.inj₁ (t.erase))
  | .sumI₂ _ _ _ _ t => (.inj₂ (t.erase))
  | .thunkF _ _ _ t => (.val (.lam (t.erase)))
  | .thunkV _ _ _ t => t.erase
  | .ret _ _ _ t => t.erase
  | .bind _ _ _ _ _ tM tN => (.app (.val (.lam (tN.erase))) (tM.erase))
  | .force _ _ i C => (forceE C (.var i))
  | .lam _ _ _ _ t => (.val (.lam (t.erase)))
  | .lamDead _ _ _ _ t => (.val (.lam (t.erase)))
  | .app _ _ i _ _ _ tM => (.app (tM.erase) (.var i))
  | .withI _ _ _ _ tM tN => (withPair (tM.erase) (tN.erase))
  | .proj₁ _ _ _ _ t => (.app (t.erase) (.val (.inj₁ .unit)))
  | .proj₂ _ _ _ _ t => (.app (t.erase) (.val (.inj₂ .unit)))
  | .topI _ _ => (.val .unit)
  | .unitE _ _ _ _ tV tM => (.seq (tV.erase) (tM.erase))
  | .tensorE _ _ _ _ _ _ tV tM => (.letpair (tV.erase) (tM.erase))
  | .sumE _ _ _ _ _ _ tV t₁ t₂ => (.case (tV.erase) (t₁.erase) (t₂.erase))
  | .zeroE _ _ _ _ tV => (absurdE (tV.erase))
  | .allI _ _ _ _ _ _ t => (.val (.lam (t.erase)))
  | .allE _ _ _ _ _ _ t => (.app (t.erase) (.val .unit))
  | .bangThunkF _ _ _ t => (.val (.lam (t.erase)))
  | .bangThunkV _ _ _ t => t.erase
  | .bangE _ _ _ t => t.erase
  | .copyBang _ _ _ => BoCa.copy
  | .forgetBang _ _ _ => forget
  | .boxI _ _ _ _ t => t.erase
  | .boxE _ _ _ _ t => t.erase
  | .immSub _ _ _ _ _ t => t.erase
  | .mutSub _ _ _ _ _ t => t.erase
  | .alloc _ _ _ => (.val (.prim .alloc))
  | .free _ _ _ => (.val (.prim .free))
  | .swap _ _ _ _ => BoCa.swap
  | .copy _ _ _ _ => BoCa.copy
  | .forgetImm _ _ _ _ => forget
  | .forgetMut _ _ _ _ => forget
  | .forgetUnk _ _ => forget
  | .lit _ _ c => (.val ⟨.prim (.lit c), .prim⟩)
  | .hostOp _ _ op => (.val (.prim (.host op)))
  | .arrNew _ _ _ => (.val (.prim .tab))
  | .arrFree _ _ _ => (.val (.prim .drop))
  | .arrSize _ _ _ => (.val sizeV)
  | .arrReplace _ _ _ => (.val replaceV)
  | .arrLen _ _ _ _ => (.val arrLenV)
  | .arrGet _ _ _ _ => (.val (.prim .idx))
  | .arrCopy _ _ _ _ => (.val copyV)
  | .arrForget _ _ _ _ => (.val forgetV)
  | .countFold _ _ _ => (.val (.prim .count))
  | .countTry _ _ _ _ => (.val (.prim .countTry))
  | .boundedFix _ _ _ _ => (.val (.prim .boundedFix))
  | .iterate _ _ _ _ _ _ => (.val (.prim .iterate))
  | .divFuel _ _ _ _ => (.val divFuelV)
  | .reify _ _ _ _ _ res _ => (.val (reifyV res))
  | .sliceBorrowM _ _ _ _ _ => withbor
  | .sliceBorrowI _ _ _ _ _ => withbor
  | .sliceGetM _ _ _ _ => (.val (.prim .idx))
  | .sliceLenM _ _ _ _ => (.val sizeV)
  | .sliceSplitI _ _ _ _ => (.val (.prim .split))
  | .sliceSplitM _ _ _ _ => (.val (.prim .split))
  | .sliceEmptyI _ _ _ _ => (.val emptyFamV)
  | .sliceEmptyM _ _ _ _ => (.val emptyFamV)
  | .sliceReplaceM _ _ _ _ => (.val replaceV)
  | .sliceSwapM _ _ _ _ => (.val swapV)
  | .withbor1 _ _ _ _ _ => withbor
  | .withbor2 _ _ _ _ _ => withbor
  | .withbor3 _ _ _ _ _ _ => withbor
  | .withload _ _ _ _ _ _ => BoCa.withload
  | .withswap _ _ _ _ _ => BoCa.withswap
  | .withbor1U _ _ _ _ _ _ td => (withborUE (td.erase))
  | .withbor2U _ _ _ _ _ _ td => (withborUE (td.erase))
  | .withbor3U _ _ _ _ _ _ _ td => (withborUE (td.erase))
  | .withloadU _ _ _ _ _ _ _ => BoCa.withload
  | .sliceBorrowMU _ _ _ _ _ _ td => (withborUE (td.erase))
  | .sliceBorrowIU _ _ _ _ _ _ td => (withborUE (td.erase))
  | .lolliE _ _ _ _ _ ta tf => (.app (tf.erase) (ta.erase))
  | .allEV _ _ _ _ _ _ t => (.app (t.erase) (.val .unit))
  | .ofRet _ _ _ t => t.erase
  | .roll _ _ _ t => t.erase
  | .unroll _ _ _ t => t.erase
  | .foldImm _ _ F _ _ _ => (.val (foldImmV F))
  | .foldOwn _ _ F _ => (.val (foldOwnV F))
  | .foldReuse _ _ F _ => (.val (foldReuseV F))
  | .nuIn _ _ _ t => t.erase
  | .nuOut _ _ _ t => t.erase
  | .unfoldN _ _ C _ => (.val (unfoldV C))
  | .effSub _ _ _ _ _ t => t.erase
  | .effPerform _ _ _ o t => (BoCa.BoLo.performE (opArgE o.n o.i (t.erase)))
  | .effRaise _ _ _ o _ t => (BoCa.BoLo.raiseE (opArgE o.n o.i (t.erase)))
  | .effLet _ _ _ _ _ _ tM tN => (.app (.val (.lam (tN.erase))) (tM.erase))
  | .effThen _ _ _ _ _ _ _ _ tM tN tD => (thenE (tN.erase) (tD.erase) (tM.erase))
  | .effHandleV _ _ _ E _ n _ _ _ _ tc te => (hndExpr n (E.map Prod.fst) (tc.erase) (te.erase))
  | .effHandleVB _ _ _ E _ n _ _ _ _ _ tc te => (hndExpr n (E.map Prod.fst) (tc.erase) (te.erase))
  | .effHandleT _ _ Hr Hc _ _ E _ n _ _ _ _ te => (hndExpr n (E.map Prod.fst) (.pair Hr (tailTuple E 0 Hc)) (te.erase))
  | .letPoly _ _ N _ _ b _ _ => (.app (.val (.lam N)) (.val (.lam b)))
  | .lendR _ _ _ _ _ _ _ td tM => (.app (.app (.val (withborUV (td.erase))) (.var 0)) (.val (lendCb (tM.erase))))
  | .lendLoopR _ _ _ A _ B R tN tK ts0 => (lendLoopApp A B R (tN.erase) (tK.erase) (ts0.erase))
  | .nilDead _ _ _ t => t.erase
  | .scheme _ _ e => e

