  | .sumE _ _ _ _ _ _ _ _ _ => false
  | .zeroE _ _ _ _ tV => (((absurdE (tV.erase)) : Expr) matches .lam _)
  | .allI _ _ _ _ _ _ _ => true
  | .allE _ _ _ _ _ _ _ => false
  | .bangThunkF _ _ _ _ => true
  | .bangThunkV _ _ _ t => t.isLam
