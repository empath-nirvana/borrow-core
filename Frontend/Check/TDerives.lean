      exact CDerivesX.nilDead a0 a1 ih0
  | consume hA _ he hΓ => exact CDerivesX.ofEffFree (consume_wf hA hΓ) he
  | withlocal k _ hΓ hk => exact CDerivesX.ofEffFree (LocalKind.wf k hΓ hk) (LocalKind.effFree k)
  | allocS σ he hΓ => exact CDerivesX.ofEffFree (d_allocS σ hΓ) he
  | freeS σ he hΓ => exact CDerivesX.ofEffFree (d_freeS σ hΓ) he
  | withborSM σ c _ hσ hT hΔ hc _ he hΓ => exact CDerivesX.ofEffFree (withborSM_wf hσ c hT hΔ hc hΓ) he
  | withborSI σ c _ hσ hT hΔ hc _ he hΓ => exact CDerivesX.ofEffFree (withborSI_wf hσ c hT hΔ hc hΓ) he
  | withborF2M s hA hBo hTo he hΓ => exact CDerivesX.ofEffFree (withborM2_wf s hA hBo hTo hΓ) he
  | withborF2I s hA hB hBo hTo he hΓ =>
      exact CDerivesX.ofEffFree (withborI2_wf s hA hB hBo hTo hΓ) he
  | litFn _ _ _ ih => exact ih
  | divLit _ _ _ ih | walk _ _ _ ih | walkGet _ _ ih | selfCall _ _ ih | lendCell _ _ _ ih | nuEta _ _ ih => exact ih
  | lendScope _ _ _ ih | litView _ _ ih | unfoldStep _ _ ih => exact ih
  | use _ _ ih => exact ih

/-- **A typed derivation is a derivation of the erasure**, tied.  `[spec §19]` -/
theorem TDerivesAt.erase {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesAt Ξ Δ Γ t j) : CDerivesAt Ξ Δ Γ t.erase j :=
  TDerivesX.erase h

/-- **A typed derivation is a derivation of the erasure**, in `CDerivesP`.  `[spec §29]` -/
theorem TDerivesP.erase {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesP Δ Γ t j) : CDerivesP Δ Γ t.erase j :=
  TDerivesX.erase h

/-- A typed derivation at `I` is one at every `I' ≥ I`, at the same node: a tie may be dropped, the
pin rules admitted.  `[spec §83]` -/
theorem TDerivesX.mono {I I' : JIdx} (hI : I ≤ I') {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr}
    {j : Jdg} (h : TDerivesX I Δ Γ t j) : TDerivesX I' Δ Γ t j := by
  induction h with
  | var a0 => exact TDerivesX.var a0
  | unitI a0 => exact TDerivesX.unitI a0
  | tensorI a0 a1 a2 a3 a4 ih0 ih1 => exact TDerivesX.tensorI a0 a1 a2 ih0 ih1
  | sumI₁ a0 ih0 => exact TDerivesX.sumI₁ ih0
  | sumI₂ a0 ih0 => exact TDerivesX.sumI₂ ih0
  | thunkF a0 ih0 => exact TDerivesX.thunkF ih0
  | thunkV a0 a1 a2 ih0 => exact TDerivesX.thunkV a0 ih0 a2
  | ret a0 ih0 => exact TDerivesX.ret ih0
  | bind a0 a1 a2 a3 a4 ih0 ih1 => exact TDerivesX.bind a0 a1 a2 ih0 ih1
  | force a0 a1 => exact TDerivesX.force a0 a1
  | lam a0 ih0 => exact TDerivesX.lam ih0
  | lamDead a0 ih0 => exact TDerivesX.lamDead ih0
  | app a0 a1 a2 a3 a4 ih0 => exact TDerivesX.app a0 a1 a2 ih0 a4
  | withI a0 a1 ih0 ih1 => exact TDerivesX.withI ih0 ih1
  | projB a0 a1 ih0 => exact TDerivesX.projB a0 ih0
  | topI => exact TDerivesX.topI
  | unitE a0 a1 a2 a3 a4 ih0 ih1 => exact TDerivesX.unitE a0 a1 a2 ih0 ih1
  | tensorE a0 a1 a2 a3 a4 ih0 ih1 => exact TDerivesX.tensorE a0 a1 a2 ih0 ih1
  | sumE a0 a1 a2 a3 a4 a5 ih0 ih1 ih2 => exact TDerivesX.sumE a0 a1 a2 ih0 ih1 ih2
  | zeroE a0 a1 a2 a3 ih0 => exact TDerivesX.zeroE a0 a1 a2 ih0
  | allI a0 a1 a2 a3 ih0 => exact TDerivesX.allI a0 a1 a2 ih0
  | allE a0 a1 ih0 => exact TDerivesX.allE ih0 a1
  | bangThunkF a0 a1 ih0 => exact TDerivesX.bangThunkF a0 ih0
  | bangThunkV a0 a1 a2 a3 ih0 => exact TDerivesX.bangThunkV a0 a1 ih0 a3
  | codeI a0 a1 a2 ih0 => exact TDerivesX.codeI ih0 a1 a2
  | codeIB a0 a1 a2 a3 ih0 => exact TDerivesX.codeIB a0 ih0 a2 a3
  | codeErase a0 ih0 => exact TDerivesX.codeErase ih0
  | codeEraseB a0 ih0 => exact TDerivesX.codeEraseB ih0
  | bangE a0 ih0 => exact TDerivesX.bangE ih0
  | copyBang a0 => exact TDerivesX.copyBang a0
  | releaseBang a0 => exact TDerivesX.releaseBang a0
  | boxI a0 a1 ih0 => exact TDerivesX.boxI ih0 a1
  | boxE a0 ih0 => exact TDerivesX.boxE ih0
  | immSub a0 a1 ih0 => exact TDerivesX.immSub ih0 a1
