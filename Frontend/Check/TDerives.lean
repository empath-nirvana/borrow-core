      exact CDerivesX.effThenF a0 a3 a4 a5 a6 a7 a8 a9 a10 ih0 ih1 ih2
  | effHandleVO a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.effHandleVO a0 a1 a4 a5 ih0 a7 a8 a9 a10 ih1 a12 a13
  | effHandleT a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 ih0 ih1 =>
      dsimp only [TExpr.erase]
      rw [a8] at ih0
      rw [a8]
      exact CDerivesX.effHandleT a0 a1 a4 a5 a6 ih0 a9 a10 a11 a12 a13 a14 ih1
  | effHandleL a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 ih0 ih1 =>
      dsimp only [TExpr.erase]
