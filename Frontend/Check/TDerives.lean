  | allE a0 a1 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.allE ih0 a1
  | bangThunkF a0 a1 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.bangThunkF a0 ih0
  | bangThunkV a0 a1 a2 a3 ih0 =>
      dsimp only [TExpr.erase]
