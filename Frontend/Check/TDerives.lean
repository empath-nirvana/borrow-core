/-- `CDerivesAt Ξ` over the typed term: `TDerivesX` at the tie `Ξ`.  `[spec §19, §83]` -/
abbrev TDerivesAt (Ξ : EffCtx) := TDerivesX {ties := some Ξ}

/-- `CDerivesP` over the typed term: `TDerivesX` with the pin rules.  `[spec §29, §83]` -/
abbrev TDerivesP := TDerivesX {pin := true}

