/-- **A typed derivation is a derivation of the erasure**, at every index.  `[spec §19, §29, §83]` -/
theorem TDerivesX.erase {I : JIdx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesX I Δ Γ t j) : CDerivesX I Δ Γ t.erase j := by
  induction h with
  | var a0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.var a0
  | unitI a0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.unitI a0
  | tensorI a0 a1 a2 a3 a4 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.tensorI a0 ih0 ih1
  | sumI₁ a0 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.sumI₁ ih0
  | sumI₂ a0 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.sumI₂ ih0
  | thunkF a0 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.thunkF ih0
  | thunkV a0 a1 a2 ih0 =>
      dsimp only [TExpr.erase]
      rw [a2] at ih0
      rw [a2]
      exact CDerivesX.thunkV a0 ih0
  | ret a0 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.ret ih0
  | bind a0 a1 a2 a3 a4 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.bind a0 ih0 ih1
  | force a0 a1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.force a0 a1
  | lam a0 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.lam ih0
  | lamDead a0 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.lamDead ih0
  | app a0 a1 a2 a3 a4 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.app a0 ih0 a4
  | withI a0 a1 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.withI ih0 ih1
  | projB a0 a1 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.projB a0 ih0
  | topI =>
      dsimp only [TExpr.erase]
      exact CDerivesX.topI
  | unitE a0 a1 a2 a3 a4 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.unitE a0 ih0 ih1
  | tensorE a0 a1 a2 a3 a4 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.tensorE a0 ih0 ih1
  | sumE a0 a1 a2 a3 a4 a5 ih0 ih1 ih2 =>
