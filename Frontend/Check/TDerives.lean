      dsimp only [TExpr.erase]
      exact CDerivesP.thunkF ih0
  | thunkV a0 a1 a2 ih0 =>
      dsimp only [TExpr.erase]
      rw [a2] at ih0
      rw [a2]
      exact CDerivesP.thunkV a0 ih0
