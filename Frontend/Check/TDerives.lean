      rw [Expr.toVal_val]
      exact CDerivesX.reify a0 a1 a2 a3 a4 a5 a6 ih0 a9
  | sliceBorrowM a0 a1 a2 a3 a4 a5 =>
      dsimp only [TExpr.erase]
