/-- A typed derivation's judgment is its node's. -/
theorem TDerivesAt.jdg_eq {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesAt Ξ Δ Γ t j) : t.jdg = j := by
  cases h <;> rfl

