  | sliceBorrowIU a0 a1 a2 a3 a4 a5 a6 a7 a8 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.sliceBorrowIU a0 a1 a2 a3 a4 a5 a6 a7 ih0
  | lolliE a0 a1 a2 a3 a4 ih0 ih1 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.lolliE a0 ih0 ih1
  | allEV a0 a1 ih0 =>
      dsimp only [TExpr.erase]
      exact CDerivesX.allEV ih0 a1
  | ofRet a0 ih0 =>
