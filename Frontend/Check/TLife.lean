  | boxE a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.boxE (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | immSub a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesP.immSub (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLe he.1 a1)
  | mutSub a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesP.mutSub (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLe he.1 a1)
  | alloc a0 =>
      intro Δ' he hd
      exact TDerivesP.alloc a0
  | free a0 =>
      intro Δ' he hd
      exact TDerivesP.free a0
  | swap a0 =>
      intro Δ' he hd
      exact TDerivesP.swap a0
  | copy a0 =>
      intro Δ' he hd
      exact TDerivesP.copy a0
  | forgetImm a0 =>
      intro Δ' he hd
      exact TDerivesP.forgetImm a0
  | forgetMut a0 =>
      intro Δ' he hd
      exact TDerivesP.forgetMut a0
  | forgetUnk a0 =>
      intro Δ' he hd
      exact TDerivesP.forgetUnk a0
  | lit a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.lit a0 a1
  | hostOp a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.hostOp a0 a1
  | arrNew a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.arrNew a0 a1
  | arrFree a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.arrFree a0 a1
  | arrSize a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.arrSize a0 a1
  | arrReplace a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.arrReplace a0 a1
  | arrLen a0 a1 a2 =>
      intro Δ' he hd
      exact TDerivesP.arrLen a0 a1 a2
  | arrGet a0 a1 a2 =>
      intro Δ' he hd
      exact TDerivesP.arrGet a0 a1 a2
  | arrCopy a0 a1 a2 =>
      intro Δ' he hd
      exact TDerivesP.arrCopy a0 a1 a2
  | arrForget a0 a1 a2 =>
      intro Δ' he hd
      exact TDerivesP.arrForget a0 a1 a2
  | countFold a0 a1 =>
      intro Δ' he hd
      exact TDerivesP.countFold a0 a1
  | countTry a0 a1 a2 =>
      intro Δ' he hd
      exact TDerivesP.countTry a0 a1 a2
  | boundedFix a0 a1 a2 =>
      intro Δ' he hd
      exact TDerivesP.boundedFix a0 a1 a2
  | iterate a0 a1 a2 a3 a4 a5 =>
      intro Δ' he hd
      exact TDerivesP.iterate a0 a1 a2 a3 a4 a5
  | divFuel a0 a1 a2 a3 =>
