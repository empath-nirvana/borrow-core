  | .nuOut ii jj C t => .nuOut ii jj C (t.reAb Δr)
  | .unfoldN ii jj C S => .unfoldN ii jj C S
  | .effSub ii jj S S' A t => .effSub ii jj S S' A (t.reAb Δr)
  | .effPerform ii jj S o t => .effPerform ii jj S o (t.reAb Δr)
  | .effRaise ii jj S o B t => .effRaise ii jj S o B (t.reAb Δr)
  | .effLet ii jj A B S u tM tN => .effLet ii jj A B S u (tM.reAb Δr) (tN.reAb Δr)
  | .effThen ii jj A B S SM SD u tM tN tD => .effThen ii jj A B S SM SD u (tM.reAb Δr) (tN.reAb Δr) (tD.reAb Δr)
  | .effHandleV ii jj S E fs n A R u ks site inside tc te => .effHandleV ii jj S E fs n A R u ks site inside (tc.reAb Δr) (te.reAb Δr)
  | .effHandleVB ii jj S E fs n A R d u ks site inside tc te => .effHandleVB ii jj S E fs n A R d u ks site inside (tc.reAb Δr) (te.reAb Δr)
  | .effHandleT ii jj S SN E fs n A R u site inside tc te => .effHandleT ii jj S SN E fs n A R u site inside (tc.reAb Δr) (te.reAb Δr)
  | .letPoly ii jj C j tV tN => .letPoly ii jj C j (tV.reAb Δr) (tN.reAb Δr)
  | .lendR ii jj x b T B S td tM => .lendR ii jj x b T B S (td.reAb Δr) (tM.reAb (Δr.extend x b))
  | .lendLoopR ii jj x A S B R tN tK ts0 => .lendLoopR ii jj x A S B R (tN.reAb (Δr.extend x Δr.meetOfDom)) (tK.reAb (Δr.extend x Δr.meetOfDom)) (ts0.reAb (Δr.extend x Δr.meetOfDom))
  | .nilDead ii jj j t => .nilDead ii jj j (t.reAb Δr)
  | t@(.dtor ..) | t@(.allocS ..) | t@(.freeS ..) | t@(.withborSM ..) | t@(.withborSI ..)
  | t@(.withborF2M ..) | t@(.withborF2I ..) => t
  | .litFn i j bs t => .litFn i j bs (t.reAb Δr)
  | .divLit i j op c t => .divLit i j op c (t.reAb Δr)
  | .walk i j m t => .walk i j m (t.reAb Δr)
  | .selfCall i j k n t => .selfCall i j k n (t.reAb Δr)
  | .lendCell i j m t => .lendCell i j m (t.reAb Δr)
  | .use i j n k τ _ t => .use i j n k τ ((t.reAb Δr).absF Δr) (t.reAb Δr)

theorem TExpr.reAb_erase : ∀ (t : TExpr) (Δr : LifeCtx), (t.reAb Δr).erase = t.erase := by
  intro t
  induction t <;> intro Δr <;> simp only [TExpr.reAb, TExpr.erase, *]

/-- **A typed derivation at a larger lifetime context**, in `TDerivesP`.  `[spec §3, §10]` -/
theorem TDerivesP.weakenΔ {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesP Δ Γ t j) : ∀ Δ', ExtΔ Δ Δ' t.lifeBinders → t.domFree = true →
      TDerivesP Δ' Γ (t.reAb Δ') j := by
  induction h with
  | var a0 =>
      intro Δ' he hd
      exact TDerivesP.var a0
  | unitI a0 =>
      intro Δ' he hd
      exact TDerivesP.unitI a0
  | tensorI a0 a1 a2 a3 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesP.tensorI a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | sumI₁ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.sumI₁ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | sumI₂ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.sumI₂ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | thunkF a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.thunkF (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | thunkV a0 a1 a2 ih0 =>
      intro Δ' he hd
      exact TDerivesP.thunkV a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a2)
  | ret a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.ret (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | bind a0 a1 a2 a3 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesP.bind a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | force a0 =>
      intro Δ' he hd
      exact TDerivesP.force a0
  | lam a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.lam (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | lamDead a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.lamDead (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | app a0 a1 a2 a3 ih0 =>
      intro Δ' he hd
      exact TDerivesP.app a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) a3
  | withI a0 a1 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesP.withI (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | proj₁ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.proj₁ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | proj₂ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesP.proj₂ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | topI =>
      intro Δ' he hd
      exact TDerivesP.topI
  | unitE a0 a1 a2 a3 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesP.unitE a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | tensorE a0 a1 a2 a3 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesP.tensorE a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | sumE a0 a1 a2 a3 a4 ih0 ih1 ih2 =>
      intro Δ' he hd
      exact TDerivesP.sumE a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih2 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | zeroE a0 a1 a2 ih0 =>
      intro Δ' he hd
      exact TDerivesP.zeroE a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | allI a0 a1 a2 a3 ih0 =>
      intro Δ' he hd
      exact TDerivesP.allI a0 (ExtΔ.avoid he (by simp [TExpr.lifeBinders]) a1) a2 (ih0 _ (ExtΔ.extend he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | allE a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesP.allE (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLt he.1 a1)
  | bangThunkF a0 a1 ih0 =>
