  | letPoly a0 a1 a2 a3 a4 a5 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesAt.letPoly a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a3) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a5)
  | dtor hA hc he hΓ => intro _ _ _; exact .dtor hA hc he hΓ
  | allocS σ he hΓ => intro _ _ _; exact .allocS σ he hΓ
  | freeS σ he hΓ => intro _ _ _; exact .freeS σ he hΓ
  | withborSM => intro _ _ hd; simp [TExpr.domFree] at hd
  | withborSI => intro _ _ hd; simp [TExpr.domFree] at hd
  | withborF2M => intro _ _ hd; simp [TExpr.domFree] at hd
  | withborF2I => intro _ _ hd; simp [TExpr.domFree] at hd
  | litFn _ hb hcl ih =>
      intro Δ' he hd; exact .litFn (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb) hcl
  | divLit _ hb hs ih =>
      intro Δ' he hd; exact .divLit (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb) hs
  | walk _ hb ih => intro Δ' he hd; exact .walk (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
  | selfCall _ hb ih =>
      intro Δ' he hd; exact .selfCall (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
  | lendCell _ hb ih =>
      intro Δ' he hd; exact .lendCell (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
  | use _ _ ih => intro Δ' he hd; exact .use (ih Δ' he hd) rfl

end BoCa.Fig16.LogRel.Core.Check
