import Frontend.Check.Weaken

/-!
# Frontend — Check — a typed derivation at a larger lifetime context  `[spec §3, §10]`

GENERATED by `scripts/gen-pin.py` from `Core/Judgment.lean` and
`scripts/pin/TLife.tmpl.lean`. Edit the template, not this file.

**The lemma that checks a `def` once.** A `def`'s body is checked at its declaration, at the
empty lifetime context. A use under lifetime binders, or inside a borrow, is at a larger context.
A typed derivation at `Δ` is one at every larger `Δ'` (`TDerivesX.weakenΔ`)
when:

* `Δ'` has every binding `Δ` has (`LeΔ`), so every premise the derivation proves of `Δ`, an
  entailment (`Δ ⊨ @a ⊑ @b`, `Δ ⊨ @a ⊏ @b`) or an outlives judgment (`CtxOutlives`,
  `Row.AnsOutlives`), holds of `Δ'`;
* a binding `Δ'` has beyond `Δ`'s mentions none of the term's lifetime binders (`ExtΔ`), so a
  `∀I`'s premise that no bound mentions its variable holds of `Δ'`;
* the term has no rule whose node's type or premises read `⊓Δ` or take a fresh variable of `Δ`
  (`TExpr.domFree`): the borrows' types are `∀'x ⊏ ⊓Δ. …`, which a larger `Δ` changes.

The term is the same at `Δ'`, except that each `use` node's absorption is computed at its context
there (`TExpr.reAb`), which leaves its erasure as it is (`TExpr.reAb_erase`). A type's lifetime
binder may shadow a variable of `Δ'` (`∀I` takes no freshness), so no binder is renamed.
-/

namespace BoCa.Fig16.LogRel.Core.Check
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.Fig16.LogRel.Core
open BoCa.Lifetime (LifeCtx LifeVar)

/-- `Δ'` has every binding of `Δ`. -/
def LeΔ (Δ Δ' : LifeCtx) : Prop := ∀ x u, Δ.find? x = some u → Δ'.find? x = some u

/-- `Δ'` has every binding of `Δ`, and its other bindings' bounds mention none of `B`. -/
def ExtΔ (Δ Δ' : LifeCtx) (B : List LifeVar) : Prop :=
  LeΔ Δ Δ' ∧ ∀ y u, Δ'.find? y = some u → Δ.find? y = some u ∨ ∀ x ∈ B, u.mentions x = false

theorem LeΔ.models {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {δ : Lifetime.LSub} (hm : Δ'.Models δ) :
    Δ.Models δ := fun x u hx => hm x u (h x u hx)

theorem LeΔ.entailsLe {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a b : Lifetime.Life}
    (he : Δ.EntailsLe a b) : Δ'.EntailsLe a b := fun δ hδ => he δ (h.models hδ)

theorem LeΔ.entailsLt {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a b : Lifetime.Life}
    (he : Δ.EntailsLt a b) : Δ'.EntailsLt a b := fun δ hδ => he δ (h.models hδ)

theorem LeΔ.defines {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a : Lifetime.Life} (he : Δ.Defines a) :
    Δ'.Defines a := fun δ hδ => he δ (h.models hδ)

theorem VOutlivesR.mono {Rb Rr Rb' Rr' : Lifetime.Life → Prop} (hb : ∀ b, Rb b → Rb' b)
    (hr : ∀ b, Rr b → Rr' b) {A : VTy} (h : VOutlivesR Rb Rr A) : VOutlivesR Rb' Rr' A := by
  induction h with
  | unit => exact .unit
  | tensor _ _ ih₁ ih₂ => exact .tensor ih₁ ih₂
  | zero => exact .zero
  | sum _ _ ih₁ ih₂ => exact .sum ih₁ ih₂
  | ref _ ih => exact .ref ih
  | bang => exact .bang
  | box h => exact .box (hb _ h)
  | imm h => exact .imm (hr _ h)
  | «mut» h => exact .mut (hr _ h)
  | tvar => exact .tvar
  | mu _ ih => exact .mu ih
  | int => exact .int
  | opq => exact .opq
  | fam _ ih => exact .fam ih

theorem LeΔ.vOutlives {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a : Lifetime.Life} {A : VTy}
    (ho : VOutlives Δ a A) : VOutlives Δ' a A :=
  VOutlivesR.mono (fun _ => h.entailsLe) (fun _ => h.entailsLt) ho

theorem LeΔ.ctxOutlives {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {Γ : Ctx VTy} {a : Lifetime.Life}
    (ho : CtxOutlives Δ Γ a) : CtxOutlives Δ' Γ a :=
  ⟨h.defines ho.1, fun s hs hl => h.vOutlives (ho.2 s hs hl)⟩

theorem LeΔ.ansOutlives {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {d : Lifetime.Life} {S : Row}
    (ho : Row.AnsOutlives Δ d S) : Row.AnsOutlives Δ' d S :=
  fun o hoS ha => h.vOutlives (ho o hoS ha)

theorem ExtΔ.sub {Δ Δ' : LifeCtx} {B B' : List LifeVar} (h : ExtΔ Δ Δ' B)
    (hB : ∀ z ∈ B', z ∈ B) : ExtΔ Δ Δ' B' :=
  ⟨h.1, fun y u hy => (h.2 y u hy).imp id fun hm x hx => hm x (hB x hx)⟩

theorem find?_extend' (Δ : LifeCtx) (x : LifeVar) (b : Lifetime.Life) (y : LifeVar) :
    (Δ.extend x b).find? y = if x = y then some b else Δ.find? y := by
  simp [Lifetime.LifeCtx.find?, Lifetime.LifeCtx.extend, Lifetime.assocFind]

theorem ExtΔ.extend {Δ Δ' : LifeCtx} {B B' : List LifeVar} {x : LifeVar} {b : Lifetime.Life}
    (h : ExtΔ Δ Δ' B) (hB : ∀ z ∈ B', z ∈ B) : ExtΔ (Δ.extend x b) (Δ'.extend x b) B' := by
  refine ⟨fun y u hy => ?_, fun y u hy => ?_⟩
  · rw [find?_extend'] at hy ⊢
    split at hy
    · rw [if_pos ‹_›]; exact hy
    · rw [if_neg ‹_›]; exact h.1 y u hy
  · rw [find?_extend'] at hy ⊢
    split at hy
    · exact .inl (by rw [if_pos ‹_›]; exact hy)
    · rw [if_neg ‹_›]; exact (h.2 y u hy).imp id fun hm z hz => hm z (hB z hz)

theorem ExtΔ.avoid {Δ Δ' : LifeCtx} {B : List LifeVar} {x : LifeVar} (h : ExtΔ Δ Δ' B)
    (hx : x ∈ B) (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false) :
    ∀ y u, Δ'.find? y = some u → u.mentions x = false := fun y u hy =>
  (h.2 y u hy).elim (hΔx y u) fun hm => hm x hx

/-- `LeΔ`, decided over `Δ`'s bindings. -/
def leΔB (Δ Δ' : LifeCtx) : Bool := Δ.entries.all fun (x, _) => Δ.find? x == Δ'.find? x

/-- `ExtΔ`, decided over the bindings of `Δ` and `Δ'`. -/
def extΔB (Δ Δ' : LifeCtx) (B : List LifeVar) : Bool :=
  leΔB Δ Δ' && Δ'.entries.all fun (y, _) =>
    Δ'.find? y == Δ.find? y || (Δ'.find? y).all fun u => B.all fun x => !u.mentions x

theorem assocFind_mem' {β : Type} {x : LifeVar} {v : β} :
    ∀ {l : List (LifeVar × β)}, Lifetime.assocFind x l = some v → ∃ w, (x, w) ∈ l
  | [], h => by simp [Lifetime.assocFind] at h
  | (y, w) :: t, h => by
      simp only [Lifetime.assocFind] at h
      split at h
      · subst_vars; exact ⟨w, List.mem_cons_self⟩
      · obtain ⟨w', hw⟩ := assocFind_mem' h; exact ⟨w', List.mem_cons_of_mem _ hw⟩

theorem extΔB_sound {Δ Δ' : LifeCtx} {B : List LifeVar} (h : extΔB Δ Δ' B = true) :
    ExtΔ Δ Δ' B := by
  simp only [extΔB, leΔB, Bool.and_eq_true, List.all_eq_true] at h
  refine ⟨fun x u hx => ?_, fun y u hy => ?_⟩
  · obtain ⟨w, hw⟩ := assocFind_mem' hx
    have := h.1 (x, w) hw
    simp only [beq_iff_eq] at this
    show Δ'.find? x = some u
    rw [← this]; exact hx
  · obtain ⟨w, hw⟩ := assocFind_mem' hy
    have := h.2 (y, w) hw
    simp only [Bool.or_eq_true, beq_iff_eq] at this
    rcases this with e | e
    · exact .inl (by rw [← e]; exact hy)
    · refine .inr fun x hx => ?_
      have hy' : Δ'.find? y = some u := hy
      rw [hy'] at e
      simp only [Option.all_some, List.all_eq_true, Bool.not_eq_true'] at e
      exact e x hx

/-- **The lifetime variables a term's rules bind**: `∀I`'s, and the relaxed lends'. -/
def TExpr.lifeBinders : TExpr → List LifeVar
  | .var ii jj i A => []
  | .tensorI ii jj A B u t₁ t₂ => t₁.lifeBinders ++ t₂.lifeBinders
  | .sumI₁ ii jj A B t => t.lifeBinders
  | .sumI₂ ii jj A B t => t.lifeBinders
  | .thunkF ii jj A t => t.lifeBinders
  | .thunkV ii jj C t => t.lifeBinders
  | .ret ii jj A t => t.lifeBinders
  | .bind ii jj A C u tM tN => tM.lifeBinders ++ tN.lifeBinders
  | .force ii jj i T C => []
  | .lam ii jj A C t => t.lifeBinders
  | .lamDead ii jj S B t => t.lifeBinders
  | .app ii jj i A C u tM => tM.lifeBinders
  | .withI ii jj C D tM tN => tM.lifeBinders ++ tN.lifeBinders
  | .proj₁ ii jj C D t => t.lifeBinders
  | .proj₂ ii jj C D t => t.lifeBinders
  | .topI ii jj => []
  | .unitE ii jj C u tV tM => tV.lifeBinders ++ tM.lifeBinders
  | .tensorE ii jj A B C u tV tM => tV.lifeBinders ++ tM.lifeBinders
  | .sumE ii jj A B C u tV t₁ t₂ => tV.lifeBinders ++ t₁.lifeBinders ++ t₂.lifeBinders
  | .zeroE ii jj C u tV => tV.lifeBinders
  | .allI ii jj x b S C t => [x] ++ t.lifeBinders
  | .allE ii jj x b a C t => t.lifeBinders
  | .bangThunkF ii jj A t => t.lifeBinders
  | .bangThunkV ii jj C t => t.lifeBinders
  | .codeI ii jj C t => t.lifeBinders
  | .codeIB ii jj C t => t.lifeBinders
  | .codeErase ii jj C E t => t.lifeBinders
  | .codeEraseB ii jj C E t => t.lifeBinders
  | .bangE ii jj A t => t.lifeBinders
  | .boxI ii jj a A t => t.lifeBinders
  | .boxE ii jj a A t => t.lifeBinders
  | .immSub ii jj a b A t => t.lifeBinders
  | .mutSub ii jj a b A t => t.lifeBinders
  | .constK ii jj k => []
  | .reify ii jj S B R tres => tres.lifeBinders
  | .withborUD ii jj A B SM SD S k x td => td.lifeBinders
  | .sliceBorrowMU ii jj A B S x td => td.lifeBinders
  | .sliceBorrowIU ii jj A B S x td => td.lifeBinders
  | .lolliE ii jj A B u ta tf => ta.lifeBinders ++ tf.lifeBinders
  | .allEV ii jj x b a A t => t.lifeBinders
  | .ofRet ii jj A t => t.lifeBinders
  | .roll ii jj A t => t.lifeBinders
  | .unroll ii jj A t => t.lifeBinders
  | .nuIn ii jj m i C t => t.lifeBinders
  | .nuOut ii jj m i C t => t.lifeBinders
  | .nuOutK ii jj i C G S => []
  | .effSub ii jj S S' A t => t.lifeBinders
  | .effPerform ii jj S o t => t.lifeBinders
  | .effAwait ii jj S n a c => []
  | .effRaise ii jj S o B t => t.lifeBinders
  | .effLet ii jj A B S u tM tN => tM.lifeBinders ++ tN.lifeBinders
  | .effThen ii jj A B S SM SD u tM tN tD => tM.lifeBinders ++ tN.lifeBinders ++ tD.lifeBinders
  | .effThenDiv ii jj A B S SM SD u tM tN tD => tM.lifeBinders ++ tN.lifeBinders ++ tD.lifeBinders
  | .effHandleV ii jj S E fs cs n A R u ks site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .effHandleVB ii jj S E fs cs n A R d u ks site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .effHandleT ii jj S SN E fs n A R u site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .effHandleL ii jj S SW E fs Xs n A R u site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .letPoly ii jj C j tV tN => tV.lifeBinders ++ tN.lifeBinders
  | .alpha ii jj j j' t => t.lifeBinders
  | .lendR ii jj x b T B S td tM => [x] ++ td.lifeBinders ++ tM.lifeBinders
  | .lendLoopR ii jj x A S B R tN tK ts0 => [x] ++ [x] ++ [x] ++ tN.lifeBinders ++ tK.lifeBinders ++ ts0.lifeBinders
  | .nilDead ii jj j t => t.lifeBinders
  | .consume .. | .allocS .. | .freeS .. | .withborSM .. | .withborSI .. | .withborF2M ..
  | .withborF2I .. => []
  | .withlocal .. => []
  | .litFn _ _ _ t | .divLit _ _ _ _ t | .walk _ _ _ _ t | .walkGet _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t
  | .nuEta _ _ _ _ t | .lendScope _ _ _ t | .litView _ _ t | .unfoldStep _ _ t
  | .use _ _ _ _ _ _ t => t.lifeBinders

/-- **No rule of the term reads `⊓Δ` or takes a fresh variable of `Δ`**: the borrows, the block
and family borrows, and the relaxed lends are absent. -/
def TExpr.domFree : TExpr → Bool
  | .var ii jj i A => true
  | .tensorI ii jj A B u t₁ t₂ => t₁.domFree && t₂.domFree
  | .sumI₁ ii jj A B t => t.domFree
  | .sumI₂ ii jj A B t => t.domFree
  | .thunkF ii jj A t => t.domFree
  | .thunkV ii jj C t => t.domFree
  | .ret ii jj A t => t.domFree
  | .bind ii jj A C u tM tN => tM.domFree && tN.domFree
  | .force ii jj i T C => true
  | .lam ii jj A C t => t.domFree
  | .lamDead ii jj S B t => t.domFree
  | .app ii jj i A C u tM => tM.domFree
  | .withI ii jj C D tM tN => tM.domFree && tN.domFree
  | .proj₁ ii jj C D t => t.domFree
  | .proj₂ ii jj C D t => t.domFree
  | .topI ii jj => true
  | .unitE ii jj C u tV tM => tV.domFree && tM.domFree
  | .tensorE ii jj A B C u tV tM => tV.domFree && tM.domFree
  | .sumE ii jj A B C u tV t₁ t₂ => tV.domFree && t₁.domFree && t₂.domFree
  | .zeroE ii jj C u tV => tV.domFree
  | .allI ii jj x b S C t => t.domFree
  | .allE ii jj x b a C t => t.domFree
  | .bangThunkF ii jj A t => t.domFree
  | .bangThunkV ii jj C t => t.domFree
  | .codeI ii jj C t => t.domFree
  | .codeIB ii jj C t => t.domFree
  | .codeErase ii jj C E t => t.domFree
  | .codeEraseB ii jj C E t => t.domFree
  | .bangE ii jj A t => t.domFree
  | .boxI ii jj a A t => t.domFree
  | .boxE ii jj a A t => t.domFree
  | .immSub ii jj a b A t => t.domFree
  | .mutSub ii jj a b A t => t.domFree
  | .constK ii jj k => k.domFree
  | .reify ii jj S B R tres => tres.domFree
  | .withborUD ii jj A B SM SD S k x td => false
  | .sliceBorrowMU ii jj A B S x td => false
  | .sliceBorrowIU ii jj A B S x td => false
  | .lolliE ii jj A B u ta tf => ta.domFree && tf.domFree
  | .allEV ii jj x b a A t => t.domFree
  | .ofRet ii jj A t => t.domFree
  | .roll ii jj A t => t.domFree
  | .unroll ii jj A t => t.domFree
  | .nuIn ii jj m i C t => t.domFree
  | .nuOut ii jj m i C t => t.domFree
  | .nuOutK ii jj i C G S => true
  | .effSub ii jj S S' A t => t.domFree
  | .effPerform ii jj S o t => t.domFree
  | .effAwait ii jj S n a c => true
  | .effRaise ii jj S o B t => t.domFree
  | .effLet ii jj A B S u tM tN => tM.domFree && tN.domFree
  | .effThen ii jj A B S SM SD u tM tN tD => tM.domFree && tN.domFree && tD.domFree
  | .effThenDiv ii jj A B S SM SD u tM tN tD => tM.domFree && tN.domFree && tD.domFree
  | .effHandleV ii jj S E fs cs n A R u ks site inside tc te => tc.domFree && te.domFree
  | .effHandleVB ii jj S E fs cs n A R d u ks site inside tc te => tc.domFree && te.domFree
  | .effHandleT ii jj S SN E fs n A R u site inside tc te => tc.domFree && te.domFree
  | .effHandleL ii jj S SW E fs Xs n A R u site inside tc te => tc.domFree && te.domFree
  | .letPoly ii jj C j tV tN => tV.domFree && tN.domFree
  | .alpha ii jj j j' t => t.domFree
  | .lendR ii jj x b T B S td tM => false
  | .lendLoopR ii jj x A S B R tN tK ts0 => false
  | .nilDead ii jj j t => t.domFree
  | .withlocal .. => false
  | .consume .. | .allocS .. | .freeS .. => true
  | .withborSM .. | .withborSI .. | .withborF2M .. | .withborF2I .. => false
  | .litFn _ _ _ t | .divLit _ _ _ _ t | .walk _ _ _ _ t | .walkGet _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t
  | .nuEta _ _ _ _ t | .lendScope _ _ _ t | .litView _ _ t | .unfoldStep _ _ t
  | .use _ _ _ _ _ _ t => t.domFree

/-- **The term at a larger lifetime context `D`**: each `use` node's absorption at its context. -/
def TExpr.reAb (Δr : LifeCtx) : TExpr → TExpr
  | .var ii jj i A => .var ii jj i A
  | .tensorI ii jj A B u t₁ t₂ => .tensorI ii jj A B u (t₁.reAb Δr) (t₂.reAb Δr)
  | .sumI₁ ii jj A B t => .sumI₁ ii jj A B (t.reAb Δr)
  | .sumI₂ ii jj A B t => .sumI₂ ii jj A B (t.reAb Δr)
  | .thunkF ii jj A t => .thunkF ii jj A (t.reAb Δr)
  | .thunkV ii jj C t => .thunkV ii jj C (t.reAb Δr)
  | .ret ii jj A t => .ret ii jj A (t.reAb Δr)
  | .bind ii jj A C u tM tN => .bind ii jj A C u (tM.reAb Δr) (tN.reAb Δr)
  | .force ii jj i T C => .force ii jj i T C
  | .lam ii jj A C t => .lam ii jj A C (t.reAb Δr)
  | .lamDead ii jj S B t => .lamDead ii jj S B (t.reAb Δr)
  | .app ii jj i A C u tM => .app ii jj i A C u (tM.reAb Δr)
  | .withI ii jj C D tM tN => .withI ii jj C D (tM.reAb Δr) (tN.reAb Δr)
  | .proj₁ ii jj C D t => .proj₁ ii jj C D (t.reAb Δr)
  | .proj₂ ii jj C D t => .proj₂ ii jj C D (t.reAb Δr)
  | .topI ii jj => .topI ii jj
  | .unitE ii jj C u tV tM => .unitE ii jj C u (tV.reAb Δr) (tM.reAb Δr)
  | .tensorE ii jj A B C u tV tM => .tensorE ii jj A B C u (tV.reAb Δr) (tM.reAb Δr)
  | .sumE ii jj A B C u tV t₁ t₂ => .sumE ii jj A B C u (tV.reAb Δr) (t₁.reAb Δr) (t₂.reAb Δr)
  | .zeroE ii jj C u tV => .zeroE ii jj C u (tV.reAb Δr)
  | .allI ii jj x b S C t => .allI ii jj x b S C (t.reAb (Δr.extend x b))
  | .allE ii jj x b a C t => .allE ii jj x b a C (t.reAb Δr)
  | .bangThunkF ii jj A t => .bangThunkF ii jj A (t.reAb Δr)
  | .bangThunkV ii jj C t => .bangThunkV ii jj C (t.reAb Δr)
  | .codeI ii jj C t => .codeI ii jj C (t.reAb Δr)
  | .codeIB ii jj C t => .codeIB ii jj C (t.reAb Δr)
  | .codeErase ii jj C E t => .codeErase ii jj C E (t.reAb Δr)
  | .codeEraseB ii jj C E t => .codeEraseB ii jj C E (t.reAb Δr)
  | .bangE ii jj A t => .bangE ii jj A (t.reAb Δr)
  | .boxI ii jj a A t => .boxI ii jj a A (t.reAb Δr)
  | .boxE ii jj a A t => .boxE ii jj a A (t.reAb Δr)
  | .immSub ii jj a b A t => .immSub ii jj a b A (t.reAb Δr)
  | .mutSub ii jj a b A t => .mutSub ii jj a b A (t.reAb Δr)
  | .constK ii jj k => .constK ii jj k
  | .reify ii jj S B R tres => .reify ii jj S B R (tres.reAb Δr)
  | .withborUD ii jj A B SM SD S k x td => .withborUD ii jj A B SM SD S k x (td.reAb Δr)
  | .sliceBorrowMU ii jj A B S x td => .sliceBorrowMU ii jj A B S x (td.reAb Δr)
  | .sliceBorrowIU ii jj A B S x td => .sliceBorrowIU ii jj A B S x (td.reAb Δr)
  | .lolliE ii jj A B u ta tf => .lolliE ii jj A B u (ta.reAb Δr) (tf.reAb Δr)
  | .allEV ii jj x b a A t => .allEV ii jj x b a A (t.reAb Δr)
  | .ofRet ii jj A t => .ofRet ii jj A (t.reAb Δr)
  | .roll ii jj A t => .roll ii jj A (t.reAb Δr)
  | .unroll ii jj A t => .unroll ii jj A (t.reAb Δr)
  | .nuIn ii jj m i C t => .nuIn ii jj m i C (t.reAb Δr)
  | .nuOut ii jj m i C t => .nuOut ii jj m i C (t.reAb Δr)
  | .nuOutK ii jj i C G S => .nuOutK ii jj i C G S
  | .effSub ii jj S S' A t => .effSub ii jj S S' A (t.reAb Δr)
  | .effPerform ii jj S o t => .effPerform ii jj S o (t.reAb Δr)
  | .effAwait ii jj S n a c => .effAwait ii jj S n a c
  | .effRaise ii jj S o B t => .effRaise ii jj S o B (t.reAb Δr)
  | .effLet ii jj A B S u tM tN => .effLet ii jj A B S u (tM.reAb Δr) (tN.reAb Δr)
  | .effThen ii jj A B S SM SD u tM tN tD => .effThen ii jj A B S SM SD u (tM.reAb Δr) (tN.reAb Δr) (tD.reAb Δr)
  | .effThenDiv ii jj A B S SM SD u tM tN tD => .effThenDiv ii jj A B S SM SD u (tM.reAb Δr) (tN.reAb Δr) (tD.reAb Δr)
  | .effHandleV ii jj S E fs cs n A R u ks site inside tc te => .effHandleV ii jj S E fs cs n A R u ks site inside (tc.reAb Δr) (te.reAb Δr)
  | .effHandleVB ii jj S E fs cs n A R d u ks site inside tc te => .effHandleVB ii jj S E fs cs n A R d u ks site inside (tc.reAb Δr) (te.reAb Δr)
  | .effHandleT ii jj S SN E fs n A R u site inside tc te => .effHandleT ii jj S SN E fs n A R u site inside (tc.reAb Δr) (te.reAb Δr)
  | .effHandleL ii jj S SW E fs Xs n A R u site inside tc te => .effHandleL ii jj S SW E fs Xs n A R u site inside (tc.reAb Δr) (te.reAb Δr)
  | .letPoly ii jj C j tV tN => .letPoly ii jj C j (tV.reAb Δr) (tN.reAb Δr)
  | .alpha ii jj j j' t => .alpha ii jj j j' (t.reAb Δr)
  | .lendR ii jj x b T B S td tM => .lendR ii jj x b T B S (td.reAb Δr) (tM.reAb (Δr.extend x b))
  | .lendLoopR ii jj x A S B R tN tK ts0 => .lendLoopR ii jj x A S B R (tN.reAb (Δr.extend x Δr.meetOfDom)) (tK.reAb (Δr.extend x Δr.meetOfDom)) (ts0.reAb (Δr.extend x Δr.meetOfDom))
  | .nilDead ii jj j t => .nilDead ii jj j (t.reAb Δr)
  | t@(.withlocal ..) => t
  | t@(.consume ..) | t@(.allocS ..) | t@(.freeS ..) | t@(.withborSM ..) | t@(.withborSI ..)
  | t@(.withborF2M ..) | t@(.withborF2I ..) => t
  | .litFn i j bs t => .litFn i j bs (t.reAb Δr)
  | .divLit i j op c t => .divLit i j op c (t.reAb Δr)
  | .walk i j m r t => .walk i j m r (t.reAb Δr)
  | .walkGet i j m t => .walkGet i j m (t.reAb Δr)
  | .selfCall i j k n t => .selfCall i j k n (t.reAb Δr)
  | .lendCell i j m t => .lendCell i j m (t.reAb Δr)
  | .nuEta i j f s t => .nuEta i j f s (t.reAb Δr)
  | .lendScope i j r t => .lendScope i j r (t.reAb Δr)
  | .litView i j t => .litView i j (t.reAb Δr)
  | .unfoldStep i j t => .unfoldStep i j (t.reAb Δr)
  | .use i j n k τ _ t => .use i j n k τ ((t.reAb Δr).absF Δr) (t.reAb Δr)

theorem TExpr.reAb_erase : ∀ (t : TExpr) (Δr : LifeCtx), (t.reAb Δr).erase = t.erase := by
  intro t
  induction t <;> intro Δr <;> simp only [TExpr.reAb, TExpr.erase, *]

/-! ### The derived nodes' shapes at a larger lifetime context  `[spec §57]` -/

theorem TExpr.isVarT_reAb (k : Nat) (Δr : LifeCtx) (t : TExpr) : (t.reAb Δr).isVarT k = t.isVarT k := by
  cases t <;> rfl

theorem TExpr.isLendCell_reAb (Δr : LifeCtx) (t : TExpr) : (t.reAb Δr).isLendCell = t.isLendCell := by
  cases t <;> rfl

theorem TExpr.lendKind?_reAb (Δr : LifeCtx) (t : TExpr) : (t.reAb Δr).lendKind? = t.lendKind? := by
  cases t <;> rfl

theorem TExpr.isUnfoldN_reAb (Δr : LifeCtx) (t : TExpr) : (t.reAb Δr).isUnfoldN = t.isUnfoldN := by
  cases t <;> rfl

theorem retLendT_reAb (Δr : LifeCtx) (t : TExpr) : retLendT (t.reAb Δr) = retLendT t := by
  cases t <;> simp only [TExpr.reAb, retLendT, TExpr.isLendCell_reAb]

theorem pairOf0T_reAb (Δr : LifeCtx) (t : TExpr) : pairOf0T (t.reAb Δr) = pairOf0T t := by
  cases t <;> simp only [TExpr.reAb, pairOf0T, TExpr.isVarT_reAb]

theorem lendScopeT_reAb (Δr : LifeCtx) (t : TExpr) : lendScopeT (t.reAb Δr) = lendScopeT t := by
  cases t <;> simp only [TExpr.reAb, lendScopeT, TExpr.isLendCell_reAb, retLendT_reAb, pairOf0T_reAb]

theorem TExpr.isRelease_reAb (Δr : LifeCtx) (t : TExpr) : (t.reAb Δr).isRelease = t.isRelease := by
  cases t <;> rfl

theorem relT_reAb (Δr : LifeCtx) (t : TExpr) : ∀ k, relT k (t.reAb Δr) = relT k t := by
  induction t
  case lolliE _ _ _ _ _ ta tf _ _ =>
    intro k; simp only [TExpr.reAb, relT, TExpr.isVarT_reAb, TExpr.isRelease_reAb]
  case ret _ _ _ t ih | ofRet _ _ _ t ih | effSub _ _ _ _ _ t ih | lendScope _ _ _ t ih
    | sumI₁ _ _ _ _ t ih | sumI₂ _ _ _ _ t ih | alpha _ _ _ _ t ih =>
    intro k; simp only [TExpr.reAb, relT, ih k]
  case bind _ _ _ _ u tM tN ihM ihN | effLet _ _ _ _ _ u tM tN ihM ihN =>
    intro k; simp only [TExpr.reAb, relT, ihM k, ihN (k + 1)]
  case unitE _ _ _ u tV tM ihV ihM | tensorI _ _ _ _ u tV tM ihV ihM => intro k; simp only [TExpr.reAb, relT, ihV k, ihM k]
  case sumE _ _ _ _ _ u tV t₁ t₂ _ ih₁ ih₂ => intro k; simp only [TExpr.reAb, relT, ih₁ (k + 1), ih₂ (k + 1)]
  case tensorE _ _ _ _ _ u tV tM _ ihM => intro k; simp only [TExpr.reAb, relT, ihM (k + 2)]
  case effThen _ _ _ _ _ _ _ u tM tN tD ihM ihN ihD =>
    intro k; simp only [TExpr.reAb, relT, ihM k, ihN (k + 1), ihD (k + 1)]
  all_goals intro k; rfl

theorem lendRelT_reAb (Δr : LifeCtx) (t : TExpr) : lendRelT (t.reAb Δr) = lendRelT t := by
  cases t with
  | tensorE _ _ _ _ _ _ _ tM => simp only [TExpr.reAb, lendRelT, relT_reAb]
  | bind _ _ _ _ _ _ tN | effLet _ _ _ _ _ _ _ tN =>
    cases tN with
    | tensorE _ _ _ _ _ _ _ tM => simp only [TExpr.reAb, lendRelT, relT_reAb]
    | _ => rfl
  | _ => rfl

theorem lendKindB_reAb (m : Bool) (Δr : LifeCtx) (t : TExpr) : lendKindB m (t.reAb Δr) = lendKindB m t := by
  cases t with
  | lolliE _ _ _ _ _ _ tf => cases tf <;> simp only [TExpr.reAb, lendKindB, TExpr.lendKind?_reAb]
  | _ => rfl

theorem litBodyT_reAb (Δr : LifeCtx) (t : TExpr) : litBodyT (t.reAb Δr) = litBodyT t := by
  cases t with
  | bind _ _ _ _ _ tA tN =>
    cases tN with
    | bind _ _ _ _ _ tL tR =>
      cases tR with
      | tensorE _ _ _ _ _ _ tP tU =>
        cases tU with
        | unitE _ _ _ _ tD _ =>
          have hA : tabT (tA.reAb Δr) = tabT tA := by
            cases tA with
            | ret _ _ _ t =>
              cases t with
              | lolliE _ _ _ _ _ _ tf =>
                cases tf with
                | bangE _ _ _ t => cases t <;> rfl
                | _ => rfl
              | _ => rfl
            | _ => rfl
          have hL : immLendT (tL.reAb Δr) = immLendT tL := by
            cases tL with
            | ret _ _ _ t =>
              cases t with
              | lolliE _ _ _ _ _ _ tf =>
                cases tf with
                | lolliE _ _ _ _ _ x h => cases h <;> simp only [TExpr.reAb, immLendT, TExpr.isVarT_reAb]
                | _ => rfl
              | _ => rfl
            | _ => rfl
          have hD : consumeOf1T (tD.reAb Δr) = consumeOf1T tD := by
            cases tD with
            | lolliE _ _ _ _ _ x h => cases h <;> simp only [TExpr.reAb, consumeOf1T, TExpr.isVarT_reAb]
            | _ => rfl
          simp only [TExpr.reAb, litBodyT, hA, hL, hD, TExpr.isVarT_reAb]
        | _ => rfl
      | _ => rfl
    | _ => rfl
  | _ => rfl

theorem litViewT_reAb (Δr : LifeCtx) (t : TExpr) : litViewT (t.reAb Δr) = litViewT t := by
  cases t with
  | ofRet _ _ _ t =>
    cases t with
    | bind _ _ _ _ _ _ tN =>
      cases tN with
      | tensorE _ _ _ _ _ _ tV tB =>
        simp only [TExpr.reAb, litViewT, TExpr.isVarT_reAb, litBodyT_reAb]
      | _ => rfl
    | _ => rfl
  | _ => rfl

theorem unfoldAppT_reAb (t : TExpr) : ∀ Δr, unfoldAppT (t.reAb Δr) = unfoldAppT t := by
  induction t <;> intro Δr <;> simp_all [TExpr.reAb, unfoldAppT, TExpr.isUnfoldN_reAb]

/-- **A typed derivation at a larger lifetime context**, at every index.  `[spec §3, §10, §83]` -/
theorem TDerivesX.weakenΔ {I : JIdx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesX I Δ Γ t j) : ∀ Δ', ExtΔ Δ Δ' t.lifeBinders → t.domFree = true →
      TDerivesX I Δ' Γ (t.reAb Δ') j := by
  induction h with
  | var a0 =>
      intro Δ' he hd
      exact TDerivesX.var a0
  | tensorI a0 a1 a2 a3 a4 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.tensorI a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | sumI₁ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.sumI₁ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | sumI₂ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.sumI₂ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | thunkF a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.thunkF (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | thunkV a0 a1 a2 ih0 =>
      intro Δ' he hd
      exact TDerivesX.thunkV a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a2)
  | ret a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.ret (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | bind a0 a1 a2 a3 a4 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.bind a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | force a0 a1 =>
      intro Δ' he hd
      exact TDerivesX.force a0 a1
  | lam a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.lam (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | lamDead a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.lamDead (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | app a0 a1 a2 a3 a4 ih0 =>
      intro Δ' he hd
      exact TDerivesX.app a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) a4
  | withI a0 a1 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.withI (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | proj₁ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.proj₁ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | proj₂ a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.proj₂ (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | topI =>
      intro Δ' he hd
      exact TDerivesX.topI
  | unitE a0 a1 a2 a3 a4 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.unitE a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | tensorE a0 a1 a2 a3 a4 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.tensorE a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | sumE a0 a1 a2 a3 a4 a5 ih0 ih1 ih2 =>
      intro Δ' he hd
      exact TDerivesX.sumE a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih2 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | zeroE a0 a1 a2 a3 ih0 =>
      intro Δ' he hd
      exact TDerivesX.zeroE a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | allI a0 a1 a2 a3 ih0 =>
      intro Δ' he hd
      exact TDerivesX.allI a0 (ExtΔ.avoid he (by simp [TExpr.lifeBinders]) a1) a2 (ih0 _ (ExtΔ.extend he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | allE a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.allE (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLt he.1 a1)
  | bangThunkF a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.bangThunkF a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | bangThunkV a0 a1 a2 a3 ih0 =>
      intro Δ' he hd
      exact TDerivesX.bangThunkV a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a3)
  | codeI a0 a1 a2 ih0 =>
      intro Δ' he hd
      exact TDerivesX.codeI (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a1) a2
  | codeIB a0 a1 a2 a3 ih0 =>
      intro Δ' he hd
      exact TDerivesX.codeIB a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a2) a3
  | codeErase a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.codeErase (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | codeEraseB a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.codeEraseB (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | bangE a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.bangE (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | boxI a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.boxI (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.ctxOutlives he.1 a1)
  | boxE a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.boxE (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | immSub a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.immSub (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLe he.1 a1)
  | mutSub a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.mutSub (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLe he.1 a1)
  | constK a0 a1 a2 a3 =>
      intro Δ' _ hd
      have hk : ConstKind.domFree a0 = true := by simpa [TExpr.domFree] using hd
      rw [ConstKind.ty_domFree hk _ Δ'.meetOfDom]
      exact TDerivesX.constK a0 a1 (ConstKind.OK_domFree hk a2) a3
  | reify a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 ih0 =>
      intro Δ' he hd
      exact TDerivesX.reify a0 a1 a2 a3 a4 a5 a6 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a8) a9
  | withborUD => intro _ _ hd; simp [TExpr.domFree] at hd
  | sliceBorrowMU => intro _ _ hd; simp [TExpr.domFree] at hd
  | sliceBorrowIU => intro _ _ hd; simp [TExpr.domFree] at hd
  | lolliE a0 a1 a2 a3 a4 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.lolliE a0 a1 (by simpa only [TExpr.reAb_erase] using a2) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | allEV a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.allEV (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.entailsLt he.1 a1)
  | ofRet a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.ofRet (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | roll a0 a1 a2 ih0 =>
      intro Δ' he hd
      exact TDerivesX.roll a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | unroll a0 ih0 =>
      intro Δ' he hd
      exact TDerivesX.unroll (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | nuIn a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.nuIn a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | nuOut a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.nuOut a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | nuOutK a0 a1 a2 a3 a4 =>
      intro Δ' he hd
      exact TDerivesX.nuOutK a0 a1 a2 a3 a4
  | effSub a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.effSub a0 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | effPerform a0 a1 a2 a3 a4 ih0 =>
      intro Δ' he hd
      exact TDerivesX.effPerform a0 a1 a2 a3 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | effAwait a0 a1 a2 a3 a4 a5 a6 =>
      intro Δ' he hd
      exact TDerivesX.effAwait a0 a1 a2 a3 a4 a5 a6
  | effRaise a0 a1 a2 a3 a4 a5 ih0 =>
      intro Δ' he hd
      exact TDerivesX.effRaise a0 a1 a2 a3 a4 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | effLet a0 a1 a2 a3 a4 a5 a6 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.effLet a0 a1 (by simpa only [TExpr.reAb_erase] using a2) a3 a4 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | effThen a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 ih0 ih1 ih2 =>
      intro Δ' he hd
      exact TDerivesX.effThen a0 a1 (by simpa only [TExpr.reAb_erase] using a2) a3 a4 a5 a6 a7 a8 a9 a10 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih2 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | effThenDiv a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 ih0 ih1 ih2 =>
      intro Δ' he hd
      exact TDerivesX.effThenDiv a0 a1 (by simpa only [TExpr.reAb_erase] using a2) a3 a4 a5 a6 a7 a8 a9 a10 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (ih2 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | effHandleV a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.effHandleV a0 a1 a2 (by simpa only [TExpr.reAb_erase] using a3) a4 (by rw [TExpr.reAb_erase]; exact a5) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) a7 a8 a9 a10 (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a12)
  | effHandleVB a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.effHandleVB a0 a1 a2 (by simpa only [TExpr.reAb_erase] using a3) a4 (by rw [TExpr.reAb_erase]; exact a5) (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) a7 a8 a9 a10 (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (LeΔ.ctxOutlives he.1 a12) (LeΔ.ansOutlives he.1 a13) (by rw [TExpr.reAb_erase]; exact a14)
  | effHandleT a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.effHandleT a0 a1 a2 (by simpa only [TExpr.reAb_erase] using a3) a4 a5 a6 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a8) a9 a10 a11 a12 a13 a14 (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a16)
  | effHandleL a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.effHandleL a0 a1 a2 (by simpa only [TExpr.reAb_erase] using a3) a4 a5 a6 a7 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a9) a10 a11 a12 a13 a14 a15 a16 a17 a18 (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a20)
  | letPoly a0 a1 a2 a3 a4 a5 ih0 ih1 =>
      intro Δ' he hd
      exact TDerivesX.letPoly a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a3) (ih1 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) (by rw [TExpr.reAb_erase]; exact a5)
  | alpha a0 a1 ih0 =>
      intro Δ' he hd
      exact TDerivesX.alpha (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree])) a1
  | lendR => intro _ _ hd; simp [TExpr.domFree] at hd
  | lendLoopR => intro _ _ hd; simp [TExpr.domFree] at hd
  | nilDead a0 a1 a2 ih0 =>
      intro Δ' he hd
      exact TDerivesX.nilDead a0 a1 (ih0 Δ' (ExtΔ.sub he (fun z hz => by simp [TExpr.lifeBinders, hz])) (by simp_all [TExpr.domFree]))
  | consume hA hc he hΓ => intro _ _ _; exact .consume hA hc he hΓ
  | withlocal => intro _ _ hd; simp [TExpr.domFree] at hd
  | allocS σ he hΓ => intro _ _ _; exact .allocS σ he hΓ
  | freeS σ he hΓ => intro _ _ _; exact .freeS σ he hΓ
  | withborSM => intro _ _ hd; simp [TExpr.domFree] at hd
  | withborSI => intro _ _ hd; simp [TExpr.domFree] at hd
  | withborF2M => intro _ _ hd; simp [TExpr.domFree] at hd
  | withborF2I => intro _ _ hd; simp [TExpr.domFree] at hd
  | litFn _ hb hcl ih =>
      intro Δ' he hd; exact .litFn (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb) hcl
  | divLit _ hb hs ih =>
      intro Δ' he hd; exact .divLit (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb) hs
  | walk _ hb hr ih =>
      intro Δ' he hd
      exact .walk (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
        (fun h => by rw [TExpr.reAb_erase]; exact hr h)
  | walkGet _ hb ih =>
      intro Δ' he hd; exact .walkGet (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
  | selfCall _ hb ih =>
      intro Δ' he hd; exact .selfCall (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
  | lendCell _ hb hm ih =>
      intro Δ' he hd
      exact .lendCell (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb) (by rw [lendKindB_reAb]; exact hm)
  | lendScope _ hs hr ih =>
      intro Δ' he hd
      exact .lendScope (ih Δ' he hd) (by rw [lendScopeT_reAb]; exact hs) (by rw [lendRelT_reAb]; exact hr)
  | litView _ hb ih =>
      intro Δ' he hd; exact .litView (ih Δ' he hd) (by rw [litViewT_reAb]; exact hb)
  | unfoldStep _ hb ih =>
      intro Δ' he hd; exact .unfoldStep (ih Δ' he hd) (by rw [unfoldAppT_reAb]; exact hb)
  | nuEta _ hb ih =>
      intro Δ' he hd; exact .nuEta (ih Δ' he hd) (by rw [TExpr.reAb_erase]; exact hb)
  | use _ _ ih => intro Δ' he hd; exact .use (ih Δ' he hd) rfl

/-- **A typed derivation at a larger lifetime context**, in `TDerivesP`.  `[spec §3, §10]` -/
theorem TDerivesP.weakenΔ {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesP Δ Γ t j) : ∀ Δ', ExtΔ Δ Δ' t.lifeBinders → t.domFree = true →
      TDerivesP Δ' Γ (t.reAb Δ') j :=
  TDerivesX.weakenΔ h

/-- **A typed derivation at a larger lifetime context**, tied.  `[spec §3, §10, §19]` -/
theorem TDerivesAt.weakenΔ {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesAt Ξ Δ Γ t j) : ∀ Δ', ExtΔ Δ Δ' t.lifeBinders → t.domFree = true →
      TDerivesAt Ξ Δ' Γ (t.reAb Δ') j :=
  TDerivesX.weakenΔ h

