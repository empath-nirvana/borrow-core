import Frontend.Check.Weaken

/-!
# Frontend — Check — a typed derivation at a larger lifetime context  `[spec §3, §10]`

GENERATED by `scripts/gen-pin.py` from `Core/Tied.lean`, `Core/PinDerives.lean` and
`scripts/pin/TLife.tmpl.lean`. Edit the template, not this file.

**The lemma that checks a `def` once.** A `def`'s body is checked at its declaration, at the
empty lifetime context. A use under lifetime binders, or inside a borrow, is at a larger context.
A typed derivation at `Δ` is one at every larger `Δ'` (`TDerivesP.weakenΔ`, `TDerivesAt.weakenΔ`)
when:

* `Δ'` has every binding `Δ` has (`LeΔ`), so every premise the derivation proves of `Δ`, an
  entailment (`Δ ⊨ @a ⊑ @b`, `Δ ⊨ @a ⊏ @b`) or an outlives judgment (`CtxOutlives`,
  `Row.AnsOutlives`), holds of `Δ'`;
* a binding `Δ'` has beyond `Δ`'s mentions none of the term's lifetime binders (`ExtΔ`), so a
  `∀I`'s premise that no bound mentions its variable holds of `Δ'`;
* the term has no rule whose node's type or premises read `⊓Δ` or take a fresh variable of `Δ`
  (`TExpr.domFree`): the borrows' types are `∀'x ⊏ ⊓Δ. …`, which a larger `Δ` changes.

The term is the same at `Δ'`, except that each `use` node's absorption is computed at its context
there (`TExpr.reAb`), which leaves its erasure as it is (`TExpr.reAb_erase`). A type's lifetime
binder may shadow a variable of `Δ'` (`∀I` takes no freshness), so no binder is renamed.
-/

namespace BoCa.Fig16.LogRel.Core.Check
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.Fig16.LogRel.Core
open BoCa.Lifetime (LifeCtx LifeVar)

/-- `Δ'` has every binding of `Δ`. -/
def LeΔ (Δ Δ' : LifeCtx) : Prop := ∀ x u, Δ.find? x = some u → Δ'.find? x = some u

/-- `Δ'` has every binding of `Δ`, and its other bindings' bounds mention none of `B`. -/
def ExtΔ (Δ Δ' : LifeCtx) (B : List LifeVar) : Prop :=
  LeΔ Δ Δ' ∧ ∀ y u, Δ'.find? y = some u → Δ.find? y = some u ∨ ∀ x ∈ B, u.mentions x = false

theorem LeΔ.models {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {δ : Lifetime.LSub} (hm : Δ'.Models δ) :
    Δ.Models δ := fun x u hx => hm x u (h x u hx)

theorem LeΔ.entailsLe {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a b : Lifetime.Life}
    (he : Δ.EntailsLe a b) : Δ'.EntailsLe a b := fun δ hδ => he δ (h.models hδ)

theorem LeΔ.entailsLt {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a b : Lifetime.Life}
    (he : Δ.EntailsLt a b) : Δ'.EntailsLt a b := fun δ hδ => he δ (h.models hδ)

theorem LeΔ.defines {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a : Lifetime.Life} (he : Δ.Defines a) :
    Δ'.Defines a := fun δ hδ => he δ (h.models hδ)

theorem VOutlivesR.mono {Rb Rr Rb' Rr' : Lifetime.Life → Prop} (hb : ∀ b, Rb b → Rb' b)
    (hr : ∀ b, Rr b → Rr' b) {A : VTy} (h : VOutlivesR Rb Rr A) : VOutlivesR Rb' Rr' A := by
  induction h with
  | unit => exact .unit
  | tensor _ _ ih₁ ih₂ => exact .tensor ih₁ ih₂
  | zero => exact .zero
  | sum _ _ ih₁ ih₂ => exact .sum ih₁ ih₂
  | ref _ ih => exact .ref ih
  | bang => exact .bang
  | box h => exact .box (hb _ h)
  | imm h => exact .imm (hr _ h)
  | «mut» h => exact .mut (hr _ h)
  | tvar => exact .tvar
  | mu _ ih => exact .mu ih
  | int => exact .int
  | opq => exact .opq
  | fam _ ih => exact .fam ih

theorem LeΔ.vOutlives {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {a : Lifetime.Life} {A : VTy}
    (ho : VOutlives Δ a A) : VOutlives Δ' a A :=
  VOutlivesR.mono (fun _ => h.entailsLe) (fun _ => h.entailsLt) ho

theorem LeΔ.ctxOutlives {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {Γ : Ctx VTy} {a : Lifetime.Life}
    (ho : CtxOutlives Δ Γ a) : CtxOutlives Δ' Γ a :=
  ⟨h.defines ho.1, fun s hs hl => h.vOutlives (ho.2 s hs hl)⟩

theorem LeΔ.ansOutlives {Δ Δ' : LifeCtx} (h : LeΔ Δ Δ') {d : Lifetime.Life} {S : Row}
    (ho : Row.AnsOutlives Δ d S) : Row.AnsOutlives Δ' d S :=
  fun o hoS ha => h.vOutlives (ho o hoS ha)

theorem ExtΔ.sub {Δ Δ' : LifeCtx} {B B' : List LifeVar} (h : ExtΔ Δ Δ' B)
    (hB : ∀ z ∈ B', z ∈ B) : ExtΔ Δ Δ' B' :=
  ⟨h.1, fun y u hy => (h.2 y u hy).imp id fun hm x hx => hm x (hB x hx)⟩

theorem find?_extend' (Δ : LifeCtx) (x : LifeVar) (b : Lifetime.Life) (y : LifeVar) :
    (Δ.extend x b).find? y = if x = y then some b else Δ.find? y := by
  simp [Lifetime.LifeCtx.find?, Lifetime.LifeCtx.extend, Lifetime.assocFind]

theorem ExtΔ.extend {Δ Δ' : LifeCtx} {B B' : List LifeVar} {x : LifeVar} {b : Lifetime.Life}
    (h : ExtΔ Δ Δ' B) (hB : ∀ z ∈ B', z ∈ B) : ExtΔ (Δ.extend x b) (Δ'.extend x b) B' := by
  refine ⟨fun y u hy => ?_, fun y u hy => ?_⟩
  · rw [find?_extend'] at hy ⊢
    split at hy
    · rw [if_pos ‹_›]; exact hy
    · rw [if_neg ‹_›]; exact h.1 y u hy
  · rw [find?_extend'] at hy ⊢
    split at hy
    · exact .inl (by rw [if_pos ‹_›]; exact hy)
    · rw [if_neg ‹_›]; exact (h.2 y u hy).imp id fun hm z hz => hm z (hB z hz)

theorem ExtΔ.avoid {Δ Δ' : LifeCtx} {B : List LifeVar} {x : LifeVar} (h : ExtΔ Δ Δ' B)
    (hx : x ∈ B) (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false) :
    ∀ y u, Δ'.find? y = some u → u.mentions x = false := fun y u hy =>
  (h.2 y u hy).elim (hΔx y u) fun hm => hm x hx

/-- `LeΔ`, decided over `Δ`'s bindings. -/
def leΔB (Δ Δ' : LifeCtx) : Bool := Δ.entries.all fun (x, _) => Δ.find? x == Δ'.find? x

/-- `ExtΔ`, decided over the bindings of `Δ` and `Δ'`. -/
def extΔB (Δ Δ' : LifeCtx) (B : List LifeVar) : Bool :=
  leΔB Δ Δ' && Δ'.entries.all fun (y, _) =>
    Δ'.find? y == Δ.find? y || (Δ'.find? y).all fun u => B.all fun x => !u.mentions x

theorem assocFind_mem' {β : Type} {x : LifeVar} {v : β} :
    ∀ {l : List (LifeVar × β)}, Lifetime.assocFind x l = some v → ∃ w, (x, w) ∈ l
  | [], h => by simp [Lifetime.assocFind] at h
  | (y, w) :: t, h => by
      simp only [Lifetime.assocFind] at h
      split at h
      · subst_vars; exact ⟨w, List.mem_cons_self⟩
      · obtain ⟨w', hw⟩ := assocFind_mem' h; exact ⟨w', List.mem_cons_of_mem _ hw⟩

theorem extΔB_sound {Δ Δ' : LifeCtx} {B : List LifeVar} (h : extΔB Δ Δ' B = true) :
    ExtΔ Δ Δ' B := by
  simp only [extΔB, leΔB, Bool.and_eq_true, List.all_eq_true] at h
  refine ⟨fun x u hx => ?_, fun y u hy => ?_⟩
  · obtain ⟨w, hw⟩ := assocFind_mem' hx
    have := h.1 (x, w) hw
    simp only [beq_iff_eq] at this
    show Δ'.find? x = some u
    rw [← this]; exact hx
  · obtain ⟨w, hw⟩ := assocFind_mem' hy
    have := h.2 (y, w) hw
    simp only [Bool.or_eq_true, beq_iff_eq] at this
    rcases this with e | e
    · exact .inl (by rw [← e]; exact hy)
    · refine .inr fun x hx => ?_
      have hy' : Δ'.find? y = some u := hy
      rw [hy'] at e
      simp only [Option.all_some, List.all_eq_true, Bool.not_eq_true'] at e
      exact e x hx

/-- **The lifetime variables a term's rules bind**: `∀I`'s, and the relaxed lends'. -/
def TExpr.lifeBinders : TExpr → List LifeVar
  | .var ii jj i A => []
  | .unitI ii jj => []
  | .tensorI ii jj A B u t₁ t₂ => t₁.lifeBinders ++ t₂.lifeBinders
  | .sumI₁ ii jj A B t => t.lifeBinders
  | .sumI₂ ii jj A B t => t.lifeBinders
  | .thunkF ii jj A t => t.lifeBinders
  | .thunkV ii jj C t => t.lifeBinders
  | .ret ii jj A t => t.lifeBinders
  | .bind ii jj A C u tM tN => tM.lifeBinders ++ tN.lifeBinders
  | .force ii jj i C => []
  | .lam ii jj A C t => t.lifeBinders
  | .lamDead ii jj S B t => t.lifeBinders
  | .app ii jj i A C u tM => tM.lifeBinders
  | .withI ii jj C D tM tN => tM.lifeBinders ++ tN.lifeBinders
  | .proj₁ ii jj C D t => t.lifeBinders
  | .proj₂ ii jj C D t => t.lifeBinders
  | .topI ii jj => []
  | .unitE ii jj C u tV tM => tV.lifeBinders ++ tM.lifeBinders
  | .tensorE ii jj A B C u tV tM => tV.lifeBinders ++ tM.lifeBinders
  | .sumE ii jj A B C u tV t₁ t₂ => tV.lifeBinders ++ t₁.lifeBinders ++ t₂.lifeBinders
  | .zeroE ii jj C u tV => tV.lifeBinders
  | .allI ii jj x b S C t => [x] ++ t.lifeBinders
  | .allE ii jj x b a C t => t.lifeBinders
  | .bangThunkF ii jj A t => t.lifeBinders
  | .bangThunkV ii jj C t => t.lifeBinders
  | .bangE ii jj A t => t.lifeBinders
  | .copyBang ii jj A => []
  | .forgetBang ii jj A => []
  | .boxI ii jj a A t => t.lifeBinders
  | .boxE ii jj a A t => t.lifeBinders
  | .immSub ii jj a b A t => t.lifeBinders
  | .mutSub ii jj a b A t => t.lifeBinders
  | .alloc ii jj A => []
  | .free ii jj A => []
  | .swap ii jj A B => []
  | .copy ii jj a A => []
  | .forgetImm ii jj a A => []
  | .forgetMut ii jj a A => []
  | .forgetUnk ii jj => []
  | .lit ii jj c => []
  | .hostOp ii jj op => []
  | .arrNew ii jj A => []
  | .arrFree ii jj A => []
  | .arrSize ii jj A => []
  | .arrReplace ii jj A => []
  | .arrLen ii jj a A => []
  | .arrGet ii jj a A => []
  | .arrCopy ii jj a A => []
  | .arrForget ii jj a A => []
  | .countFold ii jj S => []
  | .countTry ii jj S E => []
  | .boundedFix ii jj A C => []
  | .iterate ii jj S St B R => []
  | .divFuel ii jj S A => []
  | .reify ii jj S B R tres => tres.lifeBinders
  | .sliceBorrowM ii jj A B x => []
  | .sliceBorrowI ii jj A B x => []
  | .sliceGetM ii jj a A => []
  | .sliceLenM ii jj a A => []
  | .sliceSplitI ii jj a A => []
  | .sliceSplitM ii jj a A => []
  | .sliceEmptyI ii jj a A => []
  | .sliceEmptyM ii jj a A => []
  | .sliceReplaceM ii jj a A => []
  | .sliceSwapM ii jj a A => []
  | .withbor1 ii jj A B x => []
  | .withbor2 ii jj A B x => []
  | .withbor3 ii jj a A B x => []
  | .withload ii jj a A B x => []
  | .withswap ii jj a A B => []
  | .withbor1U ii jj A B S x td => td.lifeBinders
  | .withbor2U ii jj A B S x td => td.lifeBinders
  | .withbor3U ii jj a A B S x td => td.lifeBinders
  | .withloadU ii jj a A B S x => []
  | .sliceBorrowMU ii jj A B S x td => td.lifeBinders
  | .sliceBorrowIU ii jj A B S x td => td.lifeBinders
  | .lolliE ii jj A B u ta tf => ta.lifeBinders ++ tf.lifeBinders
  | .allEV ii jj x b a A t => t.lifeBinders
  | .ofRet ii jj A t => t.lifeBinders
  | .roll ii jj A t => t.lifeBinders
  | .unroll ii jj A t => t.lifeBinders
  | .foldImm ii jj F y c R => []
  | .foldOwn ii jj F R => []
  | .foldReuse ii jj F R => []
  | .nuIn ii jj C t => t.lifeBinders
  | .nuOut ii jj C t => t.lifeBinders
  | .unfoldN ii jj C S => []
  | .effSub ii jj S S' A t => t.lifeBinders
  | .effPerform ii jj S o t => t.lifeBinders
  | .effRaise ii jj S o B t => t.lifeBinders
  | .effLet ii jj A B S u tM tN => tM.lifeBinders ++ tN.lifeBinders
  | .effThen ii jj A B S SM SD u tM tN tD => tM.lifeBinders ++ tN.lifeBinders ++ tD.lifeBinders
  | .effHandleV ii jj S E fs n A R u ks site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .effHandleVB ii jj S E fs n A R d u ks site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .effHandleT ii jj S SN E fs n A R u site inside tc te => tc.lifeBinders ++ te.lifeBinders
  | .letPoly ii jj C j tV tN => tV.lifeBinders ++ tN.lifeBinders
  | .lendR ii jj x b T B S td tM => [x] ++ td.lifeBinders ++ tM.lifeBinders
  | .lendLoopR ii jj x A S B R tN tK ts0 => [x] ++ [x] ++ [x] ++ tN.lifeBinders ++ tK.lifeBinders ++ ts0.lifeBinders
  | .nilDead ii jj j t => t.lifeBinders
  | .dtor .. | .allocS .. | .freeS .. | .withborSM .. | .withborSI .. | .withborF2M ..
  | .withborF2I .. => []
  | .litFn _ _ _ t | .divLit _ _ _ _ t | .walk _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t
  | .use _ _ _ _ _ _ t => t.lifeBinders

/-- **No rule of the term reads `⊓Δ` or takes a fresh variable of `Δ`**: the borrows, the block
and family borrows, and the relaxed lends are absent. -/
def TExpr.domFree : TExpr → Bool
  | .var ii jj i A => true
  | .unitI ii jj => true
  | .tensorI ii jj A B u t₁ t₂ => t₁.domFree && t₂.domFree
  | .sumI₁ ii jj A B t => t.domFree
  | .sumI₂ ii jj A B t => t.domFree
  | .thunkF ii jj A t => t.domFree
  | .thunkV ii jj C t => t.domFree
  | .ret ii jj A t => t.domFree
  | .bind ii jj A C u tM tN => tM.domFree && tN.domFree
  | .force ii jj i C => true
  | .lam ii jj A C t => t.domFree
  | .lamDead ii jj S B t => t.domFree
  | .app ii jj i A C u tM => tM.domFree
  | .withI ii jj C D tM tN => tM.domFree && tN.domFree
  | .proj₁ ii jj C D t => t.domFree
  | .proj₂ ii jj C D t => t.domFree
  | .topI ii jj => true
  | .unitE ii jj C u tV tM => tV.domFree && tM.domFree
  | .tensorE ii jj A B C u tV tM => tV.domFree && tM.domFree
  | .sumE ii jj A B C u tV t₁ t₂ => tV.domFree && t₁.domFree && t₂.domFree
  | .zeroE ii jj C u tV => tV.domFree
  | .allI ii jj x b S C t => t.domFree
  | .allE ii jj x b a C t => t.domFree
  | .bangThunkF ii jj A t => t.domFree
  | .bangThunkV ii jj C t => t.domFree
  | .bangE ii jj A t => t.domFree
  | .copyBang ii jj A => true
  | .forgetBang ii jj A => true
  | .boxI ii jj a A t => t.domFree
  | .boxE ii jj a A t => t.domFree
  | .immSub ii jj a b A t => t.domFree
  | .mutSub ii jj a b A t => t.domFree
  | .alloc ii jj A => true
  | .free ii jj A => true
  | .swap ii jj A B => true
  | .copy ii jj a A => true
  | .forgetImm ii jj a A => true
  | .forgetMut ii jj a A => true
  | .forgetUnk ii jj => true
  | .lit ii jj c => true
  | .hostOp ii jj op => true
  | .arrNew ii jj A => true
  | .arrFree ii jj A => true
  | .arrSize ii jj A => true
  | .arrReplace ii jj A => true
  | .arrLen ii jj a A => true
  | .arrGet ii jj a A => true
  | .arrCopy ii jj a A => true
  | .arrForget ii jj a A => true
  | .countFold ii jj S => true
  | .countTry ii jj S E => true
  | .boundedFix ii jj A C => true
  | .iterate ii jj S St B R => true
  | .divFuel ii jj S A => true
  | .reify ii jj S B R tres => tres.domFree
  | .sliceBorrowM ii jj A B x => false
  | .sliceBorrowI ii jj A B x => false
  | .sliceGetM ii jj a A => true
  | .sliceLenM ii jj a A => true
  | .sliceSplitI ii jj a A => true
  | .sliceSplitM ii jj a A => true
  | .sliceEmptyI ii jj a A => true
  | .sliceEmptyM ii jj a A => true
  | .sliceReplaceM ii jj a A => true
  | .sliceSwapM ii jj a A => true
  | .withbor1 ii jj A B x => false
  | .withbor2 ii jj A B x => false
  | .withbor3 ii jj a A B x => false
  | .withload ii jj a A B x => false
  | .withswap ii jj a A B => true
  | .withbor1U ii jj A B S x td => false
  | .withbor2U ii jj A B S x td => false
  | .withbor3U ii jj a A B S x td => false
  | .withloadU ii jj a A B S x => false
  | .sliceBorrowMU ii jj A B S x td => false
  | .sliceBorrowIU ii jj A B S x td => false
  | .lolliE ii jj A B u ta tf => ta.domFree && tf.domFree
  | .allEV ii jj x b a A t => t.domFree
  | .ofRet ii jj A t => t.domFree
  | .roll ii jj A t => t.domFree
  | .unroll ii jj A t => t.domFree
  | .foldImm ii jj F y c R => true
  | .foldOwn ii jj F R => true
  | .foldReuse ii jj F R => true
  | .nuIn ii jj C t => t.domFree
  | .nuOut ii jj C t => t.domFree
  | .unfoldN ii jj C S => true
  | .effSub ii jj S S' A t => t.domFree
  | .effPerform ii jj S o t => t.domFree
  | .effRaise ii jj S o B t => t.domFree
  | .effLet ii jj A B S u tM tN => tM.domFree && tN.domFree
  | .effThen ii jj A B S SM SD u tM tN tD => tM.domFree && tN.domFree && tD.domFree
  | .effHandleV ii jj S E fs n A R u ks site inside tc te => tc.domFree && te.domFree
  | .effHandleVB ii jj S E fs n A R d u ks site inside tc te => tc.domFree && te.domFree
  | .effHandleT ii jj S SN E fs n A R u site inside tc te => tc.domFree && te.domFree
  | .letPoly ii jj C j tV tN => tV.domFree && tN.domFree
  | .lendR ii jj x b T B S td tM => false
  | .lendLoopR ii jj x A S B R tN tK ts0 => false
  | .nilDead ii jj j t => t.domFree
  | .dtor .. | .allocS .. | .freeS .. => true
  | .withborSM .. | .withborSI .. | .withborF2M .. | .withborF2I .. => false
  | .litFn _ _ _ t | .divLit _ _ _ _ t | .walk _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t
  | .use _ _ _ _ _ _ t => t.domFree

/-- **The term at a larger lifetime context `D`**: each `use` node's absorption at its context. -/
def TExpr.reAb (Δr : LifeCtx) : TExpr → TExpr
  | .var ii jj i A => .var ii jj i A
  | .unitI ii jj => .unitI ii jj
  | .tensorI ii jj A B u t₁ t₂ => .tensorI ii jj A B u (t₁.reAb Δr) (t₂.reAb Δr)
  | .sumI₁ ii jj A B t => .sumI₁ ii jj A B (t.reAb Δr)
  | .sumI₂ ii jj A B t => .sumI₂ ii jj A B (t.reAb Δr)
  | .thunkF ii jj A t => .thunkF ii jj A (t.reAb Δr)
  | .thunkV ii jj C t => .thunkV ii jj C (t.reAb Δr)
  | .ret ii jj A t => .ret ii jj A (t.reAb Δr)
  | .bind ii jj A C u tM tN => .bind ii jj A C u (tM.reAb Δr) (tN.reAb Δr)
  | .force ii jj i C => .force ii jj i C
  | .lam ii jj A C t => .lam ii jj A C (t.reAb Δr)
  | .lamDead ii jj S B t => .lamDead ii jj S B (t.reAb Δr)
  | .app ii jj i A C u tM => .app ii jj i A C u (tM.reAb Δr)
  | .withI ii jj C D tM tN => .withI ii jj C D (tM.reAb Δr) (tN.reAb Δr)
  | .proj₁ ii jj C D t => .proj₁ ii jj C D (t.reAb Δr)
  | .proj₂ ii jj C D t => .proj₂ ii jj C D (t.reAb Δr)
  | .topI ii jj => .topI ii jj
  | .unitE ii jj C u tV tM => .unitE ii jj C u (tV.reAb Δr) (tM.reAb Δr)
  | .tensorE ii jj A B C u tV tM => .tensorE ii jj A B C u (tV.reAb Δr) (tM.reAb Δr)
  | .sumE ii jj A B C u tV t₁ t₂ => .sumE ii jj A B C u (tV.reAb Δr) (t₁.reAb Δr) (t₂.reAb Δr)
  | .zeroE ii jj C u tV => .zeroE ii jj C u (tV.reAb Δr)
  | .allI ii jj x b S C t => .allI ii jj x b S C (t.reAb (Δr.extend x b))
  | .allE ii jj x b a C t => .allE ii jj x b a C (t.reAb Δr)
  | .bangThunkF ii jj A t => .bangThunkF ii jj A (t.reAb Δr)
  | .bangThunkV ii jj C t => .bangThunkV ii jj C (t.reAb Δr)
  | .bangE ii jj A t => .bangE ii jj A (t.reAb Δr)
  | .copyBang ii jj A => .copyBang ii jj A
  | .forgetBang ii jj A => .forgetBang ii jj A
  | .boxI ii jj a A t => .boxI ii jj a A (t.reAb Δr)
  | .boxE ii jj a A t => .boxE ii jj a A (t.reAb Δr)
  | .immSub ii jj a b A t => .immSub ii jj a b A (t.reAb Δr)
  | .mutSub ii jj a b A t => .mutSub ii jj a b A (t.reAb Δr)
  | .alloc ii jj A => .alloc ii jj A
  | .free ii jj A => .free ii jj A
  | .swap ii jj A B => .swap ii jj A B
  | .copy ii jj a A => .copy ii jj a A
  | .forgetImm ii jj a A => .forgetImm ii jj a A
  | .forgetMut ii jj a A => .forgetMut ii jj a A
  | .forgetUnk ii jj => .forgetUnk ii jj
  | .lit ii jj c => .lit ii jj c
  | .hostOp ii jj op => .hostOp ii jj op
  | .arrNew ii jj A => .arrNew ii jj A
  | .arrFree ii jj A => .arrFree ii jj A
  | .arrSize ii jj A => .arrSize ii jj A
  | .arrReplace ii jj A => .arrReplace ii jj A
  | .arrLen ii jj a A => .arrLen ii jj a A
  | .arrGet ii jj a A => .arrGet ii jj a A
  | .arrCopy ii jj a A => .arrCopy ii jj a A
