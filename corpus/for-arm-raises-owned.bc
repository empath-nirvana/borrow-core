-- SPEC §12 *Handled bodies* (#848): a `for` body is a per-iteration handler site, and the loop's
-- `mut` state is bound outside it. In `g`, one arm of a `match` raises and the other consumes the
-- state `s`; in `h`, an `if` with no annotation raises in one branch and answers `s` in the other.
-- The body is owed `s`, so the raising path consumes it before its abort.
--
-- `g(3)` pushes `0`, `1`, `2` (length 3); `g(6)` raises 3 at `i = 3`; `h(2)` pushes `0`, `1`
-- (length 2); `h(5)` raises 12 at `i = 2`. Answer: `i32[2970188]` (3, −3, 2, −12 in base 100) and
-- `live 0`: the string threaded through the loop is freed when a raise leaves it.

include text
include fail

fn g(n: i32, s: string) -> string with Fail[i32] =
  let mut s = s;
  for i in 0..n {
    let o: i32 + 1 = if i > 2 { inl i } else { inr () };
    let t: string = match o { inl x -> raise(x) | inr u -> let (t, _) = push_dec(s, i); t };
    s = t
  };
  s

fn h(n: i32, s: string) -> string with Fail[i32] =
  let mut s = s;
  for i in 0..n { let t = if i > 1 { raise(10 + i) } else { s }; let (t, _) = push_dec(t, i); s = t };
  s

fn size(r: string + i32) -> i32 = match r { inl s -> let (s, n) = len_of[u8](s); n | inr e -> 0 - e }

main -> i32 =
  let a = size(with to_result[i32, string] { g(3, string_new(1)) });
  let b = size(with to_result[i32, string] { g(6, string_new(1)) });
  let c = size(with to_result[i32, string] { h(2, string_new(1)) });
  let d = size(with to_result[i32, string] { h(5, string_new(1)) });
  ((a * 100 + b) * 100 + c) * 100 + d
