-- A `let` that shadows a `let mut` inside an arm, a `let` head, a `match` arm and a `for` body
-- (#504's broader form, found by `scripts/mut-combos.py`): the `let` is a variable of its own
-- (SPEC §41, rule R1), so what the arm or the loop hands on is the `let mut`'s value.
--
-- Answer: (i32[2], (i32[3], (i32[4], i32[6]))).
main -> i32 * (i32 * (i32 * i32)) =
  let mut a = 1;
  if a == 1 { a = 2; let a = 50; () } else { () };
  let mut b = 1;
  let t = if b == 1 { b = 3; let b = 60; b } else { 0 };
  let mut c = 1;
  let u = match (inl () : 1 + 1) { inl x -> c = 4; let c = 70; c | inr x -> 0 };
  let mut d = 0;
  for i in 0..4 { d = d + i; let d = d * 100; () };
  (a, (b, (c, d + (t + u) * 0)))
