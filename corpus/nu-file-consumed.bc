-- SPEC §12, §22 (#808): the object of `nu-file-read.bc` used once and then left: its implicit
-- consume runs its `close` (`Consumable.nu`, group 2), which frees the content cell.
--
-- Answer: i32[71]: the buffer is 3 + 4 = 7, the read answers 1, and the object's consume frees
-- the content cell (`live 0`).

type File<'c> = U (nu X. ((forall 'x < top. mut 'x i32 -o F (i32 * box 'c U X))
                        & (forall 'x < top. imm 'x i32 -o F (i32 * box 'c U X))) & F i32)

-- The state: the content and the number of reads.
fn file_open<'c>(start: i32) -> box 'c File<'c> =
  f <- return (unfold[nu X. ((forall 'x < top. mut 'x i32 -o F (i32 * box 'c U X))
                           & (forall 'x < top. imm 'x i32 -o F (i32 * box 'c U X))) & F i32,
                       ref i32 * i32]
    (!thunkv fun (s : ref i32 * i32) ->
      < < Fun 'x < top. fun (m : mut 'x i32) ->
          let (c, n) = s;
          cx <- return (swap[i32, i32] c i32[0]);
          let (c, k) = cx;
          cu <- return (swap[i32, i32] c k);
          let (c, u) = cu;
          q <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) -> return (v + k, n + 1)));
          let (m, r) = q;
          return (release_mut['x, i32] m);
          return (r, boxed['c] (c, n + 1)),
          Fun 'x < top. fun (b : imm 'x i32) ->
            let (c, n) = s;
            w <- return (*b);
            return (release_imm['x, i32] b);
            cx <- return (swap[i32, i32] c w);
            let (c, old) = cx;
            return (old, boxed['c] (c, n)) >,
        let (c, n) = s;
        return (free[i32] c + n * 0) >));
  s <- return (alloc[i32] start, 0);
  return (boxed['c] (thunkv nu_in
    < < g <- return (unbang f); (nu_out (force g s)).1 .1,
        g <- return (unbang f); (nu_out (force g s)).1 .2 >,
      g <- return (unbang f); (nu_out (force g s)).2 >))

fn file_read<'a, 'c>(f: box 'c File<'c>, b: mut 'a i32) -> i32 * box 'c File<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 .1['a] b

fn file_write<'a, 'c>(f: box 'c File<'c>, b: imm 'a i32) -> i32 * box 'c File<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 .2['a] b

fn file_close<'c>(f: box 'c File<'c>) -> i32 =
  g <- return (unbox f);
  (nu_out (force g)).2

main -> i32 =
  let buf = alloc(3);
  let f = file_open(4);
  let (r, f) = borrow mut buf { 'w, m -> file_read(f, m) };
  let b = free(buf);
  b * 10 + r
