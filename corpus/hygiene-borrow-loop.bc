-- Hygiene (#481): a borrow block whose body loops has its bindings spliced into the enclosing
-- body (LoopLend). A local of the block named as a function does not stay in scope after it:
-- `k()` after the block is the declared `k`.
--
-- Answer: i32[207]: the loop's 2, times 100, plus the declared `k`, 7.
fn k() -> i32 = 7
main -> i32 =
  let t = alloc(1);
  let r = borrow imm t { 'x, b ->
    let k: !(1 => i32) = !{ u -> 1 };
    let mut i = 0;
    while i < 2 { i = i + *b };
    i
  };
  let v = free(t);
  r * 100 + k()
