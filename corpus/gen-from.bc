-- Delegation: a generator that calls another passes on everything it yields, since the callee's
-- `yield` reaches the handler the caller's reaches (its copy is made for the same site, SPEC §18),
-- and goes on with what it returns. A call of a generator whose body loops is a call of a div
-- function in direct style: a state of the caller's machine holds its loop (SPEC §14, §15).
--
-- `both` delegates twice and returns a number built from the two results. `chained` delegates
-- inside a loop, once per element of a stored generator, and returns its last delegation's value.
--
-- Answer: i32[125032], read as `125` and `032`: `both(3, 2)` yields 0 1 2, 100, 10 11 (124) and
-- returns 32 (3 and 2 elements); `chained(3)` yields 0 (its loop's delegations to `range(0, 0)`
-- and `range(0, 1)`), then 0 1 (its last), which adds 1, and returns 2, which the `- 2` cancels.
-- A delegation that lost its callee's value gives 0 for the 32.

include yield

fn range(lo: i32, hi: i32) -> i32 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  hi - lo

fn both(a: i32, b: i32) -> i32 with Yield[i32] =
  let n = range(0, a);
  yield(100);
  let m = range(10, 10 + b);
  n * 10 + m

fn chained(n: i32) -> i32 with Yield[i32] =
  for k in range(0, n - 1) { let _ = range(0, k); () };
  range(0, n - 1)

main -> i32 =
  let mut acc = 0;
  let r = for x in both(3, 2) { acc = acc + x };
  let q = for x in chained(3) { acc = acc + x };
  acc * 1000 + r + q - 2
