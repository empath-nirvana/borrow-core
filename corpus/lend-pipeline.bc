-- A borrow block over a pipeline (SPEC §14, borrow scopes over loops): a table borrowed once, and
-- read by every step of a `for` over a pipeline of generators, `above(20, squares(range(1, 11)))`.
--
-- The pipeline owns its state, and the body of the `for` reads the table through the borrow. The
-- block is lent per observation: the table's cell moves into the loop's state, and each step of
-- the `for` borrows it for that step. Each generator is one `unfold` whose observations are calls
-- of known code (`gen-pipeline.bc`), so the pipeline adds no allocation, no dispatched call and no
-- copy to the table's own: `corpus/counts.expected` has 2 allocations (the array and its cell),
-- 0 and 0.
--
-- Answer: i32[361]: the table holds i + 1, and the squares above 20 from 1 to 10 are 25, 36, 49,
-- 64, 81, 100, so the sum is 355 + 6. A filter that kept everything gives 395; a body that read
-- the table at the element before squaring gives 51.

include yield

fn tab(i: i32) -> i32 = i + 1

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn squares(it: U (pull i32 1 1)) -> 1 with Yield[i32] =
  for x in it { yield(x * x) };
  ()

fn above(n: i32, it: U (pull i32 1 1)) -> 1 with Yield[i32] =
  for x in it { if n < x { yield(x) } else { () } };
  ()

main -> i32 =
  let t = alloc(array_new[i32] (101, tab));
  let n = borrow imm t { b ->
    let mut acc = 0;
    for x in above(20, squares(range(1, 11))) { acc = acc + get(b, x) };
    acc
  };
  n
