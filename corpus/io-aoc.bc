-- The sum of the numbers on the input's lines, in the style of Advent of Code's day 1 (SPEC §11,
-- §9). Every line goes into one buffer, an array of 16 slots allocated once and kept in a cell:
-- `push` and `parse` each borrow the cell mutably (`withbor2`) and work on the array through
-- `withswap`. The loop threads the cell, the line's length and the sum; the cell and the buffer
-- are freed implicitly at the end.
--
-- Answer: `5496`, the sum of 1721, 979, 366, 299, 675 and 1456. A line lost or read twice, a
-- digit read from a stale slot, or a buffer not reset between lines gives another number.

type A = array i32
type Buf = ref A

def zero : !(i32 => i32) = !thunkv fun (i : i32) -> return i32[0]
def inc : i32 => i32 = thunkv fun (n : i32) -> return ((unbang host[add32]) (n, i32[1]))

-- The byte `b` into slot `k` of the buffer; past its 16 slots `array_replace` takes its error
-- branch and the byte is dropped.
def push : Buf * (i32 * i32) => Buf * 1 =
  thunkv fun (p : Buf * (i32 * i32)) ->
    let (c, r) = p;
    let (k, b) = r;
    return (withbor2['x, top, A, 1] c
      (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x A) ->
         s <- return (withswap['x, A, 1] m (thunkv fun (a : A) ->
           q <- return ((unbang array_replace[i32]) (a, (k, b)));
           let (a2, old) = q;
           return (a2, ())));
         let (m2, u) = s;
         return (boxed['x] u))))

-- Parsing the buffer: (buffer, (index, (length, value))). Each digit is read by taking it out
-- of its slot and putting it back.
type PS = A * (i32 * (i32 * i32))

def parse_step : !(PS => PS) =
  !thunkv fun (s : PS) ->
    let (a, r) = s;
    let (k, r2) = r;
    let (n, v) = r2;
    case (unbang host[lt_u32]) (k, n) {
      inl done -> return (a, (k, (n, v)))
    | inr more ->
        q <- return ((unbang array_replace[i32]) (a, (k, i32[0])));
        let (a2, o) = q;
        case o {
          inl d ->
            q2 <- return ((unbang array_replace[i32]) (a2, (k, d)));
            let (a3, o2) = q2;
            v2 <- return ((unbang host[add32]) ((unbang host[mul32]) (v, i32[10]),
                                                  (unbang host[sub32]) (d, i32[48])));
            return (a3, (inc k, (n, v2)))
        | inr d -> return (a2, (inc k, (n, v)))
        }
    }

def parse_twice : !(PS => PS) => !(PS => PS) =
  thunkv fun (f : !(PS => PS)) -> return (!thunkv fun (s : PS) -> return ((unbang f) ((unbang f) s)))

-- The number in the first `n` slots of the buffer (at most its 16).
def parse : Buf * i32 => Buf * i32 =
  thunkv fun (p : Buf * i32) ->
    let (c, n) = p;
    return (withbor2['x, top, A, i32] c
      (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x A) ->
         s <- return (withswap['x, A, i32] m (thunkv fun (a : A) ->
           t <- return ((unbang (parse_twice (parse_twice (parse_twice (parse_twice parse_step)))))
                          (a, (i32[0], (n, i32[0]))));
           let (a2, r) = t;
           let (k, r2) = r;
           let (n2, v) = r2;
           return (a2, v)));
         let (m2, v) = s;
         return (boxed['x] v))))

main : F i32 =
  buf : Buf <- return (alloc[A] ((unbang array_new[i32]) (i32[16], zero)));
  len : i32 <- return i32[0];
  sum : i32 <- return i32[0];
  for b in bytes stdin {
    case (unbang host[eq32]) ((unbang host[extend8_u]) b, i32[10]) {
      inl digit ->
        _ <- return (push (&mut buf, (len, (unbang host[extend8_u]) b)));
        len : i32 <- return (inc len);
        return ()
    | inr newline ->
        x <- return (parse (&mut buf, len));
        sum : i32 <- return ((unbang host[add32]) (sum, x));
        len : i32 <- return i32[0];
        return ()
    }
  };
  x <- return (parse (&mut buf, len));
  sum : i32 <- return ((unbang host[add32]) (sum, x));
  _ <- return (put_dec (&mut stdout, sum));
  _ <- return (putb (&mut stdout, u8[10]));
  return sum
