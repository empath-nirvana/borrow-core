-- A `def` whose type the program writes with `dom`, used at the empty lifetime context and under
-- a borrow's `Fun 'x` (#684 review, F1): its two instances' types are `imm top i32 => …` and
-- `imm ('x /\ top) i32 => …`. The rewriter's read-back keys each instance by its lifetime context,
-- and declares the second polymorphic in it (SPEC §54, step 0).
--
-- Answer: i32[5].

def k : !(imm dom i32 => imm dom i32) = !thunkv fun (x : imm dom i32) -> return x

main : F i32 =
  f <- return k;
  c <- return (alloc[i32] i32[5]);
  q <- return (withbor1['x, i32, i32] c (thunkv Fun 'x < dom. return (thunkv fun (b : imm 'x i32) ->
         b2 <- return ((unbang k) (b :> dom));
         r <- return (withload[dom, 'z, i32, i32] b2 (thunkv Fun 'z < dom. return (thunkv fun (v : i32) ->
                return (boxed['z] v))));
         return (boxed['x] r))));
  let (c, n) = q;
  return n
