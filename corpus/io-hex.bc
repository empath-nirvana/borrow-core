-- Hex encoding (SPEC §11): each input byte as two lower-case hex digits, then a newline.
-- `put_hex` writes to a borrowed output: its type, `all 'a < top. mut 'a output * i32 =>
-- mut 'a output`, says it needs a lent output stream and nothing else, and `hex_out` lends it
-- one for each byte.
--
-- Answer: `48656c6c6f2c20576f726c64210a` for `Hello, World!\n`. Swapped nibbles, a digit
-- offset by one, or upper-case letters give a different line.

extern stdin : ref input
extern stdout : ref output
extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (i32 + 1))
extern write_byte : !(all 'a < top. mut 'a output * i32 => mut 'a output)

type In = ref input
type Out = ref output
type B = 1 + 1

-- The next byte of an input stream, or `inr ()` at its end. It takes only an input: the
-- capability is lent to `read_byte` for the one read and handed back.
def getb : In => In * (i32 + 1) =
  thunkv fun (c : In) ->
    return (withbor2['x, top, input, i32 + 1] c
      (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x input) ->
         r <- return ((unbang read_byte) ['x] m);
         let (m2, b) = r;
         return (boxed['x] b))))

-- Write one byte. It takes only an output.
def putb : Out * i32 => Out =
  thunkv fun (p : Out * i32) ->
    let (c, b) = p;
    q <- return (withbor2['x, top, output, 1] c
      (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x output) ->
         m2 <- return ((unbang write_byte) ['x] (m, b));
         return (boxed['x] ()))));
    let (c2, u) = q;
    return c2

-- A hex digit: 0-9 as `0`-`9`, 10-15 as `a`-`f`.
def hexd : i32 => i32 =
  thunkv fun (n : i32) ->
    case (unbang host[lt_u32]) (n, i32[10]) {
      inl u -> return ((unbang host[add32]) (n, i32[87]))
    | inr u -> return ((unbang host[add32]) (n, i32[48]))
    }

-- A byte as two hex digits, to a borrowed output: it takes only `mut 'a output`, and hands
-- the borrow back.
def put_hex : all 'a < top. mut 'a output * i32 => mut 'a output =
  thunkv Fun 'a < top. return (thunkv fun (p : mut 'a output * i32) ->
    let (m, b) = p;
    m1 <- return ((unbang write_byte) ['a] (m, hexd ((unbang host[shr_u32]) (b, i32[4]))));
    return ((unbang write_byte) ['a] (m1, hexd ((unbang host[and32]) (b, i32[15])))))

-- The output is lent to `put_hex` for one byte.
def hex_out : Out * i32 => Out =
  thunkv fun (p : Out * i32) ->
    let (c, b) = p;
    q <- return (withbor2['x, top, output, 1] c
      (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x output) ->
         m2 <- return (put_hex ['x] (m, b));
         return (boxed['x] ()))));
    let (c2, u) = q;
    return c2

type S = In * (Out * B)

-- Each byte read is written as two hex digits; at the end of the input, a newline.
def step : !(S => S) =
  !thunkv fun (s : S) ->
    let (i, r) = s;
    let (o, d) = r;
    case d {
      inl u ->
        q <- return (getb i);
        let (i2, x) = q;
        case x {
          inl b -> return (i2, (hex_out (o, b), (inl () : B)))
        | inr u2 -> return (i2, (putb (o, i32[10]), (inr () : B)))
        }
    | inr u -> return (i, (o, (inr () : B)))
    }

def twice : !(S => S) => !(S => S) =
  thunkv fun (f : !(S => S)) -> return (!thunkv fun (s : S) -> return ((unbang f) ((unbang f) s)))

-- 2^10 steps: an input of up to 1023 bytes.
main : F ((In * Out) * 1) =
  f <- return (twice (twice (twice (twice (twice (twice (twice (twice (twice (twice step))))))))));
  s <- return ((unbang f) (stdin, (stdout, (inl () : B))));
  let (i, r) = s;
  let (o, d) = r;
  return ((i, o), ())
