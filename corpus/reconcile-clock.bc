-- The reconciler chain of `corpus/reconcile-chain.bc`, `step() |> timeout |> retry(3, 10) |>
-- logged`, on the system interface's `Clock` (SPEC §34): run once with the platform's clock, a
-- real one, and once with a fake clock swapped in by a handler alone. Nothing else differs between
-- the two runs: `reconcile_both` is one function, given `Clock` by its row.
--
-- * The step notes its request in the journal (`Audit`) and waits on the service for `ms`
--   (`Wait`), then answers 200.
-- * `timeout` takes a computation that provides `Wait`: its handler `deadline` resumes a wait of at
--   most 50 ms, and cancels the computation at a longer one and raises 408.
-- * `retry` takes a computation that provides `Fail[i32]`: it runs it under its own `to_result`,
--   and after a failure sleeps on the clock (`base`, then twice as long) and runs it again, up to
--   `times` attempts, raising the last error.
-- * `logged` notes 9 for a value and 4 for an error.
-- * `reconcile_both` reads the clock before and after each chain: the time it took.
--
-- `fake_clock` is lawful by construction (SPEC §34 *Laws*): `now()` answers its time in
-- nanoseconds, and `sleep(ns)` adds `max(ns, 0)` to it, so its time is monotone and a sleep waits exactly what it
-- asks. The platform's clock waits at least that. So the fake clock's times are exact, and the
-- real clock's are compared with them: at least as long.
--
-- Simplified, as `reconcile-chain` is, around #487: the step does not read the clock, since a
-- capability cannot be used by a computation called under `retry`'s handler.
--
-- Answer: `(((inr i32[408], inr ()), [80, 80, 80, 4]), ((inl i32[200], inr ()), [20, 9]))` from
-- the real clock (the stuck service took at least the 30 ms of `retry`'s two backoffs, the
-- healthy one at least 0), and `(((inr i32[408], i64[30000000]), [80, 80, 80, 4]), ((inl
-- i32[200], i64[0]), [20, 9]))` from the fake one, its times in nanoseconds, the lists as
-- `inr (x, …)`.

include fail
include list
include io

effect Audit { ctl note(x: i32) }
handler journal[A]: Audit, A -> A * List[i32] = {
  return(a) = (a, nil());
  note(x, k) = { let (a, l) = k(()); (a, cons(x, l)) }
}

effect Wait { ctl wait(ms: i32) }

fn reconcile(ms: i32) -> i32 with Audit, Wait =
  note(ms);
  wait(ms);
  200

handler deadline[A]: Wait, A -> A with Fail[i32] = {
  return(a) = a;
  wait(ms, k) = if ms > 50 { u <- (force k).2; raise(408) } else { k(()) }
}

fn timeout[A](m: !(1 => A with Wait)) -> A with Fail[i32] = with deadline { m(()) }

-- The chain's own wait on the clock: a control operation, served by `on_clock` around the chain.
effect Pause { ctl pause(ms: i32) }

handler on_clock[A]: Pause, A -> A = {
  return(a) = a;
  pause(ms, k) = { sleep(ns_of_ms(ms)); k(()) }
}

fn retry[A](m: !(1 => A with Fail[i32]), times: i32, base: i32) -> A with Fail[i32], Pause =
  let mut wait_ms = base;
  let mut last = 0;
  let r = for attempt in 0..times {
    match with to_result { m(()) } {
      inl a -> break (inl a : A + 1)
    | inr e -> last = e; if attempt + 1 < times { pause(wait_ms); wait_ms = wait_ms * 2 } else { () }
    }
  } else { (inr () : A + 1) };
  match r { inl a -> a | inr u -> raise(last) }

handler logged[A]: Fail[i32], A -> A + i32 with Audit = {
  return(a) = { note(9); inl a };
  raise(e) = { note(4); inr e }
}

-- A fake clock: its time, advanced only by a sleep.
handler fake_clock(mut t: i64): Clock = {
  now() = t;
  sleep(ns) = { if ns > 0 { t = t + ns } else { () } }
}

fn stuck() -> i32 with Audit, Wait = reconcile(80)
fn healthy() -> i32 with Audit, Wait = reconcile(20)

type Run = ((i32 + i32) * i64) * List[i32]

-- The chain on a stuck service and on a healthy one, each with the time it took on the clock.
fn reconcile_both() -> Run * Run =
  let t0 = now();
  let (a, la) = with on_clock { with journal { stuck() |> timeout |> retry(3, 10) |> logged } };
  let t1 = now();
  let (b, lb) = with on_clock { with journal { healthy() |> timeout |> retry(3, 10) |> logged } };
  let t2 = now();
  (((a, t1 - t0), la), ((b, t2 - t1), lb))

type Seen = ((i32 + i32) * bool) * List[i32]

-- A run on the real clock, its times compared with the least the laws allow.
fn at_least(r: Run, ms: i32) -> Seen = let ((v, t), l) = r; ((v, t >= ns_of_ms(ms)), l)

main -> (Seen * Seen) * (Run * Run) =
  let (a, b) = reconcile_both();
  let real = (at_least(a, 30), at_least(b, 0));
  let origin : i64 = 0;
  let c = alloc(origin);
  let fake = with fake_clock(&mut c) { reconcile_both() };
  let _ = free(c);
  (real, fake)
