#! dialect 82
# [spec §80] A local remains a frame slot across a branch; both arms update the same cell.
main : F (i32 * i32) =
  q <- return (withlocal['l, top, i32, i32] i32[0]
    (thunkv Fun 'l < dom. return (thunkv fun (m : mut 'l i32) ->
      p <- case (unbang host[eq32]) (i32[0], i32[0]) {
        inl u -> let () = u;
          return (withswap['l, i32, i32] m (thunkv fun (v : i32) -> return (i32[3], v)))
      | inr u -> let () = u;
          return (withswap['l, i32, i32] m (thunkv fun (v : i32) -> return (i32[7], v)))
      };
      let (m, old) = p;
      let () = release_mut['l, i32] m;
      return (boxed['l] old))));
  return q
