-- SPEC §27 in the core text, checked, not run: `main` returns `()` and does not call `f`: `M` calls
-- a parameter whose row gives `1.0` the cancel row `[3.0]`; the finaliser performs the capturable
-- `4.0`. `Σ_M` reads the call's type: `1.0⟨[3.0]⟩, 3.0`, so `ThenLe [3.0] [4.0] (S's)` holds.

def f : !U (!U (1 -o F[1.0 unr[3.0 cancel 1 ~> 0] 1 ~> 1, 3.0 cancel 1 ~> 0] 1) -o 1 -o F[4.0 unr[3.0 cancel 1 ~> 0] 1 ~> 1, 3.0 cancel 1 ~> 0, 1.0 unr[3.0 cancel 1 ~> 0, 4.0 unr[3.0 cancel 1 ~> 0] 1 ~> 1] 1 ~> 1] 1) =
  !thunkv fun (gb : !U (1 -o F[1.0 unr[3.0 cancel 1 ~> 0] 1 ~> 1, 3.0 cancel 1 ~> 0] 1)) -> fun (u : 1) ->
    x <- (h <- return (unbang gb); force h u) unwind (perform[4.0] ()); return x

main : F 1 = return ()
