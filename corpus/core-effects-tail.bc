-- SPEC §19 in the core text: a control operation `2.0 lin 1 ~> i32` (an `ask` of an `i32`), its
-- handler's clause resuming `k` once, in tail position, with `10`. `twice` asks twice and adds the
-- answers; it is a function at the row of the operation, and its binds are `[let]` (the row has
-- no weakening).
--
-- Answer: i32[20].

def plus : i32 * i32 => i32 = unbang host[add32]

def twice : !U (1 -o F[2.0 lin 1 ~> i32] i32) =
  !thunkv fun (u : 1) ->
    a <- perform[2.0] u;
    b <- perform[2.0] ();
    return (plus (a, b))

main : F i32 =
  f <- return (unbang twice);
  u <- return ();
  handle_with[2](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (p : 1 * U ((i32 -o F i32) & top)) ->
        let (u, k) = p;
        let () = u;
        x <- return i32[10];
        (force k).1 x), ()) : !U (1 * U ((i32 -o F i32) & top) -o F i32) * 1)) (force f u)
