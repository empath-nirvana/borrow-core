-- `break` and `continue` in the continuation of an `unwind` inside a loop's body (#1053): the
-- continuation `N` of `x <- M unwind (D); N` is on the loop body's spine, so an exit in it is a
-- terminal of the turn, and the writes before it are handed on. `go` adds 1, 2, 3 to `t` and
-- breaks at 3: `t * 100 + i` is 603; `skip` adds the odd `i` up to 5 and continues past the even:
-- `s` is 1 + 3 + 5.
fn go() -> i32 =
  let mut i = 0;
  let mut t = 0;
  while true { i = i + 1; x <- (i + 0) unwind (()); t = t + x; if i == 3 { break } else { () } };
  t * 100 + i

fn skip() -> i32 =
  let mut i = 0;
  let mut s = 0;
  loop {
    i = i + 1;
    x <- (i + 0) unwind (());
    if i > 5 { break } else { () };
    if i == 2 || i == 4 { continue } else { () };
    s = s + x
  };
  s

main -> i32 * i32 = (go(), skip())
