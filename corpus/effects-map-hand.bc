-- `corpus/effects-map.bc` written by hand in capability-passing style, with no effect: each
-- handler's operations are functions over a `mut` borrow of its state, run by `modify`
-- (`withswap`), and the client is written once per handler, taking the borrow first and handing it
-- back. It is what the elaboration of the effect program produces (SPEC §18), so the two have the
-- same value and the same counts (`corpus/counts.expected`).
--
-- Answer: as `corpus/effects-map.bc`'s.

include buf
include slice

type Assoc = buf (i32 * i32)

fn assoc_find<'a>(v: array_imm 'a (i32 * i32), k: i32) -> i32 + 1 =
  let mut r = 0 - 1;
  for p in v { let (kk, x) = *p; if kk == k { r = x } else { () } };
  if r < 0 { inr () } else { inl r }

fn assoc_lookup<'h>(m: mut 'h Assoc, k: i32) -> mut 'h Assoc * (i32 + 1) =
  let r = modify m { s -> let x: i32 + 1 = borrow imm s { v -> assoc_find(v, k) }; (s, x) };
  (m, r)

fn assoc_insert<'h>(m: mut 'h Assoc, k: i32, v: i32) -> mut 'h Assoc * 1 =
  modify m { s -> let e = (k, v); push(&mut s, e); s };
  (m, ())

fn table_lookup<'h>(m: mut 'h (array i32), k: i32) -> mut 'h (array i32) * (i32 + 1) =
  let r = modify m { t ->
    let x = borrow imm t { v -> at(v, k, 0) };
    let y: i32 + 1 = if x == 0 { inr () } else { inl x };
    (t, y) };
  (m, r)

fn table_insert<'h>(m: mut 'h (array i32), k: i32, v: i32) -> mut 'h (array i32) * 1 =
  modify m { t -> let (t, _) = array_replace[i32](t, k, v); t };
  (m, ())

fn census_assoc<'h, 'a>(m: mut 'h Assoc, xs: array_imm 'a i32) -> mut 'h Assoc * (i32 * (i32 * i32)) =
  let mut repeats = 0;
  for p in xs {
    let x = *p;
    let (m, f): mut 'h Assoc * (i32 + 1) = assoc_lookup(m, x);
    let n = match f { inl c -> c | inr u -> 0 };
    repeats = repeats + n;
    let (m, u): mut 'h Assoc * 1 = assoc_insert(m, x, n + 1);
    u
  };
  let (m, f0): mut 'h Assoc * (i32 + 1) = assoc_lookup(m, 0);
  let c0 = match f0 { inl c -> c | inr u -> 0 };
  let (m, f3): mut 'h Assoc * (i32 + 1) = assoc_lookup(m, 3);
  let c3 = match f3 { inl c -> c | inr u -> 0 };
  (m, (repeats, (c0, c3)))

fn census_table<'h, 'a>(m: mut 'h (array i32), xs: array_imm 'a i32) -> mut 'h (array i32) * (i32 * (i32 * i32)) =
  let mut repeats = 0;
  for p in xs {
    let x = *p;
    let (m, f): mut 'h (array i32) * (i32 + 1) = table_lookup(m, x);
    let n = match f { inl c -> c | inr u -> 0 };
    repeats = repeats + n;
    let (m, u): mut 'h (array i32) * 1 = table_insert(m, x, n + 1);
    u
  };
  let (m, f0): mut 'h (array i32) * (i32 + 1) = table_lookup(m, 0);
  let c0 = match f0 { inl c -> c | inr u -> 0 };
  let (m, f3): mut 'h (array i32) * (i32 + 1) = table_lookup(m, 3);
  let c3 = match f3 { inl c -> c | inr u -> 0 };
  (m, (repeats, (c0, c3)))

fn data(i: i32) -> i32 = host[and32](i * 7, 7)

main -> (i32 * (i32 * i32)) * ((i32 * (i32 * i32)) * ((i32 * (i32 * i32)) * i32)) =
  let a = array_new[i32] (12, data);
  let r1 = borrow imm a { v ->
    let (s, r) = borrow mut (alloc(box buf[i32 * i32](4))) { 'x, m ->
      let (m, r): mut 'x Assoc * (i32 * (i32 * i32)) = census_assoc(m, v); r };
    r };
  let r2 = borrow imm a { v ->
    let (s, r) = borrow mut (alloc(array_new[i32] (8, !{ i -> 0 }))) { 'x, m ->
      let (m, r): mut 'x (array i32) * (i32 * (i32 * i32)) = census_table(m, v); r };
    r };
  let c = alloc(box buf[i32 * i32](4));
  let r3 = borrow mut c { 'x, m ->
    let r = borrow imm a { v -> let (m, r): mut 'x Assoc * (i32 * (i32 * i32)) = census_assoc(m, v); r };
    r };
  let (b, n) = free(c);
  array_free[i32 * i32](!{ x -> () }, b);
  (r1, (r2, (r3, n)))
