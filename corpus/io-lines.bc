-- A div helper that returns to `main` (SPEC §14). `count_lines` loops over its input to the end
-- and hands the capability back with the count; `main` then writes the count. Nothing is marked:
-- `count_lines` has a `for`, so it is div, and `main` calls it, so `main` is too. The call is
-- direct style: `main` continues when the loop finishes.
--
-- Answer: `4` and the result `i32[4]`, the four newlines of the input.

def count_lines : In => In * i32 =
  thunkv fun (c : In) ->
    n : i32 <- return i32[0];
    for b in bytes c {
      n : i32 <- case (unbang host[eq32]) (b, i32[10]) {
        inl u -> return n
      | inr u -> return ((unbang host[add32]) (n, i32[1]))
      };
      return ()
    };
    return (c, n)

main : F i32 =
  n <- return (count_lines (&stdin));
  _ <- return (put_dec (&stdout, n));
  _ <- return (putb (&stdout, i32[10]));
  return n
