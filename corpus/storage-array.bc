-- AWFY Storage: a tree of arrays built recursively (depth 7, four children a level, a leaf an
-- array of 1..10 elements sized by AWFY's Random); counts the arrays made, 5461.
-- A node owns an array of its children: `mu X. array i32 + array X`, `X` under `array` in the fold
-- class `P` (SPEC §6). The tree is dropped by its derived destructor (SPEC §12): each node's
-- children, then its array's buffer, at once. 5461 allocations, Rust's count for the same tree
-- (`docs/expressiveness-probes/zero-cost/awfybg/rs/src/bin/storage.rs`).
--
-- Answer: i32[5461]; `live 0`.
include rec
include buf
include slice

type S = mu X. array i32 + array X

fn next(seed: i32) -> i32 = host[and32](seed * 1309 + 13849, 65535)

fn build(depth: i32, seed: i32, count: i32) -> (S * i32) * i32 with Exhausted =
  let count = count + 1;
  if depth == 1 {
    let s = next(seed);
    ((roll inl array_new[i32](s % 10 + 1, !{ i -> 0 }), s), count)
  } else {
    let mut kids = array_new[S](4, !{ i -> roll inl array_new[i32](0, !{ j -> 0 }) });
    let mut seed = seed;
    let mut count = count;
    for i in 0..4 {
      let ((k, s), c) = build(depth - 1, seed, count);
      let (kids1, old) = array_replace[S](kids, i, k);
      kids = kids1;
      seed = s;
      count = c
    };
    ((roll inr kids, seed), count)
  }

main -> i32 = with on_exhausted(!{ u -> 0 - 1 }) {
  let ((t, s), c) = build(7, 74755, 0);
  c
}
