def e_hc : !U (i32 -o F[6.0 lin i32 ~> 1] ((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) * 1 =
  (!thunkv fun (e : i32) -> return (inl (inr e)), ())
def t_hr : !U (((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) -o F (((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) * (i32 * i32))) = !thunkv fun (v : ((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) -> return (v, (i32[0], i32[1]))
def t_hc : !U (i32 * U ((1 -o F (((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) * (i32 * i32))) & top) -o F (((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) * (i32 * i32))) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F (((i32 + i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) * (i32 * i32))) & top)) ->
     let (d, k) = p;
     u <- return ();
     r <- (force k).1 u;
     let (v, tp) = r; let (t, w) = tp;
     return (v, (plus (mul (d, w), t), mul (w, i32[10]))), ())
def c4_hr : !U (1 -o F[6.0 lin i32 ~> 1] 1) = !thunkv fun (v : 1) -> return v
def c4_hc : !U (i32 -o F[6.0 lin i32 ~> 1] 1) * 1 = (!thunkv fun (e : i32) -> return (), ())
def c6_hr : !U (1 -o F 1) = !thunkv fun (v : 1) -> return v
def c6_hc : !U (i32 * U ((1 -o F 1) & top) -o F 1) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F 1) & top)) -> let (d, k) = p; u <- return (); (force k).1 u, ())

def outer_step : !U (U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) * i32 -o F (((i32 + i32) * i32) + U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) * i32) & F 1) =
  !thunkv fun (s : U (nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) * i32) ->
    < let (g, t) = s;
      o <- handle_with[6](t_hr, t_hc) (handle_with[4](e_hr, e_hc) ((nu_out (force g)).1));
      let (res, tp) = o; let (td, w) = tp;
      t2 <- return (plus (mul (t, w), td));
      case res {
        inl done -> return (inl (done, t2))
      | inr g2 -> return (inr (g2, t2))
      },
      let (g, t) = s;
      handle_with[6](c6_hr, c6_hc) (handle_with[4](c4_hr, c4_hc) ((nu_out (force g)).2)) >

main : F (U (nu W. F (((i32 + i32) * i32) + U W) & F 1)) =
  sl <- return (unbang src_loop);
  u0 <- return ();
  l0 <- force sl u0;
  cl <- return (unbang cons_loop);
  u1 <- return ();
  l1 <- force cl u1;
