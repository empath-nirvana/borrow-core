-- check: old-backend-refuses
-- Pipes L1 (#920), first check, program 2: a raise inside the consumer. The source yields 1..5;
-- its turn's cleanup (an `unwind` frame around its `yield`) traces 1. The consumer owns a cell,
-- reads two items (1, 2) and raises 7 + 1 + 2 = 10 (site 4); its cleanup frees the cell and traces 2. The trace is the
-- must-resume operation 6.0, handled outside the connector with the raise, per observation of the
-- connector's loop; it records the digits in the order performed.
-- Answer: (inr i32[10], i32[21]): the consumer's cleanup, then the source's (downstream first),
-- and `live 0`.
--
-- The connector is written as Assembly(n)'s pieces (theory, `assembly-n.md` §1), each over one
-- stage's or one wire's types, plus the glue: the state tuple and a dispatching loop (one
-- `unfold`). Stage 0 is the source (a loop value performing `yield`, site 1); stage 1 the consumer
-- (a loop of one turn performing `Stream`'s `next` 2.0 and `stop` 2.1). Each `step_i` runs inside
-- the per-step finaliser `close_others_i`, one cancel region (`core-pipe-close`'s form, site 5)
-- with one `withStop_j` frame per other stage, innermost the most downstream.
--
-- State_0 = Ready(L) | AtYield(Q) | Ended                     = U L + (U Q + 1)
-- Event_0 = Yield(i32, Q) | Return(1) | Skip(L)               = i32 * U Q + (1 + U L)
-- State_1 = Ready(L1) | AtNext(KD) | AtStop(KD)               = U L1 + (U KD + U KD)
-- Event_1 = Return(R) | Skip(L1) | Next(KD) | Stop(KD)        = (R + U L1) + (U KD + U KD)
-- Input_1 = i32 + 1. The glue's turn: inl () runs stage 0, inr inp runs stage 1 with inp.

def plus : i32 * i32 => i32 = unbang host[add32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]

-- ---- Stage 0, the source ----------------------------------------------------------------------

def src_turn : !U (i32 -o F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + i32) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) =
  !thunkv fun (i : i32) ->
    < c <- return (lt (i32[5], i));
      case c {
        inl le -> u <- perform[1.0] i unwind (t <- perform[6.0] i32[1]; return ());
          return (inr (plus (i, i32[1])))
      | inr gt -> return (inl ())
      },
      return () >

def src_loop : !U (1 -o F (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) =
  !thunkv fun (u : 1) ->
    f <- return (unbang (unfold[nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1, i32] src_turn));
    s <- return i32[1];
    return (thunkv nu_in < (nu_out (force f s)).1, (nu_out (force f s)).2 >)

-- The wire site 1's storing clause: the item and the rest (Q).
def pull_hr : !U (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)))) =
  !thunkv fun (v : 1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) -> return (inr v)
def pull_hc : !U (i32 * U ((1 -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)))) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) ->
     let (x, k) = p;
     return (inl (x, thunkv nu_in < u <- return (); (force k).1 u, (force k).2 >)), ())
def close_hr : !U (1 -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) = !thunkv fun (v : 1) -> return v
def close_hc : !U (i32 * U ((1 -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) -> let (x, k) = p; u <- return (); (force k).1 u, ())

-- step_0 : State_0 * Input_0 -o F Event_0
def step_0 : !U ((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1)) * 1 -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)))) =
  !thunkv fun (p : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1)) * 1) ->
    let (s, u) = p; let () = u;
    case s {
      inl l -> handle_with[1](pull_hr, pull_hc) ((nu_out (force l)).1)
    | inr r -> case r {
        inl q -> (nu_out (force q)).1
      | inr e -> return (inr (inl e) : (i32 * U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))))
      }
    }

-- stop_0 : State_0 -o F 1
def stop_0 : !U ((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1)) -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) =
  !thunkv fun (s : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1))) ->
    case s {
      inl l -> handle_with[1](close_hr, close_hc) ((nu_out (force l)).2)
    | inr r -> case r {
        inl q -> (nu_out (force q)).2
      | inr e -> return e
      }
    }

-- withStop_0 : State_0 * U (1 -o F R) -o F R, at R = 1 and the region's row: one frame. (§1 has
-- U (F_Σ R); core text builds no thunk of an effectful `F_Σ`, so the inner computation is a λ.)
def withStop_0 : !U ((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1)) * U (1 -o F[5.0 cancel[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) -o F[5.0 cancel[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) =
  !thunkv fun (p : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1)) * U (1 -o F[5.0 cancel[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) ->
    let (s, c) = p;
    w <- return (); a <- force c w unwind (fn1 <- return (unbang stop_0); ar1 <- return (s); force fn1 ar1);
    u <- (fn2 <- return (unbang stop_0); ar2 <- return (s); force fn2 ar2);
    return a

-- ---- Stage 1, the consumer ---------------------------------------------------------------------

def cons_body : !U (1 -o F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] i32) =
  !thunkv fun (u : 1) ->
    cell <- return (alloc[i32] i32[5]);
    r <- (a <- perform[2.0] ();
          x <- case a { inl v -> return v | inr e -> return i32[0] };
          b <- perform[2.0] ();
          y <- case b { inl v -> return v | inr e -> return i32[0] };
          nv <- abort[4.0] (plus (i32[7], plus (x, y))); (absurd nv : F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] i32))
      unwind (z <- return (free[i32] cell); t <- perform[6.0] i32[2]; return ());
    z <- return (free[i32] cell);
    return (plus (r, z))

-- A stage that does not loop is a loop of one turn.
def cons_loop : !U (1 -o F (U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U X) & F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) =
  !thunkv fun (u : 1) ->
    return (thunkv nu_in < (cf <- return (unbang cons_body); u2 <- return (); r <- force cf u2; return (inl r : i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U X) & F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))), return () >)

-- The wire site 2's storing clauses: `next` and `stop` store the continuation. Both are stored at
-- KD, whose argument is `next`'s answer; `stop`'s continuation takes `inr ()`.
