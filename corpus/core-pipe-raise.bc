  f <- return (unbang (unfold[nu Z. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1, (((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu Y. F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 * U Y + (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (1 + U X) & F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + 1)) * (U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U X) & F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + (U (nu X. ((i32 + 1) -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U X) & F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1) + U (nu X. ((i32 + 1) -o F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] (i32 + U X) & F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[4.0 cancel i32 ~> 0, 6.0 lin i32 ~> 1] 1)))) * (1 + (i32 + 1)))] conn_step));
