-- A `finally` cleanup that raises during a cancel (SPEC §27, §42): `work` waits, and `timeout`
-- drops its continuation, so the elaboration cancels it (its cancel performs, #953). The cancel runs
-- the cleanup, which raises `3`; the error is kept and re-raised at the canceller, `timeout`'s
-- clause, and `to_result` catches it. The cancel row of `wait` holds the `raise` (inferred).
--
-- Answer: inr i32[3], and `live 0`. A wrong implementation that skips the cleanup on a cancel, or
-- drops its error, answers `inl (inr ())`.

include fail

effect Wait { ctl wait() }

handler timeout[A]: Wait, A -> A + 1 = { return(x) = inl x; wait(k) = inr () }

fn work() -> i32 with Wait = wait(); 5

main -> (i32 + 1) + i32 =
  with to_result[i32, i32 + 1] {
    with timeout[i32] { with default[u8, i32](0) { work() } finally { let r = raise((3 : i32)); () } }
  }
