-- Operators as `poly` families (SPEC §36): `+`, `*`, `==` and the rest are each a family chosen by
-- the operands' type, whose machine cases are the host's instructions at the integer widths. A
-- program gives a type a case of its own: here `Complex`, the Gaussian integers, gets `(+)`,
-- `(*)` and `(==)`. The generic `dot` multiplies and adds at its type parameter; its instance at
-- `i32` uses the machine cases (the same `add32` and `mul32` an `i32` program has), and its
-- instance at `Complex` calls the cases below. A different arithmetic is a different type: a
-- case is chosen by type, never by scope.
--
-- `Complex` is a `type` abbreviation, so its cases are the cases at `i32 * i32`: a family has one
-- case per type (a second case at `i32 * i32` is an error, `corpus/reject/poly-second-case.bc`).
--
-- Answer: `(i32[32], ((i32[4294967287], i32[12]), inr ()))`: `1·4 + 2·5 + 3·6 = 32` at `i32`;
-- `(1 + 2i)(3 + 4i) + (1 + i)(−1 + 3i) + 0·(7 + 7i) = (−5 + 10i) + (−4 + 2i) = −9 + 12i` at
-- `Complex` (`−9` printed unsigned); and the result equal to itself (`inr ()`, true). A `+` or `*`
-- at `Complex` that took the machine case would not type, and one that took the other operator's
-- case gives another number.

type Complex = i32 * i32

poly (+) at Complex =
  let (ar, ai) = a;
  let (br, bi) = b;
  (ar + br, ai + bi)

poly (*) at Complex =
  let (ar, ai) = a;
  let (br, bi) = b;
  (ar * br - ai * bi, ar * bi + ai * br)

poly (==) at Complex =
  let (ar, ai) = a;
  let (br, bi) = b;
  ar == br && ai == bi

-- `x₁·y₁ + x₂·y₂ + x₃·y₃`, at any type with `+` and `*`.
fn dot[T](x: T * (T * T), y: T * (T * T)) -> T =
  let (x1, (x2, x3)) = x;
  let (y1, (y2, y3)) = y;
  x1 * y1 + x2 * y2 + x3 * y3

main -> i32 * (Complex * bool) =
  let n = dot((1, (2, 3)), (4, (5, 6)));
  let z = dot[Complex](((1, 2), ((1, 1), (0, 0))), ((3, 4), ((0 - 1, 3), (7, 7))));
  (n, (z, z == z))
