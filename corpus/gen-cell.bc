-- A generator that owns a cell: its state holds the cell between observations, and each step
-- reads it (`*c`, a borrow for the read) and swaps a new value in. No borrow crosses a `yield`,
-- which is what a generator may not do (`corpus/reject/gen-self-borrow.bc`); the cell is freed
-- when the loop ends.
--
-- Answer: i32[10]: the cell holds 0, 0, 1, 3, 6 at the five `yield`s (each step adds `i`), and
-- one cell is allocated (`corpus/counts.expected`). A step that yielded after the swap gives 20;
-- a cell that was not freed leaves `live 1`.
gen fn counter(n: i32) -> i32 =
  let c = alloc(0);
  let mut i = 0;
  while i < n {
    let v = *c;
    yield v;
    let (c, old) = swap(c, v + i);
    i = i + 1
  };
  let _ = free(c);
  ()

main -> i32 =
  let mut acc = 0;
  for x in counter(5) { acc = acc + x };
  acc
