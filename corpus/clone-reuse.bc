-- Reusing recursive data after taking it apart is written. A list of `i32` holds no resource, so
-- it is persistent and may be used again (SPEC §10), but the compiled program then copies it
-- whole: `match unroll l` takes the list apart, and the arm that names `l` again needs the list
-- the match consumed. The use that copies is written `clone(l)` (decision 39); without it the
-- program is rejected at that use (`corpus/reject/implicit-copy.bc`). An `i32` used twice is
-- copied as a word, and needs nothing written.
--
-- Answer: (i32[15], i32[3]): the head times the length, and the length. The run makes one copy (`copies 1`), of
-- the three nodes, so it allocates six; a `clone` that did not copy frees the list twice.

type List = mu X. 1 + (i32 * X)

def nil : List = roll inl ()
fn cons(x: i32, t: List) -> List = roll inr (x, t)

fn len_alg(r: 1 + i32 * i32) -> i32 = match r { inl u -> 0 | inr (x, n) -> n + 1 }
def len : !(List => i32) = fold_own[1 + i32 * X, i32] len_alg

fn head_len(l: List) -> i32 * i32 =
  match unroll clone(l) {
    inl u -> (0, 0)
  | inr (x, t) -> let n = len(l); (x * n, n)
  }

main -> i32 * i32 = head_len(cons(5, cons(6, cons(7, nil))))
