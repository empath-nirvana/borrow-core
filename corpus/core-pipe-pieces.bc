-- mk_conn(mode): the chain's connector over a source and a sink not yet run.
def mk_conn : !U (i32 -o F (U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1))) =
  !thunkv fun (m : i32) ->
    st : (PipeSt[0, 1, 0, i32, 1, 1, row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (1.0 cancel[4.0 cancel i32 ~> 0] i32 ~> 1, 11.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 0 + 1, 11.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 7.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), site 1, site 11, site 7] * PipeSt[i32, 1, 0, 0, i32, 0, row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (12.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 2.0 cancel[4.0 cancel i32 ~> 0] 1 ~> i32 + 1, 2.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 13.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), site 12, site 2, site 13]) * (((1 + 0) + (0 + 1)) + ((1 + 0) + (i32 + 1))) <- return (((inl ((thunkv nu_in <
          g <- return (unbang (unfold[nu X. F[1.0 cancel[4.0 cancel i32 ~> 0] i32 ~> 1, 11.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 0 + 1, 11.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 7.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0] (1 + U X) & F[4.0 cancel i32 ~> 0] 1, i32 * i32] src_turn)); a <- return (i32[1], m); (nu_out (force g a)).1,
          g <- return (unbang (unfold[nu X. F[1.0 cancel[4.0 cancel i32 ~> 0] i32 ~> 1, 11.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 0 + 1, 11.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 7.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0] (1 + U X) & F[4.0 cancel i32 ~> 0] 1, i32 * i32] src_turn)); a <- return (i32[1], m); (nu_out (force g a)).2 >)) : PipeSt[0, 1, 0, i32, 1, 1, row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (1.0 cancel[4.0 cancel i32 ~> 0] i32 ~> 1, 11.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 0 + 1, 11.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 7.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), site 1, site 11, site 7]),
        (inl ((thunkv nu_in <
          g <- return (unbang (unfold[nu X. F[12.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 2.0 cancel[4.0 cancel i32 ~> 0] 1 ~> i32 + 1, 2.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 13.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 4.0 cancel i32 ~> 0] (i32 + U X) & F[4.0 cancel i32 ~> 0] 1, i32 * (i32 * i32)] cons_turn)); a <- return (i32[0], (i32[0], m)); (nu_out (force g a)).1,
          g <- return (unbang (unfold[nu X. F[12.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 2.0 cancel[4.0 cancel i32 ~> 0] 1 ~> i32 + 1, 2.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 13.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 4.0 cancel i32 ~> 0] (i32 + U X) & F[4.0 cancel i32 ~> 0] 1, i32 * (i32 * i32)] cons_turn)); a <- return (i32[0], (i32[0], m)); (nu_out (force g a)).2 >)) : PipeSt[i32, 1, 0, 0, i32, 0, row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (12.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 2.0 cancel[4.0 cancel i32 ~> 0] 1 ~> i32 + 1, 2.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 13.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), site 12, site 2, site 13])),
      (inr (inl (inl ())) : ((1 + 0) + (0 + 1)) + ((1 + 0) + (i32 + 1))));
