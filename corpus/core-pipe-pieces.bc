    handle_with[5](c_hr, c_hc) ((fn1 <- return (unbang pipe_with_stop[i32, 1, 0, 0, i32, 0, 1, row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (12.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 2.0 cancel[4.0 cancel i32 ~> 0] 1 ~> i32 + 1, 2.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 13.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), site 12, site 2, site 13, site 5]); ar1 <- return (s1, thunkv fun (w5 : 1) -> (perform[5.0] w5 : F[5.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0] 1)); force fn1 ar1))
