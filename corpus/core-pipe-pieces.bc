-- check: old-backend-refuses
-- SPEC §75 Part B, milestone probe: `core-pipe-connector`'s three runs (U0), its connector rebuilt
-- over `lib/pipe.bc`'s pieces. The stages are loops at the pieces' types (a stage not yet run is its
-- loop); the glue is the state tuple, the
-- running stage with its input, and one `unfold`, calling `pipe_step`, `pipe_with_stop` (the frame
-- lists, each one region at site 5), `pipe_handoff`, `pipe_forward` and `pipe_finish`.
--   (a) mode 0, to the end: 55;
--   (b) mode 1, the sink returns after 4 items, and `finish` stops the source: 10;
--   (c) mode 2, the source performs `wait` at its fresh name 7; the connector forwards it as the
--       outer `wait` 8.0 under `close_all`, and the outer handler cancels it: the sink's cleanup
--       raises 3, then the source's 1, and the first, 3, is raised at the canceller.
-- Answer: (i32[55], (i32[10], inr i32[3])), `live 0`.
include pipe

def plus : i32 * i32 => i32 = unbang host[add32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]

-- ---- Stage 0, the source: items 1..10 (sites: yield 1, stream 11, forward 7) ----------------

def src_turn : !U (i32 * i32 -o F[1.0 cancel[4.0 cancel i32 ~> 0] i32 ~> 1, 11.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 0 + 1, 11.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 7.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0] (1 + i32 * i32) & F[4.0 cancel i32 ~> 0] 1) =
  !thunkv fun (s : i32 * i32) ->
    < let (i, m) = s;
      c <- return (lt (i32[10], i));
      case c {
        inl le ->
          w <- return (eq (m, i32[2]));
          v <- case w {
              inl no -> return ()
            | inr yes -> (v2 <- perform[7.0] () unwind ((nv <- abort[4.0] i32[1]; (absurd nv : F[4.0 cancel i32 ~> 0] 1))); return v2)
            };
          u <- perform[1.0] i;
          return (inr (plus (i, i32[1]), m))
      | inr gt -> return (inl ())
      },
      let (i, m) = s; return () >

-- ---- Stage 1, the sink: it owns a cell across each `next()` (sites: yield 12, stream 2, forward 13)

def cons_turn : !U (i32 * (i32 * i32) -o F[12.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 2.0 cancel[4.0 cancel i32 ~> 0] 1 ~> i32 + 1, 2.1 cancel[4.0 cancel i32 ~> 0] 1 ~> 1 + 0, 13.0 cancel[4.0 cancel i32 ~> 0] 0 ~> 1, 4.0 cancel i32 ~> 0] (i32 + i32 * (i32 * i32)) & F[4.0 cancel i32 ~> 0] 1) =
  !thunkv fun (s : i32 * (i32 * i32)) ->
    < let (acc, r1) = s; let (n, m) = r1;
      cell <- return (alloc[i32] i32[0]);
      a <- perform[2.0] () unwind (z <- return (free[i32] cell); w <- return (eq (m, i32[2]));
        case w { inl no -> return () | inr yes -> (nv <- abort[4.0] i32[3]; (absurd nv : F[4.0 cancel i32 ~> 0] 1)) });
      z <- return (free[i32] cell);
      case a {
        inl x ->
          acc2 <- return (plus (acc, plus (x, z)));
          n2 <- return (plus (n, i32[1]));
          b <- return (eq (m, i32[1]));
          case b {
            inl no -> return (inr (acc2, (n2, m)))
          | inr yes -> d <- return (eq (n2, i32[4]));
              case d { inl no2 -> return (inr (acc2, (n2, m))) | inr yes2 -> return (inl acc2) }
          }
      | inr e -> return (inl acc)
      },
      let (acc, r1) = s; return () >

-- ---- The glue: frame lists, each one cancel region at site 5 ----------------------------------

def c_hr : !U (1 -o F[4.0 cancel i32 ~> 0] 1) = !thunkv fun (v : 1) -> return v
def c_hc : !U (1 * U ((1 -o F[4.0 cancel i32 ~> 0] 1) & F[4.0 cancel i32 ~> 0, 4.0 cancel i32 ~> 0] 1) -o F[4.0 cancel i32 ~> 0] 1) * 1 =
  (!thunkv fun (p : 1 * U ((1 -o F[4.0 cancel i32 ~> 0] 1) & F[4.0 cancel i32 ~> 0, 4.0 cancel i32 ~> 0] 1)) -> let (u, k) = p; let () = u; (force k).2, ())

