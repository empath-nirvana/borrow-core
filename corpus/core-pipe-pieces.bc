    return (thunkv nu_in < (nu_out (force f st)).1, (nu_out (force f st)).2 >)

-- ---- Outside the connector, per observation of its loop: the raise (4) and the outer `wait` (8),
-- whose handler cancels its continuation.

def h8_hr : !U ((i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) -o F[4.0 cancel i32 ~> 0] (i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1))) = !thunkv fun (v : i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) -> return v
def h4_hr : !U ((i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) -o F ((i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) + i32)) = !thunkv fun (v : i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) -> return (inl v)
def c4_hr : !U (1 -o F 1) = !thunkv fun (v : 1) -> return v

def outer_step : !U ((U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) * (i32 * (i32 * i32)) -o F ((i32 * (i32 * (i32 + i32))) + (U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) * (i32 * (i32 * i32))) & F 1) =
  !thunkv fun (s : (U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) * (i32 * (i32 * i32))) ->
    < let (g, r) = s; let (m, r2) = r; let (ra, rb) = r2;
      o <- handle_with[4](h4_hr, (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F ((i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) + i32)) * 1)) (
             handle_with[8](h8_hr, (((!thunkv fun (p : 1 * U ((1 -o F[4.0 cancel i32 ~> 0] (i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1))) & F[4.0 cancel i32 ~> 0, 4.0 cancel i32 ~> 0] 1)) ->
                 let (u, k) = p; let () = u; z <- (force k).2; return (inl i32[99])), ())
               : !U (1 * U ((1 -o F[4.0 cancel i32 ~> 0] (i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1))) & F[4.0 cancel i32 ~> 0, 4.0 cancel i32 ~> 0] 1) -o F[4.0 cancel i32 ~> 0] (i32 + U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1))) * 1)) ((nu_out (force g)).1));
      case o {
        inl v -> case v {
          inl x ->
            c0 <- return (eq (m, i32[0]));
            case c0 {
              inl n0 ->
                c1 <- return (eq (m, i32[1]));
                case c1 {
                  inl n1 -> return (inl (ra, (rb, (inl x : i32 + i32))))
                | inr y1 -> g2 <- (fn30 <- return (unbang mk_conn); ar30 <- return (i32[2]); force fn30 ar30); return (inr (g2, (i32[2], (ra, x))))
                }
            | inr y0 -> g2 <- (fn31 <- return (unbang mk_conn); ar31 <- return (i32[1]); force fn31 ar31); return (inr (g2, (i32[1], (x, rb))))
            }
        | inr g2 -> return (inr (g2, (m, (ra, rb))))
        }
      | inr e -> return (inl (ra, (rb, (inr e : i32 + i32))))
      },
      let (g, r) = s;
      handle_with[4](c4_hr, (((!thunkv fun (e : i32) -> return ()), ()) : !U (i32 -o F 1) * 1)) ((nu_out (force g)).2) >

main : F (U (nu W. F ((i32 * (i32 * (i32 + i32))) + U W) & F 1)) =
  g <- (fn32 <- return (unbang mk_conn); ar32 <- return (i32[0]); force fn32 ar32);
  h <- return (unbang (unfold[nu W. F ((i32 * (i32 * (i32 + i32))) + U W) & F 1, (U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) * (i32 * (i32 * i32))] outer_step));
  s : (U (nu Z. F[4.0 cancel i32 ~> 0, 8.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1] (i32 + U Z) & F[4.0 cancel i32 ~> 0] 1)) * (i32 * (i32 * i32)) <- return (g, (i32[0], (i32[0], i32[0])));
  return (thunkv nu_in < (nu_out (force h s)).1, (nu_out (force h s)).2 >)
