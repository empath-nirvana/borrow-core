-- A tokenizer written as a generator, feeding a recursive-descent parser that pulls tokens on
-- demand: no token list is built. `tokens` scans a borrowed view of the source and yields each
-- token; the parser holds the stored generator (`U (pull Tok 1 1)`) and one token of lookahead,
-- threading both through its calls. Errors are `Fail[i32]`; the pending generator is closed
-- (cancelled) when the parse ends or fails.
--
-- Exercises: a generator over a borrowed view, a stored generator threaded through a recursive
-- group, `Fail` across the pulls, and a borrow of a literal that the whole pipeline lives inside.
--
-- The stored generator has no destructor, so the parser closes it itself before it raises.
--
-- Answer: `(inl i32[44], inr i32[2])`: `2*(3+4)+5*6` is 44, and `2*(3+4` misses its `)`;
-- `live 0`. A parser that lost its lookahead across a pull gives another value.

include text
include yield
include rec

-- A token: its kind and its value. Kinds: 0 a number, 1 `+`, 2 `*`, 3 `(`, 4 `)`, 6 the end.
type Tok = i32 * i32

type Gen = U (pull Tok 1 1)

fn is_digit(b: u8) -> bool = 48 <= b && b <= 57

fn kind_of(b: u8) -> i32 =
  if b == b'+' { 1 } else { if b == b'*' { 2 } else { if b == b'(' { 3 } else {
  if b == b')' { 4 } else { 0 - 1 } } } }

fn tokens<'a>(v: text 'a) -> 1 with Yield[Tok] =
  let mut num = 0;
  let mut in_num = false;
  for p in v {
    let b = *p;
    if is_digit(b) { num = num * 10 + to_i32(b) - 48; in_num = true }
    else {
      if in_num { yield((0, num)); num = 0; in_num = false } else { () };
      let k = kind_of(b);
      if k >= 0 { yield((k, 0)) } else { () }
    }
  };
  if in_num { yield((0, num)) } else { () };
  ()

-- The next token, `(6, 0)` once the generator has finished.
fn pull_tok(it: Gen) -> Tok * Gen + 1 =
  o <- (nu_out (force it)).1;
  match o {
    inl (t, it) -> inl (t, it)
  | inr d -> match d { inl u -> inr () | inr it -> pull_tok(it) }
  }

-- The parser's state: the lookahead and the rest of the tokens (none once they have ended).
type P = Tok * (Gen + 1)

fn advance(p: P) -> P =
  let (t, g) = p;
  match g {
    inl it -> match pull_tok(it) { inl (t2, it) -> (t2, inl it) | inr u -> ((6, 0), inr ()) }
  | inr u -> ((6, 0), inr ())
  }

fn kind(p: P) -> P * i32 = let (t, g) = p; let (k, x) = t; ((t, g), k)

fn close(p: P) -> 1 = let (t, g) = p; match g { inl it -> (nu_out (force it)).2 | inr u -> () }

fn expr(p: P) -> i32 * P with Fail[i32], Exhausted =
  let (v, p) = term(p);
  let (p, k) = kind(p);
  if k == 1 { let (w, p) = expr(advance(p)); (v + w, p) } else { (v, p) }

fn term(p: P) -> i32 * P with Fail[i32], Exhausted =
  let (v, p) = factor(p);
  let (p, k) = kind(p);
  if k == 2 { let (w, p) = term(advance(p)); (v * w, p) } else { (v, p) }

fn factor(p: P) -> i32 * P with Fail[i32], Exhausted =
  let (t, g) = p;
  let (k, x) = t;
  if k == 0 { (x, advance((t, g))) } else {
    if k == 3 {
      let (v, p) = expr(advance((t, g)));
      let (p, k2) = kind(p);
      if k2 == 4 { (v, advance(p)) } else { close(p); raise(2) }
    } else { close((t, g)); raise(1) }
  }

fn eval<'a>(v: text 'a) -> i32 with Fail[i32], Exhausted =
  let g : U (pull Tok 1 1) = tokens(v);
  let (r, p) = expr(advance(((6, 0), (inl g : Gen + 1))));
  close(p);
  r

fn eval_lit(l: lit) -> i32 + i32 =
  borrow imm l { v -> with on_exhausted(!{ u -> inr 0 }) { with to_result { eval(v) } } }

main -> (i32 + i32) * (i32 + i32) = (eval_lit("2*(3+4)+5*6"), eval_lit("2*(3+4"))
