#! dialect 82
# `withbor3u[…] unwind (d)` in core text (SPEC §78, §19): an unwinding reborrow with a written
# finaliser at `Σ_D = ∅`. The cell `c` is lent (`withbor2`) as `m`; `m` is reborrowed around a
# body that writes `5` through the reborrow and aborts with `42`. The finaliser `d` gets the source
# `m` back as the abort passes and writes `99` through it; the handler answers `inr 42`, and the
# cell, handed back by the outer lend, holds `99`.
#
# Answer: `(i32[99], inr i32[42])`, and `live 0`. With the consume as its finaliser (no
# `unwind (d)`) the cell would hold `5`.

main : F (i32 * (0 + i32)) =
  c <- return (alloc[i32] i32[1]);
  q <- return (withbor2['x, top, i32, 0 + i32] c
         (thunkv Fun 'x < top. return (thunkv fun (m : mut 'x i32) ->
            r <- handle_with[1](
                ((!thunkv fun (p : mut 'x i32 * 0) -> let (m2, v) = p; absurd v) : !U (mut 'x i32 * 0 -o F (0 + i32))),
                (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (0 + i32)) * 1)) (
              w <- return withbor3u['x, 'y, i32, 0, [1.0 cancel i32 ~> 0]] unwind (
                thunkv fun (s : mut 'x i32) ->
                  t <- return (withswap['x, i32, 1] s (thunkv fun (v : i32) -> return (i32[99], ())));
                  let (s2, z) = t; let () = z; return (release_mut['x, i32] s2));
              cb : U (forall 'y < dom. mut 'y i32 -o F[1.0 cancel i32 ~> 0] (box 'y 0)) <- return
                (thunkv Fun 'y < dom. fun (n : mut 'y i32) ->
                  s0 <- return (withswap['y, i32, 1] n (thunkv fun (v : i32) -> return (i32[5], ())));
                  let (n2, z0) = s0; let () = z0; abort[1.0] i32[42]);
              force w m cb);
            return (boxed['x] r))));
  let (c2, r) = q;
  v <- return (free[i32] c2);
  return (v, r)
