-- A handler site in a clause, as a head of the clause's path (SPEC §27; #953 re-review F1): `tm`'s
-- clause runs `with to_result[i32, i32] { 1 }`, then answers `inr ()` without its continuation.
-- The kernel types `handle_n` at the row around it, the clause's row, which holds an abortive
-- operation (`Fail`), so the head is one an abort can pass through, and it is wrapped in
-- `unwind (cancel k)`. Nothing aborts here: `k` is cancelled at the end, the body's cleanup raises
-- `3`, kept and re-raised at the canceller, and `to_result` outside catches it.
--
-- Answer: inr i32[3], and `live 0`. Without the wrap the kernel refuses `k` live across the site.

include fail

effect Wait { ctl wait() }

fn work() -> i32 with Wait, Fail[i32] = x <- wait() unwind (let r = raise((3 : i32)); ()); 5

handler tm: Wait, i32 -> i32 + 1 with Fail[i32] = {
  return(x) = inl x;
  wait(k) = { let a = with to_result[i32, i32] { 1 }; inr () }
}

main -> (i32 + 1) + i32 = with to_result[i32, i32 + 1] { with tm { work() } }
