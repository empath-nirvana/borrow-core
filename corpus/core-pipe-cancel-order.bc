          case e {
            inl xq ->
              h <- (fn12 <- return (unbang handoff_1); ar12 <- return ((inl xq : i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1), s1); force fn12 ar12);
              let (t0, ri) = h; let (inp, t1) = ri;
              return (inr ((t0, t1), inr inp))
          | inr rs -> case rs {
              inl rk -> case rk {
                inl k ->
                  h <- (fn13 <- return (unbang handoff_1); ar13 <- return ((inr k : i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1), s1); force fn13 ar13);
                  let (t0, ri) = h; let (inp, t1) = ri;
                  return (inr ((t0, t1), inr inp))
              | inr l -> return (inr ((inl l, s1), inl ()))
              }
            | inr kf ->
                -- Fwd: store AtFwd, forward under close_all, then the source runs at the answer.
                sf : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1)) <- return (inr (inl kf));
                a <- (fn14 <- return (unbang forward_0); ar14 <- return (()); force fn14 ar14) unwind (fn15 <- return (unbang close_all); ar15 <- return (sf, s1); force fn15 ar15);
                return (inr ((sf, s1), inl a))
            }
          }
      | inr inp ->
          e <- (fn16 <- return (unbang step_1); ar16 <- return (s1, inp); force fn16 ar16) unwind (fn17 <- return (unbang close_others_1); ar17 <- return (s0); force fn17 ar17);
          case e {
            inl rl -> case rl {
              inl r -> v <- (fn18 <- return (unbang finish); ar18 <- return (r, s0); force fn18 ar18); return (inl v)
            | inr l -> return (inr ((s0, inl l), inr (inr ())))
            }
          | inr kk -> case kk {
              inl kn -> return (inr ((s0, inr (inl kn)), inl ()))
            | inr ks ->
                t1 : (U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1))) <- return (inr (inr ks));
                u <- (fn19 <- return (unbang close_others_1); ar19 <- return (s0); force fn19 ar19) unwind (fn20 <- return (unbang close_others_0); ar20 <- return (t1); force fn20 ar20);
                return (inr (((inr (inr ()) : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1))), t1), inr (inr ())))
            }
          }
      },
      let (ss, turn) = st;
      (fn21 <- return (unbang close_all); ar21 <- return (ss); force fn21 ar21) >

-- mk_conn(mode): the chain's connector over a fresh source and sink.
def mk_conn : !U (i32 -o F (U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) =
  !thunkv fun (m : i32) ->
    sf <- return (unbang src_loop); a0 <- return (i32[1], m); l0 <- force sf a0;
    cf <- return (unbang cons_loop); a1 <- return (i32[0], (i32[0], m)); l1 <- force cf a1;
    st : (((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1)) * (U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) * (1 + (i32 + 1))) <- return ((inl l0, inl l1), inr (inr ()));
    f <- return (unbang (unfold[nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1, (((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1)) * (U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) * (1 + (i32 + 1)))] conn_step));
    return (thunkv nu_in < (nu_out (force f st)).1, (nu_out (force f st)).2 >)

def mul : i32 * i32 => i32 = unbang host[mul32]

def h8_hr : !U ((i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1)) -o F[6.0 lin i32 ~> 1] (i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) = !thunkv fun (v : (i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) -> return v
def h8_hc : !U (1 * U ((1 -o F[6.0 lin i32 ~> 1] (i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) -o F[6.0 lin i32 ~> 1] (i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) * 1 =
  (!thunkv fun (p : 1 * U ((1 -o F[6.0 lin i32 ~> 1] (i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)) ->
     let (u, k) = p; let () = u; z <- (force k).2; return (inl i32[99]), ())
def t_hr : !U ((i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1)) -o F ((i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1)) * (i32 * i32))) = !thunkv fun (v : (i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1))) -> return (v, (i32[0], i32[1]))
def t_hc : !U (i32 * U ((1 -o F ((i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1)) * (i32 * i32))) & top) -o F ((i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1)) * (i32 * i32))) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F ((i32 + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1)) * (i32 * i32))) & top)) ->
     let (d, k) = p;
     u <- return ();
     r <- (force k).1 u;
     let (v, tp) = r; let (t, w) = tp;
     return (v, (plus (mul (d, w), t), mul (w, i32[10]))), ())
def c6_hr : !U (1 -o F 1) = !thunkv fun (v : 1) -> return v
def c6_hc : !U (i32 * U ((1 -o F 1) & top) -o F 1) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F 1) & top)) -> let (d, k) = p; u <- return (); (force k).1 u, ())

def outer_step : !U (U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1) * i32 -o F ((i32 * i32) + U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1) * i32) & F 1) =
  !thunkv fun (s : U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1) * i32) ->
    < let (g, t) = s;
      o <- handle_with[6](t_hr, t_hc) (handle_with[8](h8_hr, h8_hc) ((nu_out (force g)).1));
      let (res, tp) = o; let (td, w) = tp;
      t2 <- return (plus (mul (t, w), td));
      case res {
        inl x -> return (inl (x, t2))
      | inr g2 -> return (inr (g2, t2))
      },
      let (g, t) = s;
      handle_with[6](c6_hr, c6_hc) ((nu_out (force g)).2) >

main : F (U (nu W. F ((i32 * i32) + U W) & F 1)) =
  g <- (fn22 <- return (unbang mk_conn); ar22 <- return (i32[2]); force fn22 ar22);
  h <- return (unbang (unfold[nu W. F ((i32 * i32) + U W) & F 1, U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1) * i32] outer_step));
  s : U (nu Z. F[6.0 lin i32 ~> 1, 8.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1] (i32 + U Z) & F[6.0 lin i32 ~> 1] 1) * i32 <- return (g, i32[0]);
  return (thunkv nu_in < (nu_out (force h s)).1, (nu_out (force h s)).2 >)
