-- One cancel region (site 5): its clause cancels the continuation, so every frame's stop runs.
def c_hr : !U (1 -o F[6.0 lin i32 ~> 1] 1) = !thunkv fun (v : 1) -> return v
def c_hc : !U (1 * U ((1 -o F[6.0 lin i32 ~> 1] 1) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) -o F[6.0 lin i32 ~> 1] 1) * 1 =
  (!thunkv fun (p : 1 * U ((1 -o F[6.0 lin i32 ~> 1] 1) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)) -> let (u, k) = p; let () = u; (force k).2, ())

