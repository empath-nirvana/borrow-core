-- check: old-backend-refuses
-- Pipes L1 (#920): P1b Thm X at the forwarded `wait`, 2 stages (the 2-stage `pipe-cancel-order`).
-- The connector of `core-pipe-connector`, mode 2: the source waits at the fresh name 7, the
-- connector forwards it as the outer `wait` 8.0 under `close_all`, and the outer handler of 8
-- cancels it. The cleanups trace their stage's digit with the must-resume operation 6.0, handled
-- outside: the sink's 2, the source's 1.
-- Answer: (i32[99], i32[21]), and `live 0`: the sink stopped first (downstream first); 99 is the
-- outer handler's answer after the cancel. `i32[12]` would be upstream first.
--
-- The connector is Assembly(n) rev 2's pieces (theory, `assembly-n.md` §1), each over one stage's
-- or one wire's types, and the glue: the state tuple, the running stage with its pending input, and
-- a dispatching loop (one `unfold`).
--
-- Stage 0, the source, is a loop value. It performs `yield` (site 1) and, in mode 2, a resumable
-- `wait` at the fresh connector-local name 7. Stage 1, the sink, is a loop value performing
-- `Stream`'s `next` (2.0) and `stop` (2.1). The real outer `wait` is 8.0, performed only by the
-- connector (`forward_0`). Each turn of a stage runs under its storing clauses, inside the per-step
-- finaliser `close_others_i`. A forwarded `wait` is the `[then]`
--     a <- forward_0 () unwind (close_all (AtFwd k, s1)); <the source runs next, resumed at a>
-- whose finaliser is the one-region `close_all`, with the sink's frame innermost.
--
-- State_0 = Ready(L) | AtYield(K0) / AtFwd(K0) | Ended                    = U L + (U K0 + 1)
-- Event_0 = Yield(i32, K0) | Return(1) | Skip(L) | Fwd(K0)                = i32 * U K0 + ((1 + U L) + U K0)
-- State_1 = Ready(L1) | AtNext(KD) | AtStop(KD)                           = U L1 + (U KD + U KD)
-- Event_1 = Return(i32) | Skip(L1) | Next(KD) | Stop(KD)                  = (i32 + U L1) + (U KD + U KD)
-- The stages' rows are the cleanup row CR; the glue's adds the outer `wait` 8.0, whose cancel row
-- covers `close_all`'s, CR.

def plus : i32 * i32 => i32 = unbang host[add32]
def lt : i32 * i32 => 1 + 1 = unbang host[lt_s32]
def eq : i32 * i32 => 1 + 1 = unbang host[eq32]

-- ---- Stage 0, the source: items 1..10 --------------------------------------------------------

def src_turn : !U (i32 * i32 -o F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + i32 * i32) & F[6.0 lin i32 ~> 1] 1) =
  !thunkv fun (s : i32 * i32) ->
    < let (i, m) = s;
      c <- return (lt (i32[10], i));
      case c {
        inl le ->
          w <- return (eq (m, i32[2]));
          v <- case w {
              inl no -> return ()
            | inr yes -> (v2 <- perform[7.0] () unwind ((t <- perform[6.0] i32[1]; return ())); return v2)
            };
          u <- perform[1.0] i;
          return (inr (plus (i, i32[1]), m))
      | inr gt -> return (inl ())
      },
      let (i, m) = s; return () >

def src_loop : !U (i32 * i32 -o F (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1))) =
  !thunkv fun (a : i32 * i32) ->
    f <- return (unbang (unfold[nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1, i32 * i32] src_turn));
    return (thunkv nu_in < (nu_out (force f a)).1, (nu_out (force f a)).2 >)

-- The fresh site 7's storing clause (outer): Fwd(k).
def f_hr : !U ((i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1))) -o F[6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) = !thunkv fun (v : (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) -> return v
def f_hc : !U (1 * U ((1 -o F[6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) -o F[6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) * 1 =
  (!thunkv fun (p : 1 * U ((1 -o F[6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)) ->
     let (u, k) = p; let () = u;
     return (inr (inr (thunkv nu_in < fun (w : 1) -> (force k).1 w, (force k).2 >))), ())
-- Site 7 around a stored rest's cancel: a cancel run that waits is not in these programs; the
-- clause cancels.
def c7_hr : !U (1 -o F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) = !thunkv fun (v : 1) -> return v
def c7_hc : !U (1 * U ((1 -o F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) -o F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) * 1 =
  (!thunkv fun (p : 1 * U ((1 -o F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)) -> let (u, k) = p; let () = u; (force k).2, ())

-- The wire site 1's storing clause (inner): Yield(x, rest), the rest re-entering site 7's handler.
def pull_hr : !U (1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) -o F[7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) =
  !thunkv fun (v : 1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) -> return (inr (inl v))
def pull_hc : !U (i32 * U ((1 -o F[7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) & F[6.0 lin i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] 1) -o F[7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F[7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) & F[6.0 lin i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] 1)) ->
     let (x, k) = p;
     return (inl (x, thunkv nu_in < fun (w : 1) -> handle_with[7](f_hr, f_hc) ((force k).1 w),
                                    handle_with[7](c7_hr, c7_hc) ((force k).2) >)), ())

-- step_0 : State_0 * Input_0 -o F Event_0
def step_0 : !U ((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1)) * 1 -o F[6.0 lin i32 ~> 1] (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) =
  !thunkv fun (p : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1)) * 1) ->
    let (s, u) = p;
    case s {
      inl l -> let () = u; handle_with[7](f_hr, f_hc) (handle_with[1](pull_hr, pull_hc) ((nu_out (force l)).1))
    | inr r -> case r {
        inl q -> (nu_out (force q)).1 u
      | inr e -> let () = u; return (inr (inl (inl e)) : (i32 * U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1))))
      }
    }

-- stop_0 : State_0 -o F 1
def stop_0 : !U ((U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1)) -o F[6.0 lin i32 ~> 1] 1) =
  !thunkv fun (s : (U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu Y. (1 -o F[6.0 lin i32 ~> 1] (i32 * U Y + ((1 + U (nu X. F[1.0 cancel[6.0 lin i32 ~> 1] i32 ~> 1, 7.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (1 + U X) & F[6.0 lin i32 ~> 1] 1)) + U Y))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + 1))) ->
    case s {
      inl l -> (nu_out (force l)).2
    | inr r -> case r {
        inl q -> (nu_out (force q)).2
      | inr e -> return e
      }
    }

-- withStop_0 : State_0 * U (1 -o F R) -o F R (rev 2.1), at the region's R = 1.
