      a <- perform[2.0] () unwind (z <- return (free[i32] cell); (t <- perform[6.0] i32[2]; return ()));
      z <- return (free[i32] cell);
      case a {
        inl x ->
          acc2 <- return (plus (acc, plus (x, z)));
          n2 <- return (plus (n, i32[1]));
          b <- return (eq (m, i32[1]));
          case b {
            inl no -> return (inr (acc2, (n2, m)))
          | inr yes -> d <- return (eq (n2, i32[4]));
