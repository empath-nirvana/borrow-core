  !thunkv fun (s1 : (U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1) + (U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1) + U (nu X. ((i32 + 1) -o F[6.0 lin i32 ~> 1] ((i32 + U (nu X. F[2.0 cancel[6.0 lin i32 ~> 1] 1 ~> i32 + 1, 2.1 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] (i32 + U X) & F[6.0 lin i32 ~> 1] 1)) + (U X + U X))) & F[6.0 lin i32 ~> 1, 6.0 lin i32 ~> 1] 1)))) ->
    handle_with[5](c_hr, c_hc) ((fn5 <- return (unbang withStop_1); ar5 <- return (s1, thunkv fun (w5 : 1) -> (perform[5.0] w5 : F[5.0 cancel[6.0 lin i32 ~> 1] 1 ~> 1, 6.0 lin i32 ~> 1] 1)); force fn5 ar5))
