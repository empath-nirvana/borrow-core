-- R1's licence (SPEC §54) at works not written in place: `core-handle-tail`'s node, its answering
-- functions bound to `gs` first. The tail-resuming rule types the node; the licence leaves `2`
-- (works not written in place), and R1 writes the node as the `[handle]` node it erases to: `gs`
-- taken apart outside it, its clauses the rule's own, which the kernel checks again.
--
-- Answer: i32[20].

def plus : i32 * i32 => i32 = unbang host[add32]

def twice : !U (1 -o F[2.0 lin 1 ~> i32] i32) =
  !thunkv fun (u : 1) ->
    a <- perform[2.0] u;
    b <- perform[2.0] ();
    return (plus (a, b))

main : F i32 =
  f <- return (unbang twice);
  u <- return ();
  gs <- return (((!thunkv fun (u : 1) -> let () = u; return i32[10]), ()) : !U (1 -o F i32) * 1);
  handle_tail[2: lin](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      gs)
    (force f u)
