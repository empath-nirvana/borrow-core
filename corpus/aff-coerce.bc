-- The coercions between the three kinds of function (SPEC §22): persistent `!(A => B)` ≤ affine
-- `box 'c Aff[A, B]<'c>` ≤ linear `A => B` (cf. Rust's `Fn ≤ FnMut ≤ FnOnce`). `aff_of_fn` makes
-- a persistent function a closure whose state is the function; `aff_once` makes a closure a
-- linear function that calls it once and closes the rest. The other directions are refused:
-- an affine closure is not persistent (`corpus/reject/aff-copy.bc`), and a linear function has no
-- destructor, so it cannot be the state a `close` disposes of
-- (`corpus/reject/aff-linear-state.bc`).
--
-- Answer: i32[230011], and `live 0`: `x + 10` as a closure answers 11 and 12 (`23`, times
-- 10000); the counter from 10, made linear and called once with 1, answers 11, and its `close`
-- frees its cell. A coercion that dropped the counter without closing it leaves its cell live.
-- Both closures are bounded by `main`'s own lifetime (SPEC §23).

include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  aff_new_boxed[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, c1),
      n <- return (free[i32] s); return () >)

main -> i32 =
  let f = aff_of_fn[i32, i32](!thunkv fun (x : i32) -> return (x + 10));
  let (a, f) = aff_call(f, 1);
  let (b, f) = aff_call(f, 2);
  aff_close(f);
  let g = aff_once[i32, i32](counter(10));
  let c = g(1);
  (a + b) * 10000 + c
