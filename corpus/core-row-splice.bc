-- SPEC §76: two row parameters spliced into one row, `F[..r1, ..r2]`, the row their concatenation.
-- `cancel_on[row r1, row r2, site s]` runs a thunk under a handler at `s` whose clause cancels the
-- continuation. The operation `s.0` has the cancel row `r1`, and the handler's outer row is `r2`,
-- so the continuation's cancel branch is at `fin ++ Σ`, written `F[..r1, ..r2] 1`. The checker reads
-- `fin` back from that row by its length (SPEC §27).
--
-- It is used where both rows are the abortive `4.0`: the cancel branch is
-- `F[4.0 cancel i32 ~> 0, 4.0 cancel i32 ~> 0] 1`, its repeat kept, so `s.0`'s cancel row is read
-- as `[4.0]`. The thunk performs `5.0` under a finaliser that raises `4.0` with 7; the clause
-- cancels it, the finaliser runs and raises, and the handler at 4 answers 7. Were the repeat merged,
-- `5.0`'s cancel row would be read as empty and the finaliser's raise refused.
--
-- Answer: i32[7].

def cancel_on[row r1, row r2, site s] :
    !U (U (F[s.0 cancel[..r1] 1 ~> 1, ..r2] i32) -o F[..r2] i32) =
  !thunkv fun (t : U (F[s.0 cancel[..r1] 1 ~> 1, ..r2] i32)) ->
    handle_with[s](
        ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F[..r2] i32)),
        (((!thunkv fun (p : 1 * U ((1 -o F[..r2] i32) & F[..r1, ..r2] 1)) ->
            let (u, k) = p; let () = u; c <- (force k).2; let () = c; return i32[0]), ())
          : !U (1 * U ((1 -o F[..r2] i32) & F[..r1, ..r2] 1) -o F[..r2] i32) * 1)) (
      force t)

main : F i32 =
  t : U (F[5.0 cancel[4.0 cancel i32 ~> 0] 1 ~> 1, 4.0 cancel i32 ~> 0] i32) <- return (thunkv (
         x <- perform[5.0] () unwind ((nv <- abort[4.0] i32[7]; (absurd nv : F[4.0 cancel i32 ~> 0] 1)));
         return i32[1]));
  handle_with[4](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (e : i32) -> return e), ()) : !U (i32 -o F i32) * 1)) (
    (unbang cancel_on[row (4.0 cancel i32 ~> 0), row (4.0 cancel i32 ~> 0), site 5]) t)
