-- A name bound inside a borrow block over a loop, beside a variable of the same name outside it,
-- in core text, whose names are not resolved (SPEC §41): the checker resolves each name to the
-- innermost binder in scope, so the block's `let mut acc` is its own and the `acc` read after the
-- block is `main`'s. The block's body loops, so its lend is held across the loop's ticks, at the
-- graded row `div call` (SPEC §63); the loop reads the borrow `b` at each turn, and the checker
-- copies the `imm` borrow for each use (`copy`, SPEC §66). `corpus/lend-shadow.bc` is the same
-- program in a surface body.
--
-- Answer: on the input `1234`, `i32[105]`, `live 0`: 10 + 20 + 30 + 40, the newline's entry 0, and
-- `main`'s 5.

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

main : F i32 =
  let t = alloc(array_new[i32] (10, tab));
  let acc = 5;
  let r = borrow imm t { b ->
    let mut acc = 0;
    for c in bytes(&mut stdin) { acc = acc + get(b, to_i32(c) - 48) };
    acc
  };
  acc + r
