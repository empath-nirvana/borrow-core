#! dialect 82
# [spec §80] Two writes to one local; the final contents and both observations distinguish lost writes.
# Expected (final contents, body answer): (i32[12], i32[512]), live 0.
main : F (i32 * i32) =
  q <- return (withlocal['l, top, i32, i32] i32[0]
    (thunkv Fun 'l < dom. return (thunkv fun (m : mut 'l i32) ->
      p <- return (withswap['l, i32, i32] m (thunkv fun (v : i32) ->
        return ((unbang host[add32]) (v, i32[5]), (unbang host[add32]) (v, i32[5]))));
      let (m, a) = p;
      p <- return (withswap['l, i32, i32] m (thunkv fun (v : i32) ->
        return ((unbang host[add32]) (v, i32[7]), (unbang host[add32]) (v, i32[7]))));
      let (m, b) = p;
      let () = release_mut['l, i32] m;
      return (boxed['l] ((unbang host[add32]) ((unbang host[mul32]) (a, i32[100]), b))))));
  return q
