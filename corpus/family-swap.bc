-- swapBoth (Core/FamilyPrograms.lean), from the corpus review's 4a-family-swapBoth, in
-- draft 1: two cells borrowed `mut` as one family by withbor_f2_mut, and swapped.
-- 'a and 'b name the family's two internal borrows (section 9); top is the witness @w.

type B = 1 + 1

main : F 1 =
  ra <- return (alloc[B] (inl ()));
  rb <- return (alloc[B] (inr ()));
  r <- return (withbor_f2_mut['c, 'a, 'b, top, B, B, 1] (ra, rb)
         (thunkv Fun 'c < top. return (thunkv fun (m : mut 'c B * mut 'c B) ->
            let (ma, mb) = m;
            q1 <- return (withswap['c, B, 1] ma (thunkv fun (x : B) ->
                    q2 <- return (withswap['c, B, B] mb (thunkv fun (y : B) -> return (x, y)));
                    let (mb2, y2) = q2;
                    let () = forget_mut['c, B] mb2;
                    return (y2, ())));
            let (ma2, u1) = q1;
            let () = u1;
            let () = forget_mut['c, B] ma2;
            return (boxed['c] ()))));
  let (s, u) = r;
  let () = u;
  let (ra2, rb2) = s;
  a <- return (free[B] ra2);
  b <- return (free[B] rb2);
  return ()
