-- swapBoth (Core/FamilyPrograms.lean), from the corpus review's 4a-family-swapBoth, in
-- draft 1: two cells borrowed `mut` as one family by withbor_f2_mut, and swapped.
-- 'a and 'b name the family's two internal borrows (section 9); top is the witness @w. The
-- borrows `mb2` and `ma2` that the withswaps hand back are dropped implicitly (SPEC §12).
--
-- Answer: (i32[500], i32[9]), from the cells a = 9, b = 500. The cells differ, so a swap
-- that does not happen gives (9, 500), one that copies one cell into the other gives
-- (9, 9) or (500, 500), and returning the family's cells in the wrong order gives (9, 500).

main : F (i32 * i32) =
  ra <- return (alloc[i32] i32[9]);
  rb <- return (alloc[i32] i32[500]);
  r <- return (withbor_f2_mut['c, 'a, 'b, top, i32, i32, 1] (ra, rb)
         (thunkv Fun 'c < top. return (thunkv fun (m : mut 'c i32 * mut 'c i32) ->
            let (ma, mb) = m;
            q1 <- return (withswap['c, i32, 1] ma (thunkv fun (x : i32) ->
                    q2 <- return (withswap['c, i32, i32] mb (thunkv fun (y : i32) -> return (x, y)));
                    let (mb2, y2) = q2;
                    return (y2, ())));
            let (ma2, u1) = q1;
            let () = u1;
            return (boxed['c] ()))));
  let (s, u) = r;
  let () = u;
  let (ra2, rb2) = s;
  a <- return (free[i32] ra2);
  b <- return (free[i32] rb2);
  return (a, b)
