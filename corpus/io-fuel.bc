-- Fuel: div code run from total code (SPEC §14). `div_fuel` (the divergence library) observes a
-- loop at most `n` times and closes it if it has not finished, so a function that calls a div
-- function through it is total, and can say so with `total`.
--
-- `collatz` counts the steps from `n` to 1; whether that loop always finishes is an open
-- problem, and its type says it may not. `count_lines` loops over its input. Each has a total
-- wrapper with a bound. A loop closed early hands its capability back, so `main` reads on from
-- where the first, cut-off count stopped.
--
-- Answer: `((inl i32[111], inr ()), (inr (), inl i32[2]))`. From 27 the loop takes 111 steps,
-- more than 50; the first count of the input `ab\ncd\nef\n` is cut off after 3 observations
-- (three bytes read), and the second counts the two newlines left. `live 0`: the cut-off loops were
-- closed, and their state freed.

-- One step from `(n, k)`: `k` steps so far.
def collatz_step : !U (i32 * i32 -o F (i32 + (i32 * i32)) & F 1) =
  !thunkv fun (s : i32 * i32) ->
    < let (n, k) = s;
      case (unbang host[eq32]) (n, i32[1]) {
        inl other ->
          k2 <- return ((unbang host[add32]) (k, i32[1]));
          case (unbang host[eqz32]) ((unbang host[and32]) (n, i32[1])) {
            inl odd ->
              return (inr ((unbang host[add32]) ((unbang host[mul32]) (n, i32[3]), i32[1]), k2))
          | inr even -> return (inr ((unbang host[shr_u32]) (n, i32[1]), k2))
          }
      | inr one -> return (inl k)
      },
      let (n, k) = s;
      return () >

def collatz : i32 => U (loop i32 1) =
  thunkv fun (n : i32) ->
    f <- return (unbang (unfold[loop i32 1, i32 * i32] collatz_step));
    s0 : i32 * i32 <- return (n, i32[0]);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

-- The steps from `n`, if at most `fuel` observations reach 1.
total def collatz_within : i32 * i32 => i32 + 1 =
  thunkv fun (p : i32 * i32) ->
    let (n, fuel) = p;
    return (div_fuel[i32, 1] (collatz n, fuel))

def count_lines : In => In * i32 =
  thunkv fun (c : In) ->
    n : i32 <- return i32[0];
    for b in bytes c {
      n : i32 <- case (unbang host[eq32]) ((unbang host[extend8_u]) b, i32[10]) {
        inl u -> return n
      | inr u -> return ((unbang host[add32]) (n, i32[1]))
      };
      return ()
    };
    return (c, n)

-- The lines left, if at most `fuel` observations count them; the capability comes back either way.
total def lines_within : In * i32 => In * (i32 + 1) =
  thunkv fun (p : In * i32) ->
    let (c, fuel) = p;
    r <- return (div_fuel[In * i32, In * 1] (count_lines c, fuel));
    case r {
      inl q -> let (c2, n) = q; return (c2, (inl n : i32 + 1))
    | inr q -> let (c2, u) = q; return (c2, (inr () : i32 + 1))
    }

main : F (((i32 + 1) * (i32 + 1)) * ((i32 + 1) * (i32 + 1))) =
  a <- return (collatz_within (i32[27], i32[200]));
  b <- return (collatz_within (i32[27], i32[50]));
  c <- return (lines_within (&mut stdin, i32[3]));
  d <- return (lines_within (&mut stdin, i32[1000]));
  return ((a, b), (c, d))
