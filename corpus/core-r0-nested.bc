-- R0 (SPEC §54) in the core text: two abortive names, `1.0 aff i32 ~> 0` and `2.0 aff i32 ~> 0`,
-- raised by one function and handled by nested handlers. R0 rewrites one name at a time, inside
-- out: `2` first (its handler is the inner one), then `1`. `check`'s answer becomes the nested sum
-- `(i32 + i32) + i32`, the payload of `2` inside that of `1`.
--
-- Answer: (i32[5], (i32[101], i32[202])): `check` returns `5`, aborts `1.0` with `1` at `0`, which
-- the outer handler answers `100 + 1`, and aborts `2.0` with `2` at `1`, which the inner handler
-- answers `200 + 2`.

def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 aff i32 ~> 0, 2.0 aff i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz ->
        w <- return ((unbang host[eq32]) (x, i32[1]));
        case w {
          inl ne -> return x
        | inr eq -> abort[2.0] i32[2]
        }
    | inr isz -> abort[1.0] i32[1]
    }

def handled : !U (i32 -o F i32) =
  !thunkv fun (a : i32) ->
    handle_with[1](
        ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
        (((!thunkv fun (e : i32) -> return (plus (e, i32[100]))), ()) : !U (i32 -o F i32) * 1)) (
      handle_with[2](
          ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F[1.0 aff i32 ~> 0] i32)),
          (((!thunkv fun (e : i32) -> return (plus (e, i32[200]))), ()) : !U (i32 -o F[1.0 aff i32 ~> 0] i32) * 1))
        (f <- return (unbang check); force f a))

main : F (i32 * (i32 * i32)) =
  f <- return (unbang handled);
  a <- return i32[5];
  r1 <- force f a;
  g <- return (unbang handled);
  b <- return i32[0];
  r2 <- force g b;
  h <- return (unbang handled);
  c <- return i32[1];
  r3 <- force h c;
  return (r1, (r2, r3))
