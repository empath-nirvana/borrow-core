-- A copy (SPEC §34, *Files*): the file named by the first argument written to the one named by the
-- second, created or truncated, in chunks of one buffer of 64 KiB. Two files are open at once, so
-- the copy is written over the operations, whose sums it matches: a raising form would leave the
-- other file live across its raise (`corpus/reject/fs-two-files.bc`). Both files are closed, then
-- the first error is raised.
--
-- Answer, here: `corpus/no-such-file` is not found at every stage (`fs-cat`'s note), so
-- `fs-copy: corpus/no-such-file: not found` on standard error, and `i32[1]`; the destination is
-- never opened. `scripts/check-fs.sh` runs it on real files, over a longer file it truncates.
include fs
include textio

-- `src` copied to `dst`: the bytes copied.
fn copy_into(src: File, dst: File) -> i32 with Fs, Fail[FsError] =
  let mut src = src;
  let mut dst = dst;
  let mut b = string_new(65536);
  let mut n = 0;
  let r = for _ in 0..fs_max_reads {
    let (s2, (b2, x)) = fs_read(src, clear_str(b));
    src = s2;
    match x {
      inr e -> b = b2; break (inr e : 1 + FsError)
    | inl k ->
        if k == 0 { b = b2; break (inl () : 1 + FsError) } else {
          let (d2, (b3, y)) = fs_write(dst, b2);
          dst = d2;
          b = b3;
          n = n + k;
          match y { inr e -> break (inr e : 1 + FsError) | inl u -> () }
        }
    }
  } else { (inr TooBig : 1 + FsError) };
  let c1 = fs_close(src);
  let c2 = fs_close(dst);
  match r {
    inr e -> raise(e)
  | inl u -> match c1 {
      inr e -> raise(e)
    | inl u -> match c2 { inr e -> raise(e) | inl u -> n }
    }
  }

-- The error on standard error, naming the path.
fn report(path: string, e: FsError) -> string with Stderr =
  eprint_lit("fs-copy: ");
  borrow imm path { v -> eprint_bytes(v) };
  eprint_lit(": ");
  eprint_lit(fs_error_name(e));
  eprint_lit("\n");
  path

main -> i32 =
  let from = string_new(64);
  let (from, _) = next_arg(from);
  let to = string_new(64);
  let (to, _) = next_arg(to);
  let (from, a) = fs_open(from, Reading);
  match a {
    inr e -> let _ = report(from, e); 1
  | inl src ->
      let (to, b) = fs_open(to, Writing);
      match b {
        inr e -> let _ = fs_close(src); let _ = report(to, e); 1
      | inl dst ->
          match with to_result { copy_into(src, dst) } {
            inl n -> 0
          | inr e -> let _ = report(from, e); 1
          }
      }
  }
