-- P7's shape (`docs/strings-slices-design.md` §1) over numbers: an array of `i32` sorted in place
-- through a `mut` view, then searched through an `imm` one. `sort` (`lib/slice.bc`) is an
-- insertion sort: counted loops (SPEC §16) that read two neighbours through the `mut` view
-- (`peek`, a replace-and-restore over `slice_replace_mut`) and exchange them when they are out of
-- order (`slice_swap_mut`). The order is an argument, `cmp_i32`: there are no traits.
-- `binary_search` halves the range at each of at most 32 steps over the sorted view. The sorted
-- array is written out with `put_dec`.
--
-- Answer: `-9 -2 0 3 3 7 11 42` and a newline, then (i32[5], i32[5]): 7 is found at index 5,
-- and 5 is not there and would go at index 5, between the second 3 and the 7. The input order is
-- 42, 3, -9, 11, 0, 7, -2, 3: an unsorted element, a sort that compared unsigned (`-9` last) or
-- one that lost a duplicate would each print a different line. The sort and the search allocate
-- nothing and make no dispatched call: the two allocations are the array and the output
-- capability's cell.

include slice

fn data(i: i32) -> i32 =
  if i == 0 { 42 } else { if i == 1 { 3 } else { if i == 2 { 0 - 9 } else { if i == 3 { 11 }
  else { if i == 4 { 0 } else { if i == 5 { 7 } else { if i == 6 { 0 - 2 } else { 3 } } } } } } }

-- A signed number in decimal.
fn put_signed(o: Out, x: i32) -> Out =
  if x < 0 { let (o, _) = putb(o, 45); let (o, _) = put_dec(o, 0 - x); o }
  else { let (o, _) = put_dec(o, x); o }

-- Element `i` of the array, written out after a space (none before the first).
fn emit(i: i32, s: Out * array i32) -> Out * array i32 =
  let (o, a) = s;
  let x = borrow imm a { 'x, v -> at[i32](v, i, 0) };
  let o = if 0 < i { let (o, _) = putb(o, 32); o } else { o };
  (put_signed(o, x), a)

main -> i32 * i32 =
  let mut a = array_new[i32] (8, data);
  borrow mut a { 'x, v -> let v = sort[i32](v, cmp_i32, 0); () };
  let (stdout, a) = count_fold[Out * array i32] (emit, 8, 0, (stdout, a));
  putb(&mut stdout, 10);
  let r = borrow imm a { 'x, v ->
    let (v, w) = array_copy['x, i32] v;
    let p = match binary_search[i32](v, 7, cmp_i32) { inl i -> i | inr j -> 0 - 1 };
    let q = match binary_search[i32](w, 5, cmp_i32) { inl i -> 0 - 1 | inr j -> j };
    (p, q)
  };
  r
