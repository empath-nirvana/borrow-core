-- An `unwind` in one arm of an `if` inside a `while`: iterations 1 and 3 add `i` to `t` after the
-- `unwind`, iterations 2 and 4 add 10 in the other arm, so `t` is 1 + 3 + 20. Probe u12 of #1053.
--
-- KNOWN WRONG ANSWER (#1053): this prints i32[20]; the correct answer is i32[24]. Do not update this golden to "fix" it; fix #1053, then set the golden to the correct answer.
fn go() -> i32 =
  let mut i = 0;
  let mut t = 0;
  while i < 4 { i = i + 1; if i == 1 || i == 3 { x <- (i + 0) unwind (()); t = t + x } else { t = t + 10 } };
  t
main -> i32 = go()
