-- A div function taking a borrow, called from a borrow block (SPEC §14, borrow scopes over
-- loops). `total_at` sums a table at the elements of a generator, so it loops. `main` calls it
-- twice: lending the table's cell, `total_at(&t)`, and from inside a borrow block of the table,
-- `total_at(b)`.
--
-- A div function over a borrow is elaborated to take the owner and borrow it at each step
-- (`lend-server.bc`). Inside the block, the block's borrow passed to it is the place lent
-- instead: `total_at(b)` is `total_at(&t)`, and the block is lent per observation around the call,
-- so neither call holds a borrow across its loop.
--
-- Answer: i32[200]: the table holds 10 * i, and each call sums the entries 1 to 4, 100. A call
-- that saw the table empty gives 0; a block that borrowed the table once for the whole call is
-- not expressible.

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

gen fn range(lo: i32, hi: i32) -> i32 =
  let mut i = lo;
  while i < hi { yield i; i = i + 1 };
  ()

-- The sum of the entries at 1, 2, 3, 4.
def total_at : !(all 'a < top. imm 'a (array i32) => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (b : imm 'a (array i32)) ->
    let mut acc = 0;
    for i in range(1, 5) { acc = acc + get(b, i) };
    acc)

main -> i32 =
  let t = alloc(array_new[i32] (10, tab));
  let n = total_at(&t);
  let m = borrow imm t { b -> total_at(b) };
  n + m
