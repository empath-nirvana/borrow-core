-- check: old-backend-refuses
-- SPEC §27 in the core text: a stored `κ` whose cancel suspends, cancelled after its handler has
-- returned (the shape of `core-fin-stored-k-fin.bc`, the kernel's `stored-k-fin`, with a finaliser
-- that performs instead of raising). Handler 3 stores `κ` in the closure it answers; the closure
-- cancels it, outside the region. The region's finaliser performs `4.0`, whose live handler is
-- handler 4, outside: the cleanup suspends in the canceller (the closure's call), not in the
-- cancelled region, whose handlers are dead. `κ`'s cancel is a machine of `F[4.0, 4.0] 1`'s
-- outcome (Backend2's R4). Handler 4 resumes outside tail position.
--
-- Answer: inr (), and `live 0`: handler 4's clause turns the resumed `inl (inr ())` into `inr ()`.
-- A wrong implementation that skips the stored `κ`'s finaliser on the cancel answers
-- `inl (inr ())`.

main : F ((1 + 1) + 1) =
  handle_with[4](
      ((!thunkv fun (v : 1 + 1) -> return (inl v)) : !U (1 + 1 -o F ((1 + 1) + 1))),
      (((!thunkv fun (p : 1 * U ((1 -o F ((1 + 1) + 1)) & top)) ->
          let (u, k) = p; r <- (force k).1 u; case r { inl a -> return (inr ()) | inr b -> return (inr b) }), ())
        : !U (1 * U ((1 -o F ((1 + 1) + 1)) & top) -o F ((1 + 1) + 1)) * 1)) (
    g <- handle_with[3](
        ((!thunkv fun (v : 1) -> return (thunkv fun (c : 1 + 1) -> return (inl ())))
          : !U (1 -o F[4.0 lin 1 ~> 1] (U (1 + 1 -o F[4.0 lin 1 ~> 1] (1 + 1))))),
        (((!thunkv fun (p : (1 + 1) * U ((1 -o F[4.0 lin 1 ~> 1] (U (1 + 1 -o F[4.0 lin 1 ~> 1] (1 + 1)))) & F[4.0 lin 1 ~> 1, 4.0 lin 1 ~> 1] 1)) ->
          let (x, k) = p;
          return (thunkv fun (c : 1 + 1) -> case c {
              inl a -> u <- (force k).2; let () = u; return (inr ())
            | inr b -> w <- return (); g2 <- (force k).1 w; t : 1 + 1 <- return (inr ()); force g2 t })), ())
          : !U ((1 + 1) * U ((1 -o F[4.0 lin 1 ~> 1] (U (1 + 1 -o F[4.0 lin 1 ~> 1] (1 + 1)))) & F[4.0 lin 1 ~> 1, 4.0 lin 1 ~> 1] 1)
              -o F[4.0 lin 1 ~> 1] (U (1 + 1 -o F[4.0 lin 1 ~> 1] (1 + 1)))) * 1)) (
      y <- (a <- perform[3.0] (inr ()); perform[3.0] (inl ())) unwind (perform[4.0] ());
      return y);
    f : 1 + 1 <- return (inl ());
    force g f)
