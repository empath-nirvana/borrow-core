-- A `let mut` write in the continuation of an `unwind` inside the head of a `let` (an `if` whose
-- arm writes `t` and then gives 2): `t + r + 10` is 5 + 2 + 10. Probe u4 of #1053.
--
-- KNOWN WRONG ANSWER (#1053): this prints i32[12]; the correct answer is i32[17]. Do not update this golden to "fix" it; fix #1053, then set the golden to the correct answer.
fn go(b: bool) -> i32 =
  let mut t = 0;
  let r = if b { x <- (5 + 0) unwind (()); t = t + x; 2 } else { 0 };
  t + r + 10
main -> i32 = go(true)
