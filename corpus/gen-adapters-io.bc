-- check: no-source
-- Adapters of the library (#109, `lib/adapters.bc`) over an input: `line(stdin)` yields the
-- digits of one line of the input and finishes, or is closed, handing the input back, so each
-- adapter is instantiated at `K = R = In`. An adapter that stops its source (`take`,
-- `take_until`) closes it, which hands the input back with the rest of the line unread: the next
-- `line` reads that rest. The other adapters over an input are `corpus/gen-adapters-io2.bc`; the
-- pure sources are `corpus/gen-adapters.bc`, the failing ones `corpus/gen-adapters-fail.bc`.
--
-- The source interpreter takes about 20 s over it (`check: no-source`); the other stages run it.
--
-- Answer: on `corpus/gen-adapters-io.in`, i32[411603], read as 41, 16, 03, one loop to a line:
--   1234567  take 2 of skip 1 of filter above 5 of map squares: 1 4 9 16 25 36 49 → 9 16 25 36
--            49 → 16 25 36 49 → 16 25; closed after reading 5                      41
--   67       (the rest) enumerate of chain (scan sums) 0 1: 6 13 0 1 → 0 + 13 + 0 + 3   16
--   31729    flat_map n to 0 … n - 1 of take_until above 4: 3 1, closed at 7 → 0 1 2 0    3
-- A `take` that read one byte more leaves `7` for the second loop (0 in place of 16).

include adapters

gen fn line(c: In) -> i32, In =
  for b in bytes(&mut c) { if b == 10 { break } else { yield b - 48 } };
  c

gen fn range(lo: i32, hi: i32) -> i32 =
  let mut i = lo;
  while i < hi { yield i; i = i + 1 };
  ()

main -> i32 =
  let mut t = 0;
  for y in take(skip(filter(map(line(stdin), !{ x -> x * x }), !{ x -> x > 5 }), 1), 2) {
    t = t + y
  };
  t = t * 100;
  for p in enumerate(chain(scan(line(stdin), 0, !{ (s, x) -> s + x }), range(0, 2))) {
    let (i, x) = p;
    t = t + i * x
  };
  t = t * 100;
  for y in flat_map(take_until(line(stdin), !{ x -> x > 4 }), !{ n -> range(0, n) }) {
    t = t + y
  };
  t
