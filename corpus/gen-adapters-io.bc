-- check: no-source
-- Adapters of the library (#109, `lib/adapters.bc`) over an input: `line(stdin)` yields the
-- digits of one line of the input and finishes, or is closed, handing the input back, so each
-- adapter is instantiated at `K = R = In`. An adapter that stops its source (`take`,
-- `take_until`, `zip`) closes it, which hands the input back with the rest of the line unread: the
-- next `line` reads that rest. `from_iter` and `lines` read what is left of the input, as bytes.
-- The pure sources are `corpus/gen-adapters.bc`, the failing ones `corpus/gen-adapters-fail.bc`.
--
-- `main` has six loops, one state machine (SPEC §15). The source interpreter takes about 90 s over
-- it (`check: no-source`); the other stages run it.
--
-- Answer: on `corpus/gen-adapters-io.in`, (i32[411603], i32[220525]), one loop to a line:
--   1234567  take 2 of skip 1 of filter above 5 of map squares: 1 4 9 16 25 36 49 → 9 16 25 36
--            49 → 16 25 36 49 → 16 25; closed after reading 5                      41
--   67       (the rest) enumerate of chain (scan sums) 0 1: 6 13 0 1 → 0 + 13 + 0 + 3   16
--   31729    flat_map n to 0 … n - 1 of take_until above 4: 3 1, closed at 7 → 0 1 2 0    3
--   29       (the rest) zip (batch sums up to 10) (lengths of chunks of 2 of 0 … 4): 11
--            with 2                                                                     22
--   12345    lengths of chunks of 2: 2 2 1                                              5
--   ab, cde  lines of from_iter of the bytes: 2 lines (20) of 5 bytes                  25
-- A `take` that read one byte more leaves `7` for the second loop (0 in place of 16). A `batch`
-- that did not yield its last state when the source ended gives 0 for the 22; `lines` that
-- dropped a last line without a newline gives 12.

include adapters

type List = mu X. 1 + (i32 * X)
type Line = mu X. 1 + (u8 * X)

gen fn line(c: In) -> i32, In =
  for b in bytes(&mut c) { if b == 10 { break } else { yield to_i32(b) - 48 } };
  c

gen fn range(lo: i32, hi: i32) -> i32 =
  let mut i = lo;
  while i < hi { yield i; i = i + 1 };
  ()

fn len_alg(r: 1 + i32 * i32) -> i32 = match r { inl _ -> 0 | inr (x, n) -> n + 1 }
def len : !(List => i32) = fold_own[1 + i32 * X, i32] len_alg

fn len8_alg(r: 1 + u8 * i32) -> i32 = match r { inl _ -> 0 | inr (x, n) -> n + 1 }
def len8 : !(Line => i32) = fold_own[1 + u8 * X, i32] len8_alg

fn add_up(p: i32 * i32) -> i32 * bool =
  let (s, x) = p;
  if s + x >= 10 { (s + x, true) } else { (s + x, false) }

main -> i32 * i32 =
  let mut t = 0;
  for y in take(skip(filter(map(line(stdin), !{ x -> x * x }), !{ x -> x > 5 }), 1), 2) {
    t = t + y
  };
  t = t * 100;
  for p in enumerate(chain(scan(line(stdin), 0, !{ (s, x) -> s + x }), range(0, 2))) {
    let (i, x) = p;
    t = t + i * x
  };
  t = t * 100;
  for y in flat_map(take_until(line(stdin), !{ x -> x > 4 }), !{ n -> range(0, n) }) {
    t = t + y
  };
  let mut u = 0;
  for p in zip(batch(line(stdin), 0, add_up), map(chunks(range(0, 5), 2), len)) {
    let (x, y) = p;
    u = u + x * y
  };
  u = u * 100;
  for l in chunks(line(stdin), 2) { u = u + len(l) };
  u = u * 100;
  let mut n = 0;
  let mut m = 0;
  for l in lines(from_iter(bytes(stdin))) { n = n + 1; m = m + len8(l) };
  (t, u + n * 10 + m)
