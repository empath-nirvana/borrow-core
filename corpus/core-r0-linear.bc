-- R0 (SPEC §54) in the core text: a binding the program declares `linear`, at the row of an
-- abortive operation. `linear c <- force f a` binds the result of `fresh`, a cell, which the rest
-- frees. R0's `[let]` rule moves the binder into the `inl` arm of its `case` as
-- `linear c <- return r`, so it stays declared `linear`, and the guard checks it (G-qual).
--
-- Answer: (i32[5], i32[109]), and `live 0`.

def plus : i32 * i32 => i32 = unbang host[add32]

def fresh : !U (i32 -o F[1.0 aff i32 ~> 0] (ref i32)) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return (alloc[i32] x)
    | inr isz -> abort[1.0] i32[9]
    }

def use_cell : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    f <- return (unbang fresh);
    linear c <- force f a;
    return (free[i32] c)

def handled : !U (i32 -o F i32) =
  !thunkv fun (a : i32) ->
    handle_with[1](
        ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
        (((!thunkv fun (e : i32) -> return (plus (e, i32[100]))), ()) : !U (i32 -o F i32) * 1))
      (f <- return (unbang use_cell); force f a)

main : F (i32 * i32) =
  f <- return (unbang handled);
  a <- return i32[5];
  r1 <- force f a;
  g <- return (unbang handled);
  b <- return i32[0];
  r2 <- force g b;
  return (r1, r2)
