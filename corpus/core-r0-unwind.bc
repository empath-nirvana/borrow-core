-- R0 (SPEC §54) in the core text: a finaliser the program writes, on the abort path. `use_cell`
-- calls `check`, at the row of the abortive operation `1.0 aff i32 ~> 0`, with a cell `c` live
-- across the call, and writes the finaliser that frees `c` (`unwind`). R0's `[then]` rule runs
-- that finaliser once, first, in the abort arm of the `case` it writes, and the guard checks it
-- is there (G-fin). When the call returns, the rest frees `c` itself.
--
-- Answer: (i32[8], i32[107]), and `live 0`: at `5` the rest adds the cell's `3`; at `0` the call
-- aborts with `7`, the finaliser frees the cell, and the handler adds `100`.

def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

def use_cell : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    c <- return (alloc[i32] i32[3]);
    f <- return (unbang check);
    v <- force f a unwind (
      w <- return (free[i32] c);
      return ());
    x <- return (free[i32] c);
    return (plus (v, x))

def handled : !U (i32 -o F i32) =
  !thunkv fun (a : i32) ->
    handle_with[1](
        ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
        (((!thunkv fun (e : i32) -> return (plus (e, i32[100]))), ()) : !U (i32 -o F i32) * 1))
      (f <- return (unbang use_cell); force f a)

main : F (i32 * i32) =
  f <- return (unbang handled);
  a <- return i32[5];
  r1 <- force f a;
  g <- return (unbang handled);
  b <- return i32[0];
  r2 <- force g b;
  return (r1, r2)
