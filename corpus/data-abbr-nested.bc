-- Recursion through abbreviations that name abbreviations (SPEC §42, §61): `Bag[T]` is the
-- program's `Map[i32, Pair[T]]`, `Map` the library's. Each is opened at its arguments, one inside
-- the other, so `T` occurs under the array of the map's values, in a pair: `Node` is not a block
-- and is built without `box`, and `T` elaborates to
-- `mu X. i32 + (array (1 + i32 * i32) * array (X * X)) * i32`, in the fold class `P`.
--
-- Answer: i32[7]. `sum` reads the pair under the key 1, `(Leaf(2), Leaf(5))`, and adds it; the
-- pair under the key 2 is consumed with the map. `live 0`. An implementation that opens only the
-- outer abbreviation refuses `Bag[T]` or misreads `Pair`; one that reads `Node` as a block asks for
-- `box`; one whose consume skips the pairs left in the map leaves `live` above 0.
include rec
include map

type Pair[A] = A * A
type Bag[A] = Map[i32, Pair[A]]

data T = Leaf(i32) | Node(Bag[T])

fn sum(t: T) -> i32 = match t {
    Leaf(n) -> n
  | Node(m) ->
      let (m, o) = map_remove(m, 1);
      match o { inl (a, b) -> sum(a) + sum(b) | inr u -> 0 }
  }

main -> i32 = with on_exhausted(!{ u -> 0 - 1 }) {
  let m = map_new[i32, Pair[T]](4);
  let (m, _) = map_insert(m, 1, (Leaf(2), Leaf(5)));
  let (m, _) = map_insert(m, 2, (Leaf(100), Node(map_new[i32, Pair[T]](2))));
  sum(Node(m))
}
