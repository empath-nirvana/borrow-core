-- A worker pool whose workers share a read-only configuration (SPEC §32; #479's
-- `corpus/pending/async-worker-pool.bc`, on `spawn_in`). `main` owns the configuration (a scale
-- and an offset) and lends it `imm`; each worker holds a copy of the borrow across its `await`s,
-- reads the configuration through it once and processes its jobs, awaiting after each. The tasks
-- are spawned by `spawn_in` inside a unit cell's scope `'d` below the borrow, so their
-- continuations are boxed below it, and `run_in` runs them for at most 8 rounds inside the borrow;
-- the configuration is freed after. `worker`'s counted loop awaits, so it is a loop at the row
-- (SPEC §30). No borrow is lent across an `await`: `assurance: unconditional`.
--
-- Answer: `(inr (i32[63], inr (i32[92], inl ())), i32[155])`: the totals [63, 92] (jobs 1, 2, 3
-- at scale 10 plus offset 1: 10 + 20 + 30 + 3; jobs 4, 5: 40 + 50 + 2) and their sum; `live 0`.
include async

type Config = i32 * i32

-- `jobs` consecutive job numbers from `first`, each scaled and offset, awaiting after each.
fn worker<'c>(cfg: imm 'c Config, first: i32, jobs: i32) -> i32 with Async =
  let (scale, offset) = *cfg;
  let mut sum = 0;
  for i in 0..jobs {
    sum = sum + (first + i) * scale + offset;
    await()
  };
  sum

main -> List[i32] * i32 =
  let cfg = alloc((10, 1));
  let d = alloc(());
  let (d, totals) = borrow imm cfg { 'r, c ->
    let totals = borrow mut d { 'd, e ->
      let (c1, c2) = copy['r, Config] c;
      let q = queue_in[i32]();
      let q = push_in(q, with spawn_in { worker(c1, 1, 3) });
      let q = push_in(q, with spawn_in { worker(c2, 4, 2) });
      with on_exhausted(!{ u -> nil() }) { run_in(q, 8) } };
    (d, totals) };
  let _ = free(d);
  let (scale, offset) = free(cfg);
  let sum = with on_exhausted(!{ u -> 0 }) { fold(clone(totals), 0, !{ (a, x) -> a + x }) };
  (totals, sum)
