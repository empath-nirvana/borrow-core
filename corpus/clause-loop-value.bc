-- Loops in a handler's clauses (#971). A `for` body's last expression is the body's value, and
-- printed back it must still read as that value, not as the loop's `return`, the exit from the
-- clause: the printed program reads back (`bcc parse`, SPEC §41). The `wait` clause sums
-- `0..4` in a `for` and counts `2 * 5` steps in two nested ones; the `ask` clause leaves its `for`
-- by `return` at `i == 2`, which exits the clause with `10 * i`.
--
-- Answer: `(i32[16], i32[20])`: `wait` resumes with `6 + 10` (`0 + 1 + 2 + 3`, then the nested
-- loops' count) and `ask` answers `20` from its first exit. Before #971 the printed program did not
-- read back: a `for` body's last `()` printed as `return ()`, which reads as the exit.

effect Wait { ctl wait() -> i32 }
effect Ask { ctl ask() -> i32 }

handler sum_up[A]: Wait, A -> A = {
  return(x) = x;
  wait(k) = {
    let mut s = 0;
    for i in 0..4 { s = s + i };
    let mut t = 0;
    for j in 0..2 { for m in 0..5 { t = t + 1 } };
    k(s + t)
  }
}

handler first_exit: Ask, i32 -> i32 = {
  return(x) = x;
  ask(k) = {
    for i in 0..5 { if i == 2 { return 10 * i } };
    0
  }
}

fn waits() -> i32 with Wait = wait()
fn asks() -> i32 with Ask = ask() + 1

main -> i32 * i32 = (with sum_up[i32] { waits() }, with first_exit { asks() })
