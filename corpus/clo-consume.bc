#! dialect 82
# Consuming a closure (SPEC §22) runs its `close`. A closure is linear and consumable
# (SPEC §12, group 2): `close`, which disposes of the state. `k` is never called and `k2`'s rest
# is never used again, so the checker inserts their consumes at the end of the scope, and each
# `close` frees its counter's cell. `nest` is a closure whose state is another closure: its
# `close` closes the closure it holds, so consuming it frees that counter's cell too. Its bound is
# the bound `'c` of the closure it holds (SPEC §23, the box rule non-strict); it is built with
# `clo_new` and `boxed['c]`, since `clo_new_boxed`'s bound would put its `'c` strictly below.
#
# Answer: i32[3], and `live 0`. A consume that forgot a closure without running its `close` leaves
# its counter's cell live (`live 3` if none ran).

import clo

fn counter<'c>(start: i32) : box 'c Clo[i32, i32]<'c> =
  clo_new_boxed[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        let cx = (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        let cu = (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        (x + a, c1),
      let n = (free[i32] s); () >)

fn nest<'c>(k: sink box 'c Clo[i32, i32]<'c>) : box 'c Clo[i32, i32]<'c> =
  boxed['c] clo_new[box 'c Clo[i32, i32]<'c>, i32, i32]['c](k, !thunkv fun (s : box 'c Clo[i32, i32]<'c>) ->
    < fun (a : i32) ->
        let p = (clo_call(s, a));
        let (b, r) = p;
        (b, boxed['c] r),
      (clo_close(s)) >)

fn main() : i32 {
  let k = counter(7)
  let k2 = counter(1)
  let (a, k2) = clo_call(k2, 2)
  let o = nest(counter(5))
  a
}
