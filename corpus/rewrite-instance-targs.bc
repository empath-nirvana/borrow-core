-- A `def` with a type parameter used at a type argument that names a lifetime of its use's
-- context (#684 review, F1): `ident[imm 'x i32]` under the borrow's `Fun 'x`. The rewriter's
-- read-back declares that instance polymorphic in the context's lifetimes and instantiates it at
-- the use (SPEC §54, step 0).
--
-- Answer: i32[7].

def ident[A] : !(A => A) = !thunkv fun (x : A) -> return x

main : F i32 =
  c <- return (alloc[i32] i32[7]);
  q <- return (withbor1['x, i32, i32] c (thunkv Fun 'x < dom. return (thunkv fun (b : imm 'x i32) ->
         b2 <- return ((unbang ident[imm 'x i32]) b);
         r <- return (withload['x, 'z, i32, i32] b2 (thunkv Fun 'z < dom. return (thunkv fun (v : i32) ->
                return (boxed['z] v))));
         return (boxed['x] r))));
  let (c, n) = q;
  return n
