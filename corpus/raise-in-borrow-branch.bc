#! dialect 82
# A raise or a division as a branch's value, the last computation of a borrow block's body: the
# branch never returns, so nothing of it is boxed at the block's lifetime.
import fail

fn per(c: sink ref i32, d: i32) : ref i32 * i32 / Fail[i32] {
  let q = borrow imm c { v -> if d == 0 { raise(d) } else { *v } };
  (c, q)
}

fn scale(c: sink ref i32, d: i32) : ref i32 * i32 / Fail[DivError] {
  let q = borrow imm c { v -> *v / d };
  (c, q)
}

fn go(d: i32) : i32 + i32 =
  handle { let (c, q) = per(alloc(4), d); let x = free(c); q } with to_result

fn go2(d: i32) : i32 + DivError =
  handle { let (c, q) = scale(alloc(12), d); let x = free(c); q } with to_result

fn main() : (i32 + i32) * ((i32 + i32) * ((i32 + DivError) * (i32 + DivError))) =
  (go(0), (go(2), (go2(0), go2(3))))
