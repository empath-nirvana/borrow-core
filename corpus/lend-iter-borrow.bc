-- A generator that holds a borrow it is given and reads it at each turn, iterated by a `for` inside
-- a borrow block. The block's body loops (the generator's `while`), so its lend is held across the
-- loop's ticks, at the graded row `div call` (SPEC §63); the `for` is a handler around the
-- generator's call (SPEC §64), so `yield` is handled inside the lend. The generator's loop reads
-- `b` at each turn: the checker copies the `imm` borrow for each use (`copy`, SPEC §66).
--
-- Answer: `i32[60]`, `live 0`: the table holds 10 * i, and the generator yields the entries at 0,
-- 1, 2, 3.

include yield

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

fn over<'a>(b: imm 'a (array i32), n: i32) -> 1 with Yield[i32] =
  let mut i = 0;
  while i < n { yield(get(b, i)); i = i + 1 };
  ()

main -> i32 =
  let t = alloc(array_new[i32] (10, tab));
  let n = borrow imm t { b ->
    let mut acc = 0;
    for x in over(b, 4) { acc = acc + x };
    acc
  };
  n
