-- P2 of `docs/strings-slices-design.md` (§1), `parse-int`: integers from text, checked. Each input
-- line is read into a reused buffer and lent as a view; `parse_int` walks its bytes with a counted
-- loop, widening each digit (`to_i32`) and multiplying and adding with overflow checks
-- (`mul_checked`, `add_checked`, over `i64`). An error is raised (`Fail`, `lib/fail.bc`): `inl ()` for
-- no digits, `inr (inl b)` for the byte `b` that is not a digit, `inr (inr ())` for a value past
-- `i32`, and an overflow of the checked operations is raised as that last (`map_err`). The loop
-- over the digits is a counted `for` over the view; a `raise` in it leaves it by its exit. `main`
-- branches on `to_result`. `data` with a payload waits for stage S6, so the error is the sum itself.
--
-- Answer: on `parse-int.in`, each line's number or error (`empty`, `bad` and the byte, `overflow`),
-- and `i32[158]`, the sum of the numbers parsed. A digit not widened, an overflow not caught or a
-- sign dropped changes a line.

include textio

type Err = 1 + (u8 + 1)

-- A decimal integer with an optional leading `-`.
fn parse_int<'a>(t: text 'a) -> i32 with Fail[Err] =
  let (t, u) = array_copy['a, u8] t;
  let neg = at(u, 0, b' ') == b'-';
  let t = if neg { match split_at(t, 1) { inl (h, r) -> array_forget['a, u8](h); r | inr t -> t } }
    else { t };
  let (t, w) = array_copy['a, u8] t;
  if len(w) == 0 { array_forget['a, u8](t); raise(inl ()) } else {
    let mut n = 0;
    for x in t {
      let d = *x;
      if d < b'0' || b'9' < d { raise(inr (inl d)) } else { () };
      let m = with map_err(!{ u -> inr (inr ()) }) { mul_checked(n, 10) };
      n = with map_err(!{ u -> inr (inr ()) }) { add_checked(m, to_i32(d) - 48) }
    };
    if neg { 0 - n } else { n }
  }

-- A number in decimal, with a `-` when it is negative.
fn put_int(o: Out, n: i32) -> Out =
  if n < 0 { let (o, _) = putb(o, b'-'); let (o, _) = put_dec(o, 0 - n); o }
  else { let (o, _) = put_dec(o, n); o }

main -> i32 =
  let mut line = box buf[u8](32);
  let mut sum = 0;
  for b in bytes(&mut stdin) {
    if b == b'\n' {
      borrow imm line { v ->
        match with to_result { parse_int(v) } {
          inl n -> let stdout = put_int(stdout, n); sum = sum + n
        | inr e -> match e {
            inl u -> write_lit(&mut stdout, "empty")
          | inr e -> match e {
              inl c -> write_lit(&mut stdout, "bad "); putb(&mut stdout, c)
            | inr u -> write_lit(&mut stdout, "overflow")
            } }
        } };
      putb(&mut stdout, b'\n');
      line = clear_str(line)
    } else { push(&mut line, b) }
  };
  sum
