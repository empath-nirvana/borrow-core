#! dialect 82
# `x <- M` where `x` is a `let mut` variable assigns it the value of `M` (SPEC §41, rule R2), in an
# arm as on the spine.
#
# Answer: (i32[5], i32[3]).
fn main() : i32 * i32 {
  var x = 1
  if x == 1 { x = 5; () } else { () }
  var n = 0
  for i in 0..3 { n = (n + 1); () };
  (x, n)
}
