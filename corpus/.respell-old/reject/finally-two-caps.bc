-- expect: 16:50: a `finally` using two lent places (`Count`, `stdout`) has no kernel form yet (#1102, #1046)
-- A `finally` that uses two capabilities the reborrow would hand back (SPEC §78 *Open*, #1102): a
-- finaliser gets one source back, and an unwinding lend of two places is not a kernel form yet.

include io
include fail

effect Count { fn tick() -> i32 }

handler count(mut n: i32): Count = { tick() = { n = n + 1; n } }

fn work() -> i32 with Stdout, Count = print_byte(to_u8(65)); tick()

main -> i32 + u8 =
  with count(0) {
    with to_result[u8, i32] { work() } finally { print_byte(to_u8(66)); let t = tick(); () }
  }
