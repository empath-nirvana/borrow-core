-- [spec §80] An unwinding local: the scope divides by a variable and aborts on zero. The local
-- starts at 10 and is bumped to 11; `100 / d` is then added to it, or, at `d = 0`, the scope aborts
-- with the value it read. The unwind frees the local (its finaliser) and the handler answers the
-- error.
--
-- Answer: (inl (i32[36], i32[25]), inr i32[10]), and `live 0` on both paths.

def scaled : i32 => (i32 * i32) + i32 =
  thunkv fun (d : i32) ->
    handle_with[1](
        ((!thunkv fun (p : i32 * i32) -> return (inl p)) : !U (i32 * i32 -o F ((i32 * i32) + i32))),
        (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F ((i32 * i32) + i32)) * 1)) (
      w <- return withlocalu['x, top, i32, i32, [1.0 cancel i32 ~> 0]];
      cb : U (forall 'x < dom. mut 'x i32 -o F[1.0 cancel i32 ~> 0] (box 'x i32)) <- return
        (thunkv Fun 'x < dom. fun (m : mut 'x i32) ->
          p <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) ->
            return ((unbang host[add32]) (v, i32[1]), v)));
          let (m, old) = p;
          case (unbang host[div_s32]) (i32[100], d) {
            inl y ->
              p <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) ->
                return ((unbang host[add32]) (v, y), v)));
              let (m, c) = p;
              let () = release_mut['x, i32] m;
              return (boxed['x] y)
          | inr u -> let () = u;
              let () = release_mut['x, i32] m;
              abort[1.0] old
          });
      v <- return i32[10];
      force w v cb)

main : F (((i32 * i32) + i32) * ((i32 * i32) + i32)) =
  a <- return (scaled i32[4]);
  b <- return (scaled i32[0]);
  return (a, b)
