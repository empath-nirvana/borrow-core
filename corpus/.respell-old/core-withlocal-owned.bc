-- [spec §80] freeing the local wrapper returns its owned contents; it does not destroy them.
-- Expected (final contents' payload, body answer): (i32[42], i32[7]), live 0.
main : F (i32 * i32) =
  q <- return (withlocal['l, top, ref i32, i32] (alloc[i32] i32[41])
    (thunkv Fun 'l < dom. return (thunkv fun (m : mut 'l (ref i32)) ->
      p <- return (withswap['l, ref i32, i32] m (thunkv fun (old : ref i32) ->
        v <- return (free[i32] old);
        return (alloc[i32] ((unbang host[add32]) (v, i32[1])), i32[7])));
      let (m, answer) = p;
      let () = release_mut['l, ref i32] m;
      return (boxed['l] answer))));
  let (inner, answer) = q;
  return (free[i32] inner, answer)
