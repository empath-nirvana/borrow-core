-- Integers (section 8a): literals, host operations applied at value level, a test and a
-- partial division whose `inr` is where Wasm traps.

def plus : i32 * i32 => i32 = unbang host[add32]

main : F i32 =
  x <- return i32[40];
  y <- return i32[0x2];
  s <- return (plus (x, y));
  w <- return ((unbang host[wrap]) i64[4294967301]);
  case (unbang host[lt_s32]) (s, i32[100]) {
    inl u -> return w
  | inr u ->
      d <- return ((unbang host[div_s32]) (s, i32[7]));
      case d { inl q -> return q | inr t -> return i32[0xFFFFFFFF] }
  }
