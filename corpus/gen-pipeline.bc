-- Generators composed: a `range` written with `while`, a map (`squares`) and a filter (`above`)
-- written as generators over a stored generator, and a `for` that sums the pipeline.
--
-- Each generator's body is one loop, and each is one state machine whose observation runs one
-- turn of the loop. `squares` and `above` take a stored generator (`pull i32 1 1`), so each call
-- in the pipeline is stored where it is passed, and observed by the loop it is passed to; `main`'s
-- `for` handles `above`'s `yield`s. Every observation is a call of known code: the pipeline
-- allocates nothing and makes no dispatched call (`corpus/counts.expected`: 0 and 0).
--
-- Answer: i32[355], the squares from 1 to 10 that are above 20: 25 + 36 + 49 + 64 + 81 + 100. A
-- range that stopped one early gives 255; a filter that kept everything gives 385; a map that
-- yielded the element instead of its square gives 0 (nothing above 20).

include yield

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn squares(it: U (pull i32 1 1)) -> 1 with Yield[i32] =
  for x in it { yield(x * x) };
  ()

fn above(n: i32, it: U (pull i32 1 1)) -> 1 with Yield[i32] =
  for x in it { if n < x { yield(x) } else { () } };
  ()

main -> i32 =
  let mut acc = 0;
  for x in above(20, squares(range(1, 11))) { acc = acc + x };
  acc
