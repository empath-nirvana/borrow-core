-- expect: 19:11: this borrow block's result has type `imm 'x array i32 * i32`, which has the block's lifetime `'x`: nothing borrowed at `'x` outlives the block. When the body loops, each step borrows the place again, so the loop cannot keep what is borrowed before it (SPEC §14, borrow scopes over loops)
-- A borrow block over a loop whose loop keeps something borrowed before it (SPEC §14, borrow
-- scopes over loops). The block is lent per observation: the stretch before the loop borrows the
-- table for itself, and hands on to the loop what it binds, here `b2`, the borrow itself. Nothing
-- borrowed at `'x` outlives that stretch's borrow, so the loop cannot hold it between steps; the
-- loop must use `b`, which each step borrows again.

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

main -> i32 =
  let t = alloc(array_new[i32] (10, tab));
  let n = borrow imm t { 'x, b ->
    let b2 = b;
    let mut acc = 0;
    for c in bytes(&mut stdin) { acc = acc + get(b2, c - 48) };
    acc
  };
  n
