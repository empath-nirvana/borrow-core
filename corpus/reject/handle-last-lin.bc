-- expect: 12:3: the operations of `handle_last` are at the count `1?` or `0`
-- `handle_last`'s clause may cancel `κ`, so its operations are at the count `1?` or abortive
-- (`effHandleL`'s `hAff`, SPEC §51, §54). This one names its operation `lin` (the count `1`):
-- refused.

def ask : !U (1 -o F[2.0 lin 1 ~> i32] i32) =
  !thunkv fun (u : 1) -> perform[2.0] u

main : F i32 =
  f <- return (unbang ask);
  u <- return ();
  handle_last[2: lin](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      ((((!thunkv fun (w : 1) -> let () = w; return (inl i32[10])), ()) : !U (1 -o F (i32 + 1)) * 1),
       (((!thunkv fun (z : 1) -> let () = z; return i32[0]), ()) : !U (1 -o F i32) * 1)))
    (force f u)
