#! dialect 82
# An abort while a value that is not consumable is live (SPEC §19): the thunk `k` can be disposed of
# only by running it (SPEC §12, group 3), and the call of `fail_if` may abort while it is live, so
# the finaliser of that abort cannot consume it. Handing such a value to the handler with the error
# is not provided.
# expect: 14:11: `k`, of type `U (F (1 + 1))`, is live across a computation that may abort, and its type is linear and not consumable, and an abort abandons only a value that holds no owned cell
import fail
type B = 1 + 1

fn fail_if(n: i32) : i32 / Fail[i32] = if n < 0 { raise(n) } else { n }

fn check(n: i32) : i32 / Fail[i32] {
  let k = (thunk ((inl () : B)))
  let m = fail_if(n)
  let b = force k
  m
}

fn main() : i32 + i32 = handle { check(3) } with to_result
