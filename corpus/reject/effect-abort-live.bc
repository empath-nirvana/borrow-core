-- An abort while a value with no destructor is live (SPEC §19): the thunk `k` can be disposed of
-- only by running it (SPEC §12, group 3), and the call of `fail_if` may abort while it is live, so
-- the finaliser of that abort cannot drop it. Handing such a value to the handler with the error
-- is not provided.
-- expect: 13:11: `k`, of type `U (F (1 + 1))`, is live across a computation that may abort, and its type is linear with no derived drop, and an abort abandons only a value that holds no owned cell
include fail
type B = 1 + 1

fn fail_if(n: i32) -> i32 with Fail[i32] = if n < 0 { raise(n) } else { n }

fn check(n: i32) -> i32 with Fail[i32] =
  let k = (thunk (return (inl () : B)));
  let m = fail_if(n);
  b <- force k;
  return m

main -> i32 + i32 = with to_result { check(3) }
