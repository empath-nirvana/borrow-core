#! dialect 82
# expect: 15:34: `break e` gives the value of a `for` whose value is bound: `let r = for x in … { … }; …`
# `break e` gives a value to the loop it leaves; a `for` that is a statement has none to give.

import yield

fn upto(n: i32) : i32 / Yield[i32] {
  var i = 0
  while i < n { yield(i); i = i + 1 }
  n
}

fn main() : i32 {
  var acc = 0
  for x in upto(5) { if x == 3 { break 7 } else { acc = acc + x } }
  acc
}
