-- A callback that binds a variable it captures again, called inside a control handler (SPEC
-- §22): its environment comes back from each call, but not from a body the handler abandons, as a
-- `let mut` variable assigned in the body of a control `with` does not (§18). State a callback
-- keeps across an abort belongs in a handler's capability, which is lent again to the body.
-- expect: 8:54: a callback called in the body of `with to_result` binds again a variable it captures: the body may be abandoned, and the variable would not come back; keep that state in a handler's capability instead (SPEC §22)
include fail

fn guarded(f: !(1 => 1) with Fail[i32]) -> 1 + i32 = f() |> to_result

fn check(x: i32) -> 1 with Fail[i32] = if x > 2 { raise(x) } else { () }

main -> i32 =
  let mut n = 0;
  let r = guarded({ u -> n = n + 1; check(n) });
  n
