-- Use after free: the cell `r` is freed, then swapped.
type B = 1 + 1

main : F B =
  r <- return (alloc[B] (inl ()));
  x <- return (free[B] r);
  q <- return (swap[B, B] r x);
  let (r2, y) = q;
  return (free[B] r2)
-- expect: 6:3: `r` is used twice here, and its type `ref (1 + 1)` is not persistent
