-- The arms of a `case` consume different variables: the thunk `k` is run in one arm only. A
-- cell would be consumed in the other arm (SPEC §12), but a thunk is not consumable.
type B = 1 + 1

main : F B =
  k <- return (thunk (return (inl () : B)));
  c <- return (inl () : B);
  case c {
    inl u -> force k
  | inr u -> return (inr u : B)
  }
-- expect: 8:3: in this `case`, `k` is consumed in the `inl` arm but not in the `inr` arm, and its type `U (F (1 + 1))` is linear and is not consumable
