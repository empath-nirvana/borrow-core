-- expect: 9:3: `v` is used twice here, and its type `array_mut 'a i32` is linear
-- A mutable view used twice inside a callee called from a borrow block (#145, #167): the double
-- use is reported where it is, in `survey`, not at the block that calls it. A `mut` borrow has no
-- derived copy; an `imm` view used twice is copied (`corpus/imm-copy-view.bc`).

include slice

fn survey<'a>(v: array_mut 'a i32) -> i32 =
  let (v1, n) = len_mut(v);
  let (v2, m) = len_mut(v);
  n + m

fn data(i: i32) -> i32 = i

main -> i32 =
  let mut a = array_new[i32] (3, data);
  let s0 = borrow mut a { 'x, v -> survey(v) };
  s0
