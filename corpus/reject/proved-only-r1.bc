-- check: proved-only
-- expect: 11:3: --proved-only: main's typing rests on a hypothesis, not a theorem: R1 at 11:3 rests on PinLaw.lendFrame (LendFrame, RQ1) (Core/Assumptions.lean, issue #1122)
-- SPEC §29: `bcc check --proved-only` refuses a `main` whose assurance is not `unconditional`,
-- naming each relaxed rule's hypothesis and research question (Core/Assumptions.lean, issue
-- #1122). The generator of `corpus/async-r1-drain.bc`: its `borrow mut` across `yield` is R1,
-- whose soundness rests on `PinLaw.lendFrame` (RQ1). Without the flag it checks.
include yield

fn selfref() -> 1 with Yield[i32] =
  let c = alloc(5);
  borrow mut c { m ->
    let a = modify m { v -> (v, v) };
    yield(a);
    modify m { v -> v + 1 };
    let b = modify m { v -> (v, v) };
    yield(b);
    ()
  };
  let _ = free(c);
  ()

fn sum_all(it: U (pull i32 1 1)) -> i32 =
  let mut acc = 0;
  for x in it { acc = acc + x };
  acc

main -> i32 =
  sum_all(selfref())
