-- expect: 11:3: this borrow block's body performs the operation 1.0, which resumes: only an abortive operation crosses a borrow's scope (a continuation held across a lend is T1, #172)
-- A generator that would hold a borrow of its own local across a `yield` (a self-reference,
-- which Rust's generators forbid and its `async` needs `Pin` for). A borrow block's body may
-- perform only abortive operations (SPEC §19): `yield` resumes, and a continuation held across a
-- lend is T1 (#172). What is allowed is to own the cell in the generator's state and borrow it
-- anew at each step (`corpus/gen-cell.bc`).

include yield

fn selfref() -> 1 with Yield[i32] =
  let c = alloc(5);
  borrow imm c { 'x, b ->
    yield(*b);
    ()
  };
  free(c)

main -> i32 =
  let mut acc = 0;
  for x in selfref() { acc = acc + x };
  acc
