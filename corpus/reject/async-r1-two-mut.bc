-- expect: 11:5: `m` is used twice here, and its type `mut 'io_l0 i32` is not persistent
-- SPEC §29 (docs/async-capabilities.md §6.2 row 2, `n2`): two tasks holding `mut` borrows of one
-- cell. Inside a relaxed lend, the view `m` is moved into two values that cross the suspension,
-- a task's state each. A `mut` view is linear (B6): the second is a second use. R1 lends an
-- owned place once and copies no view.
include yield

fn two() -> i32 with Yield[i32] =
  let c = alloc(1);
  let v = borrow mut c { m ->
    let task1 = (m, 1);
    let task2 = (m, 2);
    yield(1);
    let (m1, k1) = task1;
    let (m2, k2) = task2;
    modify m1 { x -> x + k1 };
    modify m2 { x -> (x + k2, x + k2) }
  };
  let _ = free(c);
  v

fn stop(it: U (pull i32 i32 1)) -> 1 = (nu_out (force it)).2

main -> i32 =
  let g : U (pull i32 i32 1) = two();
  stop(g);
  0
