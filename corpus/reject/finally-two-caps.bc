#! dialect 82
# expect: 18:57: a `finally` using two lent places (`Count`, `stdout`) has no kernel form yet (#1102, #1046)
# A `finally` that uses two capabilities the reborrow would hand back (SPEC §78 *Open*, #1102): a
# finaliser gets one source back, and an unwinding lend of two places is not a kernel form yet.

import io
import fail

effect Count { tick() : i32 }

handler count(mut n: i32): Count { tick() -> { n = n + 1; n } }

fn work() : i32 / Stdout + Count { print_byte(to_u8(65)); tick()
}

fn main() : i32 + u8 =
  handle {
    handle { work() } with to_result[u8, i32] finally { print_byte(to_u8(66)); let t = tick(); () }
  } with count(0)
