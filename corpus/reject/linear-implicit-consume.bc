-- A declared type that is not consumable (SPEC §42), left unused at the end of its scope. The
-- checker inserts a consume only as a `consume` node, whose derivation carries `Consumable`
-- (`TDerivesP.consume_consumable`, `consumeSlot_derives`), and `Txn` has none (`decl_linear`). Refused.
data Txn = { id: i32, must_close(commit) log: i32 }

fn begin(id: i32) -> Txn = Txn { id: id, log: 0 }

fn commit(t: Txn) -> i32 = match t { Txn { id, log } -> id * 100 + log }

main -> i32 =
  let t = begin(7);
  5
-- expect: 11:7: `t` is not consumed in its scope, and its type `i32 * i32 * tok` is linear and is not consumable: `Txn` holds the field `log`, marked `must_close`; pass it to `commit` before its scope ends
