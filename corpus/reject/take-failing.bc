-- expect: 15:17: this argument of `take` returns `i32 + 1`, which is not `1`
-- `take` stops its source early, cancelling it, which hands nothing back: its source returns `1`
-- (`lib/adapters.bc`, SPEC §55). A source that fails returns an error (`i32 + 1`): cancelled by
-- `take` before it computed one, it has no error to report, and `take` nothing to return.

include adapters

fn upto(lo: i32, hi: i32, bad: i32) -> i32 + 1 with Yield[i32] =
  let mut i = lo;
  while i < hi && i != bad { yield(i); i = i + 1 };
  if i == bad { (inl i : i32 + 1) } else { (inr () : i32 + 1) }

main -> i32 =
  let mut t = 0;
  for y in take(upto(0, 10, 4), 2) { t = t + y };
  t
