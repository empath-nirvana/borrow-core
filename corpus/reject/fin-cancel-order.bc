-- Where an inserted cancel goes (SPEC §12's insertion policy, §27; #953). `timeout`'s clause logs
-- `1` and answers `inr ()` without using its continuation, whose cancel performs (the body's
-- `finally` raises `3`). The elaboration cancels it where §12 places a consume of an unused
-- variable: at the end of the clause's path, after its effects, just before `inr ()`. So `k` is
-- live across `log(1)`, an operation at a row that holds an abortive one, and `k` is linear and
-- not consumable (its cancel performs): the kernel refuses it, as it refuses any such value live
-- across a computation that may abort. A cancel inserted first would be accepted; the refusal
-- shows it is not. The same order, at a row with no abortive operation, runs at the source stage
-- (`log(1)` then the cancel's `log(2)`), but no backend lowers a cleanup that performs a control
-- operation yet (#869), so it is not a corpus program. Refused.

include fail

effect Log { must_resume ctl log(x: i32) }
effect Wait { ctl wait() }

handler log_sum[A]: Log, A -> A * i32 = {
  return(x) = (x, 0);
  log(x, k) = { let (a, s) = k(()); (a, s + x) }
}

handler timeout[A]: Wait, A -> A + 1 with Log = { return(x) = inl x; wait(k) = { log(1); inr () } }

fn work() -> i32 with Wait = wait(); 5

main -> ((i32 + 1) + i32) * i32 =
  with log_sum[(i32 + 1) + i32] {
    with to_result[i32, i32 + 1] {
      with timeout[i32] { with default[u8, i32](0) { work() } finally { let r = raise((3 : i32)); () } }
    }
  }
-- expect: 22:82: `k`, of type `U ((1 -o F[2.0 cancel i32 ~> 0, 1.0 lin i32 ~> 1] (i32 + 1)) & F[2.0 cancel i32 ~> 0, 2.0 cancel i32 ~> 0, 1.0 lin i32 ~> 1] 1)`, is live across a computation that may abort, and its type is linear and not consumable, and an abort abandons only a value that holds no owned cell
