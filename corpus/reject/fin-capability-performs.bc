-- A cleanup that uses a capability the body also uses and also raises (SPEC §78): the reborrow's
-- finaliser would perform, at a row of its own (`Σ_D ≠ ∅`), which is K-b's (#1046), not provided
-- yet. Refused at the cleanup.
-- expect: 17:56: this cleanup uses `Count`, which the body also uses, and performs an operation of `Fail`; a cleanup of a lent place that performs is not provided yet (#1046)

include fail

effect Count { fn tick() -> i32 }

handler count(mut n: i32): Count = { tick() = { n = n + 1; n } }

fn work(x: i32) -> i32 with Count, Fail[i32] = let t = tick(); if x > 100 { raise(x) } else { x * 6 }

main -> (i32 + i32) * i32 =
  with count(0) {
    let r = with to_result[i32, i32] {
      with default[u8, i32](0) { work(500) } finally { let t = tick(); let z = raise((2 : i32)); () }
    };
    (r, tick())
  }
