-- expect: 17:3: `first_ten` is declared `total`, but it has a `for` over a generator whose body loops (SPEC §14)
-- A number is not a bound (SPEC §16). A `for` is total when its source is data, whose length
-- bounds the loop, or a generator whose body does not loop; `take(g, 10)` of a stored generator
-- is a generator whose body loops (`lib/adapters.bc`), its turns unbounded, so the function is
-- div whatever the number. Counting the loop to 10 would cut it short when a turn yields
-- nothing: a free number would truncate it. The sized `take` of `lib/iters.bc` takes only sized
-- sources, and a stored generator is not one.

include adapters

fn up() -> 1 with Yield[i32] =
  let mut i = 0;
  while i >= 0 { yield(i); i = i + 1 }

total fn first_ten() -> i32 =
  let mut s = 0;
  for x in take(up(), 10) { s = s + x };
  s

main -> i32 = first_ten()
