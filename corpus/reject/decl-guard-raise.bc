#! dialect 82
# `corpus/decl-guard.bc` without the `finally`: the guard is released after the work, and the work
# may raise a `Fail[i32]` that passes through the inner handler, so the guard is live across a
# computation that may abort with no finaliser. `Guard` holds a token's cell, so `[let]`'s `hW`
# fails (`decl_not_ownFree`), and the `[then]` the checker would build instead needs `Guard`'s
# consume, which it has none of (`decl_linear`). Refused.
import fail

data Guard = { must_close(release) lock: i32 }

data Session = { user: i32, guard: Guard }

fn open_session(u: i32) : Session = Session { user: u, guard: Guard { lock: u } }

fn release(g: sink Guard) : i32 = match g { Guard { lock } -> lock }

fn work(u: i32) : i32 / Fail[i32] = if u > 100 { raise(u) } else { u * 6 }

fn main() : (i32 + u8) + i32 {
  let s = open_session(7)
  let Session { user, guard } = s;
  handle {
    let w = handle { work(user) } with to_result[u8, i32]
    let r = release(guard)
    w
  } with to_result[i32, i32 + u8]
}
# expect: 23:13: `guard`, of type `i32 * tok`, is live across a computation that may abort, and its type is linear and not consumable, and an abort abandons only a value that holds no owned cell: `Guard` holds the field `lock`, marked `must_close`; pass it to `release` before the computation that may abort, or close it in a `finally`
