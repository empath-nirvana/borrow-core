-- expect: 30:13: the loop's state would hold a stream chain on the pipe connector, of type `U (nu X. F[1.0 cancel i32 ~> i32] (i32 + U X) & F[1.0 cancel i32 ~> i32] 1)`, across the per-turn lend of `t`: a turn's next state is boxed at `top`, which a thunk or a borrow does not outlive (not provided; a stream chain is not kept across a lend per observation, SPEC §75 *Open*, #1082)
-- SPEC §75, Part B, *Open* (#1082): a stream chain held across a lend per observation is refused.
-- The `with idh` body loops (the chain is a loop) and assigns `t`, a `let mut` lent per
-- observation (Part A, item 1), so the frame's loop would hold the chain, a stage's loop in
-- progress, across the lend; the connector keeps its stages unboxed. The general fix is a `Code`-type
-- outlives rule in the kernel or boxing nested loops at `top` in the machine (#1082).

include pipe

effect Tick { ctl tick(n: i32) -> i32 }

handler idh[A]: Tick, A -> A = {
  return(x) = x;
  tick(n, k) = k(n)
}

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn sum3() -> i32 with Stream[i32, 1] =
  let a = match next() { inl x -> x | inr u -> 0 };
  let b = match next() { inl x -> x | inr u -> 0 };
  a + b

main -> i32 * i32 =
  let mut t = 0;
  let r = with idh[i32] {
    let v = range(0, 3) >| sum3;
    t = t + tick(v);
    v
  };
  (r, t)
