#! dialect 82
# `corpus/decl-txn.bc` with the transaction live across a `raise`: `check` may abort, and `t` is
# bound before it and committed after it, with no finaliser. An abort abandons only a value that
# holds no owned cell, `[let]`'s `hW` (`Ctx.OwnFree`), and `Txn` holds a token's cell
# (`decl_not_ownFree`); the `[then]` the checker would build instead needs `Txn`'s consume,
# which it has none of (`decl_linear`). Refused.
import fail

data Txn = { id: i32, must_close(commit) log: i32 }

fn begin(id: i32) : Txn = Txn { id: id, log: 0 }

fn commit(t: sink Txn) : i32 = match t { Txn { id, log } -> id * 100 + log }

fn check(x: i32) : i32 / Fail[i32] = if x > 3 { raise(x) } else { x }

fn main() : i32 + i32 =
  handle {
    let t = begin(7)
    let y = check(5)
    commit(t) + y
  } with to_result[i32, i32]
# expect: 20:13: `t`, of type `i32 * i32 * tok`, is live across a computation that may abort, and its type is linear and not consumable, and an abort abandons only a value that holds no owned cell: `Txn` holds the field `log`, marked `must_close`; pass it to `commit` before the computation that may abort, or close it in a `finally`
