-- expect: 12:14: `both` loops, so it is called in direct style one step at a time, and a borrow at `'a` cannot stay open across its steps: it may take one borrow of a cell at `'a`, `imm 'a A` or `mut 'a A`, which it borrows again at each step (SPEC §14, borrow scopes over loops)
-- A div function with a lifetime parameter that takes two borrows at it (SPEC §14, borrow scopes
-- over loops). A div function over a borrow is elaborated to take the owner and borrow it again
-- at each step of its loop; one owner is lent that way, so a second borrow at the same lifetime
-- would have to stay open across the steps.

gen fn range(lo: i32, hi: i32) -> i32 =
  let mut i = lo;
  while i < hi { yield i; i = i + 1 };
  ()

def both : !(all 'a < top. imm 'a i32 * imm 'a i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a i32 * imm 'a i32) ->
    let (x, y) = p;
    let mut acc = 0;
    for i in range(0, 3) { acc = acc + *x + *y };
    acc)

main -> i32 =
  let c = alloc(1);
  let d = alloc(2);
  let n = borrow imm c { x -> borrow imm d { y -> both(x, y) } };
  n
