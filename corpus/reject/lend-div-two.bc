-- expect: 17:28: `y` is used twice here, and its type `imm 'a i32` is not persistent
-- A div function with a lifetime parameter that takes two borrows at it and reads both at each turn
-- of its loop. A borrow is not persistent, so the loop's body cannot use it again at each turn: the
-- kernel refuses the second use (SPEC §10, §14).

include yield

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

def both : !(all 'a < top. imm 'a i32 * imm 'a i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a i32 * imm 'a i32) ->
    let (x, y) = p;
    let mut acc = 0;
    for i in range(0, 3) { acc = acc + *x + *y };
    acc)

main -> i32 =
  let c = alloc(1);
  let d = alloc(2);
  let n = borrow imm c { x -> borrow imm d { y -> both(x, y) } };
  n
