-- expect: 21:7: the answering functions of `handle_tail` perform only operations at the count 1 that are not abortive, but their row is `[3.0 aff 1 ~> i32]`
-- `handle_tail`'s answering functions run where the operation is performed, so they perform only
-- operations at the count `1` that are not abortive (`effHandleT`'s `hLin`, SPEC §14, §54). This
-- one performs `3.0`, written `aff` (the count `1?`), of the handler's outer row: refused.

def ask : !U (1 -o F[2.0 lin 1 ~> i32, 3.0 aff 1 ~> i32] i32) =
  !thunkv fun (u : 1) -> perform[2.0] u

main : F i32 =
  f <- return (unbang ask);
  u <- return ();
  handle_with[3](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (p : 1 * U ((i32 -o F i32) & F 1)) ->
        let (w, k) = p;
        let () = w;
        x <- return i32[10];
        (force k).1 x), ()) : !U (1 * U ((i32 -o F i32) & F 1) -o F i32) * 1))
    (handle_tail[2: lin](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F[3.0 aff 1 ~> i32] i32)),
      (((!thunkv fun (w : 1) -> perform[3.0] w), ()) : !U (1 -o F[3.0 aff 1 ~> i32] i32) * 1))
    (force f u))
