-- A declared value (SPEC §42) held as a handler's state, while an error the handler does not
-- handle passes it: the state is live across a computation that may abort (`[let]`'s `hW` asks for
-- a type with no owned cell, and `Txn` holds `Tok`), so it is refused. The handler that handles
-- the abort itself is accepted (`corpus/decl-handler-state.bc`).
include fail

data Txn = { id: i32, must_close(commit) log: i32 }

fn write(t: Txn, x: i32) -> Txn = match t { Txn { id, log } -> Txn { id: id, log: log + x } }

fn commit(t: Txn) -> i32 = match t { Txn { id, log } -> id * 100 + log }

effect Log { must_resume ctl log(x: i32) -> 1 }

handler in_txn(mut t: Txn): Log, i32 -> i32 = {
  return(a) = a + commit(t);
  log(x, k) = { t = write(t, x); k(()) }
}

fn work(x: i32) -> i32 with Log, Fail[i32] =
  log(x);
  if x > 100 { raise(x) } else { x * 6 }

fn run_it(x: i32) -> i32 + i32 =
  with to_result[i32, i32] {
    with in_txn(Txn { id: 7, log: 0 }) { work(x) }
  }

main -> i32 = match run_it(5) { inl v -> v | inr e -> 0 - e }
-- expect: 17:34: `t`, of type `i32 * i32 * tok`, is live across a computation that may abort, and its type is linear with no derived drop, and an abort abandons only a value that holds no owned cell: `Txn` holds the field `log`, marked `must_close`; pass it to `commit` before the computation that may abort, or close it in a `finally`
