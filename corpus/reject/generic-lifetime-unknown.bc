-- expect: 9:15: the lifetime `'a` of `empty` is not determined by its arguments here: write it, `empty[…]['x](…)`, the types and then the lifetimes
-- A lifetime parameter that only the result mentions, called where no result type is expected
-- and no lifetime is in scope: `dom` names none, and outside `main` there is no lifetime of
-- `main`'s own to take (SPEC §23). Inside a borrow block, or in `main`, `dom` gives it.

include slice

fn none_len(u: 1) -> i32 =
  let n = len(empty[i32]());
  n

main -> i32 = none_len(())
