#! dialect 82
# expect: 15:3: `wide` performs `Yield[i64]`, but the handler of `Yield` in scope is at `Yield[i32]`
# A generator that calls another passes on what it yields: the callee's `yield` reaches the
# handler the caller's reaches, at one type. `narrow` yields `i32`, and `wide` `i64`.

import yield

fn wide() : 1 / Yield[i64] {
  let x : i64 = 1
  yield(x);
  ()
}

fn narrow() : 1 / Yield[i32] {
  wide();
  ()
}

fn main() : i32 {
  var a = 0
  for x in narrow() { a = a + x }
  a
}
