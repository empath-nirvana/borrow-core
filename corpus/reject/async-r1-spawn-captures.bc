-- expect: 12:11: the row of a relaxed lend's body has only operations that resume once (affine or linear), of names other than 0, answering `1` with the empty cancel row, whose arguments are closed data with no `U` (R1, SPEC §29)
-- SPEC §29 (docs/async-capabilities.md §6.2 row 10, `n9`): a task spawned inside a relaxed lend,
-- capturing the view. The spawn is an operation whose argument is the task, a thunk: the second
-- `yield` hands the scheduler `{ modify m … }`, which holds `m` and could run after the lend
-- ended. An operation performed inside a relaxed lend takes closed data with no `U`
-- (`Row.ResumeO`). The first `yield` hands a thunk that captures nothing; it is refused too, since
-- the row is checked, not the value.
include yield

fn parent() -> i32 with Yield[U (F i32)] =
  let c = alloc(1);
  let v = borrow mut c { m ->
    let p = (m, 2);
    yield({ 7 });
    let (m, k) = p;
    yield({ modify m { x -> (x, x) } });
    k
  };
  let _ = free(c);
  v

fn stop(it: U (pull (U (F i32)) i32 1)) -> 1 = (nu_out (force it)).2

main -> i32 =
  let g : U (pull (U (F i32)) i32 1) = parent();
  stop(g);
  0
