#! dialect 82
# A `raise` that nothing handles (SPEC §19): `main` performs no effect, and no handler of `Fail`
# is around the call, so the abort has nowhere to go.
# expect: 8:19: `half` performs `Fail`, but no handler of `Fail` is in scope here
import fail
fn half(n: i32) : i32 / Fail[i32] = if n < 0 { raise(n) } else { n }

fn main() : i32 = half(3)
