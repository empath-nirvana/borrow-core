-- expect: 15:3: this borrow block's body performs the operation 1.0, which resumes: only an abortive operation crosses a borrow's scope (a continuation held across a lend is T1, #172)
-- A `for` over `&a`, whose body performs `yield`. The loop is div because its body performs an
-- operation that resumes, so `&a` lends `a` one turn at a time, to the bindings of the body that
-- use the element (SPEC §14, borrow scopes over loops): here `yield(*x)`, so the continuation of
-- `yield` would hold the lend across a suspension, which is T1 (#172). Over the
-- owned array, or over a view the generator is given, the same loop runs
-- (`corpus/for-data-div.bc`).

include yield

fn tab(i: i32) -> i32 = i + 1

fn elems_of() -> 1 with Yield[i32] =
  let a = array_new[i32] (3, tab);
  for x in &a { yield(*x) };
  ()

main -> i32 =
  let mut acc = 0;
  for x in elems_of() { acc = acc + x };
  acc
