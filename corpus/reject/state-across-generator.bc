#! dialect 82
# expect: 19:13: the type of the type of the body `state` handles is not determined here: ascribe it
# A generator's `let mut` as an instance of `State` (#611), live across `yield`: the generator's
# loop is div, and no handler wraps a div computation (§21 *Open*). The state is carried in the
# loop's state, as the generator's variables are.
effect State[T] { must_resume ctl get() : T; must_resume ctl put(v: T) : 1 }

handler state[T, A](mut s: T): State[T], (A) -> A * T {
  return(a) -> (a, s)
  get(k) -> k(s)
  put(v, k) -> { s = v; k(()) }
}

import yield

fn evens(n: i32) : 1 / Yield[i32] {
  let (u, s) = handle {
    let (u, s) = handle {
      while k.get() < n { yield(i.get()); i.put(i.get() + 2); k.put(k.get() + 1) }
    } with state[i32, 1](0) as k
    u
  } with state[i32, 1](0) as i
  u
}

fn main() : i32 {
  let (v, s) = handle { for v in evens(4) { sum.put(sum.get() + v) }; sum.get() } with state[i32, i32](0) as sum
  v
}
