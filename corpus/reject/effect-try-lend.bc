-- A place lent inside the body of a control handler (SPEC §19): the body may be abandoned (an
-- abort unwinds it), and it does not hand back `stdout` when it lends it, so the lend is
-- rejected; the program lends it outside the block instead.
-- expect: 8:21: the body of `with to_result` assigns a `let mut` variable declared outside it, or lends a place declared outside it: a control handler's body may be abandoned, and does not hand them back; bind what the block answers instead
include fail
fn half(n: i32) -> i32 with Fail[i32] = if n < 0 { raise(n) } else { n }

main -> i32 + i32 = with to_result { putb(&mut stdout, 10); half(3) }
