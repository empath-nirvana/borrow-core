-- expect: 6:24: `break` is outside every loop
-- `break` leaves the innermost loop; outside every loop of a function's body there is none.

include yield

fn first(n: i32) -> 1 with Yield[i32] =
  if n < 0 { yield(0); break } else { () };
  yield(n)

main -> i32 =
  let mut acc = 0;
  for x in first(3) { acc = acc + x };
  acc
