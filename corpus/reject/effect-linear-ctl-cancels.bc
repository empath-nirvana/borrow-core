-- `effects-cancel-two-sites.bc` with its operation declared `linear ctl`: a bound of `1` (SPEC §53).
-- `scaled`'s clause cancels its continuation when `d` is `0`, so it asks `1?` of `ask`, and the
-- checker refuses the declaration at that handler, by name.
-- expect: 17:53: the operation 3.0 is declared `linear ctl`, and this handler's clause asks more of its continuation: it may cancel its continuation (SPEC §53)
include fail

effect Ask { linear ctl ask(x: i32) -> i32 }

handler scaled[A](d: i32): Ask, A -> A with Fail[i32] = {
  return(a) = a;
  ask(x, k) = if d == 0 { u <- (force k).2; raise(0) } else { k(x) }
}

fn two() -> i32 with Ask = ask(10) + ask(20)

fn under(d: i32) -> (i32 + i32) + i32 =
  with to_result[i32, i32 + i32] { with to_result { with scaled(d) { two() } } }

main -> ((i32 + i32) + i32) * ((i32 + i32) + i32) = (under(5), under(0))
