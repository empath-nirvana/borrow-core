-- A function `A => B` is not a closure (SPEC §22): there is no uniform coercion from `A => B` to
-- `box 'c Clo[A, B]<'c>`. A closure's `close` must dispose of its state, and `A => B` is linear
-- with no derived drop (SPEC §12, group 3): it is disposed of only by calling it, which
-- needs an argument `close` does not have (`Core/Clo.lean`, `not_hasDtor_lolli`). Here `close`
-- leaves the state `h` unused, and the checker refuses it.
include clo

fn of_linear<'c>(h: i32 => i32) -> Clo[i32, i32]<'c> =
  clo_new[i32 => i32, i32, i32]['c](h, !thunkv fun (h : i32 => i32) ->
    < fun (x : i32) -> b <- return (h x); return (b, boxed['c] (thunkv fun (y : i32) -> return y)),
      return () >)

main -> i32 = 0
-- expect: 10:5: in this `<M, N>`, `h` is consumed in the first component but not in the second, and its type `i32 => i32` is linear and has no derived drop
