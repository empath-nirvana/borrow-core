#! dialect 82
# A named entry of a row with no handler of its name where the function is called (SPEC §38):
# `sync`'s entries `src` and `dst` are served by the handlers named so, `with src = h(…)`; two
# handlers without names cannot serve them.
# expect: 16:5: `sync` performs `Log` at the handler named `src`, but no handler of `Log` named `src` is in scope here
effect Log { note(x: i32) : 1 }
handler count(mut n: i32): Log { note(x) -> { n = n + x; () } }

fn sync() : i32 / src: Log + dst: Log { src.note(1); dst.note(2); 0
}

fn main() : i32 * (i32 * i32) {
  let a = alloc(0)
  let b = alloc(0)
  let r = handle { handle {
    sync() } with count(&b) } with count(&a);
  (r, (free(a), free(b)))
}
