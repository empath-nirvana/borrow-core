#! dialect 82
# An operation with no handler of its effect in scope (SPEC §18): `tick` is called in `main`,
# outside every `with count(…)`, so there is no capability to call its clause on.
# expect: 9:19: the operation `tick` of `Counter` is performed here, but no handler of `Counter` is in scope
effect Counter { tick() : i32 }

handler count(mut n: i32): Counter { tick() -> { n = n + 1; n } }

fn main() : i32 = tick()
