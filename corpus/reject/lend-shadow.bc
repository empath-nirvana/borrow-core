-- expect: 20:11: the row of an unwinding borrow's callback has only abortive operations, of names other than 0, whose arguments outlive every lifetime and do not mention its lifetime
-- A name bound inside a borrow block over a loop, beside a variable of the same name outside it,
-- in core text, whose names are not resolved (SPEC §41). The block's body loops, so its lend is held
-- across the loop's ticks, and the kernel refuses the lend at the row `div` (`Row.Unwind`; T1, SPEC
-- §14, §19). In a surface body the block's `acc` is a variable of its own
-- (`corpus/pending/lend-shadow.bc`).

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

main : F i32 =
  let t = alloc(array_new[i32] (10, tab));
  let acc = 5;
  let r = borrow imm t { b ->
    let mut acc = 0;
    for c in bytes(&mut stdin) { acc = acc + get(b, c - 48) };
    acc
  };
  acc + r
