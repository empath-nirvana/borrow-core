-- One operation with two signatures (SPEC §19, decision R): the two handlers of the name `1` give
-- its operation `1.0` the argument `i32` and the argument `1`. A program gives each operation one
-- signature, so each instance of a name has one protocol.
-- expect: 5:1: the operation 1.0 has two signatures in this program, `cancel i32 ~> 0` and `cancel 1 ~> 0`: an operation has one signature (decision R)
main : F (i32 * i32) =
  hr : !U (i32 -o F i32) <- return (!thunkv fun (v : i32) -> return v);
  hc : !U (i32 -o F i32) * 1 <- return ((!thunkv fun (e : i32) -> return e), ());
  hc1 : !U (1 -o F i32) * 1 <- return ((!thunkv fun (u : 1) -> return i32[0]), ());
  a <- handle_with[1](hr, hc) (abort[1.0] i32[3]);
  b <- handle_with[1](hr, hc1) (abort[1.0] ());
  return (a, b)
