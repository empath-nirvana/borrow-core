-- An assignment inside the body of a control handler (SPEC §41, R3), here one whose operation
-- resumes: the body of `with resuming` may be abandoned, so it hands nothing back, and `x` is lent
-- around the handler site instead (a cell scoped to the site); in the body `x = 5` is `modify` of
-- the borrow, before the body performs `pause`. After the `with`, `x` holds the write. (It was
-- refused, §18 *Not provided*, as `corpus/reject/mut-control-with.bc`.)
--
-- Answer: `i32[5]`; `live 0`.
effect Pause { ctl pause() }
handler resuming[A]: Pause, A -> A = { return(a) = a; pause(k) = k(()) }
fn body() -> i32 with Pause =
  let mut x = 1;
  pause();
  with resuming { x = 5; pause(); () };
  x
main -> i32 = with resuming { body() }
