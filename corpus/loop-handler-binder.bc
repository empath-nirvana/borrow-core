-- A `with default(d) { … }` inside a `for`'s body, in a function with a linear variable named
-- `e`, consumed before the loop (#493). `default`'s clause `raise(e) = d` (`lib/fail.bc`) binds
-- `e`, and the clause runs in the scope of the `with`. Every binder of a control handler's code
-- has a fresh name (`Frontend/Elab/Hygiene.lean`, SPEC §41), so the loop, which chooses the
-- variables it threads by name, does not take the clause's `e` for the function's (it threaded
-- the outer `e` too, a second use of it: "`e` is used twice here").
--
-- Answer: i32[42].

include text

-- The number `t` holds, parsed three times in a loop, after an earlier use of a view named `e`.
fn thrice<'a>(t: text 'a) -> i32 =
  let (e, u) = array_copy['a, u8] t;
  array_forget['a, u8](u);
  let mut v = e;
  let mut k = 0;
  for _ in 0..3 {
    let (w, x) = array_copy['a, u8] v;
    v = w;
    k = k + with default(0) { parse_i32(x) }
  };
  array_forget['a, u8](v);
  k

main -> i32 =
  let s = string_of_lit("14");
  let n = borrow imm s { t -> thrice(t) };
  n
