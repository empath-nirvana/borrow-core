-- Goal program for RQ1 (#1122): checks under PinLaw (an accepted assumption); see the register.
-- RQ1 (#838; register #1122), the generator configuration of E3: the cells of
-- `corpus/rq1-exampleA-mut.bc`, with `κ` resumed under the other cell's lend instead of beside it.
-- `gen` is given the cell `c`, opens a `mut` borrow of it (the lend `α`) and yields twice under it,
-- so its continuation holds the borrow; it hands `c` back at its end. `stepping` stores the
-- continuation boxed at `top` (BOXED-κ, SPEC §28). `main` steps the generator once, which opens `α`
-- and parks it at the first `yield`; steps it again inside its own `mut` lend `β` of `c2` (`α`'s
-- branch resumed under `β`), which writes through the borrow and parks it again; ends `β` while
-- `α` is still held by the parked continuation; and steps it a third time after `β`, which writes
-- once more and ends `α`, so `c` returns. (With `lib/yield.bc`'s `pull` instead of BOXED-κ, the
-- stepped generator could not leave `β` at all: a `U` value cannot be shown to outlive a lend,
-- whether or not it holds a borrow.)
--
-- Today it checks with `assurance: PinLaw (R1 at 36:11)`: `α` is R1 (`withbor2r`), with PinLaw's
-- `LendFrame` assumed there. It is pending an unconditional assurance (RQ1 E3.3's done-when);
-- `corpus/trusted/rq1-generator.txt` pins the site, so the gate fails when that changes.
--
-- Answer: (i32[111], i32[1011]): `c` is 1 at the first `yield`, 11 at the second and 111 at the
-- end; `c2` is 1000 + 11, what the second step yielded, added through `β`. `live 0`.

effect Gen { ctl yield(x: i32) }

-- A suspended generator, boxed at `top`: its next observation runs it to its next `yield` or its
-- end, where it hands back the cell.
type Susp = box top U (nu X. F (ref i32 + (i32 * box top U X)) & F 1)
type Step = ref i32 + (i32 * Susp)

handler stepping: Gen, ref i32 -> Step = {
  return(c) = inl c;
  yield(x, k) = inr (x, boxed[top] (thunkv nu_in <
    kk <- return (unbox k); u <- return (); s <- (force kk).1 u; return s,
    kk <- return (unbox k); (force kk).2 >))
}

fn gen(c: ref i32) -> ref i32 with Gen =
  let _ = borrow mut c { m ->
    let a = modify m { v -> (v, v) };
    yield(a);
    modify m { v -> v + 10 };
    let b = modify m { v -> (v, v) };
    yield(b);
    modify m { v -> v + 100 };
    ()
  };
  c

fn wake(t: Susp) -> Step = g <- return (unbox t); (nu_out (force g)).1

-- The cell once the generator has finished; -1 if it yields again (it is cancelled).
fn finish(s: Step) -> i32 =
  match s {
    inl c -> free(c)
  | inr (x, t) -> match wake(t) {
      inl c -> free(c)
    | inr (y, t) -> g <- return (unbox t); (nu_out (force g)).2; 0 - 1
    }
  }

main -> i32 * i32 =
  let c = alloc(1);
  let c2 = alloc(1000);
  match with stepping { gen(c) } {
    inl c -> (free(c), free(c2))
  | inr (a, t) ->
      let s = borrow mut c2 { m2 ->
        let s : Step = match wake(t) {
          inl c -> inl c
        | inr (b, t) -> modify m2 { v -> v + b }; inr (b, t)
        };
        s
      };
      let r = finish(s);
      (r, free(c2))
  }
