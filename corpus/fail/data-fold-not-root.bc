-- A fold block over a member of a mutual group that is not its root (SPEC §60, F1, the
-- single-root rule): only the root `Forest` is a `mu`, so a fold folds it, with `Rose` matched
-- inside its arms.
-- expect: 9:41: `fold_own` folds the root of a recursive group, and `Rose` is not its group's root `Forest` (the single-root rule): fold `Forest`
data Rose = Rose(val: i32, kids: box Forest)

data Forest = FNil | FCons(Rose, box Forest)

fn first(r: Rose) -> i32 = fold_own r { Rose(v, k) -> v }

main -> i32 = 0
