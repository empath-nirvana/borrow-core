#! dialect 82
# expect: 10:93: a `finally` clause can't yet assign `d`, a variable declared outside the handler: its write would be lost (#940)
# A `finally` clause that assigns a `let mut` declared outside the handler (SPEC §42; #940). The
# finaliser runs in place, but what it writes is not handed back after the `with`, so the write
# would be lost and the program would answer the old value. Until it is, the clause is refused.
import fail

fn chk(n: i32) : i32 / Fail[i32] = if n > 0 { raise(n) } else { n }

fn main() : (i32 + i32) * i32 { var d = 0; let r = handle { chk(2) } with to_result finally { d = d + 100 }; (r, d) }
