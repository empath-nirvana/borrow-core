#! dialect 82
# expect: 8:3: `n` is assigned, but it is not declared `let mut`
# An assignment after a `let` that shadows a `let mut` of the same name (#504): the name resolves
# to the `let`, which is not `let mut` (SPEC §41, rules R1 and R2).
fn main() : i32 {
  var n = 0
  let n = 10
  n = n + 1
  n
}
