#! dialect 82
# An arm no value reaches (SPEC §42, M4): the arms before it match everything it matches.
# expect: 6:48: this arm is never reached: the arms before it match everything it matches
data State = Locked | Open

fn f(s: sink State) : i32 = match s { _ -> 0 | Locked -> 1 }

fn main() : i32 = f(Open)
