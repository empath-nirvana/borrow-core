-- A `box` pattern in a `fold_imm` block (SPEC §42, F1): the arms read the block through the
-- views of its cells, and free nothing.
-- expect: 6:61: `fold_imm` reads `Cons` through the views of its cells, and frees nothing: match it without `box`
data List = Nil | Cons(head: i32, tail: List)

fn sum<'a>(l: imm 'a List) -> i32 = fold_imm l { Nil -> 0 | box Cons(h, t) -> h + t }

main -> i32 = 0
