-- A `let mut` as an instance of `State` (#611), assigned in a `while`: two `State` instances
-- across the loop. The loop is div, and each handler around it is installed per observation
-- (SPEC §75), its state (the handler's `mut` parameter) carried in the loop's state from turn to
-- turn (§19). The `while`'s condition performs `get`, so it is tested before each turn.
--
-- Answer: `(i32[5], inr ())`: `5` is the first `i` whose square passes `20`, and `found` is
-- `true`, which prints as `inr ()`.

effect State[T] { must_resume ctl get() -> T; must_resume ctl put(v: T) }

handler state[T, A](mut s: T): State[T], A -> A * T = {
  return(a) = (a, s);
  get(k) = k(s);
  put(v, k) = { s = v; k(()) }
}

main -> i32 * bool =
  let (v, s) = with i = state[i32, i32 * bool](0) {
    let (v, f) = with found = state[bool, i32 * bool](false) {
      while i.get() < 10 && not(found.get()) { if i.get() * i.get() > 20 { found.put(true) } else { i.put(i.get() + 1) } };
      let r: i32 * bool = (i.get(), found.get());
      r
    };
    v
  };
  v
