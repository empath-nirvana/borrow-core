-- A `let mut` variable assigned in an arm of a `match` that heads a `let` is handed on to what
-- follows the binding, beside the `match`'s value (#581).
--
-- Answer: i32[52]: the `inl` arm sets `x` to 5 and answers 2. Without the join, i32[12].

main -> i32 =
  let mut x = 1;
  let s = (inl () : 1 + 1);
  let a = match s { inl u -> x = 5; 2 | inr u -> 3 };
  x * 10 + a
