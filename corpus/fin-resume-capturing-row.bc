-- A clause whose row has an abortive operation (`Fail`) and one that captures a continuation
-- (`Ask`), resuming its continuation after a head that performs neither (`n + 1`), with no finaliser
-- (SPEC §27; #953 re-review H2). Whether a head is wrapped in `unwind (cancel k)` is read from its
-- row, as the typing gives it, not from its syntax: this head can neither abort nor be cancelled
-- through, so it is not wrapped, and the clause elaborates as without phase 2.
--
-- Answer: inl (inl i32[5]), and `live 0`.

include fail

effect Wait { ctl wait() }
effect Ask { ctl ask() }

handler asker[A]: Ask, A -> A = { return(x) = x; ask(k) = k(()) }

handler tm[A](n: i32): Wait, A -> A + 1 with Fail[i32], Ask = {
  return(x) = inl x;
  wait(k) = { let y = n + 1; k(()) }
}

fn work() -> i32 with Wait, Fail[i32] = wait(); 5

main -> (i32 + 1) + i32 =
  with asker[(i32 + 1) + i32] { with to_result[i32, i32 + 1] { with tm[i32](1) { work() } } }
