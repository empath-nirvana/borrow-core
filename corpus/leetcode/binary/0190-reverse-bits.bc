-- LeetCode 190, Reverse Bits.
--
-- The 32 bits of `n` in reverse order: a counted loop moves the lowest bit of `n` into the answer,
-- shifting both, 32 times. Bitwise operations and shifts are `host[and32]`, `host[xor32]`,
-- `host[shl32]`, … (#144). A case is an unsigned 32-bit number, read modulo 2³²; the answer is
-- printed unsigned, through `i64` (`host[extend_u]`, `print_dec64`), as `print_dec` is signed and
-- there is no unsigned type.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, the spanning lend
-- (#172, SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0190-reverse-bits.in`: `964176192 3221225471 0 2147483648 4294967295 1`, one per line,
-- then `i32[6]`, the number of cases.

include textio

fn reverse_bits(n: i32) -> i32 =
  let mut n = n;
  let mut r = 0;
  for _ in 0..32 {
    r = host[or32](host[shl32](r, 1), host[and32](n, 1));
    n = host[shr_u32](n, 1)
  };
  r

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> (i32 * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, b) -> x }, 0);
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl (x, next) ->
        print_dec64(host[extend_u](reverse_bits(x)));
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
