-- LeetCode 338, Counting Bits.
--
-- The set bits of every `i` from 0 to `n`, in an array built in one pass: `i` has the bits of `i >>
-- 1` and its own lowest bit. Bitwise operations and shifts are `host[and32]`, `host[xor32]`,
-- `host[shl32]`, … (#144). A case is `n`.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, which
-- decision 71 rules out (SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0338-counting-bits.in`: each case's counts, separated by spaces, one case per line,
-- then `i32[4]`, the number of cases.

include textio

fn count_bits(n: i32) -> array i32 =
  let mut bits = array_new[i32] (n + 1, !{ i -> 0 });
  for i in 1..n + 1 {
    let half = at(&bits, host[shr_u32](i, 1), 0);
    bits = array_set(bits, i, half + host[and32](i, 1))
  };
  bits

-- The first `n` elements of `a` on one line, separated by spaces.
fn print_nums(a: array i32, n: i32) -> array i32 =
  for i in 0..n {
    if 0 < i { print_byte(b' ') } else { () };
    let x = at(&a, i, 0);
    print_dec(x)
  };
  a

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> (i32 * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, b) -> x }, 0);
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl (x, next) ->
        let bits = print_nums(count_bits(x), x + 1);
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
