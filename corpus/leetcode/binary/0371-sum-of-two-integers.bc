-- LeetCode 371, Sum of Two Integers.
--
-- The sum without `+`: `a ^ b` is the sum without carries and `(a & b) << 1` the carries, added
-- again until there are none. Bitwise operations and shifts are `host[and32]`, `host[xor32]`,
-- `host[shl32]`, … (#144). A case is the two integers.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, the spanning lend
-- (#172, SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0371-sum-of-two-integers.in`: `3 5 0 -20 -2147483648 0 -150`, one per line, then
-- `i32[7]`, the number of cases.

include textio

fn get_sum(a: i32, b: i32) -> i32 =
  let mut a = a;
  let mut b = b;
  while b != 0 {
    let carry = host[shl32](host[and32](a, b), 1);
    a = host[xor32](a, b);
    b = carry
  };
  a

-- The two numbers on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> ((i32 * i32) * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, (a, (b, k))) -> if k == 0 { (x, (b, 1)) } else { (a, (x, 2)) } },
            (0, (0, 0)));
          let (a, (b, k)) = c;
          let c = (a, b);
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl ((x, y), next) ->
        print_dec(get_sum(x, y));
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
