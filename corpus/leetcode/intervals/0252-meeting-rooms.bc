-- LeetCode 252, Meeting Rooms.
--
-- Each line of the input is one case, meetings written as pairs of integers, start and end, each
-- meeting the half-open interval between them (one may start when another ends). The program
-- prints, for each, `true` when one person can attend them all, no two overlapping, and `false`
-- otherwise, and answers how many can.
--
-- The meetings are sorted by start in place through a `mut` view (`sort`, the order an explicit
-- function, decision 54), and two overlap exactly when one starts before the previous one in
-- that order ends. The library's `sort` is an insertion sort, so the `O(n log n)` is `O(n^2)`
-- here (#497).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

-- The meetings of a line, its integers taken in pairs.
fn intervals<'t>(l: text 't) -> buf (i32 * i32) =
  let (ivs, _) = fold_i32s(l, !{ (x, (ivs, (s, half))) ->
    if half { let (ivs, _) = push(ivs, (s, x)); (ivs, (0, false)) } else { (ivs, (x, true)) } },
    (box buf[i32 * i32](8), (0, false)));
  ivs

fn by_start(x: i32 * i32, y: i32 * i32) -> i32 =
  let (a, _) = x;
  let (b, _) = y;
  cmp_i32(a, b)

-- Whether no two meetings overlap.
fn can_attend(ivs: buf (i32 * i32)) -> bool =
  let mut ivs = ivs;
  borrow mut ivs { v -> let v = sort(v, by_start, (0, 0)); () };
  let (a, n) = ivs;
  let mut ok = true;
  for i in 1..n {
    let (_, e) = at(&a, i - 1, (0, 0));
    let (s, _) = at(&a, i, (0, 0));
    if s < e { ok = false; break } else { () }
  };
  ok

main -> i32 =
  let s = read_input();
  let count = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut count = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          if can_attend(intervals(l)) { print_lit("true\n"); count = count + 1 }
          else { print_lit("false\n") }
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    count };
  count
