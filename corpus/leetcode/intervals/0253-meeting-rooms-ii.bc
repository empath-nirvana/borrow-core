-- LeetCode 253, Meeting Rooms II.
--
-- Each line of the input is one case, meetings written as pairs of integers, start and end, each
-- meeting the half-open interval between them (a room is free again when its meeting ends). The
-- program prints, for each, the fewest rooms that hold all the meetings, and answers the sum.
--
-- The meetings are sorted by start in place through a `mut` view (`sort`, the order an explicit
-- function, decision 54), and the end times of the rooms in use are kept in a binary min-heap
-- (`heap_push`, `heap_pop`, `heap_peek`, `lib/buf.bc`), the end time its priority and nothing
-- else stored (`A = 1`). A meeting reuses the room that frees first when it is free by the
-- meeting's start, and otherwise takes a new one; the answer is the heap's largest size. The
-- library's `sort` is an insertion sort, so the `O(n log n)` is `O(n^2)` here (#497).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

fn max(a: i32, b: i32) -> i32 = if a < b { b } else { a }

-- The meetings of a line, its integers taken in pairs.
fn intervals<'t>(l: text 't) -> buf (i32 * i32) =
  let (ivs, _) = fold_i32s(l, !{ (x, (ivs, (s, half))) ->
    if half { let (ivs, _) = push(ivs, (s, x)); (ivs, (0, false)) } else { (ivs, (x, true)) } },
    (box buf[i32 * i32](8), (0, false)));
  ivs

fn by_start(x: i32 * i32, y: i32 * i32) -> i32 =
  let (a, _) = x;
  let (b, _) = y;
  cmp_i32(a, b)

-- The fewest rooms that hold the meetings.
fn rooms(ivs: buf (i32 * i32)) -> i32 =
  let mut ivs = ivs;
  borrow mut ivs { v -> let v = sort(v, by_start, (0, 0)); () };
  let (a, n) = ivs;
  let mut ends = box buf[i32 * 1](n);
  let mut most = 0;
  for i in 0..n {
    let (s, e) = at(&a, i, (0, 0));
    let (h, first) = heap_peek(ends);
    ends = h;
    match first {
      inl (free_at, _) -> if free_at <= s { let (h, _) = heap_pop(ends); ends = h } else { () }
    | inr _ -> ()
    };
    ends = heap_push(ends, e, ());
    let (h, k) = len_of(ends);
    ends = h;
    most = max(most, k)
  };
  most

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let k = rooms(intervals(l));
          print_dec(k); print_byte(b'\n');
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
