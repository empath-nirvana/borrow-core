-- LeetCode 57, Insert Interval.
--
-- Each line of the input is one case, closed intervals written as pairs of integers, start and
-- end: the first is the new interval, and the rest are sorted by start with none overlapping. The
-- program prints, for each, the list with the new interval inserted and merged with those it
-- overlaps or touches, as `[s,e]` separated by spaces, and answers how many intervals there are
-- in all.
--
-- One sweep over the sorted list: the intervals that end before the new one starts are kept, those
-- that overlap it widen it, and the rest are kept after it. No sort is needed.
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

fn max(a: i32, b: i32) -> i32 = if a < b { b } else { a }

fn min(a: i32, b: i32) -> i32 = if a < b { a } else { b }

-- The intervals of a line, its integers taken in pairs.
fn intervals<'t>(l: text 't) -> buf (i32 * i32) =
  let (ivs, _) = fold_i32s(l, !{ (x, (ivs, (s, half))) ->
    if half { let (ivs, _) = push(ivs, (s, x)); (ivs, (0, false)) } else { (ivs, (x, true)) } },
    (box buf[i32 * i32](8), (0, false)));
  ivs

-- The intervals, `[s,e]` each, separated by spaces, on a line.
fn print_intervals(ivs: buf (i32 * i32)) -> buf (i32 * i32) =
  let (a, n) = ivs;
  for i in 0..n {
    if 0 < i { print_byte(b' ') } else { () };
    let (s, e) = at(&a, i, (0, 0));
    print_byte(b'['); print_dec(s); print_byte(b','); print_dec(e); print_byte(b']')
  };
  print_byte(b'\n');
  (a, n)

-- The intervals after the first, with the first inserted and merged.
fn insert(ivs: buf (i32 * i32)) -> buf (i32 * i32) =
  let (a, n) = ivs;
  let (ns, ne) = at(&a, 0, (0, 0));
  let mut ns = ns;
  let mut ne = ne;
  let mut out = box buf[i32 * i32](n);
  let mut placed = false;
  for i in 1..n {
    let (s, e) = at(&a, i, (0, 0));
    if e < ns { let (o, _) = push(out, (s, e)); out = o } else {
      if ne < s {
        if not(placed) { let (o, _) = push(out, (ns, ne)); out = o; placed = true } else { () };
        let (o, _) = push(out, (s, e)); out = o
      } else { ns = min(ns, s); ne = max(ne, e) }
    }
  };
  if not(placed) { let (o, _) = push(out, (ns, ne)); out = o } else { () };
  out

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let m = print_intervals(insert(intervals(l)));
          let (_, k) = len_of(m);
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
