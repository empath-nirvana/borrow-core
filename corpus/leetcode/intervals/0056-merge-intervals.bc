-- LeetCode 56, Merge Intervals.
--
-- Each line of the input is one case, closed intervals written as pairs of integers, start and
-- end. The program prints, for each, the intervals that cover the same points with none
-- overlapping (touching ones merged), in order, as `[s,e]` separated by spaces, and answers how
-- many there are in all.
--
-- The intervals are a buffer of pairs, sorted by start in place through a `mut` view (`sort`,
-- the order an explicit function, decision 54), then swept once: an interval that starts at or
-- before the current one's end extends it, any other closes it. The library's `sort` is an
-- insertion sort, so the sweep's `O(n log n)` is `O(n^2)` here (#497).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

fn max(a: i32, b: i32) -> i32 = if a < b { b } else { a }

-- The intervals of a line, its integers taken in pairs.
fn intervals<'t>(l: text 't) -> buf (i32 * i32) =
  let (ivs, _) = fold_i32s(l, !{ (x, (ivs, (s, half))) ->
    if half { let (ivs, _) = push(ivs, (s, x)); (ivs, (0, false)) } else { (ivs, (x, true)) } },
    (box buf[i32 * i32](8), (0, false)));
  ivs

fn by_start(x: i32 * i32, y: i32 * i32) -> i32 =
  let (a, _) = x;
  let (b, _) = y;
  cmp_i32(a, b)

-- The intervals, `[s,e]` each, separated by spaces, on a line.
fn print_intervals(ivs: buf (i32 * i32)) -> buf (i32 * i32) =
  let (a, n) = ivs;
  for i in 0..n {
    if 0 < i { print_byte(b' ') } else { () };
    let (s, e) = at(&a, i, (0, 0));
    print_byte(b'['); print_dec(s); print_byte(b','); print_dec(e); print_byte(b']')
  };
  print_byte(b'\n');
  (a, n)

-- The intervals merged: sorted by start, then swept.
fn merge(ivs: buf (i32 * i32)) -> buf (i32 * i32) =
  let mut ivs = ivs;
  borrow mut ivs { v -> let v = sort(v, by_start, (0, 0)); () };
  let (a, n) = ivs;
  let mut out = box buf[i32 * i32](n);
  let mut cs = 0;
  let mut ce = 0;
  for i in 0..n {
    let (s, e) = at(&a, i, (0, 0));
    if i == 0 { cs = s; ce = e } else {
      if s <= ce { ce = max(ce, e) } else {
        let (o, _) = push(out, (cs, ce));
        out = o; cs = s; ce = e
      }
    }
  };
  if 0 < n { let (o, _) = push(out, (cs, ce)); out = o } else { () };
  out

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let m = print_intervals(merge(intervals(l)));
          let (_, k) = len_of(m);
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
