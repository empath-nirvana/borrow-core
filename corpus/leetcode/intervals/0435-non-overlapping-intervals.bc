-- LeetCode 435, Non-overlapping Intervals.
--
-- Each line of the input is one case, half-open intervals written as pairs of integers, start and
-- end (intervals that only touch do not overlap). The program prints, for each, the fewest
-- intervals to remove so that no two left overlap, and answers the sum.
--
-- Greedy by end: the intervals are sorted by end in place through a `mut` view (`sort`, the order
-- an explicit function, decision 54), and swept once, keeping each interval that starts at or
-- after the end of the last one kept and counting the others. The library's `sort` is an
-- insertion sort, so the `O(n log n)` is `O(n^2)` here (#497).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

-- The intervals of a line, its integers taken in pairs.
fn intervals<'t>(l: text 't) -> buf (i32 * i32) =
  let (ivs, _) = fold_i32s(l, !{ (x, (ivs, (s, half))) ->
    if half { let (ivs, _) = push(ivs, (s, x)); (ivs, (0, false)) } else { (ivs, (x, true)) } },
    (box buf[i32 * i32](8), (0, false)));
  ivs

fn by_end(x: i32 * i32, y: i32 * i32) -> i32 =
  let (_, a) = x;
  let (_, b) = y;
  cmp_i32(a, b)

-- The fewest intervals to remove.
fn removals(ivs: buf (i32 * i32)) -> i32 =
  let mut ivs = ivs;
  borrow mut ivs { v -> let v = sort(v, by_end, (0, 0)); () };
  let (a, n) = ivs;
  let mut removed = 0;
  let mut end = 0;
  for i in 0..n {
    let (s, e) = at(&a, i, (0, 0));
    if i == 0 || end <= s { end = e } else { removed = removed + 1 }
  };
  removed

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let k = removals(intervals(l));
          print_dec(k); print_byte(b'\n');
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
