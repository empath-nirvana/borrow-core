-- LeetCode 300, Longest Increasing Subsequence.
--
-- Patience sorting, `n log n`: `tails[k]` is the smallest last element of an increasing subsequence
-- of length `k + 1`. Each number replaces the first tail not smaller than it, found by the
-- library's `binary_search` on a view of the buffer, or extends the longest.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, the spanning lend
-- (#172, SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0300-longest-increasing-subsequence.in`: `4 4 1 1 6 1`, one per line, then `i32[6]`,
-- the number of cases.

include textio

fn length_of_lis<'a>(nums: array_imm 'a i32) -> i32 =
  let mut tails = box buf[i32](16);
  for p in nums {
    let x = *p;
    let found = borrow imm tails { v -> binary_search(v, x, cmp_i32) };
    let i = match found { inl i -> i | inr i -> i };
    let (t, k) = len_of(tails);
    if i == k { let (t, _) = push(t, x); tails = t } else {
      let (a, k) = t;
      tails = (array_set(a, i, x), k)
    }
  };
  let (t, k) = len_of(tails);
  k

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> (buf i32 * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](16));
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl (b, next) ->
        let r = borrow imm b { v -> length_of_lis(v) };
        print_dec(r);
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
