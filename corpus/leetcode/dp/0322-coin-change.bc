-- LeetCode 322, Coin Change.
--
-- Bottom-up: the fewest coins for every amount from 0 to the target, each the best over the coins
-- of one more than the fewest for the amount left after that coin. A case is the coins, `|`, and
-- the amount; `-1` when it cannot be made.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, which
-- decision 71 rules out (SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0322-coin-change.in`: `3 -1 0 2 20 4 4`, one per line, then `i32[7]`, the number of
-- cases.

include textio

fn coin_change(coins: array i32, k: i32, amount: i32) -> array i32 * i32 =
  let none = amount + 1;
  let mut best = array_set(array_new[i32] (amount + 1, !{ i -> 0 }), 0, 0);
  for a in 1..amount + 1 {
    let mut b = none;
    for j in 0..k {
      let c = at(&coins, j, 0);
      if c <= a {
        let r = at(&best, a - c, none);
        if r + 1 < b { b = r + 1 } else { () }
      } else { () }
    };
    best = array_set(best, a, b)
  };
  let r = at(&best, amount, none);
  let answer = if r < none { r } else { 0 - 1 };
  (coins, answer)

-- The numbers written in `l`, in a buffer.
fn nums<'t>(l: text 't) -> buf i32 =
  fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](16))

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> ((buf i32 * i32) * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = match split_once(l, b'|') {
            inl (x, y) -> (nums(x), fold_i32s(y, !{ (x, b) -> x }, 0))
          | inr l -> (nums(l), 0)
          };
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl (((a, k), amount), next) ->
        let (a, r) = coin_change(a, k, amount);
        print_dec(r);
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
