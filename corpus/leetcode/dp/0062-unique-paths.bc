-- LeetCode 62, Unique Paths.
--
-- Bottom-up over one row of the grid: the paths to a cell are the paths to the cell above (the
-- row's old entry) and to the cell on its left (its new one). A case is `m` and `n`.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, which
-- decision 71 rules out (SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0062-unique-paths.in`: `28 3 1 28 48620 1`, one per line, then `i32[6]`, the number of
-- cases.

include textio

fn unique_paths(m: i32, n: i32) -> i32 =
  let mut row = array_new[i32] (n, !{ i -> 1 });
  for _ in 1..m {
    for j in 1..n {
      let up = at(&row, j, 0);
      let left = at(&row, j - 1, 0);
      row = array_set(row, j, up + left)
    }
  };
  let r = at(&row, n - 1, 0);
  r

-- The two numbers on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> ((i32 * i32) * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, (a, (b, k))) -> if k == 0 { (x, (b, 1)) } else { (a, (x, 2)) } },
            (0, (0, 0)));
          let (a, (b, k)) = c;
          let c = (a, b);
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl ((m, n), next) ->
        print_dec(unique_paths(m, n));
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
