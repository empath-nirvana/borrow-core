-- LeetCode 206, Reverse Linked List.
--
-- `reverse` turns a list round in place: each node is taken off the front of what is left and
-- put on the front of what is done, by swapping its tail cell's contents (the rest of the list)
-- for the reversed prefix. No node is allocated or freed, as in Rust, where the loop moves each
-- `Box` from one `Option` to the other. It is a recursion in tail position, the accumulator
-- being the reversed prefix, so its depth is the list's length under the `bounded` driver's
-- budget (`lib/rec.bc`; past it, `exhausted()`, answered here by printing `-1`). Rust's
-- loop has no such budget: a loop over a list's spine is a drain, which is div (SPEC §16 Open,
-- `for` over `μ` data).
--
-- The list type is `mu X. 1 + (i32 * ref X)`, a cell per node. With the tail unboxed,
-- `mu X. 1 + (i32 * X)` (`lib/list.bc`'s `List[A]`), the same reversal rebuilds every node:
-- `unroll` frees each node and `roll` allocates one, `n` allocations where Rust makes none.
--
-- Allocations per case: one cell per node, made by `list_of`, and the line's buffer of numbers.
--
-- Input `0206-reverse-linked-list.in`: one case a line, the list's values. Answer: each reversed
-- list on a line, then the number of cases, `i32[5]`.

include textio
include rec

-- The numbers of a line.
fn nums<'t>(l: text 't) -> buf i32 =
  fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](8))

-- The numbers of each line that is not empty.
fn cases<'t>(t: text 't) -> buf (buf i32) =
  fold_lines(t, !{ (l, cs) ->
    let (l, m) = array_copy['t, u8] l;
    if len(m) == 0 { array_forget['t, u8](l); cs } else { let (cs, _) = push(cs, nums(l)); cs } },
    box buf[buf i32](8))

-- A singly linked list: each node is a value and a cell holding the rest, the cell being Rust's
-- `Box<ListNode>`. Relinking a node is a `swap` of its cell.
type List = mu X. 1 + (i32 * ref X)

fn nil() -> List = roll inl ()

fn cons(x: i32, t: List) -> List = roll inr (x, alloc(t))

-- The list of `a[b..b + k]`, one cell per node.
fn list_of(a: array i32, b: i32, k: i32) -> array i32 * List =
  let mut a = a;
  let mut l = nil();
  for i in 0..k { let x = at(&a, b + k - 1 - i, 0); l = cons(x, l) };
  (a, l)

-- The values of a list on a line, separated by spaces; the list is consumed.
fn show_rest(l: List) -> 1 =
  match unroll l {
    inl _ -> print_byte(b'\n')
  | inr (x, c) -> print_byte(b' '); print_dec(x); show_rest(free(c))
  }

fn show(l: List) -> 1 =
  match unroll l {
    inl _ -> print_byte(b'\n')
  | inr (x, c) -> print_dec(x); show_rest(free(c))
  }

-- `l` reversed onto `acc`.
fn reverse_onto(l: List, acc: List) -> List =
  match unroll l {
    inl _ -> acc
  | inr (x, c) -> let (c, rest) = swap(c, acc); let done: List = roll inr (x, c); reverse_onto(rest, done)
  }

fn reverse(l: List) -> List = reverse_onto(l, nil())

main -> i32 =
  let s = read_input();
  let cs = borrow imm s { 't, t -> cases(t) };
  let (cs, n) = cs;
  let mut cs = cs;
  for i in 0..n {
    let (c, o) = array_replace[buf i32] (cs, i, filler[buf i32]);
    cs = c;
    match o {
      inl b -> let (a, k) = b; let (_, l) = list_of(a, 0, k);
               let r = with exhausted_to_option { show(reverse(l)) };
               match r { inl _ -> () | inr _ -> print_dec(0 - 1); print_byte(b'\n') }
    | inr b -> ()
    }
  };
  n
