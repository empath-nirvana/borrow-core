-- LeetCode 54, Spiral Matrix.
--
-- The elements in spiral order, into a buffer: four bounds close in (the first and last rows `r0`,
-- `r1` and columns `c0`, `c1`), each pass reading the top row left to right, the right column down,
-- the bottom row right to left and the left column up, the last two only while a row and a column
-- remain between the bounds.
--
-- The matrix is one flat array, row by row, with its width: element `(i, j)` is at `i * w + j`, as
-- there is no 2D type or indexing (#143). A case is the rows, separated by `;`. Each pass moves the
-- bounds first and reads after, so that the `if` around the last two loops is in tail position: a
-- loop that reads the matrix inside an `if` before `;` is refused (#502).
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, which
-- decision 71 rules out (SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0054-spiral-matrix.in`: each case's elements, separated by spaces, one case per line,
-- then `i32[7]`, the number of cases.

include textio

fn spiral_order(a: array i32, n: i32, w: i32) -> array i32 * buf i32 =
  let h = if w == 0 { 0 } else { match host[div_u32](n, w) { inl q -> q | inr u -> 0 } };
  let mut a = a;
  let mut out = box buf[i32](n);
  let mut r0 = 0;
  let mut r1 = h - 1;
  let mut c0 = 0;
  let mut c1 = w - 1;
  while r0 <= r1 && c0 <= c1 {
    let (t, b, l, r) = (r0, r1, c0, c1);
    r0 = r0 + 1;
    r1 = r1 - 1;
    c0 = c0 + 1;
    c1 = c1 - 1;
    for j in l..r + 1 { let x = at(&a, t * w + j, 0); let (o, _) = push(out, x); out = o };
    for i in t + 1..b + 1 { let x = at(&a, i * w + r, 0); let (o, _) = push(out, x); out = o };
    if t < b && l < r {
      for k in 0..r - l {
        let x = at(&a, b * w + r - 1 - k, 0); let (o, _) = push(out, x); out = o
      };
      for k in 0..b - t - 1 {
        let x = at(&a, (b - 1 - k) * w + l, 0); let (o, _) = push(out, x); out = o
      }
    } else { () }
  };
  (a, out)

-- The width of a matrix written row by row, separated by `;`: the numbers before the first `;`.
fn width<'t>(l: text 't) -> i32 =
  match split_once(l, b';') {
    inl (h, t) -> array_forget['t, u8](t); fold_i32s(h, !{ (x, n) -> n + 1 }, 0)
  | inr l -> fold_i32s(l, !{ (x, n) -> n + 1 }, 0)
  }

-- The numbers written in `l`, in a buffer.
fn nums<'t>(l: text 't) -> buf i32 =
  fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](16))

-- The first `n` elements of `a` on one line, separated by spaces.
fn print_nums(a: array i32, n: i32) -> array i32 =
  for i in 0..n {
    if 0 < i { print_byte(b' ') } else { () };
    let x = at(&a, i, 0);
    print_dec(x)
  };
  a

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> ((buf i32 * i32) * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let (l, l2) = array_copy['t, u8] l;
          let c = (nums(l), width(l2));
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl (((a, n), w), next) ->
        let (a, out) = spiral_order(a, n, w);
        let (o, k) = out;
        let o = print_nums(o, k);
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
