-- LeetCode 98, Validate Binary Search Tree.
--
-- `valid` answers whether every node's value is greater than every value of its left subtree and
-- less than every value of its right, read through a borrow: `fold_imm` over `&t`, whose algebra
-- sees, for each subtree, whether it is a search tree and, when it is not empty, its least and
-- greatest values. A node is valid when both subtrees are and its value lies strictly between
-- the left's greatest and the right's least. The Rust recursion passes the bounds down instead;
-- a fold computes from the leaves up, so the bounds come up as results. The lend `&t` puts the
-- tree in a cell scoped to the call (SPEC §11): one allocation (#500).
--
-- The tree is `mu X. 1 + (ref X * (i32 * ref X))`, a cell per subtree, two per node where Rust
-- allocates one box (`0104-maximum-depth-of-binary-tree.bc`).
--
-- Allocations per case: two cells per node, the lend's cell, and the line's buffer of tokens.
--
-- Input `0098-validate-binary-search-tree.in`: one case a line, the tree's preorder, `#` for each
-- empty subtree. Answer: each case's verdict on a line, `1` for a search tree and `0` otherwise
-- (`1`, `0`, `1`, `0`, `0`, `1`, `0`), then the number of cases, `i32[7]`.

include textio
include rec

-- The tokens of a line: each integer as `inl`, each `#` as `inr ()`.
fn tokens<'t>(l: text 't) -> buf (i32 + 1) =
  let mut out = box buf[i32 + 1](16);
  let mut n = 0;
  let mut neg = false;
  let mut inside = false;
  for p in l {
    let b = *p;
    if b'0' <= b && b <= b'9' {
      n = n * 10 + to_i32(b) - 48;
      inside = true
    } else {
      if inside {
        let x = if neg { 0 - n } else { n };
        let (o, _) = push(out, inl x);
        out = o
      } else { () };
      inside = false;
      n = 0;
      neg = b == b'-';
      if b == b'#' { let (o, _) = push(out, inr ()); out = o } else { () }
    }
  };
  if inside { let x = if neg { 0 - n } else { n }; let (o, _) = push(out, inl x); o } else { out }

-- The tokens of each line that is not empty.
fn cases<'t>(t: text 't) -> buf (buf (i32 + 1)) =
  fold_lines(t, !{ (l, cs) ->
    let (l, m) = array_copy['t, u8] l;
    if len(m) == 0 { array_forget['t, u8](l); cs } else { let (cs, _) = push(cs, tokens(l)); cs } },
    box buf[buf (i32 + 1)](8))

-- A binary tree: empty, or a node of a value and a cell for each subtree, the cells being Rust's
-- `Box<TreeNode>`s.
type Tree = mu X. 1 + (ref X * (i32 * ref X))

fn tip() -> Tree = roll inl ()

fn branch(l: Tree, v: i32, r: Tree) -> Tree = roll inr (alloc(l), (v, alloc(r)))

-- The tree whose preorder, with `#` for each empty subtree, starts at token `i`, and the index
-- after it. Past the end of the tokens, the empty tree.
fn parse(ts: array (i32 + 1), i: i32) -> (array (i32 + 1) * i32) * Tree =
  let x = at(&ts, i, inr ());
  match x {
    inl v ->
      let ((ts, j), l) = parse(ts, i + 1);
      let ((ts, k), r) = parse(ts, j);
      ((ts, k), branch(l, v, r))
  | inr _ -> ((ts, i + 1), tip())
  }

-- The tree of a line's tokens, from the first.
fn tree_of(ts: buf (i32 + 1)) -> Tree = let (a, n) = ts; let (_, t) = parse(a, 0); t

-- A tree's preorder, `#` for each empty subtree; the tree is consumed.
fn show(t: Tree) -> 1 =
  match unroll t {
    inl _ -> print_byte(b'#')
  | inr (cl, (v, cr)) -> print_dec(v); print_byte(b' '); show(free(cl)); print_byte(b' '); show(free(cr))
  }

-- A subtree's summary: whether it is a search tree, and its least and greatest values, or
-- `inr ()` when it is empty.
type Sum = bool * ((i32 * i32) + 1)

-- One layer of the fold: a node's summary from its subtrees'.
fn valid_alg<'y>(r: 1 + (Sum * (i32 * Sum))) -> Sum =
  match r {
    inl _ -> (true, inr ())
  | inr ((okl, sl), (v, (okr, sr))) ->
      let (above, lo) = match sl { inl (a, b) -> (b < v, a) | inr _ -> (true, v) };
      let (below, hi) = match sr { inl (a, b) -> (v < a, b) | inr _ -> (true, v) };
      (okl && okr && above && below, inl (lo, hi))
  }

fn valid<'a>(t: imm 'a Tree) -> bool =
  let (ok, _) = (unbang (fold_imm[1 + (ref X * (i32 * ref X)), 'b, top, Sum] valid_alg)) ['a] t;
  ok

-- One case: the tree's preorder.
fn solve(b: buf (i32 + 1)) -> 1 =
  let mut t = tree_of(b);
  let ok = valid(&t);
  let v = if ok { 1 } else { 0 };
  print_dec(v)

main -> i32 =
  let s = read_input();
  let cs = borrow imm s { 't, t -> cases(t) };
  let (cs, n) = cs;
  let mut cs = cs;
  for i in 0..n {
    let (c, o) = array_replace[buf (i32 + 1)] (cs, i, filler[buf (i32 + 1)]);
    cs = c;
    match o {
      inl b -> let r = with exhausted_to_option { solve(b) };
               match r { inl _ -> () | inr _ -> print_dec(0 - 1) };
               print_byte(b'\n')
    | inr b -> ()
    }
  };
  n
