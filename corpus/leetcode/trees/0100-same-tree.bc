-- LeetCode 100, Same Tree.
--
-- `same` answers whether two trees have the same shape and the same values, by a recursion over
-- both at once that compares the roots and then each pair of subtrees, stopping at the first
-- difference. It consumes both trees: what it has compared is freed as it goes, and what it has
-- not is dropped by its destructor. The Rust `fn is_same_tree(p: &…, q: &…)` reads both through
-- borrows instead. A recursion over a borrowed tree, each call at the subtree's view, is open
-- (structural and borrowed descent, K5, #179); the kernel's borrowed fold, `fold_imm`, walks one
-- tree, and its algebra cannot hold the other. Here the inputs are not needed afterwards, so
-- consuming them costs nothing; a caller that kept them would hand each tree back rebuilt
-- (`0572-subtree-of-another-tree.bc`).
--
-- The tree is `mu X. 1 + (ref X * (i32 * ref X))`, a cell per subtree, two per node where Rust
-- allocates one box (`0104-maximum-depth-of-binary-tree.bc`).
--
-- Allocations per case: two cells per node, and the line's buffer of tokens.
--
-- Input `0100-same-tree.in`: one case a line, the two trees' preorders one after the other, `#`
-- for each empty subtree. Answer: each case's verdict on a line, `1` when the trees are the same
-- and `0` otherwise (`1`, `0`, `0`, `1`, `0`, `1`), then the number of cases, `i32[6]`.

include textio
include rec

-- The tokens of a line: each integer as `inl`, each `#` as `inr ()`.
fn tokens<'t>(l: text 't) -> buf (i32 + 1) =
  let mut out = box buf[i32 + 1](16);
  let mut n = 0;
  let mut neg = false;
  let mut inside = false;
  for p in l {
    let b = *p;
    if b'0' <= b && b <= b'9' {
      n = n * 10 + to_i32(b) - 48;
      inside = true
    } else {
      if inside {
        let x = if neg { 0 - n } else { n };
        let (o, _) = push(out, inl x);
        out = o
      } else { () };
      inside = false;
      n = 0;
      neg = b == b'-';
      if b == b'#' { let (o, _) = push(out, inr ()); out = o } else { () }
    }
  };
  if inside { let x = if neg { 0 - n } else { n }; let (o, _) = push(out, inl x); o } else { out }

-- The tokens of each line that is not empty.
fn cases<'t>(t: text 't) -> buf (buf (i32 + 1)) =
  fold_lines(t, !{ (l, cs) ->
    let (l, m) = array_copy['t, u8] l;
    if len(m) == 0 { array_forget['t, u8](l); cs } else { let (cs, _) = push(cs, tokens(l)); cs } },
    box buf[buf (i32 + 1)](8))

-- A binary tree: empty, or a node of a value and a cell for each subtree, the cells being Rust's
-- `Box<TreeNode>`s.
type Tree = mu X. 1 + (ref X * (i32 * ref X))

fn tip() -> Tree = roll inl ()

fn branch(l: Tree, v: i32, r: Tree) -> Tree = roll inr (alloc(l), (v, alloc(r)))

-- The tree whose preorder, with `#` for each empty subtree, starts at token `i`, and the index
-- after it. Past the end of the tokens, the empty tree.
fn parse(ts: array (i32 + 1), i: i32) -> (array (i32 + 1) * i32) * Tree =
  let x = at(&ts, i, inr ());
  match x {
    inl v ->
      let ((ts, j), l) = parse(ts, i + 1);
      let ((ts, k), r) = parse(ts, j);
      ((ts, k), branch(l, v, r))
  | inr _ -> ((ts, i + 1), tip())
  }

-- The tree of a line's tokens, from the first.
fn tree_of(ts: buf (i32 + 1)) -> Tree = let (a, n) = ts; let (_, t) = parse(a, 0); t

-- A tree's preorder, `#` for each empty subtree; the tree is consumed.
fn show(t: Tree) -> 1 =
  match unroll t {
    inl _ -> print_byte(b'#')
  | inr (cl, (v, cr)) -> print_dec(v); print_byte(b' '); show(free(cl)); print_byte(b' '); show(free(cr))
  }

-- Whether `p` and `q` are the same tree; both are consumed.
fn same(p: Tree, q: Tree) -> bool =
  match unroll p {
    inl _ -> match unroll q { inl _ -> true | inr _ -> false }
  | inr (pl, (x, pr)) -> match unroll q {
      inl _ -> false
    | inr (ql, (y, qr)) -> x == y && same(free(pl), free(ql)) && same(free(pr), free(qr))
    }
  }

-- One case: two preorders.
fn solve(b: buf (i32 + 1)) -> 1 =
  let (a, n) = b;
  let ((a, j), p) = parse(a, 0);
  let ((a, _), q) = parse(a, j);
  let v = if same(p, q) { 1 } else { 0 };
  print_dec(v)

main -> i32 =
  let s = read_input();
  let cs = borrow imm s { 't, t -> cases(t) };
  let (cs, n) = cs;
  let mut cs = cs;
  for i in 0..n {
    let (c, o) = array_replace[buf (i32 + 1)] (cs, i, filler[buf (i32 + 1)]);
    cs = c;
    match o {
      inl b -> let r = with exhausted_to_option { solve(b) };
               match r { inl _ -> () | inr _ -> print_dec(0 - 1) };
               print_byte(b'\n')
    | inr b -> ()
    }
  };
  n
