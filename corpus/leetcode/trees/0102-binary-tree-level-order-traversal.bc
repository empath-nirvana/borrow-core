-- LeetCode 102, Binary Tree Level Order Traversal.
--
-- `levels` prints a tree's values level by level, left to right: a breadth-first search whose
-- queue is a buffer of subtrees with a head index, a level being the subtrees queued when it
-- starts. Each subtree taken from the queue is taken apart: its value printed, its two cells
-- freed, and the non-empty subtrees in them queued. So the walk consumes the tree, moving each
-- subtree into the queue rather than queuing a reference to it, as the Rust
-- `VecDeque<&TreeNode>` (or `Rc` clones, in the LeetCode signature) does. Queuing views of the
-- subtrees would keep a borrow of the tree in a buffer from one turn of the loop to the next:
-- views stored in data and held across turns (T1, #172), each at the tree's lifetime through an
-- owned pointer (#219). Consuming is what the problem needs here; a caller that kept the tree
-- would rebuild it. The queue holds `1 + Tree`, not `Tree`: a buffer's free slots hold a filler,
-- and recursive data has none (`lib/buf.bc`), so each slot is an option.
--
-- The tree is `mu X. 1 + (ref X * (i32 * ref X))`, a cell per subtree, two per node where Rust
-- allocates one box (`0104-maximum-depth-of-binary-tree.bc`).
--
-- Allocations per case: two cells per node; the queue, with its growth; and the line's buffer of
-- tokens.
--
-- Input `0102-binary-tree-level-order-traversal.in`: one case a line, the tree's preorder, `#` for
-- each empty subtree. Answer: each tree's levels on a line, separated by ` | `, then the number of
-- cases, `i32[5]`.

include textio
include rec

-- The tokens of a line: each integer as `inl`, each `#` as `inr ()`.
fn tokens<'t>(l: text 't) -> buf (i32 + 1) =
  let mut out = box buf[i32 + 1](16);
  let mut n = 0;
  let mut neg = false;
  let mut inside = false;
  for p in l {
    let b = *p;
    if b'0' <= b && b <= b'9' {
      n = n * 10 + to_i32(b) - 48;
      inside = true
    } else {
      if inside {
        let x = if neg { 0 - n } else { n };
        let (o, _) = push(out, inl x);
        out = o
      } else { () };
      inside = false;
      n = 0;
      neg = b == b'-';
      if b == b'#' { let (o, _) = push(out, inr ()); out = o } else { () }
    }
  };
  if inside { let x = if neg { 0 - n } else { n }; let (o, _) = push(out, inl x); o } else { out }

-- The tokens of each line that is not empty.
fn cases<'t>(t: text 't) -> buf (buf (i32 + 1)) =
  fold_lines(t, !{ (l, cs) ->
    let (l, m) = array_copy['t, u8] l;
    if len(m) == 0 { array_forget['t, u8](l); cs } else { let (cs, _) = push(cs, tokens(l)); cs } },
    box buf[buf (i32 + 1)](8))

-- A binary tree: empty, or a node of a value and a cell for each subtree, the cells being Rust's
-- `Box<TreeNode>`s.
type Tree = mu X. 1 + (ref X * (i32 * ref X))

fn tip() -> Tree = roll inl ()

fn branch(l: Tree, v: i32, r: Tree) -> Tree = roll inr (alloc(l), (v, alloc(r)))

-- The tree whose preorder, with `#` for each empty subtree, starts at token `i`, and the index
-- after it. Past the end of the tokens, the empty tree.
fn parse(ts: array (i32 + 1), i: i32) -> (array (i32 + 1) * i32) * Tree =
  let x = at(&ts, i, inr ());
  match x {
    inl v ->
      let ((ts, j), l) = parse(ts, i + 1);
      let ((ts, k), r) = parse(ts, j);
      ((ts, k), branch(l, v, r))
  | inr _ -> ((ts, i + 1), tip())
  }

-- The tree of a line's tokens, from the first.
fn tree_of(ts: buf (i32 + 1)) -> Tree = let (a, n) = ts; let (_, t) = parse(a, 0); t

-- A tree's preorder, `#` for each empty subtree; the tree is consumed.
fn show(t: Tree) -> 1 =
  match unroll t {
    inl _ -> print_byte(b'#')
  | inr (cl, (v, cr)) -> print_dec(v); print_byte(b' '); show(free(cl)); print_byte(b' '); show(free(cr))
  }

-- The tree in cell `c` queued, unless it is empty.
fn enqueue(q: buf (1 + Tree), c: ref Tree) -> buf (1 + Tree) =
  let t = free(c);
  match unroll t {
    inl _ -> q
  | inr n -> let t: Tree = roll inr n; let (q, _) = push(q, inr t); q
  }

-- The levels of `t`, printed: one turn of the outer loop per level and of the inner loop per
-- subtree of the level, so `bound`, the number of the line's tokens, bounds both.
fn levels(t: Tree, bound: i32) -> 1 =
  let mut q = enqueue(box buf[1 + Tree](8), alloc(t));
  let mut head = 0;
  for _ in 0..bound {
    let (r, end) = len_of(q);
    q = r;
    if head == end { break } else { () };
    if 0 < head { print_lit(" | ") } else { () };
    for i in head..end {
      let (q2, o) = take(q, i);
      q = q2;
      match o {
        inl s -> match s {
            inl _ -> ()
          | inr t -> match unroll t {
              inl _ -> ()
            | inr (cl, (v, cr)) ->
                if head < i { print_byte(b' ') } else { () };
                print_dec(v);
                q = enqueue(enqueue(q, cl), cr)
            }
          }
      | inr _ -> ()
      }
    };
    head = end
  }

-- One case: the tree's preorder.
fn solve(b: buf (i32 + 1)) -> 1 = let (b, n) = len_of(b); levels(tree_of(b), n)

main -> i32 =
  let s = read_input();
  let cs = borrow imm s { 't, t -> cases(t) };
  let (cs, n) = cs;
  let mut cs = cs;
  for i in 0..n {
    let (c, o) = array_replace[buf (i32 + 1)] (cs, i, filler[buf (i32 + 1)]);
    cs = c;
    match o {
      inl b -> let r = with exhausted_to_option { solve(b) };
               match r { inl _ -> () | inr _ -> print_dec(0 - 1) };
               print_byte(b'\n')
    | inr b -> ()
    }
  };
  n
