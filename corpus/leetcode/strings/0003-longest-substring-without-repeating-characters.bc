-- LeetCode 3, Longest Substring Without Repeating Characters.
--
-- Each line of the input is one case, a string; the program prints, for each, the length of its
-- longest run of bytes in which no byte occurs twice, and answers the sum of those lengths.
--
-- A sliding window over the view: `last` holds, for each byte, one past the index where it was last
-- seen, so the window's start jumps past an earlier copy of the byte that ends it. The table is an
-- array of 256 entries, cleared and reused from case to case (Rust would keep it on the stack:
-- arrays here are always allocated, #496). One pass over the view, the `for` over the parameter.
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

fn max(a: i32, b: i32) -> i32 = if a < b { b } else { a }

-- The length of the longest run of `l` with no byte twice, and the table back.
fn longest<'t>(last: array i32, l: text 't) -> array i32 * i32 =
  let mut last = last;
  borrow mut last { v -> let v = fill(v, 0); () };
  let mut start = 0;
  let mut best = 0;
  let mut i = 0;
  for p in l {
    let b = to_i32(*p);
    let seen = at(&last, b, 0);
    start = max(start, seen);
    best = max(best, i + 1 - start);
    last = array_set(last, b, i + 1);
    i = i + 1
  };
  (last, best)

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut last = array_new[i32] (256, !{ i -> 0 });
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let (a, n) = longest(last, l);
          last = a;
          print_dec(n); print_byte(b'\n');
          sum = sum + n
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
