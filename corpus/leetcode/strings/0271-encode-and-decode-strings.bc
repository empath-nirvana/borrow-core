-- LeetCode 271, Encode and Decode Strings.
--
-- Each line of the input is one case, a list of strings separated by `|` (the empty line is the
-- empty list). The program encodes the list into one string and prints it, decodes that string
-- back into a list and prints its length and its strings joined by `|` again, which is the line it
-- read; it answers the total number of strings decoded.
--
-- Each string is encoded as its length in decimal, a `#`, and its bytes, so any byte may occur in
-- it. The list is a buffer of views of the input line, and the decoded list a buffer of views of
-- the encoded string (`buf (text 'e)`): no string is copied, where Rust's `Vec<String>` owns a
-- copy of each. The encoded string grows by `push_str`. A view is read out of a buffer of views by
-- `view_at`, a copy kept in place (#142).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

-- The strings of a line, separated by `|`.
fn fields<'t>(l: text 't) -> buf (text 't) =
  let (l, u) = array_copy['t, u8] l;
  let n = len(u);
  let mut out = box buf[text 't](8);
  if n == 0 { array_forget['t, u8](l); out } else {
    let mut rest = l;
    for _ in 0..n + 1 {
      match split_once(rest, b'|') {
        inl (w, r) -> rest = r; let (o, _) = push(out, w); out = o
      | inr w -> rest = slice_empty_imm['t, u8]; let (o, _) = push(out, w); out = o; break
      }
    };
    array_forget['t, u8](rest);
    out
  }

-- The list encoded into one string: each string's length, a `#`, and its bytes.
fn encode<'t>(strs: buf (text 't)) -> buf (text 't) * string =
  let (strs, n) = len_of(strs);
  let mut strs = strs;
  let mut enc = string_new(64);
  for i in 0..n {
    let (b, w) = view_at(strs, i);
    strs = b;
    let (w, u) = array_copy['t, u8] w;
    let (e, _) = push_dec(enc, len(u));
    let (e, _) = push_byte(e, b'#');
    let (e, _) = push_str(e, w);
    enc = e
  };
  (strs, enc)

-- The list an encoded string holds, each string a view of it.
fn decode<'e>(code: text 'e) -> buf (text 'e) =
  let (code, u) = array_copy['e, u8] code;
  let mut rest = code;
  let mut out = box buf[text 'e](8);
  for _ in 0..len(u) {
    let (r, v) = array_copy['e, u8] rest;
    if len(v) == 0 { rest = r; break } else {
      match split_once(r, b'#') {
        inl (num, after) ->
          let k = with default(0) { parse_i32(num) };
          match split_at(after, k) {
            inl (w, r2) -> rest = r2; let (o, _) = push(out, w); out = o
          | inr after -> rest = slice_empty_imm['e, u8]; array_forget['e, u8](after); break
          }
      | inr r -> rest = slice_empty_imm['e, u8]; array_forget['e, u8](r); break
      }
    }
  };
  array_forget['e, u8](rest);
  out

-- The strings of a list, joined by `|`, to standard output.
fn print_joined<'e>(strs: buf (text 'e)) -> buf (text 'e) =
  let (strs, n) = len_of(strs);
  let mut strs = strs;
  for i in 0..n {
    if 0 < i { print_byte(b'|') } else { () };
    let (b, w) = view_at(strs, i);
    strs = b;
    print_str(w)
  };
  strs

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let (_, enc) = encode(fields(l));
          let enc = print_string(enc);
          print_byte(b'\n');
          let k = borrow imm enc { 'e, e ->
            let strs = decode(e);
            let (strs, k) = len_of(strs);
            print_dec(k); print_byte(b' ');
            let _ = print_joined(strs);
            k };
          print_byte(b'\n');
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
