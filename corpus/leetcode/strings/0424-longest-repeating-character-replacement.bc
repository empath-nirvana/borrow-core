-- LeetCode 424, Longest Repeating Character Replacement.
--
-- Each line of the input is one case: a number `k`, a space, and a string of capital letters. The
-- program prints, for each, the length of the longest run that can be made of one letter by
-- changing at most `k` bytes, and answers the sum of those lengths.
--
-- A sliding window over the view with the counts of its letters (an array of 26, reused from case
-- to case; on the stack in Rust, #496) and the largest count seen. The window grows by one byte at
-- each step, and when it has more than `k` bytes that are not its commonest letter it slides
-- instead: its first byte leaves. The largest count is never lowered, so the window never shrinks,
-- and the answer is its final length. The byte leaving is read by index: a view is not duplicable
-- (#142) and has no `v[i]` (#143), so each read takes a copy of the view first (`byte_at`).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
-- The views read in the loop are bound under names not used outside it: a body binding that
-- shadows a consumed linear variable is threaded in its place (#493).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

fn max(a: i32, b: i32) -> i32 = if a < b { b } else { a }

-- The byte at `i`, and the view back.
fn byte_at<'t>(t: text 't, i: i32) -> text 't * u8 =
  let (t, u) = array_copy['t, u8] t;
  (t, at(u, i, 0))

-- The length of the longest run of one letter after at most `k` changes, and the counts back.
fn longest<'t>(counts: array i32, k: i32, s: text 't) -> array i32 * i32 =
  let mut counts = counts;
  borrow mut counts { v -> let v = fill(v, 0); () };
  let mut s = s;
  let (s1, u) = array_copy['t, u8] s;
  s = s1;
  let n = len(u);
  let mut start = 0;
  let mut most = 0;
  for i in 0..n {
    let (s2, b) = byte_at(s, i);
    s = s2;
    let c = to_i32(b) - 65;
    let old = at(&counts, c, 0);
    counts = array_set(counts, c, old + 1);
    most = max(most, old + 1);
    if i + 1 - start - most > k {
      let (s3, f) = byte_at(s, start);
      s = s3;
      let d = to_i32(f) - 65;
      let had = at(&counts, d, 0);
      counts = array_set(counts, d, had - 1);
      start = start + 1
    } else { () }
  };
  (counts, n - start)

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut counts = array_new[i32] (26, !{ i -> 0 });
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          match split_once(l, b' ') {
            inl (kt, w) ->
              let k = with default(0) { parse_i32(kt) };
              let (a, n) = longest(counts, k, w);
              counts = a;
              print_dec(n); print_byte(b'\n');
              sum = sum + n
          | inr l -> ()
          }
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
