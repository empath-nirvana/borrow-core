-- LeetCode 20, Valid Parentheses.
--
-- Each line of the input is one case, a run of the brackets `()[]{}`; the program prints `true` or
-- `false` for each, and answers how many were balanced.
--
-- The open brackets go on a stack, a buffer reused from case to case (`clear`); a closing bracket
-- pops it and must match. A case is left at its first mismatch (`break` out of the counted loop
-- over the view). A stack over a view of the input.
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

fn opener(b: u8) -> u8 = if b == b')' { b'(' } else { if b == b']' { b'[' } else { b'{' } }

fn is_open(b: u8) -> bool = b == b'(' || b == b'[' || b == b'{'

-- Whether one case is balanced, with the stack (reused from case to case) back.
fn valid<'t>(stack: buf u8, l: text 't) -> buf u8 * bool =
  let mut stack = clear(stack);
  let mut ok = true;
  for p in l {
    let b = *p;
    if is_open(b) { let (s, _) = push(stack, b); stack = s } else {
      let (s, last) = pop(stack);
      stack = s;
      let o : u8 = match last { inl x -> x | inr u -> 0 };
      if o != opener(b) { ok = false; break } else { () }
    }
  };
  let (stack, n) = len_of(stack);
  (stack, ok && n == 0)

main -> i32 =
  let s = read_input();
  let count = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut stack = box buf[u8](16);
    let mut count = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let (st, ok) = valid(stack, l);
          stack = st;
          if ok { print_lit("true\n"); count = count + 1 } else { print_lit("false\n") }
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    count };
  count
