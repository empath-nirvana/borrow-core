-- LeetCode 49, Group Anagrams.
--
-- Each line of the input is one case, words separated by spaces. The program prints, for each,
-- its groups of words that are rearrangements of one another, a group to a line with its words in
-- the order they came, the groups in the order of their first words, and a line `--` after the
-- case; it answers the total number of groups.
--
-- A word's key is its bytes, sorted, in a string of its own (as Rust's `String` key). A map from
-- key to the index of the key's group (`Map[string, i32]`) finds a word's group; the groups are a
-- buffer of buffers of views of the input, so no word is copied, and their order is the order of
-- first appearance, which a map's iteration would not give. The map is `lib/map.bc`'s hash map,
-- keyed by the `hash` and `equal` of `string` (`lib/key.bc`, SPEC §36: a buffer's case, which
-- compares the initialised bytes): `map_new[K, V](cap)`, `map_insert(&mut m, k, v)` answering the
-- value it displaces, and `map_lookup(&m, k)` a copy of a persistent value. The key sought is given
-- by value, and the lookup drops it; on a word whose group is new, the key is made again for the
-- insertion (Rust's `get(&k)` borrows it instead).
--
-- Answer on `0049-group-anagrams.in`,
--
--     eat tea ate
--     tan nat
--     bat
--     --
--     a
--     --
--     --
--     abc bca cab cba
--     xyz zyx
--     --
--     listen silent enlist inlets
--     google
--     banana
--     --
--     ab ab ba
--     b
--     --
--
-- then `i32[11]`, the number of groups.

include textio
include map

-- The words of a line, separated by spaces.
fn words<'t>(l: text 't) -> buf (text 't) =
  let (l, u) = array_copy['t, u8] l;
  let n = len(u);
  let mut out = box buf[text 't](8);
  if n == 0 { array_forget['t, u8](l); out } else {
    let mut rest = l;
    for _ in 0..n + 1 {
      match split_once(rest, b' ') {
        inl (w, r) -> rest = r; let (o, _) = push(out, w); out = o
      | inr w -> rest = slice_empty_imm['t, u8]; let (o, _) = push(out, w); out = o; break
      }
    };
    array_forget['t, u8](rest);
    out
  }

-- A word's key: its bytes, sorted, in a string of its own.
fn key<'t>(w: text 't) -> string =
  let mut k = to_string(w);
  borrow mut k { v -> let v = sort(v, cmp_u8, 0); () };
  k

-- `w` pushed onto group `g`.
fn add_to<'t>(groups: buf (buf (text 't)), g: i32, w: text 't) -> buf (buf (text 't)) =
  let (a, n) = groups;
  let (a, o) = array_replace[buf (text 't)] (a, g, filler[buf (text 't)]);
  match o {
    inl grp ->
      let (grp, _) = push(grp, w);
      let (a, _) = array_replace[buf (text 't)] (a, g, grp);
      (a, n)
  | inr e -> array_forget['t, u8](w); (a, n)
  }

-- The words of a case in groups of rearrangements, in the order of their first words.
fn group<'t>(words: buf (text 't)) -> buf (buf (text 't)) =
  let (words, n) = len_of(words);
  let mut words = words;
  let mut index : Map[string, i32] = map_new[string, i32](16);
  let mut groups = box buf[buf (text 't)](8);
  for i in 0..n {
    let (b, w) = view_at(words, i);
    words = b;
    let (w, v) = array_copy['t, u8] w;
    let (w, v2) = array_copy['t, u8] w;
    let o = map_lookup(&index, key(v));
    match o {
      inl g -> array_forget['t, u8](v2); groups = add_to(groups, g, w)
    | inr _ ->
        let (gs, m) = len_of(groups);
        let (gs, _) = push(gs, box buf[text 't](4));
        groups = add_to(gs, m, w);
        map_insert(&mut index, key(v2), m)
    }
  };
  groups

-- Group `g`'s words, separated by spaces, on a line.
fn print_group<'t>(groups: buf (buf (text 't)), g: i32) -> buf (buf (text 't)) =
  let (a, n) = groups;
  let (a, o) = array_replace[buf (text 't)] (a, g, filler[buf (text 't)]);
  match o {
    inl grp ->
      let (grp, k) = len_of(grp);
      let mut grp = grp;
      for i in 0..k {
        if 0 < i { print_byte(b' ') } else { () };
        let (b, w) = view_at(grp, i);
        grp = b;
        print_str(w)
      };
      print_byte(b'\n');
      let (a, _) = array_replace[buf (text 't)] (a, g, grp);
      (a, n)
  | inr e -> (a, n)
  }

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let groups = group(words(l));
          let (groups, k) = len_of(groups);
          let mut groups = groups;
          for g in 0..k { groups = print_group(groups, g) };
          print_lit("--\n");
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
