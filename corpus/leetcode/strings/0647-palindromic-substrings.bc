-- LeetCode 647, Palindromic Substrings.
--
-- Each line of the input is one case, a string. The program prints, for each, how many of its runs
-- (counted by position) read the same both ways, and answers the sum of those counts.
--
-- Expansion around each of the `2n - 1` centres, a byte or the gap between two: every step outward
-- whose two bytes match is one more palindrome. A counted loop per centre that leaves by `break`;
-- nothing is allocated. Each read takes a copy of the view first (`byte_at`): a view is not
-- duplicable (#142) and has no `v[i]` (#143).
--
-- The lines are walked by hand, a counted loop over `next_line` in `main`, so that each answer is
-- printed as it is found: the closure of `fold_lines` cannot print (#161), and a `for` over
-- `lines(t)` is a drain whose iterator holds the borrow of the input (SPEC §14).
--
-- The answers on the `.in` beside it agree with a brute-force reference solution, run separately.

include textio

-- The byte at `i`, and the view back.
fn byte_at<'t>(t: text 't, i: i32) -> text 't * u8 =
  let (t, u) = array_copy['t, u8] t;
  (t, at(u, i, 0))

-- The number of palindromes around the centre `l`, `r`: the steps outward from `l` and `r` whose
-- bytes match, `l` and `r` themselves first.
fn reach<'t>(s: text 't, n: i32, l: i32, r: i32) -> text 't * i32 =
  let mut s = s;
  let mut k = 0;
  for _ in 0..n {
    if l - k < 0 || n <= r + k { break } else { () };
    let (s1, a) = byte_at(s, l - k);
    let (s2, b) = byte_at(s1, r + k);
    s = s2;
    if a == b { k = k + 1 } else { break }
  };
  (s, k)

-- The number of palindromic runs of `s`.
fn count<'t>(s: text 't) -> i32 =
  let mut s = s;
  let (s1, u) = array_copy['t, u8] s;
  s = s1;
  let n = len(u);
  let mut sum = 0;
  for c in 0..2 * n - 1 {
    let l = host[shr_u32](c, 1);
    let (s2, k) = reach(s, n, l, l + host[and32](c, 1));
    s = s2;
    sum = sum + k
  };
  array_forget['t, u8](s);
  sum

main -> i32 =
  let s = read_input();
  let sum = borrow imm s { 't, t ->
    let (t, u) = array_copy['t, u8] t;
    let mut rest = t;
    let mut sum = 0;
    for _ in 0..len(u) + 1 {
      match next_line(rest) {
        inl (l, r) ->
          rest = r;
          let k = count(l);
          print_dec(k); print_byte(b'\n');
          sum = sum + k
      | inr _ -> rest = slice_empty_imm['t, u8]; break
      }
    };
    sum };
  sum
