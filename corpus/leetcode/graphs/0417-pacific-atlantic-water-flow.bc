-- LeetCode 417, Pacific Atlantic Water Flow.
--
-- Water runs from a square to a neighbour no higher than it; the Pacific touches the top row and
-- the left column, the Atlantic the bottom row and the right column. `reach` answers, for one
-- ocean, which squares drain into it: a breadth-first search that starts from every square on
-- that ocean's edges and climbs, from a square to each neighbour at least as high. The squares
-- both searches reach are the answer, in row-major order. The heights are the buffer of the
-- line's numbers, read from an offset; each search's seen array and queue hold each square at
-- most once. A 2D grid, multi-source BFS and two visited sets.
--
-- Allocations per case: two seen arrays and two queues, as a Rust solution with two
-- `Vec<bool>`s and a `VecDeque` reused or not; and the line's buffer of numbers.
--
-- Input `0417-pacific-atlantic-water-flow.in`: one case a line, the rows, the columns, then the
-- heights row by row. Answer: for each case a line of the squares that drain into both oceans,
-- each as `row,column`, then the number of cases, `i32[5]`.

include textio

-- The numbers of a line.
fn nums<'t>(l: text 't) -> buf i32 =
  fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](8))

-- The numbers of each line that is not empty.
fn cases<'t>(t: text 't) -> buf (buf i32) =
  fold_lines(t, !{ (l, cs) ->
    let (l, m) = array_copy['t, u8] l;
    if len(m) == 0 { array_forget['t, u8](l); cs } else { let (cs, _) = push(cs, nums(l)); cs } },
    box buf[buf i32](8))

-- The neighbour of `p` in direction `d` (up, right, down, left), or `-1` off the grid.
fn step(p: i32, d: i32, w: i32, h: i32) -> i32 =
  let x = p - p / w * w;
  let y = p / w;
  let nx = if d == 1 { x + 1 } else { if d == 3 { x - 1 } else { x } };
  let ny = if d == 0 { y - 1 } else { if d == 2 { y + 1 } else { y } };
  if 0 <= nx && nx < w && 0 <= ny && ny < h { ny * w + nx } else { 0 - 1 }

-- Whether square `p` lies on an edge of ocean `o`: the Pacific (`0`) on the top row or the left
-- column, the Atlantic (`1`) on the bottom row or the right column.
fn on_edge(p: i32, o: i32, w: i32, h: i32) -> bool =
  let x = p - p / w * w;
  let y = p / w;
  if o == 0 { y == 0 || x == 0 } else { y == h - 1 || x == w - 1 }

-- The squares that drain into ocean `o`, of a grid of `h` rows and `w` columns whose square `i`
-- has height `hs[b + i]`.
fn reach(hs: array i32, b: i32, h: i32, w: i32, o: i32) -> array i32 * array bool =
  let n = h * w;
  let mut hs = hs;
  let mut seen = array_new[bool] (n, !{ i -> false });
  let mut queue = array_new[i32] (n, !{ i -> 0 });
  let mut tail = 0;
  for p in 0..n {
    if on_edge(p, o, w, h) {
      seen = array_set(seen, p, true);
      queue = array_set(queue, tail, p);
      tail = tail + 1
    } else { () }
  };
  let mut head = 0;
  for _ in 0..n {
    if head == tail { break } else { () };
    let p = at(&queue, head, 0);
    head = head + 1;
    let hp = at(&hs, b + p, 0);
    for d in 0..4 {
      let q = step(p, d, w, h);
      if 0 <= q {
        let hq = at(&hs, b + q, 0);
        let been = at(&seen, q, true);
        if hp <= hq && not(been) {
          seen = array_set(seen, q, true);
          queue = array_set(queue, tail, q);
          tail = tail + 1
        } else { () }
      } else { () }
    }
  };
  (hs, seen)

-- One case: `h`, `w`, then the heights; the squares that drain into both oceans printed.
fn solve(c: buf i32) -> 1 =
  let (a, k) = c;
  let h = at(&a, 0, 0);
  let w = at(&a, 1, 0);
  let (a, pacific) = reach(a, 2, h, w, 0);
  let (a, atlantic) = reach(a, 2, h, w, 1);
  let mut first = true;
  for p in 0..h * w {
    let x = at(&pacific, p, false);
    let y = at(&atlantic, p, false);
    if x && y {
      if first { first = false } else { print_byte(b' ') };
      print_dec(p / w); print_byte(b','); print_dec(p - p / w * w)
    } else { () }
  };
  print_byte(b'\n')

main -> i32 =
  let s = read_input();
  let cs = borrow imm s { 't, t -> cases(t) };
  let (cs, n) = cs;
  let mut cs = cs;
  for i in 0..n {
    let (c, o) = array_replace[buf i32] (cs, i, filler[buf i32]);
    cs = c;
    match o { inl b -> solve(b) | inr b -> () }
  };
  n
