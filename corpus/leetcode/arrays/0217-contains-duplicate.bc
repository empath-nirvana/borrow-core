-- LeetCode 217, Contains Duplicate.
--
-- One pass with a set of the numbers seen: the first number already in it is a duplicate. The set
-- is `lib/map.bc`'s hash set, `Set[K] = Map[K, 1]`, keyed by the `hash` and `equal` of `i32`
-- (`lib/key.bc`, SPEC §36): `set_new[K](cap)`, and `set_insert(&mut s, k)`, whether `k` was not
-- yet in it, as Rust's `HashSet::insert`.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, the spanning lend
-- (#172, SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0217-contains-duplicate.in`: `true false true false false true`, one per line, then
-- `i32[6]`, the number of cases.

include textio
include map

fn contains_duplicate<'a>(nums: array_imm 'a i32) -> bool =
  let mut seen = set_new[i32](16);
  let mut dup = false;
  for p in nums {
    let x = *p;
    let fresh = set_insert(&mut seen, x);
    if fresh { () } else { dup = true; break }
  };
  dup

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> (buf i32 * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](16));
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl (b, next) ->
        let r = borrow imm b { v -> contains_duplicate(v) };
        if r { print_lit("true") } else { print_lit("false") };
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
