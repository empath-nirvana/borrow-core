-- LeetCode 11, Container With Most Water.
--
-- Two pointers from the ends: the area between them is the width times the shorter line, and the
-- shorter line moves inwards, since no container that keeps it can be larger.
--
-- Each line of the input is a case, and its answer is printed on a line of its own. `cases` holds
-- the input and the offset of the next line; each turn lends the input to read one line
-- (`case_at`), and the case is solved on what was read, outside the lend. A loop over the lines of
-- the lent input, `for l in lines(t)`, would hold the borrow across its turns, the spanning lend
-- (#172, SPEC §14 *Not covered*), and a `fold_lines` callback cannot print (#161).
--
-- Answer on `0011-container-with-most-water.in`: `49 1 16 2 17 4`, one per line, then `i32[6]`, the
-- number of cases.

include textio

fn max_area(a: array i32, n: i32) -> array i32 * i32 =
  let mut lo = 0;
  let mut hi = n - 1;
  let mut best = 0;
  while lo < hi {
    let x = at(&a, lo, 0);
    let y = at(&a, hi, 0);
    let h = if x < y { x } else { y };
    if best < h * (hi - lo) { best = h * (hi - lo) } else { () };
    if x < y { lo = lo + 1 } else { hi = hi - 1 }
  };
  (a, best)

-- The case on the line that starts at `pos`, and where the next line starts; or `inr ()` at the end
-- of the input.
fn case_at<'t>(t: text 't, pos: i32) -> (buf i32 * i32) + 1 =
  match split_at(t, pos) {
    inl (h, rest) ->
      array_forget['t, u8](h);
      match next_line(rest) {
        inl (l, r) ->
          array_forget['t, u8](r);
          let (l, m) = array_copy['t, u8] l;
          let c = fold_i32s(l, !{ (x, b) -> let (b, _) = push(b, x); b }, box buf[i32](16));
          inl (c, pos + len(m) + 1)
      | inr u -> inr ()
      }
  | inr t -> array_forget['t, u8](t); inr ()
  }

-- Each line of the input a case. The number of cases.
fn cases(s: string) -> string * i32 =
  let mut s = s;
  let mut pos = 0;
  let mut count = 0;
  loop {
    let c = borrow imm s { 't, t -> case_at(t, pos) };
    match c {
      inl ((a, k), next) ->
        let (a, r) = max_area(a, k);
        print_dec(r);
        print_byte(b'\n');
        pos = next;
        count = count + 1
    | inr u -> break
    }
  };
  (s, count)

main -> i32 =
  let (s, count) = cases(read_input());
  count
