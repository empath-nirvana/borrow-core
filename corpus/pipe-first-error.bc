-- check: old-backend-refuses
-- SPEC §75, Part B, law 7 ((a′)(ii)) on the pipe connector: the first cleanup error is the one
-- reported. The middle's cleanup raises `20` and the source's `10`; the sink's raises nothing.
--   * On a raise: the sink raises `30` at its second item. The others are stopped
--     downstream-first in one region (`close_others`), the middle first: its `20` is the first
--     error, and the source's `10` is dropped: `321`, `inr i32[20]`. A region per frame would
--     report the source's, the latest.
--   * On a cancel from outside: the sink waits at its second item and `tm` cancels there. The
--     connector forwards the sink's `wait`, under `close_all`, which stops every stage
--     downstream-first in one region: the middle's `20` is the first error, and it replaces the
--     cancel: `321`, `inr i32[20]`.
--   * At `stop()`: the middle takes two items and stops its upstream; the sink raises nothing. The
--     source's cleanup raises `10` in that region (`close_up`). The connector raises the region's
--     error under the frame list of the middle and the stages downstream of it (`close_down`),
--     which stops them downstream-first in one region: the sink, then the middle, whose cleanup
--     raises `20`, that region's first error, which replaces the `10` in flight: `132`,
--     `inr i32[20]`.
-- Answer: `321.321.132(inr i32[20], (inr i32[20], inr i32[20]))`, `live 0`.

include io
include pipe
include fail

effect Trace { must_resume ctl note(d: i32); must_resume ctl dot() }

handler show[A]: Trace, A -> A = {
  return(x) = x;
  note(d, k) = { print_dec(d); k(()) };
  dot(k) = { print_byte(b'.'); k(()) }
}

effect Wait { ctl wait() }

-- `tm` cancels the computation at its `wait()`: its clause does not resume.
handler tm[A]: Wait, A -> A + 1 = {
  return(x) = inl x;
  wait(k) = inr ()
}

fn bye(d: i32, e: i32) -> 1 with Trace, Fail[i32] =
  note(d);
  raise(e)

fn chk(v: i32, at: i32, code: i32) -> i32 with Fail[i32] = if v == at { raise(code) } else { v }

fn src(n: i32) -> 1 with Yield[i32], Trace, Fail[i32] =
  x <- (
    let mut i = 1;
    while i <= n { yield(i); i = i + 1 };
    ()) unwind (bye(1, 10));
  note(1);
  x

fn mid() -> 1 with Stream[i32, 1], Yield[i32], Trace, Fail[i32] =
  x <- (
    let mut go = true;
    while go { match next() { inl v -> yield(v * 10) | inr u -> go = false } };
    ()) unwind (bye(2, 20));
  note(2);
  x

-- The middle takes two items, then stops its upstream and ends.
fn take2() -> 1 with Stream[i32, 1], Yield[i32], Trace, Fail[i32] =
  x <- (
    let a = match next() { inl v -> v | inr u -> 0 };
    yield(a * 10);
    let b = match next() { inl v -> v | inr u -> 0 };
    yield(b * 10);
    stop();
    ()) unwind (bye(2, 20));
  note(2);
  x

fn sink() -> i32 with Stream[i32, 1], Trace, Fail[i32] =
  x <- (
    let mut s = 0;
    let mut go = true;
    while go { match next() { inl v -> s = s + chk(v, 20, 30) | inr u -> go = false } };
    s) unwind (note(3));
  note(3);
  x

-- A sink that raises nothing.
fn sum_all() -> i32 with Stream[i32, 1], Trace =
  x <- (
    let mut s = 0;
    let mut go = true;
    while go { match next() { inl v -> s = s + v | inr u -> go = false } };
    s) unwind (note(3));
  note(3);
  x

-- The sink waits at its second item.
fn wait_at(v: i32) -> i32 with Wait = if v == 20 { wait(); v } else { v }

fn sink_wait() -> i32 with Stream[i32, 1], Trace, Fail[i32], Wait =
  x <- (
    let mut s = 0;
    let mut go = true;
    while go { match next() { inl v -> s = s + wait_at(v) | inr u -> go = false } };
    s) unwind (note(3));
  note(3);
  x

fn plain(r: i32 + i32) -> i32 + i32 = r

fn on_cancel(r: (i32 + 1) + i32) -> i32 + i32 =
  match r { inl a -> (match a { inl v -> (inl v : i32 + i32) | inr u -> (inl 0 : i32 + i32) }) | inr e -> (inr e : i32 + i32) }

main -> (i32 + i32) * ((i32 + i32) * (i32 + i32)) =
  with show[(i32 + i32) * ((i32 + i32) * (i32 + i32))] {
    let a = plain(with to_result[i32, i32] { src(5) >| mid >| sink });
    dot();
    let b = on_cancel(with to_result[i32, i32 + 1] { with tm[i32] { src(5) >| mid >| sink_wait } });
    dot();
    let c = plain(with to_result[i32, i32] { src(5) >| take2 >| sum_all });
    (a, (b, c))
  }
