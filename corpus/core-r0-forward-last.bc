-- R0 (SPEC §54) in the core text: an abort through a `handle_last` of another name. The handler
-- `handle_last[2: aff]` is inside `handle_with[1]` of the abortive operation `1.0 aff i32 ~> 0`, so
-- its outer row holds `1.0`: its exit aborts `1.0` with `7`. R0's forwarding rule for
-- `[handle-last]` writes the answer clause to forward `1`'s payload, and translates the works and
-- the exits homomorphically.
--
-- Answer: (inl i32[20], inr i32[7]): at `inl ()` the work resumes with `10` twice; at `inr ()` it
-- cancels the continuation and the exit aborts.

def plus : i32 * i32 => i32 = unbang host[add32]

def twice : !U (1 + 1 -o F[2.0 aff 1 + 1 ~> i32, 1.0 aff i32 ~> 0] i32) =
  !thunkv fun (s : 1 + 1) ->
    a <- perform[2.0] s;
    t <- return (inl () : 1 + 1);
    b <- perform[2.0] t;
    return (plus (a, b))

def handled : !U (1 + 1 -o F (i32 + i32)) =
  !thunkv fun (s : 1 + 1) ->
    handle_with[1](
        ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
        (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (
      handle_last[2: aff](
          ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F[1.0 aff i32 ~> 0] i32)),
          ((((!thunkv fun (s : 1 + 1) ->
               case s { inl x -> let () = x; return (inl i32[10]) | inr y -> let () = y; return (inr ()) }),
             ()) : !U (1 + 1 -o F (i32 + 1)) * 1),
           (((!thunkv fun (z : 1) -> let () = z; abort[1.0] i32[7]), ()) : !U (1 -o F[1.0 aff i32 ~> 0] i32) * 1)))
        (f <- return (unbang twice); force f s))

main : F ((i32 + i32) * (i32 + i32)) =
  f <- return (unbang handled);
  a <- return (inl () : 1 + 1);
  r1 <- force f a;
  g <- return (unbang handled);
  b <- return (inr () : 1 + 1);
  r2 <- force g b;
  return (r1, r2)
