-- `parse-recover-gen.bc` over a lent token view: the tokens are lent, not moved. The generator's
-- tokens stay in the buffer the `for` collects them into, and `run_all` parses under
-- `borrow imm b { v -> … }`. Each parsing function takes the shared view `v` and an index, reads
-- the token at the index where it lies (`at`, a copy of a persistent `i32 * i32`), and answers its
-- value with the index after what it read. A statement that raises leaves the tokens where they
-- were, so the error arm resynchronises from the statement's own start, `skip_statement(v, i)`,
-- with no copy of the tokens: `parse-recover-gen.bc` clones the whole remaining list twice per
-- statement for that (#1064, P6: lend, don't move).
--
-- The view is used many times. Each use past the first is the checker's derived copy of the view
-- (SPEC §12, *The derived copy at `imm`*), a copy of the handle, not of the tokens.
--
-- Answer: as `parse-recover.bc`, `([3, 6, 77, 8], [(3, 1), (5, 2)])`; `live 0`.

include text
include yield
include rec
include list
include buf
include slice

-- A token: its kind and its value. Kinds: 0 a number, 1 `+`, 2 `*`, 3 `(`, 4 `)`, 5 `;`.
type Tok = i32 * i32

fn is_digit(b: u8) -> bool = 48 <= b && b <= 57

fn kind_of(b: u8) -> i32 =
  if b == b'+' { 1 } else { if b == b'*' { 2 } else { if b == b'(' { 3 } else {
  if b == b')' { 4 } else { if b == b';' { 5 } else { 0 - 1 } } } } }

-- The tokens of a literal: numbers, operators and `;`; blanks are skipped. A trailing statement is
-- closed with a `;`.
fn tokens(src: lit) -> 1 with Yield[Tok] =
  let (n, byte) = src;
  let mut num = 0;
  let mut in_num = false;
  for i in 0..n {
    let b = byte(i);
    if is_digit(b) { num = num * 10 + to_i32(b) - 48; in_num = true }
    else {
      if in_num { yield((0, num)); num = 0; in_num = false } else { () };
      let k = kind_of(b);
      if k >= 0 { yield((k, 0)) } else { () }
    }
  };
  if in_num { yield((0, num)) } else { () };
  yield((5, 0))

-- The token at `i`, or the end marker `(-1, 0)` past the last.
fn tok<'a>(v: array_imm 'a Tok, i: i32) -> Tok = at(v, i, (0 - 1, 0))

fn expr<'a>(v: array_imm 'a Tok, i: i32) -> i32 * i32 with Fail[i32], Exhausted =
  let (x, i) = term(v, i);
  expr_rest(v, x, i)

fn expr_rest<'a>(v: array_imm 'a Tok, acc: i32, i: i32) -> i32 * i32 with Fail[i32], Exhausted =
  let (k, x) = tok(v, i);
  if k == 1 { let (y, j) = term(v, i + 1); expr_rest(v, acc + y, j) } else { (acc, i) }

fn term<'a>(v: array_imm 'a Tok, i: i32) -> i32 * i32 with Fail[i32], Exhausted =
  let (x, i) = factor(v, i);
  term_rest(v, x, i)

fn term_rest<'a>(v: array_imm 'a Tok, acc: i32, i: i32) -> i32 * i32 with Fail[i32], Exhausted =
  let (k, x) = tok(v, i);
  if k == 2 { let (y, j) = factor(v, i + 1); term_rest(v, acc * y, j) } else { (acc, i) }

fn factor<'a>(v: array_imm 'a Tok, i: i32) -> i32 * i32 with Fail[i32], Exhausted =
  let (k, x) = tok(v, i);
  if k == 0 { (x, i + 1) } else {
    if k == 3 {
      let (y, j) = expr(v, i + 1);
      let (kc, xc) = tok(v, j);
      if kc == 4 { (y, j + 1) } else { raise(2) }
    } else { raise(1) }
  }

-- One statement: its value, and the index after its `;`.
fn statement<'a>(v: array_imm 'a Tok, i: i32) -> i32 * i32 with Fail[i32], Exhausted =
  let (x, i) = expr(v, i);
  let (k, u) = tok(v, i);
  if k < 0 { (x, i) } else { if k == 5 { (x, i + 1) } else { raise(5) } }

-- The index after the next `;`.
fn skip_statement<'a>(v: array_imm 'a Tok, i: i32) -> i32 with Exhausted =
  let (k, x) = tok(v, i);
  if k < 0 { i } else { if k == 5 { i + 1 } else { skip_statement(v, i + 1) } }

effect Diag { fn report(stmt: i32, code: i32) }

handler collect(mut seen: List[i32 * i32]): Diag = {
  report(stmt, code) = { seen = cons((stmt, code), seen); () }
}

-- Every statement parsed, in order: the values of the good ones; each bad one reported.
fn run_all<'a>(v: array_imm 'a Tok) -> List[i32] =
  let n = len(v);
  let mut i = 0;
  let mut vals = nil[i32]();
  let mut s = 0;
  -- At most one statement per token.
  for _ in 0..n {
    if i < n {
      s = s + 1;
      match with to_result { statement(v, i) } {
        inl (x, j) -> vals = cons(x, vals); i = j
      | inr code -> report(s, code); i = skip_statement(v, i)
      }
    } else { () }
  };
  fold(vals, nil[i32](), !{ (acc, x) -> cons(x, acc) })

-- The tokens of the source, in order, in a buffer.
fn token_buf(src: lit) -> buf Tok =
  let mut b = buf_new[Tok](16);
  for t in tokens(src) { let (b2, _) = push(b, t); b = b2 };
  b

main -> List[i32] * List[i32 * i32] =
  let b = token_buf("1+2; 2*3; 4*; 7*(5+6); (8; 8");
  with on_exhausted(!{ u -> (nil(), nil()) }) {
    let reports = alloc(nil[i32 * i32]());
    let vals = with collect(&mut reports) { borrow imm b { v -> run_all(v) } };
    let rs = free(reports);
    (vals, fold(rs, nil[i32 * i32](), !{ (acc, r) -> cons(r, acc) }))
  }
