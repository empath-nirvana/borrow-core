#! dialect 82
# Goal program for RQ1 (#1122): checks under PinLaw (an accepted assumption); see the register.
# RQ1 (#838; register #1122), the first configuration of E3 at the surface: OBEff's Example A
# (Chen, Tanabe, Sekiyama, PPL 2026, §3.2 and §4.2.4) in its `mut` form. The cell `c` is owned
# outside the handled block, moved in and handed back. Inside the block a `mut` borrow of it (the
# lend `α`) is made, and `op` is performed under it, so `κ` holds the borrow. The handler `h` is
# general: its clause stores `κ` (the kind `stored`), opens and closes a lend `β` of a cell of its
# own, `c2`, while `κ` is parked (`β` a sibling of `α`), then resumes `κ`. `κ` writes through the
# borrow twice and the borrow ends, so `c` returns to its owner. `corpus/rq1-generator.bc` is the
# same cells with the resumption under `β` instead of beside it.
#
# Today it checks with `assurance: PinLaw (R1 at 38:13)`: `α` is R1 (`withbor2r`), with PinLaw's
# `LendFrame` assumed there. It is pending an unconditional assurance (RQ1 E3.3's done-when);
# `corpus/trusted/rq1-exampleA-mut.txt` pins the site, so the gate fails when that changes.
#
# Answer: (i32[111], i32[1011]): `c` is 1, then 11 and 111 through the borrow after the resume;
# `c2` is 1000 + 11 (`op`'s argument) when the clause frees it. `live 0`.

effect Op { ctl op(x: i32) : 1 }

handler h: Op, (ref i32) -> ref i32 * i32 {
  return(c) -> (c, 0)
  op(x, k) -> {
    let parked = (k, x)
    let c2 = alloc(1000)
    borrow mut c2 { m2 -> modify m2 { v -> v + x } }
    let w = free(c2)
    let (k2, y) = parked
    let u = ()
    let r = (force k2).1 u
    let (c, n) = r;
    (c, n + w)
  }
}

fn main() : i32 * i32 {
  let c = alloc(1)
  let (c, w) = handle {
    let _ = borrow mut c { m ->
      let a = modify m { v -> (v, v) }
      op(a + 10)
      modify m { v -> v + 10 }
      modify m { v -> v + 100 };
      ()
    }
    c
  } with h;
  (free(c), w)
}
