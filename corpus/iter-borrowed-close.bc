-- Early close of a borrowed iterator (SPEC §7, borrowed iteration), with the list still owned
-- and freed after. [100, 20, 3] is a `Seq` in a cell, borrowed `imm` by withbor1; the borrow is
-- copied, and each copy is loaded once, giving two families of views at 'y and 'z. The first
-- iterator yields one element and is closed by `close` (`.2`); the second, `u0`, is never used:
-- its implicit destructor (SPEC §12) runs its `close`. Both closes forget the views they hold
-- and free nothing, so the caller still owns every cell: `digits` reads the sequence, head last
-- in base 1000, and frees it.
--
-- Answer: (i32[100], i32[3020100]). A first element read from the wrong position gives 20 or 3;
-- a close that freed the borrowed cells would free them a second time in `digits`, and one that
-- ran `next` or changed the sequence changes 3020100. `live 0` checks that all four cells are
-- freed.

type Seq = mu X. 1 + (ref i32 * X)

def plus : i32 * i32 => i32 = unbang host[add32]

def nil : Seq = roll (inl ())

def cons : i32 * Seq => Seq =
  thunkv fun (p : i32 * Seq) -> let (x, s) = p; return (roll (inr (alloc[i32] x, s)))

-- The borrowed iterator (Core/BorrowedIter.lean, `iterImmV`): `unfold` with the views as its
-- state. `next` yields the head view and the rest of the views; `close` drops the views that
-- are left (the implicit destructor of the state forgets each `imm`).
def iter_imm[A] : !(all 'a < top. (mu X. 1 + (imm 'a A * X)) => U (iter (imm 'a A) 1 1)) =
  !thunkv Fun 'a < top.
    f <- return (unbang (unfold[iter (imm 'a A) 1 1, mu X. 1 + (imm 'a A * X)]
           (!thunkv fun (s : mu X. 1 + (imm 'a A * X)) ->
              < case (unroll s) {
                  inl u -> return (inr u : (imm 'a A * (mu X. 1 + (imm 'a A * X))) + 1)
                | inr p -> return (inl p : (imm 'a A * (mu X. 1 + (imm 'a A * X))) + 1)
                },
                return () >)));
    return (thunkv fun (vs : mu X. 1 + (imm 'a A * X)) ->
      return (thunkv nu_in < (nu_out (force f vs)).1, (nu_out (force f vs)).2 >))

-- Read an element through its view.
def read : !(all 'a < top. imm 'a i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (v : imm 'a i32) ->
    return (withload['a, 'z, i32, i32] v
      (thunkv Fun 'z < dom. return (thunkv fun (x : i32) -> return (boxed['z] x)))))

-- Free every cell; read the elements as base-1000 digits, head last.
def digits_alg : !(1 + ref i32 * i32 => i32) =
  !thunkv fun (r : 1 + ref i32 * i32) ->
    case r {
      inl u -> return i32[0]
    | inr p ->
        let (rn, t) = p;
        return (plus (free[i32] rn, (unbang host[mul32]) (t, i32[1000])))
    }

def digits : Seq => i32 = unbang (fold_own[1 + (ref i32 * X), i32] digits_alg)

main : F (i32 * i32) =
  l <- return (cons (i32[100], cons (i32[20], cons (i32[3], nil))));
  r <- return (alloc[Seq] l);
  q <- return (withbor1['x, Seq, i32] r
         (thunkv Fun 'x < top. return (thunkv fun (b : imm 'x Seq) ->
            bb <- return (copy['x, Seq] b);
            let (b1, b2) = bb;
            s <- return (withload['x, 'y, Seq, i32] b1
                   (thunkv Fun 'y < dom. return (thunkv fun (vs : view 'y Seq) ->
                      it <- return ((unbang iter_imm[i32]) ['y] vs);
                      o <- (nu_out (force it)).1;
                      case o {
                        inl p ->
                          let (v, rest) = p;
                          x <- return ((unbang read) ['y] v);
                          u <- (nu_out (force rest)).2;
                          let () = u;
                          return (boxed['y] x)
                      | inr u -> return (boxed['y] i32[0])
                      })));
            t <- return (withload['x, 'z, Seq, 1] b2
                   (thunkv Fun 'z < dom. return (thunkv fun (ws : view 'z Seq) ->
                      u0 <- return ((unbang iter_imm[i32]) ['z] ws);
                      return (boxed['z] ()))));
            let () = t;
            return (boxed['x] s))));
  let (r2, s) = q;
  l2 <- return (free[Seq] r2);
  return (s, digits l2)
