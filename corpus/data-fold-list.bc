-- A list declared with `data`, traversed and mapped in place by fold blocks (SPEC §60, F1, F2):
-- `corpus/map-reuse.bc` and `corpus/sum-i32.bc` with the declaration and the folds' arms written
-- with constructor patterns, as `docs/typed-elaboration.md` §6.2 spells them.
--
-- `sum` reads the list through a borrow (`fold_imm`): `Cons(h, t)` binds the view of the head
-- cell and the folded tail. `map_inc` rebuilds the list in its own cells (`fold_reuse`):
-- `Cons(c, (d, t))` binds the head cell, the emptied tail cell and the mapped tail, and
-- `Cons(c, d)` reassembles the block from its cells, allocating nothing. `digits` consumes it
-- (`fold_own`), freeing each head cell.
--
-- Answer: i32[64209]: the sum 9 of [1, 3, 5] read before the map, and the mapped list [2, 4, 6]
-- read as the digits of one number, head last, 642. A map that skips an element changes a digit;
-- one that reverses the list gives 246. `live 0`: the folds free every node.

data List = Nil | Cons(head: i32, tail: List)

fn sum<'a>(l: imm 'a List) -> i32 = fold_imm l { Nil -> 0 | Cons(h, t) -> *h + t }

fn map_inc(l: List) -> List =
  fold_reuse l {
    Nil -> Nil
  | Cons(c, (d, t)) ->
      let (c, x) = swap(c, ());
      let (c, ()) = swap(c, x + 1);
      let (d, ()) = swap(d, t);
      Cons(c, d)
  }

fn digits(l: List) -> i32 = fold_own l { Nil -> 0 | Cons(c, t) -> free(c) + t * 10 }

main -> i32 =
  let mut l = box Cons(1, box Cons(3, box Cons(5, Nil)));
  let s = sum(&l);
  modify &mut l { k -> map_inc(k) };
  digits(l) * 100 + s
