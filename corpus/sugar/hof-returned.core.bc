-- `hof-returned.bc` in core, as `bcc desugar` prints it: `twice` is called at its copy for div
-- callbacks, one state machine (SPEC §15) with a state per call of the callback.

def div_bind_step[A, B, R1, R] : !U (U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R -o F (B + U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) & F R) =
  !thunkv fun (s : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) ->
      < case s {
          inl p -> let (m, k) = p;
            o <- (nu_out force m).1;
            case o {
              inl a -> l <- force k.1 a;
                return inr inr l
            | inr m2 -> return inr inl (m2, k)
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl p -> let (m, k) = p;
            r1 <- (nu_out force m).2;
            force k.2 r1
        | inr l -> (nu_out force l).2
        } >

def div_bind[A, B, R1, R] : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) => U loop B R =
  thunkv fun (p : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R))) ->
      f <- return unbang unfold[loop B R, U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R] div_bind_step[A, B, R1, R];
      s0 : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R <- return inl p;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def div_double_alg : !(1 + (mu X. 1 + X) => mu X. 1 + X) =
  !thunkv fun (r : 1 + (mu X. 1 + X)) ->
      case r {
        inl u -> return (roll inl u : mu X. 1 + X)
      | inr m -> return (roll inr (roll inr m : mu X. 1 + X) : mu X. 1 + X)
      }

def div_nat_step : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =
  !thunkv fun (s : i32 * (mu X. 1 + X)) ->
      let (n, acc) = s;
      d <- return (unbang fold_own[1 + X, mu X. 1 + X] div_double_alg) acc;
      n2 <- return (unbang host[shl32]) (n, i32[1]);
      case (unbang host[eqz32]) ((unbang host[shr_u32]) (n, i32[31])) {
        inl one -> return (n2, (roll inr d : mu X. 1 + X))
      | inr zero -> return (n2, d)
      }

def div_nat_twice : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) => !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =
  thunkv fun (f : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X))) ->
      return (!thunkv fun (s : i32 * (mu X. 1 + X)) ->
          return (unbang f) ((unbang f) s))

def div_nat : i32 => mu X. 1 + X =
  thunkv fun (n : i32) ->
      s <- return (unbang div_nat_twice (div_nat_twice (div_nat_twice (div_nat_twice (div_nat_twice div_nat_step))))) (n, (roll inl () : mu X. 1 + X));
      let (z, acc) = s;
      return acc

def div_fuel_alg[A, Q] : !(1 + !(U loop A Q => A + Q) => !(U loop A Q => A + Q)) =
  !thunkv fun (r : 1 + !(U loop A Q => A + Q)) ->
      case r {
        inl u -> let () = u;
          return (!thunkv fun (l : U loop A Q) ->
              q <- (nu_out force l).2;
              return inr q)
      | inr k -> return (!thunkv fun (l : U loop A Q) ->
              o <- (nu_out force l).1;
              case o {
                inl a -> return inl a
              | inr l2 -> return (unbang k) l2
              })
      }

def div_fuel[A, Q] : U loop A Q * i32 => A + Q =
  thunkv fun (p : U loop A Q * i32) ->
      let (l, n) = p;
      h <- return (unbang fold_own[1 + X, !(U loop A Q => A + Q)] div_fuel_alg[A, Q]) (div_nat n);
      return (unbang h) l

def div_defer_step[B, R] : !U (U (F U loop B R & F R) + U loop B R -o F (B + U (F U loop B R & F R) + U loop B R) & F R) =
  !thunkv fun (s : U (F U loop B R & F R) + U loop B R) ->
      < case s {
          inl t -> l <- force t.1;
            o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl t -> force t.2
        | inr l -> (nu_out force l).2
        } >

def div_defer[B, R] : U (F U loop B R & F R) => U loop B R =
  thunkv fun (t : U (F U loop B R & F R)) ->
      f <- return unbang unfold[loop B R, U (F U loop B R & F R) + U loop B R] div_defer_step[B, R];
      s0 : U (F U loop B R & F R) + U loop B R <- return inl t;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def once : i32 => U loop i32 1 =
  thunkv fun (n : i32) ->
      return (thunkv nu_in < return inl (unbang host[add32]) (n, i32[1]),
          return () >)

def steps : !(i32 => U loop i32 1) =
  !thunkv fun (n : i32) ->
      io_run_0 : !(U delay i32 => i32 + U delay i32) <- return (!thunkv fun (io_a : U delay i32) ->
            io_d0 <- return io_a;
            io_o <- (nu_out force io_d0).1;
            case io_o {
              inl io_b -> k <- return io_b;
                io_v : i32 <- return k;
                return inl io_v
            | inr io_d0 -> return inr io_d0
            });
      io_step : !U (U delay i32 -o F (i32 + U delay i32) & F 1) <- return (!thunkv fun (io_a : U delay i32) ->
            < return (unbang io_run_0) io_a,
              io_d0 <- return io_a;
              io_r <- (nu_out force io_d0).2;
              let () = io_r;
              return () >);
      io_mk : !(U delay i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U delay i32) ->
            io_f <- return unbang unfold[loop i32 1, U delay i32] io_step;
            return (thunkv nu_in < (nu_out force io_f io_s0).1,
                (nu_out force io_f io_s0).2 >));
      io_d0 <- return once n;
      return (unbang io_mk) io_d0

def twice : !(i32 => i32) * i32 => i32 =
  thunkv fun (p : !(i32 => i32) * i32) ->
      let (f, a) = p;
      x <- return (unbang f) a;
      y <- return (unbang f) x;
      return y

def pick : 1 => !(i32 => U loop i32 1) =
  thunkv fun (u : 1) ->
      let () = u;
      return steps

def twice__0 : !(i32 => U delay i32) * i32 => U loop i32 1 =
  thunkv fun (p : !(i32 => U delay i32) * i32) ->
      io_run_1 : !(U delay i32 => i32 + U delay i32 * !(i32 => U delay i32) + U delay i32) <- return (!thunkv fun (io_a : U delay i32) ->
            io_d1 <- return io_a;
            io_o <- (nu_out force io_d1).1;
            case io_o {
              inl io_b -> y <- return io_b;
                io_v : i32 <- return y;
                return inl io_v
            | inr io_d1 -> return inr inr io_d1
            });
      io_run_0 : !(U delay i32 * !(i32 => U delay i32) => i32 + U delay i32 * !(i32 => U delay i32) + U delay i32) <- return (!thunkv fun (io_a : U delay i32 * !(i32 => U delay i32)) ->
            let (io_d0, f) = io_a;
            io_o <- (nu_out force io_d0).1;
            case io_o {
              inl io_b -> x <- return io_b;
                io_d1 <- return (unbang f) x;
                return inr inr io_d1
            | inr io_d0 -> return inr inl (io_d0, f)
            });
      io_step : !U (U delay i32 * !(i32 => U delay i32) + U delay i32 -o F (i32 + U delay i32 * !(i32 => U delay i32) + U delay i32) & F 1) <- return (!thunkv fun (io_s : U delay i32 * !(i32 => U delay i32) + U delay i32) ->
            < case io_s {
                inl io_a -> return (unbang io_run_0) io_a
              | inr io_a -> return (unbang io_run_1) io_a
              },
              case io_s {
                inl io_a -> let (io_d0, f) = io_a;
                  io_r <- (nu_out force io_d0).2;
                  let () = io_r;
                  return ()
              | inr io_a -> io_d1 <- return io_a;
                  io_r <- (nu_out force io_d1).2;
                  let () = io_r;
                  return ()
              } >);
      io_mk : !(U delay i32 * !(i32 => U delay i32) + U delay i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U delay i32 * !(i32 => U delay i32) + U delay i32) ->
            io_f <- return unbang unfold[loop i32 1, U delay i32 * !(i32 => U delay i32) + U delay i32] io_step;
            return (thunkv nu_in < (nu_out force io_f io_s0).1,
                (nu_out force io_f io_s0).2 >));
      let (f, a) = p;
      io_d0 <- return (unbang f) a;
      return (unbang io_mk) (inl (io_d0, f))

main : F (i32 + 1) =
  g <- return pick ();
  r <- return div_fuel[i32, 1] (twice__0 (g, i32[5]), i32[10]);
  return r
