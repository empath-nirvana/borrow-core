-- `hof-returned.bc` in core, as `bcc desugar` prints it: `pick` returns `steps`, a div function,
-- where a function returning its loop is written, so it returns the function that makes the loop
-- value of each call (`reify`); `twice` is called at its copy for that callback, which drains the
-- loops it is given (SPEC §14).
def div_bind_step[A, B, R1, R] : !U (U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R -o F (B + U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) & F R) =
  !thunkv fun (s : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) ->
      < case s {
          inl p -> let (m, k) = p;
            o <- (nu_out force m).1;
            case o {
              inl a -> l <- force k.1 a;
                return inr inr l
            | inr m2 -> return inr inl (m2, k)
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl p -> let (m, k) = p;
            r1 <- (nu_out force m).2;
            force k.2 r1
        | inr l -> (nu_out force l).2
        } >

def div_bind[A, B, R1, R] : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) => U loop B R =
  thunkv fun (p : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R))) ->
      f <- return unbang unfold[loop B R, U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R] div_bind_step[A, B, R1, R];
      s0 : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R <- return inl p;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def div_fuel_step[A, Q] : !(i32 * (U loop A Q + A + Q) => U loop A Q + A + Q) =
  !thunkv fun (p : i32 * (U loop A Q + A + Q)) ->
      let (i, s) = p;
      case s {
        inl l -> o <- (nu_out force l).1;
          case o {
            inl a -> return inr inl a
          | inr l2 -> return inl l2
          }
      | inr r -> return inr r
      }

def div_fuel[A, Q] : U loop A Q * i32 => A + Q =
  thunkv fun (p : U loop A Q * i32) ->
      let (l, n) = p;
      s <- return (unbang count_fold[U loop A Q + A + Q]) (div_fuel_step[A, Q], (n, (i32[0], inl l)));
      case s {
        inl l2 -> q <- (nu_out force l2).2;
          return inr q
      | inr r -> return r
      }

def div_defer_step[B, R] : !U (U (F U loop B R & F R) + U loop B R -o F (B + U (F U loop B R & F R) + U loop B R) & F R) =
  !thunkv fun (s : U (F U loop B R & F R) + U loop B R) ->
      < case s {
          inl t -> l <- force t.1;
            o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl t -> force t.2
        | inr l -> (nu_out force l).2
        } >

def div_defer[B, R] : U (F U loop B R & F R) => U loop B R =
  thunkv fun (t : U (F U loop B R & F R)) ->
      f <- return unbang unfold[loop B R, U (F U loop B R & F R) + U loop B R] div_defer_step[B, R];
      s0 : U (F U loop B R & F R) + U loop B R <- return inl t;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def once : i32 => U loop i32 1 =
  thunkv fun (n : i32) ->
      return (thunkv nu_in < return inl (unbang host[add32]) (n, i32[1]),
          return () >)

def steps : !U (i32 -o F[div] (i32 + 1)) =
  !thunkv fun (n : i32) ->
      io_dl1 <- return once n;
      io_step3 : !U (U delay i32 -o F[div] ((i32 + i32 + 1) + U delay i32) & F[div] 1) <- return (!thunkv fun (io_s3 : U delay i32) ->
            < io_dl1 <- return io_s3;
              io_o <- (nu_out force io_dl1).1;
              case io_o {
                inl io_jb1 -> return inl inl io_jb1
              | inr io_dl1 -> return inr io_dl1
              },
              io_dl1 <- return io_s3;
              io_r <- (nu_out force io_dl1).2;
              let () = io_r;
              return () >);
      io_s03 : U delay i32 <- return io_dl1;
      io_x3 : (i32 + i32 + 1) + 1 <- (io_n3 <- perform[4294967295.0] ();
        case io_n3 {
          inl io_u -> io_it3 <- return unbang iterate[U delay i32, i32 + i32 + 1, 1, [div]];
            io_p3 : !U (U delay i32 -o F[div] ((i32 + i32 + 1) + U delay i32) & F[div] 1) * U delay i32 <- return (io_step3, io_s03);
            force io_it3 io_p3
        | inr io_u -> io_sf3 <- return unbang io_step3;
            io_q3 <- force io_sf3 io_s03.2;
            return inr io_q3
        });
      case io_x3 {
        inl io_l3 -> case io_l3 {
            inl io_j1 -> io_jb1 <- return io_j1;
              k <- return io_jb1;
              return inl k
          | inr io_a3 -> return io_a3
          }
      | inr io_r3 -> return inr io_r3
      }

def twice : !(i32 => i32) * i32 => i32 =
  thunkv fun (p : !(i32 => i32) * i32) ->
      let (f, a) = p;
      x <- return (unbang f) a;
      y <- return (unbang f) x;
      return y

def pick : 1 => !(i32 => U loop i32 1) =
  thunkv fun (u : 1) ->
      let () = u;
      return (!thunkv fun (io_lx24_85 : i32) ->
          return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
                return ())) (thunkv fun (io_u : 1) ->
              let () = io_u;
              io_fglf24_85 <- return unbang steps;
              io_falf24_85 <- return io_lx24_85;
              force io_fglf24_85 io_falf24_85))

def twice__0 : U (!(i32 => U delay i32) * i32 -o F[div] (i32 + 1)) =
  thunkv fun (p : !(i32 => U delay i32) * i32) ->
      let (f, a) = p;
      io_dl1 <- return (unbang f) a;
      io_step6 : !U (U delay i32 * !(i32 => U delay i32) -o F[div] ((i32 * !(i32 => U delay i32) + i32 + 1) + U delay i32 * !(i32 => U delay i32)) & F[div] 1) <- return (!thunkv fun (io_s6 : U delay i32 * !(i32 => U delay i32)) ->
            < let (io_dl1, io_s6t) = io_s6;
              f <- return io_s6t;
              io_o <- (nu_out force io_dl1).1;
              case io_o {
                inl io_jb1 -> return inl inl (io_jb1, f)
              | inr io_dl1 -> return inr (io_dl1, f)
              },
              let (io_dl1, io_s6t) = io_s6;
              f <- return io_s6t;
              io_r <- (nu_out force io_dl1).2;
              let () = io_r;
              return () >);
      io_s06 : U delay i32 * !(i32 => U delay i32) <- return (io_dl1, f);
      io_x6 : (i32 * !(i32 => U delay i32) + i32 + 1) + 1 <- (io_n6 <- perform[4294967295.0] ();
        case io_n6 {
          inl io_u -> io_it6 <- return unbang iterate[U delay i32 * !(i32 => U delay i32), i32 * !(i32 => U delay i32) + i32 + 1, 1, [div]];
            io_p6 : !U (U delay i32 * !(i32 => U delay i32) -o F[div] ((i32 * !(i32 => U delay i32) + i32 + 1) + U delay i32 * !(i32 => U delay i32)) & F[div] 1) * U delay i32 * !(i32 => U delay i32) <- return (io_step6, io_s06);
            force io_it6 io_p6
        | inr io_u -> io_sf6 <- return unbang io_step6;
            io_q6 <- force io_sf6 io_s06.2;
            return inr io_q6
        });
      case io_x6 {
        inl io_l6 -> case io_l6 {
            inl io_j1 -> let (io_jb1, io_j1t) = io_j1;
              f <- return io_j1t;
              x <- return io_jb1;
              io_dl3 <- return (unbang f) x;
              io_step5 : !U (U delay i32 -o F[div] ((i32 + i32 + 1) + U delay i32) & F[div] 1) <- return (!thunkv fun (io_s5 : U delay i32) ->
                    < io_dl3 <- return io_s5;
                      io_o <- (nu_out force io_dl3).1;
                      case io_o {
                        inl io_jb3 -> return inl inl io_jb3
                      | inr io_dl3 -> return inr io_dl3
                      },
                      io_dl3 <- return io_s5;
                      io_r <- (nu_out force io_dl3).2;
                      let () = io_r;
                      return () >);
              io_s05 : U delay i32 <- return io_dl3;
              io_x5 : (i32 + i32 + 1) + 1 <- (io_n5 <- perform[4294967295.0] ();
                case io_n5 {
                  inl io_u -> io_it5 <- return unbang iterate[U delay i32, i32 + i32 + 1, 1, [div]];
                    io_p5 : !U (U delay i32 -o F[div] ((i32 + i32 + 1) + U delay i32) & F[div] 1) * U delay i32 <- return (io_step5, io_s05);
                    force io_it5 io_p5
                | inr io_u -> io_sf5 <- return unbang io_step5;
                    io_q5 <- force io_sf5 io_s05.2;
                    return inr io_q5
                });
              case io_x5 {
                inl io_l5 -> case io_l5 {
                    inl io_j3 -> io_jb3 <- return io_j3;
                      y <- return io_jb3;
                      return inl y
                  | inr io_a5 -> return io_a5
                  }
              | inr io_r5 -> return inr io_r5
              }
          | inr io_a6 -> return io_a6
          }
      | inr io_r6 -> return inr io_r6
      }

main : F (i32 + 1) =
  g <- return pick ();
  r <- return div_fuel[i32, 1] ((unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
          return ())) (thunkv fun (io_u : 1) ->
        let () = io_u;
        io_fglv28_34 <- return twice__0;
        io_falv28_34 <- return (g, i32[5]);
        force io_fglv28_34 io_falv28_34), i32[10]);
  return r
