-- `lend-div.bc` in core, as `bcc desugar` prints it. `total_at` takes the owner and hands it back
-- first; its loop's state holds the owner, and each step borrows it around the body. `main` calls
-- it twice in direct style, each call a state of `main`'s machine (SPEC §15) holding its loop; the
-- second call is the borrow block's, whose borrow passed to `total_at` is the place lent instead.

def get : !(all 'a < top. imm 'a array i32 * i32 => i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (p : imm 'a array i32 * i32) ->
          let (b, i) = p;
          return withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom.
              return (thunkv fun (xs : array_imm 'z i32) ->
                  case (unbang array_get['z, i32]) (xs, i) {
                    inl e -> v <- return withload['z, 'io_ly12_59, i32, i32] e (thunkv Fun 'io_ly12_59 < dom.
                            return (thunkv fun (io_dv : view 'io_ly12_59 i32) ->
                                return boxed['io_ly12_59] io_dv));
                      return boxed['z] v
                  | inr io_m0 -> io_d1 <- return io_m0;
                      return boxed['z] i32[0]
                  })))

def tab : !(i32 => i32) =
  !thunkv fun (i : i32) ->
      return (unbang host[mul32]) (i, i32[10])

def down : i32 => U iter i32 1 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[iter i32 1 1, i32] (!thunkv fun (k : i32) ->
            < case (unbang host[eqz32]) k {
                inl nz -> return inl (k, (unbang host[sub32]) (k, i32[1]))
              | inr z -> return inr ()
              },
              return () >);
      return (thunkv nu_in < (nu_out force f n).1,
          (nu_out force f n).2 >)

def total_at : !(ref array i32 => U loop (ref array i32 * i32) 1) =
  !thunkv fun (io_arg_total_at : ref array i32) ->
      io_run_0 : !(U iter i32 1 1 * ref array i32 * i32 => ref array i32 * i32 + U iter i32 1 1 * ref array i32 * i32) <- return (!thunkv fun (io_a : U iter i32 1 1 * ref array i32 * i32) ->
            let (io_it0, io_a_t) = io_a;
            let (io_own_total_at, acc) = io_a_t;
            io_o <- (nu_out force io_it0).1;
            case io_o {
              inl io_p -> let (i, io_it0) = io_p;
                io_lb29_40_0 <- return withbor1['a, array i32, i32] io_own_total_at (thunkv Fun 'a < dom.
                      return (thunkv fun (b : imm 'a array i32) ->
                          acc <- return (unbang host[add32]) (acc, (unbang get) ['a] (b, i));
                          io_u <- return ();
                          return boxed['a] acc));
                let (io_own_total_at, io_lr29_40_1) = io_lb29_40_0;
                acc <- return io_lr29_40_1;
                io_u <- return ();
                return inr (io_it0, (io_own_total_at, acc))
            | inr io_d -> io_q <- return io_d;
                io_v : ref array i32 * i32 <- return (io_own_total_at, acc);
                return inl io_v
            });
      io_step : !U (U iter i32 1 1 * ref array i32 * i32 -o F (ref array i32 * i32 + U iter i32 1 1 * ref array i32 * i32) & F 1) <- return (!thunkv fun (io_a : U iter i32 1 1 * ref array i32 * i32) ->
            < return (unbang io_run_0) io_a,
              let (io_it0, io_a_t) = io_a;
              let (io_own_total_at, acc) = io_a_t;
              io_c <- (nu_out force io_it0).2;
              return () >);
      io_mk : !(U iter i32 1 1 * ref array i32 * i32 => U loop (ref array i32 * i32) 1) <- return (!thunkv fun (io_s0 : U iter i32 1 1 * ref array i32 * i32) ->
            io_f <- return unbang unfold[loop (ref array i32 * i32) 1, U iter i32 1 1 * ref array i32 * i32] io_step;
            return (thunkv nu_in < (nu_out force io_f io_s0).1,
                (nu_out force io_f io_s0).2 >));
      io_own_total_at <- return io_arg_total_at;
      acc <- return i32[0];
      io_it0 <- return down i32[4];
      return (unbang io_mk) (io_it0, (io_own_total_at, acc))

main : F U loop i32 1 =
  io_run_1 : !(U delay (ref array i32 * i32) * i32 => i32 + U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32) <- return (!thunkv fun (io_a : U delay (ref array i32 * i32) * i32) ->
        let (io_d1, n) = io_a;
        io_o <- (nu_out force io_d1).1;
        case io_o {
          inl io_b -> let (t, io_lt37_11_0) = io_b;
            io_b3 <- return (t, io_lt37_11_0);
            let (t, m) = io_b3;
            io_v : i32 <- return (unbang host[add32]) (n, m);
            return inl io_v
        | inr io_d1 -> return inr inr (io_d1, n)
        });
  io_run_0 : !(U delay (ref array i32 * i32) => i32 + U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32) <- return (!thunkv fun (io_a : U delay (ref array i32 * i32)) ->
        io_d0 <- return io_a;
        io_o <- (nu_out force io_d0).1;
        case io_o {
          inl io_b -> let (t, n) = io_b;
            io_d1 <- return (unbang total_at) t;
            return inr inr (io_d1, n)
        | inr io_d0 -> return inr inl io_d0
        });
  io_step : !U (U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32 -o F (i32 + U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32) & F 1) <- return (!thunkv fun (io_s : U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32) ->
        < case io_s {
            inl io_a -> return (unbang io_run_0) io_a
          | inr io_a -> return (unbang io_run_1) io_a
          },
          case io_s {
            inl io_a -> io_d0 <- return io_a;
              io_r <- (nu_out force io_d0).2;
              let () = io_r;
              return ()
          | inr io_a -> let (io_d1, n) = io_a;
              io_r <- (nu_out force io_d1).2;
              let () = io_r;
              return ()
          } >);
  io_mk : !(U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32) ->
        io_f <- return unbang unfold[loop i32 1, U delay (ref array i32 * i32) + U delay (ref array i32 * i32) * i32] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  t <- return alloc[array i32] ((unbang array_new[i32]) (i32[10], tab));
  io_d0 <- return (unbang total_at) t;
  return (unbang io_mk) (inl io_d0)
