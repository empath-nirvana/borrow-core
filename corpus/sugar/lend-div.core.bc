-- `lend-div.bc` in core, as `bcc desugar` prints it. `total_at` takes the owner and hands it back
-- first; its loop is `iterate` over a state that holds the owner, and each turn borrows it around
-- the body. `main` calls it twice in direct style, each a call at the row `div`; the second call
-- is the borrow block's, whose borrow passed to `total_at` is the place lent instead.
def get : !(all 'a < top. imm 'a array i32 * i32 => i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (p : imm 'a array i32 * i32) ->
          let (b, i) = p;
          return withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom.
              return (thunkv fun (xs : array_imm 'z i32) ->
                  case (unbang array_get['z, i32]) (xs, i) {
                    inl e -> v <- return withload['z, 'io_ly13_59, i32, i32] e (thunkv Fun 'io_ly13_59 < dom.
                            return (thunkv fun (io_dv : view 'io_ly13_59 i32) ->
                                return boxed['io_ly13_59] io_dv));
                      return boxed['z] v
                  | inr io_m0 -> io_d1 <- return io_m0;
                      return boxed['z] i32[0]
                  })))

def tab : !(i32 => i32) =
  !thunkv fun (i : i32) ->
      return (unbang host[mul32]) (i, i32[10])

def down : i32 => U iter i32 1 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[iter i32 1 1, i32] (!thunkv fun (k : i32) ->
            < case (unbang host[eqz32]) k {
                inl nz -> return inl (k, (unbang host[sub32]) (k, i32[1]))
              | inr z -> return inr ()
              },
              return () >);
      return (thunkv nu_in < (nu_out force f n).1,
          (nu_out force f n).2 >)

def total_at : !U (ref array i32 -o F[div] (ref array i32 * i32 + 1)) =
  !thunkv fun (io_arg_total_at : ref array i32) ->
      io_own_total_at <- return io_arg_total_at;
      acc <- return i32[0];
      io_src2 <- return down i32[4];
      io_step7 : !U (U iter i32 1 1 * ref array i32 * i32 -o F[div] ((ref array i32 * i32 + ref array i32 * i32 + 1) + U iter i32 1 1 * ref array i32 * i32) & F[div] 1) <- return (!thunkv fun (io_s7 : U iter i32 1 1 * ref array i32 * i32) ->
            < let (io_src2, io_s7t) = io_s7;
              let (io_own_total_at, io_s7tt) = io_s7t;
              acc <- return io_s7tt;
              io_o <- (nu_out force io_src2).1;
              case io_o {
                inl io_p -> let (i, io_src2) = io_p;
                  io_lb30_40_0 <- return withbor1['a, array i32, i32] io_own_total_at (thunkv Fun 'a < dom.
                        return (thunkv fun (b : imm 'a array i32) ->
                            acc <- return (unbang host[add32]) (acc, (unbang get) ['a] (b, i));
                            return boxed['a] acc));
                  let (io_own_total_at, io_lr30_40_1) = io_lb30_40_0;
                  acc <- return io_lr30_40_1;
                  return inr (io_src2, (io_own_total_at, acc))
              | inr io_d -> io_q <- return io_d;
                  return inl inl (io_own_total_at, acc)
              },
              let (io_src2, io_s7t) = io_s7;
              let (io_own_total_at, io_s7tt) = io_s7t;
              acc <- return io_s7tt;
              io_c <- (nu_out force io_src2).2;
              return () >);
      io_s07 : U iter i32 1 1 * ref array i32 * i32 <- return (io_src2, (io_own_total_at, acc));
      io_x7 : (ref array i32 * i32 + ref array i32 * i32 + 1) + 1 <- (io_n7 <- perform[4294967295.0] ();
        case io_n7 {
          inl io_u -> io_it7 <- return unbang iterate[U iter i32 1 1 * ref array i32 * i32, ref array i32 * i32 + ref array i32 * i32 + 1, 1, [div]];
            io_p7 : !U (U iter i32 1 1 * ref array i32 * i32 -o F[div] ((ref array i32 * i32 + ref array i32 * i32 + 1) + U iter i32 1 1 * ref array i32 * i32) & F[div] 1) * U iter i32 1 1 * ref array i32 * i32 <- return (io_step7, io_s07);
            force io_it7 io_p7
        | inr io_u -> io_sf7 <- return unbang io_step7;
            io_q7 <- force io_sf7 io_s07.2;
            return inr io_q7
        });
      case io_x7 {
        inl io_l7 -> case io_l7 {
            inl io_j2 -> let (io_own_total_at, io_j2t) = io_j2;
              acc <- return io_j2t;
              return inl (io_own_total_at, acc)
          | inr io_a7 -> return io_a7
          }
      | inr io_r7 -> return inr io_r7
      }

main : F U loop i32 1 =
  return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
        return ())) (thunkv fun (io_u : 1) ->
      let () = io_u;
      t <- return alloc[array i32] ((unbang array_new[i32]) (i32[10], tab));
      io_d2 <- (io_fg1 <- return unbang total_at;
        io_fa1 <- return t;
        force io_fg1 io_fa1);
      case io_d2 {
        inl io_b -> let (t, n) = io_b;
          io_d4 <- (io_fg3 <- return unbang total_at;
            io_fa3 <- return t;
            force io_fg3 io_fa3);
          case io_d4 {
            inl io_b -> let (t, io_lt38_11_0) = io_b;
              io_b3 <- return (t, io_lt38_11_0);
              let (t, m) = io_b3;
              return inl (unbang host[add32]) (n, m)
          | inr io_r -> let () = io_r;
              io_res7 <- return ();
              return inr io_res7
          }
      | inr io_r -> let () = io_r;
          io_res8 <- return ();
          return inr io_res8
      })
