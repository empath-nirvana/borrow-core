-- A call of a div function in direct style inside a generator: `collatz` is a loop (its type says
-- so), and `steps` calls it in direct style. The generator's body is a div body at the row of
-- `Yield`: the loop runs inside it, drained by `iterate` (SPEC §14, §50), one turn per
-- observation; when it finishes, the rest of the body runs with its result.
-- `gen-div.core.bc` is its elaboration in core, as `bcc desugar` prints it.
-- Answer: i32[111], the Collatz steps from 27.

include yield

-- One step from `(n, k)`: `k` steps so far.
def collatz_step : !U (i32 * i32 -o F (i32 + (i32 * i32)) & F 1) =
  !thunkv fun (s : i32 * i32) ->
    < let (n, k) = s;
      case (unbang host[eq32]) (n, i32[1]) {
        inl other ->
          k2 <- return ((unbang host[add32]) (k, i32[1]));
          case (unbang host[eqz32]) ((unbang host[and32]) (n, i32[1])) {
            inl odd ->
              return (inr ((unbang host[add32]) ((unbang host[mul32]) (n, i32[3]), i32[1]), k2))
          | inr even -> return (inr ((unbang host[shr_u32]) (n, i32[1]), k2))
          }
      | inr one -> return (inl k)
      },
      let (n, k) = s;
      return () >

def collatz : i32 => U (loop i32 1) =
  thunkv fun (n : i32) ->
    f <- return (unbang (unfold[loop i32 1, i32 * i32] collatz_step));
    s0 : i32 * i32 <- return (n, i32[0]);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

fn steps(n: i32) -> 1 with Yield[i32] =
  let k = collatz(n);
  yield(k);
  ()

main -> i32 =
  let mut acc = 0;
  for k in steps(27) { acc = acc + k };
  acc
