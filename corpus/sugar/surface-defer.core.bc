-- `surface-defer.bc` in core, as `bcc desugar` prints it: the block is the loop that runs nothing
-- until it is first observed, whose first observation makes the loop value of the block's body
-- (`reify`) and observes it, and whose close before it starts hands back `()` (SPEC §14).
def div_bind_step[A, B, R1, R] : !U (U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R -o F (B + U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) & F R) =
  !thunkv fun (s : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) ->
      < case s {
          inl p -> let (m, k) = p;
            o <- (nu_out force m).1;
            case o {
              inl a -> l <- force k.1 a;
                return inr inr l
            | inr m2 -> return inr inl (m2, k)
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl p -> let (m, k) = p;
            r1 <- (nu_out force m).2;
            force k.2 r1
        | inr l -> (nu_out force l).2
        } >

def div_bind[A, B, R1, R] : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) => U loop B R =
  thunkv fun (p : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R))) ->
      f <- return unbang unfold[loop B R, U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R] div_bind_step[A, B, R1, R];
      s0 : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R <- return inl p;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def div_fuel_step[A, Q] : !(i32 * (U loop A Q + A + Q) => U loop A Q + A + Q) =
  !thunkv fun (p : i32 * (U loop A Q + A + Q)) ->
      let (i, s) = p;
      case s {
        inl l -> o <- (nu_out force l).1;
          case o {
            inl a -> return inr inl a
          | inr l2 -> return inl l2
          }
      | inr r -> return inr r
      }

def div_fuel[A, Q] : U loop A Q * i32 => A + Q =
  thunkv fun (p : U loop A Q * i32) ->
      let (l, n) = p;
      s <- return (unbang count_fold[U loop A Q + A + Q]) (div_fuel_step[A, Q], (n, (i32[0], inl l)));
      case s {
        inl l2 -> q <- (nu_out force l2).2;
          return inr q
      | inr r -> return r
      }

def div_defer_step[B, R] : !U (U (F U loop B R & F R) + U loop B R -o F (B + U (F U loop B R & F R) + U loop B R) & F R) =
  !thunkv fun (s : U (F U loop B R & F R) + U loop B R) ->
      < case s {
          inl t -> l <- force t.1;
            o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl t -> force t.2
        | inr l -> (nu_out force l).2
        } >

def div_defer[B, R] : U (F U loop B R & F R) => U loop B R =
  thunkv fun (t : U (F U loop B R & F R)) ->
      f <- return unbang unfold[loop B R, U (F U loop B R & F R) + U loop B R] div_defer_step[B, R];
      s0 : U (F U loop B R & F R) + U loop B R <- return inl t;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def once : i32 => U loop i32 1 =
  thunkv fun (n : i32) ->
      return (thunkv nu_in < return inl (unbang host[add32]) (n, i32[1]),
          return () >)

main : F (i32 + 1) =
  l <- return ((thunkv nu_in < io_bl <- return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
                return ())) (thunkv fun (io_u : 1) ->
              let () = io_u;
              io_dl2 <- return once i32[4];
              io_step4 : !U (U delay i32 -o F[div] ((i32 + i32 + 1) + U delay i32) & F[div] 1) <- return (!thunkv fun (io_s4 : U delay i32) ->
                    < io_dl2 <- return io_s4;
                      io_o <- (nu_out force io_dl2).1;
                      case io_o {
                        inl io_jb2 -> return inl inl io_jb2
                      | inr io_dl2 -> return inr io_dl2
                      },
                      io_dl2 <- return io_s4;
                      io_r <- (nu_out force io_dl2).2;
                      let () = io_r;
                      return () >);
              io_s04 : U delay i32 <- return io_dl2;
              io_x4 : (i32 + i32 + 1) + 1 <- (io_n4 <- perform[4294967295.0] ();
                case io_n4 {
                  inl io_u -> io_it4 <- return unbang iterate[U delay i32, i32 + i32 + 1, 1, [div]];
                    io_p4 : !U (U delay i32 -o F[div] ((i32 + i32 + 1) + U delay i32) & F[div] 1) * U delay i32 <- return (io_step4, io_s04);
                    force io_it4 io_p4
                | inr io_u -> io_sf4 <- return unbang io_step4;
                    io_q4 <- force io_sf4 io_s04.2;
                    return inr io_q4
                });
              case io_x4 {
                inl io_l4 -> case io_l4 {
                    inl io_j2 -> io_jb2 <- return io_j2;
                      io_t <- return io_jb2;
                      return inl io_t
                  | inr io_a4 -> return io_a4
                  }
              | inr io_r4 -> return inr io_r4
              });
        (nu_out force io_bl).1,
        return () >) : U loop i32 1);
  return div_fuel[i32, 1] (l, i32[10])
