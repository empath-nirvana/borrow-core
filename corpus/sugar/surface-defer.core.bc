-- `surface-defer.bc` written by hand in core: the block is `div_defer` of `< start, abort >`,
-- `start` the delay bind of `once`'s loop and the rest, `abort` handing back `()`. The divergence
-- library (`lib/div.bc`) is copied in.
def div_bind_step[A, B, R1, R] :
    !U ((U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)
        -o F (B + ((U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)))
         & F R) =
  !thunkv fun (s : (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)) ->
    < case s {
        inl p ->
          let (m, k) = p;
          o <- (nu_out (force m)).1;
          case o {
            inl a ->
              l <- (force k).1 a;
              return (inr (inr l))
          | inr m2 -> return (inr (inl (m2, k)))
          }
      | inr l ->
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      },
      case s {
        inl p ->
          let (m, k) = p;
          r1 <- (nu_out (force m)).2;
          (force k).2 r1
      | inr l -> (nu_out (force l)).2
      } >

-- The delay bind: run the first loop, then the continuation on its result. If either never
-- finishes, neither does the whole.
def div_bind[A, B, R1, R] :
    U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R)) => U (loop B R) =
  thunkv fun (p : U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) ->
    f <- return (unbang (unfold[loop B R,
           (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)]
           div_bind_step[A, B, R1, R]));
    s0 : (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R) <-
      return (inl p);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

-- Fuel. `div_nat` turns an `i32` into a unary count (`mu X. 1 + X`), one bit at a time from
-- the highest: thirty-two steps of `acc := 2 acc + bit`.
def div_double_alg : !(1 + (mu X. 1 + X) => mu X. 1 + X) =
  !thunkv fun (r : 1 + (mu X. 1 + X)) ->
    case r {
      inl u -> return (roll (inl u) : mu X. 1 + X)
    | inr m -> return (roll (inr (roll (inr m) : mu X. 1 + X)) : mu X. 1 + X)
    }

def div_nat_step : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =
  !thunkv fun (s : i32 * (mu X. 1 + X)) ->
    let (n, acc) = s;
    d <- return ((unbang (fold_own[1 + X, mu X. 1 + X] div_double_alg)) acc);
    n2 <- return ((unbang host[shl32]) (n, i32[1]));
    case (unbang host[eqz32]) ((unbang host[shr_u32]) (n, i32[31])) {
      inl one -> return (n2, (roll (inr d) : mu X. 1 + X))
    | inr zero -> return (n2, d)
    }

def div_nat_twice : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =>
    !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =
  thunkv fun (f : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X))) ->
    return (!thunkv fun (s : i32 * (mu X. 1 + X)) -> return ((unbang f) ((unbang f) s)))

def div_nat : i32 => mu X. 1 + X =
  thunkv fun (n : i32) ->
    s <- return ((unbang (div_nat_twice (div_nat_twice (div_nat_twice (div_nat_twice
           (div_nat_twice div_nat_step)))))) (n, (roll (inl ()) : mu X. 1 + X)));
    let (z, acc) = s;
    return acc

-- One more observation of a loop, before the handler `k` for the rest: at zero, close.
def div_fuel_alg[A, Q] :
    !(1 + !(U (loop A Q) => A + Q) => !(U (loop A Q) => A + Q)) =
  !thunkv fun (r : 1 + !(U (loop A Q) => A + Q)) ->
    case r {
      inl u ->
        let () = u;
        return (!thunkv fun (l : U (loop A Q)) ->
          q <- (nu_out (force l)).2;
          return (inr q))
    | inr k ->
        return (!thunkv fun (l : U (loop A Q)) ->
          o <- (nu_out (force l)).1;
          case o {
            inl a -> return (inl a)
          | inr l2 -> return ((unbang k) l2)
          })
    }

-- The fuel handler: observe a loop at most `n` times, and close it if it has not finished.
-- It is `driveE n` (SPEC §7) with the count a value: div code under it is total.
def div_fuel[A, Q] : U (loop A Q) * i32 => A + Q =
  thunkv fun (p : U (loop A Q) * i32) ->
    let (l, n) = p;
    h <- return ((unbang (fold_own[1 + X, !(U (loop A Q) => A + Q)] div_fuel_alg[A, Q]))
           (div_nat n));
    return ((unbang h) l)

-- A loop that runs nothing until it is first observed: its state is the code to start it, `t`,
-- whose first observation runs the code up to the loop and returns the loop, and whose second
-- hands back the residual without running anything; or, once started, the loop. `{ S }` of a
-- body `S` that loops is `div_defer` of `< S, abort >` (typed elaboration, decision 2).
def div_defer_step[B, R] :
    !U (U (F (U (loop B R)) & F R) + U (loop B R)
        -o F (B + (U (F (U (loop B R)) & F R) + U (loop B R))) & F R) =
  !thunkv fun (s : U (F (U (loop B R)) & F R) + U (loop B R)) ->
    < case s {
        inl t ->
          l <- (force t).1;
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      | inr l ->
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      },
      case s {
        inl t -> (force t).2
      | inr l -> (nu_out (force l)).2
      } >

def div_defer[B, R] : U (F (U (loop B R)) & F R) => U (loop B R) =
  thunkv fun (t : U (F (U (loop B R)) & F R)) ->
    f <- return (unbang (unfold[loop B R, U (F (U (loop B R)) & F R) + U (loop B R)]
           div_defer_step[B, R]));
    s0 : U (F (U (loop B R)) & F R) + U (loop B R) <- return (inl t);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

-- A loop that finishes at its first observation, with `n + 1`.
def once : i32 => U (loop i32 1) =
  thunkv fun (n : i32) ->
    return (thunkv nu_in < return (inl ((unbang host[add32]) (n, i32[1]))), return () >)

main : F (i32 + 1) =
  l <- return (div_defer[i32, 1] (thunkv
         < m <- return (once i32[4]);
           return (div_bind[i32, i32, 1, 1] (m, thunkv
             < fun (a : i32) ->
                 k <- return a;
                 v : i32 <- return k;
                 return (thunkv nu_in < return (inl v), return () >),
               fun (r : 1) -> return r >)),
           return () >) : U (loop i32 1));
  return (div_fuel[i32, 1] (l, i32[10]))
