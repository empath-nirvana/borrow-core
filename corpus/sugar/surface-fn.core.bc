-- `surface-fn.bc` written by hand in core: each `fn` a persistent `def` whose parameter is the
-- tuple of its parameters, each call `(unbang f) V`, each `let` a binding.
def add3 : !(i32 * (i32 * i32) => i32) =
  !thunkv fun (p : i32 * (i32 * i32)) ->
    let (a, q) = p;
    let (b, c) = q;
    return ((unbang host[add32]) ((unbang host[add32]) (a, b), c))

def zero : !(1 => i32) =
  !thunkv fun (u : 1) ->
    let () = u;
    return i32[0]

def pick : !((1 + 1) * i32 => i32) =
  !thunkv fun (q : (1 + 1) * i32) ->
    p <- return q;
    let (flag, n) = p;
    case flag {
      inl m -> d <- return m; return n
    | inr m -> let () = m; return ((unbang zero) ())
    }

main : F i32 =
  x <- return ((unbang add3) (i32[1], (i32[2], i32[3])));
  d <- return ((unbang zero) ());
  return ((unbang pick) ((inl () : 1 + 1), x))
