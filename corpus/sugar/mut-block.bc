#! dialect 82
# A block that assigns an outer `let mut` (#586). `mut-block.core.bc` is its elaboration, written
# by hand, the block taking `x` and handing it back, through the copy of `ap` for that block.
# Answer: i32[52].
fn ap(f: !((i32) -> i32)) : i32 = f(1)

fn main() : i32 {
  var x = 1
  let a = ap(!{ u -> x = 5; u + 1 })
  x * 10 + a
}
