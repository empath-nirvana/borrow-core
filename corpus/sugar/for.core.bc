      n <- return io_j20;
      d <- return i32[1000000000];
      started <- return false;
      io_r102_3 <- return (unbang count_fold[!(u8 => 1) * i32 * i32 * (1 + 1)]) (!thunkv fun (io_q102_3 : i32 * !(u8 => 1) * i32 * i32 * (1 + 1)) ->
            io_t0 <- return io_q102_3;
