          return (thunkv fun (fx_pp10 : mut 'fx_l input * array_mut 'b u8) ->
              let (fx_c, v) = fx_pp10;
              i <- return fx_c;
              let (j, r) = (unbang read_into) ['fx_l] ['b] (i, v);
              i <- return j;
              return (i, (r : array_mut 'b u8 * i32))))

