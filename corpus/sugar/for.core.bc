type In = ref input

type Out = ref output

type Bytes = mu X. 1 + u8 * X

def getb : !(In => In * (u8 + 1)) =
  !thunkv fun (c : In) ->
      io_b2 <- return withbor2['fx_l0, dom, input, u8 + 1] c (thunkv Fun 'fx_l0 < dom.
            return (thunkv fun (ufx_c11 : mut 'fx_l0 input) ->
                fx_b48 : mut 'fx_l0 input * (u8 + 1) <- return (unbang wasi_stdin__input_byte) ['fx_l0] (ufx_c11, ());
                let (ufx_c11, fx_v49) = fx_b48;
                return boxed['fx_l0] fx_v49));
      let (c, r) = io_b2;
      return (c, r)

def putb : !(Out * u8 => Out * 1) =
  !thunkv fun (io_p7 : Out * u8) ->
      let (o, b) = io_p7;
      io_b5 <- return withbor2['fx_l3, dom, output, 1] o (thunkv Fun 'fx_l3 < dom.
            return (thunkv fun (ufx_c41 : mut 'fx_l3 output) ->
                fx_b50 : mut 'fx_l3 output * 1 <- return (unbang wasi_stdout__print_byte) ['fx_l3] (ufx_c41, b);
                let (ufx_c41, fx_v51) = fx_b50;
                return boxed['fx_l3] fx_v51));
      let (o, io_d6) = io_b5;
      return (o, ())

def io_dec_step : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) =
  !thunkv fun (s : Out * i32 * i32 * (1 + 1)) ->
      let (o, r) = s;
      let (n, r2) = r;
      let (d, st) = r2;
      case (unbang host[eqz32]) d {
        inl nz -> q <- return (unbang host[div_u32]) (n, d);
          digit : i32 <- case q {
              inl x -> return x
            | inr u -> return i32[0]
            };
          n2 <- return (unbang host[sub32]) (n, (unbang host[mul32]) (digit, d));
          show : 1 + 1 <- case st {
              inl u -> case (unbang host[eqz32]) digit {
                  inl u2 -> return (inr () : 1 + 1)
                | inr u3 -> return (unbang host[eq32]) (d, i32[1])
                }
            | inr u -> return (inr () : 1 + 1)
            };
          o2 : Out <- case show {
              inl u -> return o
            | inr u -> q2 <- return (unbang putb) (o, (unbang host[wrap8]) ((unbang host[add32]) (digit, i32[48])));
                let (o3, v) = q2;
                return o3
            };
          q3 <- return (unbang host[div_u32]) (d, i32[10]);
          d2 : i32 <- case q3 {
              inl x -> return x
            | inr u -> return i32[0]
            };
          return (o2, (n2, (d2, show)))
      | inr z -> return (o, (n, (d, st)))
      }

def io_dec_twice : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) => !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) =
  thunkv fun (f : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1))) ->
      return (!thunkv fun (s : Out * i32 * i32 * (1 + 1)) ->
          return (unbang f) ((unbang f) s))

def put_dec : Out * i32 => Out * 1 =
  thunkv fun (p : Out * i32) ->
      let (o, n) = p;
      s <- return (unbang io_dec_twice (io_dec_twice (io_dec_twice (io_dec_twice io_dec_step)))) (o, (n, (i32[1000000000], (inl () : 1 + 1))));
      let (o2, r) = s;
      return (o2, ())

def write_bytes : !(all 'b < top. Out * array_imm 'b u8 => Out * 1) =
  !thunkv Fun 'b < top.
      return (thunkv fun (io_p12 : Out * array_imm 'b u8) ->
          let (o, v) = io_p12;
          io_b10 <- return withbor2['fx_l8, dom, output, 1] o (thunkv Fun 'fx_l8 < dom.
                return (thunkv fun (ufx_c91 : mut 'fx_l8 output) ->
                    fx_b52 <- return (unbang wasi_stdout__print_bytes) ['fx_l8] ['b] (ufx_c91, v);
                    let (ufx_c91, fx_v53) = fx_b52;
                    return boxed['fx_l8] fx_v53));
          let (o, io_d11) = io_b10;
          return (o, ()))

def read_bytes : !(all 'b < top. In * array_mut 'b u8 => In * array_mut 'b u8 * i32) =
  !thunkv Fun 'b < top.
      return (thunkv fun (io_p16 : In * array_mut 'b u8) ->
          let (c, v) = io_p16;
          io_b15 <- return withbor2['fx_l13, dom, input, array_mut 'b u8 * i32] c (thunkv Fun 'fx_l13 < dom.
                return (thunkv fun (ufx_c141 : mut 'fx_l13 input) ->
                    fx_b54 <- return (unbang wasi_stdin__input_into) ['fx_l13] ['b] (ufx_c141, v);
                    let (ufx_c141, fx_v55) = fx_b54;
                    return boxed['fx_l13] fx_v55));
          let (c, r) = io_b15;
          return (c, r))

def io_bytes_step : !U (In -o F (u8 * In + In) & F In) =
  !thunkv fun (c : In) ->
      < q <- return (unbang getb) c;
        let (c2, x) = q;
        case x {
          inl b -> return inl (b, c2)
        | inr u -> return inr c2
        },
        return c >

def bytes : In => U iter u8 In In =
  thunkv fun (c : In) ->
      f <- return unbang unfold[iter u8 In In, In] io_bytes_step;
      return (thunkv nu_in < (nu_out force f c).1,
          (nu_out force f c).2 >)

def dec_each : !(i32 * !(u8 => 1) => 1) =
  !thunkv fun (io_p21 : i32 * !(u8 => 1)) ->
      let (x, put) = io_p21;
      n <- return x;
      io_j20 <- case (unbang host[lt_s32]) (x, i32[0]) {
