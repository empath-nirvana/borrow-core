def wasi_args__arg_byte : !(all 'fx_l < top. mut 'fx_l args * 1 => mut 'fx_l args * (u8 + 1)) =
  !thunkv Fun 'fx_l < top.
      return (thunkv fun (fx_pp53 : mut 'fx_l args * 1) ->
          let (fx_c, fx_p52) = fx_pp53;
          let () = fx_p52;
          a <- return fx_c;
          let (b, r) = (unbang read_arg) ['fx_l] a;
          a <- return b;
          fx_v48 : u8 + 1 <- return r;
          return (a, fx_v48))

type In = ref input

type Out = ref output

type Bytes = mu X. 1 + u8 * X

def getb : !(In => In * (u8 + 1)) =
  !thunkv fun (io_p3 : In) ->
      c <- return io_p3;
      io_b2 <- return withbor2['fx_l0, dom, input, u8 + 1] c (thunkv Fun 'fx_l0 < dom.
            return (thunkv fun (fx_c1 : mut 'fx_l0 input) ->
                fx_b54 : mut 'fx_l0 input * (u8 + 1) <- return (unbang wasi_stdin__input_byte) ['fx_l0] (fx_c1, ());
                let (fx_c1, fx_v55) = fx_b54;
                return boxed['fx_l0] fx_v55));
      let (c, r) = io_b2;
      return (c, r)

def putb : !(Out * u8 => Out * 1) =
  !thunkv fun (io_p8 : Out * u8) ->
      let (o, b) = io_p8;
      io_b6 <- return withbor2['fx_l4, dom, output, 1] o (thunkv Fun 'fx_l4 < dom.
            return (thunkv fun (fx_c5 : mut 'fx_l4 output) ->
                fx_b56 : mut 'fx_l4 output * 1 <- return (unbang wasi_stdout__print_byte) ['fx_l4] (fx_c5, b);
                let (fx_c5, fx_v57) = fx_b56;
                return boxed['fx_l4] fx_v57));
      let (o, io_d7) = io_b6;
      return (o, ())

def io_dec_step : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) =
  !thunkv fun (s : Out * i32 * i32 * (1 + 1)) ->
      let (o, r) = s;
      let (n, r2) = r;
      let (d, st) = r2;
      case (unbang host[eqz32]) d {
        inl nz -> q <- return (unbang host[div_u32]) (n, d);
          digit : i32 <- case q {
              inl x -> return x
            | inr u -> return i32[0]
            };
          n2 <- return (unbang host[sub32]) (n, (unbang host[mul32]) (digit, d));
          show : 1 + 1 <- case st {
              inl u -> case (unbang host[eqz32]) digit {
                  inl u2 -> return (inr () : 1 + 1)
                | inr u3 -> return (unbang host[eq32]) (d, i32[1])
                }
            | inr u -> return (inr () : 1 + 1)
            };
          o2 : Out <- case show {
              inl u -> return o
            | inr u -> q2 <- return (unbang putb) (o, (unbang host[wrap8]) ((unbang host[add32]) (digit, i32[48])));
                let (o3, v) = q2;
                return o3
            };
          q3 <- return (unbang host[div_u32]) (d, i32[10]);
          d2 : i32 <- case q3 {
              inl x -> return x
            | inr u -> return i32[0]
            };
          return (o2, (n2, (d2, show)))
      | inr z -> return (o, (n, (d, st)))
      }

def io_dec_twice : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) => !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) =
  thunkv fun (f : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1))) ->
      return (!thunkv fun (s : Out * i32 * i32 * (1 + 1)) ->
          return (unbang f) ((unbang f) s))

def put_dec : Out * i32 => Out * 1 =
  thunkv fun (p : Out * i32) ->
      let (o, n) = p;
      s <- return (unbang io_dec_twice (io_dec_twice (io_dec_twice (io_dec_twice io_dec_step)))) (o, (n, (i32[1000000000], (inl () : 1 + 1))));
      let (o2, r) = s;
      return (o2, ())

def write_bytes : !(all 'b < top. Out * array_imm 'b u8 => Out * 1) =
  !thunkv Fun 'b < top.
      return (thunkv fun (io_p13 : Out * array_imm 'b u8) ->
          let (o, v) = io_p13;
          io_b11 <- return withbor2['fx_l9, dom, output, 1] o (thunkv Fun 'fx_l9 < dom.
                return (thunkv fun (fx_c10 : mut 'fx_l9 output) ->
                    fx_b58 <- return (unbang wasi_stdout__print_bytes) ['fx_l9] ['b] (fx_c10, v);
                    let (fx_c10, fx_v59) = fx_b58;
                    return boxed['fx_l9] fx_v59));
          let (o, io_d12) = io_b11;
          return (o, ()))

def read_bytes : !(all 'b < top. In * array_mut 'b u8 => In * array_mut 'b u8 * i32) =
  !thunkv Fun 'b < top.
      return (thunkv fun (io_p17 : In * array_mut 'b u8) ->
          let (c, v) = io_p17;
          io_b16 <- return withbor2['fx_l14, dom, input, array_mut 'b u8 * i32] c (thunkv Fun 'fx_l14 < dom.
                return (thunkv fun (fx_c15 : mut 'fx_l14 input) ->
                    fx_b60 <- return (unbang wasi_stdin__input_into) ['fx_l14] ['b] (fx_c15, v);
                    let (fx_c15, fx_v61) = fx_b60;
                    return boxed['fx_l14] fx_v61));
          let (c, r) = io_b16;
          return (c, r))

def io_bytes_step : !U (In -o F (u8 * In + In) & F In) =
  !thunkv fun (c : In) ->
      < q <- return (unbang getb) c;
        let (c2, x) = q;
        case x {
          inl b -> return inl (b, c2)
        | inr u -> return inr c2
        },
        return c >

def bytes : In => U iter u8 In In =
  thunkv fun (c : In) ->
      f <- return unbang unfold[iter u8 In In, In] io_bytes_step;
      return (thunkv nu_in < (nu_out force f c).1,
          (nu_out force f c).2 >)

def dec_each : !(i32 * !(u8 => 1) => 1) =
  !thunkv fun (io_p22 : i32 * !(u8 => 1)) ->
      let (x, put) = io_p22;
      n <- return x;
      io_j21 <- case (unbang host[lt_s32]) (x, i32[0]) {
          inl io_else -> return n
        | inr io_then -> io_s18 <- return (unbang put) u8[45];
            n <- return (unbang host[sub32]) (i32[0], x);
            return n
        };
      n <- return io_j21;
      d <- return i32[1000000000];
      started <- return false;
      io_r102_3 <- return (unbang count_fold[!(u8 => 1) * i32 * i32 * (1 + 1)]) (!thunkv fun (io_q102_3 : i32 * !(u8 => 1) * i32 * i32 * (1 + 1)) ->
            io_t0 <- return io_q102_3;
            let (io_d1, io_q102_3_t) = io_t0;
            let (put, io_q102_3_t_t) = io_q102_3_t;
            let (n, io_q102_3_t_t_t) = io_q102_3_t_t;
            let (d, started) = io_q102_3_t_t_t;
            q <- case (unbang host[div_u32]) (n, d) {
                inl y -> return y
              | inr u -> return i32[0]
              };
            io_j20 <- case run case run case started {
                inl io_sc -> return (unbang host[ne32]) (q, i32[0])
              | inr io_sc -> return (inr () : 1 + 1)
              } {
                inl io_sc -> return (unbang host[eq32]) (d, i32[1])
              | inr io_sc -> return (inr () : 1 + 1)
              } {
                inl io_else -> return started
              | inr io_then -> io_s19 <- return (unbang put) ((unbang to_u8) ((unbang host[add32]) (q, i32[48])));
                  started <- return true;
                  return started
              };
            started <- return io_j20;
            n <- return (unbang host[sub32]) (n, (unbang host[mul32]) (q, d));
            d2 <- case (unbang host[div_u32]) (d, i32[10]) {
                inl y -> return y
              | inr u -> return i32[1]
              };
            d <- return d2;
            return (put, (n, (d, started))), (i32[10], (i32[0], (put, (n, (d, started))))));
      let (put, io_r102_3_t) = io_r102_3;
      let (n, io_r102_3_t_t) = io_r102_3_t;
      let (d, started) = io_r102_3_t_t;
      return ()

def ns_of_ms : !(i32 => i64) =
  !thunkv fun (io_p25 : i32) ->
      ms <- return io_p25;
      return (unbang host[mul64]) ((unbang host[extend_s]) ms, i64[1000000])

