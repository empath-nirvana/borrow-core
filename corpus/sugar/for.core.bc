extern stdin : ref input

extern stdout : ref output

main : F U loop ((ref input * ref output) * i32) ((ref input * ref output) * 1) =
  io_step : !U (U iter u8 (ref input) (ref input) * ref output * i32 -o F ((ref input * ref output) * i32 + U iter u8 (ref input) (ref input) * ref output * i32) & F ((ref input * ref output) * 1)) <- return (!thunkv fun (io_a : U iter u8 (ref input) (ref input) * ref output * i32) ->
        < let (io_it0, io_a_t) = io_a;
          let (stdout, n) = io_a_t;
          io_o <- (nu_out force io_it0).1;
          case io_o {
            inl io_p -> let (b, io_it0) = io_p;
              n : i32 <- return (unbang host[add32]) (n, i32[1]);
              io_lend <- return (unbang putb) (stdout, b);
              let (stdout, io_u) = io_lend;
              return inr (io_it0, (stdout, n))
          | inr io_d -> io_q <- return io_d;
              stdin <- return io_q;
              return inl ((stdin, stdout), n)
          },
          let (io_it0, io_a_t) = io_a;
          let (stdout, n) = io_a_t;
          io_c <- (nu_out force io_it0).2;
          stdin <- return io_c;
          return ((stdin, stdout), ()) >);
  n : i32 <- return i32[0];
  io_it0 <- return bytes stdin;
  io_f <- return unbang unfold[loop ((ref input * ref output) * i32) ((ref input * ref output) * 1), U iter u8 (ref input) (ref input) * ref output * i32] io_step;
  io_s0 : U iter u8 (ref input) (ref input) * ref output * i32 <- return (io_it0, (stdout, n));
  return (thunkv nu_in < (nu_out force io_f io_s0).1,
      (nu_out force io_f io_s0).2 >)
