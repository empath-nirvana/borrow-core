-- The elaboration of `for.bc` (SPEC §11, §14), as `bcc desugar` prints it: an ordinary core
-- program, with the I/O library the sugar brings in, whose `main` is one state machine (SPEC §15).
-- `scripts/check-sugar.sh` checks that both erase to one term.
def true : 1 + 1 =
  inr ()

def false : 1 + 1 =
  inl ()

def not : !(1 + 1 => 1 + 1) =
  !thunkv fun (b : 1 + 1) ->
      case b {
        inl u -> return true
      | inr u -> return false
      }

def to_i32 : !(u8 => i32) =
  !thunkv fun (b : u8) ->
      return (unbang host[extend8_u]) b

def to_u8 : !(i32 => u8) =
  !thunkv fun (i : i32) ->
      return (unbang host[wrap8]) i

extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (u8 + 1))

extern write_byte : !(all 'a < top. mut 'a output * u8 => mut 'a output)

extern write_all : !(all 'a < top. all 'b < top. mut 'a output * array_imm 'b u8 => mut 'a output)

extern read_into : !(all 'a < top. all 'b < top. mut 'a input * array_mut 'b u8 => mut 'a input * array_mut 'b u8 * i32)

extern clock_now : !(all 'a < top. mut 'a clock => mut 'a clock * i64)

extern clock_sleep : !(all 'a < top. mut 'a clock * i64 => mut 'a clock)

extern read_arg : !(all 'a < top. mut 'a args => mut 'a args * (u8 + 1))

def wasi_stdin__input_byte : !(all 'fx_l < top. mut 'fx_l input * 1 => mut 'fx_l input * (u8 + 1)) =
  !thunkv Fun 'fx_l < top.
      return (thunkv fun (fx_pp5 : mut 'fx_l input * 1) ->
          let (fx_c, fx_p4) = fx_pp5;
          let () = fx_p4;
          i <- return fx_c;
          let (j, r) = (unbang read_byte) ['fx_l] i;
          i <- return j;
          fx_v0 : u8 + 1 <- return r;
          return (i, fx_v0))

def wasi_stdin__input_into : !(all 'fx_l < top. all 'b < top. mut 'fx_l input * array_mut 'b u8 => mut 'fx_l input * array_mut 'b u8 * i32) =
  !thunkv Fun 'fx_l < top.
      return (thunkv Fun 'b < top.
          return (thunkv fun (fx_pp11 : mut 'fx_l input * array_mut 'b u8) ->
              let (fx_c, fx_p10) = fx_pp11;
              v <- return fx_p10;
              i <- return fx_c;
              let (j, r) = (unbang read_into) ['fx_l] ['b] (i, v);
              i <- return j;
              fx_v6 : array_mut 'b u8 * i32 <- return r;
              return (i, fx_v6)))

