extern stdin : ref input

extern stdout : ref output

main : F U loop ((ref input * ref output) * i32) ((ref input * ref output) * 1) =
  return (unbang reify[(ref input * ref output) * i32, (ref input * ref output) * 1, []](!thunkv fun (io_b : (ref input * ref output) * i32) ->
        let (io_bw0, io_bwr) = io_b;
        return (io_bw0, ()))) (thunkv fun (io_u : 1) ->
      let () = io_u;
      n : i32 <- return i32[0];
      io_src1 <- return bytes stdin;
      io_step5 : !U (U iter u8 (ref input) (ref input) * ref output * i32 -o F[div] ((ref input * ref output * i32 + (ref input * ref output) * i32 + (ref input * ref output) * 1) + U iter u8 (ref input) (ref input) * ref output * i32) & F[div] ((ref input * ref output) * 1)) <- return (!thunkv fun (io_s5 : U iter u8 (ref input) (ref input) * ref output * i32) ->
            < let (io_src1, io_s5t) = io_s5;
              let (stdout, io_s5tt) = io_s5t;
              n <- return io_s5tt;
              io_o <- (nu_out force io_src1).1;
              case io_o {
                inl io_p -> let (b, io_src1) = io_p;
                  n : i32 <- return (unbang host[add32]) (n, i32[1]);
                  io_lend <- return (unbang putb) (stdout, b);
                  let (stdout, io_u) = io_lend;
                  return inr (io_src1, (stdout, n))
              | inr io_d -> io_q <- return io_d;
                  stdin <- return io_q;
                  return inl inl (stdin, (stdout, n))
              },
              let (io_src1, io_s5t) = io_s5;
              let (stdout, io_s5tt) = io_s5t;
              n <- return io_s5tt;
              io_c <- (nu_out force io_src1).2;
              stdin <- return io_c;
              return ((stdin, stdout), ()) >);
      io_s05 : U iter u8 (ref input) (ref input) * ref output * i32 <- return (io_src1, (stdout, n));
      io_x5 : (ref input * ref output * i32 + (ref input * ref output) * i32 + (ref input * ref output) * 1) + (ref input * ref output) * 1 <- (io_n5 <- perform[4294967295.0] ();
        case io_n5 {
          inl io_u -> io_it5 <- return unbang iterate[U iter u8 (ref input) (ref input) * ref output * i32, ref input * ref output * i32 + (ref input * ref output) * i32 + (ref input * ref output) * 1, (ref input * ref output) * 1, [div]];
            io_p5 : !U (U iter u8 (ref input) (ref input) * ref output * i32 -o F[div] ((ref input * ref output * i32 + (ref input * ref output) * i32 + (ref input * ref output) * 1) + U iter u8 (ref input) (ref input) * ref output * i32) & F[div] ((ref input * ref output) * 1)) * U iter u8 (ref input) (ref input) * ref output * i32 <- return (io_step5, io_s05);
            force io_it5 io_p5
        | inr io_u -> io_sf5 <- return unbang io_step5;
            io_q5 <- force io_sf5 io_s05.2;
            return inr io_q5
        });
      case io_x5 {
        inl io_l5 -> case io_l5 {
            inl io_j1 -> let (stdin, io_j1t) = io_j1;
              let (stdout, io_j1tt) = io_j1t;
              n <- return io_j1tt;
              return inl ((stdin, stdout), n)
          | inr io_a5 -> return io_a5
          }
      | inr io_r5 -> return inr io_r5
      })
