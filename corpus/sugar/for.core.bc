-- The elaboration of `for.bc` (SPEC §11, §14), as `bcc desugar` prints it: an ordinary core program,
-- with the I/O and divergence libraries the sugar brings in. `scripts/check-sugar.sh` checks that
-- both erase to one term.
extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (i32 + 1))

extern write_byte : !(all 'a < top. mut 'a output * i32 => mut 'a output)

type In = ref input

type Out = ref output

type Bytes = mu X. 1 + i32 * X

def getb : In => In * (i32 + 1) =
  thunkv fun (c : In) ->
      return withbor2['x, top, input, i32 + 1] c (thunkv Fun 'x < dom.
          return (thunkv fun (m : mut 'x input) ->
              r <- return (unbang read_byte) ['x] m;
              let (m2, b) = r;
              return boxed['x] b))

def putb : Out * i32 => Out * 1 =
  thunkv fun (p : Out * i32) ->
      let (c, b) = p;
      return withbor2['x, top, output, 1] c (thunkv Fun 'x < dom.
          return (thunkv fun (m : mut 'x output) ->
              m2 <- return (unbang write_byte) ['x] (m, b);
              return boxed['x] ()))

def io_dec_step : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) =
  !thunkv fun (s : Out * i32 * i32 * (1 + 1)) ->
      let (o, r) = s;
      let (n, r2) = r;
      let (d, st) = r2;
      case (unbang host[eqz32]) d {
        inl nz -> q <- return (unbang host[div_u32]) (n, d);
          digit : i32 <- case q {
              inl x -> return x
            | inr u -> return i32[0]
            };
          n2 <- return (unbang host[sub32]) (n, (unbang host[mul32]) (digit, d));
          show : 1 + 1 <- case st {
              inl u -> case (unbang host[eqz32]) digit {
                  inl u2 -> return (inr () : 1 + 1)
                | inr u3 -> return (unbang host[eq32]) (d, i32[1])
                }
            | inr u -> return (inr () : 1 + 1)
            };
          o2 : Out <- case show {
              inl u -> return o
            | inr u -> q2 <- return putb (o, (unbang host[add32]) (digit, i32[48]));
                let (o3, v) = q2;
                return o3
            };
          q3 <- return (unbang host[div_u32]) (d, i32[10]);
          d2 : i32 <- case q3 {
              inl x -> return x
            | inr u -> return i32[0]
            };
          return (o2, (n2, (d2, show)))
      | inr z -> return (o, (n, (d, st)))
      }

def io_dec_twice : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) => !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1)) =
  thunkv fun (f : !(Out * i32 * i32 * (1 + 1) => Out * i32 * i32 * (1 + 1))) ->
      return (!thunkv fun (s : Out * i32 * i32 * (1 + 1)) ->
          return (unbang f) ((unbang f) s))

def put_dec : Out * i32 => Out * 1 =
  thunkv fun (p : Out * i32) ->
      let (o, n) = p;
      s <- return (unbang io_dec_twice (io_dec_twice (io_dec_twice (io_dec_twice io_dec_step)))) (o, (n, (i32[1000000000], (inl () : 1 + 1))));
      let (o2, r) = s;
      return (o2, ())

def io_bytes_step : !U (In -o F (i32 * In + In) & F In) =
  !thunkv fun (c : In) ->
      < q <- return getb c;
        let (c2, x) = q;
        case x {
          inl b -> return inl (b, c2)
        | inr u -> return inr c2
        },
        return c >

def bytes : In => U iter i32 In In =
  thunkv fun (c : In) ->
      f <- return unbang unfold[iter i32 In In, In] io_bytes_step;
      return (thunkv nu_in < (nu_out force f c).1,
          (nu_out force f c).2 >)

def div_bind_step[A, B, R1, R] : !U (U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R -o F (B + U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) & F R) =
  !thunkv fun (s : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R) ->
      < case s {
          inl p -> let (m, k) = p;
            o <- (nu_out force m).1;
            case o {
              inl a -> l <- force k.1 a;
                return inr inr l
            | inr m2 -> return inr inl (m2, k)
            }
        | inr l -> o <- (nu_out force l).1;
            case o {
              inl b -> return inl b
            | inr l2 -> return inr inr l2
            }
        },
        case s {
          inl p -> let (m, k) = p;
            r1 <- (nu_out force m).2;
            force k.2 r1
        | inr l -> (nu_out force l).2
        } >

def div_bind[A, B, R1, R] : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) => U loop B R =
  thunkv fun (p : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R))) ->
      f <- return unbang unfold[loop B R, U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R] div_bind_step[A, B, R1, R];
      s0 : U loop A R1 * U ((A -o F U loop B R) & (R1 -o F R)) + U loop B R <- return inl p;
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def div_double_alg : !(1 + (mu X. 1 + X) => mu X. 1 + X) =
  !thunkv fun (r : 1 + (mu X. 1 + X)) ->
      case r {
        inl u -> return (roll inl u : mu X. 1 + X)
      | inr m -> return (roll inr (roll inr m : mu X. 1 + X) : mu X. 1 + X)
      }

def div_nat_step : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =
  !thunkv fun (s : i32 * (mu X. 1 + X)) ->
      let (n, acc) = s;
      d <- return (unbang fold_own[1 + X, mu X. 1 + X] div_double_alg) acc;
      n2 <- return (unbang host[shl32]) (n, i32[1]);
      case (unbang host[eqz32]) ((unbang host[shr_u32]) (n, i32[31])) {
        inl one -> return (n2, (roll inr d : mu X. 1 + X))
      | inr zero -> return (n2, d)
      }

def div_nat_twice : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) => !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X)) =
  thunkv fun (f : !(i32 * (mu X. 1 + X) => i32 * (mu X. 1 + X))) ->
      return (!thunkv fun (s : i32 * (mu X. 1 + X)) ->
          return (unbang f) ((unbang f) s))

def div_nat : i32 => mu X. 1 + X =
  thunkv fun (n : i32) ->
      s <- return (unbang div_nat_twice (div_nat_twice (div_nat_twice (div_nat_twice (div_nat_twice div_nat_step))))) (n, (roll inl () : mu X. 1 + X));
      let (z, acc) = s;
      return acc

def div_fuel_alg[A, Q] : !(1 + !(U loop A Q => A + Q) => !(U loop A Q => A + Q)) =
  !thunkv fun (r : 1 + !(U loop A Q => A + Q)) ->
      case r {
        inl u -> let () = u;
          return (!thunkv fun (l : U loop A Q) ->
              q <- (nu_out force l).2;
              return inr q)
      | inr k -> return (!thunkv fun (l : U loop A Q) ->
              o <- (nu_out force l).1;
              case o {
                inl a -> return inl a
              | inr l2 -> return (unbang k) l2
              })
      }

def div_fuel[A, Q] : U loop A Q * i32 => A + Q =
  thunkv fun (p : U loop A Q * i32) ->
      let (l, n) = p;
      h <- return (unbang fold_own[1 + X, !(U loop A Q => A + Q)] div_fuel_alg[A, Q]) (div_nat n);
      return (unbang h) l

extern stdin : ref input

extern stdout : ref output

main : F U loop ((ref input * ref output) * i32) ((ref input * ref output) * 1) =
  n : i32 <- return i32[0];
  io_step : !U (U iter i32 (ref input) (ref input) * ref output * i32 -o F ((ref input * ref output) * i32 + U iter i32 (ref input) (ref input) * ref output * i32) & F ((ref input * ref output) * 1)) <- return (!thunkv fun (io_s : U iter i32 (ref input) (ref input) * ref output * i32) ->
        < let (io_it, io_st) = io_s;
          let (stdout, n) = io_st;
          io_o <- (nu_out force io_it).1;
          case io_o {
            inl io_p -> let (b, io_it) = io_p;
              n : i32 <- return (unbang host[add32]) (n, i32[1]);
              io_lend <- return putb (stdout, b);
              let (stdout, io_u) = io_lend;
              return inr (io_it, (stdout, n))
          | inr io_c -> stdin <- return io_c;
              io_v : (ref input * ref output) * i32 <- return ((stdin, stdout), n);
              return inl io_v
          },
          let (io_it, io_st) = io_s;
          let (stdout, n) = io_st;
          io_c <- (nu_out force io_it).2;
          stdin <- return io_c;
          return ((stdin, stdout), ()) >);
  io_f <- return unbang unfold[loop ((ref input * ref output) * i32) ((ref input * ref output) * 1), U iter i32 (ref input) (ref input) * ref output * i32] io_step;
  io_s0 : U iter i32 (ref input) (ref input) * ref output * i32 <- return (bytes stdin, (stdout, n));
  return (thunkv nu_in < (nu_out force io_f io_s0).1,
      (nu_out force io_f io_s0).2 >)
