-- `finaliser-order.bc` with the finaliser the checker inserts written out: the call is bound by
-- `[then]` (`unwind`), and its finaliser consumes `d` and then `c`, most recently bound first. A
-- cell's consume is `free_cell`, the term of `ref i32`'s consume (SPEC §12).
def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 cancel i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

def free_cell : ref i32 => 1 =
  thunkv fun (c : ref i32) -> u <- return (free[i32] c); z <- return u; return ()

def use_cells : !U (i32 -o F[1.0 cancel i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    c <- return (alloc[i32] i32[3]);
    d <- return (alloc[i32] i32[4]);
    f <- return (unbang check);
    v <- force f a unwind (let () = free_cell d; let () = free_cell c; return ());
    y <- return (free[i32] d);
    x <- return (free[i32] c);
    return (plus (v, plus (x, y)))

main : F (i32 + i32) =
  b <- return i32[0];
  handle_with[1](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (g <- return (unbang use_cells); force g b)
