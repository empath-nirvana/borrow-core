-- lowers: corpus/pipe-bracket.bc
-- `corpus/pipe-bracket.bc` with each chain written as §33's case (iii) writes it, the nested calls
-- (SPEC §70): the three bracketings of `range(0, 10) >| map(sq) >| filter(big) >| take(2)`
-- are each `take(filter(map(range(0, 10), sq), big), 2)`.

include adapters

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn sq(x: i32) -> i32 = x * x
fn big(x: i32) -> bool = x > 5

fn left() -> i32 =
  let mut a = 0;
  for y in take(filter(map(range(0, 10), sq), big), 2) { a = a + y };
  a

fn right() -> i32 =
  let mut a = 0;
  for y in take(filter(map(range(0, 10), sq), big), 2) { a = a + y };
  a

fn mixed() -> i32 =
  let mut a = 0;
  for y in take(filter(map(range(0, 10), sq), big), 2) { a = a + y };
  a

main -> i32 * (i32 * i32) = (left(), (right(), mixed()))
