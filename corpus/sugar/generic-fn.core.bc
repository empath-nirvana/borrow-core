-- `generic-fn.bc` written by hand in core: the generic function a `def` with a type parameter,
-- its lifetime an `all 'a` around it and a `Fun 'a` around its body, `*g` a `withload`; the call
-- `(unbang first[i32]) ['x] V`.
def tab : !(i32 => i32) =
  !thunkv fun (p : i32) ->
    i <- return p;
    return ((unbang host[add32]) (i, i32[10]))

def first[A] : !(all 'a < top. array_imm 'a A * A => A) =
  !thunkv Fun 'a < top. return (thunkv fun (p : array_imm 'a A * A) ->
    let (v, d) = p;
    case (unbang array_get['a, A]) (v, i32[0]) {
      inl g -> return (withload['a, 'y, A, A] g (thunkv Fun 'y < dom. return (thunkv fun (e : view 'y A) ->
                 return (boxed['y] e))))
    | inr u -> return d
    })

main : F i32 =
  a <- return ((unbang array_new[i32]) (i32[3], tab));
  r <- return (slice_borrow_imm['x, top, i32, i32] a (thunkv Fun 'x < dom. return (thunkv fun (v : array_imm 'x i32) ->
         b <- return ((unbang first[i32]) ['x] (v, i32[0]));
         return (boxed['x] b))));
  let (a, x) = r;
  return x
