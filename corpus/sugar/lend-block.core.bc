-- `lend-block.bc` in core, as `bcc desugar` prints it: the borrow block over the loop, lent per
-- observation. The stretch before the loop is a `withbor1` of `t` that hands on `first` and `acc`;
-- the loop is the state of `main`'s machine (SPEC §15) that holds the iterator, `t` and the
-- threaded variables, whose code borrows `t` around the body; the stretch after the loop borrows
-- `t` in the loop's last step.

def get : !(all 'a < top. imm 'a array i32 * i32 => i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (p : imm 'a array i32 * i32) ->
          let (b, i) = p;
          return withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom.
              return (thunkv fun (xs : array_imm 'z i32) ->
                  case (unbang array_get['z, i32]) (xs, i) {
                    inl e -> v <- return withload['z, 'io_ly13_59, i32, i32] e (thunkv Fun 'io_ly13_59 < dom.
                            return (thunkv fun (io_dv : view 'io_ly13_59 i32) ->
                                return boxed['io_ly13_59] io_dv));
                      return boxed['z] v
                  | inr io_m0 -> io_d1 <- return io_m0;
                      return boxed['z] i32[0]
                  })))

def tab : !(i32 => i32) =
  !thunkv fun (i : i32) ->
      return (unbang host[mul32]) (i, i32[10])

def down : i32 => U iter i32 1 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[iter i32 1 1, i32] (!thunkv fun (k : i32) ->
            < case (unbang host[eqz32]) k {
                inl nz -> return inl (k, (unbang host[sub32]) (k, i32[1]))
              | inr z -> return inr ()
              },
              return () >);
      return (thunkv nu_in < (nu_out force f n).1,
          (nu_out force f n).2 >)

main : F U loop i32 1 =
  io_run_0 : !(U iter i32 1 1 * ref array i32 * i32 * i32 => i32 + U iter i32 1 1 * ref array i32 * i32 * i32) <- return (!thunkv fun (io_a : U iter i32 1 1 * ref array i32 * i32 * i32) ->
        let (io_it0, io_a_t) = io_a;
        let (t, io_a_t_t) = io_a_t;
        let (first, acc) = io_a_t_t;
        io_o <- (nu_out force io_it0).1;
        case io_o {
          inl io_p -> let (i, io_it0) = io_p;
            io_lb30_11_3 <- return withbor1['io_l2, array i32, i32] t (thunkv Fun 'io_l2 < dom.
                  return (thunkv fun (b : imm 'io_l2 array i32) ->
                      acc <- return (unbang host[add32]) ((unbang host[add32]) (acc, first), (unbang get) ['io_l2] (b, i));
                      io_u <- return ();
                      return boxed['io_l2] acc));
            let (t, io_lr30_11_4) = io_lb30_11_3;
            acc <- return io_lr30_11_4;
            io_u <- return ();
            return inr (io_it0, (t, (first, acc)))
        | inr io_d -> io_q <- return io_d;
            io_b3 <- return withbor1['io_l2, array i32, i32] t (thunkv Fun 'io_l2 < dom.
                  return (thunkv fun (b : imm 'io_l2 array i32) ->
                      io_bx <- return (unbang host[add32]) ((unbang host[sub32]) (acc, i32[6]), (unbang get) ['io_l2] (b, i32[0]));
                      return boxed['io_l2] io_bx));
            let (t, n) = io_b3;
            io_v : i32 <- return n;
            return inl io_v
        });
  io_step : !U (U iter i32 1 1 * ref array i32 * i32 * i32 -o F (i32 + U iter i32 1 1 * ref array i32 * i32 * i32) & F 1) <- return (!thunkv fun (io_a : U iter i32 1 1 * ref array i32 * i32 * i32) ->
        < return (unbang io_run_0) io_a,
          let (io_it0, io_a_t) = io_a;
          let (t, io_a_t_t) = io_a_t;
          let (first, acc) = io_a_t_t;
          io_c <- (nu_out force io_it0).2;
          return () >);
  io_mk : !(U iter i32 1 1 * ref array i32 * i32 * i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U iter i32 1 1 * ref array i32 * i32 * i32) ->
        io_f <- return unbang unfold[loop i32 1, U iter i32 1 1 * ref array i32 * i32 * i32] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  t <- return alloc[array i32] ((unbang array_new[i32]) (i32[10], tab));
  io_lb30_11_1 <- return withbor1['io_l2, array i32, i32 * i32] t (thunkv Fun 'io_l2 < dom.
        return (thunkv fun (b : imm 'io_l2 array i32) ->
            first <- return (unbang get) ['io_l2] (b, i32[1]);
            acc <- return i32[0];
            io_bx <- return (first, acc);
            return boxed['io_l2] io_bx));
  let (t, io_lr30_11_2) = io_lb30_11_1;
  let (first, acc) = io_lr30_11_2;
  io_it0 <- return down i32[4];
  return (unbang io_mk) (io_it0, (t, (first, acc)))
