-- `lend-block.bc` in core, as `bcc desugar` prints it: the borrow block over the loop, lent per
-- observation. The stretch before the loop is a `withbor1` of `t` that hands on `first` and `acc`;
-- the loop is `iterate` over the iterator, `t` and the threaded variables, whose turn borrows `t`
-- around the body; the stretch after the loop borrows `t` once the loop has ended.
def get : !(all 'a < top. imm 'a array i32 * i32 => i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (p : imm 'a array i32 * i32) ->
          let (b, i) = p;
          return withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom.
              return (thunkv fun (xs : array_imm 'z i32) ->
                  case (unbang array_get['z, i32]) (xs, i) {
                    inl e -> v <- return withload['z, 'io_ly13_59, i32, i32] e (thunkv Fun 'io_ly13_59 < dom.
                            return (thunkv fun (io_dv : view 'io_ly13_59 i32) ->
                                return boxed['io_ly13_59] io_dv));
                      return boxed['z] v
                  | inr io_m0 -> io_d1 <- return io_m0;
                      return boxed['z] i32[0]
                  })))

def tab : !(i32 => i32) =
  !thunkv fun (i : i32) ->
      return (unbang host[mul32]) (i, i32[10])

def down : i32 => U iter i32 1 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[iter i32 1 1, i32] (!thunkv fun (k : i32) ->
            < case (unbang host[eqz32]) k {
                inl nz -> return inl (k, (unbang host[sub32]) (k, i32[1]))
              | inr z -> return inr ()
              },
              return () >);
      return (thunkv nu_in < (nu_out force f n).1,
          (nu_out force f n).2 >)

main : F U loop i32 1 =
  return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
        return ())) (thunkv fun (io_u : 1) ->
      let () = io_u;
      t <- return alloc[array i32] ((unbang array_new[i32]) (i32[10], tab));
      io_lb30_11_1 <- return withbor1['io_l2, array i32, i32 * i32] t (thunkv Fun 'io_l2 < dom.
            return (thunkv fun (b : imm 'io_l2 array i32) ->
                first <- return (unbang get) ['io_l2] (b, i32[1]);
                acc <- return i32[0];
                io_bx <- return (first, acc);
                return boxed['io_l2] io_bx));
      let (t, io_lr30_11_2) = io_lb30_11_1;
      let (first, acc) = io_lr30_11_2;
      io_src2 <- return down i32[4];
      io_step8 : !U (U iter i32 1 1 * ref array i32 * i32 * i32 -o F[div] ((ref array i32 * i32 + i32 + 1) + U iter i32 1 1 * ref array i32 * i32 * i32) & F[div] 1) <- return (!thunkv fun (io_s8 : U iter i32 1 1 * ref array i32 * i32 * i32) ->
            < let (io_src2, io_s8t) = io_s8;
              let (t, io_s8tt) = io_s8t;
              let (first, io_s8ttt) = io_s8tt;
              acc <- return io_s8ttt;
              io_o <- (nu_out force io_src2).1;
              case io_o {
                inl io_p -> let (i, io_src2) = io_p;
                  io_lb30_11_3 <- return withbor1['io_l2, array i32, i32] t (thunkv Fun 'io_l2 < dom.
                        return (thunkv fun (b : imm 'io_l2 array i32) ->
                            acc <- return (unbang host[add32]) ((unbang host[add32]) (acc, first), (unbang get) ['io_l2] (b, i));
                            return boxed['io_l2] acc));
                  let (t, io_lr30_11_4) = io_lb30_11_3;
                  acc <- return io_lr30_11_4;
                  return inr (io_src2, (t, (first, acc)))
              | inr io_d -> io_q <- return io_d;
                  return inl inl (t, acc)
              },
              let (io_src2, io_s8t) = io_s8;
              let (t, io_s8tt) = io_s8t;
              let (first, io_s8ttt) = io_s8tt;
              acc <- return io_s8ttt;
              io_c <- (nu_out force io_src2).2;
              return () >);
      io_s08 : U iter i32 1 1 * ref array i32 * i32 * i32 <- return (io_src2, (t, (first, acc)));
      io_x8 : (ref array i32 * i32 + i32 + 1) + 1 <- (io_n8 <- perform[4294967295.0] ();
        case io_n8 {
          inl io_u -> io_it8 <- return unbang iterate[U iter i32 1 1 * ref array i32 * i32 * i32, ref array i32 * i32 + i32 + 1, 1, [div]];
            io_p8 : !U (U iter i32 1 1 * ref array i32 * i32 * i32 -o F[div] ((ref array i32 * i32 + i32 + 1) + U iter i32 1 1 * ref array i32 * i32 * i32) & F[div] 1) * U iter i32 1 1 * ref array i32 * i32 * i32 <- return (io_step8, io_s08);
            force io_it8 io_p8
        | inr io_u -> io_sf8 <- return unbang io_step8;
            io_q8 <- force io_sf8 io_s08.2;
            return inr io_q8
        });
      case io_x8 {
        inl io_l8 -> case io_l8 {
            inl io_j2 -> let (t, io_j2t) = io_j2;
              acc <- return io_j2t;
              io_b3 <- return withbor1['io_l2, array i32, i32] t (thunkv Fun 'io_l2 < dom.
                    return (thunkv fun (b : imm 'io_l2 array i32) ->
                        io_bx <- return (unbang host[add32]) ((unbang host[sub32]) (acc, i32[6]), (unbang get) ['io_l2] (b, i32[0]));
                        return boxed['io_l2] io_bx));
              let (t, n) = io_b3;
              return inl n
          | inr io_a8 -> return io_a8
          }
      | inr io_r8 -> return inr io_r8
      })
