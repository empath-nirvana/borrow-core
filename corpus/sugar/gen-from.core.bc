-- `gen-from.bc` written by hand in core. Each body is one state machine (SPEC §15).
--
-- `two` has three states: before it starts, after `yield 1` and after `yield 2`.
--
-- `around` has four: before it starts; after `yield 0`; during `yield from two()`, holding the
-- delegate; and after `yield n`, holding `n`. The delegation's code is `deleg`, called from the
-- state after `yield 0` (which starts `two()` and observes it at once) and from the delegation's
-- own state: each element `two` yields is yielded with the delegation's state, a skip of `two` is
-- a skip, and when `two` finishes with `n` the code goes on to `yield n`. Closed during the
-- delegation, `around` closes `two`, whose residual is `()`.
--
-- `main` is one loop over `around()`, whose end runs what follows it and finishes.

def two : !(1 => U (gen i32 i32 1)) =
  !thunkv fun (p : 1) ->
    step : !U (1 + (1 + 1) -o F (i32 * (1 + (1 + 1)) + (i32 + (1 + (1 + 1)))) & F 1) <-
      return (!thunkv fun (s : 1 + (1 + 1)) ->
        < case s {
            inl a -> p <- return a; let () = p; return (inl (i32[1], inr (inl ())))
          | inr b -> case b {
              inl a -> let () = a; u <- return (); return (inl (i32[2], inr (inr ())))
            | inr a -> let () = a; u <- return (); v : i32 <- return i32[5]; return (inr (inl v))
            }
          },
          case s {
            inl a -> p <- return a; let () = p; return ()
          | inr b -> case b {
              inl a -> let () = a; return ()
            | inr a -> let () = a; return ()
            }
          } >);
    f <- return (unbang (unfold[gen i32 i32 1, 1 + (1 + 1)] step));
    s0 : 1 + (1 + 1) <- return (inl p);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

def around : !(1 => U (gen i32 i32 1)) =
  !thunkv fun (p : 1) ->
    -- During `yield from two()`: one observation of the delegate `g`.
    deleg : !(U (gen i32 i32 1)
              => i32 * (1 + (1 + (U (gen i32 i32 1) + i32)))
                 + (i32 + (1 + (1 + (U (gen i32 i32 1) + i32))))) <-
      return (!thunkv fun (a : U (gen i32 i32 1)) ->
        g <- return a;
        o <- (nu_out (force g)).1;
        case o {
          inl y -> let (e, g) = y; return (inl (e, inr (inr (inl g))))
        | inr d -> case d {
            inl b -> n <- return b; return (inl (n, inr (inr (inr n))))
          | inr g -> return (inr (inr (inr (inr (inl g)))))
          }
        });
    step : !U (1 + (1 + (U (gen i32 i32 1) + i32))
               -o F (i32 * (1 + (1 + (U (gen i32 i32 1) + i32)))
                     + (i32 + (1 + (1 + (U (gen i32 i32 1) + i32))))) & F 1) <-
      return (!thunkv fun (s : 1 + (1 + (U (gen i32 i32 1) + i32))) ->
        < case s {
            inl a -> p <- return a; let () = p; return (inl (i32[0], inr (inl ())))
          | inr b -> case b {
              inl a -> let () = a; u <- return (); g <- return ((unbang two) ()); return ((unbang deleg) g)
            | inr b -> case b {
                inl a -> return ((unbang deleg) a)
              | inr a ->
                  n <- return a;
                  u <- return ();
                  v : i32 <- return ((unbang host[add32]) (n, i32[1]));
                  return (inr (inl v))
              }
            }
          },
          case s {
            inl a -> p <- return a; let () = p; return ()
          | inr b -> case b {
              inl a -> let () = a; return ()
            | inr b -> case b {
                inl a -> g <- return a; r <- (nu_out (force g)).2; let () = r; return ()
              | inr a -> n <- return a; return ()
              }
            }
          } >);
    f <- return (unbang (unfold[gen i32 i32 1, 1 + (1 + (U (gen i32 i32 1) + i32))] step));
    s0 : 1 + (1 + (U (gen i32 i32 1) + i32)) <- return (inl p);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

main : F (U (loop i32 1)) =
  -- The loop's head: one iteration; at the end, what follows the loop.
  head : !(U (gen i32 i32 1) * i32 => i32 + U (gen i32 i32 1) * i32) <-
    return (!thunkv fun (a : U (gen i32 i32 1) * i32) ->
      let (it, acc) = a;
      o <- (nu_out (force it)).1;
      case o {
        inl y ->
          let (x, it) = y;
          acc <- return ((unbang host[add32]) ((unbang host[mul32]) (acc, i32[10]), x));
          u <- return ();
          return (inr (it, acc))
      | inr d -> case d {
          inl q ->
            r <- return q;
            v : i32 <- return ((unbang host[add32]) ((unbang host[mul32]) (acc, i32[10]), r));
            return (inl v)
        | inr it -> return (inr (it, acc))
        }
      });
  step : !U (U (gen i32 i32 1) * i32 -o F (i32 + U (gen i32 i32 1) * i32) & F 1) <-
    return (!thunkv fun (a : U (gen i32 i32 1) * i32) ->
      < return ((unbang head) a),
        let (it, acc) = a;
        c <- (nu_out (force it)).2;
        return () >);
  mk : !(U (gen i32 i32 1) * i32 => U (loop i32 1)) <-
    return (!thunkv fun (s0 : U (gen i32 i32 1) * i32) ->
      f <- return (unbang (unfold[loop i32 1, U (gen i32 i32 1) * i32] step));
      return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >));
  acc <- return i32[0];
  it <- return ((unbang around) ());
  return ((unbang mk) (it, acc))
