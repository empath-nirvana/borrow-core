-- A generator with three `yield`s and no loop. `gen fn` elaborates the body to one state machine
-- (SPEC §15): a state before it starts and one after each `yield`; each `next` runs to the next
-- `yield` and answers with the element and the state after it, and `close` hands back the
-- residual (`()` here) without running anything. The call runs nothing: it returns the machine at
-- its first state. `gen-yields.core.bc` is its elaboration in core, as `bcc desugar` prints it.
-- Answer: i32[14].

gen fn produce() -> i32 =
  yield 1;
  yield 4;
  yield 9

main -> i32 =
  let mut acc = 0;
  for x in produce() { acc = acc + x };
  acc
