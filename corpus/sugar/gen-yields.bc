-- A generator with three `yield`s and no loop: a function at the row of `Yield`, whose copy for
-- the `for`'s site threads the loop's variable `acc` through the operation, `w <- perform (x, w)`.
-- The `for` is one handled call, total: its clause is the loop's body, resumed at its end.
-- `gen-yields.core.bc` is its elaboration in core, as `bcc desugar` prints it.
-- Answer: i32[14].

include yield

fn produce() -> 1 with Yield[i32] =
  yield(1);
  yield(4);
  yield(9)

main -> i32 =
  let mut acc = 0;
  for x in produce() { acc = acc + x };
  acc
