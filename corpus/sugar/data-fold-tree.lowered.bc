-- lowers: corpus/data-fold-tree.bc
-- `corpus/data-fold-tree.bc` with its fold blocks written out by SPEC §42's rules F1 and F2, in
-- the surface: each the kernel's fold at the tree's shape and the function's result, applied to
-- the algebra at `A_R`, `A″_R` or `A′_R`, its arms a `case` on the unrolled shape. In the
-- `fold_reuse` arm `Node(dl, c, dr)` is the block reassembled from its cells; in the `fold_own`
-- arm `box Node(l, v, r)` frees the value cell, and only it: the children are the fold's results.

type Tree = mu X. 1 + (ref X * (ref i32 * ref X))

shape Tree_Node = node (leaf Tree) (node (leaf i32) (leaf Tree))

fn branch(l: Tree, v: i32, r: Tree) -> Tree = (roll (inr (alloc_s[Tree_Node] (l, (v, r)))) : Tree)

fn sum<'a>(t: imm 'a Tree) -> i32 =
  (unbang fold_imm[1 + ref X * (ref i32 * ref X), 'y, top, i32] (!thunkv Fun 'y < top.
    return (thunkv fun (x : 1 + i32 * (imm 'y i32 * i32)) ->
      case x {
        inl e -> let () = e; 0
      | inr b ->
          let (cl, rest) = b;
          let (cv, cr) = rest;
          let l = cl;
          let v = cv;
          let r = cr;
          l + *v + r
      }))) ['a] t

fn map_inc(t: Tree) -> Tree =
  (unbang fold_reuse[1 + ref X * (ref i32 * ref X), Tree] (!thunkv fun (x : 1 + (ref 1 * Tree) * (ref i32 * (ref 1 * Tree))) ->
    case x {
      inl e -> let () = e; (roll (inl ()) : Tree)
    | inr b ->
        let (pl, rest) = b;
        let (cc, pr) = rest;
        let (cdl, cl) = pl;
        let (cdr, cr) = pr;
        let dr = cdr;
        let r = cr;
        let dl = cdl;
        let l = cl;
        let c = cc;
        let (dl, ()) = swap(dl, l);
        let (c, x) = swap(c, ());
        let (c, ()) = swap(c, x + 1);
        let (dr, ()) = swap(dr, r);
        (roll (inr (dl, (c, dr))) : Tree)
    })) t

fn digits(t: Tree) -> i32 =
  (unbang fold_own[1 + ref X * (ref i32 * ref X), i32] (!thunkv fun (x : 1 + i32 * (ref i32 * i32)) ->
    case x {
      inl e -> let () = e; 0
    | inr b ->
        let (cl, rest) = b;
        let (cv, cr) = rest;
        let v = free(cv);
        let l = cl;
        let r = cr;
        l + v * 10 + r * 100
    })) t

main -> i32 =
  let mut t = branch(branch((roll (inl ()) : Tree), 1, (roll (inl ()) : Tree)), 2,
    branch((roll (inl ()) : Tree), 3, (roll (inl ()) : Tree)));
  let s = sum(&t);
  modify &mut t { k -> map_inc(k) };
  digits(t) * 10 + s
