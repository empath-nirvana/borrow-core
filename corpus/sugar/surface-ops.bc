-- Literals and operators (typed elaboration, stage 5, §5.5). A literal is `i32` unless an `i64` is
-- expected of it; an operator is the host operation at its operands' width; a comparison is
-- signed and returns `1 + 1`, `inr ()` for true. `surface-ops.core.bc` is the program written by
-- hand in core.
-- Answer: ((i64[47], inr ()), inl ()): 4 * 10 + 7, 3 * 2 + 1 - 3 = 4 < 5, not 2 >= 3.
fn mix(a: i32, b: i64) -> i64 * (1 + 1) =
  let c = a * 2 + 1 - a;
  (b * 10 + 7, c < 5)

main -> (i64 * (1 + 1)) * (1 + 1) =
  (mix(3, 4), 2 >= 3)
