-- `gen-callback.bc` written by hand in core. The closure is a generator function: each call
-- returns the generator of its body. `twice_gen` is `twice` at that callback type: each call of
-- `f` is a `yield from`, `gen_bind` (copied from the generator library, `lib/gen.bc`) of the
-- generator it returns and the rest. `pairs` delegates to `twice_gen`, and finishes with what it
-- finishes with.

-- The bind's state: in the first generator, with the continuation; or in the continuation's
-- generator. The continuation has two observations: go on with the first generator's result,
-- or, when the whole is closed during the first, turn its residual into the whole's.
def gen_bind_step[A, B1, R1, B, R] :
    !U ((U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) + U (gen A B R)
        -o F (A * ((U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) + U (gen A B R))
              + (B + ((U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) + U (gen A B R))))
         & F R) =
  !thunkv fun (s : (U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) + U (gen A B R)) ->
    < case s {
        inl p ->
          let (m, k) = p;
          o <- (nu_out (force m)).1;
          case o {
            inl y ->
              let (a, m2) = y;
              return (inl (a, inl (m2, k)))
          | inr d ->
              case d {
                inl b1 ->
                  l <- (force k).1 b1;
                  return (inr (inr (inr l)))
              | inr m2 -> return (inr (inr (inl (m2, k))))
              }
          }
      | inr l ->
          o <- (nu_out (force l)).1;
          case o {
            inl y ->
              let (a, l2) = y;
              return (inl (a, inr l2))
          | inr d ->
              case d {
                inl b -> return (inr (inl b))
              | inr l2 -> return (inr (inr (inr l2)))
              }
          }
      },
      case s {
        inl p ->
          let (m, k) = p;
          r1 <- (nu_out (force m)).2;
          (force k).2 r1
      | inr l -> (nu_out (force l)).2
      } >

-- The bind: run the first generator, passing on what it yields, then the continuation on its
-- result. It is `div_bind` (SPEC §14) with elements.
def gen_bind[A, B1, R1, B, R] :
    U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R)) => U (gen A B R) =
  thunkv fun (p : U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) ->
    f <- return (unbang (unfold[gen A B R,
           (U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) + U (gen A B R)]
           gen_bind_step[A, B1, R1, B, R]));
    s0 : (U (gen A B1 R1) * U ((B1 -o F (U (gen A B R))) & (R1 -o F R))) + U (gen A B R) <-
      return (inl p);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

def twice_gen : !(!(i32 => U (gen i32 1 1)) * i32 => U (gen i32 1 1)) =
  !thunkv fun (p : !(i32 => U (gen i32 1 1)) * i32) ->
    return (thunkv nu_in <
      let (f, x) = p;
      m <- return ((unbang f) x);
      g <- return (gen_bind[i32, 1, 1, 1, 1] (m, thunkv
        < fun (a : 1) ->
            s0 <- return a;
            return (thunkv nu_in <
              m <- return ((unbang f) ((unbang host[add32]) (x, i32[1])));
              g <- return (gen_bind[i32, 1, 1, 1, 1] (m, thunkv
                < fun (a : 1) ->
                    t <- return a;
                    return (thunkv nu_in < v : 1 <- return t; return (inr (inl v)),
                      dt <- return t; return () >),
                  fun (r : 1) -> let () = r; return () >));
              (nu_out (force g)).1,
              df <- return f;
              dx <- return x;
              return () >),
          fun (r : 1) -> let () = r; df <- return f; dx <- return x; return () >));
      (nu_out (force g)).1,
      let (f, x) = p;
      return () >)

-- The closure `!{ y -> yield y; yield y * 10 }`, a generator function.
def pairs : !(i32 => U (gen i32 1 1)) =
  !thunkv fun (p : i32) ->
    return (thunkv nu_in <
      x <- return p;
      m <- return ((unbang twice_gen) (!thunkv fun (y : i32) ->
        return ((thunkv nu_in <
          return (inl (y, thunkv nu_in <
            s2 <- return ();
            return (inl ((unbang host[mul32]) (y, i32[10]), thunkv nu_in <
              s <- return ();
              v : 1 <- return ();
              return (inr (inl v)),
              return () >)),
            dy <- return y;
            return () >)),
          dy <- return y;
          return () > : U (gen i32 1 1))), x));
      g <- return (gen_bind[i32, 1, 1, 1, 1] (m, thunkv
        < fun (a : 1) ->
            t <- return a;
            return (thunkv nu_in < v : 1 <- return t; return (inr (inl v)),
              dt <- return t; return () >),
          fun (r : 1) -> let () = r; return () >));
      (nu_out (force g)).1,
      x <- return p;
      return () >)

main : F (U (loop i32 1)) =
  acc <- return i32[0];
  step : !U (U (gen i32 1 1) * i32 -o F (i32 + U (gen i32 1 1) * i32) & F 1) <-
    return (!thunkv fun (s : U (gen i32 1 1) * i32) ->
      < let (it, st) = s;
        acc <- return st;
        o <- (nu_out (force it)).1;
        case o {
          inl q ->
            let (x, it) = q;
            acc <- return ((unbang host[add32]) (acc, x));
            u <- return ();
            return (inr (it, acc))
        | inr d ->
            case d {
              inl c -> v : i32 <- return acc; return (inl v)
            | inr it -> return (inr (it, acc))
            }
        },
        let (it, st) = s;
        acc <- return st;
        c <- (nu_out (force it)).2;
        return () >);
  f <- return (unbang (unfold[loop i32 1, U (gen i32 1 1) * i32] step));
  s0 : U (gen i32 1 1) * i32 <- return ((unbang pairs) i32[2], acc);
  return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)
