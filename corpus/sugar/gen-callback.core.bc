-- `gen-callback.bc` in core, as `bcc desugar` prints it. The closure is a generator function:
-- each call returns the state machine of its body. `twice__0` is `twice` at that callback type:
-- each call of `f` is a `yield from`, a state holding the generator it returns. `pairs` delegates
-- to `twice__0` the same way, and finishes with what it finishes with.

def twice : !(!(i32 => 1) * i32 => 1) =
  !thunkv fun (io_p1 : !(i32 => 1) * i32) ->
      let (f, x) = io_p1;
      io_s0 <- return (unbang f) x;
      return (unbang f) ((unbang host[add32]) (x, i32[1]))

def twice__0 : !(!(i32 => U gen i32 1 1) * i32 => U gen i32 1 1) =
  !thunkv fun (io_p1 : !(i32 => U gen i32 1 1) * i32) ->
      io_run_2 : !(U gen i32 1 1 => i32 * (!(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) + 1 + !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) <- return (!thunkv fun (io_a : U gen i32 1 1) ->
            io_d2 <- return io_a;
            io_o <- (nu_out force io_d2).1;
            case io_o {
              inl io_y -> let (io_e, io_d2) = io_y;
                return inl (io_e, inr inr io_d2)
            | inr io_dd -> case io_dd {
                  inl io_b -> io_t <- return io_b;
                    io_v : 1 <- return io_t;
                    return inr inl io_v
                | inr io_d2 -> return inr inr inr inr io_d2
                }
            });
      io_run_1 : !(U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 => i32 * (!(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) + 1 + !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) <- return (!thunkv fun (io_a : U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32) ->
            let (io_d1, io_a_t) = io_a;
            let (f, x) = io_a_t;
            io_o <- (nu_out force io_d1).1;
            case io_o {
              inl io_y -> let (io_e, io_d1) = io_y;
                return inl (io_e, inr inl (io_d1, (f, x)))
            | inr io_dd -> case io_dd {
                  inl io_b -> io_s0 <- return io_b;
                    io_d2 <- return (unbang f) ((unbang host[add32]) (x, i32[1]));
                    return (unbang io_run_2) io_d2
                | inr io_d1 -> return inr inr inr inl (io_d1, (f, x))
                }
            });
      io_step : !U (!(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 -o F (i32 * (!(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) + 1 + !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) & F 1) <- return (!thunkv fun (io_s : !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1) ->
            < case io_s {
                inl io_a -> io_p1 <- return io_a;
                  let (f, x) = io_p1;
                  io_d1 <- return (unbang f) x;
                  return (unbang io_run_1) (io_d1, (f, x))
              | inr io_b0 -> case io_b0 {
                    inl io_a -> return (unbang io_run_1) io_a
                  | inr io_a -> return (unbang io_run_2) io_a
                  }
              },
              case io_s {
                inl io_a -> io_p1 <- return io_a;
                  let (f, x) = io_p1;
                  return ()
              | inr io_b0 -> case io_b0 {
                    inl io_a -> let (io_d1, io_a_t) = io_a;
                      let (f, x) = io_a_t;
                      io_r <- (nu_out force io_d1).2;
                      let () = io_r;
                      return ()
                  | inr io_a -> io_d2 <- return io_a;
                      io_r <- (nu_out force io_d2).2;
                      let () = io_r;
                      return ()
                  }
              } >);
      io_f <- return unbang unfold[gen i32 1 1, !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1] io_step;
      io_s0 : !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 * !(i32 => U gen i32 1 1) * i32 + U gen i32 1 1 <- return inl io_p1;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

def pairs : !(i32 => U gen i32 1 1) =
  !thunkv fun (io_p3 : i32) ->
      io_run_1 : !(U gen i32 1 1 => i32 * (i32 + U gen i32 1 1) + 1 + i32 + U gen i32 1 1) <- return (!thunkv fun (io_a : U gen i32 1 1) ->
            io_d1 <- return io_a;
            io_o <- (nu_out force io_d1).1;
            case io_o {
              inl io_y -> let (io_e, io_d1) = io_y;
                return inl (io_e, inr io_d1)
            | inr io_dd -> case io_dd {
                  inl io_b -> io_t <- return io_b;
                    io_v : 1 <- return io_t;
                    return inr inl io_v
                | inr io_d1 -> return inr inr inr io_d1
                }
            });
      io_step : !U (i32 + U gen i32 1 1 -o F (i32 * (i32 + U gen i32 1 1) + 1 + i32 + U gen i32 1 1) & F 1) <- return (!thunkv fun (io_s : i32 + U gen i32 1 1) ->
            < case io_s {
                inl io_a -> io_p3 <- return io_a;
                  x <- return io_p3;
                  io_d1 <- return (unbang twice__0) (!thunkv fun (y : i32) ->
                        return (run (io_step : !U (i32 + i32 + 1 -o F (i32 * (i32 + i32 + 1) + 1 + i32 + i32 + 1) & F 1) <- return (!thunkv fun (io_s : i32 + i32 + 1) ->
                              < case io_s {
                                  inl io_a -> y <- return io_a;
                                    return inl (y, inr inl y)
                                | inr io_b0 -> case io_b0 {
                                      inl io_a -> y <- return io_a;
                                        io_s2 <- return ();
                                        return inl ((unbang host[mul32]) (y, i32[10]), inr inr ())
                                    | inr io_a -> let () = io_a;
                                        io_y <- return ();
                                        io_v : 1 <- return ();
                                        return inr inl io_v
                                    }
                                },
                                case io_s {
                                  inl io_a -> y <- return io_a;
                                    return ()
                                | inr io_b0 -> case io_b0 {
                                      inl io_a -> y <- return io_a;
                                        return ()
                                    | inr io_a -> let () = io_a;
                                        return ()
                                    }
                                } >);
                        io_f <- return unbang unfold[gen i32 1 1, i32 + i32 + 1] io_step;
                        io_s0 : i32 + i32 + 1 <- return inl y;
                        return (thunkv nu_in < (nu_out force io_f io_s0).1,
                            (nu_out force io_f io_s0).2 >)) : U gen i32 1 1), x);
                  return (unbang io_run_1) io_d1
              | inr io_a -> return (unbang io_run_1) io_a
              },
              case io_s {
                inl io_a -> io_p3 <- return io_a;
                  x <- return io_p3;
                  return ()
              | inr io_a -> io_d1 <- return io_a;
                  io_r <- (nu_out force io_d1).2;
                  let () = io_r;
                  return ()
              } >);
      io_f <- return unbang unfold[gen i32 1 1, i32 + U gen i32 1 1] io_step;
      io_s0 : i32 + U gen i32 1 1 <- return inl io_p3;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

main : F U loop i32 1 =
  io_run_0 : !(U gen i32 1 1 * i32 => i32 + U gen i32 1 1 * i32) <- return (!thunkv fun (io_a : U gen i32 1 1 * i32) ->
        let (io_it0, acc) = io_a;
        io_o <- (nu_out force io_it0).1;
        case io_o {
          inl io_p -> let (v, io_it0) = io_p;
            acc <- return (unbang host[add32]) (acc, v);
            io_u <- return ();
            return inr (io_it0, acc)
        | inr io_d -> case io_d {
              inl io_q -> io_v : i32 <- return acc;
                return inl io_v
            | inr io_it0 -> return inr (io_it0, acc)
            }
        });
  io_step : !U (U gen i32 1 1 * i32 -o F (i32 + U gen i32 1 1 * i32) & F 1) <- return (!thunkv fun (io_a : U gen i32 1 1 * i32) ->
        < return (unbang io_run_0) io_a,
          let (io_it0, acc) = io_a;
          io_c <- (nu_out force io_it0).2;
          return () >);
  io_mk : !(U gen i32 1 1 * i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U gen i32 1 1 * i32) ->
        io_f <- return unbang unfold[loop i32 1, U gen i32 1 1 * i32] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  acc <- return i32[0];
  io_it0 <- return (unbang pairs) i32[2];
  return (unbang io_mk) (io_it0, acc)
