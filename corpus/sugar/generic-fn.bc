-- A generic function with a surface body (typed elaboration §7, generic functions): `fn f[A]<'a>`
-- is a template, and `first[i32](v, 0)` is a call of its instance at `i32`, the body elaborated
-- at that type (`*g` reads an `i32`, which is persistent). The lifetime `'a` is the view's, read
-- off the argument, and the call needs no `unbang`. `generic-fn.core.bc` is the program written
-- by hand in core, as the library was before: a `def` with a type parameter, called at `[i32]`
-- and at the lifetime.
-- Answer: 10.
fn tab(i: i32) -> i32 = host[add32] (i, i32[10])

fn first[A]<'a>(v: array_imm 'a A, d: A) -> A =
  match array_get['a, A](v, i32[0]) { inl g -> *g | inr u -> d }

main -> i32 =
  let a = array_new[i32] (i32[3], tab);
  borrow imm a { 'x, v -> first[i32](v, i32[0]) }
