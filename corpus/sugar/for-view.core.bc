-- `for-view.bc` with `main` written by hand in core: the `for` is a `slice_borrow_mut` of `a`
-- around a counted loop; inside, the view's length `m` is read, the iterator `it` made, and
-- `count_fold` observes it at most `m + 1` times, with the state `(it or what it finished with,
-- n)`: an element runs the body, a skip goes on, a finish is kept. After the loop the iterator,
-- if it has not finished, is closed, and `n` is handed out of the block. The library functions
-- below are the instances of `lib/slice.bc` at `i32`, as `bcc desugar` prints them.
def true : 1 + 1 = inr ()

def tab : !(i32 => i32) =
  !thunkv fun (io_p0 : i32) ->
      i <- return io_p0;
      return (unbang host[add32]) (i, i32[1])

def len_mut : !(all 'a < top. array_mut 'a i32 => array_mut 'a i32 * i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p6 : array_mut 'a i32) ->
          v <- return io_p6;
          return (unbang slice_len_mut['a, i32]) v)

def split_at_mut : !(all 'a < top. array_mut 'a i32 * i32 => array_mut 'a i32 * array_mut 'a i32 + array_mut 'a i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p30 : array_mut 'a i32 * i32) ->
          let (v, i) = io_p30;
          return (unbang slice_split_mut['a, i32]) (v, i))

def get_mut : !(all 'a < top. array_mut 'a i32 * i32 => mut 'a i32 + 1) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p8 : array_mut 'a i32 * i32) ->
          let (v, i) = io_p8;
          return (unbang slice_get_mut['a, i32]) (v, i))

def discard_mut : !(all 'a < top. array_mut 'a i32 => 1) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p26 : array_mut 'a i32) ->
          v <- return io_p26;
          case (unbang get_mut) ['a] (v, (unbang host[sub32]) (i32[0], i32[1])) {
            inl m -> return forget_mut['a, i32] m
          | inr u -> return u
          })

def split_first_mut : !(all 'a < top. array_mut 'a i32 => mut 'a i32 * array_mut 'a i32 + 1) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p38 : array_mut 'a i32) ->
          v <- return io_p38;
          case (unbang split_at_mut) ['a] (v, i32[1]) {
            inl io_m37 -> let (h, t) = io_m37;
              case (unbang get_mut) ['a] (h, i32[0]) {
                inl e -> return inl (e, t)
              | inr u -> io_s35 <- return (unbang discard_mut) ['a] t;
                  return inr u
              }
          | inr w -> io_s36 <- return (unbang discard_mut) ['a] w;
              return inr ()
          })

def empty_mut : !(all 'a < top. 1 => array_mut 'a i32) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p28 : 1) ->
          let () = io_p28;
          return slice_empty_mut['a, i32])

def iter_mut : !(all 'a < top. array_mut 'a i32 => U gen (mut 'a i32) 1 1) =
  !thunkv Fun 'a < top.
      return (thunkv fun (io_p151 : array_mut 'a i32) ->
          io_run_2 : !(1 => mut 'a i32 * (array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) + 1 + array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) <- return (!thunkv fun (io_a : 1) ->
                let () = io_a;
                io_v : 1 <- return ();
                return inr inl io_v);
          io_run_1 : !(array_mut 'a i32 => mut 'a i32 * (array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) + 1 + array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) <- return (!thunkv fun (io_a : array_mut 'a i32) ->
                rest <- return io_a;
                case true {
                  inl io_f -> return (unbang io_run_2) ()
                | inr io_t -> case (unbang split_first_mut) ['a] rest {
                      inl io_m150 -> let (e, t) = io_m150;
                        rest <- return t;
                        return inl (e, inr inr rest)
                    | inr u -> rest <- return (unbang empty_mut) ['a] ();
                        return (unbang io_run_2) ()
                    }
                });
          io_step : !U (array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32 -o F (mut 'a i32 * (array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) + 1 + array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) & F 1) <- return (!thunkv fun (io_s : array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32) ->
                < case io_s {
                    inl io_a -> io_p151 <- return io_a;
                      v <- return io_p151;
                      rest <- return v;
                      return (unbang io_run_1) rest
                  | inr io_b0 -> case io_b0 {
                        inl io_a -> return (unbang io_run_1) io_a
                      | inr io_a -> rest <- return io_a;
                          io_y <- return ();
                          io_u <- return ();
                          return (unbang io_run_1) rest
                      }
                  },
                  case io_s {
                    inl io_a -> io_p151 <- return io_a;
                      v <- return io_p151;
                      rest <- return v;
                      return ()
                  | inr io_b0 -> case io_b0 {
                        inl io_a -> rest <- return io_a;
                          return ()
                      | inr io_a -> rest <- return io_a;
                          return ()
                      }
                  } >);
          io_f <- return unbang unfold[gen (mut 'a i32) 1 1, array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32] io_step;
          io_s0 : array_mut 'a i32 + array_mut 'a i32 + array_mut 'a i32 <- return inl io_p151;
          return (thunkv nu_in < (nu_out force io_f io_s0).1,
              (nu_out force io_f io_s0).2 >))

main : F i32 =
  a <- return (unbang array_new[i32]) (i32[3], tab);
  n <- return i32[0];
  r <- return slice_borrow_mut['x, top, i32, i32] a (thunkv Fun 'x < dom.
    return (thunkv fun (w : array_mut 'x i32) ->
      v <- return w;
      let (v, m) = (unbang len_mut) ['x] v;
      it <- return (unbang iter_mut) ['x] v;
      s <- return (unbang count_fold[(U (gen (mut 'x i32) 1 1) + 1) * i32]) (!thunkv fun (p : i32 * ((U (gen (mut 'x i32) 1 1) + 1) * i32)) ->
          let (k, q) = p;
          let (o, t) = q;
          n <- return t;
          case o {
            inl it ->
              e <- (nu_out (force it)).1;
              case e {
                inl y ->
                  let (x, it) = y;
                  b <- return withswap['x, i32, 1] x (thunkv fun (v : i32) ->
                    return ((unbang host[mul32]) (v, i32[10]), ()));
                  let (x, d) = b;
                  n <- return (unbang host[add32]) (n, i32[1]);
                  u <- return ();
                  return (inl it, n)
              | inr d ->
                  case d {
                    inl f -> return (inr f, n)
                  | inr it -> return (inl it, n)
                  }
              }
          | inr f -> return (inr f, n)
          }, ((unbang host[add32]) (m, i32[1]), (i32[0], (inl it, n))));
      let (o, t) = s;
      n <- return t;
      z <- case o {
        inl it -> (nu_out (force it)).2
      | inr f -> return f
      };
      return boxed['x] n));
  let (a, t) = r;
  n <- return t;
  return n
