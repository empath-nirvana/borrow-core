-- `div-nested.bc` in core (SPEC §14), as `bcc desugar` prints it. Each nested call of
-- `line_length` is bound before the application it is an argument of, in evaluation order, and is
-- a state of the body's machine (SPEC §15) holding its loop; `inc` of its result is bound after
-- it.

extern stdin : ref input

extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (u8 + 1))

type In = ref input

def getb : In => In * (u8 + 1) =
  thunkv fun (c : In) ->
      return withbor2['x, top, input, u8 + 1] c (thunkv Fun 'x < dom.
          return (thunkv fun (m : mut 'x input) ->
              r <- return (unbang read_byte) ['x] m;
              let (m2, b) = r;
              return boxed['x] b))

def ll_step : !U (In * i32 -o F (In * i32 + In * i32) & F (In * 1)) =
  !thunkv fun (s : In * i32) ->
      < let (c, n) = s;
        q <- return getb c;
        let (c2, x) = q;
        case x {
          inl b -> case (unbang host[eq32]) ((unbang host[extend8_u]) b, i32[10]) {
              inl u -> return inr (c2, (unbang host[add32]) (n, i32[1]))
            | inr u -> return inl (c2, n)
            }
        | inr u -> return inl (c2, n)
        },
        let (c, n) = s;
        return (c, ()) >

def line_length : In => U loop (In * i32) (In * 1) =
  thunkv fun (c : In) ->
      f <- return unbang unfold[loop (In * i32) (In * 1), In * i32] ll_step;
      s0 : In * i32 <- return (c, i32[0]);
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def inc : i32 => i32 =
  thunkv fun (n : i32) ->
      return (unbang host[add32]) (n, i32[1])

def two_lines : In => U loop (In * i32 * i32) (ref input * 1) =
  thunkv fun (c : In) ->
      io_run_1 : !(U loop (ref input * i32) (ref input * 1) * i32 => ref input * i32 * i32 + U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) <- return (!thunkv fun (io_a : U loop (ref input * i32) (ref input * 1) * i32) ->
            let (io_d1, io_n1) = io_a;
            io_o <- (nu_out force io_d1).1;
            case io_o {
              inl io_b -> let (c, io_n2) = io_b;
                io_n3 <- return inc io_n2;
                p <- return (io_n1, io_n3);
                io_v : ref input * i32 * i32 <- return (c, p);
                return inl io_v
            | inr io_d1 -> return inr inr (io_d1, io_n1)
            });
      io_run_0 : !(U loop (ref input * i32) (ref input * 1) => ref input * i32 * i32 + U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) <- return (!thunkv fun (io_a : U loop (ref input * i32) (ref input * 1)) ->
            io_d0 <- return io_a;
            io_o <- (nu_out force io_d0).1;
            case io_o {
              inl io_b -> let (c, io_n0) = io_b;
                io_n1 <- return inc io_n0;
                io_d1 <- return line_length c;
                return inr inr (io_d1, io_n1)
            | inr io_d0 -> return inr inl io_d0
            });
      io_step : !U (U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32 -o F (ref input * i32 * i32 + U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) & F (ref input * 1)) <- return (!thunkv fun (io_s : U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) ->
            < case io_s {
                inl io_a -> return (unbang io_run_0) io_a
              | inr io_a -> return (unbang io_run_1) io_a
              },
              case io_s {
                inl io_a -> io_d0 <- return io_a;
                  io_r <- (nu_out force io_d0).2;
                  let (c, io_ru) = io_r;
                  return (c, ())
              | inr io_a -> let (io_d1, io_n1) = io_a;
                  io_r <- (nu_out force io_d1).2;
                  let (c, io_ru) = io_r;
                  return (c, ())
              } >);
      io_mk : !(U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32 => U loop (ref input * i32 * i32) (ref input * 1)) <- return (!thunkv fun (io_s0 : U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) ->
            io_f <- return unbang unfold[loop (ref input * i32 * i32) (ref input * 1), U loop (ref input * i32) (ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32] io_step;
            return (thunkv nu_in < (nu_out force io_f io_s0).1,
                (nu_out force io_f io_s0).2 >));
      io_d0 <- return line_length c;
      return (unbang io_mk) (inl io_d0)

main : F U loop (ref input * i32 * i32) (ref input * 1) =
  io_run_0 : !(U loop (ref input * i32 * i32) (ref input * 1) => ref input * i32 * i32 + U loop (ref input * i32 * i32) (ref input * 1)) <- return (!thunkv fun (io_a : U loop (ref input * i32 * i32) (ref input * 1)) ->
        io_d0 <- return io_a;
        io_o <- (nu_out force io_d0).1;
        case io_o {
          inl io_b -> let (stdin, p) = io_b;
            io_v : ref input * i32 * i32 <- return (stdin, p);
            return inl io_v
        | inr io_d0 -> return inr io_d0
        });
  io_step : !U (U loop (ref input * i32 * i32) (ref input * 1) -o F (ref input * i32 * i32 + U loop (ref input * i32 * i32) (ref input * 1)) & F (ref input * 1)) <- return (!thunkv fun (io_a : U loop (ref input * i32 * i32) (ref input * 1)) ->
        < return (unbang io_run_0) io_a,
          io_d0 <- return io_a;
          io_r <- (nu_out force io_d0).2;
          let (stdin, io_ru) = io_r;
          return (stdin, ()) >);
  io_mk : !(U loop (ref input * i32 * i32) (ref input * 1) => U loop (ref input * i32 * i32) (ref input * 1)) <- return (!thunkv fun (io_s0 : U loop (ref input * i32 * i32) (ref input * 1)) ->
        io_f <- return unbang unfold[loop (ref input * i32 * i32) (ref input * 1), U loop (ref input * i32 * i32) (ref input * 1)] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  io_d0 <- return two_lines stdin;
  return (unbang io_mk) io_d0
