-- `div-nested.bc` in core (SPEC §14), as `bcc desugar` prints it. Each nested call of
-- `line_length` is bound before the application it is an argument of, in evaluation order, and is
-- a call at the row `div` whose `inr`, closed early, hands back `main`'s residual; `inc` of its
-- result is bound after it.
extern stdin : ref input

extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (u8 + 1))

type In = ref input

def getb : In => In * (u8 + 1) =
  thunkv fun (c : In) ->
      return withbor2['x, top, input, u8 + 1] c (thunkv Fun 'x < dom.
          return (thunkv fun (m : mut 'x input) ->
              r <- return (unbang read_byte) ['x] m;
              let (m2, b) = r;
              return boxed['x] b))

def ll_step : !U (In * i32 -o F (In * i32 + In * i32) & F (In * 1)) =
  !thunkv fun (s : In * i32) ->
      < let (c, n) = s;
        q <- return getb c;
        let (c2, x) = q;
        case x {
          inl b -> case (unbang host[eq32]) ((unbang host[extend8_u]) b, i32[10]) {
              inl u -> return inr (c2, (unbang host[add32]) (n, i32[1]))
            | inr u -> return inl (c2, n)
            }
        | inr u -> return inl (c2, n)
        },
        let (c, n) = s;
        return (c, ()) >

def line_length : In => U loop (In * i32) (In * 1) =
  thunkv fun (c : In) ->
      f <- return unbang unfold[loop (In * i32) (In * 1), In * i32] ll_step;
      s0 : In * i32 <- return (c, i32[0]);
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def inc : i32 => i32 =
  thunkv fun (n : i32) ->
      return (unbang host[add32]) (n, i32[1])

def two_lines : U (In -o F[div] (In * i32 * i32 + ref input * 1)) =
  thunkv fun (c : In) ->
      io_dl1 <- return line_length c;
      io_step9 : !U (U loop (ref input * i32) (ref input * 1) -o F[div] ((ref input * i32 + ref input * i32 * i32 + ref input * 1) + U loop (ref input * i32) (ref input * 1)) & F[div] (ref input * 1)) <- return (!thunkv fun (io_s9 : U loop (ref input * i32) (ref input * 1)) ->
            < io_dl1 <- return io_s9;
              io_o <- (nu_out force io_dl1).1;
              case io_o {
                inl io_jb1 -> return inl inl io_jb1
              | inr io_dl1 -> return inr io_dl1
              },
              io_dl1 <- return io_s9;
              io_r <- (nu_out force io_dl1).2;
              let (c, io_ru) = io_r;
              return (c, ()) >);
      io_s09 : U loop (ref input * i32) (ref input * 1) <- return io_dl1;
      io_x9 : (ref input * i32 + ref input * i32 * i32 + ref input * 1) + ref input * 1 <- (io_n9 <- perform[4294967295.0] ();
        case io_n9 {
          inl io_u -> io_it9 <- return unbang iterate[U loop (ref input * i32) (ref input * 1), ref input * i32 + ref input * i32 * i32 + ref input * 1, ref input * 1, [div]];
            io_p9 : !U (U loop (ref input * i32) (ref input * 1) -o F[div] ((ref input * i32 + ref input * i32 * i32 + ref input * 1) + U loop (ref input * i32) (ref input * 1)) & F[div] (ref input * 1)) * U loop (ref input * i32) (ref input * 1) <- return (io_step9, io_s09);
            force io_it9 io_p9
        | inr io_u -> io_sf9 <- return unbang io_step9;
            io_q9 <- force io_sf9 io_s09.2;
            return inr io_q9
        });
      case io_x9 {
        inl io_l9 -> case io_l9 {
            inl io_j1 -> io_jb1 <- return io_j1;
              let (c, io_n0) = io_jb1;
              io_n1 <- return inc io_n0;
              io_dl4 <- return line_length c;
              io_step8 : !U (U loop (ref input * i32) (ref input * 1) * i32 -o F[div] (((ref input * i32) * i32 + ref input * i32 * i32 + ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) & F[div] (ref input * 1)) <- return (!thunkv fun (io_s8 : U loop (ref input * i32) (ref input * 1) * i32) ->
                    < let (io_dl4, io_s8t) = io_s8;
                      io_n1 <- return io_s8t;
                      io_o <- (nu_out force io_dl4).1;
                      case io_o {
                        inl io_jb4 -> return inl inl (io_jb4, io_n1)
                      | inr io_dl4 -> return inr (io_dl4, io_n1)
                      },
                      let (io_dl4, io_s8t) = io_s8;
                      io_n1 <- return io_s8t;
                      io_r <- (nu_out force io_dl4).2;
                      let (c, io_ru) = io_r;
                      return (c, ()) >);
              io_s08 : U loop (ref input * i32) (ref input * 1) * i32 <- return (io_dl4, io_n1);
              io_x8 : ((ref input * i32) * i32 + ref input * i32 * i32 + ref input * 1) + ref input * 1 <- (io_n8 <- perform[4294967295.0] ();
                case io_n8 {
                  inl io_u -> io_it8 <- return unbang iterate[U loop (ref input * i32) (ref input * 1) * i32, (ref input * i32) * i32 + ref input * i32 * i32 + ref input * 1, ref input * 1, [div]];
                    io_p8 : !U (U loop (ref input * i32) (ref input * 1) * i32 -o F[div] (((ref input * i32) * i32 + ref input * i32 * i32 + ref input * 1) + U loop (ref input * i32) (ref input * 1) * i32) & F[div] (ref input * 1)) * U loop (ref input * i32) (ref input * 1) * i32 <- return (io_step8, io_s08);
                    force io_it8 io_p8
                | inr io_u -> io_sf8 <- return unbang io_step8;
                    io_q8 <- force io_sf8 io_s08.2;
                    return inr io_q8
                });
              case io_x8 {
                inl io_l8 -> case io_l8 {
                    inl io_j4 -> let (io_jb4, io_j4t) = io_j4;
                      io_n1 <- return io_j4t;
                      let (c, io_n2) = io_jb4;
                      io_n3 <- return inc io_n2;
                      p <- return (io_n1, io_n3);
                      return inl (c, p)
                  | inr io_a8 -> return io_a8
                  }
              | inr io_r8 -> return inr io_r8
              }
          | inr io_a9 -> return io_a9
          }
      | inr io_r9 -> return inr io_r9
      }

main : F U loop (ref input * i32 * i32) (ref input * 1) =
  return (unbang reify[ref input * i32 * i32, ref input * 1, []](!thunkv fun (io_b : ref input * i32 * i32) ->
        let (io_bw0, io_bwr) = io_b;
        return (io_bw0, ()))) (thunkv fun (io_u : 1) ->
      let () = io_u;
      io_d1 <- (io_fg0 <- return two_lines;
        io_fa0 <- return stdin;
        force io_fg0 io_fa0);
      case io_d1 {
        inl io_b -> let (stdin, p) = io_b;
          return inl (stdin, p)
      | inr io_r -> let (stdin, io_ru) = io_r;
          io_res3 <- return (stdin, ());
          return inr io_res3
      })
