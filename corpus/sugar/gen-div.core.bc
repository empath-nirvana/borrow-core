            return inr io_q9
        });
      case io_x9 {
        inl io_l9 -> case io_l9 {
            inl io_j5 -> io_jb5 <- return io_j5;
              io_j40_3 : i32 * 1 + i32 * 1 <- return io_jb5;
              io_jj40_3 : i32 * 1 <- case io_j40_3 {
                  inl io_ja40_3 -> let (io_jw40_3, io_jg40_3) = io_ja40_3;
                    return (io_jw40_3, ())
                | inr io_je40_3 -> let (io_jw40_3, io_jo40_3) = io_je40_3;
                    return (io_jw40_3, io_jo40_3)
                };
              let (io_jx40_3, io_v40_3) = io_jj40_3;
              acc <- return io_jx40_3;
              let () = io_v40_3;
              return inl acc
          | inr io_a9 -> return io_a9
          }
      | inr io_r9 -> return inr io_r9
      })
