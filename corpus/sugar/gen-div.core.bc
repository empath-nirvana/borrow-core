-- `gen-div.bc` in core, as `bcc desugar` prints it. The call of `collatz` is a state of the
-- generator's machine holding the loop: each observation observes the loop once, a skip until it
-- finishes, then binds `k` and yields it. Closed during the loop, the generator closes it and hands
-- back its residual, `()`.

def collatz_step : !U (i32 * i32 -o F (i32 + i32 * i32) & F 1) =
  !thunkv fun (s : i32 * i32) ->
      < let (n, k) = s;
        case (unbang host[eq32]) (n, i32[1]) {
          inl other -> k2 <- return (unbang host[add32]) (k, i32[1]);
            case (unbang host[eqz32]) ((unbang host[and32]) (n, i32[1])) {
              inl odd -> return inr ((unbang host[add32]) ((unbang host[mul32]) (n, i32[3]), i32[1]), k2)
            | inr even -> return inr ((unbang host[shr_u32]) (n, i32[1]), k2)
            }
        | inr one -> return inl k
        },
        let (n, k) = s;
        return () >

def collatz : i32 => U loop i32 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[loop i32 1, i32 * i32] collatz_step;
      s0 : i32 * i32 <- return (n, i32[0]);
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def steps : !(i32 => U gen i32 1 1) =
  !thunkv fun (io_p1 : i32) ->
      io_run_1 : !(U delay i32 => i32 * (i32 + U delay i32 + 1) + 1 + i32 + U delay i32 + 1) <- return (!thunkv fun (io_a : U delay i32) ->
            io_d1 <- return io_a;
            io_o <- (nu_out force io_d1).1;
            case io_o {
              inl io_b -> k <- return io_b;
                return inl (k, inr inr ())
            | inr io_d1 -> return inr inr inr inl io_d1
            });
      io_step : !U (i32 + U delay i32 + 1 -o F (i32 * (i32 + U delay i32 + 1) + 1 + i32 + U delay i32 + 1) & F 1) <- return (!thunkv fun (io_s : i32 + U delay i32 + 1) ->
            < case io_s {
                inl io_a -> io_p1 <- return io_a;
                  n <- return io_p1;
                  io_d1 <- return collatz n;
                  return (unbang io_run_1) io_d1
              | inr io_b0 -> case io_b0 {
                    inl io_a -> return (unbang io_run_1) io_a
                  | inr io_a -> let () = io_a;
                      io_s0 <- return ();
                      io_v : 1 <- return ();
                      return inr inl io_v
                  }
              },
              case io_s {
                inl io_a -> io_p1 <- return io_a;
                  n <- return io_p1;
                  return ()
              | inr io_b0 -> case io_b0 {
                    inl io_a -> io_d1 <- return io_a;
                      io_r <- (nu_out force io_d1).2;
                      let () = io_r;
                      return ()
                  | inr io_a -> let () = io_a;
                      return ()
                  }
              } >);
      io_f <- return unbang unfold[gen i32 1 1, i32 + U delay i32 + 1] io_step;
      io_s0 : i32 + U delay i32 + 1 <- return inl io_p1;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

main : F U loop i32 1 =
  io_run_0 : !(U gen i32 1 1 * i32 => i32 + U gen i32 1 1 * i32) <- return (!thunkv fun (io_a : U gen i32 1 1 * i32) ->
        let (io_it0, acc) = io_a;
        io_o <- (nu_out force io_it0).1;
        case io_o {
          inl io_p -> let (k, io_it0) = io_p;
            acc <- return (unbang host[add32]) (acc, k);
            io_u <- return ();
            return inr (io_it0, acc)
        | inr io_d -> case io_d {
              inl io_q -> io_v : i32 <- return acc;
                return inl io_v
            | inr io_it0 -> return inr (io_it0, acc)
            }
        });
  io_step : !U (U gen i32 1 1 * i32 -o F (i32 + U gen i32 1 1 * i32) & F 1) <- return (!thunkv fun (io_a : U gen i32 1 1 * i32) ->
        < return (unbang io_run_0) io_a,
          let (io_it0, acc) = io_a;
          io_c <- (nu_out force io_it0).2;
          return () >);
  io_mk : !(U gen i32 1 1 * i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U gen i32 1 1 * i32) ->
        io_f <- return unbang unfold[loop i32 1, U gen i32 1 1 * i32] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  acc <- return i32[0];
  io_it0 <- return (unbang steps) i32[27];
  return (unbang io_mk) (io_it0, acc)
