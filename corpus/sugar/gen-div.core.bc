-- The elaboration of `gen-div.bc` in core, as `bcc desugar` prints it: `steps` is a div function
-- at the row `div, Yield`, which calls `collatz`, a loop written in core, by draining its loop
-- with `iterate`; the `for` over it observes its loop value, `reify` of its call (SPEC §14, §15).
def collatz_step : !U (i32 * i32 -o F (i32 + i32 * i32) & F 1) =
  !thunkv fun (s : i32 * i32) ->
      < let (n, k) = s;
        case (unbang host[eq32]) (n, i32[1]) {
          inl other -> k2 <- return (unbang host[add32]) (k, i32[1]);
            case (unbang host[eqz32]) ((unbang host[and32]) (n, i32[1])) {
              inl odd -> return inr ((unbang host[add32]) ((unbang host[mul32]) (n, i32[3]), i32[1]), k2)
            | inr even -> return inr ((unbang host[shr_u32]) (n, i32[1]), k2)
            }
        | inr one -> return inl k
        },
        let (n, k) = s;
        return () >

def collatz : i32 => U loop i32 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[loop i32 1, i32 * i32] collatz_step;
      s0 : i32 * i32 <- return (n, i32[0]);
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def steps__n1__g0 : !U (i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] (i32 * 1 + 1)) =
  !thunkv fun (fx_pp1 : i32 * i32) ->
      let (fx_w1, n) = fx_pp1;
      io_dl1 <- return collatz n;
      io_step5 : !U (U delay i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 * i32 + i32 * 1 + 1) + U delay i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) <- return (!thunkv fun (io_s5 : U delay i32 * i32) ->
            < let (io_dl1, io_s5t) = io_s5;
              fx_w1 <- return io_s5t;
              io_o <- (nu_out force io_dl1).1;
              case io_o {
                inl io_jb1 -> return inl inl (io_jb1, fx_w1)
              | inr io_dl1 -> return inr (io_dl1, fx_w1)
              },
              let (io_dl1, io_s5t) = io_s5;
              fx_w1 <- return io_s5t;
              io_r <- (nu_out force io_dl1).2;
              let () = io_r;
              return () >);
      io_s05 : U delay i32 * i32 <- return (io_dl1, fx_w1);
      io_x5 : (i32 * i32 + i32 * 1 + 1) + 1 <- (io_iter5 <- return unbang iterate[U delay i32 * i32, i32 * i32 + i32 * 1 + 1, 1, [div, 1.0 aff i32 * i32 ~> i32]];
        io_p5 : !U (U delay i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 * i32 + i32 * 1 + 1) + U delay i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) * U delay i32 * i32 <- return (io_step5, io_s05);
        force io_iter5 io_p5);
      case io_x5 {
        inl io_l5 -> case io_l5 {
            inl io_j1 -> let (io_jb1, io_j1t) = io_j1;
              fx_w1 <- return io_j1t;
              k <- return io_jb1;
              fx_w1 <- perform[1.0] (k, fx_w1);
              io_s0 <- return ();
              return inl (fx_w1, ())
          | inr io_a5 -> return io_a5
          }
      | inr io_r5 -> return inr io_r5
      }

def steps__n1__g0__close : !U (i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] 1) =
  !thunkv fun (fx_pp1 : i32 * i32) ->
      let (fx_w1, n) = fx_pp1;
      return ()

main : F U loop i32 1 =
  return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
        return ())) (thunkv fun (io_u : 1) ->
      let () = io_u;
      acc <- return i32[0];
      fx_w1 : i32 <- return acc;
      io_l40_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) <- return (thunkv nu_in < io_rl40_3 <- (io_rf40_3 <- return unbang reify[i32 * 1, 1, [1.0 aff i32 * i32 ~> i32]](!thunkv fun (io_b : i32 * 1) ->
                      return ());
              io_rt40_3 : U (1 -o F[div, 1.0 aff i32 * i32 ~> i32] (i32 * 1 + 1)) <- return (thunkv fun (io_u : 1) ->
                    let () = io_u;
                    io_si40_3 <- return unbang iterate[i32 * i32 + i32 * i32, i32 * 1 + 1, 1, [div, 1.0 aff i32 * i32 ~> i32]];
                    io_sp040_3 : !U (i32 * i32 + i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 * 1 + 1) + i32 * i32 + i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) * (i32 * i32 + i32 * i32) <- return (!thunkv fun (io_ss40_3 : i32 * i32 + i32 * i32) ->
                          < case io_ss40_3 {
                              inl io_sp40_3 -> return inr inr io_sp40_3
                            | inr io_sp40_3 -> io_sx40_3 <- (io_fgs40_3 <- return unbang steps__n1__g0;
                                  io_fas40_3 <- return io_sp40_3;
                                  force io_fgs40_3 io_fas40_3);
                                return inl io_sx40_3
                            },
                            case io_ss40_3 {
                              inl io_sp40_3 -> io_fgc40_3 <- return unbang steps__n1__g0__close;
                                io_fac40_3 <- return io_sp40_3;
                                force io_fgc40_3 io_fac40_3
                            | inr io_sp40_3 -> io_fgd40_3 <- return unbang steps__n1__g0__close;
                                io_fad40_3 <- return io_sp40_3;
                                force io_fgd40_3 io_fad40_3
                            } >, inl (fx_w1, i32[27]));
                    io_sr40_3 <- force io_si40_3 io_sp040_3;
                    case io_sr40_3 {
                      inl io_sa -> return io_sa
                    | inr io_sq -> return inr io_sq
                    });
              force io_rf40_3 io_rt40_3);
            (nu_out force io_rl40_3).1,
            io_fge40_3 <- return unbang steps__n1__g0__close;
            io_fae40_3 <- return (fx_w1, i32[27]);
            force io_fge40_3 io_fae40_3 >);
      io_hwf40_3 : !(U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) => U loop (i32 * 1 + i32 * 1) 1) <- return (!thunkv fun (io_hl40_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
            io_hf40_3 <- return unbang unfold[loop (i32 * 1 + i32 * 1) 1, U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)] (!thunkv fun (io_hs40_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
                  < handle_with[1](((!thunkv fun (io_hv40_3 : i32 * 1 + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
                          case io_hv40_3 {
                            inl io_ha40_3 -> return inl inl io_ha40_3
                          | inr io_hl40_3 -> return inr io_hl40_3
                          }) : !U (i32 * 1 + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)))), ((!thunkv fun (io_hp40_3 : (i32 * i32) * U ((i32 -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) & F 1)) ->
                          let (io_hxw40_3, io_k40_3) = io_hp40_3;
                          let (k, io_hw40_3) = io_hxw40_3;
                          acc <- return io_hw40_3;
                          acc <- return (unbang host[add32]) (acc, k);
                          io_wv40_3 <- return acc;
                          force io_k40_3.1 io_wv40_3, ()) : !U ((i32 * i32) * U ((i32 -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) & F 1) -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) * 1)) (nu_out force io_hs40_3).1,
                    handle_with[1](((!thunkv fun (io_cv40_3 : 1) ->
                          return io_cv40_3) : !U (1 -o F 1)), ((!thunkv fun (io_cp40_3 : (i32 * i32) * U ((i32 -o F 1) & F 1)) ->
                          let (io_cxw40_3, io_ck40_3) = io_cp40_3;
                          let (io_cx40_3, io_cw40_3) = io_cxw40_3;
                          force io_ck40_3.1 io_cw40_3, ()) : !U ((i32 * i32) * U ((i32 -o F 1) & F 1) -o F 1) * 1)) (nu_out force io_hs40_3).2 >);
            return (thunkv nu_in < (nu_out force io_hf40_3 io_hl40_3).1,
                (nu_out force io_hf40_3 io_hl40_3).2 >));
      io_dl5 <- return (unbang io_hwf40_3) io_l40_3;
      io_step9 : !U (U delay (i32 * 1 + i32 * 1) -o F[div] (((i32 * 1 + i32 * 1) + i32 + 1) + U delay (i32 * 1 + i32 * 1)) & F[div] 1) <- return (!thunkv fun (io_s9 : U delay (i32 * 1 + i32 * 1)) ->
            < io_dl5 <- return io_s9;
              io_o <- (nu_out force io_dl5).1;
              case io_o {
                inl io_jb5 -> return inl inl io_jb5
              | inr io_dl5 -> return inr io_dl5
