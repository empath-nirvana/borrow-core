-- The elaboration of `gen-div.bc` in core, as `bcc desugar` prints it.

def collatz_step : !U (i32 * i32 -o F (i32 + i32 * i32) & F 1) =
  !thunkv fun (s : i32 * i32) ->
      < let (n, k) = s;
        case (unbang host[eq32]) (n, i32[1]) {
          inl other -> k2 <- return (unbang host[add32]) (k, i32[1]);
            case (unbang host[eqz32]) ((unbang host[and32]) (n, i32[1])) {
              inl odd -> return inr ((unbang host[add32]) ((unbang host[mul32]) (n, i32[3]), i32[1]), k2)
            | inr even -> return inr ((unbang host[shr_u32]) (n, i32[1]), k2)
            }
        | inr one -> return inl k
        },
        let (n, k) = s;
        return () >

def collatz : i32 => U loop i32 1 =
  thunkv fun (n : i32) ->
      f <- return unbang unfold[loop i32 1, i32 * i32] collatz_step;
      s0 : i32 * i32 <- return (n, i32[0]);
      return (thunkv nu_in < (nu_out force f s0).1,
          (nu_out force f s0).2 >)

def steps__n1__g0 : !(i32 * i32 => U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1)) =
  !thunkv fun (fx_pp1 : i32 * i32) ->
      io_run_1 : !U (U delay i32 * i32 -o F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + i32 * i32 + U delay i32 * i32)) <- return (!thunkv fun (io_a : U delay i32 * i32) ->
            let (io_d1, fx_w1) = io_a;
            io_o <- (nu_out force io_d1).1;
            case io_o {
              inl io_b -> k <- return io_b;
                fx_w1 <- perform[1.0] (k, fx_w1);
                io_s0 <- return ();
                return inl (fx_w1, ())
            | inr io_d1 -> return inr inr (io_d1, fx_w1)
            });
      io_step : !U (i32 * i32 + U delay i32 * i32 -o F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + i32 * i32 + U delay i32 * i32) & F[1.0 cancel i32 * i32 ~> i32] 1) <- return (!thunkv fun (io_s : i32 * i32 + U delay i32 * i32) ->
            < case io_s {
                inl io_a -> fx_pp1 <- return io_a;
                  let (fx_w1, n) = fx_pp1;
                  io_d1 <- return collatz n;
                  io_rf1 <- return unbang io_run_1;
                  io_ra1 <- return (io_d1, fx_w1);
                  force io_rf1 io_ra1
              | inr io_a -> io_rf <- return unbang io_run_1;
                  force io_rf io_a
              },
              case io_s {
                inl io_a -> fx_pp1 <- return io_a;
                  let (fx_w1, n) = fx_pp1;
                  return ()
              | inr io_a -> let (io_d1, fx_w1) = io_a;
                  io_r <- (nu_out force io_d1).2;
                  let () = io_r;
                  return ()
              } >);
      io_f <- return unbang unfold[nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1, i32 * i32 + U delay i32 * i32] io_step;
      io_s0 : i32 * i32 + U delay i32 * i32 <- return inl fx_pp1;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

main : F U loop i32 1 =
  io_step : !U (U delay (i32 * 1 + i32 * 1) -o F (i32 + U delay (i32 * 1 + i32 * 1)) & F 1) <- return (!thunkv fun (io_a : U delay (i32 * 1 + i32 * 1)) ->
        < io_d0 <- return io_a;
          io_o <- (nu_out force io_d0).1;
          case io_o {
            inl io_b -> io_j40_3 : i32 * 1 + i32 * 1 <- return io_b;
              io_jj40_3 : i32 * 1 <- case io_j40_3 {
                  inl io_ja40_3 -> let (io_jw40_3, io_jg40_3) = io_ja40_3;
                    return (io_jw40_3, ())
                | inr io_je40_3 -> let (io_jw40_3, io_jo40_3) = io_je40_3;
                    return (io_jw40_3, io_jo40_3)
                };
              let (io_jx40_3, io_v40_3) = io_jj40_3;
              acc <- return io_jx40_3;
              let () = io_v40_3;
              return inl acc
          | inr io_d0 -> return inr io_d0
          },
          io_d0 <- return io_a;
          io_r <- (nu_out force io_d0).2;
          let () = io_r;
          return () >);
  acc <- return i32[0];
  fx_w1 : i32 <- return acc;
  io_l40_3 : U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1) <- return (unbang steps__n1__g0) (fx_w1, i32[27]);
  io_hwf40_3 : !(U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1) => U loop (i32 * 1 + i32 * 1) 1) <- return (!thunkv fun (io_hl40_3 : U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1)) ->
        io_hf40_3 <- return unbang unfold[loop (i32 * 1 + i32 * 1) 1, U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1)] (!thunkv fun (io_hs40_3 : U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1)) ->
              < handle_with[1](((!thunkv fun (io_hv40_3 : i32 * 1 + U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1)) ->
                      case io_hv40_3 {
                        inl io_ha40_3 -> return inl inl io_ha40_3
                      | inr io_hl40_3 -> return inr io_hl40_3
                      }) : !U (i32 * 1 + U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1) -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1)))), ((!thunkv fun (io_hp40_3 : (i32 * i32) * U ((i32 -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1))) & F 1)) ->
                      let (io_hxw40_3, io_k40_3) = io_hp40_3;
                      let (k, io_hw40_3) = io_hxw40_3;
                      acc <- return io_hw40_3;
                      acc <- return (unbang host[add32]) (acc, k);
                      io_wv40_3 <- return acc;
                      force io_k40_3.1 io_wv40_3, ()) : !U ((i32 * i32) * U ((i32 -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1))) & F 1) -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 cancel i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 cancel i32 * i32 ~> i32] 1))) * 1)) (nu_out force io_hs40_3).1,
                handle_with[1](((!thunkv fun (io_cv40_3 : 1) ->
                      return io_cv40_3) : !U (1 -o F 1)), ((!thunkv fun (io_cp40_3 : (i32 * i32) * U ((i32 -o F 1) & F 1)) ->
                      let (io_cxw40_3, io_ck40_3) = io_cp40_3;
                      let (io_cx40_3, io_cw40_3) = io_cxw40_3;
                      force io_ck40_3.1 io_cw40_3, ()) : !U ((i32 * i32) * U ((i32 -o F 1) & F 1) -o F 1) * 1)) (nu_out force io_hs40_3).2 >);
        return (thunkv nu_in < (nu_out force io_hf40_3 io_hl40_3).1,
            (nu_out force io_hf40_3 io_hl40_3).2 >));
  io_d0 <- return (unbang io_hwf40_3) io_l40_3;
  io_f <- return unbang unfold[loop i32 1, U delay (i32 * 1 + i32 * 1)] io_step;
  io_s0 : U delay (i32 * 1 + i32 * 1) <- return io_d0;
  return (thunkv nu_in < (nu_out force io_f io_s0).1,
      (nu_out force io_f io_s0).2 >)
