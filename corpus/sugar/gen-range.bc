-- A generator that is one loop (`lib/gen.bc`): `range` is the `unfold` of one step function,
-- whose first state is the parameters and whose other states are the loop's variables before
-- an iteration, or the body's rest after a `yield`, with the loop's variables inside it.
-- Observing the first state runs the code before the loop and the loop's head (`head`): the
-- condition, then the body up to its first observation. When the body's rest finishes an
-- iteration without yielding, the next observation starts the next one at once, so every
-- observation yields until the loop ends. `gen-range.core.bc` is the program written by hand
-- in core.
-- Answer: i32[55].

gen fn range(lo: i32, hi: i32) -> i32 =
  let mut i = lo;
  while i < hi { yield i; i = i + 1 };
  ()

main -> i32 =
  let mut acc = 0;
  for x in range(1, 11) { acc = acc + x };
  acc
