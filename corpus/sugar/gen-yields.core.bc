-- The elaboration of `gen-yields.bc` in core, as `bcc desugar` prints it.

def produce__n1__g0 : !U (i32 * 1 -o F[1.0 aff i32 * i32 ~> i32] (i32 * 1)) =
  !thunkv fun (fx_pp3 : i32 * 1) ->
      let (fx_w1, io_p2) = fx_pp3;
      let () = io_p2;
      fx_w1 <- perform[1.0] (i32[1], fx_w1);
      io_s1 <- return ();
      fx_w1 <- perform[1.0] (i32[4], fx_w1);
      io_s0 <- return ();
      fx_w1 <- perform[1.0] (i32[9], fx_w1);
      return (fx_w1, ())

main : F i32 =
  acc <- return i32[0];
  fx_w1 : i32 <- return acc;
  io_j16_3 : i32 * 1 + i32 * 1 <- handle_with[1](
      ((!thunkv fun (io_hv16_3 : i32 * 1) ->
        return inl io_hv16_3) : !U (i32 * 1 -o F (i32 * 1 + i32 * 1))),
      ((!thunkv fun (io_hp16_3 : (i32 * i32) * U ((i32 -o F (i32 * 1 + i32 * 1)) & F 1)) ->
        let (io_hxw16_3, io_k16_3) = io_hp16_3;
        let (x, io_hw16_3) = io_hxw16_3;
        acc <- return io_hw16_3;
        acc <- return (unbang host[add32]) (acc, x);
        io_u <- return ();
        io_wv16_3 <- return acc;
        force io_k16_3.1 io_wv16_3, ()) : !U ((i32 * i32) * U ((i32 -o F (i32 * 1 + i32 * 1)) & F 1) -o F (i32 * 1 + i32 * 1)) * 1)) (io_fg16_3 <- return unbang produce__n1__g0;
    io_fa16_3 <- return (fx_w1, ());
    force io_fg16_3 io_fa16_3);
  io_jj16_3 : i32 * 1 <- case io_j16_3 {
      inl io_ja16_3 -> let (io_jw16_3, io_jg16_3) = io_ja16_3;
        return (io_jw16_3, ())
    | inr io_je16_3 -> let (io_jw16_3, io_jo16_3) = io_je16_3;
        return (io_jw16_3, io_jo16_3)
    };
  let (io_jx16_3, io_v16_3) = io_jj16_3;
  acc <- return io_jx16_3;
  let () = io_v16_3;
  return acc
