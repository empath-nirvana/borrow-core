-- `gen-yields.bc` in core, as `bcc desugar` prints it. The generator is one state machine with a
-- state before it starts and one after each `yield`: each observation runs to the next `yield`.
-- The `for` is the loop of SPEC §14 over it; a skip goes round the loop, and at the end the loop
-- finishes with the sum.

def produce : !(1 => U gen i32 1 1) =
  !thunkv fun (io_p2 : 1) ->
      io_step : !U (1 + 1 + 1 + 1 -o F (i32 * (1 + 1 + 1 + 1) + 1 + 1 + 1 + 1 + 1) & F 1) <- return (!thunkv fun (io_s : 1 + 1 + 1 + 1) ->
            < case io_s {
                inl io_a -> io_p2 <- return io_a;
                  let () = io_p2;
                  return inl (i32[1], inr inl ())
              | inr io_b0 -> case io_b0 {
                    inl io_a -> let () = io_a;
                      io_s1 <- return ();
                      return inl (i32[4], inr inr inl ())
                  | inr io_b1 -> case io_b1 {
                        inl io_a -> let () = io_a;
                          io_s0 <- return ();
                          return inl (i32[9], inr inr inr ())
                      | inr io_a -> let () = io_a;
                          io_y <- return ();
                          io_v : 1 <- return ();
                          return inr inl io_v
                      }
                  }
              },
              case io_s {
                inl io_a -> io_p2 <- return io_a;
                  let () = io_p2;
                  return ()
              | inr io_b0 -> case io_b0 {
                    inl io_a -> let () = io_a;
                      return ()
                  | inr io_b1 -> case io_b1 {
                        inl io_a -> let () = io_a;
                          return ()
                      | inr io_a -> let () = io_a;
                          return ()
                      }
                  }
              } >);
      io_f <- return unbang unfold[gen i32 1 1, 1 + 1 + 1 + 1] io_step;
      io_s0 : 1 + 1 + 1 + 1 <- return inl io_p2;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

main : F U loop i32 1 =
  io_run_0 : !(U gen i32 1 1 * i32 => i32 + U gen i32 1 1 * i32) <- return (!thunkv fun (io_a : U gen i32 1 1 * i32) ->
        let (io_it0, acc) = io_a;
        io_o <- (nu_out force io_it0).1;
        case io_o {
          inl io_p -> let (x, io_it0) = io_p;
            acc <- return (unbang host[add32]) (acc, x);
            io_u <- return ();
            return inr (io_it0, acc)
        | inr io_d -> case io_d {
              inl io_q -> io_v : i32 <- return acc;
                return inl io_v
            | inr io_it0 -> return inr (io_it0, acc)
            }
        });
  io_step : !U (U gen i32 1 1 * i32 -o F (i32 + U gen i32 1 1 * i32) & F 1) <- return (!thunkv fun (io_a : U gen i32 1 1 * i32) ->
        < return (unbang io_run_0) io_a,
          let (io_it0, acc) = io_a;
          io_c <- (nu_out force io_it0).2;
          return () >);
  io_mk : !(U gen i32 1 1 * i32 => U loop i32 1) <- return (!thunkv fun (io_s0 : U gen i32 1 1 * i32) ->
        io_f <- return unbang unfold[loop i32 1, U gen i32 1 1 * i32] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  acc <- return i32[0];
  io_it0 <- return (unbang produce) ();
  return (unbang io_mk) (io_it0, acc)
