-- A `let mut` live across a control operation that captures its continuation and resumes it
-- (`await`'s shape, under a handler that resumes at once). `mut-await.core.bc` is its elaboration,
-- written by hand.
-- Answer: i32[111].
effect Pause { ctl pause() }

handler resuming[A]: Pause, A -> A = { return(a) = a; pause(k) = k(()) }

fn ticker(tag: i32) -> i32 with Pause =
  let mut acc = tag;
  pause();
  acc = acc * 10 + tag;
  pause();
  acc * 10 + tag

main -> i32 = with resuming { ticker(1) }
