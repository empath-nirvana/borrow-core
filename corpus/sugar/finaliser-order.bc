-- The order of the consume glue's consumes (SPEC §12, §19): two owned cells, `c` bound before `d`,
-- are live across a call that may abort. The checker binds the call by `[then]` with a finaliser
-- it inserts, which consumes them in reverse binding order, `d` first, as the consumes at the end
-- of a path do. `finaliser-order.core.bc` writes that finaliser out, `d`'s consume first; the two
-- checked `main`s erase to the same term.
def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 cancel i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

def use_cells : !U (i32 -o F[1.0 cancel i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    c <- return (alloc[i32] i32[3]);
    d <- return (alloc[i32] i32[4]);
    f <- return (unbang check);
    v <- force f a;
    y <- return (free[i32] d);
    x <- return (free[i32] c);
    return (plus (v, plus (x, y)))

main : F (i32 + i32) =
  b <- return i32[0];
  handle_with[1](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (g <- return (unbang use_cells); force g b)
