-- `residual-alias.bc` in core (SPEC §14), as `bcc desugar` prints it. `count` is a div function
-- whose residual is `Src * 1`: closed early, it closes the stream and hands back the capability
-- the stream hands back. Its loop is `iterate` over the stream and the count.
extern stdin : ref input

extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (u8 + 1))

type Src = ref input

def getb : Src => Src * (u8 + 1) =
  thunkv fun (c : Src) ->
      return withbor2['x, top, input, u8 + 1] c (thunkv Fun 'x < dom.
          return (thunkv fun (m : mut 'x input) ->
              r <- return (unbang read_byte) ['x] m;
              let (m2, b) = r;
              return boxed['x] b))

def src_step : !U (Src -o F (u8 * Src + Src) & F Src) =
  !thunkv fun (c : Src) ->
      < q <- return getb c;
        let (c2, x) = q;
        case x {
          inl b -> return inl (b, c2)
        | inr u -> return inr c2
        },
        return c >

def src_bytes : Src => U iter u8 Src Src =
  thunkv fun (c : Src) ->
      f <- return unbang unfold[iter u8 Src Src, Src] src_step;
      return (thunkv nu_in < (nu_out force f c).1,
          (nu_out force f c).2 >)

def count : U (Src -o F[div] (Src * i32 + ref input * 1)) =
  thunkv fun (c : Src) ->
      n <- return i32[0];
      io_src1 <- return src_bytes c;
      io_step5 : !U (U iter u8 (ref input) (ref input) * i32 -o F[div] ((ref input * i32 + ref input * i32 + ref input * 1) + U iter u8 (ref input) (ref input) * i32) & F[div] (ref input * 1)) <- return (!thunkv fun (io_s5 : U iter u8 (ref input) (ref input) * i32) ->
            < let (io_src1, io_s5t) = io_s5;
              n <- return io_s5t;
              io_o <- (nu_out force io_src1).1;
              case io_o {
                inl io_p -> let (b, io_src1) = io_p;
                  n <- return (unbang host[add32]) (n, i32[1]);
                  return inr (io_src1, n)
              | inr io_d -> io_q <- return io_d;
                  c <- return io_q;
                  return inl inl (c, n)
              },
              let (io_src1, io_s5t) = io_s5;
              n <- return io_s5t;
              io_c <- (nu_out force io_src1).2;
              c <- return io_c;
              return (c, ()) >);
      io_s05 : U iter u8 (ref input) (ref input) * i32 <- return (io_src1, n);
      io_x5 : (ref input * i32 + ref input * i32 + ref input * 1) + ref input * 1 <- (io_n5 <- perform[4294967295.0] ();
        case io_n5 {
          inl io_u -> io_it5 <- return unbang iterate[U iter u8 (ref input) (ref input) * i32, ref input * i32 + ref input * i32 + ref input * 1, ref input * 1, [div]];
            io_p5 : !U (U iter u8 (ref input) (ref input) * i32 -o F[div] ((ref input * i32 + ref input * i32 + ref input * 1) + U iter u8 (ref input) (ref input) * i32) & F[div] (ref input * 1)) * U iter u8 (ref input) (ref input) * i32 <- return (io_step5, io_s05);
            force io_it5 io_p5
        | inr io_u -> io_sf5 <- return unbang io_step5;
            io_q5 <- force io_sf5 io_s05.2;
            return inr io_q5
        });
      case io_x5 {
        inl io_l5 -> case io_l5 {
            inl io_j1 -> let (c, io_j1t) = io_j1;
              n <- return io_j1t;
              return inl (c, n)
          | inr io_a5 -> return io_a5
          }
      | inr io_r5 -> return inr io_r5
      }

main : F U loop (ref input * i32) (ref input * 1) =
  return (unbang reify[ref input * i32, ref input * 1, []](!thunkv fun (io_b : ref input * i32) ->
        let (io_bw0, io_bwr) = io_b;
        return (io_bw0, ()))) (thunkv fun (io_u : 1) ->
      let () = io_u;
      io_d1 <- (io_fg0 <- return count;
        io_fa0 <- return stdin;
        force io_fg0 io_fa0);
      case io_d1 {
        inl io_b -> let (stdin, r) = io_b;
          return inl (stdin, r)
      | inr io_r -> let (stdin, io_ru) = io_r;
          io_res3 <- return (stdin, ());
          return inr io_res3
      })
