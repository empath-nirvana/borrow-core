-- A loop-invariant borrow: `let tb = &t` borrows the table for the rest of `main`,
-- the borrow block `borrow imm t { tb -> … }`; `get(tb, i)` takes its lifetime from `tb`.
--
-- The lend spans the loop's ticks, which the kernel admits at the graded row `div call`
-- (SPEC §63). The loop reads the borrow `tb` at each turn, so its state threads it and
-- each turn uses it again: the checker copies the `imm` borrow for each use (`copy`,
-- SPEC §66), and the copy left at the end is dropped (`forget_imm`).
--
-- Answer: `i32[100]`, `live 0`: the entries at 4, 3, 2, 1 of 10 * i.

def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

def tab : !(i32 => i32) = !thunkv fun (i : i32) -> return ((unbang host[mul32]) (i, i32[10]))

-- The numbers from `n` down to 1.
def down : i32 => U (iter i32 1 1) =
  thunkv fun (n : i32) ->
    f <- return (unbang (unfold[iter i32 1 1, i32] (!thunkv fun (k : i32) ->
      < case (unbang host[eqz32]) k {
          inl nz -> return (inl (k, (unbang host[sub32]) (k, i32[1])))
        | inr z -> return (inr ())
        },
        return () >)));
    return (thunkv nu_in < (nu_out (force f n)).1, (nu_out (force f n)).2 >)

main -> i32 =
  let t = alloc(array_new[i32] (10, tab));
  let tb = &t;
  let mut acc = 0;
  for i in down(4) { acc = acc + get(tb, i) };
  acc
