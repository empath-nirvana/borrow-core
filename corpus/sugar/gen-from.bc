-- Delegation: `around` yields 0, then everything `two` yields, then what `two` returned. A call
-- of a generator passes on what it yields: `two`'s copy is made for the site `around`'s is.
-- `gen-from.core.bc` is its elaboration in core, as `bcc desugar` prints it.
-- Answer: i32[1256]: the elements 0, 1, 2, 5 read as digits, then `around`'s value 6.

include yield

fn two() -> i32 with Yield[i32] =
  yield(1);
  yield(2);
  5

fn around() -> i32 with Yield[i32] =
  yield(0);
  let n = two();
  yield(n);
  n + 1

main -> i32 =
  let mut acc = 0;
  let r = for x in around() { acc = acc * 10 + x };
  acc * 10 + r
