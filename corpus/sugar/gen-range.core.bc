-- The elaboration of `gen-range.bc` in core, as `bcc desugar` prints it.

def range__n1__g0 : !(i32 * i32 * i32 => U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) =
  !thunkv fun (fx_pp1 : i32 * i32 * i32) ->
      io_run_1 : !U (i32 * i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + i32 * i32 * i32 + i32 * i32 * i32)) <- return (!thunkv fun (io_a : i32 * i32 * i32) ->
            let (fx_w1, io_a_t) = io_a;
            let (hi, i) = io_a_t;
            case (unbang host[lt_s32]) (i, hi) {
              inl io_f -> io_v : i32 * 1 <- return (fx_w1, ());
                return inl io_v
            | inr io_t -> fx_w1 <- perform[1.0] (i, fx_w1);
                io_s0 <- return ();
                i <- return (unbang host[add32]) (i, i32[1]);
                io_u <- return ();
                return inr inr (fx_w1, (hi, i))
            });
      io_step : !U (i32 * i32 * i32 + i32 * i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + i32 * i32 * i32 + i32 * i32 * i32) & F[1.0 aff i32 * i32 ~> i32] 1) <- return (!thunkv fun (io_s : i32 * i32 * i32 + i32 * i32 * i32) ->
            < case io_s {
                inl io_a -> fx_pp1 <- return io_a;
                  let (fx_w1, io_p1) = fx_pp1;
                  let (lo, hi) = io_p1;
                  i <- return lo;
                  io_rf1 <- return unbang io_run_1;
                  io_ra1 <- return (fx_w1, (hi, i));
                  force io_rf1 io_ra1
              | inr io_a -> io_rf <- return unbang io_run_1;
                  force io_rf io_a
              },
              case io_s {
                inl io_a -> fx_pp1 <- return io_a;
                  let (fx_w1, io_p1) = fx_pp1;
                  let (lo, hi) = io_p1;
                  i <- return lo;
                  return ()
              | inr io_a -> let (fx_w1, io_a_t) = io_a;
                  let (hi, i) = io_a_t;
                  return ()
              } >);
      io_f <- return unbang unfold[nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1, i32 * i32 * i32 + i32 * i32 * i32] io_step;
      io_s0 : i32 * i32 * i32 + i32 * i32 * i32 <- return inl fx_pp1;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

main : F U loop i32 1 =
  io_run_0 : !U (U delay (i32 * 1 + i32 * 1) -o F (i32 + U delay (i32 * 1 + i32 * 1))) <- return (!thunkv fun (io_a : U delay (i32 * 1 + i32 * 1)) ->
        io_d0 <- return io_a;
        io_o <- (nu_out force io_d0).1;
        case io_o {
          inl io_b -> io_j19_3 : i32 * 1 + i32 * 1 <- return io_b;
            io_jj19_3 : i32 * 1 <- case io_j19_3 {
                inl io_ja19_3 -> let (io_jw19_3, io_jg19_3) = io_ja19_3;
                  return (io_jw19_3, ())
              | inr io_je19_3 -> let (io_jw19_3, io_jo19_3) = io_je19_3;
                  return (io_jw19_3, io_jo19_3)
              };
            let (io_jx19_3, io_v19_3) = io_jj19_3;
            acc <- return io_jx19_3;
            let () = io_v19_3;
            io_v : i32 <- return acc;
            return inl io_v
        | inr io_d0 -> return inr io_d0
        });
  io_step : !U (U delay (i32 * 1 + i32 * 1) -o F (i32 + U delay (i32 * 1 + i32 * 1)) & F 1) <- return (!thunkv fun (io_a : U delay (i32 * 1 + i32 * 1)) ->
        < return (unbang io_run_0) io_a,
          io_d0 <- return io_a;
          io_r <- (nu_out force io_d0).2;
          let () = io_r;
          return () >);
  io_mk : !(U delay (i32 * 1 + i32 * 1) => U loop i32 1) <- return (!thunkv fun (io_s0 : U delay (i32 * 1 + i32 * 1)) ->
        io_f <- return unbang unfold[loop i32 1, U delay (i32 * 1 + i32 * 1)] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  acc <- return i32[0];
  fx_w1 : i32 <- return acc;
  io_l19_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) <- return (unbang range__n1__g0) (fx_w1, (i32[1], i32[11]));
  io_hwf19_3 : !(U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) => U loop (i32 * 1 + i32 * 1) 1) <- return (!thunkv fun (io_hl19_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
        io_hf19_3 <- return unbang unfold[loop (i32 * 1 + i32 * 1) 1, U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)] (!thunkv fun (io_hs19_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
              < io_hr19_3 : !U (i32 * 1 + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) <- return (!thunkv fun (io_hv19_3 : i32 * 1 + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
                      case io_hv19_3 {
                        inl io_ha19_3 -> return inl inl io_ha19_3
                      | inr io_hl19_3 -> return inr io_hl19_3
                      });
                io_hc19_3 : !U ((i32 * i32) * U ((i32 -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) & F 1) -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) * 1 <- return (!thunkv fun (io_hp19_3 : (i32 * i32) * U ((i32 -o F ((i32 * 1 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * 1 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) & F 1)) ->
                      let (io_hxw19_3, io_k19_3) = io_hp19_3;
                      let (x, io_hw19_3) = io_hxw19_3;
                      acc <- return io_hw19_3;
                      acc <- return (unbang host[add32]) (acc, x);
                      io_u <- return ();
                      io_wv19_3 <- return acc;
                      force io_k19_3.1 io_wv19_3, ());
                handle_with[1](io_hr19_3, io_hc19_3) (nu_out force io_hs19_3).1,
                io_chr19_3 : !U (1 -o F 1) <- return (!thunkv fun (io_cv19_3 : 1) ->
                      return io_cv19_3);
                io_chc19_3 : !U ((i32 * i32) * U ((i32 -o F 1) & F 1) -o F 1) * 1 <- return (!thunkv fun (io_cp19_3 : (i32 * i32) * U ((i32 -o F 1) & F 1)) ->
                      let (io_cxw19_3, io_ck19_3) = io_cp19_3;
                      let (io_cx19_3, io_cw19_3) = io_cxw19_3;
                      force io_ck19_3.1 io_cw19_3, ());
                handle_with[1](io_chr19_3, io_chc19_3) (nu_out force io_hs19_3).2 >);
        return (thunkv nu_in < (nu_out force io_hf19_3 io_hl19_3).1,
            (nu_out force io_hf19_3 io_hl19_3).2 >));
  io_d0 <- return (unbang io_hwf19_3) io_l19_3;
  return (unbang io_mk) io_d0
