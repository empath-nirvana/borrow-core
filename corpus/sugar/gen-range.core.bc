-- The elaboration of `gen-range.bc` in core, as `bcc desugar` prints it: `range` is a div function
-- at the row `div, Yield`, its `while` `iterate` with no tick on entry (a row's placement); the
-- `for` over it is `range`'s call in direct style under the kernel's tail-resuming rule
-- (`handle_tail`), a call of a div function itself (SPEC §14, §15, §64).

def range__n1__g0 : !U (i32 * i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] (i32 * 1 + 1)) =
  !thunkv fun (fx_pp1 : i32 * i32 * i32) ->
      let (fx_w1, io_p1) = fx_pp1;
      let (lo, hi) = io_p1;
      i <- return lo;
      io_step7 : !U (i32 * i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 + i32 * 1 + 1) + i32 * i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) <- return (!thunkv fun (io_s7 : i32 * i32 * i32) ->
            < let (fx_w1, io_s7t) = io_s7;
              let (hi, io_s7tt) = io_s7t;
              i <- return io_s7tt;
              case (unbang host[lt_s32]) (i, hi) {
                inl io_f -> return inl inl fx_w1
              | inr io_t -> fx_w1 <- perform[1.0] (i, fx_w1);
                  io_s0 <- return ();
                  i <- return (unbang host[add32]) (i, i32[1]);
                  return inr (fx_w1, (hi, i))
              },
              let (fx_w1, io_s7t) = io_s7;
              let (hi, io_s7tt) = io_s7t;
              i <- return io_s7tt;
              return () >);
      io_s07 : i32 * i32 * i32 <- return (fx_w1, (hi, i));
      io_x7 : (i32 + i32 * 1 + 1) + 1 <- (io_iter7 <- return unbang iterate[i32 * i32 * i32, i32 + i32 * 1 + 1, 1, [div, 1.0 aff i32 * i32 ~> i32]];
        io_p7 : !U (i32 * i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 + i32 * 1 + 1) + i32 * i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) * i32 * i32 * i32 <- return (io_step7, io_s07);
        force io_iter7 io_p7);
      case io_x7 {
        inl io_l7 -> case io_l7 {
            inl io_j1 -> fx_w1 <- return io_j1;
              return inl (fx_w1, ())
          | inr io_a7 -> return io_a7
          }
      | inr io_r7 -> return inr io_r7
      }

def range__n1__g0__close : !U (i32 * i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] 1) =
  !thunkv fun (fx_pp1 : i32 * i32 * i32) ->
      let (fx_w1, io_p1) = fx_pp1;
      let (lo, hi) = io_p1;
      i <- return lo;
      return ()

main : F U loop i32 1 =
  return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
        return ())) (thunkv fun (io_u : 1) ->
      let () = io_u;
      acc <- return i32[0];
      fx_w1 : i32 <- return acc;
      io_d2 <- handle_tail[1: aff](((!thunkv fun (io_hv19_3 : i32 * 1 + 1) ->
              case io_hv19_3 {
                inl io_ha19_3 -> return inl inl io_ha19_3
              | inr io_hl19_3 -> return inr io_hl19_3
              }) : !U (i32 * 1 + 1 -o F[div] ((i32 * 1 + i32 * 1) + 1))), (((!thunkv fun (io_hp19_3 : i32 * i32) ->
              let (x, io_hw19_3) = io_hp19_3;
              acc <- return io_hw19_3;
              acc <- return (unbang host[add32]) (acc, x);
              return acc) : !U (i32 * i32 -o F i32)), ())) (io_fg19_3 <- return unbang range__n1__g0;
        io_fa19_3 <- return (fx_w1, (i32[1], i32[11]));
        force io_fg19_3 io_fa19_3);
      case io_d2 {
        inl io_b -> io_j19_3 : i32 * 1 + i32 * 1 <- return io_b;
          io_jj19_3 : i32 * 1 <- case io_j19_3 {
              inl io_ja19_3 -> let (io_jw19_3, io_jg19_3) = io_ja19_3;
                return (io_jw19_3, ())
            | inr io_je19_3 -> let (io_jw19_3, io_jo19_3) = io_je19_3;
                return (io_jw19_3, io_jo19_3)
            };
          let (io_jx19_3, io_v19_3) = io_jj19_3;
          acc <- return io_jx19_3;
          let () = io_v19_3;
          return inl acc
      | inr io_r -> let () = io_r;
          io_res6 <- return ();
          return inr io_res6
      })
