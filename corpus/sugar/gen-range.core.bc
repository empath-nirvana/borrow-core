                    handle_with[1](((!thunkv fun (io_cv19_3 : 1) ->
                          return io_cv19_3) : !U (1 -o F 1)), ((!thunkv fun (io_cp19_3 : (i32 * i32) * U ((i32 -o F 1) & F 1)) ->
