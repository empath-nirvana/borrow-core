#! dialect 82
# A `let mut` in a function served by a stateful answering handler (handlers-di's shape).
# `mut-service.core.bc` is its elaboration, written by hand: the loop's state is the capability and
# the accumulator.
# Answer: (i32[10], i32[6]).
effect Log { log(x: i32) : 1 }

handler summing(mut s: i32): Log { log(x) -> { s = s + x; () } }

fn work(n: i32) : i32 / Log {
  var acc = 0
  for i in 0..n {
    if host[and32](i, 1) == 0 { log(i) } else { () }
    acc = acc + i
  }
  acc
}

fn main() : i32 * i32 {
  var c = alloc(0)
  let a = handle { work(5) } with summing(&c);
  (a, free(c))
}
