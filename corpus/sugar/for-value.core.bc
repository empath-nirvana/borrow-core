-- The elaboration of `for-value.bc` in core, as `bcc desugar` prints it.

def pair__n1__g0 : !U (i32 * 1 -o F[1.0 aff i32 * i32 ~> i32] (i32 * i32)) =
  !thunkv fun (fx_pp2 : i32 * 1) ->
      let (fx_w1, io_p2) = fx_pp2;
      let () = io_p2;
      fx_w1 <- perform[1.0] (i32[1], fx_w1);
      io_s1 <- return ();
      fx_w1 <- perform[1.0] (i32[2], fx_w1);
      io_s0 <- return ();
      return (fx_w1, i32[7])

def pair__n2__g1 : !U (i32 * 1 -o F[2.0 aff i32 * i32 ~> i32] (i32 * i32)) =
  !thunkv fun (fx_pp5 : i32 * 1) ->
      let (fx_w2, io_p2) = fx_pp5;
      let () = io_p2;
      fx_w2 <- perform[2.0] (i32[1], fx_w2);
      io_s1 <- return ();
      fx_w2 <- perform[2.0] (i32[2], fx_w2);
      io_s0 <- return ();
      return (fx_w2, i32[7])

main : F i32 =
  acc <- return i32[0];
  fx_w1 : i32 <- return acc;
  io_hr19_3 : !U (i32 * i32 -o F (i32 * i32 + i32 * i32)) <- return (!thunkv fun (io_hv19_3 : i32 * i32) ->
        return inl io_hv19_3);
  io_hc19_3 : !U ((i32 * i32) * U ((i32 -o F (i32 * i32 + i32 * i32)) & F 1) -o F (i32 * i32 + i32 * i32)) * 1 <- return (!thunkv fun (io_hp19_3 : (i32 * i32) * U ((i32 -o F (i32 * i32 + i32 * i32)) & F 1)) ->
        let (io_hxw19_3, io_k19_3) = io_hp19_3;
        let (x, io_hw19_3) = io_hxw19_3;
        acc <- return io_hw19_3;
        acc <- return (unbang host[add32]) (acc, x);
        io_u <- return ();
        io_wv19_3 <- return acc;
        force io_k19_3.1 io_wv19_3, ());
  io_j19_3 : i32 * i32 + i32 * i32 <- handle_with[1](io_hr19_3, io_hc19_3) (io_fg19_3 <- return unbang pair__n1__g0;
    io_fa19_3 <- return (fx_w1, ());
    force io_fg19_3 io_fa19_3);
  io_jj19_3 : i32 * i32 <- case io_j19_3 {
      inl io_ja19_3 -> let (io_jw19_3, io_jg19_3) = io_ja19_3;
        return (io_jw19_3, io_jg19_3)
    | inr io_je19_3 -> let (io_jw19_3, io_jo19_3) = io_je19_3;
        return (io_jw19_3, io_jo19_3)
    };
  let (io_jx19_3, io_v19_3) = io_jj19_3;
  acc <- return io_jx19_3;
  r : i32 <- return io_v19_3;
  n <- return (unbang host[add32]) ((unbang host[mul32]) (acc, i32[10]), r);
  fx_w2 : i32 <- return n;
  io_hr21_3 : !U (i32 * i32 -o F (i32 * i32 + i32 * i32)) <- return (!thunkv fun (io_hv21_3 : i32 * i32) ->
        return inl io_hv21_3);
  io_hc21_3 : !U ((i32 * i32) * U ((i32 -o F (i32 * i32 + i32 * i32)) & F 1) -o F (i32 * i32 + i32 * i32)) * 1 <- return (!thunkv fun (io_hp21_3 : (i32 * i32) * U ((i32 -o F (i32 * i32 + i32 * i32)) & F 1)) ->
        let (io_hxw21_3, io_k21_3) = io_hp21_3;
        let (x, io_hw21_3) = io_hxw21_3;
        n <- return io_hw21_3;
        case (unbang host[eq32]) (x, i32[2]) {
          inl io_else -> n <- return (unbang host[add32]) (n, x);
            io_u <- return ();
            io_wv21_3 <- return n;
            force io_k21_3.1 io_wv21_3
        | inr io_then -> io_c21_3 <- force io_k21_3.2;
            return inr (n, i32[40])
        }, ());
  io_j21_3 : i32 * i32 + i32 * i32 <- handle_with[2](io_hr21_3, io_hc21_3) (io_fg21_3 <- return unbang pair__n2__g1;
    io_fa21_3 <- return (fx_w2, ());
    force io_fg21_3 io_fa21_3);
  io_jj21_3 : i32 * i32 <- case io_j21_3 {
      inl io_ja21_3 -> let (io_jw21_3, io_jg21_3) = io_ja21_3;
        return (io_jw21_3, io_jg21_3)
    | inr io_je21_3 -> let (io_jw21_3, io_jo21_3) = io_je21_3;
        return (io_jw21_3, io_jo21_3)
    };
  let (io_jx21_3, io_v21_3) = io_jj21_3;
  n <- return io_jx21_3;
  s : i32 <- return io_v21_3;
  return (unbang host[add32]) (n, s)
