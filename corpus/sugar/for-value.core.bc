-- `for-value.bc` written by hand in core. Each `for` is the loop of SPEC §14 over the generator.
-- The first loop's rest yields again (a second loop follows), so it finishes with the
-- capabilities (none, `()`), the variables what follows reads (`acc`) and its value `r`, bound
-- where the iterator finishes; `div_bind` runs what follows with them. The second loop's rest is
-- total and runs in its last step; `break 40` binds `s` to 40, closes the iterator and runs it.

def pair : !(1 => U (gen i32 i32 1)) =
  !thunkv fun (p : 1) ->
    return (thunkv nu_in <
      let () = p;
      return (inl (i32[1], thunkv nu_in <
        s1 <- return ();
        return (inl (i32[2], thunkv nu_in <
          s0 <- return ();
          v : i32 <- return i32[7];
          return (inr (inl v)),
          return () >)),
        return () >)),
      let () = p;
      return () >)

-- The delay bind, copied from the divergence library (`lib/div.bc`).
def div_bind_step[A, B, R1, R] :
    !U ((U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)
        -o F (B + ((U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)))
         & F R) =
  !thunkv fun (s : (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)) ->
    < case s {
        inl p ->
          let (m, k) = p;
          o <- (nu_out (force m)).1;
          case o {
            inl a ->
              l <- (force k).1 a;
              return (inr (inr l))
          | inr m2 -> return (inr (inl (m2, k)))
          }
      | inr l ->
          o <- (nu_out (force l)).1;
          case o {
            inl b -> return (inl b)
          | inr l2 -> return (inr (inr l2))
          }
      },
      case s {
        inl p ->
          let (m, k) = p;
          r1 <- (nu_out (force m)).2;
          (force k).2 r1
      | inr l -> (nu_out (force l)).2
      } >

-- The delay bind: run the first loop, then the continuation on its result. If either never
-- finishes, neither does the whole.
def div_bind[A, B, R1, R] :
    U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R)) => U (loop B R) =
  thunkv fun (p : U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) ->
    f <- return (unbang (unfold[loop B R,
           (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R)]
           div_bind_step[A, B, R1, R]));
    s0 : (U (loop A R1) * U ((A -o F (U (loop B R))) & (R1 -o F R))) + U (loop B R) <-
      return (inl p);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

type Out = 1 * (i32 * i32)

main : F (U (loop i32 1)) =
  acc <- return i32[0];
  step : !U (U (gen i32 i32 1) * i32 -o F (Out + U (gen i32 i32 1) * i32) & F 1) <-
    return (!thunkv fun (s : U (gen i32 i32 1) * i32) ->
      < let (it, st) = s;
        acc <- return st;
        o <- (nu_out (force it)).1;
        case o {
          inl p ->
            let (x, it) = p;
            acc <- return ((unbang host[add32]) (acc, x));
            u <- return ();
            return (inr (it, acc))
        | inr d ->
            case d {
              inl q -> r <- return q; return (inl ((), (acc, r)))
            | inr it -> return (inr (it, acc))
            }
        },
        let (it, st) = s;
        acc <- return st;
        c <- (nu_out (force it)).2;
        return () >);
  f <- return (unbang (unfold[loop Out 1, U (gen i32 i32 1) * i32] step));
  s0 : U (gen i32 i32 1) * i32 <- return ((unbang pair) (), acc);
  l <- return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >);
  return (div_bind[Out, i32, 1, 1] (l, thunkv
    < fun (a : Out) ->
        let (ka, wa) = a;
        let () = ka;
        let (acc, r) = wa;
        n <- return ((unbang host[add32]) ((unbang host[mul32]) (acc, i32[10]), r));
        step : !U (U (gen i32 i32 1) * i32 -o F (i32 + U (gen i32 i32 1) * i32) & F 1) <-
          return (!thunkv fun (s : U (gen i32 i32 1) * i32) ->
            < let (it, st) = s;
              n <- return st;
              o <- (nu_out (force it)).1;
              case o {
                inl p ->
                  let (x, it) = p;
                  case (unbang host[eq32]) (x, i32[2]) {
                    inl ne ->
                      n <- return ((unbang host[add32]) (n, x));
                      u <- return ();
                      return (inr (it, n))
                  | inr eq ->
                      s <- return i32[40];
                      c <- (nu_out (force it)).2;
                      v : i32 <- return ((unbang host[add32]) (n, s));
                      return (inl v)
                  }
              | inr d ->
                  case d {
                    inl q -> s <- return q; v : i32 <- return ((unbang host[add32]) (n, s)); return (inl v)
                  | inr it -> return (inr (it, n))
                  }
              },
              let (it, st) = s;
              n <- return st;
              c <- (nu_out (force it)).2;
              return () >);
        f <- return (unbang (unfold[loop i32 1, U (gen i32 i32 1) * i32] step));
        s0 : U (gen i32 i32 1) * i32 <- return ((unbang pair) (), n);
        return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >),
      fun (r : 1) -> return r >))
