-- A `for` that keeps its value: `let r = for x in V { M }; N` binds `r` in `N` to what the
-- generator returns, or to `e` after `break e`. `pair` yields 1 and 2 and returns 7. The first
-- loop runs to the end, so `r` is 7; the second leaves at its second element with `break 40`,
-- which cancels the rest of `pair`. `for-value.core.bc` is its elaboration in core, as
-- `bcc desugar` prints it.
-- Answer: i32[78]: (1 + 2) * 10 + 7 = 37, then the second loop adds its first element, 1, and
-- leaves with 40. A `break` whose value was lost gives 38; a first loop whose value was not the
-- generator's gives 71 or 31.

include yield

fn pair() -> i32 with Yield[i32] =
  yield(1);
  yield(2);
  7

main -> i32 =
  let mut acc = 0;
  let r = for x in pair() { acc = acc + x };
  let mut n = acc * 10 + r;
  let s = for x in pair() { if x == 2 { break 40 } else { n = n + x } };
  n + s
