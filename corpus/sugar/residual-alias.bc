-- A div helper whose residual comes from its type (SPEC §14, docs/typed-elaboration.md §2.4).
-- `count` loops over the input and hands back the capability with the count. Its result
-- `Src * i32` holds `Src`, a name this program gives `ref input`: `Src` has no destructor, so a
-- loop closed early must hand it back, and the residual is `Src * 1`. The residual is read off
-- the type, not recognized by the names `In`, `Out`, `ref input` or `ref output`.
-- `residual-alias.core.bc` is the same program written by hand in core.
extern stdin : ref input
extern read_byte : !(all 'a < top. mut 'a input => mut 'a input * (i32 + 1))

-- The input under a name of this program's own.
type Src = ref input

def getb : Src => Src * (i32 + 1) =
  thunkv fun (c : Src) ->
    return (withbor2['x, top, input, i32 + 1] c
      (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x input) ->
         r <- return ((unbang read_byte) ['x] m);
         let (m2, b) = r;
         return (boxed['x] b))))

-- The input as a stream of bytes, finishing (or closed) with the capability.
def src_step : !U (Src -o F (i32 * Src + Src) & F Src) =
  !thunkv fun (c : Src) ->
    < q <- return (getb c);
      let (c2, x) = q;
      case x {
        inl b -> return (inl (b, c2))
      | inr u -> return (inr c2)
      },
      return c >

def src_bytes : Src => U (iter i32 Src Src) =
  thunkv fun (c : Src) ->
    f <- return (unbang (unfold[iter i32 Src Src, Src] src_step));
    return (thunkv nu_in < (nu_out (force f c)).1, (nu_out (force f c)).2 >)

def count : Src => Src * i32 =
  thunkv fun (c : Src) ->
    n <- return i32[0];
    for b in src_bytes c {
      n <- return ((unbang host[add32]) (n, i32[1]));
      return ()
    };
    return (c, n)

main : F (ref input * i32) =
  r <- return (count (&mut stdin));
  return (stdin, r)
