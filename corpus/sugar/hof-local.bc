-- A callback passed through a local variable (SPEC §14, docs/typed-elaboration.md §2.4). `g` is
-- bound to the div function `steps`, and `twice (g, 5)` specializes `twice` at `g`'s type,
-- which inference gives: the copy's calls through its parameter are calls of a div function, so
-- the copy is div. `main` runs it under `div_fuel`, so `main` is total. `hof-local.core.bc` is
-- its elaboration in core, as `bcc desugar` prints it.
-- Answer: `inl 7` (5 + 1 + 1).
-- A loop that finishes at its first observation, with `n + 1`.
def once : i32 => U (loop i32 1) =
  thunkv fun (n : i32) ->
    return (thunkv nu_in < return (inl ((unbang host[add32]) (n, i32[1]))), return () >)

-- A callback that runs a loop: it calls `once` in direct style, so it is div.
def steps : !(i32 => i32) =
  !thunkv fun (n : i32) ->
    k <- return (once n);
    return k

-- A higher-order function, written once at a total callback type.
def twice : !(i32 => i32) * i32 => i32 =
  thunkv fun (p : !(i32 => i32) * i32) ->
    let (f, a) = p;
    x <- return ((unbang f) a);
    y <- return ((unbang f) x);
    return y

main : F (i32 + 1) =
  g <- return steps;
  r <- return (div_fuel[i32, 1] (twice (g, i32[5]), i32[10]));
  return r
