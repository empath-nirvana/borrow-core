-- The elaboration of `gen-return.bc` in core, as `bcc desugar` prints it: each loop of `upto` is
-- `iterate`, `return e` from inside it leaves the loop with the body's answer, and the `for` over
-- it is `upto`'s call in direct style under the kernel's tail-resuming rule (`handle_tail`), a
-- call of a div function itself (SPEC §14, §15, §64).

def upto__n1__g0 : !U (i32 * i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] (i32 * i32 + 1)) =
  !thunkv fun (fx_pp1 : i32 * i32 * i32) ->
      let (fx_w1, io_p2) = fx_pp1;
      let (n, stop) = io_p2;
      i <- return i32[0];
      io_step9 : !U (i32 * i32 * i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 * i32 + i32 * i32 + 1) + i32 * i32 * i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) <- return (!thunkv fun (io_s9 : i32 * i32 * i32 * i32) ->
            < let (fx_w1, io_s9t) = io_s9;
              let (n, io_s9tt) = io_s9t;
              let (stop, io_s9ttt) = io_s9tt;
              i <- return io_s9ttt;
              case (unbang host[lt_s32]) (i, n) {
                inl io_f -> return inl inl (fx_w1, n)
              | inr io_t -> case (unbang host[eq32]) (i, stop) {
                    inl io_else -> io_s1 <- return ();
                      fx_w1 <- perform[1.0] (i, fx_w1);
                      io_s0 <- return ();
                      i <- return (unbang host[add32]) (i, i32[1]);
                      return inr (fx_w1, (n, (stop, i)))
                  | inr io_then -> io_rv7 <- return (fx_w1, i);
                      return inl inr inl io_rv7
                  }
              },
              let (fx_w1, io_s9t) = io_s9;
              let (n, io_s9tt) = io_s9t;
              let (stop, io_s9ttt) = io_s9tt;
              i <- return io_s9ttt;
              return () >);
      io_s09 : i32 * i32 * i32 * i32 <- return (fx_w1, (n, (stop, i)));
      io_x9 : (i32 * i32 + i32 * i32 + 1) + 1 <- (io_iter9 <- return unbang iterate[i32 * i32 * i32 * i32, i32 * i32 + i32 * i32 + 1, 1, [div, 1.0 aff i32 * i32 ~> i32]];
        io_p9 : !U (i32 * i32 * i32 * i32 -o F[div, 1.0 aff i32 * i32 ~> i32] ((i32 * i32 + i32 * i32 + 1) + i32 * i32 * i32 * i32) & F[div, 1.0 aff i32 * i32 ~> i32] 1) * i32 * i32 * i32 * i32 <- return (io_step9, io_s09);
        force io_iter9 io_p9);
      case io_x9 {
        inl io_l9 -> case io_l9 {
            inl io_j1 -> let (fx_w1, io_j1t) = io_j1;
              n <- return io_j1t;
              return inl (fx_w1, n)
          | inr io_a9 -> return io_a9
          }
      | inr io_r9 -> return inr io_r9
      }

def upto__n1__g0__close : !U (i32 * i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] 1) =
  !thunkv fun (fx_pp1 : i32 * i32 * i32) ->
      let (fx_w1, io_p2) = fx_pp1;
      let (n, stop) = io_p2;
      return ()

main : F U loop i32 1 =
  return (unbang reify[i32, 1, []](!thunkv fun (io_b : i32) ->
        return ())) (thunkv fun (io_u : 1) ->
      let () = io_u;
      acc <- return i32[0];
      fx_w1 : i32 <- return acc;
      io_d2 <- handle_tail[1: aff](((!thunkv fun (io_hv21_3 : i32 * i32 + 1) ->
              case io_hv21_3 {
                inl io_ha21_3 -> return inl inl io_ha21_3
              | inr io_hl21_3 -> return inr io_hl21_3
              }) : !U (i32 * i32 + 1 -o F[div] ((i32 * i32 + i32 * 1) + 1))), (((!thunkv fun (io_hp21_3 : i32 * i32) ->
              let (x, io_hw21_3) = io_hp21_3;
              acc <- return io_hw21_3;
              acc <- return (unbang host[add32]) (acc, x);
              return acc) : !U (i32 * i32 -o F i32)), ())) (io_fg21_3 <- return unbang upto__n1__g0;
        io_fa21_3 <- return (fx_w1, (i32[10], i32[4]));
        force io_fg21_3 io_fa21_3);
      case io_d2 {
        inl io_b -> io_j21_3 : i32 * i32 + i32 * 1 <- return io_b;
          io_jj21_3 : i32 * 1 <- case io_j21_3 {
              inl io_ja21_3 -> let (io_jw21_3, io_jg21_3) = io_ja21_3;
                return (io_jw21_3, ())
            | inr io_je21_3 -> let (io_jw21_3, io_jo21_3) = io_je21_3;
                return (io_jw21_3, io_jo21_3)
            };
          let (io_jx21_3, io_v21_3) = io_jj21_3;
          acc <- return io_jx21_3;
          let () = io_v21_3;
          return inl acc
      | inr io_r -> let () = io_r;
          io_res6 <- return ();
          return inr io_res6
      })
