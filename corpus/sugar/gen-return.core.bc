-- The elaboration of `gen-return.bc` in core, as `bcc desugar` prints it.

def upto__n1__g0 : !(i32 * i32 * i32 => U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) =
  !thunkv fun (fx_pp1 : i32 * i32 * i32) ->
      io_run_1 : !U (i32 * i32 * i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + i32 * i32 * i32 + i32 * i32 * i32 * i32)) <- return (!thunkv fun (io_a : i32 * i32 * i32 * i32) ->
            let (fx_w1, io_a_t) = io_a;
            let (n, io_a_t_t) = io_a_t;
            let (stop, i) = io_a_t_t;
            case (unbang host[lt_s32]) (i, n) {
              inl io_f -> io_v : i32 * i32 <- return (fx_w1, n);
                return inl io_v
            | inr io_t -> case (unbang host[eq32]) (i, stop) {
                  inl io_else -> io_s1 <- return ();
                    fx_w1 <- perform[1.0] (i, fx_w1);
                    io_s0 <- return ();
                    i <- return (unbang host[add32]) (i, i32[1]);
                    io_u <- return ();
                    return inr inr (fx_w1, (n, (stop, i)))
                | inr io_then -> io_v : i32 * i32 <- return (fx_w1, i);
                    return inl io_v
                }
            });
      io_step : !U (i32 * i32 * i32 + i32 * i32 * i32 * i32 -o F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + i32 * i32 * i32 + i32 * i32 * i32 * i32) & F[1.0 aff i32 * i32 ~> i32] 1) <- return (!thunkv fun (io_s : i32 * i32 * i32 + i32 * i32 * i32 * i32) ->
            < case io_s {
                inl io_a -> fx_pp1 <- return io_a;
                  let (fx_w1, io_p2) = fx_pp1;
                  let (n, stop) = io_p2;
                  i <- return i32[0];
                  io_rf1 <- return unbang io_run_1;
                  io_ra1 <- return (fx_w1, (n, (stop, i)));
                  force io_rf1 io_ra1
              | inr io_a -> io_rf <- return unbang io_run_1;
                  force io_rf io_a
              },
              case io_s {
                inl io_a -> fx_pp1 <- return io_a;
                  let (fx_w1, io_p2) = fx_pp1;
                  let (n, stop) = io_p2;
                  return ()
              | inr io_a -> let (fx_w1, io_a_t) = io_a;
                  let (n, io_a_t_t) = io_a_t;
                  let (stop, i) = io_a_t_t;
                  return ()
              } >);
      io_f <- return unbang unfold[nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1, i32 * i32 * i32 + i32 * i32 * i32 * i32] io_step;
      io_s0 : i32 * i32 * i32 + i32 * i32 * i32 * i32 <- return inl fx_pp1;
      return (thunkv nu_in < (nu_out force io_f io_s0).1,
          (nu_out force io_f io_s0).2 >)

main : F U loop i32 1 =
  io_run_0 : !U (U delay (i32 * i32 + i32 * 1) -o F (i32 + U delay (i32 * i32 + i32 * 1))) <- return (!thunkv fun (io_a : U delay (i32 * i32 + i32 * 1)) ->
        io_d0 <- return io_a;
        io_o <- (nu_out force io_d0).1;
        case io_o {
          inl io_b -> io_j21_3 : i32 * i32 + i32 * 1 <- return io_b;
            io_jj21_3 : i32 * 1 <- case io_j21_3 {
                inl io_ja21_3 -> let (io_jw21_3, io_jg21_3) = io_ja21_3;
                  return (io_jw21_3, ())
              | inr io_je21_3 -> let (io_jw21_3, io_jo21_3) = io_je21_3;
                  return (io_jw21_3, io_jo21_3)
              };
            let (io_jx21_3, io_v21_3) = io_jj21_3;
            acc <- return io_jx21_3;
            let () = io_v21_3;
            io_v : i32 <- return acc;
            return inl io_v
        | inr io_d0 -> return inr io_d0
        });
  io_step : !U (U delay (i32 * i32 + i32 * 1) -o F (i32 + U delay (i32 * i32 + i32 * 1)) & F 1) <- return (!thunkv fun (io_a : U delay (i32 * i32 + i32 * 1)) ->
        < return (unbang io_run_0) io_a,
          io_d0 <- return io_a;
          io_r <- (nu_out force io_d0).2;
          let () = io_r;
          return () >);
  io_mk : !(U delay (i32 * i32 + i32 * 1) => U loop i32 1) <- return (!thunkv fun (io_s0 : U delay (i32 * i32 + i32 * 1)) ->
        io_f <- return unbang unfold[loop i32 1, U delay (i32 * i32 + i32 * 1)] io_step;
        return (thunkv nu_in < (nu_out force io_f io_s0).1,
            (nu_out force io_f io_s0).2 >));
  acc <- return i32[0];
  fx_w1 : i32 <- return acc;
  io_l21_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) <- return (unbang upto__n1__g0) (fx_w1, (i32[10], i32[4]));
  io_hwf21_3 : !(U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) => U loop (i32 * i32 + i32 * 1) 1) <- return (!thunkv fun (io_hl21_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
        io_hf21_3 <- return unbang unfold[loop (i32 * i32 + i32 * 1) 1, U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)] (!thunkv fun (io_hs21_3 : U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
              <                 handle_with[1](
                    ((!thunkv fun (io_hv21_3 : i32 * i32 + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)) ->
                      case io_hv21_3 {
                        inl io_ha21_3 -> return inl inl io_ha21_3
                      | inr io_hl21_3 -> return inr io_hl21_3
                      }) : !U (i32 * i32 + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1) -o F ((i32 * i32 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1)))),
                    ((!thunkv fun (io_hp21_3 : (i32 * i32) * U ((i32 -o F ((i32 * i32 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) & F 1)) ->
                      let (io_hxw21_3, io_k21_3) = io_hp21_3;
                      let (x, io_hw21_3) = io_hxw21_3;
                      acc <- return io_hw21_3;
                      acc <- return (unbang host[add32]) (acc, x);
                      io_u <- return ();
                      io_wv21_3 <- return acc;
                      force io_k21_3.1 io_wv21_3, ()) : !U ((i32 * i32) * U ((i32 -o F ((i32 * i32 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) & F 1) -o F ((i32 * i32 + i32 * 1) + U (nu X. F[1.0 aff i32 * i32 ~> i32] (i32 * i32 + U X) & F[1.0 aff i32 * i32 ~> i32] 1))) * 1)) (nu_out force io_hs21_3).1,
                handle_with[1](
                    ((!thunkv fun (io_cv21_3 : 1) ->
                      return io_cv21_3) : !U (1 -o F 1)),
                    ((!thunkv fun (io_cp21_3 : (i32 * i32) * U ((i32 -o F 1) & F 1)) ->
                      let (io_cxw21_3, io_ck21_3) = io_cp21_3;
                      let (io_cx21_3, io_cw21_3) = io_cxw21_3;
                      force io_ck21_3.1 io_cw21_3, ()) : !U ((i32 * i32) * U ((i32 -o F 1) & F 1) -o F 1) * 1)) (nu_out force io_hs21_3).2 >);
        return (thunkv nu_in < (nu_out force io_hf21_3 io_hl21_3).1,
            (nu_out force io_hf21_3 io_hl21_3).2 >));
  io_d0 <- return (unbang io_hwf21_3) io_l21_3;
  return (unbang io_mk) io_d0
