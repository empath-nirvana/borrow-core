-- check: old-backend-refuses
-- SPEC §27 in the core text: the suspending twin of `core-fin-cancel-reentered`. The region
-- re-enters the site of the name `3`; handler 1 cancels `κ` at `1.0`, below the inner handler 3,
-- which is dead at the cancel. The finaliser performs the capturable `3.0`, which goes to the live
-- outer handler 3 in the canceller; it resumes outside tail position and marks the answer. The
-- inner handler's row gives `1.0` its own empty cancel row; the site's row holds `3.0` in it.
--
-- Answer: inr (), and `live 0`. A wrong implementation that delivers the operation to the dead
-- inner handler (which resumes in tail position) answers `inl ()`.

main : F (1 + 1) =
  handle_with[3](
      ((!thunkv fun (v : 1) -> return (inl v)) : !U (1 -o F (1 + 1))),
      (((!thunkv fun (p : 1 * U ((1 -o F (1 + 1)) & F 1)) ->
          let (u, k) = p; r <- (force k).1 u; case r { inl a -> return (inr a) | inr b -> return (inr b) }), ())
        : !U (1 * U ((1 -o F (1 + 1)) & F 1) -o F (1 + 1)) * 1)) (
    handle_with[1](
        ((!thunkv fun (v : 1) -> return v) : !U (1 -o F[3.0 cancel 1 ~> 1] 1)),
        (((!thunkv fun (p : 1 * U ((1 -o F[3.0 cancel 1 ~> 1] 1) & F[3.0 cancel 1 ~> 1, 3.0 cancel 1 ~> 1] 1)) ->
          let (u, k) = p; let () = u; c <- (force k).2; return c), ())
          : !U (1 * U ((1 -o F[3.0 cancel 1 ~> 1] 1) & F[3.0 cancel 1 ~> 1, 3.0 cancel 1 ~> 1] 1) -o F[3.0 cancel 1 ~> 1] 1) * 1)) (
      x <- (handle_with[3](
              ((!thunkv fun (v : 1) -> return v) : !U (1 -o F[1.0 cancel 1 ~> 1] 1)),
              (((!thunkv fun (p : 1 * U ((1 -o F[1.0 cancel 1 ~> 1] 1) & F[1.0 cancel 1 ~> 1] 1)) ->
                let (u, k) = p; (force k).1 u), ())
                : !U (1 * U ((1 -o F[1.0 cancel 1 ~> 1] 1) & F[1.0 cancel 1 ~> 1] 1) -o F[1.0 cancel 1 ~> 1] 1) * 1)) (
            perform[1.0] ())) unwind (perform[3.0] ());
      return x))
