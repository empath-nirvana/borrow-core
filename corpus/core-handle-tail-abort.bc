-- SPEC §14, §54 in the core text: `handle_tail[2: 0]`, a tail-resuming rule's handler whose
-- operation `2.0 aff i32 ~> 0` is abortive (the count `0`). Its function `!U(i32 -o F i32)` is its
-- clause, the handler's answer at the abort (`tailClause`'s abortive clause, `ansesRead` at `0`).
-- `go` aborts with `20`, so the code after the abort does not run.
--
-- Answer: i32[20].

def plus : i32 * i32 => i32 = unbang host[add32]

def go : !U (i32 -o F[2.0 aff i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    z <- abort[2.0] (plus (a, a));
    absurd z

main : F i32 =
  f <- return (unbang go);
  u <- return i32[10];
  handle_tail[2: 0](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      (((!thunkv fun (s : i32) -> return s), ()) : !U (i32 -o F i32) * 1))
    (force f u)
