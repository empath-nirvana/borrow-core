-- An iterator into borrowed data held across `await` (SPEC §32): `main` owns a vector and lends a
-- shared view of it to one task. The task iterates the view and awaits after every element, so the
-- iterator (the view, and the position in it) is live across each `await`. The leaf views of a
-- family `array_imm 'r i32` are at the lender's lifetime `'r` (SPEC §9), so a state that holds
-- them is boxed below `'r` by `spawn_in`, inside a unit cell's scope `'d`, and `run_in` runs the
-- task for at most 8 rounds inside the borrow. No lend is held across the `await`:
-- `assurance: unconditional`. It is the first of the hard problems (`corpus/pending/HARD-PROBLEMS.md`);
-- the form that loads the view from a borrow of a cell, at a lifetime of its own, is
-- `corpus/pending/hard-async-iter-borrowed.bc`.
--
-- Rust: `async fn sum_slowly(xs: &[i32])` with `for x in xs { …; yield_now().await }`; the future
-- holds a `slice::Iter<'a, i32>` across the `.await`, bounded by `'a`.
--
-- Answer: i32[100], the sum 10 + 20 + 30 + 40, read one element per turn; `live 0`.

include async

-- The sum of the elements, letting the other tasks run after each one.
fn sum_slowly<'a>(xs: array_imm 'a i32) -> i32 with Async =
  let mut s = 0;
  for x in xs { s = s + *x; await() };
  s

fn tab(i: i32) -> i32 = 10 * (i + 1)

main -> i32 =
  let v = array_new[i32](4, tab);
  let d = alloc(());
  let (d, sums) = borrow imm v { 'r, xs ->
    let sums = borrow mut d { 'd, e ->
      let q = push_in(queue_in[i32](), with spawn_in { sum_slowly(xs) });
      with on_exhausted(!{ u -> nil() }) { run_in(q, 8) } };
    (d, sums) };
  let _ = free(d);
  with on_exhausted(!{ u -> 0 }) { fold(sums, 0, !{ (a, x) -> a + x }) }
