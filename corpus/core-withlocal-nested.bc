#! dialect 82
# [spec §80] Distinct nested locals, asymmetric writes: final outer 18, inner 15.
main : F (i32 * i32) =
  q <- return (withlocal['x, top, i32, i32] i32[1]
    (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x i32) ->
      r <- return (withlocal['y, top, i32, mut 'x i32] i32[10]
        (thunkv Fun 'y < dom. return (thunkv fun (n : mut 'y i32) ->
          p <- return (withswap['y, i32, 1] n (thunkv fun (v : i32) ->
            return ((unbang host[add32]) (v, i32[5]), ())));
          let (n, u) = p;
          let () = u;
          let () = release_mut['y, i32] n;
          return (boxed['y] m))));
      let (inner, m) = r;
      p <- return (withswap['x, i32, 1] m (thunkv fun (v : i32) ->
        return ((unbang host[add32]) (v, (unbang host[add32]) (inner, i32[2])), ())));
      let (m, u) = p;
      let () = u;
      let () = release_mut['x, i32] m;
      return (boxed['x] inner))));
  return q
