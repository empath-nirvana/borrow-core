-- SPEC §3, §22 (#808): `File<'c>` written in lifetime contexts whose numbering differs, the object
-- passed between them. `refill<'p, 'c>` has a lifetime parameter before `'c` and lends a buffer of
-- its own, so inside its lend `File<'c>`'s binders are numbered past three context variables;
-- `main` numbers them past `'main` and its lend's. The checker relates the two elaborations by
-- `[α]`: the binders' names differ, and the types are one up to them.
--
-- Answer: see `nu-file-contexts.out`: the buffer is 2 + 3 = 5 after `main`'s read; `refill`
-- copies it into its own buffer, reads the file into that (5 + 3 = 8, the second read), and
-- answers 8 * 10 + 2; `close` answers the content 3; `live 0`.

type File<'c> = U (nu X. ((forall 'x < top. mut 'x i32 -o F (i32 * box 'c U X))
                        & (forall 'x < top. imm 'x i32 -o F (i32 * box 'c U X))) & F i32)

-- The state: the content and the number of reads.
fn file_open<'c>(start: i32) -> box 'c File<'c> =
  f <- return (unfold[nu X. ((forall 'x < top. mut 'x i32 -o F (i32 * box 'c U X))
                           & (forall 'x < top. imm 'x i32 -o F (i32 * box 'c U X))) & F i32,
                       ref i32 * i32]
    (!thunkv fun (s : ref i32 * i32) ->
      < < Fun 'x < top. fun (m : mut 'x i32) ->
          let (c, n) = s;
          cx <- return (swap[i32, i32] c i32[0]);
          let (c, k) = cx;
          cu <- return (swap[i32, i32] c k);
          let (c, u) = cu;
          q <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) -> return (v + k, n + 1)));
          let (m, r) = q;
          return (release_mut['x, i32] m);
          return (r, boxed['c] (c, n + 1)),
          Fun 'x < top. fun (b : imm 'x i32) ->
            let (c, n) = s;
            w <- return (*b);
            return (release_imm['x, i32] b);
            cx <- return (swap[i32, i32] c w);
            let (c, old) = cx;
            return (old, boxed['c] (c, n)) >,
        let (c, n) = s;
        return (free[i32] c + n * 0) >));
  s <- return (alloc[i32] start, 0);
  return (boxed['c] (thunkv nu_in
    < < g <- return (unbang f); (nu_out (force g s)).1 .1,
        g <- return (unbang f); (nu_out (force g s)).1 .2 >,
      g <- return (unbang f); (nu_out (force g s)).2 >))

fn file_read<'a, 'c>(f: box 'c File<'c>, b: mut 'a i32) -> i32 * box 'c File<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 .1['a] b

fn file_write<'a, 'c>(f: box 'c File<'c>, b: imm 'a i32) -> i32 * box 'c File<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 .2['a] b

fn file_close<'c>(f: box 'c File<'c>) -> i32 =
  g <- return (unbox f);
  (nu_out (force g)).2

-- The lent value copied into a buffer of `refill`'s own, which is lent `mut` to the file's `read`;
-- the buffer is freed and answered with the read's count.
fn refill<'p, 'c>(f: box 'c File<'c>, x: imm 'p i32) -> i32 * box 'c File<'c> =
  xv <- return (*x);
  return (release_imm['p, i32] x);
  let own = alloc(xv);
  let (r, f) = borrow mut own { 'w, m -> file_read(f, m) };
  let o = free(own);
  (o * 10 + r, f)

main -> i32 =
  let buf = alloc(2);
  let f = file_open(3);
  let (r1, f) = borrow mut buf { 'w, m -> file_read(f, m) };
  let (o, f) = borrow imm buf { 'w, b -> refill(f, b) };
  let content = file_close(f);
  let b = free(buf);
  b * 10000 + o * 10 + content + r1 * 0
