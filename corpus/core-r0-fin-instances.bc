-- R0 (SPEC §54) in the core text: two finalisers at one span. `guarded[A]` writes a finaliser
-- (`unwind`) that frees a cell live across the call of `check`, at the row of the abortive
-- operation `1.0 aff i32 ~> 0`; it is used at `i32` and at `i32 * i32`, two instances whose
-- finalisers have one span. G-fin tells them apart by id, as `π` does binders: the numbering pass
-- gives each its own, and each is run on its own abort arms.
--
-- Answer: (inl (i32[1], i32[8]), inr i32[107]), and `live 0`: at `5` the rest adds the cell's `3`;
-- at `0` the call aborts, the finaliser frees the cell, and the handler answers `7 + 100`.

def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

def guarded[A] : !U (A * i32 -o F[1.0 aff i32 ~> 0] (A * i32)) =
  !thunkv fun (p : A * i32) ->
    let (v, a) = p;
    c <- return (alloc[i32] i32[3]);
    f <- return (unbang check);
    w <- force f a unwind (
      y <- return (free[i32] c);
      return ());
    x <- return (free[i32] c);
    return (v, plus (w, x))

def handled[A] : !U (A * i32 -o F ((A * i32) + i32)) =
  !thunkv fun (p : A * i32) ->
    handle_with[1](
        ((!thunkv fun (r : A * i32) -> return (inl r)) : !U (A * i32 -o F ((A * i32) + i32))),
        (((!thunkv fun (e : i32) -> return (inr (plus (e, i32[100])))), ()) : !U (i32 -o F ((A * i32) + i32)) * 1))
      (f <- return (unbang guarded[A]); force f p)

main : F (((i32 * i32) + i32) * (((i32 * i32) * i32) + i32)) =
  f <- return (unbang handled[i32]);
  a <- return (i32[1], i32[5]);
  r1 <- force f a;
  g <- return (unbang handled[i32 * i32]);
  b <- return ((i32[5], i32[6]), i32[0]);
  r2 <- force g b;
  return (r1, r2)
