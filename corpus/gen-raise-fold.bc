-- A raising `try_fold` is a plain `fold` with an error handler attached (SPEC §15, #910). `fold`
-- folds a stored generator with a step function and knows nothing of errors. `try_sum` passes it a
-- step that raises when the running sum passes a limit, and attaches `to_result`: the raise leaves
-- the fold, closing the source, and the handler gives the error. `try_sum_bad` folds a source that
-- raises itself: `fold`'s copy is at the source's row, and that raise reaches the same handler.
--
-- Answer: `(inl i32[10], (inr i32[21], inr i32[1004]))`: 1 + 2 + 3 + 4; the first running sum past
-- 20, 1 + … + 6; and the source's own error at its fourth element. `live 0`. A raise that did not
-- leave the fold, the step's or the source's, gives `inl 55` in its place.

include yield
include fail
include rec

fn events(n: i32) -> 1 with Yield[i32] =
  let mut i = 1;
  while i <= n { yield(i); i = i + 1 };
  ()

fn events_until(n: i32, bad: i32) -> 1 with Yield[i32], Fail[i32] =
  let mut i = 1;
  while i <= n { if i == bad { raise(1000 + i) } else { () }; yield(i); i = i + 1 };
  ()

fn fold(it: U (pull i32 1 1), s: i32, f: !(i32 * i32 => i32)) -> i32 with Exhausted =
  o <- (nu_out (force it)).1;
  match o {
    inl (x, it) -> fold(it, f((s, x)), f)
  | inr d -> match d { inl u -> s | inr it -> fold(it, s, f) }
  }

fn try_sum(n: i32, limit: i32) -> i32 + i32 =
  with on_exhausted(!{ u -> inr 0 }) {
    with to_result[i32, i32] { fold(events(n), 0, !{ (s, x) -> if s + x > limit { raise(s + x) } else { s + x } }) }
  }

fn try_sum_bad(n: i32, bad: i32) -> i32 + i32 =
  with on_exhausted(!{ u -> inr 0 }) {
    with to_result[i32, i32] { fold(events_until(n, bad), 0, !{ (s, x) -> s + x }) }
  }

main -> (i32 + i32) * ((i32 + i32) * (i32 + i32)) =
  (try_sum(4, 100), (try_sum(10, 20), try_sum_bad(10, 4)))
