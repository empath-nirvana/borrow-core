-- A generator that fails: `digits` yields `inl d` for each decimal digit of its input and, at
-- the first byte that is neither a digit nor a newline, yields `inr b` and stops (Rust's `?` in a
-- generator, which yields the error and ends). It finishes, or stops, handing the input back.
-- This is a stopgap until the error effect (#18): the failure is an element, and the consumer
-- matches on it.
--
-- Answer: on the input `12`, `34x56`, the line `!x` and i32[1234]: the digits before the bad byte
-- read as a number. A generator that went on past the error gives i32[123456]; one that did not
-- skip the newline prints `!` and a newline and stops at 12.

gen fn digits(c: In) -> i32 + i32, In =
  for b in bytes(c) {
    if 47 < b && b < 58 { yield inl (b - 48) }
    else { if b == 10 { () } else { yield inr b; break } }
  };
  c

main -> i32 =
  let mut n = 0;
  for r in digits(stdin) {
    match r {
      inl d -> n = n * 10 + d
    | inr b -> putb(&mut stdout, 33); putb(&mut stdout, b); putb(&mut stdout, 10)
    }
  };
  n
