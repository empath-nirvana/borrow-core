-- A source that never ends (SPEC §15, §16): `naturals` is a generator that returns `0`, the
-- empty type, so its body is a `loop` that nothing follows. A `for` over it is div, and its value
-- is exactly `break`'s type: there is no `else`, since the source cannot end. A loop over it with
-- no `break` never ends either (`count_forever`, which `main` does not call).
--
-- Answer: i32[1035], the first triangular number over 1000 (1 + 2 + … + 45).

include yield

fn naturals() -> 0 with Yield[i32] =
  let mut i = 1;
  loop { yield(i); i = i + 1 }

-- The first triangular number over `lim`.
fn first_triangle_over(lim: i32) -> i32 =
  let mut t = 0;
  let r = for i in naturals() { t = t + i; if t > lim { break t } else { () } };
  r

-- A loop with no `break` over a source that never ends: what follows it does not run.
fn count_forever(k: i32) -> i32 =
  let mut s = 0;
  for i in naturals() { s = s + i };
  s + k

main -> i32 = first_triangle_over(1000)
