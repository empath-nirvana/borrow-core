-- `|>` and `>|` in one chain (SPEC §70, the mixing rule): the operator at each edge names
-- that wire's mode, push or pull, and the chain is one chain whatever its operators. Until L2
-- (#921) each edge into a source-owning adapter is §33's case (iii). An edge that is not a stream
-- edge is §33's, whatever chain it is in: `|> double` after the chain is a plain function's call.
--
-- * `a`: `range(0, 20) >| map(sq) |> filter(even) >| skip(1) |> take(3)`, two pull wires and
--   two push wires: the even squares 0, 4, 16, 36, 64, …, skipping 0, the next three, 4 + 16 + 36.
-- * `b`: a parenthesised sub-chain at a `|>` edge, spliced in (its edges join): `range(0, 20) |>
--   (map(sq) >| filter(even)) >| take(2)`, 0 + 4.
-- * `c`: a chain into a sink and a plain function: `sum_all` takes the chain stored (case (iii)),
--   and `double` its sum, `2 * (1 + 4 + 9)`.
--
-- Answer: `(i32[56], (i32[4], i32[28]))`.

include adapters

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn sq(x: i32) -> i32 = x * x
fn even(x: i32) -> bool = host[and32] (x, 1) == 0
fn double(x: i32) -> i32 = 2 * x

fn sum_all(it: U (pull i32 1 1)) -> i32 =
  let mut s = 0;
  for x in it { s = s + x };
  s

main -> i32 * (i32 * i32) =
  let mut a = 0;
  for y in range(0, 20) >| map(sq) |> filter(even) >| skip(1) |> take(3) { a = a + y };
  let mut b = 0;
  for y in range(0, 20) |> (map(sq) >| filter(even)) >| take(2) { b = b + y };
  let c = range(1, 10) >| map(sq) >| take(3) |> sum_all |> double;
  (a, (b, c))
