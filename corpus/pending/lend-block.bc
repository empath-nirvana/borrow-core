-- pending: #58 (an implicit copy of an `imm` borrow, here one read at each turn of a loop; SPEC §42 Open)
-- now: 41:24: `b` is used twice here, and its type `imm 'io_l2 array i32` is not persistent
--
-- A borrow block over a loop: the table's cell `t` is borrowed around code before a
-- `for`, the `for`, and code after it, each of which reads it.
--
-- The lend spans the loop's ticks, which the kernel admits at the graded row `div call`
-- (SPEC §48). The loop then reads the borrow `b` at each turn, so its state threads it and
-- each turn uses it again; a borrow is not persistent, and an `imm` borrow is not copied
-- implicitly (#58, SPEC §42 Open), so the checker refuses the second use, as it does
-- `corpus/reject/lend-iter-borrow.bc`'s.
--
-- Once it lands: `i32[134]`, `live 0`: the entries at 4, 3, 2, 1 of 10 * i sum to 100, the first
-- entry read before the loop is 10 (added once per step, 40), and the entry read after it is 0 less
-- 6.

def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

def tab : !(i32 => i32) = !thunkv fun (i : i32) -> return ((unbang host[mul32]) (i, i32[10]))

-- The numbers from `n` down to 1.
def down : i32 => U (iter i32 1 1) =
  thunkv fun (n : i32) ->
    f <- return (unbang (unfold[iter i32 1 1, i32] (!thunkv fun (k : i32) ->
      < case (unbang host[eqz32]) k {
          inl nz -> return (inl (k, (unbang host[sub32]) (k, i32[1])))
        | inr z -> return (inr ())
        },
        return () >)));
    return (thunkv nu_in < (nu_out (force f n)).1, (nu_out (force f n)).2 >)

main -> i32 =
  let t = alloc(array_new[i32] (10, tab));
  let n = borrow imm t { b ->
    let first = get(b, 1);
    let mut acc = 0;
    for i in down(4) { acc = acc + first + get(b, i) };
    acc - 6 + get(b, 0)
  };
  n
