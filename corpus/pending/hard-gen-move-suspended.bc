-- pending: #172 (a self-borrowing machine moved between resumes)
-- now: 27:3: the body of this `for` performs an operation that resumes (the operation 1.0), and its source `&buf` lends `buf` around the whole loop: an operation that resumes cannot cross a borrow (T1, #172). Iterate an owned array, or a view the function is given
-- Coverage: a suspended machine that borrows from itself is moved between two resumes. `squares`
-- owns its vector and holds an iterator into it across `yield`. `main` stores the generator, pulls
-- one element, hands the suspended generator to `advance`, which pulls again and returns it inside
-- a pair, and then pulls the rest. Between the pulls the machine moves (into a call, into a pair,
-- back out), and the view it holds must stay valid: the vector it points into does not move.
--
-- Issue: #172 (E2: the lend held folded in the machine's state), #682; the pinning report's core
-- case (`scratch-archive/pinning-lit/report.md` §1.2: a reified frame that holds a borrow of its
-- own place, moved as a value).
--
-- Rust: a self-referential `async` block or `static` coroutine must be pinned before it is first
-- resumed (`Box::pin`); the `Pin<Box<…>>` handle moves, the frame does not.
--
-- Today: refused in `squares`, at the `for` over `&buf` whose body yields (T1, #172). Both backends
-- stop at the same message.
--
-- Once it lands: i32[30]: 0 + 1 + 4 + 9 + 16, pulled in three places; `live 0`.

include yield

fn sq(i: i32) -> i32 = i * i

fn squares(n: i32) -> 1 with Yield[i32] =
  let buf = array_new[i32](n, sq);
  for x in &buf { yield(*x) };
  ()

-- The next element (0 at the end) and the generator, still suspended.
fn advance(g: U (pull i32 1 1)) -> i32 * (U (pull i32 1 1) + 1) =
  o <- (nu_out (force g)).1;
  match o {
    inl (x, g) -> (x, inl g)
  | inr d -> match d { inl u -> (0, inr ()) | inr g -> (0, inl g) }
  }

main -> i32 =
  let g : U (pull i32 1 1) = squares(5);
  let (a, r) = advance(g);
  match r {
    inl g ->
      let p = advance(g);
      let (b, r) = p;
      match r {
        inl g -> let mut s = a + b; for x in g { s = s + x }; s
      | inr u -> a + b
      }
  | inr u -> a
  }
