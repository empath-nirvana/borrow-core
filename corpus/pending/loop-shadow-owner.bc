-- now: 17:42: type mismatch: expected `array u8 * i32`, but this has type `i32`
--
-- A name bound in a `for`'s body, inside a borrow block, that is the name of the block's owner.
-- `let (s, c) = (i, 1)` binds a new `s : i32` for the rest of the body; the loop chooses the
-- variables it threads by name, without the body's own bindings, and threads the owner `s`, a
-- string, in its place. With the local renamed the program answers as below.
--
-- Once it lands: `.` and `i32[6]`, `live 0`.

include textio

main -> i32 =
  let s = string_of_lit("abc");
  let n = borrow imm s { 't, t ->
    let mut k = 0;
    for i in 0..3 { let (s, c) = (i, 1); k = k + s + c };
    k };
  print_byte(b'.');
  n
