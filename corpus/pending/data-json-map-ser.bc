-- pending: a load block (`borrow imm *j`) whose body performs an abortive operation has no unwinding form in the elaborator (#879)
-- now: 24:11: this borrow block's body performs an abortive operation, and its place has no unwinding form here: not provided
--
-- J1's need in miniature: a `Json` whose objects are `Map[string, Json]` (SPEC §36, §42)
-- serialised by borrow, recursively, then consumed. `ser` lends the value, matches its view
-- through a load (`borrow imm *j { 'y, v -> … }`), and at an object iterates the entries with
-- `map_entries`, each key printed from its text view and each value serialised by the recursive
-- call. The recursion performs `Exhausted` (SPEC §20), an abortive operation, inside the load
-- block; the kernel's `withload` has its unwinding form (`withloadU`, SPEC §19 *Borrows*), but the
-- load form does not elaborate to it (`unwindingC?`, `Frontend/Sugar.lean`, covers the cell and
-- slice borrows only).
-- `fold_imm` is no way round: `array X` (the map's values) is not a fold shape.
--
-- Answer, once it checks: `{"n":3,"o":{"a":1,"b":null}}` up to the slot order of each object's
-- keys, then `i32[0]` and `live 0` (the value consumed after the walk).
include rec
include textio
include map

data Json = Null | Num(i32) | Obj(Map[string, Json])

-- The value `j` points at, appended to `out` as JSON text.
fn ser<'a>(j: imm 'a Json, out: string) -> string =
  let r = borrow imm *j { 'y, v -> match v {
      Null -> let (o, _) = push_lit(out, "null"); o
    | Num(n) -> let (o, _) = push_dec(out, n); o
    | Obj(m) ->
        let (o, _) = push_byte(out, b'{');
        let mut o = o;
        let mut first = true;
        for e in map_entries(m) {
          let (k, x) = e;
          if first { first = false } else { let (p, _) = push_byte(o, b','); o = p };
          let (p, _) = push_byte(o, b'"');
          let (p, _) = borrow imm *k { 'z, b -> push_str(p, key_prefix(b)) };
          let (p, _) = push_lit(p, "\":");
          o = ser(x, p)
        };
        let (o, _) = push_byte(o, b'}');
        o
    } };
  r

fn obj2(ka: lit, a: Json, kb: lit, b: Json) -> Json =
  let m = map_new[string, Json](2);
  let (m, _) = map_insert(m, string_of_lit(ka), a);
  let (m, _) = map_insert(m, string_of_lit(kb), b);
  Obj(m)

main -> i32 = with on_exhausted(!{ u -> 0 - 1 }) {
  let mut j = obj2("n", Num(3), "o", obj2("a", Num(1), "b", Null));
  let s = ser(&j, string_new(16));
  let s = print_string(s);
  print_byte(b'\n');
  0
}
