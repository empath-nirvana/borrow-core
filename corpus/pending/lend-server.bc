-- pending: #58 (an implicit copy of an `imm` borrow, here one read at each turn of a loop; SPEC §42 Open)
-- now: 33:30: `cfg` is used twice here, and its type `imm 'a (i32 * i32)` is not persistent
--
-- A div function that takes a borrow: `serve` reads its input to the end, handling each byte
-- under a configuration it borrows, and `main` calls it in direct style with
-- `serve(&config, stdin)`.
--
-- The div function's loop reads the borrow `cfg` it is given at each turn, so its state
-- threads it and each turn uses it again; a borrow is not persistent, and an `imm` borrow is
-- not copied implicitly (#58, SPEC §42 Open), so the checker refuses the second use, as it does
-- `corpus/reject/lend-iter-borrow.bc`'s. The lend at the call, across the callee's ticks, is
-- the kind the kernel admits at the graded row `div call` (SPEC §48); it is not reached.
--
-- Once it lands: on the input `1203`, `i32[65]`, `live 0`: the configuration is (step 10, bias 1),
-- so each digit adds `10 * d + 1`, giving 64, and `main` adds the bias read from the configuration
-- it got back.

type Cfg = i32 * i32

-- `acc + step * d + bias`.
def handle : !(all 'a < top. imm 'a Cfg * (i32 * i32) => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a Cfg * (i32 * i32)) ->
    let (cfg, q) = p;
    let (acc, d) = q;
    let (step, bias) = *cfg;
    acc + step * d + bias)

-- Reads its input to the end, handling each byte under the configuration it borrows.
def serve : !(all 'a < top. imm 'a Cfg * ref input => ref input * i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a Cfg * ref input) ->
    let (cfg, i) = p;
    let mut acc = 0;
    for c in bytes(&mut i) { acc = handle(cfg, (acc, to_i32(c) - 48)) };
    (i, acc))

main -> i32 =
  let config = alloc((10, 1));
  let (stdin, n) = serve(&config, stdin);
  let (step, bias) = free(config);
  n + bias
