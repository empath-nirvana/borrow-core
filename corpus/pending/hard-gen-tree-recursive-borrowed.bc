-- pending: SPEC §5 *Open* (E5: a recursive walk of a borrowed tree), with a generator; first #686
-- now: 31:37: `*` reads an `imm` borrow or a cell, but this has type `1`
-- Coverage: the most natural spelling of row 3. A recursive generator walks a borrowed binary search
-- tree in order and yields each key: it recurses on the left child, yields the key, recurses on
-- the right. Each frame of the recursion holds a view of its node, a child of its caller's node at
-- the same lifetime `'a`, across the `yield`s below it.
--
-- Issue: SPEC §5 *Open* and #669's E5 (a child of an `imm` node at the parent's lifetime), H1 ×
-- borrows (a recursive generator whose frames hold views), #682.
--
-- Rust: a recursive `gen` function over `&'a Node` (boxed, as recursive generators must be), or the
-- `Vec<&'a Node>` iterator of row 3.
--
-- Today: refused at `*k`: the binder is typed `1` (#686). Without the `*`, the match reports
-- ``unroll V` needs `V : mu X. A`, but `V : imm 'a (mu …)`` (E5). Both backends stop at the same
-- message.
--
-- Once it lands: i32[1234567], the keys 1 … 7 in order as decimal digits; `live 0`.

include rec
include yield

data Tree = Leaf | Node(left: Tree, key: i32, right: Tree)

fn branch(l: Tree, k: i32, r: Tree) -> Tree = box Node(l, k, r)
fn tip(k: i32) -> Tree = box Node(Leaf, k, Leaf)

fn walk<'a>(t: imm 'a Tree) -> 1 with Yield[i32], Exhausted =
  match t {
    Leaf -> ()
  | Node(l, k, r) -> walk(l); yield(*k); walk(r)
  }

main -> i32 =
  with on_exhausted(!{ u -> 0 - 1 }) {
    let t = branch(branch(tip(1), 2, tip(3)), 4, branch(tip(5), 6, tip(7)));
    let mut acc = 0;
    for k in walk(&t) { acc = acc * 10 + k };
    acc }
