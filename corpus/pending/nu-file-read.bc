-- pending: #808 — a type with a `forall` observation, elaborated in two lifetime contexts, gets two binder names, and the checker compares types syntactically
-- now: 69:52: type mismatch: expected `box ('main /\ top) U (nu X. ((forall 'l4 < top. mut 'l4 i32 -o F (i32 * box ('main /\ top) U X)) & (forall 'l4 < top. imm 'l4 i32 -o F (i32 * box ('main /\ top) U X))) & F i32)`, but this has type `box ('main /\ top) U (nu X. ((forall 'l2 < top. mut 'l2 i32 -o F (i32 * box ('main /\ top) U X)) & (forall 'l2 < top. imm 'l2 i32 -o F (i32 * box ('main /\ top) U X))) & F i32)`
--
-- SPEC §7, §22 (#808): codata whose observations take borrowed arguments. `File<'c>` is a
-- protocol object with three observations: `read` is lent a buffer `mut` for the call, `write`
-- is lent one `imm`, and `close` ends it. Each of `read` and `write` is an observation
-- `forall 'x < top. … 'x … -o …`, so the borrow is lent per call. Each hands back the rest of
-- the object boxed at its bound `'c`, so the object outlives every lend it is called in.
--
-- The state is an owned cell, the file's content. `read` adds the content to the buffer and
-- answers the number of reads so far; `write` stores the buffer into the content.
--
-- `main` lends the buffer `mut` to `read`, takes it back, lends it `imm` to `write`, closes the
-- file (its `close` frees the content) and frees the buffer.
--
-- Answer: i32[12107]: the buffer is 7 + 5 = 12 after the read, the read answers 1, and the
-- content after the write is 12 (12 * 1000 + 1 * 100 + 7, the content freed by `close` read
-- back through the write's answer); `live 0`.

type File<'c> = U (nu X. ((forall 'x < top. mut 'x i32 -o F (i32 * box 'c U X))
                        & (forall 'x < top. imm 'x i32 -o F (i32 * box 'c U X))) & F i32)

-- The state: the content and the number of reads.
fn file_open<'c>(start: i32) -> box 'c File<'c> =
  f <- return (unfold[nu X. ((forall 'x < top. mut 'x i32 -o F (i32 * box 'c U X))
                           & (forall 'x < top. imm 'x i32 -o F (i32 * box 'c U X))) & F i32,
                       ref i32 * i32]
    (!thunkv fun (s : ref i32 * i32) ->
      < < Fun 'x < top. fun (m : mut 'x i32) ->
          let (c, n) = s;
          cx <- return (swap[i32, i32] c i32[0]);
          let (c, k) = cx;
          cu <- return (swap[i32, i32] c k);
          let (c, u) = cu;
          q <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) -> return (v + k, n + 1)));
          let (m, r) = q;
          return (release_mut['x, i32] m);
          return (r, boxed['c] (c, n + 1)),
          Fun 'x < top. fun (b : imm 'x i32) ->
            let (c, n) = s;
            w <- return (*b);
            return (release_imm['x, i32] b);
            cx <- return (swap[i32, i32] c w);
            let (c, old) = cx;
            return (old, boxed['c] (c, n)) >,
        let (c, n) = s;
        return (free[i32] c + n * 0) >));
  s <- return (alloc[i32] start, 0);
  return (boxed['c] (thunkv nu_in
    < < g <- return (unbang f); (nu_out (force g s)).1 .1,
        g <- return (unbang f); (nu_out (force g s)).1 .2 >,
      g <- return (unbang f); (nu_out (force g s)).2 >))

fn file_read<'a, 'c>(f: box 'c File<'c>, b: mut 'a i32) -> i32 * box 'c File<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 .1['a] b

fn file_write<'a, 'c>(f: box 'c File<'c>, b: imm 'a i32) -> i32 * box 'c File<'c> =
  g <- return (unbox f);
  (nu_out (force g)).1 .2['a] b

fn file_close<'c>(f: box 'c File<'c>) -> i32 =
  g <- return (unbox f);
  (nu_out (force g)).2

main -> i32 =
  let buf = alloc(7);
  let f = file_open(5);
  let (r, f) = borrow mut buf { 'w, m -> file_read(f, m) };
  let (old, f) = borrow imm buf { 'w, b -> file_write(f, b) };
  let content = file_close(f);
  let b = free(buf);
  b * 10000 + content * 100 + r * 10 + old
