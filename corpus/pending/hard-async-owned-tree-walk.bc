-- pending: #682 (H3: a task that owns a pointer-linked tree and walks it at O(1) per step)
-- now: 39:11: this borrow block's body performs the operation 1.0, which resumes: only an abortive operation crosses a borrow's scope (a continuation held across a lend is T1, #172)
-- Hard problem 4: a task owns a binary search tree, which it builds itself, and walks it in order
-- without taking it apart, awaiting after every node. Its cursor is a stack of views of its own
-- tree's nodes, live across each `await`; each step pushes or pops one view, O(1), with no path
-- walked again from the root. When the walk ends the task still owns the whole tree, and frees it.
--
-- Issue: #682 (#669's H3, the non-destructive walk). Needs a view held across a suspension into
-- data the task owns (self-reference, E2) and a child view at the parent's lifetime (E5).
-- Re-borrowing from the root at each step types today (#669's `r3`) but costs O(depth) per step,
-- 2.5× Rust; the consuming walk (main's H3 source) destroys the tree.
--
-- Rust: an `async` block that owns `Box<Node>` and holds a `Vec<&Node>` across `.await`; the
-- future is self-referential, so it is `Box::pin`ned before it is polled.
--
-- Today: refused at the task's borrow of its own tree: the body performs `await`, which resumes,
-- and a continuation held across a lend is T1 (#172). Both backends stop at the same message.
--
-- Also needs: implicit copies of `imm` views (`corpus/pending/hard-imm-view-copy.bc`): this
-- program uses a view twice (`cons(cur, todo)` after `match cur`).
--
-- Once it lands: `inr (i32[28], inr (i32[280], inl ()))`, the list [28, 280]: the keys 1 … 7 and
-- 10 … 70 summed by the two tasks, their turns interleaved; `live 0` (each task frees its tree).

include async

data Tree = Leaf | Node(left: Tree, key: i32, right: Tree)

fn branch(l: Tree, k: i32, r: Tree) -> Tree = box Node(l, k, r)
fn tip(k: i32) -> Tree = box Node(Leaf, k, Leaf)

-- The keys 1 … 7 times `m`, as a balanced tree.
fn seven(m: i32) -> Tree =
  branch(branch(tip(m), 2 * m, tip(3 * m)), 4 * m, branch(tip(5 * m), 6 * m, tip(7 * m)))

-- Builds its own tree, then sums its keys in order, one node per turn, and frees the tree.
fn walk(m: i32) -> i32 with Async =
  let t = seven(m);
  let s = borrow imm t { 'a, root ->
    let mut todo : List[imm 'a Tree] = roll inl ();
    let mut cur = root;
    let mut sum = 0;
    let mut more = true;
    while more {
      match cur {
        Node(l, k, r) -> todo = cons(cur, todo); cur = l
      | Leaf -> match unroll todo {
          inl u -> more = false
        | inr (n, rest) -> match n {
            Node(l, k, r) -> sum = sum + *k; await(); todo = rest; cur = r
          | Leaf -> () }
        }
      }
    };
    sum };
  s

main -> List[i32] =
  let q = queue[i32]();
  let q = push(q, with spawn { walk(1) });
  let q = push(q, with spawn { walk(10) });
  run_until_empty(q)
