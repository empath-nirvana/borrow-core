-- pending: a lend held across a tick (a suspension; T1, #172): tier 2 is open and has no path
-- now: 38:28: `b` is used twice here, and its type `imm 'a array i32` is not persistent
--
-- A div function taking a borrow, called from a borrow block. `total_at` sums a table at the
-- elements of a generator, so it loops. `main` calls it twice: lending the table's cell,
-- `total_at(&t)`, and from inside a borrow block of the table, `total_at(b)`.
--
-- Needs a lend held across a tick. Every loop is at the row `div` (SPEC §14), and each of its back
-- edges ticks, a control operation that resumes; the lend `&t` at 43:11 spans the call of
-- `total_at`, whose `for` over a generator at 38:5 ticks and reads the borrow `b` at each turn (the
-- kernel refuses that use first: `b` is not persistent). The kernel's rule for a lend at a row has
-- only abortive operations (`Row.Unwind`), so it refuses the lend. Holding a lend across a
-- suspension is tier 2, which is open and has no path.
--
-- Once it lands: `i32[200]`, `live 0`: the table holds 10 * i, and each call sums the entries 1 to
-- 4, 100.

include yield

fn tab(i: i32) -> i32 = i * 10

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

-- The sum of the entries at 1, 2, 3, 4.
def total_at : !(all 'a < top. imm 'a (array i32) => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (b : imm 'a (array i32)) ->
    let mut acc = 0;
    for i in range(1, 5) { acc = acc + get(b, i) };
    acc)

main -> i32 =
  let t = alloc(array_new[i32] (10, tab));
  let n = total_at(&t);
  let m = borrow imm t { b -> total_at(b) };
  n + m
