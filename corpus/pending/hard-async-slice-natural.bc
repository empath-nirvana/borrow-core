-- pending: #52 (tasks that borrow from their spawner, without a scope cell or a bound on the rounds)
-- now: 31:3: cannot show that `U (delay (mu X. 1 + i32 * X))` outlives `top`
-- The natural form of `corpus/async-slice-iter-await.bc` and `corpus/async-two-readers-views.bc`:
-- two tasks given views of one vector, spawned with `spawn` and run by `run_until_empty` inside the
-- borrow. Those two programs run today only with scaffolding: a unit cell `d` lent `mut` to make a
-- scope `'d` below the borrow, `spawn_in` to box the tasks at `'d`, and `run_in(q, 8)` under
-- `on_exhausted`, a bounded number of rounds, so that the scheduler runs inside the borrow.
--
-- Issue: #52 (a scheduler holding tasks that borrow; `corpus/pending/async-borrow.bc`), #682.
--
-- Rust: `join!(sum_slowly(&v), sum_slowly(&v))`: the futures borrow `v` and the join ends before
-- `v` does; no scope token and no round limit.
--
-- Today: refused: the scheduler's answer cannot be shown to outlive the borrow, as in
-- `corpus/pending/hard-async-mixed-borrowers.bc`. Both backends stop at the same message.
--
-- Once it lands: `inr (i32[100], inr (i32[100], inl ()))`, the list [100, 100]; `live 0`.

include async

-- The sum of the elements, letting the other tasks run after each one.
fn sum_slowly<'a>(xs: array_imm 'a i32) -> i32 with Async =
  let mut s = 0;
  for x in xs { s = s + *x; await() };
  s

fn tab(i: i32) -> i32 = 10 * (i + 1)

main -> List[i32] =
  let v = array_new[i32](4, tab);
  borrow imm v { 'r, xs ->
    let (x1, x2) = array_copy['r, i32](xs);
    let q = queue[i32]();
    let q = push(q, with spawn { sum_slowly(x1) });
    let q = push(q, with spawn { sum_slowly(x2) });
    run_until_empty(q) }
