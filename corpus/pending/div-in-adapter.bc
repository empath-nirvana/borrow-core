-- pending: #161 (effectful callbacks stored: an adapter's function is kept in the generator it makes)
-- A division by a variable inside the function given to an adapter of `lib/adapters.bc`
-- (SPEC §39): `map` stores its function in the generator it answers, so the function is a closure
-- that is not run in place, and an operation in it cannot reach its handler. A `raise` there is
-- refused the same way (SPEC §18 *Not provided*). A literal divisor performs nothing and is
-- accepted (`corpus/div-infer.bc`'s `tenth`).

include adapters

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

main -> i32 =
  let mut a = 0;
  for y in map(range(1, 5), !{ x -> 120 / x }) { a = a + y };
  a
-- now: 17:29: an operation of `Fail` is performed inside a closure or block that is not run in place: it cannot reach its handler (effectful callbacks, #161)
