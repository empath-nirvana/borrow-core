-- pending: refused #502
-- now: 15:3: `a` is used twice here, and its type `array i32` is not persistent
--
-- A counted `for` that lends a linear variable (`at(&a, i, 0)`) inside an `if` arm that is the
-- head of `;`, off the spine. The same loop threading an `i32` is accepted, and so is the same `if`
-- in tail position.
--
-- Once it lands: `i32[3]`, `live 0`.

include slice

fn sum_if(a: array i32, c: bool) -> array i32 * i32 =
  let mut a = a;
  let mut s = 0;
  if c { for i in 0..2 { let x = at(&a, i, 0); s = s + x } } else { () };
  (a, s)

main -> i32 =
  let (a, s) = sum_if(array_new[i32] (2, !{ i -> i + 1 }), true);
  s
