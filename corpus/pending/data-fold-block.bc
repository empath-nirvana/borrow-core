-- pending: §11.1 A2 of docs/data-declarations.md (the `fold` block)
-- A binary tree declared with `data`, built with `box`, and summed through a borrow by a fold
-- block with constructor patterns.
--
-- Axes: data × coeffects × scope. Recursive data (`mu`), each node one block with a cell per
-- field, read through an `imm` borrow by `fold_imm`.
--
-- Blocked by: the `fold` block (§11.1 A2), in which the recursive fields arrive already folded.
-- The declaration, `box Node(…)` and constructor patterns are built (SPEC §42): the tree and its
-- sum by a recursive match that consumes it run as `corpus/data-box-tree.bc`. A recursion over a
-- borrowed tree is the fold's: a load's view is at a lifetime shorter than the borrow's, and a
-- group's members recurse at their own lifetimes (SPEC §20).
--
-- Spelling: `docs/typed-elaboration.md` §5.3's, which the user decided (a node is one block,
-- the allocation is written `box`); the fold block is draft 0's (`docs/surface-cbpv.md` §2.7).
--
-- Today: `fold_imm` is the core constant, which takes its bracket arguments.
--
-- Once it lands: the tree 1 ← 2 → 3 sums to 6. Golden: `i32[6]`, `live 0` (the tree's
-- destructor frees its three nodes).

data Tree = Leaf | Node(left: Tree, val: i32, right: Tree)

fn branch(l: Tree, v: i32, r: Tree) -> Tree = box Node(l, v, r)

fn sum<'a>(t: imm 'a Tree) -> i32 =
  fold_imm t { Leaf -> 0 | Node(l, v, r) -> l + *v + r }

main -> i32 =
  let t = branch(branch(Leaf, 1, Leaf), 2, branch(Leaf, 3, Leaf));
  let n = sum(&t);
  n
