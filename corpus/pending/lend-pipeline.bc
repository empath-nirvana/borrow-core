-- pending: #58 (an implicit copy of an `imm` borrow, here one read at each turn of a loop; SPEC §42 Open)
-- now: 44:49: `b` is used twice here, and its type `imm 'io_l5 array i32` is not persistent
--
-- A borrow block over a pipeline: a table borrowed once, and read by every step of a `for` over a
-- pipeline of generators, `above(20, squares(range(1, 11)))`.
--
-- The lend spans the loop's ticks, which the kernel admits at the graded row `div call`
-- (SPEC §48). The loop then reads the borrow `b` at each turn, so its state threads it and
-- each turn uses it again; a borrow is not persistent, and an `imm` borrow is not copied
-- implicitly (#58, SPEC §42 Open), so the checker refuses the second use, as it does
-- `corpus/reject/lend-iter-borrow.bc`'s.
--
-- Once it lands: `i32[361]`, `live 0`: the table holds i + 1, and the squares above 20 from 1 to 10
-- are 25, 36, 49, 64, 81, 100, so the sum is 355 + 6.

include yield

fn tab(i: i32) -> i32 = i + 1

-- The entry at `i`, or 0 out of range.
def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn squares(it: U (pull i32 1 1)) -> 1 with Yield[i32] =
  for x in it { yield(x * x) };
  ()

fn above(n: i32, it: U (pull i32 1 1)) -> 1 with Yield[i32] =
  for x in it { if n < x { yield(x) } else { () } };
  ()

main -> i32 =
  let t = alloc(array_new[i32] (101, tab));
  let n = borrow imm t { b ->
    let mut acc = 0;
    for x in above(20, squares(range(1, 11))) { acc = acc + get(b, x) };
    acc
  };
  n
