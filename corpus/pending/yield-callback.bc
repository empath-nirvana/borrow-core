-- pending: #161 (effectful callbacks)
-- A callback that yields: `tens` passes `for_each` a closure that yields ten times each element,
-- so that `tens` yields what the callback yields while `for_each` runs.
--
-- Blocked by #161: a block passed to a function is copied at its row (SPEC §29), but the `for`'s
-- site that `tens`'s `yield` goes to threads the loop's variables through the operation, and a
-- block would have to be passed them and hand them back at each call (SPEC §29 *Open*). Until
-- then a generator that maps another is written as a loop over it (`corpus/gen-pipeline.bc`).
--
-- now: 24:25: this block performs `Yield` of an enclosing `for`, which threads its variables through the operation: a block passed to a function does not hand them back (not provided)

include yield

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn for_each(it: U (pull i32 1 1), f: !(i32 => 1)) -> 1 =
  for x in it { f(x) };
  ()

fn tens(n: i32) -> 1 with Yield[i32] =
  for_each(range(0, n), !{ x -> yield(x * 10) })

main -> i32 =
  let mut acc = 0;
  for x in tens(3) { acc = acc + x };
  acc
