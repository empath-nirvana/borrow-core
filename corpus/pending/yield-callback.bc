-- pending: #161 (effectful callbacks)
-- A callback that yields: `tens` passes `for_each` a closure that yields ten times each element,
-- so that `tens` yields what the callback yields while `for_each` runs.
--
-- Blocked by #161: a closure that performs an operation is a computation passed as a value, and
-- the function it is passed to would have to be specialized at the callback's row. Until then a
-- generator that maps another is written as a loop over it (`corpus/gen-pipeline.bc`).
--
-- now: 23:25: an operation of `Yield` is performed inside a closure or block that is not run in place: it cannot reach its handler (effectful callbacks, #161)

include yield

fn range(lo: i32, hi: i32) -> 1 with Yield[i32] =
  let mut i = lo;
  while i < hi { yield(i); i = i + 1 };
  ()

fn for_each(it: U (pull i32 1 1), f: !(i32 => 1)) -> 1 =
  for x in it { f(x) };
  ()

fn tens(n: i32) -> 1 with Yield[i32] =
  for_each(range(0, n), !{ x -> yield(x * 10) })

main -> i32 =
  let mut acc = 0;
  for x in tens(3) { acc = acc + x };
  acc
