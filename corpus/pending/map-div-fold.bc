-- pending: SPEC §14 (a div callback inside a fold)
-- `map` over a list, written once, called with a total callback and with a div one.
--
-- Axes: data × effects (div). A fold of data whose algebra calls a callback that may diverge.
--
-- What already works, in the whole-program case: a higher-order function whose callback is
-- called on its spine is specialized at a div callback's type (SPEC §14; `corpus/div-hof.bc`
-- runs `sum3` with the Collatz `steps`), and this `map` runs with `double` alone.
--
-- Blocked by, here: the surface's elaboration. `map` calls `f` inside the algebra of a
-- `fold_own`, a `!` closure that the fold requires to be total (`!U(A' -o F R)`). The copy of
-- `map` made at `steps`'s type gives `f` a loop type, and a call inside the algebra is not
-- elaborated as a direct-style div call, so `f(x)` is a loop where an `i32` is expected. What
-- would be needed is a fold into the div effect: the algebra's result `R` a loop,
-- `U(loop List 1)`, with the node's work sequenced by `div_bind`. That is expressible in core
-- as far as the types go (`fold_own` takes any `R`; not written or checked here), so this is a
-- matter of elaboration, not of the kernel.
--
-- Beyond the whole program: `map` compiled once, in a library, and called later with callbacks
-- of either kind needs a type ranging over computation types (effect polymorphism), which the
-- core does not have (SPEC §14: "The core has no type ranging over computation types, so this
-- is whole-program monomorphization"), or one representation for both (every callback called
-- as a loop). There is no separate compilation to write that program against yet (#63).
--
-- Spelling: today's surface.
--
-- Today: the checker rejects `f(x)` in the copy of `map` specialized at `steps`: it is a
-- `U (delay i32)` where `i32` is expected.
--
-- Once it lands: [1, 2, 3] doubled is [2, 4, 6], and [6, 7, 27] maps to their Collatz step
-- counts [8, 16, 111]; each list is read as base-1000 digits, head last. Golden:
-- `(i32[6004002], i32[111016008])`, `live 0`.

type List = mu X. 1 + (i32 * X)

def nil : List = roll inl ()
fn cons(x: i32, t: List) -> List = roll inr (x, t)

-- The Collatz steps from `n` (as in `corpus/div-hof.bc`): whether this loop always finishes is
-- open.
def collatz_step : !U (i32 * i32 -o F (i32 + (i32 * i32)) & F 1) =
  !thunkv fun (s : i32 * i32) ->
    < let (n, k) = s;
      if n == 1 { inl k } else {
        if host[and32] (n, 1) == 0 { inr (host[shr_u32] (n, 1), k + 1) }
        else { inr (n * 3 + 1, k + 1) }
      },
      () >

def collatz : i32 => U (loop i32 1) =
  thunkv fun (n : i32) ->
    f <- return (unbang (unfold[loop i32 1, i32 * i32] collatz_step));
    s0 : i32 * i32 <- return (n, i32[0]);
    return (thunkv nu_in < (nu_out (force f s0)).1, (nu_out (force f s0)).2 >)

fn steps(n: i32) -> i32 = collatz(n)
fn double(n: i32) -> i32 = n + n

fn map(f: !(i32 => i32), l: List) -> List =
  (unbang (fold_own[1 + i32 * X, List] (!{ r -> match r { inl _ -> nil | inr (x, t) -> cons(f(x), t) } }))) l

fn digits(l: List) -> i32 =
  (unbang (fold_own[1 + i32 * X, i32] (!{ r -> match r { inl _ -> 0 | inr (x, t) -> x + t * 1000 } }))) l

main -> i32 * i32 =
  let a = digits(map(double, cons(1, cons(2, cons(3, nil)))));
  let b = digits(map(steps, cons(6, cons(7, cons(27, nil)))));
  (a, b)
-- now: 60:93: type mismatch: expected `i32`, but this has type `U (delay i32)`
