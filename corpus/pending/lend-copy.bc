-- pending: a lend held across a tick (a suspension; T1, #172): tier 2 is open and has no path
-- now: 33:13: the row of an unwinding borrow's callback has only abortive operations, of names other than 0, whose arguments outlive every lifetime and do not mention its lifetime
--
-- A copy of a borrow block's borrow is the borrow: the borrow is identified by its binder,
-- followed through copies, `let b2 = b` and `let mut v = v`. `sum` reads a table through a copy
-- of an `imm` borrow; `rev` reverses an array through a `let mut` copy of a `mut` borrow,
-- assigned at each step (#617); `late` copies the borrow after a statement that does not use it.
--
-- Needs a lend held across a tick. Every loop is at the row `div` (SPEC §14), and each of its back
-- edges ticks, a control operation that resumes; the borrows at 33:13, 42:3 and 51:14 span the
-- ticks of the `while` loops in their bodies. The kernel's rule for a lend at a row has only
-- abortive operations (`Row.Unwind`), so it refuses the lend. Holding a lend across a suspension is
-- tier 2, which is open and has no path.
--
-- Once it lands: `(i32[30], (i32[321], i32[6]))`, `live 0`: 0 + 10 + 20; the array [1, 2, 3]
-- reversed, read as the digits of 3·100 + 2·10 + 1; and 1 + 2 + 3 through a copy bound after `let k
-- = 1`.
include slice

fn tab(i: i32) -> i32 = i * 10

def get : !(all 'a < top. imm 'a (array i32) * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a (array i32) * i32) ->
    let (b, i) = p;
    withload['a, 'z, array i32, i32] b (thunkv Fun 'z < dom. return (thunkv fun (xs : array_imm 'z i32) ->
      match array_get['z, i32] (xs, i) { inl e -> let v = *e; boxed['z] v | inr _ -> boxed['z] 0 })))

fn digit(i: i32) -> i32 = i + 1

main -> i32 * (i32 * i32) =
  let t = alloc(array_new[i32](10, tab));
  let mut i = 0;
  let sum = borrow imm t { 'x, b ->
    let b2 = b;
    let mut acc = 0;
    while i < 3 { acc = acc + get(b2, i); i = i + 1 };
    acc
  };
  let mut a = array_new[i32](3, digit);
  let mut lo = 0;
  let mut hi = 2;
  borrow mut a { v ->
    let mut v = v;
    while lo < hi { v = swap_at(v, lo, hi); lo = lo + 1; hi = hi - 1 };
    discard_mut(v) };
  let d0 = at(&a, 0, 0);
  let d1 = at(&a, 1, 0);
  let d2 = at(&a, 2, 0);
  let rev: i32 = d0 * 100 + d1 * 10 + d2;
  let mut j = 0;
  let late = borrow imm t { 'y, c ->
    let k = 1;
    let c2 = c;
    let mut s = 0;
    while j < 3 { s = s + get(c2, j) / 10 + k; j = j + 1 };
    s
  };
  free(t);
  (sum, (rev, late))
