-- pending: SPEC §5 *Open* (E5: a cursor that moves from an `imm` node to its child, at the same lifetime); first #686
-- now: 38:12: `*` reads an `imm` borrow or a cell, but this has type `1`
-- Hard problem 13: no suspension at all. `contains` looks a key up in a borrowed binary search
-- tree with a loop: its cursor starts at the root and moves to the left or right child at each
-- step, O(depth) in all, nothing copied. The cursor is a view of a node, and each child it moves
-- to is viewed at the lifetime of the borrow of the root.
--
-- Issue: #669's E5 (a partial walk of `mu` under `imm`; SPEC §5 *Open*), #682. `fold_imm` is the
-- only eliminator of `imm (mu …)`, and it visits every node: a lookup by fold is O(n), and a
-- cursor held in a loop has no term (#669's `h8c`, quadratic when written by copying).
--
-- Rust: `let mut cur = &root; loop { match cur { Leaf => break false, Node(l, k, r) => { if *k ==
-- key { break true } cur = if key < *k { l } else { r } } } }`; `l: &'a Tree` from `cur: &'a Tree`.
--
-- Today: refused at `*key`: the binder is typed `1` (#686, the elaborator's fallback). Without the
-- `*`, the same match reports the intended obstacle, ``unroll V` needs `V : mu X. A`, but
-- `V : imm 'a (mu …)`` (E5; #686 records the probe). Both backends stop at the same message.
--
-- Also needs: implicit copies of `imm` views (`corpus/pending/hard-imm-view-copy.bc`): this
-- program uses a view twice (`*key` read twice).
--
-- Once it lands: i32[101]: 5 is in the tree 1 … 7, 8 is not, and 1 is (1, 0, 1 as digits);
-- `live 0`.

data Tree = Leaf | Node(left: Tree, key: i32, right: Tree)

fn branch(l: Tree, k: i32, r: Tree) -> Tree = box Node(l, k, r)
fn tip(k: i32) -> Tree = box Node(Leaf, k, Leaf)

fn contains<'a>(t: imm 'a Tree, k: i32) -> i32 =
  let mut cur = t;
  let mut found = 0;
  let mut more = true;
  while more {
    match cur {
      Leaf -> more = false
    | Node(l, key, r) ->
        if *key == k { found = 1; more = false }
        else if k < *key { cur = l }
        else { cur = r }
    }
  };
  found

main -> i32 =
  let t = branch(branch(tip(1), 2, tip(3)), 4, branch(tip(5), 6, tip(7)));
  let a = contains(&t, 5);
  let b = contains(&t, 8);
  let c = contains(&t, 1);
  a * 100 + b * 10 + c
