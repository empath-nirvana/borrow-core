-- J1's need in miniature (#65): a `Json` whose objects are `Map[string, Json]` (SPEC §36, §42),
-- serialised by borrow, recursively, then consumed. `ser` lends the value, matches its view
-- through a load (`borrow imm *j { 'y, v -> … }`), and at an object iterates the entries with
-- `map_entries`, printing each key from its text view and serialising each value by the recursive
-- call. The recursion performs `Exhausted` (SPEC §20), an abortive operation, inside the load
-- block, so the load is `withloadU` (SPEC §19 *Borrows*, #887). The recursive call is at the
-- load's shorter lifetime `'y`: each member's lifetime parameters are instantiated afresh at each
-- call (SPEC §31 *Generic recursive groups*, #890).
--
-- Answer: `{"o":{"b":null,"a":1},"n":3}` (each object's keys in the map's slot order), then
-- `i32[0]` and `live 0` (the value consumed after the walk). A walk that consumed the value would
-- leave nothing to consume after it; one that skipped a level drops a key; a leaked key string or
-- view shows in `live`.
include rec
include textio
include map

data Json = Null | Num(i32) | Obj(Map[string, Json])

-- The value `j` points at, appended to `out` as JSON text.
fn ser<'a>(j: imm 'a Json, out: string) -> string =
  let r = borrow imm *j { 'y, v -> match v {
      Null -> let (o, _) = push_lit(out, "null"); o
    | Num(n) -> let (o, _) = push_dec(out, n); o
    | Obj(m) ->
        let (o, _) = push_byte(out, b'{');
        let mut o = o;
        let mut first = true;
        for e in map_entries(m) {
          let (k, x) = e;
          if first { first = false } else { let (p, _) = push_byte(o, b','); o = p };
          let (p, _) = push_byte(o, b'"');
          let (p, _) = borrow imm *k { 'z, b -> push_str(p, key_prefix(b)) };
          let (p, _) = push_lit(p, "\":");
          o = ser(x, p)
        };
        let (o, _) = push_byte(o, b'}');
        o
    } };
  r

fn obj2(ka: lit, a: Json, kb: lit, b: Json) -> Json =
  let m = map_new[string, Json](2);
  let (m, _) = map_insert(m, string_of_lit(ka), a);
  let (m, _) = map_insert(m, string_of_lit(kb), b);
  Obj(m)

main -> i32 = with on_exhausted(!{ u -> 0 - 1 }) {
  let mut j = obj2("n", Num(3), "o", obj2("a", Num(1), "b", Null));
  let s = ser(&j, string_new(16));
  let s = print_string(s);
  print_byte(b'\n');
  0
}
