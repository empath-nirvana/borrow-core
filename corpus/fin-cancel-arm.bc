-- A continuation resumed on one path of a clause and dropped on the other (SPEC §12, §27; #953):
-- `tm` has a state (its parameter `flag`), so its clause is the state's function, and the drop is
-- placed by the same rule inside it: the arm that does not use `k` cancels it at its end. Here
-- `flag` is `false`: `k` is cancelled, the body's cleanup raises `3`, kept and re-raised at the
-- canceller, and `to_result` catches it. With `true` the body resumes and answers `5`.
--
-- Answer: (inr i32[3], inl (inl i32[5])), and `live 0`.

include fail

effect Wait { ctl wait() }

handler tm[A](flag: bool): Wait, A -> A + 1 = {
  return(x) = inl x;
  wait(k) = if flag { k(()) } else { inr () }
}

fn work() -> i32 with Wait, Fail[i32] = x <- wait() unwind (let r = raise((3 : i32)); ()); 5

fn go(flag: bool) -> (i32 + 1) + i32 = with to_result[i32, i32 + 1] { with tm[i32](flag) { work() } }

main -> ((i32 + 1) + i32) * ((i32 + 1) + i32) = let a = go(false); let b = go(true); (a, b)
