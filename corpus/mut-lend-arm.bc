#! dialect 82
# A lend of a `let mut` place inside an arm (`&mut x`) rebinds the place: the arm writes it, and
# the join hands it on (SPEC §41, rule R2).
#
# Answer: i32[12].
fn add<'a>(c: mut 'a i32, k: i32) : 1 { modify c { v -> v + k }; release_mut['a, i32](c)
}
fn main() : i32 {
  var x = 1
  if x == 1 { add(&x, 10); () } else { () }
  add(&x, 1)
  x
}
