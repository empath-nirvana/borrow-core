-- SPEC §19 in the core text: an abortive operation `1.0 aff i32 ~> 0` (a `Fail` over `i32`), and
-- its handler `to_result` turning an abort into a sum. `check` aborts with `7` at `0` and answers
-- its argument otherwise; it is a function at the row of the operation, called under
-- `handle_with[1]`, which holds its answer clause and the tuple of its clauses.
--
-- Answer: (inl i32[5], inr i32[7]): the call at `5` returns, the call at `0` aborts.

def check : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

main : F ((i32 + i32) * (i32 + i32)) =
  a <- return i32[5];
  r1 <- handle_with[1](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (f <- return (unbang check); force f a);
  b <- return i32[0];
  r2 <- handle_with[1](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (g <- return (unbang check); force g b);
  return (r1, r2)
