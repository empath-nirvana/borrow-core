-- A loop-invariant borrow (SPEC §14, borrow scopes over loops). `let cfg = &config` borrows the
-- configuration `imm` for the rest of `main`; the code before the loop reads it, every step of
-- the loop reads it, and the code after the loop reads it again.
--
-- `let cfg = &config; S` is the borrow block `borrow imm config { cfg -> S }`, and `S` loops, so
-- it is lent per observation: `config` moves into the loop's state, and the stretch before the
-- loop, each step, and the stretch after it each borrow it for themselves. `step` and `limit`,
-- read before the loop, are `i32`s and outlive the borrow, so the loop can keep them. The calls
-- `scale(cfg, …)` and `cap(cfg, …)` take the lifetime of `cfg` from their argument.
--
-- Answer: i32[54] on the input `1203`: the configuration is (step 10, limit 100, bias 2); each
-- digit adds `10 * d + 2`, giving 12, 34, 36, 68, which is under the limit, less 7 * 2 read after
-- the loop. Steps that ignored the bias give 46; a loop that did not thread `acc` gives 18; a
-- result that skipped the borrow after the loop gives 68.

type Cfg = i32 * (i32 * i32)

-- `acc + step * d + bias`.
def scale : !(all 'a < top. imm 'a Cfg * (i32 * i32) => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a Cfg * (i32 * i32)) ->
    let (cfg, q) = p;
    let (acc, d) = q;
    let (step, r) = *cfg;
    let (limit, bias) = r;
    acc + step * d + bias)

-- `n` capped at the limit, less seven times the bias.
def cap : !(all 'a < top. imm 'a Cfg * i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (p : imm 'a Cfg * i32) ->
    let (cfg, n) = p;
    let (step, r) = *cfg;
    let (limit, bias) = r;
    let m = if limit < n { limit } else { n };
    m - 7 * bias)

main -> i32 =
  let config = alloc((10, (100, 2)));
  let cfg = &config;
  let mut acc = 0;
  for c in bytes(&mut stdin) { acc = scale(cfg, (acc, c - 48)) };
  cap(cfg, acc)
