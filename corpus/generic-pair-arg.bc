-- A pair as the argument of a generic function (SPEC §15, #135): the type arguments are read off
-- the arguments' types, and an argument that is a pair is one argument, of a `*` type, matched
-- against its parameter whole. `apply` and `snd` take a pair at a type parameter; `flip` takes
-- one at a parameter of a `*` type.
--
-- Answer: `(7, ((3, 4), (true, 5)))`.

fn apply[A, B](f: !(A => B), a: A) -> B = f(a)

fn snd[A, B](a: A, b: B) -> B = b

fn flip[A, B](p: A * B) -> B * A = let (a, b) = p; (b, a)

main -> i32 * ((i32 * i32) * (bool * i32)) =
  (apply(!{ p -> let (x, y) = p; x + y }, (3, 4)), (snd(1, (3, 4)), flip((5, true))))
