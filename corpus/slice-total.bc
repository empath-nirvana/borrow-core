-- Total functions that iterate views (SPEC §16, the total `for`): each `for` is over a view's
-- iterator (`iter_imm`, `iter_mut`, `lib/slice.bc`) or a `range`, a bounded source, so it is a
-- counted loop and every function here is `total`. `sum` and `max` read each element through
-- its `imm` leaf with `*x`; `count_in` nests a `for` over a range inside a `for` over a view;
-- `clamp` writes each element through its `mut` leaf. `main` lends the owned array to each with
-- `&a` or `&mut a` (SPEC §9), for one call, with no cell.
--
-- Answer: (i32[31], (i32[9], (i32[3], i32[26]))): the sum of 3, 1, 4, 1, 5, 9, 2, 6; its
-- largest element; how many elements lie in [2, 5), counted by comparing each with every number
-- of the range; and the sum after clamping to at most 5. A loop that missed the last element
-- gives 25 for the first sum. One allocation, the array; no dispatched call.

include slice

fn digits(i: i32) -> i32 =
  if i == 0 { 3 } else { if i == 1 { 1 } else { if i == 2 { 4 } else { if i == 3 { 1 } else {
  if i == 4 { 5 } else { if i == 5 { 9 } else { if i == 6 { 2 } else { 6 } } } } } } }

total fn sum<'a>(v: array_imm 'a i32) -> i32 =
  let mut acc = 0;
  for x in iter_imm(v) { acc = acc + *x };
  acc

total fn max<'a>(v: array_imm 'a i32) -> i32 =
  let mut m = 0 - 2147483647;
  for x in iter_imm(v) { let e = *x; if m < e { m = e } };
  m

total fn count_in<'a>(v: array_imm 'a i32, lo: i32, hi: i32) -> i32 =
  let mut k = 0;
  for x in iter_imm(v) {
    let e = *x;
    for i in range(lo, hi) { if e == i { k = k + 1 } }
  };
  k

total fn clamp<'a>(v: array_mut 'a i32, hi: i32) -> 1 =
  for x in iter_mut(v) { modify x { e -> if hi < e { hi } else { e } } }

main -> i32 * (i32 * (i32 * i32)) =
  let mut a = array_new[i32] (8, digits);
  let s = sum(&a);
  let m = max(&a);
  let k = count_in(&a, 2, 5);
  clamp(&mut a, 5);
  let t = sum(&a);
  (s, (m, (k, t)))
