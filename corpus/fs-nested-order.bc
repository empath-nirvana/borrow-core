-- check: old-backend-refuses
-- Destructors under two nested handler sites of `Fs` (SPEC §62), `fs-nested-sites` with the sites
-- swapped: `quiet` is the outer site and `fake` the inner one, which handles every operation the
-- functions perform and prints each close with the file's descriptor (its path's length), so the
-- order the destructors run in is the output. Each function holds a file across an operation of
-- `Fs`; at `exit_two`'s normal exit and on `raise_two`'s unwind, the file opened last is closed
-- first.
include fs
include textio

handler quiet[A]: Fs, A -> A = {
  return(a) = a;
  fs_open(p, m, k) = {
    let (a, n) = p;
    if n == 0 { k(((a, n), (inr NotFound : File + FsError))) } else { k(((a, n), (inl file_mk(n) : File + FsError))) }
  };
  fs_read(f, b, k) = { k((f, (b, (inl 0 : i32 + FsError)))) };
  fs_write(f, b, k) = { k((f, (b, (inl () : 1 + FsError)))) };
  fs_size(f, k) = { k((f, (inl 0 : i32 + FsError))) };
  fs_close(f, k) = {
    let d = file_take(f);
    k((inl () : 1 + FsError))
  }
}

handler fake[A]: Fs, A -> A = {
  return(a) = a;
  fs_open(p, m, k) = {
    let (a, n) = p;
    if n == 0 { k(((a, n), (inr NotFound : File + FsError))) } else { k(((a, n), (inl file_mk(n) : File + FsError))) }
  };
  fs_read(f, b, k) = { k((f, (b, (inl 0 : i32 + FsError)))) };
  fs_write(f, b, k) = { k((f, (b, (inl () : 1 + FsError)))) };
  fs_size(f, k) = { k((f, (inl 0 : i32 + FsError))) };
  fs_close(f, k) = {
    let d = file_take(f);
    print_lit("close ");
    print_dec(d);
    print_lit("\n");
    k((inl () : 1 + FsError))
  }
}

fn exit_two() -> i32 with Fs, Fail[FsError] =
  let (p, a) = open(string_of_lit("ab"), Reading);
  let (q, b) = open(string_of_lit("abc"), Reading);
  let (b, n) = fs_size(b);
  7

fn close_two() -> i32 with Fs, Fail[FsError] =
  let (p, a) = open(string_of_lit("ab"), Reading);
  let (q, b) = open(string_of_lit("abc"), Reading);
  let (b, n) = fs_size(b);
  close(b);
  close(a);
  7

fn raise_two() -> i32 with Fs, Fail[FsError] =
  let (p, a) = open(string_of_lit("abcd"), Reading);
  let (q, b) = open(string_of_lit("abcde"), Reading);
  let (r, c) = open(string_of_lit(""), Reading);
  close(c);
  close(b);
  close(a);
  0

main -> (i32 + FsError) * ((i32 + FsError) * (i32 + FsError)) =
  with quiet {
    with fake {
      let x = with to_result { exit_two() };
      let y = with to_result { close_two() };
      let z = with to_result { raise_two() };
      (x, (y, z))
    }
  }
