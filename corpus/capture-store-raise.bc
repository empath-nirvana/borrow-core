-- An abortive handler inside a resuming one whose clause stores the continuation (SPEC §19).
-- `task` answers a `Task`, a stream that holds `κ`'s resume and cancel entries, and `main` steps
-- it: `f` suspends with `await` to `task` and raises to the inner `to_result`, which catches in
-- the resumed continuation. The stored cancel entry is never run, and its call of `f`'s resume
-- code raises nothing (`Backend/Clos/Unwind.lean`).
--
-- Answer: (inl i32[4], i32[1]): the first step yields the suspended task, the second its answer,
-- `inl 4`.

include fail
effect Async { ctl await() }

type Task[A] = U (nu X. F (A + U X) & F 1)

handler task[A]: Async, A -> Task[A] = {
  return(v) = (thunkv nu_in < return (inl v), return () >);
  await(k) = (thunkv nu_in < u <- return (); t <- (force k).1 u; return (inr t), (force k).2 >)
}

fn f(x: i32) -> i32 with Async, Fail[i32] = await(); if x > 5 { raise(x) } else { x + 1 }

main -> (i32 + i32) * i32 =
  let t = with task { with to_result[i32, i32] { f(3) } };
  o <- (nu_out (force t)).1;
  match o { inl v -> (v, 0) | inr t -> o2 <- (nu_out (force t)).1; match o2 { inl v -> (v, 1) | inr t -> c <- (nu_out (force t)).2; (inr 0, 2) } }
