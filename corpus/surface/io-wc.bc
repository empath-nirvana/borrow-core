-- `corpus/io-wc.bc` in draft 0's surface (typed elaboration, stages 5–7): lines, words and bytes
-- of the input. `let mut` variables are assigned in the loop's body and in `if`s, which hand them
-- on; the loop threads them at their inferred types. `bool` and `false` come from the prelude, and
-- `||` does not evaluate its right operand when the left decides. `&mut c` lends a capability
-- that comes back to its name. `count` is div (it has a `for`), and so is `main`, which calls it.
--
-- Answer: `3 10 50` and (i32[3], (i32[10], i32[50])), as `corpus/io-wc.bc` (the same input and
-- golden output).

-- Space, newline or tab.
fn is_space(b: u8) -> bool = b == 32 || b == 10 || b == 9

fn count(c: In) -> In * (i32 * (i32 * i32)) =
  let mut lines = 0;
  let mut words = 0;
  let mut chars = 0;
  let mut in_word = false;
  for b in bytes(&mut c) {
    chars = chars + 1;
    if b == 10 { lines = lines + 1 };
    if is_space(b) { in_word = false }
    else { if not(in_word) { words = words + 1 }; in_word = true }
  };
  (c, (lines, (words, chars)))

main -> i32 * (i32 * i32) =
  let (lines, (words, chars)) = count(&mut stdin);
  put_dec(&mut stdout, lines); putb(&mut stdout, 32);
  put_dec(&mut stdout, words); putb(&mut stdout, 32);
  put_dec(&mut stdout, chars); putb(&mut stdout, 10);
  (lines, (words, chars))
