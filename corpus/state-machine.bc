-- A connection's state machine driven by a stream of events. The events come from a generator
-- (`script`, `Yield`); a `for` feeds each to `step`, which answers the next state or raises
-- `Fail[i32]` for an event the current state does not accept. The driver handles the error per
-- event: it records the rejected event and stays in the same state. It also counts the data
-- received while established. (`corpus/pending/state-machine-audit.bc` is this program with the
-- records kept by an answering effect's handler instead of the loop's variables.)
--
-- States: 0 closed, 1 listening, 2 established, 3 closing. Events: 10 open, 11 connect,
-- 12 data (its payload in the next event), 13 fin, 14 ack, 15 reset.
--
-- Exercises: a generator consumed by a `for` whose body handles an error per element, a state
-- machine over `i32` constants, `break` out of the generator once the machine is closed for
-- good, and the loop's value with its variables read after it.
--
-- Answer: `(i32[0], (i32[2], (i32[11], i32[12])))`: the machine ends closed; two events were
-- rejected (`data` while only listening, and `connect` while established), the last being
-- `connect` (11); 12 bytes were received (5 and 7). `live 0`. A driver that stopped at the first
-- rejected event ends listening; one that lost the payload counts 0 bytes.

include yield
include fail

def s_closed : i32 = 0
def s_listen : i32 = 1
def s_up : i32 = 2
def s_closing : i32 = 3

def e_open : i32 = 10
def e_connect : i32 = 11
def e_data : i32 = 12
def e_fin : i32 = 13
def e_ack : i32 = 14
def e_reset : i32 = 15

-- The next state on `ev`, or the event raised when `s` does not accept it.
fn step(s: i32, ev: i32) -> i32 with Fail[i32] =
  if ev == e_reset { s_closed }
  else { if s == s_closed { if ev == e_open { s_listen } else { raise(ev) } }
  else { if s == s_listen { if ev == e_connect { s_up } else { raise(ev) } }
  else { if s == s_up {
           if ev == e_data { s_up } else { if ev == e_fin { s_closing } else { raise(ev) } } }
  else { if ev == e_ack { s_closed } else { raise(ev) } } } } }

-- A session: open, a stray data event, connect, two payloads, a stray connect, fin, ack; then
-- events that must not be read.
fn script() -> 1 with Yield[i32] =
  yield(e_open); yield(e_data); yield(e_connect);
  yield(e_data); yield(5); yield(e_data); yield(7);
  yield(e_connect); yield(e_fin); yield(e_ack);
  yield(e_open); yield(e_connect);
  ()

-- Runs the machine until it closes after having been established: its last state, the number of
-- rejected events, the last one rejected, and the bytes received.
fn drive() -> i32 * (i32 * (i32 * i32)) =
  let mut s = s_closed;
  let mut payload = false;
  let mut was_up = false;
  let mut rejected = 0;
  let mut last = 0;
  let mut bytes = 0;
  for ev in script() {
    if payload { bytes = bytes + ev; payload = false }
    else {
      match with to_result { step(s, ev) } {
        inl next ->
          if s == s_up && ev == e_data { payload = true } else { () };
          if next == s_up { was_up = true } else { () };
          s = next
      | inr bad -> rejected = rejected + 1; last = bad
      };
      if s == s_closed && was_up { break } else { () }
    }
  };
  (s, (rejected, (last, bytes)))

main -> i32 * (i32 * (i32 * i32)) = drive()
