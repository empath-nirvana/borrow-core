-- Advent of Code 2021, day 10, ported from `src/year2021/day10.rs` of
-- maneatingape/advent-of-code-rust. Copyright © 2023-2026 maneatingape. MIT License:
-- `corpus/aoc/LICENSE.md`.
--
-- The puzzle: each line is a run of brackets `()[]{}<>`. A corrupted line closes a bracket with the
-- wrong kind; part 1 sums a score of the first wrong closing bracket of each. The other lines are
-- incomplete; each is scored by the brackets that would complete it, as a base-5 number, and part
-- 2 is the middle score.
--
-- The port keeps the open brackets on a stack, a buffer reused from line to line, and leaves a
-- line at its first mismatch (`break` out of the counted loop over the view). The completion
-- scores are `i64`, collected into a buffer and sorted. Strings, a stack, sorting and 64-bit
-- arithmetic.
--
-- The stack is the first parameter of `syntax`, before the view: with the view first and the
-- buffer, a pair, last, the `for` over the view is taken for a loop of unknown bound (#491).
--
-- Answer on `2021-10.in` (`corpus/aoc/gen.py`), as the Rust solution gives: `178827` and
-- `59260921449`, one per line, then `(i64[178827], i64[59260921449])`.

include textio

-- The opening bracket a closing one matches, and the closing one's score when it is the first
-- that does not match.
fn opener(b: u8) -> u8 =
  if b == b')' { b'(' } else { if b == b']' { b'[' } else { if b == b'}' { b'{' } else { b'<' } } }

fn error_score(b: u8) -> i64 =
  if b == b')' { i64[3] } else { if b == b']' { i64[57] }
  else { if b == b'}' { i64[1197] } else { i64[25137] } } }

-- What an opening bracket left open adds to the completion's score.
fn close_score(b: u8) -> i64 =
  if b == b'(' { i64[1] } else { if b == b'[' { i64[2] }
  else { if b == b'{' { i64[3] } else { i64[4] } } }

fn is_open(b: u8) -> bool = b == b'(' || b == b'[' || b == b'{' || b == b'<'

-- One line, with the stack of its open brackets (reused from line to line): the score of its
-- first closing bracket that does not match, or 0 when there is none, and the stack left.
fn syntax<'t>(stack: buf u8, l: text 't) -> buf u8 * i64 =
  let mut stack = clear(stack);
  let mut score = i64[0];
  for p in l {
    let b = *p;
    if is_open(b) { let (s, _) = push(stack, b); stack = s } else {
      let (s, last) = pop(stack);
      stack = s;
      let o : u8 = match last { inl x -> x | inr u -> 0 };
      if o != opener(b) { score = error_score(b); break } else { () }
    }
  };
  (stack, score)

-- The score of the brackets that close what is left open, innermost first.
fn completion(stack: buf u8) -> buf u8 * i64 =
  let (stack, n) = len_of(stack);
  let mut score = i64[0];
  let (a, m) = stack;
  for i in 0..n {
    let b = at(&a, n - 1 - i, 0);
    score = 5 * score + close_score(b)
  };
  ((a, m), score)

fn cmp_i64(x: i64, y: i64) -> i32 = if x < y { 0 - 1 } else { if y < x { 1 } else { 0 } }

-- Part 1 sums the scores of the corrupted lines; part 2 is the middle score of the completions
-- of the others.
fn line<'t>(st: (buf u8 * buf i64) * i64, l: text 't) -> (buf u8 * buf i64) * i64 =
  let ((stack, done), corrupt) = st;
  let (stack, e) = syntax(stack, l);
  if e == i64[0] {
    let (stack, c) = completion(stack);
    let (done, _) = push(done, c);
    ((stack, done), corrupt)
  } else { ((stack, done), corrupt + e) }

main -> i64 * i64 =
  let s = read_input();
  let r = borrow imm s { 't, t ->
    fold_lines(t, !{ (l, st) -> line(st, l) }, ((box buf[u8](16), box buf[i64](16)), i64[0])) };
  let ((_, done), p1) = r;
  let mut done = done;
  borrow mut done { 'x, v -> let v = sort(v, cmp_i64, i64[0]); () };
  let (done, n) = len_of(done);
  let (a, _) = done;
  let p2 = at(&a, host[shr_u32](n, 1), i64[0]);
  print_dec64(p1); print_byte(b'\n');
  print_dec64(p2); print_byte(b'\n');
  (p1, p2)
