-- Advent of Code 2022, day 12, ported from `src/year2022/day12.rs` of
-- maneatingape/advent-of-code-rust. Copyright © 2023-2026 maneatingape. MIT License:
-- `corpus/aoc/LICENSE.md`.
--
-- The puzzle: a grid of elevations `a`–`z`, a start `S` (at `a`) and a summit `E` (at `z`). A step
-- goes to a neighbour at most one higher. Part 1 is the fewest steps from `S` to `E`, part 2 the
-- fewest from any square at `a`.
--
-- The port, as the Rust, searches backwards from `E`, breadth first, so that one search answers
-- either part by where it stops. The grid is the input's bytes without newlines; the queue is an
-- array holding each square at most once, with a head and a tail. A 2D grid, neighbour walks and
-- BFS.
--
-- Answer on `2022-12.in` (`corpus/aoc/gen.py`), as the Rust solution gives: `63` and `64`, one per
-- line, then `(i32[63], i32[64])`.

include textio

-- `a / b`, for `b > 0`.
fn quot(a: i32, b: i32) -> i32 = match host[div_s32](a, b) { inl q -> q | inr u -> 0 }

-- A grid of bytes, row by row, and its width and height.
type Grid = array u8 * (i32 * i32)

-- The lines of `t` as a grid; its width is the first line's length.
fn grid_of<'t>(t: text 't) -> Grid =
  let (t, u) = array_copy['t, u8] t;
  let (t, v) = array_copy['t, u8] t;
  let w = match find(u, b'\n', eq_u8) { inl k -> k | inr _ -> 0 };
  let mut cells = box buf[u8](len(v));
  for p in t { let b = *p; if b != b'\n' { let (c, _) = push(cells, b); cells = c } else { () } };
  let (a, n) = cells;
  (a, (w, quot(n, w)))

-- The elevation of a square: `S` is at `a`, `E` at `z`.
fn height(b: u8) -> i32 = if b == b'S' { 97 } else { if b == b'E' { 122 } else { to_i32(b) } }

-- The neighbour of `p` in direction `d` (up, right, down, left), or `-1` off the grid.
fn step(p: i32, d: i32, w: i32, h: i32) -> i32 =
  let x = p - quot(p, w) * w;
  let y = quot(p, w);
  let nx = if d == 1 { x + 1 } else { if d == 3 { x - 1 } else { x } };
  let ny = if d == 0 { y - 1 } else { if d == 2 { y + 1 } else { y } };
  if 0 <= nx && nx < w && 0 <= ny && ny < h { ny * w + nx } else { 0 - 1 }

-- The fewest steps from the summit `E` down to the nearest square holding `goal`, walking the
-- climb backwards: from a square to a neighbour at most one lower than it. A breadth-first search
-- whose queue is an array of squares with their distances: each square joins it at most once.
fn bfs(g: Grid, start: i32, goal: u8) -> Grid * i32 =
  let (a, (w, h)) = g;
  let n = w * h;
  let mut a = a;
  let mut seen = array_set(array_new[bool] (n, !{ i -> false }), start, true);
  let mut queue = array_set(array_new[i32 * i32] (n, !{ i -> (0, 0) }), 0, (start, 0));
  let mut head = 0;
  let mut tail = 1;
  let mut answer = 0 - 1;
  for _ in 0..n {
    if head == tail { break } else { () };
    let (p, c) = at(&queue, head, (0, 0));
    head = head + 1;
    let b = at(&a, p, 0);
    if b == goal { answer = c; break } else { () };
    for d in 0..4 {
      let q = step(p, d, w, h);
      if 0 <= q {
        let been = at(&seen, q, true);
        let nb = at(&a, q, 0);
        if not(been) && height(b) - height(nb) <= 1 {
          queue = array_set(queue, tail, (q, c + 1));
          tail = tail + 1;
          seen = array_set(seen, q, true)
        } else { () }
      } else { () }
    }
  };
  ((a, (w, h)), answer)

main -> i32 * i32 =
  let s = read_input();
  let g = borrow imm s { 't, t -> grid_of(t) };
  let (a, wh) = g;
  let (a, n) = array_size[u8](a);
  let start = borrow imm a { 'x, v -> match find(v, b'E', eq_u8) { inl k -> k | inr _ -> 0 } };
  let (g, p1) = bfs((a, wh), start, b'S');
  let (g, p2) = bfs(g, start, b'a');
  print_dec(p1); print_byte(b'\n');
  print_dec(p2); print_byte(b'\n');
  (p1, p2)
