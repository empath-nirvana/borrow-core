-- `linear-move-in-restore.bc` with the handler applied by `|>` (`theory/linear-state` probe p05;
-- must not regress): `fill(b, k - i) |> to_result[…]` moves the `let mut` string `b` into the
-- handled computation, and both arms of the `match` write `b` back.
--
-- Answer: `(i32[303], i32[4294967196])`, as `linear-move-in-restore.bc`.

include fail
include text

fn fill(s: string, k: i32) -> string * i32 with Fail[i32] =
  if k < 0 { raise(k) } else { let (s, u) = push_byte(s, b'x'); len_of(s) }

fn go(k: i32) -> i32 =
  let mut b = string_new(4);
  let mut n = 0;
  for i in 0..3 {
    match fill(b, k - i) |> to_result[i32, string * i32] {
      inl p -> let (b2, m) = p; b = b2; n = m
    | inr e -> b = string_new(4); n = 0 - 1
    }
  };
  let (b, m) = len_of(b);
  n * 100 + m

main -> i32 * i32 = (go(5), go(1))
