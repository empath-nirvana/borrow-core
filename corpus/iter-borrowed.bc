-- An iterator over borrowed data (SPEC §7, borrowed iteration): the sequence [100, 20, 3] is a
-- `Seq`, a value spine of element cells. It is stored in a cell and borrowed `imm` by withbor1;
-- one withload hands the callback `view 'y Seq`, which is every element's view at the one
-- lifetime 'y. `iter_imm` turns those views into `iter (imm 'y i32) 1 1`, whose elements are
-- views at the same 'y. Four pulls sum the three elements and see the finish. After the borrow
-- ends the caller still owns the sequence: `digits` reads it, head last in base 1000, and frees
-- every cell.
--
-- Answer: (i32[123], i32[3020100]). An iterator that skips the first element gives 23, one that
-- does not advance gives 300 and is unfinished (i32[4294967295]), one that finishes early gives
-- 120 or 100 unfinished; a borrow that changed or lost the sequence changes 3020100. `live 0`
-- checks that every element cell and the sequence's cell are freed, once.

type Seq = mu X. 1 + (ref i32 * X)

def plus : i32 * i32 => i32 = unbang host[add32]

def nil : Seq = roll (inl ())

def cons : i32 * Seq => Seq =
  thunkv fun (p : i32 * Seq) -> let (x, s) = p; return (roll (inr (alloc[i32] x, s)))

-- The borrowed iterator (Core/BorrowedIter.lean, `iterImmV`): `unfold` with the views as its
-- state. `next` yields the head view and the rest of the views; `close` drops the views that
-- are left (the implicit destructor of the state forgets each `imm`).
def iter_imm[A] : !(all 'a < top. (mu X. 1 + (imm 'a A * X)) => U (iter (imm 'a A) 1 1)) =
  !thunkv Fun 'a < top.
    f <- return (unbang (unfold[iter (imm 'a A) 1 1, mu X. 1 + (imm 'a A * X)]
           (!thunkv fun (s : mu X. 1 + (imm 'a A * X)) ->
              < case (unroll s) {
                  inl u -> return (inr u : (imm 'a A * (mu X. 1 + (imm 'a A * X))) + 1)
                | inr p -> return (inl p : (imm 'a A * (mu X. 1 + (imm 'a A * X))) + 1)
                },
                return () >)));
    return (thunkv fun (vs : mu X. 1 + (imm 'a A * X)) ->
      return (thunkv nu_in < (nu_out (force f vs)).1, (nu_out (force f vs)).2 >))

-- Read an element through its view.
def read : !(all 'a < top. imm 'a i32 => i32) =
  !thunkv Fun 'a < top. return (thunkv fun (v : imm 'a i32) ->
    return (withload['a, 'z, i32, i32] v
      (thunkv Fun 'z < dom. return (thunkv fun (x : i32) -> return (boxed['z] x)))))

-- One pull of a sum: `inl (sum, rest)` while the iterator runs, `inr (sum, ())` once it finishes.
def pull : !(all 'a < top. (i32 * U (iter (imm 'a i32) 1 1) + i32 * 1)
                          => (i32 * U (iter (imm 'a i32) 1 1) + i32 * 1)) =
  !thunkv Fun 'a < top. return (thunkv fun (st : i32 * U (iter (imm 'a i32) 1 1) + i32 * 1) ->
    case st {
      inl a ->
        let (acc, it) = a;
        o <- (nu_out (force it)).1;
        case o {
          inl p -> let (v, rest) = p;
                   return (inl (plus (acc, (unbang read) ['a] v), rest)
                             : i32 * U (iter (imm 'a i32) 1 1) + i32 * 1)
        | inr r -> return (inr (acc, r) : i32 * U (iter (imm 'a i32) 1 1) + i32 * 1)
        }
    | inr d -> return (inr d : i32 * U (iter (imm 'a i32) 1 1) + i32 * 1)
    })

-- Free every cell; read the elements as base-1000 digits, head last.
def digits_alg : !(1 + ref i32 * i32 => i32) =
  !thunkv fun (r : 1 + ref i32 * i32) ->
    case r {
      inl u -> return i32[0]
    | inr p ->
        let (rn, t) = p;
        return (plus (free[i32] rn, (unbang host[mul32]) (t, i32[1000])))
    }

def digits : Seq => i32 = unbang (fold_own[1 + (ref i32 * X), i32] digits_alg)

main : F (i32 * i32) =
  l <- return (cons (i32[100], cons (i32[20], cons (i32[3], nil))));
  r <- return (alloc[Seq] l);
  q <- return (withbor1['x, Seq, i32] r
         (thunkv Fun 'x < top. return (thunkv fun (b : imm 'x Seq) ->
            s <- return (withload['x, 'y, Seq, i32] b
                   (thunkv Fun 'y < dom. return (thunkv fun (vs : view 'y Seq) ->
                      it <- return ((unbang iter_imm[i32]) ['y] vs);
                      st <- return ((unbang pull) ['y] ((unbang pull) ['y] ((unbang pull) ['y]
                              ((unbang pull) ['y]
                                (inl (i32[0], it) : i32 * U (iter (imm 'y i32) 1 1) + i32 * 1)))));
                      case st {
                        inl a -> let (acc, rest) = a; return (boxed['y] i32[4294967295])
                      | inr d -> let (acc, u) = d; return (boxed['y] acc)
                      })));
            return (boxed['x] s))));
  let (r2, s) = q;
  l2 <- return (free[Seq] r2);
  return (s, digits l2)
