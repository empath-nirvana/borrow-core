-- Axes: data × effects (failure) × coeffects × scope, borrowed. The baseline for errors on a
-- borrowed list: the hand-threaded `Result`, written as data (what `try_fold` is in Rust). It is
-- here for comparison with the error effect (`corpus/pending/raise-in-fold.bc`), and to test the
-- error path's scope; it is not the intended style.
--
-- `digit_sum` folds a borrowed list of bytes with `fold_imm`. Its algebra returns `i32 + i32`:
-- `inl` the sum of the digits so far, or `inr` the first byte that is not a digit, as in
-- `result-fold-own.bc`, reading each byte through its `imm` view. On the error path the borrow
-- ends like on the success path: the borrow block returns, and its lender, the cell `bad`, is
-- usable again. `main` shows it by lending `bad` once more after the failing fold, to count its
-- nodes, and the cells are freed at the end.
--
-- Answer: (inl i32[6], (inr i32[120], i32[4])): the digits of `123` sum to 6; `1x3y` fails at
-- `x` (byte 120); and the list that failed still has its 4 nodes. An algebra that let a later
-- error win gives 121; a borrow not handed back on the error path does not check; a fold that
-- consumed nodes would count fewer than 4.

type List = mu X. 1 + (ref i32 * ref X)
shape Node = node (leaf i32) (leaf List)

def nil : List = roll inl ()
fn cons(x: i32, t: List) -> List = roll inr alloc_s[Node] (x, t)

-- A digit's value, or `inr` the byte itself.
fn digit(b: i32) -> i32 + i32 =
  match host[lt_u32] (b - 48, 10) { inl _ -> inr b | inr _ -> inl (b - 48) }

def sum_alg : !(all 'y < top. 1 + (imm 'y i32 * (i32 + i32)) => i32 + i32) =
  !thunkv Fun 'y < top. return (thunkv fun (r : 1 + (imm 'y i32 * (i32 + i32))) ->
    match r {
      inl _ -> inl 0
    | inr (v, t) ->
        let b = *v;
        match digit(b) {
          inl d -> match t { inl s -> inl (d + s) | inr e -> inr e }
        | inr e -> inr e
        }
    })
def digit_sum : !(all 'a < top. imm 'a List => i32 + i32) =
  fold_imm[1 + (ref i32 * ref X), 'a, top, i32 + i32] sum_alg

def len_alg : !(all 'y < top. 1 + (imm 'y i32 * i32) => i32) =
  !thunkv Fun 'y < top. return (thunkv fun (r : 1 + (imm 'y i32 * i32)) ->
    match r { inl _ -> 0 | inr (_, n) -> n + 1 })
def len : !(all 'a < top. imm 'a List => i32) = fold_imm[1 + (ref i32 * ref X), 'a, top, i32] len_alg

main -> (i32 + i32) * ((i32 + i32) * i32) =
  let good = alloc(cons(49, cons(50, cons(51, nil))));
  let bad = alloc(cons(49, cons(120, cons(51, cons(121, nil)))));
  let g = digit_sum(&good);
  let e = digit_sum(&bad);
  let n = len(&bad);
  (g, (e, n))
