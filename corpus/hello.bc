-- Hello, world: a literal written to standard output in one call (`write_lit`, the `write_all`
-- extern). The literal's bytes sit in the program's read-only data and are written from there,
-- so nothing is allocated for the text: the one allocation is the output capability's cell.
--
-- Answer: `Hello, world!` and a newline, and `()`.

include textio

main -> 1 =
  write_lit(&mut stdout, "Hello, world!\n")
