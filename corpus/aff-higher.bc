-- Higher-order affine closures (SPEC §22): a closure capturing a closure, and a closure taking a
-- closure.
--
-- `doubler(k)` is a closure whose state is the closure `k`: each call calls `k` and doubles its
-- answer, and closing it closes `k`. Its bound `'d` is below `k`'s `'c`, since its state must
-- outlive `'d`. `runner` is a closure whose call takes a closure `f` (owned) and calls it with 5,
-- then closes it; its state is the running total of `f`'s answers. The argument's type names no
-- state, so `runner` takes a counter over a cell and a persistent function made a closure alike.
--
-- Answer: i32[12062], and `live 0`. `doubler` over a counter from 0 answers 2 and 6 (`2 + 60`);
-- `runner` answers 105 for a counter from 100, then 105 + 15 for `x * 3` (`12000`). Closing
-- `doubler` and `runner`'s closes of its arguments free both counters' cells: a `close` that did
-- not close what it captured leaves a cell live.

include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, boxed['c] c1),
      n <- return (free[i32] s); return () >)

-- A closure capturing a closure.
fn doubler<'c, 'd < 'c>(k: box 'c Aff[i32, i32]<'c>) -> box 'd Aff[i32, i32]<'d> =
  boxed['d] aff_new[box 'c Aff[i32, i32]<'c>, i32, i32]['d](k, !thunkv fun (s : box 'c Aff[i32, i32]<'c>) ->
    < fun (a : i32) ->
        p <- return (aff_call(s, a));
        let (b, r) = p;
        return (b * 2, boxed['d] r),
      return (aff_close(s)) >)

-- A closure taking a closure.
fn runner<'c, 'd>() -> box 'd Aff[box 'c Aff[i32, i32]<'c>, i32]<'d> =
  boxed['d] aff_new[i32, box 'c Aff[i32, i32]<'c>, i32]['d](0, !thunkv fun (t : i32) ->
    < fun (f : box 'c Aff[i32, i32]<'c>) ->
        p <- return (aff_call(f, 5));
        let (b, r) = p;
        u <- return (aff_close(r));
        return (t + b, boxed['d] (t + b)),
      return () >)

main -> i32 =
  let d = alloc(0);
  let r = borrow mut d { 'x, e ->
    borrow mut e { 'y, e2 ->
      let o = doubler ['x] ['y](counter ['x](0));
      let (a, o) = aff_call(o, 1);
      let (b, o) = aff_call(o, 2);
      aff_close(o);
      let rn = runner ['x] ['y]();
      let (u, rn) = aff_call(rn, counter ['x](100));
      let (v, rn) = aff_call(rn, aff_of_fn[i32, i32]['x](!thunkv fun (x : i32) -> return (x * 3)));
      aff_close(rn);
      a + b * 10 + v * 100 } };
  free(d) + r
