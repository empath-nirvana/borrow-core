-- An `if` that heads a `let` in a loop's body: the `let mut` variable its arm assigns is handed
-- on to the rest of the body, so the loop threads it (#581). A `while` and a `for`; and an arm
-- that leaves the function with `return` while the other assigns.
--
-- Answer: `(i32[2060], (i32[2060], (i32[303], i32[10])))`: each loop counts its two even turns
-- in `x` and sums 10 + 20 + 10 + 20; `early(3)` returns `x * 100 + i` at `i = 3` after three
-- turns, `early(20)` runs out at `x = 10`. Without the join, `x` stays 0:
-- `(i32[60], (i32[60], (i32[3], i32[0])))`.

fn whiles() -> i32 =
  let mut x = 0;
  let mut s = 0;
  let mut i = 0;
  while i < 4 {
    let a = if i % 2 == 0 { x = x + 1; 10 } else { 20 };
    s = s + a;
    i = i + 1
  };
  x * 1000 + s

fn fors() -> i32 =
  let mut x = 0;
  let mut s = 0;
  for i in 0..4 {
    let a = if i % 2 == 0 { x = x + 1; 10 } else { 20 };
    s = s + a
  };
  x * 1000 + s

fn early(k: i32) -> i32 =
  let mut x = 0;
  let mut i = 0;
  while i < 10 {
    let a = if i == k { return x * 100 + i } else { x = x + 1; 1 };
    i = i + a
  };
  x

main -> i32 * (i32 * (i32 * i32)) = (whiles(), (fors(), (early(3), early(20))))
