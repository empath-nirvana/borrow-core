-- SPEC §27 in the core text, the twin of the kernel program `e7d` (`bcc kernel interp e7d`, E7d):
-- `to_result_1 (to_result_6 (timeout (body (raise 1) unwind raise 6)))`. `timeout` (handler 2)
-- cancels a body suspended at `2.0` below two finalisers: the inner raises `1.0`, the outer `6.0`.
-- Both `[then]`s are at the row `[6.0, 1.0]`, which the cancel row of `2.0` holds. The finalisers
-- fire innermost first and the first error, `1.0`, is kept and re-raised at the canceller; it
-- passes handler 6 and is caught by handler 1.
--
-- Answer: inr (), and `live 0`. A wrong implementation that lets the second error (`6.0`)
-- supersede the first, or skips the finalisers, answers `inl (inr ())`.

main : F ((1 + 1) + 1) =
  handle_with[1](
      ((!thunkv fun (v : 1 + 1) -> return (inl v)) : !U (1 + 1 -o F ((1 + 1) + 1))),
      (((!thunkv fun (e : 1) -> return (inr e)), ()) : !U (1 -o F ((1 + 1) + 1)) * 1)) (
    handle_with[6](
        ((!thunkv fun (v : 1 + 1) -> return v) : !U (1 + 1 -o F[1.0 cancel 1 ~> 0] (1 + 1))),
        (((!thunkv fun (e : 1) -> return (inr e)), ()) : !U (1 -o F[1.0 cancel 1 ~> 0] (1 + 1)) * 1)) (
      handle_with[2](
          ((!thunkv fun (v : 1) -> return (inl v)) : !U (1 -o F[6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0] (1 + 1))),
          (((!thunkv fun (p : 1 * U ((1 -o F[6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0] (1 + 1)) & F[6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0, 6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0] 1)) ->
            let (u, k) = p; let () = u; c <- (force k).2; let () = c; return (inr ())), ())
            : !U (1 * U ((1 -o F[6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0] (1 + 1)) & F[6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0, 6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0] 1) -o F[6.0 cancel 1 ~> 0, 1.0 cancel 1 ~> 0] (1 + 1)) * 1)) (
        y <- (x <- perform[2.0] () unwind (abort[1.0] ()); return x) unwind (abort[6.0] ());
        return y)))
