-- R0 (SPEC §54) in the core text: a finaliser the program writes that consumes a value with no
-- destructor. `k`, a linear thunk, is live across the call of `check` at the row of the abortive
-- operation `1.0 aff i32 ~> 0`; its type has no destructor, so the checker cannot drop it on the
-- abort path, and the program writes the finaliser that runs it (`unwind`). R0's `[then]` rule
-- runs the finaliser in the abort arm of its `case`; without it the kernel's re-check refuses
-- the arm, which leaves `k` unconsumed (the reject test `scripts/check-rewrite.sh`, seed
-- `dropFin`).
--
-- Answer: (i32[8], i32[107]): at `5` the rest adds `k`'s `3`; at `0` the call aborts with `7`,
-- the finaliser runs `k`, and the handler adds `100`.

def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

def use_k : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    k : U (1 -o F i32) <- return (thunkv fun (u : 1) -> return i32[3]);
    f <- return (unbang check);
    v <- force f a unwind (
      u <- return ();
      w <- force k u;
      return ());
    u <- return ();
    w <- force k u;
    return (plus (v, w))

def handled : !U (i32 -o F i32) =
  !thunkv fun (a : i32) ->
    handle_with[1](
        ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
        (((!thunkv fun (e : i32) -> return (plus (e, i32[100]))), ()) : !U (i32 -o F i32) * 1))
      (f <- return (unbang use_k); force f a)

main : F (i32 * i32) =
  f <- return (unbang handled);
  a <- return i32[5];
  r1 <- force f a;
  g <- return (unbang handled);
  b <- return i32[0];
  r2 <- force g b;
  return (r1, r2)
