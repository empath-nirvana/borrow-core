#! dialect 82
# As corpus/mut-cancel-loop-for.bc, with the loop's value bound (`let r = for … else { 0 }`) and the
# `let mut` total read after it: `t + r` is 3 + 0. Probe k4 of #1053.
import fail
effect Wait { ctl wait() : 1 }
fn chk(x: i32) : i32 / Fail[i32] = if x == 30 { raise(x) } else { x }
handler tm[A]: Wait, (A) -> A + i32 / Fail[i32] {
  return(x) -> inl x
  wait(k) -> {
    var t = 0
    let r = for i in 0..3 { let v = chk(i); t = t + v } else { 0 }
    let s = t + r; inr s
  }
}
fn work() : i32 / Wait { wait(); 5
}
fn main() : (i32 + i32) + i32 = handle { handle { work() } with tm[i32] } with to_result[i32, i32 + i32]
