-- check: no-source
-- Every adapter of the library (#109, `lib/adapters.bc`) over pure sources: `range` finishes with
-- `()` and, closed, hands back `()`. Each adapter is a generic `gen fn` written once; each call
-- makes its instance at the types of its arguments (`i32`, pairs, lists). The adapters are
-- composed, a few to a loop. The source interpreter takes about a minute over it (`check:
-- no-source`); the other stages run it. The I/O sources are `corpus/gen-adapters-io.bc`, the
-- failing ones `corpus/gen-adapters-fail.bc`.
--
-- Answer: i32[110051049], read as 110, 051 and 049:
--   take 3 of skip 2 of filter above 5 of map squares of 0 … 9:
--     0 1 4 9 16 25 36 49 64 81 → 9 16 25 36 49 64 81 → 25 36 49 64 81 → 25 36 49        110
--   enumerate of chain (scan sums of 1 … 4) (flat_map n to 0 … n - 1 of 0 1 2), sum of i * x:
--     1 3 6 10, then 0 0 1 → 0*1 + 1*3 + 2*6 + 3*10 + 4*0 + 5*0 + 6*1                   51
--   zip (batch sums up to 10 of 1 … 7) (lengths of chunks of 2 of take_until a square above
--   20), sum of products: batch 10 11 7; take_until 0 1 2 3 4, chunks [0 1] [2 3] [4], lengths
--   2 2 1 → 10*2 + 11*2 + 7*1                                                              49
-- A `take` that ran one step more gives 174; a `skip` off by one 126 or 94; a `take_until` that
-- yielded the square above 20 makes its last chunk [4 5], which changes nothing, but a `chunks`
-- that dropped its last partial chunk gives 42.

include adapters

type List = mu X. 1 + (i32 * X)

gen fn range(lo: i32, hi: i32) -> i32 =
  let mut i = lo;
  while i < hi { yield i; i = i + 1 };
  ()

fn len_alg(r: 1 + i32 * i32) -> i32 = match r { inl _ -> 0 | inr (x, n) -> n + 1 }
def len : !(List => i32) = fold_own[1 + i32 * X, i32] len_alg

fn add_up(p: i32 * i32) -> i32 * bool =
  let (s, x) = p;
  if s + x >= 10 { (s + x, true) } else { (s + x, false) }

main -> i32 =
  let mut a = 0;
  for y in take(skip(filter(map(range(0, 10), !{ x -> x * x }), !{ x -> x > 5 }), 2), 3) {
    a = a + y
  };
  let mut b = 0;
  for p in enumerate(chain(scan(range(1, 5), 0, !{ (s, x) -> s + x }),
                           flat_map(range(0, 3), !{ n -> range(0, n) }))) {
    let (i, x) = p;
    b = b + i * x
  };
  let mut c = 0;
  for p in zip(batch(range(1, 8), 0, add_up),
               map(chunks(take_until(range(0, 100), !{ x -> x * x > 20 }), 2), len)) {
    let (x, y) = p;
    c = c + x * y
  };
  a * 1000000 + b * 1000 + c
