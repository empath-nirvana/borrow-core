-- A `for` followed by another loop (SPEC §14). `main` copies its input and counts the bytes, then
-- calls the div function `count_lines`. What follows the `for` loops, so it does not run inside
-- the `for`'s last step: the `for`'s end runs the code up to the call, and `main`'s machine moves
-- to the state that holds the call's loop (SPEC §15). The input has ended by then, so
-- `count_lines` finds no line.
--
-- Answer: the input, then `6`, and the result `(i32[6], i32[0])`.

def count_lines : In => In * i32 =
  thunkv fun (c : In) ->
    n : i32 <- return i32[0];
    for b in bytes c {
      n : i32 <- case (unbang host[eq32]) ((unbang host[extend8_u]) b, i32[10]) {
        inl u -> return n
      | inr u -> return ((unbang host[add32]) (n, i32[1]))
      };
      return ()
    };
    return (c, n)

main : F (i32 * i32) =
  n : i32 <- return i32[0];
  for b in bytes stdin {
    n : i32 <- return ((unbang host[add32]) (n, i32[1]));
    return (putb (&mut stdout, b))
  };
  m <- return (count_lines (&mut stdin));
  _ <- return (put_dec (&mut stdout, n));
  _ <- return (putb (&mut stdout, u8[10]));
  return (n, m)
