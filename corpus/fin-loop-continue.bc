#! dialect 82
# A dropped continuation cancelled on an abort out of a loop of the clause whose body uses its own
# `continue` (SPEC §27; #953 re-review M1). A `continue` stays in the clause, so the loop is still a head
# of the clause's path as a whole; only a `return` leaves the clause. The body raises `7` while
# `k` is live; the abort cancels `k` on the way out, and the cleanup's raise `3` supersedes `7`.
#
# Answer: inr i32[3], and `live 0`. A continuation left uncancelled would answer `inr i32[7]`.

import fail

effect Wait { ctl wait() : 1 }

fn check(e: i32) : i32 / Fail[i32] = raise(e)

handler tm[A]: Wait, (A) -> A + 1 / Fail[i32] {
  return(x) -> inl x
  wait(k) -> { for i in 0..3 { if i == 1 { continue }; let y = check(7); () }; inr () }
}

fn work() : i32 / Wait + Fail[i32] { let x = wait() unwind (let r = raise((3 : i32)); ()); 5
}

fn main() : (i32 + 1) + i32 = handle { handle { work() } with tm[i32] } with to_result[i32, i32 + 1]
