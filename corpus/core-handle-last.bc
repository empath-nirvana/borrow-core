-- SPEC §51, §54 in the core text: a handler written by `[handle-last]`'s rule,
-- `handle_last[2: aff]`. Its one operation `2.0 aff 1 ~> i32` is at the count `1?`; its work
-- `!U(1 -o F (i32 + 1))` answers `inl 10`, so the rule's clause resumes `κ` with `10`, and its exit
-- `!U(1 -o F i32)` would answer `0` after a cancel (`effHandleL`).
--
-- Answer: i32[20].

def plus : i32 * i32 => i32 = unbang host[add32]

def twice : !U (1 -o F[2.0 aff 1 ~> i32] i32) =
  !thunkv fun (u : 1) ->
    a <- perform[2.0] u;
    b <- perform[2.0] ();
    return (plus (a, b))

main : F i32 =
  f <- return (unbang twice);
  u <- return ();
  handle_last[2: aff](
      ((!thunkv fun (v : i32) -> return v) : !U (i32 -o F i32)),
      ((((!thunkv fun (u : 1) -> let () = u; return (inl i32[10])), ()) : !U (1 -o F (i32 + 1)) * 1),
       (((!thunkv fun (z : 1) -> let () = z; return i32[0]), ()) : !U (1 -o F i32) * 1)))
    (force f u)
