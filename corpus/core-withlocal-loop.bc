-- [spec §80] A local cell across an uncounted loop (`withlocal_loop`), in the shape of
-- `leetcode/binary/0190-reverse-bits.bc`'s `cases`: `count` is the local, and the loop's state is
-- the position with a checksum of the case values (standing in for their printing). Each turn
-- reads the case at the position: a case bumps `count` through the turn's `Mut` view and moves
-- on; the end of the input breaks with the state. The runtime drives the loop turn by turn; the
-- steps see a view of the cell, never the cell or its contents.
--
-- Answer: (i32[4], (i32[4], i32[128])), and `live 0`.

def case_at : i32 => (i32 * i32) + 1 =
  thunkv fun (pos : i32) ->
    case (unbang host[lt_s32]) (pos, i32[4]) {
      inl ge -> return (inr () : (i32 * i32) + 1)
    | inr lt ->
        return (inl ((unbang host[add32]) ((unbang host[mul32]) (pos, i32[7]), i32[1]),
          (unbang host[add32]) (pos, i32[1])) : (i32 * i32) + 1)
    }

def next : !(i32 * i32 => all 'x < dom. mut 'x i32 => box 'x ((i32 * i32) + (i32 * i32))) =
  !thunkv fun (st : i32 * i32) -> return (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x i32) ->
    let (pos, sum) = st;
    c <- return (case_at pos);
    case c {
      inl q ->
        let (x, after) = q;
        p <- return (withswap['x, i32, i32] m (thunkv fun (v : i32) ->
          return ((unbang host[add32]) (v, i32[1]), v)));
        let (m, old) = p;
        let () = release_mut['x, i32] m;
        return (boxed['x] (inr (after, (unbang host[xor32]) (sum, (unbang host[shl32]) (x, i32[3])))
          : (i32 * i32) + (i32 * i32)))
    | inr u ->
        let () = u;
        let () = release_mut['x, i32] m;
        return (boxed['x] (inl (pos, sum) : (i32 * i32) + (i32 * i32)))
    }))

def close : !(i32 * i32 => all 'x < dom. mut 'x i32 => box 'x 1) =
  !thunkv fun (st : i32 * i32) -> return (thunkv Fun 'x < dom. return (thunkv fun (m : mut 'x i32) ->
    let (pos, sum) = st;
    let () = release_mut['x, i32] m;
    return (boxed['x] ())))

main : F (U (loop (i32 * (i32 * i32)) (i32 * 1))) =
  return (withlocal_loop['x, top, i32, i32 * i32, i32 * i32, 1] (i32[0], (i32[0], i32[0]))
    (next, close))
