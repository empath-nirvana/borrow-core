-- SPEC §19's drop glue in the core text: an owned cell `c` is live across a call of `check`, at
-- the row of the abortive operation `1.0 aff i32 ~> 0`. The checker binds the call by `[then]`
-- with a finaliser it inserts, the cell's destructor, as it inserts SPEC §12's destructors: when
-- the call aborts, the rest does not run and the finaliser frees `c`. When the call returns, the
-- rest frees `c` itself.
--
-- Answer: (inl i32[8], inr i32[7]), and `live 0`: at `5` the rest adds the cell's `3`; at `0` the
-- call aborts and the finaliser frees the cell.

def plus : i32 * i32 => i32 = unbang host[add32]

def check : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (x : i32) ->
    z <- return ((unbang host[eqz32]) x);
    case z {
      inl nz -> return x
    | inr isz -> abort[1.0] i32[7]
    }

def use_cell : !U (i32 -o F[1.0 aff i32 ~> 0] i32) =
  !thunkv fun (a : i32) ->
    c <- return (alloc[i32] i32[3]);
    f <- return (unbang check);
    v <- force f a;
    x <- return (free[i32] c);
    return (plus (v, x))

main : F ((i32 + i32) * (i32 + i32)) =
  a <- return i32[5];
  r1 <- handle_with[1](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (f <- return (unbang use_cell); force f a);
  b <- return i32[0];
  r2 <- handle_with[1](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (g <- return (unbang use_cell); force g b);
  return (r1, r2)
