-- Mutual recursion at shorter lifetimes (SPEC §31, *Generic recursive groups*). `sums` and
-- `maxes` take turns halving a borrowed array: `sums` adds each pair, `maxes` keeps the larger of
-- each pair, and each lends its new array to the other (`borrow imm w { 'x, u -> … }`), at a
-- lifetime shorter than its own `'a`. When its first element exceeds 50, `maxes` instead hands
-- `sums` the rest of its own view, at its own `'a`. Each member's lifetime parameter is quantified
-- in its field of the group's fixed-point record, and each call instantiates it, at `'x` or at
-- `'a`.
--
-- Answer: `i32[241]`. From `37 · i mod 101` for `i < 16`: `sums` gives
-- `37, 84, 131, 77, 124, 70, 117, 63`; `maxes` (37 is not above 50) `84, 131, 124, 117`; `sums`
-- `215, 241`; `maxes` (215 is above 50) drops 215; `sums` of `241` is 241.

include rec
include buf
include slice

-- Each pair added, or the larger kept; a missing partner is 0.
fn halve<'a>(v: array_imm 'a i32, add: bool) -> array i32 =
  let n = len(v);
  let m = (n + 1) / 2;
  let mut b = buf_new[i32](m);
  for i in 0..m {
    let x = at(v, 2 * i, 0);
    let y = at(v, 2 * i + 1, 0);
    let z = if add { x + y } else { if x < y { y } else { x } };
    let (b2, u) = push(b, z);
    b = b2
  };
  let (a, k) = b;
  a

fn sums<'a>(v: array_imm 'a i32) -> i32 =
  if len(v) <= 1 { at(v, 0, 0) } else {
    let mut w = halve(v, true);
    let r = borrow imm w { 'x, u -> maxes(u) };
    r
  }

fn maxes<'a>(v: array_imm 'a i32) -> i32 =
  if len(v) <= 1 { at(v, 0, 0) } else {
    match split_first(v) {
      inl (h, t) -> if *h > 50 { sums(t) } else {
          let mut w = halve(v, false);
          let r = borrow imm w { 'x, u -> sums(u) };
          r
        }
    | inr u -> 0
    }
  }

fn data(i: i32) -> i32 = (i * 37) % 101

main -> i32 = with on_exhausted(!{ u -> 0 - 1 }) {
  let mut a = array_new[i32] (16, data);
  borrow imm a { 'x, v -> sums(v) }
}
