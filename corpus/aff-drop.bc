-- Dropping an affine closure (SPEC §22) runs its `close`. An affine closure has a destructor
-- (SPEC §12, class 2): `close`, which disposes of the state. `k` is never called and `k2`'s rest
-- is never used again, so the checker inserts their destructors at the end of the scope, and each
-- `close` frees its counter's cell. `nest` is a closure whose state is another closure: its
-- `close` closes the closure it holds, so dropping it frees that counter's cell too. Its bound is
-- the bound `'c` of the closure it holds (SPEC §23, the box rule non-strict); it is built with
-- `aff_new` and `boxed['c]`, since `aff_new_boxed`'s bound would put its `'c` strictly below.
--
-- Answer: i32[3], and `live 0`. A drop that forgot a closure without running its `close` leaves
-- its counter's cell live (`live 3` if none ran).

include aff

fn counter<'c>(start: i32) -> box 'c Aff[i32, i32]<'c> =
  aff_new_boxed[ref i32, i32, i32]['c](alloc(start), !thunkv fun (s : ref i32) ->
    < fun (a : i32) ->
        cx <- return (swap[i32, i32] s i32[0]);
        let (c, x) = cx;
        cu <- return (swap[i32, i32] c (x + a));
        let (c1, u) = cu;
        return (x + a, c1),
      n <- return (free[i32] s); return () >)

fn nest<'c>(k: box 'c Aff[i32, i32]<'c>) -> box 'c Aff[i32, i32]<'c> =
  boxed['c] aff_new[box 'c Aff[i32, i32]<'c>, i32, i32]['c](k, !thunkv fun (s : box 'c Aff[i32, i32]<'c>) ->
    < fun (a : i32) ->
        p <- return (aff_call(s, a));
        let (b, r) = p;
        return (b, boxed['c] r),
      return (aff_close(s)) >)

main -> i32 =
  let k = counter(7);
  let k2 = counter(1);
  let (a, k2) = aff_call(k2, 2);
  let o = nest(counter(5));
  a
