-- SPEC §27 in the core text: one step of a 2-stage pipe connector, typed by `[then]`. Each stage
-- runs one observation at a time under its own handler, whose clause stores the stage's
-- continuation (as in `core-yield-pull`): the downstream stage waits at its `next` (site 3) holding
-- a cell, which its cleanup frees; the upstream stage yields 7 (site 1) and raises 42 (site 2) when
-- resumed. The step `r <- (nu_out (force ku)).1 unwind ((nu_out (force kd)).2); N` resumes the
-- upstream's stored continuation (M) with the downstream's (`kd`) in the finaliser's and the rest's
-- part of the context: the raise runs the finaliser, which cancels the downstream stage, whose
-- cleanup frees its cell. The step's row `[2.0 cancel i32 ~> 0]` has no unrestricted operation, so
-- `[then]` does not ask that `kd` be `!`.
--
-- Answer: inr i32[42], and `live 0`: the downstream's cell is freed by the cancel.

def plus : i32 * i32 => i32 = unbang host[add32]

-- The downstream stage, one observation: it owns a cell across its `next` (site 3); its cleanup
-- frees the cell.
def down_obs : !U (1 -o F[3.0 cancel 1 ~> i32] i32) =
  !thunkv fun (u : 1) ->
    c <- return (alloc[i32] i32[5]);
    a <- perform[3.0] () unwind (z <- return (free[i32] c); return ());
    z <- return (free[i32] c);
    return (plus (a, z))

def d_hr : !U (i32 -o F (i32 + U (nu X. (i32 -o F (i32 + U X)) & F 1))) =
  !thunkv fun (v : i32) -> return (inl v)
def d_hc : !U (1 * U ((i32 -o F (i32 + U (nu X. (i32 -o F (i32 + U X)) & F 1))) & F 1) -o F (i32 + U (nu X. (i32 -o F (i32 + U X)) & F 1))) * 1 =
  (!thunkv fun (p : 1 * U ((i32 -o F (i32 + U (nu X. (i32 -o F (i32 + U X)) & F 1))) & F 1)) ->
     let (u, k) = p; let () = u;
     return (inr (thunkv nu_in < fun (y : i32) -> (force k).1 y, (force k).2 >)), ())

-- The upstream stage: yields 7 (site 1), and raises 42 (site 2) when resumed.
def up_obs : !U (1 -o F[1.0 cancel i32 ~> 1, 2.0 cancel i32 ~> 0] 1) =
  !thunkv fun (u : 1) ->
    v <- perform[1.0] i32[7];
    abort[2.0] i32[42]

def u_hr : !U (1 -o F[2.0 cancel i32 ~> 0] (1 + i32 * U (nu Y. F[2.0 cancel i32 ~> 0] (1 + i32 * U Y) & F[2.0 cancel i32 ~> 0] 1))) =
  !thunkv fun (v : 1) -> return (inl v)
def u_hc : !U (i32 * U ((1 -o F[2.0 cancel i32 ~> 0] (1 + i32 * U (nu Y. F[2.0 cancel i32 ~> 0] (1 + i32 * U Y) & F[2.0 cancel i32 ~> 0] 1))) & F[2.0 cancel i32 ~> 0] 1) -o F[2.0 cancel i32 ~> 0] (1 + i32 * U (nu Y. F[2.0 cancel i32 ~> 0] (1 + i32 * U Y) & F[2.0 cancel i32 ~> 0] 1))) * 1 =
  (!thunkv fun (p : i32 * U ((1 -o F[2.0 cancel i32 ~> 0] (1 + i32 * U (nu Y. F[2.0 cancel i32 ~> 0] (1 + i32 * U Y) & F[2.0 cancel i32 ~> 0] 1))) & F[2.0 cancel i32 ~> 0] 1)) ->
     let (x, k) = p;
     return (inr (x, thunkv nu_in < u <- return (); (force k).1 u, (force k).2 >)), ())

-- Deliver an item to the downstream stage and finish it: a further `next` is answered by
-- cancelling it.
def finish : !U (U (nu X. (i32 -o F (i32 + U X)) & F 1) * i32 -o F i32) =
  !thunkv fun (q : U (nu X. (i32 -o F (i32 + U X)) & F 1) * i32) ->
    let (k, x) = q;
    r <- (nu_out (force k)).1 x;
    case r {
      inl v -> return v
    | inr k2 -> u <- (nu_out (force k2)).2; return i32[0]
    }

main : F (i32 + i32) =
  handle_with[2](
      ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
      (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (
    df <- return (unbang down_obs);
    d <- handle_with[3](d_hr, d_hc) (u0 <- return (); force df u0);
    case d {
      inl v -> return v
    | inr kd ->
        uf <- return (unbang up_obs);
        -- The upstream's first observation; the finaliser cancels the downstream.
        up <- handle_with[1](u_hr, u_hc) (u1 <- return (); force uf u1) unwind ((nu_out (force kd)).2);
        case up {
          inl e -> (a <- return (kd, i32[0]); fz <- return (unbang finish); force fz a)
        | inr xk ->
            let (x, ku) = xk;
            -- The connector step: M resumes the upstream's stored continuation; D cancels the
            -- downstream's (Gamma_2 = kd, x).
            r <- (nu_out (force ku)).1 unwind ((nu_out (force kd)).2);
            case r {
              inl e -> (a <- return (kd, x); fz <- return (unbang finish); force fz a)
            | inr yk ->
                let (y, ku2) = yk;
                w <- (nu_out (force ku2)).2 unwind ((nu_out (force kd)).2);
                (a <- return (kd, x); fz <- return (unbang finish); force fz a)
            }
        }
    })
