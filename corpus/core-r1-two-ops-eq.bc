-- R1 (SPEC §54) at a name of two operations of one signature, `3.0 lin i32 ~> i32` (add `1`) and
-- `3.1 lin i32 ~> i32` (times `10`). Each `perform` becomes a call of its own operation's work. A
-- `perform` sent to the other operation's work, or one that answers its argument and drops the
-- work's answer, still types: those faults are the controls `wrongWork` and `dropAnswer`, which
-- only the golden output sees (`scripts/check-rewrite.sh`).
--
-- Answer: (i32[6], i32[50]): `inc 5` is `6`, `ten 5` is `50`.

def plus : i32 * i32 => i32 = unbang host[add32]

def both : !U (i32 -o F[3.0 lin i32 ~> i32, 3.1 lin i32 ~> i32] (i32 * i32)) =
  !thunkv fun (x : i32) ->
    a <- perform[3.0] x;
    b <- perform[3.1] x;
    return (a, b)

main : F (i32 * i32) =
  f <- return (unbang both);
  x <- return i32[5];
  handle_with[3](
      ((!thunkv fun (v : i32 * i32) -> return v) : !U (i32 * i32 -o F (i32 * i32))),
      (((!thunkv fun (p : i32 * U ((i32 -o F (i32 * i32)) & top)) ->
        let (y, k) = p;
        z <- return (plus (y, i32[1]));
        (force k).1 z),
       ((!thunkv fun (p : i32 * U ((i32 -o F (i32 * i32)) & top)) ->
        let (y, k) = p;
        z <- return ((unbang host[mul32]) (y, i32[10]));
        (force k).1 z), ()))
        : !U (i32 * U ((i32 -o F (i32 * i32)) & top) -o F (i32 * i32))
          * (!U (i32 * U ((i32 -o F (i32 * i32)) & top) -o F (i32 * i32)) * 1))) (force f x)
