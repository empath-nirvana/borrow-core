-- R0 (SPEC §54) in the core text: two abortive names under one unwinding borrow. The cell `c` is
-- lent by `withbor2u` to a callback at the row `[1.0 aff i32 ~> 0, 2.0 aff i32 ~> 0]`, which
-- aborts `2.0`. R0 rewrites `2` first (its handler is the inner one): the borrow keeps its
-- unwinding form at the row of `1.0`, with its finaliser for `1`'s aborts and a `case` for `2`'s;
-- then `1`, which takes it to the non-unwinding form.
--
-- Answer: (inr i32[42], inr i32[43]), and `live 0`: the cell is freed on both abort paths.

def lend : !U (i32 -o F[1.0 aff i32 ~> 0, 2.0 aff i32 ~> 0] (ref i32 * i32)) =
  !thunkv fun (k : i32) ->
    c <- return (alloc[i32] i32[1]);
    w <- return withbor2u['x, top, i32, i32, [1.0 aff i32 ~> 0, 2.0 aff i32 ~> 0]];
    cb : U (forall 'x < dom. mut 'x i32 -o F[1.0 aff i32 ~> 0, 2.0 aff i32 ~> 0] (box 'x i32)) <- return
      (thunkv Fun 'x < dom. fun (m : mut 'x i32) ->
        let () = forget_mut['x, i32] m;
        z <- return ((unbang host[eqz32]) k);
        case z { inl nz -> abort[2.0] i32[42] | inr isz -> abort[1.0] i32[43] });
    force w c cb

def handled : !U (i32 -o F (i32 + i32)) =
  !thunkv fun (k : i32) ->
    handle_with[1](
        ((!thunkv fun (v : i32) -> return (inl v)) : !U (i32 -o F (i32 + i32))),
        (((!thunkv fun (e : i32) -> return (inr e)), ()) : !U (i32 -o F (i32 + i32)) * 1)) (
      handle_with[2](
          ((!thunkv fun (p : ref i32 * i32) -> let (r, v) = p; w <- return (free[i32] r); return v) : !U (ref i32 * i32 -o F[1.0 aff i32 ~> 0] i32)),
          (((!thunkv fun (e : i32) -> abort[1.0] e), ()) : !U (i32 -o F[1.0 aff i32 ~> 0] i32) * 1))
        (f <- return (unbang lend); force f k))

main : F ((i32 + i32) * (i32 + i32)) =
  f <- return (unbang handled);
  a <- return i32[5];
  r1 <- force f a;
  g <- return (unbang handled);
  b <- return i32[0];
  r2 <- force g b;
  return (r1, r2)
