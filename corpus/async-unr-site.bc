-- SPEC §52's `unr` guard: a stored BOXED-κ site whose operation is `multi ctl` (an `unr` `κ`) in a
-- program that has a stack machine (`tsum`, run by `spawn`). The clause copies its `κ` and resumes
-- both copies, which the typing allows at `unr`. Such a site does not switch the task stack: its
-- `κ` may be copied, so it could not be the stack's one owner (`stackOps` and `convDrive`'s
-- `siteSw` both ask that no operation of the node be `unr`). The `spawn` site still runs `tsum`'s
-- recursion on a stack of its own.
--
-- Answer: `i32[5]`: `grab`'s computation answers 5 at the first resume; the second resume of the
-- copy answers it again. `live 0`.

include rec
include async

effect Many { multi ctl pick() }

type T = box top U (nu X. F (i32 + box top U X) & F 1)

handler grab: Many, i32 -> T = {
  return(v) = boxed[top] (thunkv nu_in < return (inl v), return () >);
  pick(k) = boxed[top] (thunkv nu_in <
    kb <- return (unbox k); kk <- return (unbang kb); u <- return (); t1 <- (force kk).1 u; kk2 <- return (unbang kb); u2 <- return (); t <- (force kk2).1 u2; let _ = t1; return (inr t),
    kb <- return (unbox k); kk <- return (unbang kb); (force kk).2 >)
}

fn step(t: T) -> i32 + T = g <- return (unbox t); (nu_out (force g)).1

fn tsum(lo: i32, hi: i32) -> i64 with Async, Exhausted =
  if lo < hi {
    let m = lo + (hi - lo) / 2;
    let a = tsum(lo, m);
    await();
    let b = tsum(m + 1, hi);
    a + b + i64[1]
  } else { i64[0] }

fn task(n: i32) -> i64 with Async = with on_exhausted(!{ u -> i64[0] - 1 }) { tsum(0, n) }

main -> i32 =
  let t = with grab { pick(); 5 };
  let q = push(queue[i64](), with spawn { task(7) });
  let vs = run_until_empty(q);
  match step(t) { inl v -> v | inr t2 -> match step(t2) { inl v -> v | inr t3 -> 7 } }
