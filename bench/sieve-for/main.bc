include textio
include buf
include io
include float

-- `bench/sieve` with every loop a counted `for` (SPEC §16) instead of a `while` (SPEC §14): the
-- strides of the inner loop counted by a division, the outer loop up to the square root.

-- The next argument as a number, or `d` when there is none or it is not one.
fn arg_i32(d: i32) -> i32 =
  let (s, got) = next_arg(string_new(16));
  let n = borrow imm s { t -> with default(d) { parse_i32(t) } };
  if got { n } else { d }

fn one(i: i32) -> u8 = u8[1]

-- The multiples of `i` from `i * i` below `n` struck out.
fn strike(a: array u8, i: i32, n: i32) -> array u8 =
  let mut a = a;
  let m = (n - i * i + i - 1) / i;
  for k in 0..m { a = array_set(a, i * i + k * i, u8[0]) };
  a

-- The number of primes below `n`, for `n` at most 2³¹ − 1.
fn sieve(n: i32) -> i32 =
  let mut a = array_new[u8](n, one);
  let lim = i32_of_f64_sat(sqrt_f64(f64_of_i32(n))) + 1;
  for i in 2..lim {
    if i * i < n {
      let f = at(&a, i, u8[0]);
      if f == u8[1] { a = strike(a, i, n) } else { () }
    } else { () }
  };
  let mut count = 0;
  for f in &a { if *f == u8[1] { count = count + 1 } else { () } };
  count - 2

main -> i32 =
  let n = arg_i32(1000);
  let reps = arg_i32(1);
  let mut c = 0;
  for r in 0..reps { c = sieve(n) };
  print_dec(c);
  print_byte(b'\n');
  0
