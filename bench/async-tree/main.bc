-- Recursive async tasks: `tasks` tasks, each a recursive async function over the implicit
-- balanced search tree of the keys `0 .. n` that awaits once at every node, run round robin by
-- the library's scheduler (`run_until_empty`, `lib/async.bc`). Each task's sum of its keys'
-- values is printed.

include textio
include io
include rec
include async

-- The first argument as a number, or `d` when there is none or it is not one.
fn arg_i32(d: i32) -> i32 =
  let (s, got) = next_arg(string_new(16));
  let n = borrow imm s { t -> with default(d) { parse_i32(t) } };
  if got { n } else { d }

fn value(k: i32, r: i32) -> i32 = (k * 7919 + r) % 1000

-- The values of the keys of `[lo, hi)` in task `r`, summed; one `await` per node.
fn tsum(lo: i32, hi: i32, r: i32) -> i64 with Async, Exhausted =
  if lo < hi {
    let m = lo + (hi - lo) / 2;
    let a = tsum(lo, m, r);
    await();
    let b = tsum(m + 1, hi, r);
    a + host[extend_s](value(m, r)) + b
  } else { i64[0] }

fn task(n: i32, r: i32) -> i64 with Async = with on_exhausted(!{ u -> i64[0] - 1 }) { tsum(0, n, r) }

fn print_all(xs: List[i64]) -> 1 =
  let mut cur = xs;
  let mut more = true;
  while more {
    match unroll cur {
      inl u -> more = false; cur = (roll inl () : List[i64])
    | inr (x, rest) -> print_dec64(x); print_byte(b'\n'); cur = rest
    }
  };
  ()

main -> i32 =
  let n = arg_i32(1000);
  let tasks = arg_i32(1);
  let mut q = queue[i64]();
  for r in 0..tasks { q = push(q, with spawn { task(n, r) }) };
  print_all(run_until_empty(q));
  0
