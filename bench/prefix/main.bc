include textio
include slice
include io

-- The next argument as a number, or `d` when there is none or it is not one.
fn arg_i32(d: i32) -> i32 =
  let (s, got) = next_arg(string_new(16));
  let n = borrow imm s { t -> with default(d) { parse_i32(t) } };
  if got { n } else { d }

fn value(i: i32) -> i64 = host[extend_s]((i * 7919) % 1000)

-- Each element replaced by the sum of the elements up to it, in place.
fn prefix<'a>(v: array_mut 'a i64) -> 1 =
  let mut s = i64[0];
  for p in v { s = modify p { x -> (x + s, x + s) } };
  ()

main -> i32 =
  let n = arg_i32(1000);
  let reps = arg_i32(1);
  let mut a = array_new[i64](n, value);
  for r in 0..reps {
    prefix(&mut a)
  };
  let last = at(&a, n - 1, i64[0]);
  print_dec64(last);
  print_byte(b'\n');
  0
