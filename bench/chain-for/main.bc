include textio
include io

-- `bench/chain-gen` as a counted `for`: the numbers below `n`, each `3x + 1`, those not divisible
-- by 7, summed.

-- The next argument as a number, or `d` when there is none or it is not one.
fn arg_i32(d: i32) -> i32 =
  let (s, got) = next_arg(string_new(16));
  let n = borrow imm s { t -> with default(d) { parse_i32(t) } };
  if got { n } else { d }

main -> i32 =
  let n = arg_i32(1000);
  let mut s = i64[0];
  for i in 0..n {
    let y = host[extend_s](i) * 3 + 1;
    if y % 7 != 0 { s = s + y } else { () }
  };
  print_dec64(s);
  print_byte(b'\n');
  0
