include textio
include slice
include io
include rec

-- `bench/quicksort` written once for any element type with `<`, used at pairs ordered by a `poly`
-- case: the generic sort is instantiated at the pair type, and its `<` is the case below.

-- The next argument as a number, or `d` when there is none or it is not one.
fn arg_i32(d: i32) -> i32 =
  let (s, got) = next_arg(string_new(16));
  let n = borrow imm s { t -> with default(d) { parse_i32(t) } };
  if got { n } else { d }

type Key = i32 * i32

-- Pairs in lexicographic order.
poly (<) at Key =
  let (a1, a2) = a;
  let (b1, b2) = b;
  a1 < b1 || (a1 == b1 && a2 < b2)

-- Element `i` of the input: the high and low bits of an LCG step.
fn data(i: i32) -> Key =
  let x = host[and32](host[add32](host[mul32](i, 1103515245), 12345), 2147483647);
  (host[shr_u32](x, 20), host[and32](x, 1023))

-- Lomuto's partition of `[lo, hi]` around its middle element, moved to `hi` first. `d` is any
-- element, put in a slot while it is read.
fn partition[T]<'a>(v: array_mut 'a T, lo: i32, hi: i32, d: T) -> array_mut 'a T * i32 =
  let mut v = swap_at(v, lo + (hi - lo) / 2, hi);
  let (w, p) = peek(v, hi, d);
  v = w;
  let mut i = lo;
  for j in lo..hi {
    let (u, x) = peek(v, j, d);
    v = u;
    if x < p { v = swap_at(v, i, j); i = i + 1 } else { () }
  };
  (swap_at(v, i, hi), i)

-- `[lo, hi]` sorted in place.
fn quicksort[T]<'a>(v: array_mut 'a T, lo: i32, hi: i32, d: T) -> array_mut 'a T =
  if lo < hi {
    let (v, p) = partition(v, lo, hi, d);
    let v = quicksort(v, lo, p - 1, d);
    quicksort(v, p + 1, hi, d)
  } else { v }

main -> i32 =
  let n = arg_i32(2000);
  let reps = arg_i32(1);
  let mut bad = 0;
  let mut check = 0;
  for r in 0..reps {
    let mut a = array_new[Key](n, data);
    borrow mut a { v ->
      match with exhausted_to_option { quicksort(v, 0, n - 1, (0, 0)) } { inl v -> discard_mut(v) | inr u -> () } };
    for i in 1..n {
      let x = at(&a, i - 1, (0, 0));
      let y = at(&a, i, (0, 0));
      if y < x { bad = bad + 1 } else { () }
    };
    let (m1, m2) = at(&a, n / 2, (0, 0));
    check = check + m1 * 1024 + m2
  };
  print_dec(bad);
  print_byte(b' ');
  print_dec(check);
  print_byte(b'\n');
  0
