-- Spectral norm (the Benchmarks Game's): ten rounds of the power method on the infinite matrix
-- A(i, j) = 1 / ((i + j)(i + j + 1) / 2 + i + 1), cut to n×n. Prints the norm times 10⁹,
-- truncated, so that every side prints the same digits.
include textio
include io
include float
include buf

-- The first argument as a number, or `d` when there is none or it is not one.
fn arg_i32(d: i32) -> i32 =
  let (s, got) = next_arg(string_new(16));
  let n = borrow imm s { t -> with default(d) { parse_i32(t) } };
  if got { n } else { d }

fn a(i: i32, j: i32) -> f64 =
  let ij = i + j;
  1.0 / f64_of_i32(ij * (ij + 1) / 2 + i + 1)

-- `out = A u`.
fn mul_av(n: i32, u: array f64, out: array f64) -> array f64 * array f64 =
  let mut u = u;
  let mut out = out;
  for i in 0..n {
    let mut s = 0.0;
    let mut j = 0;
    for p in &u { s = s + a(i, j) * *p; j = j + 1 };
    out = array_set(out, i, s)
  };
  (u, out)

-- `out = Aᵀ u`.
fn mul_atv(n: i32, u: array f64, out: array f64) -> array f64 * array f64 =
  let mut u = u;
  let mut out = out;
  for i in 0..n {
    let mut s = 0.0;
    let mut j = 0;
    for p in &u { s = s + a(j, i) * *p; j = j + 1 };
    out = array_set(out, i, s)
  };
  (u, out)

fn one(i: i32) -> f64 = 1.0
fn zero(i: i32) -> f64 = 0.0

main -> i32 =
  let n = arg_i32(100);
  let mut u = array_new[f64](n, one);
  let mut v = array_new[f64](n, zero);
  let mut t = array_new[f64](n, zero);
  for k in 0..10 {
    -- v = AᵀA u, then u = AᵀA v.
    let (u1, t1) = mul_av(n, u, t);
    let (t2, v1) = mul_atv(n, t1, v);
    let (v2, t3) = mul_av(n, v1, t2);
    let (t4, u2) = mul_atv(n, t3, u1);
    u = u2; v = v2; t = t4
  };
  let mut vbv = 0.0;
  let mut vv = 0.0;
  let mut i = 0;
  for p in &v {
    let x = *p;
    let y = at(&u, i, 0.0);
    vbv = vbv + y * x;
    vv = vv + x * x;
    i = i + 1
  };
  let r = sqrt_f64(vbv / vv);
  print_dec64(i64_of_f64_sat(r * 1000000000.0));
  print_byte(b'\n');
  0
