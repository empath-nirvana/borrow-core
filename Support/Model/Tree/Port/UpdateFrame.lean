/-- `⦇ρ₁ ● ρ₂⦈ = ⦇ρ₁⦈ ○ ⦇ρ₂⦈`.
`[about ours: the factorisation `[TR]` 6.48's proof performs, as an equation
between flattenings]` -/
theorem flat_compR {ρ₁ ρ₂ ρ₁₂ σ : ResUT BoCa.Loc BoCa.Val K} (h : ResUT.CompS ρ₁ ρ₂ ρ₁₂)
    (hσ : ResUT.Flat ρ₁₂ σ) :
    ∃ σ₁ σ₂, ResUT.Flat ρ₁ σ₁ ∧ ResUT.Flat ρ₂ σ₂ ∧ ResUT.CompR σ₁ σ₂ σ := by
  obtain ⟨e₁, e₂, e, a₁, a₂, a, σ₁, σ₂, he₁, he₂, hec, ha₁, ha₂, hac, hc, hσ₁, hσ₂⟩ :=
    ResUT.Flat.split_factors h hσ
  have himm : e.ImmFree := ResUT.ImmFree.compS hec (ExST.immFree he₁) (ExST.immFree he₂)
  have hdisj := ResUT.CompatS.disjoint_of_immFree himm hc.1
  have hd12 := ResUT.CompatS.disjoint_of_immFree (ExST.immFree he₁) hec.1
  have key : ∀ l, (σ₁.get l = e₁.get l ∧ σ₂.get l = e₂.get l ∧ σ.get l = e.get l)
      ∨ (σ₁.get l = a₁.get l ∧ σ₂.get l = a₂.get l ∧ σ.get l = a.get l) := by
    intro l
    rcases hdisj l with hnoE | hnoA
    · obtain ⟨f₁, f₂⟩ := (ResUT.Comp.eq_none_iff hec l).mp hnoE
      exact Or.inr ⟨ResUT.Comp.get_of_left_none hσ₁ f₁,
        ResUT.Comp.get_of_left_none hσ₂ f₂, ResUT.Comp.get_of_left_none hc hnoE⟩
    · obtain ⟨g₁, g₂⟩ := (ResUT.Comp.eq_none_iff hac l).mp hnoA
      exact Or.inl ⟨ResUT.Comp.get_of_right_none hσ₁ g₁,
        ResUT.Comp.get_of_right_none hσ₂ g₂, ResUT.Comp.get_of_right_none hc hnoA⟩
  refine ⟨σ₁, σ₂, ⟨e₁, a₁, he₁, ha₁, hσ₁⟩, ⟨e₂, a₂, he₂, ha₂, hσ₂⟩, ?_, ?_⟩
  · intro l ψ₁ ψ₂ f₁ f₂
    rcases key l with ⟨k₁, k₂, -⟩ | ⟨k₁, k₂, -⟩
    · rw [k₁] at f₁; rw [k₂] at f₂
      rcases hd12 l with hn | hn
      · rw [hn] at f₁; exact absurd f₁ (by simp)
      · rw [hn] at f₂; exact absurd f₂ (by simp)
    · rw [k₁] at f₁; rw [k₂] at f₂; exact hac.1 l ψ₁ ψ₂ f₁ f₂
  · intro l
    rcases key l with ⟨k₁, k₂, k⟩ | ⟨k₁, k₂, k⟩
    · rw [k₁, k₂, k]
      have hp := hec.2 l
      rcases hd12 l with hn | hn
      · rw [hn] at hp ⊢; exact optComp_left_none hp
      · rw [hn] at hp ⊢; exact optComp_right_none hp
    · rw [k₁, k₂, k]; exact hac.2 l

/-- `ψ` is a `mut` cell of lifetime `b` and invariant `P̂`, value and witness
free: the data `↭`'s second clause fixes. -/
def IsMutSig (ψ : CellUT BoCa.Loc BoCa.Val K) (b : TSet) [Fact (K.Anti b)]
    (P : Val → SPropST BoCa.Loc BoCa.Val K b) : Prop :=
  ∃ (v : Val) (χ : ResUT BoCa.Loc BoCa.Val K) (h : χ.InStratum b) (hw : P v ⟨χ, h⟩),
    ψ = CellUT.mutOf b v χ h P hw

/-- `↭`'s two clauses at one location of the two flattenings.
`[about ours: `[TR]` p. 5's `↭`, at one location of the flattenings]` -/
def CellUpd (o o' : Option (CellUT BoCa.Loc BoCa.Val K)) : Prop :=
  (∀ (s : TSet) (v : Val) (χ : ResUT BoCa.Loc BoCa.Val K) (h : χ.InStratum s),
      o = some (CellUT.immOf s v χ h) ↔ o' = some (CellUT.immOf s v χ h)) ∧
  (∀ (b : TSet) [Fact (K.Anti b)] (P : Val → SPropST BoCa.Loc BoCa.Val K b),
      (∃ ψ, o = some ψ ∧ IsMutSig ψ b P) ↔ (∃ ψ, o' = some ψ ∧ IsMutSig ψ b P))

/-- `↭` read at one location of the two flattenings. -/
theorem cellUpd_of_upd {ρ₁ ρ₂ σ₁ σ₂ : ResUT BoCa.Loc BoCa.Val K} (h : ResUT.Upd ρ₁ ρ₂)
    (h₁ : ResUT.Flat ρ₁ σ₁) (h₂ : ResUT.Flat ρ₂ σ₂) (l : BoCa.Loc) :
    CellUpd (σ₁.get l) (σ₂.get l) := by
  refine ⟨fun s v χ hh => ?_, fun b _ P => ?_⟩
  · rw [← ResUT.flatAt_iff h₁, ← ResUT.flatAt_iff h₂]
    exact h.1 l s v χ hh
  · constructor
    · rintro ⟨ψ, hψ, v, χ, hh, hw, rfl⟩
      obtain ⟨v', χ', hh', hw', hg⟩ :=
        (h.2 l b P).mp ⟨v, χ, hh, hw, (ResUT.flatAt_iff h₁ _ _).mpr hψ⟩
      exact ⟨_, (ResUT.flatAt_iff h₂ _ _).mp hg, ⟨v', χ', hh', hw', rfl⟩⟩
    · rintro ⟨ψ, hψ, v, χ, hh, hw, rfl⟩
      obtain ⟨v', χ', hh', hw', hg⟩ :=
        (h.2 l b P).mpr ⟨v, χ, hh, hw, (ResUT.flatAt_iff h₂ _ _).mpr hψ⟩
      exact ⟨_, (ResUT.flatAt_iff h₁ _ _).mp hg, ⟨v', χ', hh', hw', rfl⟩⟩

/-- `CellUpd` is reflexive. -/
theorem CellUpd.refl (o : Option (CellUT BoCa.Loc BoCa.Val K)) : CellUpd o o :=
  ⟨fun _ _ _ _ => Iff.rfl, fun _ _ _ => Iff.rfl⟩

/-- `(ρ₁ ● ρ₂) ● ρ₃` regrouped as `ρ₁ ● (ρ₂ ● ρ₃)`. -/
theorem compS_reassoc {a b c ab x : ResUT BoCa.Loc BoCa.Val K} (h₁ : ResUT.CompS a b ab)
    (h₂ : ResUT.CompS ab c x) : ∃ bc, ResUT.CompS b c bc ∧ ResUT.CompS a bc x :=
  (ResUT.CompS.assoc a b c x).mpr ⟨ab, h₁, h₂⟩

/-- `ρ₁ ● (ρ₂ ● ρ₃)` regrouped as `(ρ₁ ● ρ₂) ● ρ₃`. -/
theorem compS_reassoc' {a b c bc x : ResUT BoCa.Loc BoCa.Val K} (h₁ : ResUT.CompS b c bc)
    (h₂ : ResUT.CompS a bc x) : ∃ ab, ResUT.CompS a b ab ∧ ResUT.CompS ab c x :=
  (ResUT.CompS.assoc a b c x).mp ⟨bc, h₁, h₂⟩

/-- `(ρ₁ ● ρ₂) ● ρ₃ = (ρ₁ ● ρ₃) ● ρ₂`. -/
theorem compS_exch {a b c ab x : ResUT BoCa.Loc BoCa.Val K} (h₁ : ResUT.CompS a b ab)
    (h₂ : ResUT.CompS ab c x) : ∃ ac, ResUT.CompS a c ac ∧ ResUT.CompS ac b x := by
  obtain ⟨bc, hbc, hx⟩ := compS_reassoc h₁ h₂
  exact compS_reassoc' (ResUT.CompS.comm hbc) hx

/-- `ρ₁ ● (ρ₂ ● ρ₃) = ρ₂ ● (ρ₁ ● ρ₃)`. -/
theorem compS_lcomm {a b c bc x : ResUT BoCa.Loc BoCa.Val K} (h₁ : ResUT.CompS b c bc)
    (h₂ : ResUT.CompS a bc x) : ∃ ac, ResUT.CompS a c ac ∧ ResUT.CompS b ac x := by
  obtain ⟨ab, hab, hx⟩ := compS_reassoc' h₁ h₂
  obtain ⟨ac, hac, hx'⟩ := compS_exch hab hx
  exact ⟨ac, hac, ResUT.CompS.comm hx'⟩

