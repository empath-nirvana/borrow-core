theorem ResUT.upd_ag_mut_eq {ρ₂ ρ₃ e₂ a₂ σ₂ e₃ a₃ σ₃ : ResUT Loc Val K}
    (h : ResUT.Upd ρ₂ ρ₃)
    (he₂ : ExST ρ₂ e₂) (ha₂ : AgWT ρ₂ a₂) (hc₂ : ResUT.CompS e₂ a₂ σ₂)
    (he₃ : ExST ρ₃ e₃) (ha₃ : AgWT ρ₃ a₃) (hc₃ : ResUT.CompS e₃ a₃ σ₃)
    {n : Loc} {b : TSet} [Fact (K.Anti b)] {v : Val} {χ : ResUT Loc Val K} {hb : χ.InStratum b}
    {P : Val → SPropST Loc Val K b} {hw : P v ⟨χ, hb⟩}
    (hg : a₂.get n = some (CellUT.mutOf b v χ hb P hw)) :
    a₃.get n = some (CellUT.mutOf b v χ hb P hw) := by
  classical
  -- An `own` cell has the empty witness.
  have witOwn : ∀ ψ : CellUT Loc Val K, ψ.kind = Kind.own →
      ψ.wit = (PMap.empty : ResUT Loc Val K) := by
    intro ψ hk
    rcases CellUT.rep' ψ with ⟨u, rfl⟩ | ⟨s, u, τ, m, rfl⟩ | ⟨c, _, u, τ, m, Q, k, rfl⟩
    · simp
    · simp at hk
    · simp at hk
  -- What a `○`-factorisation carries over: the value always, the witness
  -- whenever the factor's own cell is not `own`.
  have key : ∀ (p z a : ResUT Loc Val K) (ξ ζ : CellUT Loc Val K),
      ResUT.CompR p z a → p.get n = some ξ → a.get n = some ζ →
      ζ.kind ≠ Kind.own →
      ζ.erase = ξ.erase ∧ (ξ.kind ≠ Kind.own → ζ.wit = ξ.wit) := by
    intro p z a ξ ζ hC hp ha hζo
    rcases ResUT.Comp.get hC n with ⟨f₁, -, -⟩ | ⟨ψ, f₁, -, f⟩ | ⟨ψ, f₁, -, -⟩ |
        ⟨ψ₁, ψ₂, ψ, f₁, -, f, hcc⟩
    · rw [hp] at f₁
      exact absurd f₁ (by simp)
    · have e₁ : ξ = ψ := Option.some.inj (hp.symm.trans f₁)
      have e₂ : ζ = ψ := Option.some.inj (ha.symm.trans f)
      rw [e₁, e₂]
      exact ⟨rfl, fun _ => rfl⟩
    · rw [hp] at f₁
      exact absurd f₁ (by simp)
    · have e₁ : ξ = ψ₁ := Option.some.inj (hp.symm.trans f₁)
      have e₂ : ζ = ψ := Option.some.inj (ha.symm.trans f)
      subst e₁
      subst e₂
      refine ⟨(CellUT.CompR.erase hcc).2, fun hξo => ?_⟩
      rcases CellUT.CompR.wit_of_ne_own hcc hζo with ⟨-, e⟩ | ⟨k₂, e⟩
      · exact e
      · exact e.trans (CellUT.CompR.wit hcc hξo k₂).symm
  have hφk : (CellUT.mutOf b v χ hb P hw).kind ≠ Kind.imm := by simp
  have hφo : (CellUT.mutOf b v χ hb P hw).kind ≠ Kind.own := by simp
  have hσ₂ : σ₂.get n = some (CellUT.mutOf b v χ hb P hw) :=
    ResUT.flat_eq_ag_at he₂ hc₂ hg hφk
  -- Clause (2) of `↭`: the lifetime and the invariant.
  obtain ⟨v', χ', hb', hw', hfa⟩ :=
    (h.2 n b P).mp ⟨v, χ, hb, hw, ⟨σ₂, ⟨e₂, a₂, he₂, ha₂, hc₂⟩, hσ₂⟩⟩
  have hσ₃ : σ₃.get n = some (CellUT.mutOf b v' χ' hb' P hw') :=
    (ResUT.flatAt_iff ⟨e₃, a₃, he₃, ha₃, hc₃⟩ n _).mp hfa
  -- The ancestor step, left to right.
  obtain ⟨κ, ev, av, p, z, ξ, -, -, -, hz, hpn, hξk, hξw, hξe⟩ :=
    ResUT.upd_ag_nonimm_transfer h he₂ ha₂ hc₂ he₃ ha₃ hc₃ hg hφk
  have hocc : ∃ ζ, a₃.get n = some ζ := by
    rcases ResUT.Comp.get hz n with ⟨f₁, -, -⟩ | ⟨ψ, -, -, f⟩ | ⟨ψ, f₁, -, -⟩ |
        ⟨ψ₁, ψ₂, ψ, -, -, f, -⟩
    · rw [hpn] at f₁
      exact absurd f₁ (by simp)
    · exact ⟨ψ, f⟩
    · rw [hpn] at f₁
      exact absurd f₁ (by simp)
    · exact ⟨ψ, f⟩
  obtain ⟨ζ, hζ⟩ := hocc
  -- `ag(ρ₃)(n)` is `⦇ρ₃⦈(n)`: `ex(ρ₃)_●` is `imm`-free and `ag(ρ₃)` is occupied.
  have he₃n : e₃.get n = none := by
    cases f : e₃.get n with
    | none => rfl
    | some ξ' =>
        have hk := (CellUT.CompatS.kinds (hc₃.1 n ξ' ζ f hζ)).1
        exact absurd hk (ExST.immFree he₃ n ξ' f)
  have ha₃n : a₃.get n = σ₃.get n := by
    rcases ResUT.Comp.get hc₃ n with ⟨-, f₂, -⟩ | ⟨ψ, f₁, -, -⟩ | ⟨ψ, -, f₂, f⟩ |
        ⟨ψ₁, ψ₂, ψ, f₁, -, -, -⟩
    · rw [hζ] at f₂
      exact absurd f₂ (by simp)
    · rw [he₃n] at f₁
      exact absurd f₁ (by simp)
    · rw [f₂, f]
    · rw [he₃n] at f₁
      exact absurd f₁ (by simp)
  have hgt : a₃.get n = some (CellUT.mutOf b v' χ' hb' P hw') := ha₃n.trans hσ₃
  have hζo : (CellUT.mutOf b v' χ' hb' P hw').kind ≠ Kind.own := by simp
  obtain ⟨heL, hwL⟩ := key p z a₃ ξ _ hz hpn hgt hζo
  -- The value.
  have hv : v' = v := by
    have e := heL.trans hξe
    simpa using e
  subst hv
  -- The witness, from whichever side's trace has a cell that is not `own`.
  have hχ : χ' = χ := by
    by_cases hξo : ξ.kind = Kind.own
    · have hχe : χ = (PMap.empty : ResUT Loc Val K) := by
        have e := hξw.symm
        rw [witOwn ξ hξo] at e
        simpa using e
      obtain ⟨κ', ev', av', p', z', ξ', -, -, -, hz', hpn', hξk', hξw', hξe'⟩ :=
        ResUT.upd_ag_nonimm_transfer h.symm he₃ ha₃ hc₃ he₂ ha₂ hc₂ hgt (by simp)
      obtain ⟨-, hwR⟩ := key p' z' a₂ ξ' _ hz' hpn' hg hφo
      by_cases hξo' : ξ'.kind = Kind.own
      · have e := hξw'.symm
        rw [witOwn ξ' hξo'] at e
        have : χ' = (PMap.empty : ResUT Loc Val K) := by simpa using e
        rw [this, hχe]
      · have e := (hwR hξo').trans hξw'
        simpa using e.symm
    · have e := (hwL hξo).trans hξw
      simpa using e
  subst hχ
  exact hgt

/-- `ag(ρ₂)` and `ag(ρ₃)` agree wherever the cell is not `own`.  `[about ours: `[TR]`
6.48's proof at the aliasable walk, its `imm`, `mut ○ mut` and `own` bullets
together]` -/
theorem ResUT.upd_ag_eq_of_ne_own {ρ₂ ρ₃ e₂ a₂ σ₂ e₃ a₃ σ₃ : ResUT Loc Val K}
    (h : ResUT.Upd ρ₂ ρ₃)
    (he₂ : ExST ρ₂ e₂) (ha₂ : AgWT ρ₂ a₂) (hc₂ : ResUT.CompS e₂ a₂ σ₂)
    (he₃ : ExST ρ₃ e₃) (ha₃ : AgWT ρ₃ a₃) (hc₃ : ResUT.CompS e₃ a₃ σ₃)
    {n : Loc} {ψ : CellUT Loc Val K} (hg : a₂.get n = some ψ)
    (hk : ψ.kind ≠ Kind.own) : a₃.get n = some ψ := by
  rcases CellUT.rep' ψ with ⟨u, rfl⟩ | ⟨s, u, χ, hh, rfl⟩ | ⟨c, _, u, χ, hh, Q, kQ, rfl⟩
  · simp at hk
  · -- clause (1): an `imm` cell of `ag` is the flattening's cell, and `↭` pins it
    have hex : e₂.get n = none := by
      cases f : e₂.get n with
      | none => rfl
      | some ξ =>
          exact absurd (CellUT.CompatS.kinds (hc₂.1 n ξ _ f hg)).1 (ExST.immFree he₂ n ξ f)
    have hσ₂ : σ₂.get n = some (CellUT.immOf s u χ hh) := by
      rcases ResUT.Comp.get hc₂ n with ⟨-, f₂, -⟩ | ⟨ζ, f₁, -, -⟩ | ⟨ζ, -, f₂, f⟩ |
          ⟨ζ₁, ζ₂, ζ, f₁, -, -, -⟩
      · rw [hg] at f₂; exact absurd f₂ (by simp)
      · rw [hex] at f₁; exact absurd f₁ (by simp)
      · exact f.trans (congrArg some (Option.some.inj (f₂.symm.trans hg)))
      · rw [hex] at f₁; exact absurd f₁ (by simp)
    have hσ₃ : σ₃.get n = some (CellUT.immOf s u χ hh) :=
      (ResUT.flatAt_iff ⟨e₃, a₃, he₃, ha₃, hc₃⟩ n _).mp
        ((h.1 n s u χ hh).mp ((ResUT.flatAt_iff ⟨e₂, a₂, he₂, ha₂, hc₂⟩ n _).mpr hσ₂))
    exact ResUT.ag_eq_flat_at_imm he₃ hc₃ hσ₃ (CellUT.kind_immOf _ _ _ _)
  · exact ResUT.upd_ag_mut_eq h he₂ ha₂ hc₂ he₃ ha₃ hc₃ hg

/-- At an `own` cell of `ag(ρ₂)`, `ag(ρ₃)` carries an `own` cell or nothing. -/
theorem ResUT.upd_ag_own_or_none {ρ₂ ρ₃ e₂ a₂ σ₂ e₃ a₃ σ₃ : ResUT Loc Val K}
    (h : ResUT.Upd ρ₂ ρ₃)
    (he₂ : ExST ρ₂ e₂) (ha₂ : AgWT ρ₂ a₂) (hc₂ : ResUT.CompS e₂ a₂ σ₂)
    (he₃ : ExST ρ₃ e₃) (ha₃ : AgWT ρ₃ a₃) (hc₃ : ResUT.CompS e₃ a₃ σ₃)
    {n : Loc}
    (hg : ∀ ψ, a₂.get n = some ψ → ψ.kind = Kind.own) :
    ∀ φ, a₃.get n = some φ → φ.kind = Kind.own := by
  intro φ hφ
  by_contra hk
  have := ResUT.upd_ag_eq_of_ne_own h.symm he₃ ha₃ hc₃ he₂ ha₂ hc₂ hφ hk
  exact hk (hg φ this)

