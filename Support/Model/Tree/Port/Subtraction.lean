/-- `ᾱ ∖ β̄ ⊆ ᾱ`, so a witness in `Res_ᾱ` is a witness in `Res_{ᾱ ∖ β̄}`. -/
theorem TSet.diff_inStratum {s t u : TSet} (h : TSet.Diff s t u)
    {ρ : ResUT Loc Val K} (hρ : ρ.InStratum s) : ρ.InStratum u :=
  hρ.mono fun x hx => ⟨x, ((h x).mp hx).1, K.refl x⟩

