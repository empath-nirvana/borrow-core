/-- The exclusive walk at `○` splits along a `●` (the `●` of `[CONF]` p. 415:24
fn. 1's `≤`), following 6.18's printed proof.
`[about ours: `[TR]` 6.18's proof at a `●` hypothesis and an `○` walk]` -/
theorem ExRT.split_of_compS {ρ₁ ρ₂ ρ₁₂ w : ResUT Loc Val K}
    (h₁₂ : ResUT.CompS ρ₁ ρ₂ ρ₁₂) :
    ExRT ρ₁₂ w ↔ ∃ σ₁ σ₂, ExRT ρ₁ σ₁ ∧ ExRT ρ₂ σ₂ ∧ ResUT.CompR σ₁ σ₂ w := by
  have hR : ∀ ψ₁ ψ₂ ψ : CellUT Loc Val K, CellUT.CompR ψ₁ ψ₂ ψ → CellUT.CompatR ψ₁ ψ₂ :=
    fun _ _ ψ hc => ⟨ψ, hc⟩
  have hown : ResUT.CompR (G.restrict CellUT.kind ρ₁ Kind.own) (G.restrict CellUT.kind ρ₂ Kind.own)
      (G.restrict CellUT.kind ρ₁₂ Kind.own) :=
    ResUT.CompS.toCompR (ResUT.CompS.restrict h₁₂ Kind.own)
  have hmut : ResUT.CompR (G.restrict CellUT.kind ρ₁ Kind.mut) (G.restrict CellUT.kind ρ₂ Kind.mut)
      (G.restrict CellUT.kind ρ₁₂ Kind.mut) :=
    ResUT.CompS.toCompR (ResUT.CompS.restrict h₁₂ Kind.mut)
  constructor
  · intro h
    cases h with
    | mk hs hw hb hnm hσ =>
        rename_i u
        obtain ⟨u₁, u₂, hperm, hs₁, hs₂, hsub₁, hsub₂⟩ :=
          ResUT.Sites.split_pairs h₁₂ Kind.mut_ne_imm hs
        have hperm' : (u.map Prod.snd).Perm (u₁.map Prod.snd ++ u₂.map Prod.snd) := by
          rw [← List.map_append]
          exact hperm.map Prod.snd
        obtain ⟨b₁, b₂, hb₁, hb₂, hbc⟩ :=
          (BigCompT.append hR ResUT.compLawsR).mp
            (BigCompT.of_perm hR ResUT.compLawsR hperm' hb)
        obtain ⟨nm₁, nm₂, hnm₁, hnm₂, hnmc⟩ :=
          (ResUT.CompR.exchange₄ _ _ _ _ _).mp ⟨_, _, hown, hmut, hnm⟩
        obtain ⟨σ₁, σ₂, hσ₁, hσ₂, hσc⟩ :=
          (ResUT.CompR.exchange₄ nm₁ nm₂ b₁ b₂ w).mp ⟨_, _, hnmc, hbc, hσ⟩
        exact ⟨σ₁, σ₂,
          G.ExW.mk hs₁ (ExWitsT.to_compS_left h₁₂ hw hsub₁ hs₁) hb₁ hnm₁ hσ₁,
          G.ExW.mk hs₂ (ExWitsT.to_compS_right h₁₂ hw hsub₂ hs₂) hb₂ hnm₂ hσ₂,
          hσc⟩
  · rintro ⟨σ₁, σ₂, h₁, h₂, hc⟩
    cases h₁ with
    | mk hs₁ hw₁ hb₁ hnm₁ hσ₁ =>
        rename_i u₁
        cases h₂ with
        | mk hs₂ hw₂ hb₂ hnm₂ hσ₂ =>
            rename_i u₂
            obtain ⟨nm, b, hnmc, hbc, hσ⟩ :=
              (ResUT.CompR.exchange₄ _ _ _ _ w).mpr ⟨σ₁, σ₂, hσ₁, hσ₂, hc⟩
            obtain ⟨O, M, hO, hM, hOM⟩ :=
              (ResUT.CompR.exchange₄ _ _ _ _ nm).mpr ⟨_, _, hnm₁, hnm₂, hnmc⟩
            obtain rfl : O = (G.restrict CellUT.kind ρ₁₂ Kind.own) := ResUT.CompR.functional hO hown
            obtain rfl : M = (G.restrict CellUT.kind ρ₁₂ Kind.mut) := ResUT.CompR.functional hM hmut
            refine G.ExW.mk (w := u₁ ++ u₂) ?_
              (ExWitsT.append (ExWitsT.of_compS_left h₁₂ hw₁)
                (ExWitsT.of_compS_right h₁₂ hw₂)) ?_ hOM hσ
            · rw [List.map_append]
              exact ResUT.Sites.append_of_compS h₁₂ Kind.mut_ne_imm hs₁ hs₂
            · rw [List.map_append]
              exact (BigCompT.append hR ResUT.compLawsR).mpr ⟨_, _, hb₁, hb₂, hbc⟩

/-- The witness `π(ℓ)/ℓ` that `reb_α` sets at an `own` cell is a `●`-factor of
the source.
`[about ours: `[TR]` p. 5's `π(ℓ)/ℓ` against `ρ ≥ ⨀_{ℓ} π(ℓ)`]` -/
theorem ResUT.reb_own_wit_le {α : Life} {ρ ρ' : ResUT Loc Val K} (h : ResUT.Reb α ρ ρ')
    {l : Loc} {v : Val} {χ : ResUT Loc Val K}
    {hχ : χ.InStratum (TSet.single α)}
    (hl : ρ'.get l = some (CellUT.immOf (TSet.single α) v χ hχ))
    (hown : ρ.get l = some (CellUT.ownOf v)) : ResUT.Le χ ρ := by
  have hR : ∀ ψ₁ ψ₂ ψ : CellUT Loc Val K, CellUT.CompS ψ₁ ψ₂ ψ → CellUT.CompatS ψ₁ ψ₂ :=
    fun _ _ _ hc => CellUT.CompS.compat hc
  obtain ⟨-, π, b, hdom, hbig, hle, hat⟩ := h
  obtain ⟨⟨l', p⟩, hpm, hl'⟩ := List.mem_map.mp ((hdom.2 l).mpr ⟨_, hl⟩)
  rw [show l' = l from hl'] at hpm
  obtain ⟨⟨ζ, hζ⟩, hownc, -, -⟩ := hat l p hpm
  obtain ⟨h', he⟩ := hownc v hown
  rw [hl] at he
  obtain ⟨-, -, hχe⟩ := CellUT.immOf_inj (Option.some.inj he)
  obtain ⟨z, hz⟩ :=
    BigCompT.mem_factor hR ResUT.compLawsS hbig p (List.mem_map.mpr ⟨(l, p), hpm, rfl⟩)
  obtain ⟨τ, hτ⟩ := hle
  obtain ⟨z₁, hz₁⟩ := ResUT.Comp.factor_trans hR ResUT.compLawsS (ResUT.del_compS hζ) hz
  obtain ⟨z₂, hz₂⟩ := ResUT.Comp.factor_trans hR ResUT.compLawsS hz₁ hτ
  exact ⟨z₂, by rw [hχe]; exact hz₂⟩

/-- A `○`-factor of `⦇ρ′ᵢ⦈_○` is absorbed by `ag(ρᵢ)`; `[TR]` 6.59's *"both
get the borrow from `ρᵢ`"* is spent through it.
`[about ours: a `○`-factor of `⦇ρ′ᵢ⦈_○` against `ag(ρᵢ)`]` -/
theorem ResUT.absorbed_of_factor_flatR {ρ'i a₂ : ResUT Loc Val K}
    {l₀ : Loc} {s : TSet} {v : Val} {hs : ρ'i.InStratum s}
    (ha₂ : AgWT (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) a₂)
    {es as pS : ResUT Loc Val K} (hexS : ExRT ρ'i es) (hagS : AgWT ρ'i as)
    (hfS : ResUT.CompR es as pS)
    {Y : ResUT Loc Val K} (hY : ResUT.LeR Y pS) : ResUT.LeR Y a₂ := by
  classical
  obtain ⟨es', as', pS', hexS', hagS', hfS', hagi⟩ := AgWT.single_imm_inv ha₂
  cases ExRT.functional hexS' hexS
  cases AgWT.functional hagS' hagS
  cases ResUT.CompR.functional hfS' hfS
  obtain ⟨z, hz⟩ := hY
  exact ResUT.Comp.factor_trans (fun _ _ ψ hc => ⟨ψ, hc⟩) ResUT.compLawsR hz
    (ResUT.CompR.comm hagi)

/-- A `ρ_reb` cell's raised witness is absorbed by `ag(ρᵢ)`.
`[about ours: the `imm`-family step of `[TR]` 6.59's closing sentence, at one cell]` -/
theorem ResUT.reb_wit_absorbs {β : Life} {ρ'i ρ a₂ : ResUT Loc Val K}
    {l₀ : Loc} {s : TSet} {v : Val} {hs : ρ'i.InStratum s}
    (hreb : ResUT.Reb β ρ'i ρ)
    (ha₂ : AgWT (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) a₂)
    {es as pS : ResUT Loc Val K} (hexS : ExRT ρ'i es) (hagS : AgWT ρ'i as)
    (hfS : ResUT.CompR es as pS)
    {q : Loc} {ψq : CellUT Loc Val K}
    (hψq : (ρ.restrictDom ρ'i.exclPart).get q = some ψq)
    {evq avq p : ResUT Loc Val K}
    (hexq : ExRT ψq.wit evq) (hagq : AgWT ψq.wit avq)
    (hcq : ResUT.CompR evq avq p) :
    ResUT.LeR p a₂ := by
  classical
  have hR : ∀ ψ₁ ψ₂ ψ : CellUT Loc Val K, CellUT.CompR ψ₁ ψ₂ ψ → CellUT.CompatR ψ₁ ψ₂ :=
    fun _ _ ψ hc => ⟨ψ, hc⟩
  have hfacEx : ∀ Y : ResUT Loc Val K, ResUT.LeR Y es → ResUT.LeR Y a₂ := fun Y hY =>
    ResUT.absorbed_of_factor_flatR ha₂ hexS hagS hfS (hY.trans (ResUT.LeR.left hfS))
  have hfacAg : ∀ Y : ResUT Loc Val K, ResUT.LeR Y as → ResUT.LeR Y a₂ := fun Y hY =>
    ResUT.absorbed_of_factor_flatR ha₂ hexS hagS hfS (hY.trans (ResUT.LeR.right hfS))
  have hρq : ρ.get q = some ψq := ResUT.restrictDom_get_inv hψq
  obtain ⟨φ', hφ'⟩ := ResUT.restrictDom_dom hψq
  obtain ⟨hφ'g, hφ'k⟩ := ResUT.exclPart_eq_some.mp hφ'
  obtain ⟨vv, χw, hχs, hψeq, hev, hor⟩ := ResUT.reb_src hreb hρq hφ'g hφ'k
  have hwit : ψq.wit = χw := by rw [hψeq]; exact CellUT.wit_immOf _ _ _ _
  rw [hwit] at hexq hagq
  have hEx : ∃ z, ResUT.CompR evq z es := by
    by_cases hk : φ'.kind = Kind.own
    · rcases CellUT.rep' φ' with ⟨w, hw⟩ | ⟨s', w, ξ, hξ, hw⟩ | ⟨b', _, w, ξ, hξ, P, hP, hw⟩
      · obtain ⟨z, hz⟩ := ResUT.reb_own_wit_le hreb (hψeq ▸ hρq)
          (by rw [hφ'g, hw, show w = vv from by rw [← hev, hw]; rfl])
        obtain ⟨e₁, e₂, he₁, he₂, hec⟩ := (ExRT.split_of_compS hz).mp hexS
        rw [show e₁ = evq from ExRT.functional he₁ hexq] at hec
        exact ⟨e₂, hec⟩
      · exact absurd (by rw [hw]; rfl) hφ'k
      · exact absurd (by rw [hw]; rfl : φ'.kind = Kind.mut)
          (by rw [hk]; exact fun e => Kind.noConfusion e)
    · have hkm : φ'.kind = Kind.mut := by
        rcases CellUT.rep' φ' with ⟨w, hw⟩ | ⟨s', w, ξ, hξ, hw⟩ | ⟨b', _, w, ξ, hξ, P, hP, hw⟩
        · exact absurd (by rw [hw]; rfl) hk
        · exact absurd (by rw [hw]; rfl) hφ'k
        · rw [hw]; rfl
      have hwφ : φ'.wit = χw := hor.resolve_left hk
      obtain ⟨ev, z, hev', hz⟩ := ExWT.wit_le hR ResUT.compLawsR hexS hφ'g hkm
      rw [hwφ] at hev'
      rw [show ev = evq from ExRT.functional hev' hexq] at hz
      exact ⟨z, hz⟩
  have hAg : ∃ z, ResUT.CompR avq z as := by
    by_cases hk : φ'.kind = Kind.own
    · rcases CellUT.rep' φ' with ⟨w, hw⟩ | ⟨s', w, ξ, hξ, hw⟩ | ⟨b', _, w, ξ, hξ, P, hP, hw⟩
      · obtain ⟨z, hz⟩ := ResUT.reb_own_wit_le hreb (hψeq ▸ hρq)
          (by rw [hφ'g, hw, show w = vv from by rw [← hev, hw]; rfl])
        obtain ⟨a', a'', ha', ha'', hac⟩ := (AgWT.split hz).mp hagS
        rw [show a' = avq from AgWT.functional ha' hagq] at hac
        exact ⟨a'', hac⟩
      · exact absurd (by rw [hw]; rfl) hφ'k
      · exact absurd (by rw [hw]; rfl : φ'.kind = Kind.mut)
          (by rw [hk]; exact fun e => Kind.noConfusion e)
    · have hkm : φ'.kind = Kind.mut := by
        rcases CellUT.rep' φ' with ⟨w, hw⟩ | ⟨s', w, ξ, hξ, hw⟩ | ⟨b', _, w, ξ, hξ, P, hP, hw⟩
        · exact absurd (by rw [hw]; rfl) hk
        · exact absurd (by rw [hw]; rfl) hφ'k
        · rw [hw]; rfl
      have hwφ : φ'.wit = χw := hor.resolve_left hk
      obtain ⟨av, z, hav', hz⟩ := AgWT.mut_wit_le hagS hφ'g hkm
      rw [hwφ] at hav'
      rw [show av = avq from AgWT.functional hav' hagq] at hz
      exact ⟨z, hz⟩
  exact ⟨a₂, ResUT.CompR.absorb_comp hcq (hfacEx evq hEx).absorb (hfacAg avq hAg).absorb⟩

/-- `ag(ρ_reb) = ρ_reb ○ bi` with `bi` absorbed by `ag(ρᵢ)`.
`[about ours: a decomposition of `ag(ρ_reb)` for `[TR]` 6.59's closing sentence]` -/
theorem ResUT.reb_ag_split {β : Life} {ρ'i ρ areb a₂ : ResUT Loc Val K}
    {l₀ : Loc} {s : TSet} {v : Val} {hs : ρ'i.InStratum s}
    (hreb : ResUT.Reb β ρ'i ρ)
    (hareb : AgWT (ρ.restrictDom ρ'i.exclPart) areb)
    (ha₂ : AgWT (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) a₂)
    {es as pS : ResUT Loc Val K} (hexS : ExRT ρ'i es) (hagS : AgWT ρ'i as)
    (hfS : ResUT.CompR es as pS) :
    ∃ bi, ResUT.CompR (ρ.restrictDom ρ'i.exclPart) bi areb ∧
      ResUT.LeR bi a₂ := by
  classical
  have himmR : ∀ m ψ, (ρ.restrictDom ρ'i.exclPart).get m = some ψ →
      ψ.kind = Kind.imm :=
    fun m ψ hψ => ResUT.reb_imm_image hreb (ResUT.restrictDom_get_inv hψ)
  cases hareb with
  | mk hsm hsi hwm hwi hbm hbi ha hσ =>
      rename_i aa bm bi wm wi
      obtain rfl : wm = [] := by
        have hnil : wm.map Prod.fst = [] :=
          ResUT.sites_nil_of_none hsm (fun m ψ hψ => by
            rw [himmR m ψ hψ]; exact fun e => Kind.noConfusion e)
        cases wm with
        | nil => rfl
        | cons q t => simp at hnil
      obtain rfl : bm = (PMap.empty : ResUT Loc Val K) := BigCompT.nil_inv hbm
      have hrestr : (G.restrict CellUT.kind (ρ.restrictDom ρ'i.exclPart) Kind.imm)
          = ρ.restrictDom ρ'i.exclPart := by
        refine PMap.ext fun m => ?_
        cases e : (ρ.restrictDom ρ'i.exclPart).get m with
        | none => exact ResUT.restrict_get_none e
        | some ψ => exact ResUT.restrict_get_some e (himmR m ψ e)
      obtain rfl : aa = ρ.restrictDom ρ'i.exclPart := by
        rw [← hrestr]
        exact (ResUT.CompR.functional ha (ResUT.comp_empty_right _))
      refine ⟨bi, hσ, a₂, BigCompT.absorb hbi (fun τ hm => ?_)⟩
      obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hm
      obtain ⟨ψq, evq, avq, hψq, hexq, hagq, hcq⟩ := AgWitsIT.mem hwi q hq
      exact (ResUT.reb_wit_absorbs hreb ha₂ hexS hagS hfS hψq hexq hagq hcq).absorb

