/-- `ᾱ ∪ {β} ≠ {β}` for a (nonempty) `ᾱ` that misses `β`. -/
theorem TSet.union_singleton_ne_singleton {s : TSet} {b : Life} (hs : b ∉ s.set) :
    s ∪ TSet.single b ≠ TSet.single b := by
  intro h
  obtain ⟨y, hy⟩ := s.ne
  have hj : y ∈ (s ∪ TSet.single b).set := Finset.mem_union_left _ hy
  rw [h] at hj
  have : y = b := by simpa using hj
  exact hs (this ▸ hy)

