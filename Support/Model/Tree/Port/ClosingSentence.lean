/-- `ᾱ` strictly above `{β}` gives `β ∉ ᾱ`. -/
theorem TSet.notMem_of_above {K : WCactus} {s : TSet} {b : Life}
    (h : K.Above (TSet.single b) s) : b ∉ s.set :=
  fun hb => Cactus.lt_irrefl _ b (h b (by simp) b hb)

