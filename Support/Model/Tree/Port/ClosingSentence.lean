/-- An `imm` cell that outlives `β` carries no borrow at `β`. -/
theorem CellUT.notMem_of_inStratum {Loc Val : Type} {s : TSet} {v : Val}
    {χ : ResUT Loc Val K} {h : χ.InStratum s} {b : Life}
    (hc : (CellUT.immOf s v χ h).InStratum (TSet.single b)) : b ∉ s.set :=
  TSet.notMem_of_above hc

