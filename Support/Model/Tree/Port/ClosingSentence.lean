variable {Loc Val : Type} {K : WCactus}
/-- `x ○ imm({β}, v, χ)` at an `imm` cell `x`: the value and the witness agree
and the sets union. -/
theorem CellUT.compR_immBeta_imm {β : Life} {v : Val} {χ : ResUT Loc Val K}
    {hχ : χ.InStratum (TSet.single β)} {a x : CellUT Loc Val K}
    (h : CellUT.CompR a (CellUT.immOf (TSet.single β) v χ hχ) x)
    (ho : a.InStratum (TSet.single β)) (hak : a.kind = Kind.imm) :
    ∃ (s : TSet) (hs : χ.InStratum s) (hu : χ.InStratum (s ∪ TSet.single β)),
      a = CellUT.immOf s v χ hs ∧ x = CellUT.immOf (s ∪ TSet.single β) v χ hu ∧
        β ∉ s.set := by
  rcases CellUT.CompR.inv h with ⟨e, -⟩ | ⟨k, ex⟩ |
      ⟨_, _, _, _, _, _, _, _, _, _, _, _, -, e₂, -⟩ | ⟨-, hk2, -⟩ | ⟨-, hk1, -⟩ |
      ⟨-, -, hk2⟩ | ⟨-, hk1, -⟩
  · rw [e] at ho
    exact (Cactus.lt_irrefl _ β (ho β (by simp) β (by simp))).elim
  · have hcs : CellUT.CompS a (CellUT.immOf (TSet.single β) v χ hχ) x :=
      ex ▸ CellUT.compS_spec _ _ k
    obtain ⟨s₁, s₂, u, τ, k₁, k₂, k₃, f₁, f₂, f₃⟩ := hcs
    obtain ⟨hs2, hu2, hτ2⟩ := CellUT.immOf_inj f₂
    subst hs2
    subst hu2
    subst hτ2
    refine ⟨s₁, k₁, k₃, f₁, f₃, ?_⟩
    rw [f₁] at ho
    exact TSet.notMem_of_above ho
  · exact absurd e₂ CellUT.immOf_ne_mutOf
  · simp at hk2
  · rw [hak] at hk1; simp at hk1
  · simp at hk2
  · rw [hak] at hk1; simp at hk1

/-- An `imm` cell missing `β`, composed with `ρ_reb`'s `imm({β}, v, χ)`, is not
`ρ_reb`'s cell alone. -/
theorem CellUT.reb_frame_imm_ne_singleton {β : Life} {v : Val} {χ : ResUT Loc Val K}
    {hχ : χ.InStratum (TSet.single β)} {a x : CellUT Loc Val K}
    (h : CellUT.CompR a (CellUT.immOf (TSet.single β) v χ hχ) x)
    (ho : a.InStratum (TSet.single β)) (hak : a.kind = Kind.imm) :
    x ≠ CellUT.immOf (TSet.single β) v χ hχ := by
  obtain ⟨s, hs, hu, -, ex, hβs⟩ := CellUT.compR_immBeta_imm h ho hak
  intro e
  rw [ex] at e
  exact TSet.union_singleton_ne_singleton hβs (CellUT.immOf_inj e).1

/-- Where `ag(ρ)` is defined, `ex(ρ)_●` is not.
`[about ours: the disjointness of a flattening's two walks]` -/
theorem ResUT.ex_none_of_ag_some {e a σ : ResUT Loc Val K}
    (himm : e.ImmFree) (hc : ResUT.CompS e a σ)
    {l : Loc} {c : CellUT Loc Val K} (hg : a.get l = some c) :
    e.get l = none := by
  rcases ResUT.CompatS.disjoint_of_immFree himm hc.1 l with h | h
  · exact h
  · rw [hg] at h; exact absurd h (by simp)

/-- A flattening is its aliasable walk where that walk is defined.
`[about ours: `ResUT.flat_eq_ag_at` without its kind hypothesis]` -/
theorem ResUT.flat_eq_ag_of_immFree {e a σ : ResUT Loc Val K}
    (himm : e.ImmFree) (hc : ResUT.CompS e a σ)
    {l : Loc} {c : CellUT Loc Val K} (hg : a.get l = some c) :
    σ.get l = some c := by
  have hn := ResUT.ex_none_of_ag_some himm hc hg
  rcases ResUT.Comp.get hc l with ⟨-, f₂, -⟩ | ⟨ψ, f₁, -, -⟩ | ⟨ψ, -, f₂, f⟩ |
      ⟨ψ₁, ψ₂, ψ, f₁, -, -, -⟩
  · rw [hg] at f₂; exact absurd f₂ (by simp)
  · rw [hn] at f₁; exact absurd f₁ (by simp)
  · rw [f, show ψ = c from Option.some.inj (f₂.symm.trans hg)]
  · rw [hn] at f₁; exact absurd f₁ (by simp)

/-- An `imm`-only resource has an empty exclusive walk.
`[about ours: `ex(−)_◐` at a resource carrying `imm` cells only]` -/
theorem ExWT.eq_empty_of_immOnly {R : CellUT Loc Val K → CellUT Loc Val K → Prop}
    {C : CellUT Loc Val K → CellUT Loc Val K → CellUT Loc Val K → Prop}
    {ρ : ResUT Loc Val K}
    (h : ∀ l ψ, ρ.get l = some ψ → ψ.kind = Kind.imm) :
    ExWT R C ρ (PMap.empty : ResUT Loc Val K) := by
  have hr : ∀ k : Kind, k ≠ Kind.imm → (G.restrict CellUT.kind ρ k) = (PMap.empty : ResUT Loc Val K) := by
    intro k hk
    refine PMap.ext fun l => ?_
    show (ρ.get l).bind (fun ψ => if ψ.kind = k then some ψ else none) = _
    cases e : ρ.get l with
    | none => simp [PMap.empty_get]
    | some ψ =>
        have hne : ψ.kind ≠ k := by rw [h l ψ e]; exact fun c => hk c.symm
        simp [hne, PMap.empty_get]
  refine G.ExW.mk (w := []) (b := PMap.empty) (nm := PMap.empty)
    ⟨List.nodup_nil, fun l => ?_⟩ G.ExWits.nil G.BigComp.nil ?_ ?_
  · refine ⟨fun hl => absurd hl (by simp), ?_⟩
    rintro ⟨ψ, hg, hk⟩
    rw [h l ψ hg] at hk
    exact absurd hk (by simp)
  · rw [hr Kind.own (by simp), hr Kind.mut (by simp)]
    exact ResUT.comp_empty_right _
  · exact ResUT.comp_empty_right _

/-- Swapping one `imm`-only factor for another leaves the exclusive walk
unchanged.
`[about ours: `ExST.split` at an `imm`-only factor]` -/
theorem ResUT.ex_eq_of_swap_immOnly {L F Gr Lf Lg eF eG : ResUT Loc Val K}
    (hF : ∀ l ψ, F.get l = some ψ → ψ.kind = Kind.imm)
    (hG : ∀ l ψ, Gr.get l = some ψ → ψ.kind = Kind.imm)
    (hLf : ResUT.CompS L F Lf) (hLg : ResUT.CompS L Gr Lg)
    (heF : ExST Lf eF) (heG : ExST Lg eG) : eF = eG := by
  obtain ⟨e₁, e₂, he₁, he₂, hec⟩ := (ExST.split hLf).mp heF
  obtain ⟨d₁, d₂, hd₁, hd₂, hdc⟩ := (ExST.split hLg).mp heG
  cases ExST.functional he₂ (ExWT.eq_empty_of_immOnly hF)
  cases ExST.functional hd₂ (ExWT.eq_empty_of_immOnly hG)
  cases ExST.functional hd₁ he₁
  exact (ResUT.CompS.functional hec (ResUT.comp_empty_right _)).trans
    (ResUT.CompS.functional (ResUT.comp_empty_right _) hdc)

/-- `ρ|dom(ρ′ᵢ|imm)` outlives `β`: one of the components that `[TR]` 6.59's
closing sentence says *"outlive `β`"*.
`[about ours: a component of `[TR]` 6.59's left side]` -/
theorem ResUT.reb_immPart_inStratum {α : Life} {ρ' ρ : ResUT Loc Val K}
    (h : ResUT.Reb α ρ' ρ) :
    (ρ.restrictDom (G.restrict CellUT.kind ρ' Kind.imm)).InStratum (TSet.single α) := by
  intro l ψ hg
  have himg : ρ.get l = some ψ := ResUT.restrictDom_get_inv hg
  cases e : (G.restrict CellUT.kind ρ' Kind.imm).get l with
  | none => rw [ResUT.restrictDom_get_of_none e] at hg; exact absurd hg (by simp)
  | some φ =>
      obtain ⟨hsrc, hk⟩ := ResUT.restrict_eq_some.mp e
      exact (ResUT.reb_imm_cell_kw h himg hsrc hk).2.2.2 _ (h.1 l φ hsrc)

/-- If the `imm` cell `↭` pins at `m` is an `imm` cell of `ag(R)`, then `⦇κ⦈_○`
is a `○`-factor of `ag(R) ○ ag(ρᵢ)`.
`[about ours: the attribution branch of `[TR]` 6.59 where `ag(R)` carries the
ancestor]` -/
theorem ResUT.reb_attribute_of_side {R aR ai aRi : ResUT Loc Val K}
    (haR : AgWT R aR) (hRi : ResUT.CompR aR ai aRi)
    {m : Loc} {t : TSet} {u : Val} {κ : ResUT Loc Val K} {hh : κ.InStratum t}
    (hm : aR.get m = some (CellUT.immOf t u κ hh)) :
    ∃ ev av p z, ExRT κ ev ∧ AgWT κ av ∧ ResUT.CompR ev av p ∧ ResUT.CompR p z aRi := by
  obtain ⟨ev, av, p, z, hev, hav, hp, hz⟩ := AgWT.flat_imm_wit_le haR m t u κ hh hm
  obtain ⟨x, -, hx⟩ := (ResUT.CompR.assoc p z ai aRi).mpr ⟨aR, hz, hRi⟩
  exact ⟨ev, av, p, x, hev, hav, hp, hx⟩

/-- If `↭` pins an `imm` cell over witness `κ` at the ancestor `m` of
`ag(R ● ρ_reb)`, then `⦇κ⦈_○` is a `○`-factor of `ag(R) ○ ag(ρᵢ)`.
`[about ours: `[TR]` 6.59's attribution, assembled]` -/
theorem ResUT.reb_attribute {β : Life} {ρ'i ρ R aR areb a₂ aRreb aRi : ResUT Loc Val K}
    {l₀ : Loc} {s : TSet} {v : Val} {hs : ρ'i.InStratum s}
    (hreb : ResUT.Reb β ρ'i ρ)
    (haR : AgWT R aR)
    (hareb : AgWT (ρ.restrictDom ρ'i.exclPart) areb)
    (ha₂ : AgWT (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) a₂)
    {es as pS : ResUT Loc Val K} (hexS : ExRT ρ'i es) (hagS : AgWT ρ'i as)
    (hfS : ResUT.CompR es as pS)
    (hRreb : ResUT.CompR aR areb aRreb) (hRi : ResUT.CompR aR a₂ aRi)
    {m : Loc} {t : TSet} {u : Val} {κ : ResUT Loc Val K} {hh : κ.InStratum t}
    (hm : aRreb.get m = some (CellUT.immOf t u κ hh)) :
    ∃ ev av p z, ExRT κ ev ∧ AgWT κ av ∧ ResUT.CompR ev av p ∧
      ResUT.CompR p z aRi := by
  classical
  have hRc : ∀ ψ₁ ψ₂ ψ : CellUT Loc Val K, CellUT.CompR ψ₁ ψ₂ ψ → CellUT.CompatR ψ₁ ψ₂ :=
    fun _ _ ψ hc => ⟨ψ, hc⟩
  have hofAbs : ∀ {q : ResUT Loc Val K}, ResUT.CompR q a₂ a₂ →
      ∃ z, ResUT.CompR q z aRi := by
    intro q habs
    obtain ⟨y, hy₁, hy₂⟩ := (ResUT.CompR.assoc aR q a₂ aRi).mp ⟨a₂, habs, hRi⟩
    exact ResUT.Comp.factor_trans hRc ResUT.compLawsR (ResUT.CompR.comm hy₁) hy₂
  rcases ResUT.CompR.imm_source hRreb hm with ⟨t₁, h₁, hin⟩ | ⟨t₂, h₂, hin⟩
  · exact ResUT.reb_attribute_of_side haR hRi hin
  · obtain ⟨bi, hσ, hbiabs⟩ := ResUT.reb_ag_split hreb hareb ha₂ hexS hagS hfS
    obtain ⟨ev, av, p, -, hev, hav, hp, -⟩ :=
      AgWT.flat_imm_wit_le hareb m t₂ u κ h₂ hin
    have habs : ResUT.LeR p a₂ := by
      rcases ResUT.CompR.imm_source hσ hin with ⟨t₃, h₃, hown⟩ | ⟨t₄, h₄, hbi⟩
      · refine ResUT.reb_wit_absorbs hreb ha₂ hexS hagS hfS hown ?_ ?_ hp
        · rw [show (CellUT.immOf t₃ u κ h₃).wit = κ from CellUT.wit_immOf _ _ _ _]
          exact hev
        · rw [show (CellUT.immOf t₃ u κ h₃).wit = κ from CellUT.wit_immOf _ _ _ _]
          exact hav
      · obtain ⟨t₅, h₅, ha₂m⟩ := ResUT.CompR.imm_left_get hbiabs.absorb hbi
        obtain ⟨ev', av', p', z', hev', hav', hp', hz'⟩ :=
          AgWT.flat_imm_wit_le ha₂ m t₅ u κ h₅ ha₂m
        cases ExRT.functional hev' hev
        cases AgWT.functional hav' hav
        cases ResUT.CompR.functional hp' hp
        exact ⟨_, hz'⟩
    obtain ⟨z, hz⟩ := hofAbs habs.absorb
    exact ⟨ev, av, p, z, hev, hav, hp, hz⟩

/-- Off `dom(ρ_reb)`, `ag(ρ_reb)`'s cell is absorbed by `ag(ρᵢ)`'s, without
`ρ # ρᵢ`.
`[about ours: `ag(ρ_reb)` off `dom(ρ_reb)`, without `ρ # ρᵢ`]` -/
theorem ResUT.reb_ag_cell_absorbed_off_dom {β : Life} {ρ'i ρ areb a₂ : ResUT Loc Val K}
    {l₀ : Loc} {s : TSet} {v : Val} {hs : ρ'i.InStratum s}
    (hreb : ResUT.Reb β ρ'i ρ)
    (hareb : AgWT (ρ.restrictDom ρ'i.exclPart) areb)
    (ha₂ : AgWT (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) a₂)
    {es as pS : ResUT Loc Val K} (hexS : ExRT ρ'i es) (hagS : AgWT ρ'i as)
    (hfS : ResUT.CompR es as pS)
    {m : Loc} (hm : (ρ.restrictDom ρ'i.exclPart).get m = none)
    {ψ : CellUT Loc Val K} (hψ : areb.get m = some ψ) :
    ∃ φ, a₂.get m = some φ ∧ CellUT.CompR ψ φ φ := by
  obtain ⟨bi, hσ, hbile⟩ := ResUT.reb_ag_split hreb hareb ha₂ hexS hagS hfS
  -- off `ρ_reb`'s own domain the walk's cell is `bi`'s
  have hbim : bi.get m = some ψ := by
    rcases ResUT.Comp.get hσ m with ⟨-, f₂, f⟩ | ⟨ξ, f₁, -, -⟩ | ⟨ξ, -, f₂, f⟩ |
        ⟨ξ₁, ξ₂, ξ, f₁, -, -, -⟩
    · rw [f] at hψ; exact absurd hψ (by simp)
    · rw [hm] at f₁; exact absurd f₁ (by simp)
    · exact f₂.trans (congrArg some (Option.some.inj (f.symm.trans hψ)))
    · rw [hm] at f₁; exact absurd f₁ (by simp)
  -- and `≼` absorbs it
  rcases ResUT.Comp.get hbile.absorb m with ⟨f₁, -, -⟩ | ⟨ξ, -, f₂, f⟩ |
      ⟨ξ, f₁, -, -⟩ | ⟨ξ₁, ξ₂, ξ, f₁, f₂, f, hC⟩
  · rw [hbim] at f₁; exact absurd f₁ (by simp)
  · rw [f] at f₂; exact absurd f₂.symm (by simp)
  · rw [hbim] at f₁; exact absurd f₁ (by simp)
  · refine ⟨ξ₂, f₂, ?_⟩
    obtain rfl : ξ₁ = ψ := Option.some.inj (f₁.symm.trans hbim)
    obtain rfl : ξ = ξ₂ := Option.some.inj (f.symm.trans f₂)
    exact hC

/-- `○` at two `imm` cells: one value, one witness, the union of the sets.
`[about ours: `[TR]` p. 5's `○` at two `imm` cells, read off the relation]` -/
theorem CellUT.CompR.imm_imm_union {ψ₁ ψ₂ ψ : CellUT Loc Val K} (h : CellUT.CompR ψ₁ ψ₂ ψ)
    (k₁ : ψ₁.kind = Kind.imm) (k₂ : ψ₂.kind = Kind.imm) :
    ∃ (a b : TSet) (u : Val) (χ : ResUT Loc Val K)
      (ha : χ.InStratum a) (hb : χ.InStratum b)
      (hu : χ.InStratum (a ∪ b)),
      ψ₁ = CellUT.immOf a u χ ha ∧ ψ₂ = CellUT.immOf b u χ hb ∧
        ψ = CellUT.immOf (a ∪ b) u χ hu := by
  obtain ⟨a, ha, e₁⟩ := CellUT.imm_eta k₁
  obtain ⟨b, hb, e₂⟩ := CellUT.imm_eta k₂
  have hv : ψ₁.erase = ψ₂.erase := (CellUT.CompR.erase h).1
  have hw : ψ₁.wit = ψ₂.wit :=
    CellUT.CompR.wit h (by rw [k₁]; simp) (by rw [k₂]; simp)
  have hb' : ψ₁.wit.InStratum b := by rw [hw]; exact hb
  have e₂' : ψ₂ = CellUT.immOf b ψ₁.erase ψ₁.wit hb' :=
    e₂.trans (CellUT.immOf_congr rfl hv.symm hw.symm hb hb')
  obtain ⟨hu, e⟩ := CellUT.CompR.imm_union h e₁ e₂'
  exact ⟨a, b, ψ₁.erase, ψ₁.wit, ha, hb', hu, e₁, e₂', e⟩

/-- Absorption is transitive. -/
theorem CellUT.CompR.absorb_transC {X Y Z : CellUT Loc Val K}
    (h₁ : CellUT.CompR X Y Y) (h₂ : CellUT.CompR Y Z Z) : CellUT.CompR X Z Z := by
  obtain ⟨w, hw, hx⟩ := (CellUT.compR_assoc X Y Z Z).mpr ⟨Y, h₁, h₂⟩
  rwa [CellUT.CompR.functional hw h₂] at hx

/-- Absorption is pointwise.
`[about ours: `ResUT.CompR` at a resource absorbed cell by cell]` -/
theorem ResUT.compR_absorb_of_cells {X W : ResUT Loc Val K}
    (h : ∀ n ψ, X.get n = some ψ → ∃ φ, W.get n = some φ ∧ CellUT.CompR ψ φ φ) :
    ResUT.CompR X W W := by
  refine ⟨fun l ψ₁ ψ₂ e₁ e₂ => ?_, fun l => ?_⟩
  · obtain ⟨φ, hφ, hc⟩ := h l ψ₁ e₁
    rw [hφ] at e₂
    obtain rfl : φ = ψ₂ := Option.some.inj e₂
    exact ⟨φ, hc⟩
  · show OptCompT CellUT.CompR (X.get l) (W.get l) (W.get l)
    cases e : X.get l with
    | none =>
        cases f : W.get l with
        | none => rfl
        | some φ => rfl
    | some ψ =>
        obtain ⟨φ, hφ, hc⟩ := h l ψ e
        rw [hφ]
        exact ⟨φ, rfl, hc⟩

/-- `≼` at one location: where the smaller resource is defined, so is the
larger, and the larger's cell absorbs the smaller's.
`[about ours: `ResUT.LeR` at one location]` -/
theorem ResUT.LeR.get_some {τ σ : ResUT Loc Val K} (h : ResUT.LeR τ σ) {m : Loc}
    {ψ : CellUT Loc Val K} (hg : τ.get m = some ψ) :
    ∃ χ, σ.get m = some χ ∧ CellUT.CompR ψ χ χ := by
  have habs := h.absorb.2 m
  rw [hg] at habs
  cases f : σ.get m with
  | none =>
      rw [f] at habs
      exact absurd (show (none : Option (CellUT Loc Val K)) = some ψ from habs) (by simp)
  | some χ =>
      rw [f] at habs
      obtain ⟨ζ, hζ, hc⟩ := habs
      obtain rfl : χ = ζ := Option.some.inj hζ
      exact ⟨_, rfl, hc⟩

/-- Every `imm` cell of the walk `σ` is absorbed by `W`.
`[about ours: the `imm`-cell half of the hypothesis `[TR]` 6.59's closing
sentence spends on a walk]` -/
def AgWT.AbsImm (σ W : ResUT Loc Val K) : Prop :=
  ∀ m ψ, σ.get m = some ψ → ψ.kind = Kind.imm →
    ∃ φ, W.get m = some φ ∧ CellUT.CompR ψ φ φ

/-- Every `imm` cell of the walk `σ` has its witness's `⦇−⦈_○` inside `W`.
`[about ours: the witness half of the hypothesis `[TR]` 6.59's closing sentence
spends on a walk]` -/
def AgWT.AbsAnc (σ W : ResUT Loc Val K) : Prop :=
  ∀ (m : Loc) (t : TSet) (u : Val) (κ : ResUT Loc Val K) (hh : κ.InStratum t),
    σ.get m = some (CellUT.immOf t u κ hh) →
    ∀ ev av p, ExRT κ ev → AgWT κ av → ResUT.CompR ev av p → ResUT.CompR p W W

/-- `AgWT.AbsImm` passes to a `○`-factor of the walk. -/
theorem AgWT.AbsImm.of_le {τ σ W : ResUT Loc Val K} (hle : ResUT.LeR τ σ)
    (h : AgWT.AbsImm σ W) : AgWT.AbsImm τ W := by
  intro m ψ hg hk
  obtain ⟨χ, hχ, hc⟩ := hle.get_some hg
  have hχk : χ.kind = Kind.imm := by
    obtain ⟨t, ht, e⟩ := CellUT.imm_eta hk
    obtain ⟨t', h', e'⟩ := CellUT.CompR.imm_left_eq hc e
    rw [e']; exact CellUT.kind_immOf _ _ _ _
  obtain ⟨φ, hφ, hcf⟩ := h m χ hχ hχk
  exact ⟨φ, hφ, CellUT.CompR.absorb_transC hc hcf⟩

theorem AgWT.AbsAnc.of_le {τ σ W : ResUT Loc Val K} (hle : ResUT.LeR τ σ)
    (h : AgWT.AbsAnc σ W) : AgWT.AbsAnc τ W := by
  intro m t u κ hh hg ev av p hev hav hp
  obtain ⟨χ, hχ, hc⟩ := hle.get_some hg
  obtain ⟨t', h', e'⟩ := CellUT.CompR.imm_left_eq hc rfl
  rw [e'] at hχ
  exact h m t' u κ h' hχ ev av p hev hav hp

/-- If `W` absorbs every `imm` cell of `ag(X)` and contains each one's
witness's `⦇−⦈_○`, then `W` absorbs `ag(X)`.
`[about ours: `AgWT.nonimm_beneath_imm` as an absorption rather than a trace]` -/
theorem AgWT.absorb_of_ancestors {X a : ResUT Loc Val K} (h : AgWT X a) :
    ∀ W : ResUT Loc Val K, AgWT.AbsImm a W → AgWT.AbsAnc a W → ResUT.CompR a W W := by
  have hR : ∀ ψ₁ ψ₂ ψ : CellUT Loc Val K, CellUT.CompR ψ₁ ψ₂ ψ → CellUT.CompatR ψ₁ ψ₂ :=
    fun _ _ ψ hc => ⟨ψ, hc⟩
  refine G.AgW.rec
    (motive_1 := fun _ σ _ => ∀ W, AgWT.AbsImm σ W → AgWT.AbsAnc σ W →
      ResUT.CompR σ W W)
    (motive_2 := fun _ w _ => ∀ q ∈ w, ∀ W, AgWT.AbsImm q.2 W → AgWT.AbsAnc q.2 W →
      ResUT.CompR q.2 W W)
    (motive_3 := fun _ _ _ => True)
    ?mk ?nilM ?consM ?nilI ?consI h
  case mk =>
    intro ρ' σ' aa bm bi wm wi hsm hsi hwm hwi hbm hbi ha hσ ihm _ W himm hanc
    have hag : AgWT ρ' σ' := G.AgW.mk hsm hsi hwm hwi hbm hbi ha hσ
    have hleA : ResUT.LeR aa σ' := ResUT.LeR.left hσ
    have hleBi : ResUT.LeR bi σ' := ResUT.LeR.right hσ
    have hleBm : ResUT.LeR bm aa := ResUT.LeR.right ha
    have hleImm : ResUT.LeR (G.restrict CellUT.kind ρ' Kind.imm) aa := ResUT.LeR.left ha
    -- (1) the top-level `imm` cells
    have h1 : ResUT.CompR (G.restrict CellUT.kind ρ' Kind.imm) W W := by
      refine ResUT.compR_absorb_of_cells (fun n ψ hg => ?_)
      exact AgWT.AbsImm.of_le (hleImm.trans hleA) himm n ψ hg
        (ResUT.restrict_eq_some.mp hg).2
    -- (2) the `mut` family
    have h2 : ResUT.CompR bm W W := by
      refine BigCompT.absorb hbm (fun τ hm => ?_)
      obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hm
      obtain ⟨z, hz⟩ := BigCompT.mem_factor hR ResUT.compLawsR hbm q.2
        (List.mem_map.mpr ⟨q, hq, rfl⟩)
      have hle : ResUT.LeR q.2 σ' :=
        (ResUT.LeR.left hz).trans (hleBm.trans hleA)
      exact ihm q hq W (AgWT.AbsImm.of_le hle himm) (AgWT.AbsAnc.of_le hle hanc)
    -- (3) the `imm` family
    have h3 : ResUT.CompR bi W W := by
      refine BigCompT.absorb hbi (fun τ hm => ?_)
      obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hm
      obtain ⟨ψ, ev, av, hψ, hex, hav, hp⟩ := AgWitsIT.mem hwi q hq
      obtain ⟨ψ', hψ', hk'⟩ := (hsi.2 q.1).mp (List.mem_map.mpr ⟨q, hq, rfl⟩)
      obtain rfl : ψ' = ψ := Option.some.inj (hψ'.symm.trans hψ)
      obtain ⟨χ, hχ, hχk, hχe, hχw⟩ := AgWT.get_imm hag hψ hk'
      obtain ⟨t, ht, he⟩ := CellUT.imm_eta hχk
      rw [he] at hχ
      refine hanc q.1 t χ.erase χ.wit ht hχ ev av q.2 ?_ ?_ hp
      · rw [hχw]; exact hex
      · rw [hχw]; exact hav
    exact ResUT.CompR.absorb_comp hσ (ResUT.CompR.absorb_comp ha h1 h2) h3
  case nilM => intro ρ' q hq; exact absurd hq (by simp)
  case consM =>
    intro ρ' e l w ψ hψ hk he hw ihe ihw q hq
    rcases List.mem_cons.mp hq with rfl | hq'
    · exact ihe
    · exact ihw q hq'
  case nilI => intro _; trivial
  case consI => intro _ _ _ _ _ _ _ _ _ _ _ _ _ _ _; trivial

end BoCa.Fig16.Tree
namespace BoCa.Fig16.Tree
open BoCa.Fig16
/-- `ᾱ ⊆ ᾱ_R ∪ {β}` and `β ∉ ᾱ` give `ᾱ ⊆ ᾱ_R`; `β ∉ ᾱ` is *"all components
of the composition besides for `ρ_reb` outlive `β`"*. -/
theorem TSet.union_singleton_le_cancel {s t : TSet} {b : Life} (hs : b ∉ s.set)
    (h : s ∪ (t ∪ TSet.single b) = t ∪ TSet.single b) : s ∪ t = t := by
  refine TSet.ext (Finset.ext fun x => ?_)
  have hx : x ∈ (s ∪ (t ∪ TSet.single b)).set ↔ x ∈ (t ∪ TSet.single b).set := by
    rw [h]
  simp only [TSet.union_set, TSet.single_set, Finset.mem_union, Finset.mem_singleton] at hx ⊢
  by_cases hb : x = b
  · subst hb
    exact ⟨fun c => c.elim (fun d => absurd d hs) id, fun c => Or.inr c⟩
  · refine ⟨fun c => ?_, fun c => Or.inr c⟩
    rcases c with c | c
    · exact (hx.mp (Or.inl c)).elim id (fun d => absurd d hb)
    · exact c

end BoCa.Fig16.Tree
namespace BoCa.Fig16.Tree
open BoCa.Fig16
variable {Loc Val : Type} {K : WCactus}
/-- An `imm` cell `ψ` outliving `β` that is absorbed by `d ○ imm({β}, u, κ)` is
absorbed by `d`.
`[about ours: `[TR]` 6.59's *"neither have the immutable borrow at `β` from
`ρ_reb`"* as a `≼` at one cell]` -/
theorem CellUT.reb_frame_imm_le {β : Life} {u : Val} {κ : ResUT Loc Val K}
    {hy : κ.InStratum (TSet.single β)} {ψ d e : CellUT Loc Val K}
    (hψβ : ψ.InStratum (TSet.single β)) (hψk : ψ.kind = Kind.imm)
    (hdB : CellUT.CompR d (CellUT.immOf (TSet.single β) u κ hy) e)
    (hψe : CellUT.CompR ψ e e) : CellUT.CompR ψ d d := by
  classical
  have hBk : (CellUT.immOf (TSet.single β) u κ hy).kind = Kind.imm :=
    CellUT.kind_immOf _ _ _ _
  have hcomm : CellUT.CompR (CellUT.immOf (TSet.single β) u κ hy) d e :=
    CellUT.CompR.comm hdB
  have hek : e.kind = Kind.imm := by
    obtain ⟨E, hE, heE⟩ := CellUT.CompR.imm_left_eq hcomm rfl
    rw [heE]; exact CellUT.kind_immOf _ _ _ _
  obtain ⟨a, c, uu, χ, ha, hc, hu, eψ, ee, ecomp⟩ :=
    CellUT.CompR.imm_imm_union hψe hψk hek
  have haE : a ∪ c = c := (CellUT.immOf_inj (ecomp.symm.trans ee)).1
  have hβa : β ∉ a.set := CellUT.notMem_of_inStratum (eψ ▸ hψβ)
  by_cases hdk : d.kind = Kind.imm
  · obtain ⟨D, sb, ud, χd, hD, hsb, hud, ed, eB, ecd⟩ :=
      CellUT.CompR.imm_imm_union hdB hdk hBk
    obtain ⟨rfl, rfl, rfl⟩ := CellUT.immOf_inj eB.symm
    obtain ⟨rfl, rfl, rfl⟩ := CellUT.immOf_inj (ee.symm.trans ecd)
    have haD : a ∪ D = D := TSet.union_singleton_le_cancel hβa haE
    have hcs : ψ.CompatS d := by
      rw [eψ, ed]; exact ⟨a, D, uu, χ, ha, hD, rfl, rfl⟩
    obtain ⟨s₁, s₂, vv, ρρ, k₁, k₂, k₃, f₁, f₂, f₃⟩ := CellUT.compS_spec ψ d hcs
    obtain ⟨rfl, rfl, rfl⟩ := CellUT.immOf_inj (eψ.symm.trans f₁)
    obtain ⟨rfl, -, -⟩ := CellUT.immOf_inj (ed.symm.trans f₂)
    have hfix : CellUT.compS ψ d hcs = d := by
      rw [f₃, ed]; exact CellUT.immOf_congr haD rfl rfl k₃ hD
    have hstr : CellUT.CompR ψ d (CellUT.compS ψ d hcs) := CellUT.CompR.strict hcs
    rwa [hfix] at hstr
  · exfalso
    have heB : e = CellUT.immOf (TSet.single β) u κ hy :=
      CellUT.CompR.imm_nonimm_left hcomm hBk hdk
    have h2 := (CellUT.immOf_inj (ee.symm.trans heB)).1
    refine TSet.union_singleton_ne_singleton hβa ?_
    rw [← h2]; exact haE

/-- `ag(ρᵢ)` is defined wherever `ρ_reb` is.
`[about ours: `ag(ρᵢ)` at a location `ρ_reb` covers]` -/
theorem ResUT.ag_single_imm_some_of_reb
    {ρ'i ρ ai : ResUT BoCa.Loc BoCa.Val K}
    {l₀ : BoCa.Loc} {s : TSet} {v : BoCa.Val} {hs : ρ'i.InStratum s}
    (hai : AgWT (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) ai)
    {l : BoCa.Loc} {ζ : CellUT BoCa.Loc BoCa.Val K}
    (hζ : (ρ.restrictDom ρ'i.exclPart).get l = some ζ) :
    ∃ c, ai.get l = some c := by
  obtain ⟨es, as, pS, hexS, hagS, hfS, hagi⟩ := AgWT.single_imm_inv hai
  obtain ⟨φ', hφ'⟩ := ResUT.restrictDom_dom hζ
  obtain ⟨hφ'g, hφ'k⟩ := ResUT.exclPart_eq_some.mp hφ'
  obtain ⟨ξ, hξ, -, -⟩ := ExRT.get_of_ne_imm hexS hφ'g hφ'k
  have hpS : ∃ c, pS.get l = some c := by
    rcases ResUT.Comp.get hfS l with ⟨f₁, -, -⟩ | ⟨ψ, -, -, f⟩ | ⟨ψ, f₁, -, -⟩ |
        ⟨ψ₁, ψ₂, ψ, -, -, f, -⟩
    · rw [hξ] at f₁; exact absurd f₁ (by simp)
    · exact ⟨ψ, f⟩
    · rw [hξ] at f₁; exact absurd f₁ (by simp)
    · exact ⟨ψ, f⟩
  obtain ⟨cS, hcS⟩ := hpS
  rcases ResUT.Comp.get hagi l with ⟨-, f₂, -⟩ | ⟨ψ, -, -, f⟩ | ⟨ψ, -, f₂, f⟩ |
      ⟨ψ₁, ψ₂, ψ, -, -, f, -⟩
  · rw [hcS] at f₂; exact absurd f₂ (by simp)
  · exact ⟨ψ, f⟩
  · exact ⟨ψ, f⟩
  · exact ⟨ψ, f⟩

/-- Where the aliasable walk is undefined, the flattening is the exclusive walk.
`[about ours: `⦇ρ⦈` where `ag(ρ)` carries nothing]` -/
theorem ResUT.flat_eq_ex_of_ag_none {Loc Val : Type} {e a σ : ResUT Loc Val K}
    (hc : ResUT.CompS e a σ) {l : Loc} (h : a.get l = none) :
    σ.get l = e.get l := by
  rcases ResUT.Comp.get hc l with ⟨f₁, -, f⟩ | ⟨ψ, f₁, -, f⟩ | ⟨ψ, -, f₂, -⟩ |
      ⟨ψ₁, ψ₂, ψ, -, f₂, -, -⟩
  · rw [f, f₁]
  · rw [f, f₁]
  · rw [h] at f₂; exact absurd f₂ (by simp)
  · rw [h] at f₂; exact absurd f₂ (by simp)

/-- Two flattenings that agree at `ℓ` are `ResUT.SimFormAt` there. -/
theorem ResUT.simFormAt_of_eq {σ₁ σ₂ : ResUT BoCa.Loc BoCa.Val K} {l : BoCa.Loc}
    (h : σ₁.get l = σ₂.get l) : ResUT.SimFormAt σ₁ σ₂ l := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rintro ⟨ψ, hψ⟩
    obtain ⟨hg, hk⟩ := ResUT.borrowPart_eq_some.mp hψ
    exact ⟨ψ, ResUT.borrowPart_eq_some.mpr ⟨h ▸ hg, hk⟩⟩
  · rintro ⟨ψ, hψ⟩
    obtain ⟨hg, hk⟩ := ResUT.borrowPart_eq_some.mp hψ
    exact ⟨ψ, ResUT.borrowPart_eq_some.mpr ⟨h.symm ▸ hg, hk⟩⟩
  · intro ψ hψ
    obtain ⟨hg, hk⟩ := ResUT.borrowPart_eq_some.mp hψ
    exact ⟨ψ, h ▸ hg, CellUT.Sim.refl hk⟩

/-- `ResUT.SimFormAt` reads its two flattenings at `ℓ` only. -/
theorem ResUT.simFormAt_congr {σ₁ σ₂ τ₁ τ₂ : ResUT BoCa.Loc BoCa.Val K} {l : BoCa.Loc}
    (h₁ : σ₁.get l = τ₁.get l) (h₂ : σ₂.get l = τ₂.get l)
    (h : ResUT.SimFormAt τ₁ τ₂ l) : ResUT.SimFormAt σ₁ σ₂ l := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rintro ⟨ψ, hψ⟩
    obtain ⟨hg, hk⟩ := ResUT.borrowPart_eq_some.mp hψ
    obtain ⟨φ, hφ⟩ := h.1.1 ⟨ψ, ResUT.borrowPart_eq_some.mpr ⟨h₁.symm.trans hg, hk⟩⟩
    obtain ⟨hg₂, hk₂⟩ := ResUT.borrowPart_eq_some.mp hφ
    exact ⟨φ, ResUT.borrowPart_eq_some.mpr ⟨h₂.trans hg₂, hk₂⟩⟩
  · rintro ⟨ψ, hψ⟩
    obtain ⟨hg, hk⟩ := ResUT.borrowPart_eq_some.mp hψ
    obtain ⟨φ, hφ⟩ := h.1.2 ⟨ψ, ResUT.borrowPart_eq_some.mpr ⟨h₂.symm.trans hg, hk⟩⟩
    obtain ⟨hg₂, hk₂⟩ := ResUT.borrowPart_eq_some.mp hφ
    exact ⟨φ, ResUT.borrowPart_eq_some.mpr ⟨h₁.trans hg₂, hk₂⟩⟩
  · intro ψ hψ
    obtain ⟨hg, hk⟩ := ResUT.borrowPart_eq_some.mp hψ
    obtain ⟨φ, hφ, hsim⟩ :=
      h.2 ψ (ResUT.borrowPart_eq_some.mpr ⟨h₁.symm.trans hg, hk⟩)
    exact ⟨φ, h₂.trans hφ, hsim⟩

/-- The `ℓ ∈ dom(ρ_reb)` half of `[TR]` 6.59's closing sentence, with `χ` bound
by `ResUT.SubKeep` (§12.58).
`[about ours]` -/
def ResUT.SixFiftyNineResidualKeep : Prop :=
  ∀ (β : Life) (ρ'i ρ ρb ρ' ρp χ ρρb ρ'p Xi Y σX σY : ResUT BoCa.Loc BoCa.Val K)
    (l₀ : BoCa.Loc) (s : TSet) (v : BoCa.Val) (hs : ρ'i.InStratum s) (D : TSet),
    K.DownOf D (TSet.single β) → ResUT.Reb β ρ'i ρ →
    ResUT.CompS ρ ρb ρρb →
    ResUT.CompS ρ' ρp ρ'p →
    ResUT.UpdV ρρb ρ'p →
    ρb.InStratum (TSet.single β) →
    ρ'.InStratum (TSet.single β) →
    ResUT.Hash ρb (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) →
    ResUT.Hash ρ'p (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) →
    ResUT.SubKeep ρp (ρ.restrictDom ρ'i.exclPart) χ →
    ResUT.CompS (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) ρb Xi →
    (∃ w, ResUT.CompS ρ' χ w ∧
      ResUT.CompS w (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) Y) →
    ResUT.Flat Xi σX →
    ResUT.Flat Y σY →
    ∀ l : BoCa.Loc, (∃ ζ, (ρ.restrictDom ρ'i.exclPart).get l = some ζ) →
      ResUT.SimFormAt σX σY l

theorem ResUT.reb_immOnly {β : Life} {ρ'i ρ : ResUT BoCa.Loc BoCa.Val K}
    (hreb : ResUT.Reb β ρ'i ρ) :
    ∀ l ψ, ρ.get l = some ψ → ψ.kind = Kind.imm :=
  fun _ _ hg => ResUT.reb_imm_image hreb hg

theorem ResUT.reb_reb_immOnly {β : Life} {ρ'i ρ : ResUT BoCa.Loc BoCa.Val K}
    (hreb : ResUT.Reb β ρ'i ρ) :
    ∀ l ψ, (ρ.restrictDom ρ'i.exclPart).get l = some ψ → ψ.kind = Kind.imm :=
  fun _ _ hg => ResUT.reb_imm_image hreb (ResUT.restrictDom_get_inv hg)

theorem ResUT.single_imm_immOnly {ρ'i : ResUT BoCa.Loc BoCa.Val K} {l₀ : BoCa.Loc}
    {s : TSet} {v : BoCa.Val} {hs : ρ'i.InStratum s} :
    ∀ l ψ, (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)).get l = some ψ →
      ψ.kind = Kind.imm := by
  intro l ψ hg
  obtain ⟨-, rfl⟩ := ResUT.single_get_eq_some hg
  exact CellUT.kind_immOf _ _ _ _

/-- The half of `[TR]` 6.59 off `dom(ρ_reb)`, the case the print calls
*"immediate"*, with `χ` bound by `ResUT.SubKeep` (§12.58).
`[about ours]` -/
def ResUT.SixFiftyNineOffRebKeep : Prop :=
  ∀ (β : Life) (ρ'i ρ ρb ρ' ρp χ ρρb ρ'p Xi Y σX σY : ResUT BoCa.Loc BoCa.Val K)
    (l₀ : BoCa.Loc) (s : TSet) (v : BoCa.Val) (hs : ρ'i.InStratum s) (D : TSet),
    K.DownOf D (TSet.single β) → ResUT.Reb β ρ'i ρ →
    ResUT.CompS ρ ρb ρρb →
    ResUT.CompS ρ' ρp ρ'p →
    ResUT.UpdV ρρb ρ'p →
    ρb.InStratum (TSet.single β) →
    ρ'.InStratum (TSet.single β) →
    ResUT.Hash ρb (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) →
    ResUT.Hash ρ'p (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) →
    ResUT.SubKeep ρp (ρ.restrictDom ρ'i.exclPart) χ →
    ResUT.CompS (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) ρb Xi →
    (∃ w, ResUT.CompS ρ' χ w ∧
      ResUT.CompS w (ResUT.single l₀ (CellUT.immOf s v ρ'i hs)) Y) →
    ResUT.Flat Xi σX →
    ResUT.Flat Y σY →
    ∀ l : BoCa.Loc, (ρ.restrictDom ρ'i.exclPart).get l = none →
      ResUT.SimFormAt σX σY l

