import Frontend.Check.FactNodes
import Core.Tied
import Core.PinFundamental

/-!
# Frontend — Check — derivations over the typed term  `[spec §19, §29, §83]`

GENERATED by `scripts/gen-pin.py` from `Core/Judgment.lean` and
`scripts/pin/TDerives.tmpl.lean`. Edit the template, not this file.

`TDerivesX I Δ Γ t j` is `CDerivesX I` (SPEC §83) with each premise's term a child of `t` and its
conclusion's term the node `t`; `TDerivesAt Ξ := TDerivesX {ties := some Ξ}` and
`TDerivesP := TDerivesX {pin := true}` are its instances, each rule under each instance's name at
the instance's premises (`TDerivesAt.effOp`, `TDerivesP.lendR`). A premise that
types a term built from other arguments (`thunkV`'s `λN`, `letPoly`'s) carries the equation
between the child's erasure and that term. The node's fields are the rule's arguments, so a
derivation fixes every field: the types, rows, lifetimes and qualifiers a node carries are the
ones its rule was applied at, and its judgment is the derivation's (`TDerivesP.jdg_eq`). A rule
at a split has two premises `CDerives` does not: its node's use masks are the ones its parts'
contexts have (`SplitMasks`), so a slot both parts receive is one both masks hold; and each mask
covers its part (`Covers`, SPEC §55): every slot the part's term mentions is one its mask holds.

* `TDerivesX.erase`: projects to `CDerivesX I` at `t.erase`, case for case (`TDerivesAt.erase`,
  `TDerivesP.erase` its instances). So FP, adequacy, `PinLaw`'s theorems and decision R's apply to
  the typed term's erasure unchanged.
* `TDerivesX.mono`: a typed derivation at `I` is one at every `I' ≥ I` (`TDerivesAt.toP`).
* the derived nodes: each a fixed scheme at a consumed context, its premises the ones of the
  `Core/` lemma that types it, and its projection that lemma (`consume_wf`, `d_allocS`, `d_freeS`,
  `withborSM_wf`, `withborSI_wf`, `withborM2_wf`, `withborI2_wf`), at every index as
  `CDerivesX.ofEffFree` puts a term with no operation there; and the derived nodes over a marked scheme's typed term
  (`litFn`), whose premises are that term's derivation and the equation saying which instance of
  the scheme its erasure is.
* `use`: a `def`'s body at the use, its derivation the body's, and its absorption field the body's
  (`TExpr.absF`).

The node's `TInfo` is not constrained: it is where the node was checked from.
-/

namespace BoCa.Fig16.LogRel.Core.Check
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.Fig16.LogRel.Core
open BoCa.Lifetime (LifeCtx LifeVar)

/-- **`CDerivesX I` over the typed term**: each rule of `CDerivesX` with its premises at children,
and the derived nodes.  `[spec §3, §19, §29, §83]` -/
inductive TDerivesX (I : JIdx) : LifeCtx → Ctx VTy → TExpr → Jdg → Prop where
--@X_RULES@
  /-- **Derived**: the consume of `A` (`consume_wf`). -/
  | consume {Δ Γ A} {info : TInfo} (hA : Consumable A) (hc : closedAt 0 (consumeE A) = true)
      (he : (consumeE A).effFree = true) (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.consume info (.val (.lolli A .unit)) A) (.val (.lolli A .unit))
  /-- **Derived**: a scoped local of kind `k`, its side condition, type and term the kind's
  (`LocalOK`, `localTy`, `localE`, `Core/Local.lean`). `[spec §80]` -/
  | withlocal {Δ Γ A B} {info : TInfo} (k : LocalKind) (x : LifeVar) (hΓ : BoCa.Ctx.Dead Γ)
      (hk : LocalOK k Δ x A B) :
      TDerivesX I Δ Γ (.withlocal info (.val (localTy k Δ x A B)) k A B x) (.val (localTy k Δ x A B))
  /-- **Derived**: a block's allocation (`d_allocS`). -/
  | allocS {Δ Γ} {info : TInfo} (σ : Shape) (he : (allocS σ).effFree = true)
      (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.allocS info (.val (.lolli σ.valTy σ.refTy)) σ) (.val (.lolli σ.valTy σ.refTy))
  /-- **Derived**: a block's release (`d_freeS`). -/
  | freeS {Δ Γ} {info : TInfo} (σ : Shape) (he : (freeS σ).effFree = true)
      (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.freeS info (.val (.lolli σ.refTy σ.valTy)) σ) (.val (.lolli σ.refTy σ.valTy))
  /-- **Derived**: a block borrow, `mut` (`withborSM_wf`). -/
  | withborSM {Δ Γ} {info : TInfo} (σ : Shape) (c : LifeVar) (T : VTy) (hσ : σ.plain = true)
      (hT : plainV T = true) (hΔ : Δ.Ok) (hc : Δ.find? c = none)
      (hcl : closedAt 0 (withborS σ) = true) (he : (withborS σ).effFree = true)
      (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.withborSM info (.val (wTy mutM c Δ.meetOfDom σ T)) σ c T)
        (.val (wTy mutM c Δ.meetOfDom σ T))
  /-- **Derived**: a block borrow, `imm` (`withborSI_wf`). -/
  | withborSI {Δ Γ} {info : TInfo} (σ : Shape) (c : LifeVar) (T : VTy) (hσ : σ.plain = true)
      (hT : plainV T = true) (hΔ : Δ.Ok) (hc : Δ.find? c = none)
      (hcl : closedAt 0 (withborS σ) = true) (he : (withborS σ).effFree = true)
      (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.withborSI info (.val (wTy immM c Δ.meetOfDom σ T)) σ c T)
        (.val (wTy immM c Δ.meetOfDom σ T))
  /-- **Derived**: a family's two-lifetime borrow, `mut` (`withborM2_wf`). -/
  | withborF2M {Δ Γ} {info : TInfo} {c x y : LifeVar} {A B T : VTy}
      (s : FamSide mutM Δ c x y A B T) (hA : ∃ b, Δ.Defines b ∧ VOutlivesLe Δ b A)
      (hBo : VOutlives (FD₁ Δ x) (.var x) B) (hTo : VOutlives (FD₁ Δ x) (.var x) T)
      (he : withborF2.effFree = true) (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.withborF2M info (.val (withborF2Ty mutM c Δ.meetOfDom A B T)) c x y A B T)
        (.val (withborF2Ty mutM c Δ.meetOfDom A B T))
  /-- **Derived**: a family's two-lifetime borrow, `imm` (`withborI2_wf`). -/
  | withborF2I {Δ Γ} {info : TInfo} {c x y : LifeVar} {A B T : VTy}
      (s : FamSide immM Δ c x y A B T) (hA : VScoped Δ A) (hB : VScoped Δ B)
      (hBo : VOutlives (FD₁ Δ x) (.var x) B) (hTo : VOutlives (FD₁ Δ x) (.var x) T)
      (he : withborF2.effFree = true) (hΓ : BoCa.Ctx.Dead Γ) :
      TDerivesX I Δ Γ (TExpr.withborF2I info (.val (withborF2Ty immM c Δ.meetOfDom A B T)) c x y A B T)
        (.val (withborF2Ty immM c Δ.meetOfDom A B T))
  /-- **Derived**: a string literal's table, the bytes `bs`: its typed term's erasure is `litFnE bs`. -/
  | litFn {Δ Γ j} {info : TInfo} {bs : List Nat} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : t.erase = litFnE bs) (hcl : closedAt 0 (litFnE bs) = true) :
      TDerivesX I Δ Γ (TExpr.litFn info j bs t) j
  /-- **Derived**: a division by a literal at which it cannot fail: its typed term's erasure is the
  scheme (`divLitB`), at a safe literal (`safeDivB`). -/
  | divLit {Δ Γ j} {info : TInfo} {op : HostOp} {c : IntLit} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : divLitB op c t.erase = true) (hs : safeDivB op c = true) :
      TDerivesX I Δ Γ (TExpr.divLit info j op c t) j
  /-- **Derived**: a counted walk of a view: its typed term's erasure is a `count_fold` or a `count_try` (`walkB`). -/
  | walk {Δ Γ j} {info : TInfo} {m read : Bool} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : walkB t.erase = true) (hr : read = true → walkReadB m t.erase = true) :
      TDerivesX I Δ Γ (TExpr.walk info j m read t) j
  /-- **Derived**: a walk's read of its view at its index (`walkGetB`).  `[spec §46]` -/
  | walkGet {Δ Γ j} {info : TInfo} {m : Bool} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : walkGetB m t.erase = true) :
      TDerivesX I Δ Γ (TExpr.walkGet info j m t) j
  /-- **Derived**: a recursive group's self-reference: its typed term's erasure is a variable
  (`selfCallB`). -/
  | selfCall {Δ Γ j} {info : TInfo} {k n : Nat} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : selfCallB t.erase = true) :
      TDerivesX I Δ Γ (TExpr.selfCall info j k n t) j
  /-- **Derived**: the lend of a cell allocated for it (`lendCellB`). -/
  | lendCell {Δ Γ j} {info : TInfo} {m : Bool} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : lendCellB t.erase = true) (hm : lendKindB m t = true) :
      TDerivesX I Δ Γ (TExpr.lendCell info j m t) j
  /-- **Derived**: codata written as an η-thunk: its typed term's erasure is the scheme at `f`, `s`
  (`nuEtaB`).  `[spec §45]` -/
  | nuEta {Δ Γ j} {info : TInfo} {f : Nat} {s : Option Nat} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : nuEtaB f s t.erase = true) :
      TDerivesX I Δ Γ (TExpr.nuEta info j f s t) j
  /-- **Derived**: a lent cell's scope (`lendScopeT`), its release on every path (`lendRelT`).
  `[spec §57]` -/
  | lendScope {Δ Γ j} {info : TInfo} {rel : Bool} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hs : lendScopeT t = true) (hr : lendRelT t = rel) :
      TDerivesX I Δ Γ (TExpr.lendScope info j rel t) j
  /-- **Derived**: a literal's view (`litViewT`).  `[spec §57]` -/
  | litView {Δ Γ j} {info : TInfo} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : litViewT t = true) :
      TDerivesX I Δ Γ (TExpr.litView info j t) j
  /-- **Derived**: `unfold step` (`unfoldAppT`).  `[spec §57]` -/
  | unfoldStep {Δ Γ j} {info : TInfo} {t : TExpr} (h : TDerivesX I Δ Γ t j)
      (hb : unfoldAppT t = true) :
      TDerivesX I Δ Γ (TExpr.unfoldStep info j t) j
  /-- A `def`'s body at its use. -/
  | use {Δ Γ j} {info : TInfo} {name : String} {decl : Nat} {targs : List VTy} {ab : Option AbsF}
      {t : TExpr} (h : TDerivesX I Δ Γ t j) (hab : ab = t.absF Δ) :
      TDerivesX I Δ Γ (TExpr.use info j name decl targs ab t) j


/-- `CDerivesAt Ξ` over the typed term: `TDerivesX` at the tie `Ξ`.  `[spec §19, §83]` -/
abbrev TDerivesAt (Ξ : EffCtx) := TDerivesX {ties := some Ξ}

/-- `CDerivesP` over the typed term: `TDerivesX` with the pin rules.  `[spec §29, §83]` -/
abbrev TDerivesP := TDerivesX {pin := true}

/-! ### The rules under each instance's name, at the instance's premises -/

--@ALIASES@

/-- **A typed derivation is a derivation of the erasure**, at every index.  `[spec §19, §29, §83]` -/
theorem TDerivesX.erase {I : JIdx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesX I Δ Γ t j) : CDerivesX I Δ Γ t.erase j := by
  induction h with
--@X_ERASE@
  | consume hA _ he hΓ => exact CDerivesX.ofEffFree (consume_wf hA hΓ) he
  | withlocal k _ hΓ hk => exact CDerivesX.ofEffFree (LocalKind.wf k hΓ hk) (LocalKind.effFree k)
  | allocS σ he hΓ => exact CDerivesX.ofEffFree (d_allocS σ hΓ) he
  | freeS σ he hΓ => exact CDerivesX.ofEffFree (d_freeS σ hΓ) he
  | withborSM σ c _ hσ hT hΔ hc _ he hΓ => exact CDerivesX.ofEffFree (withborSM_wf hσ c hT hΔ hc hΓ) he
  | withborSI σ c _ hσ hT hΔ hc _ he hΓ => exact CDerivesX.ofEffFree (withborSI_wf hσ c hT hΔ hc hΓ) he
  | withborF2M s hA hBo hTo he hΓ => exact CDerivesX.ofEffFree (withborM2_wf s hA hBo hTo hΓ) he
  | withborF2I s hA hB hBo hTo he hΓ =>
      exact CDerivesX.ofEffFree (withborI2_wf s hA hB hBo hTo hΓ) he
  | litFn _ _ _ ih => exact ih
  | divLit _ _ _ ih | walk _ _ _ ih | walkGet _ _ ih | selfCall _ _ ih | lendCell _ _ _ ih | nuEta _ _ ih => exact ih
  | lendScope _ _ _ ih | litView _ _ ih | unfoldStep _ _ ih => exact ih
  | use _ _ ih => exact ih

/-- **A typed derivation is a derivation of the erasure**, tied.  `[spec §19]` -/
theorem TDerivesAt.erase {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesAt Ξ Δ Γ t j) : CDerivesAt Ξ Δ Γ t.erase j :=
  TDerivesX.erase h

/-- **A typed derivation is a derivation of the erasure**, in `CDerivesP`.  `[spec §29]` -/
theorem TDerivesP.erase {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesP Δ Γ t j) : CDerivesP Δ Γ t.erase j :=
  TDerivesX.erase h

/-- A typed derivation at `I` is one at every `I' ≥ I`, at the same node: a tie may be dropped, the
pin rules admitted.  `[spec §83]` -/
theorem TDerivesX.mono {I I' : JIdx} (hI : I ≤ I') {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr}
    {j : Jdg} (h : TDerivesX I Δ Γ t j) : TDerivesX I' Δ Γ t j := by
  induction h with
--@MONO_CASES@
  | consume hA hc he hΓ => exact .consume hA hc he hΓ
  | withlocal k x hΓ hk => exact .withlocal k x hΓ hk
  | allocS σ he hΓ => exact .allocS σ he hΓ
  | freeS σ he hΓ => exact .freeS σ he hΓ
  | withborSM σ c T hσ hT hΔ hc hcl he hΓ => exact .withborSM σ c T hσ hT hΔ hc hcl he hΓ
  | withborSI σ c T hσ hT hΔ hc hcl he hΓ => exact .withborSI σ c T hσ hT hΔ hc hcl he hΓ
  | withborF2M s hA hBo hTo he hΓ => exact .withborF2M s hA hBo hTo he hΓ
  | withborF2I s hA hB hBo hTo he hΓ => exact .withborF2I s hA hB hBo hTo he hΓ
  | litFn _ hb hcl ih => exact .litFn ih hb hcl
  | divLit _ hb hs ih => exact .divLit ih hb hs
  | walk _ hb hr ih => exact .walk ih hb hr
  | walkGet _ hb ih => exact .walkGet ih hb
  | selfCall _ hb ih => exact .selfCall ih hb
  | lendCell _ hb hm ih => exact .lendCell ih hb hm
  | lendScope _ hs hr ih => exact .lendScope ih hs hr
  | litView _ hb ih => exact .litView ih hb
  | unfoldStep _ hb ih => exact .unfoldStep ih hb
  | nuEta _ hb ih => exact .nuEta ih hb
  | use _ hab ih => exact .use ih hab

/-- A tied typed derivation is one of `TDerivesP`, at the same node. -/
theorem TDerivesAt.toP {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesAt Ξ Δ Γ t j) : TDerivesP Δ Γ t j :=
  TDerivesX.mono (I := {ties := some Ξ}) (I' := {pin := true}) (JIdx.le_pin _) h

/-- **A split node's masks are its parts'**: a typed derivation of a node at a split splits its
context into two parts whose contexts the node's masks are related to (`SplitMasks`).
`[spec §3, §83]` -/
theorem TDerivesX.split_masks {I : JIdx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    {m : Masks} (h : TDerivesX I Δ Γ t j) (hm : t.masks? = some m) :
    ∃ Γ₁ Γ₂, Ctx.SplitP Γ Γ₁ Γ₂ ∧ m.Rel Γ₁ Γ₂ := by
  cases h <;> simp only [TExpr.masks?, Option.some.injEq, reduceCtorEq] at hm <;>
    (subst hm; exact ⟨_, _, ‹_›, ‹_›⟩)

/-- `TDerivesX.split_masks`, tied.  `[spec §3]` -/
theorem TDerivesAt.split_masks {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    {m : Masks} (h : TDerivesAt Ξ Δ Γ t j) (hm : t.masks? = some m) :
    ∃ Γ₁ Γ₂, Ctx.SplitP Γ Γ₁ Γ₂ ∧ m.Rel Γ₁ Γ₂ :=
  TDerivesX.split_masks h hm

/-- `TDerivesX.split_masks`, in `TDerivesP`.  `[spec §3, §29]` -/
theorem TDerivesP.split_masks {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg} {m : Masks}
    (h : TDerivesP Δ Γ t j) (hm : t.masks? = some m) :
    ∃ Γ₁ Γ₂, Ctx.SplitP Γ Γ₁ Γ₂ ∧ m.Rel Γ₁ Γ₂ :=
  TDerivesX.split_masks h hm

/-- **The copy set of a split is its masks' both**: the slots a typed derivation of a split node
gives to both parts are exactly those both of its masks hold (`Masks.both`), and each is live in
the node's context at a persistent type.  `[spec §3, §10]` -/
theorem TDerivesP.copies {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg} {m : Masks}
    (h : TDerivesP Δ Γ t j) (hm : t.masks? = some m) :
    ∃ Γ₁ Γ₂, Ctx.SplitP Γ Γ₁ Γ₂ ∧
      (∀ k, (liveAt Γ₁ k = true ∧ liveAt Γ₂ k = true) ↔
        (m.u₁.getD k false = true ∧ m.u₂.getD k false = true)) ∧
      (∀ k, m.u₁.getD k false = true → m.u₂.getD k false = true →
        ∃ s, Γ[k]? = some s ∧ s.live = true ∧ s.ty.Persistent) := by
  obtain ⟨Γ₁, Γ₂, hs, hr⟩ := h.split_masks hm
  exact ⟨Γ₁, Γ₂, hs, hr.both_iff, SplitMasks.both_persistent hs hr⟩

/-- A typed derivation's judgment is its node's.  `[spec §83]` -/
theorem TDerivesX.jdg_eq {I : JIdx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesX I Δ Γ t j) : t.jdg = j := by
  cases h <;> rfl

/-- A typed derivation's judgment is its node's. -/
theorem TDerivesAt.jdg_eq {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesAt Ξ Δ Γ t j) : t.jdg = j :=
  TDerivesX.jdg_eq h

/-- A typed derivation's judgment is its node's. -/
theorem TDerivesP.jdg_eq {Δ : LifeCtx} {Γ : Ctx VTy} {t : TExpr} {j : Jdg}
    (h : TDerivesP Δ Γ t j) : t.jdg = j :=
  TDerivesX.jdg_eq h

/-- **An inserted consume carries `Consumable`**: a `consume` node of the typed term is typed only at a type
that is consumable. The checker inserts a consume only as a `consume` node, so it inserts none at a
linear type that is not consumable, a declared type among them (`decl_linear`).  `[spec §12, §42, §83]` -/
theorem TDerivesX.consume_consumable {I : JIdx} {Δ : LifeCtx} {Γ : Ctx VTy} {i : TInfo} {j : Jdg}
    {A : VTy} {j' : Jdg} (h : TDerivesX I Δ Γ (.consume i j A) j') : Consumable A := by
  cases h with
  | consume hA _ _ _ => exact hA

/-- `TDerivesX.consume_consumable`, in `TDerivesP`. -/
theorem TDerivesP.consume_consumable {Δ : LifeCtx} {Γ : Ctx VTy} {i : TInfo} {j : Jdg} {A : VTy}
    {j' : Jdg} (h : TDerivesP Δ Γ (.consume i j A) j') : Consumable A :=
  TDerivesX.consume_consumable h

/-- The same at the typed derivation at an effect context. -/
theorem TDerivesAt.consume_consumable {Ξ : EffCtx} {Δ : LifeCtx} {Γ : Ctx VTy} {i : TInfo} {j : Jdg}
    {A : VTy} {j' : Jdg} (h : TDerivesAt Ξ Δ Γ (.consume i j A) j') : Consumable A :=
  TDerivesX.consume_consumable h

end BoCa.Fig16.LogRel.Core.Check
