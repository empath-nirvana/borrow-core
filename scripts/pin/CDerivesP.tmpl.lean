namespace BoCa.Fig16.LogRel.Core
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.BoLo (Heap Steps Step1 Head Kont eLoad eStore)
open BoCa.Lifetime (LSub LifeCtx LifeVar)

/-- A value type with no `U` at a position read componentwise (`Law2`'s `NoThunkT`, on the
`law2-typed-world` branch): an answer read back at the kernel's relation after a re-lend. -/
def NoThunkT : VTy → Prop
  | .tensor A B => NoThunkT A ∧ NoThunkT B
  | .sum A B => NoThunkT A ∧ NoThunkT B
  | .thunk _ => False
  | .bang A => NoThunkT A
  | .ref A => NoThunkT A
  | .box _ A => NoThunkT A
  | .fam L => NoThunkT L
  | _ => True

/-- **The row a relaxed lend's callback may stop at.** Every operation resumes (none abortive),
none is unrestricted, its cancel row is empty, it answers `1`, its name is not `⊥`, and its
argument is closed data: free of `'x`, outliving every lifetime, with no `U` in it.  `[spec §29]` -/
def Row.ResumeO (S : Row) (x : LifeVar) : Prop :=
  ∀ o ∈ S, o.abort = false ∧ o.q ≠ .unr ∧ o.fin = .ret .unit ∧ o.B = .unit ∧ o.n ≠ 0 ∧
    ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A

/-- **The row a relaxed lend's callback may stop at, widened for the cancel path only.** Each
operation is one `Row.ResumeO` admits; or a cancellable wait (`OpSig.Cancellable`: marked, linear,
answering `1 ⊕ 1`) at operation `0` of a nonzero name, taking closed data, at any cancel row; or the
cancel target
(`OpSig.CancelTarget`) at operation `1` of a name whose operation `0` is a cancellable wait, which
`[await-c]` raises on `inr ()`. No other abortive operation is admitted, and the row does not hold
`Div`.  `[spec §29, §29a]` -/
def Row.ResumeOC (S : Row) (x : LifeVar) : Prop :=
  (∀ o ∈ S,
    (o.abort = false ∧ o.q ≠ .unr ∧ o.fin = .ret .unit ∧ o.B = .unit ∧ o.n ≠ 0 ∧
      ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A) ∨
    (o.Cancellable ∧ o.i = 0 ∧ o.n ≠ 0 ∧ ¬ VFree x o.A ∧ (∀ Δ a, VOutlives Δ a o.A) ∧ NoThunkT o.A) ∨
    (o.CancelTarget ∧ o.i = 1 ∧ o.q = .cancel ∧ o.n ≠ 0 ∧
      ∃ a, Row.find S o.n 0 = some a ∧ a.Cancellable)) ∧
  Row.divB S = false

/-- `Row.ResumeO` admits no `Div`: every entry answers `1`, and `tick` answers `1 ⊕ 1`. -/
theorem Row.ResumeO.divB {S : Row} {x : LifeVar} (h : Row.ResumeO S x) : Row.divB S = false :=
  Row.divB_of_noTick fun o ho => by
    simp [tickB, (h o ho).2.2.2.1, VTy.isNextB]

/-- `Row.ResumeOC` widens `Row.ResumeO`: every row R1 admitted it still admits. -/
theorem Row.ResumeO.toC {S : Row} {x : LifeVar} (h : Row.ResumeO S x) : Row.ResumeOC S x :=
  ⟨fun o ho => .inl (h o ho), h.divB⟩

/-- A lend's callback `Λ. λm. M`. -/
def lendCb (M : Expr) : Val := ⟨.lam (.lam M), .lam⟩

/-! ### R2's term: `loop_lend_imm` / `loop_lend_mut`

`lendLoopE C` is the erasure of the per-observation lend (`lib/lend.bc`, `LoopBorrow`), at the
loop body `C` that `unfold` coiterates. The `imm` and `mut` combinators erase to this one term:
`withbor` (1) and (2) differ only in typing. `experiments/AsyncCap/AsyncCap/LoopTerm.lean` checks
that it is `bcc`'s erasure of both at a monomorphic instance. -/

/-- `withbor`'s body, `λr. λf. (r, f () r)`, as the elaborator inlines it. -/
def wbInl : Expr :=
  .lam (.lam (.pair (.var 1) (.app (.app (.var 0) .unit) (.var 1))))

/-- The step `λp. λo. case o {inj₁ _. next | inj₂ _. close}` of `unfold`, under `(nx, cl)`. -/
def lendStepE : Expr :=
  .lam (.lam (.case (.var 0)
    (.seq (.var 0) (.letpair (.var 2)
      (.app
        (.lam (.letpair (.var 0) (.case (.var 0)
          (.inj₁ (.pair (.var 2) (.var 0)))
          (.inj₂ (.pair (.var 2) (.var 0))))))
        (.app (.app wbInl (.var 1))
          (.lam (.lam (.app (.app (.var 8) .unit) (.pair (.var 0) (.var 2)))))))))
    (.seq (.var 0) (.letpair (.var 2)
      (.app (.app wbInl (.var 1))
        (.lam (.lam (.app (.app (.var 7) .unit) (.pair (.var 0) (.var 2))))))))))

/-- `λ(nx, cl). unfold_C step`: the per-observation lend, at `unfold`'s body `C`. -/
def lendLoopE (C : CTy) : Expr :=
  .lam (.letpair (.var 0) (.app (unfoldV C).1 lendStepE))

/-- The loop body of R2's result, `F((Ref A ⊗ B) ⊕ X) & F (Ref A ⊗ R)`. -/
abbrev lendLoopBody (A B R : VTy) : CTy := CTy.loopBody (.tensor (.ref A) B) (.tensor (.ref A) R)

/-- R2's term at `r : Ref A`: `f ← lend_loop (Λ. λp. N, Λ. λp. K); q ← return (r, s₀); f q`. -/
def lendLoopApp (A B R : VTy) (N K s0 : Expr) : Expr :=
  bindE (.app (lendLoopE (lendLoopBody A B R)) (.pair (lendCb N).1 (lendCb K).1))
    (bindE (.pair (.var 1) s0) (.app (.var 1) (.var 0)))

/-- The extended judgment: `CDerives`, every premise in `CDerivesP`, and the relaxed rules. -/
inductive CDerivesP : LifeCtx → Ctx VTy → Expr → Jdg → Prop where
--@CORE_RULES@
  /-- **R1, the relaxed lend.** `r : Ref T ⊢ withborU d r (Λ. λm. M) : F_Σ (Ref T ⊗ B)`, the
  callback `M` at a row `Σ` of resuming operations and the cancel path's cancellable wait and cancel
  target (`Row.ResumeOC`), typed in `CDerivesP` with the
  view `m : Mut 'x T` alone in its context. `d : Ref T ⊸ 1` is the owner's finaliser, run when a
  continuation captured inside the callback is cancelled. The side conditions are
  `withbor2U`'s, with the callback's row resuming instead of unwinding. -/
  | lendR {Δ : LifeCtx} {x : LifeVar} {b : Lifetime.Life} {T B : VTy} {d M : Expr} {S : Row}
      (hb : Δ.Defines b) (hx : Δ.find? x = none) (hbx : b.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hT : ¬ VFree x T) (hB : ¬ VFree x B) (hBn : NoThunkT B)
      (hside : ∃ b', Δ.Defines b' ∧ VOutlivesLe Δ b' T)
      (hS : Row.ResumeOC S x) (hM1 : closedAt 1 M = true) (hcb : closedAt 0 (lendCb M).1 = true)
      (hdc : closedAt 0 d = true) (hd : CDerivesP Δ [] d (.val (.lolli (.ref T) .unit)))
      (hM : CDerivesP (Δ.extend x b) [⟨.mut (.var x) T, true⟩] M
        (.comp (CTy.effOf S (.box (.var x) B)))) :
      CDerivesP Δ [⟨.ref T, true⟩] (.app (.app (.val (withborUV d)) (.var 0)) (.val (lendCb M)))
        (.comp (CTy.effOf S (.tensor (.ref T) B)))
  /-- **R2, the shared lend over a loop whose state holds the borrow.** `r : Ref A ⊢` the
  per-observation lend of `r` (`lendLoopApp`) `: U(Loop (Ref A ⊗ B) (Ref A ⊗ R))`. At each
  observation `r` is lent `Imm 'x A` at a fresh `'x` below `⊓Δ`, and the step `N` (to continue,
  `B ⊕ S`) or `K` (to close, `R`) runs on the view and the state. The state's type `S` **may
  mention `'x`**: the state holds `imm` views of the place, and what is built from them, between
  observations. `LoopLend` (SPEC §14) requires `S` to outlive `'x`. The steps and the first state
  `s₀` are typed in `CDerivesP`; the steps see only the pair `(view, state)`.

  Only the `imm` lend: each observation hands the step a fresh view beside the state's, and two
  `imm` views of one place are sound together; two `mut` views are not. -/
  | lendLoopR {Δ : LifeCtx} {x : LifeVar} {A S B R : VTy} {N K s0 : Expr}
      (hx : Δ.find? x = none) (hbx : Δ.meetOfDom.mentions x = false)
      (hΔx : ∀ y u, Δ.find? y = some u → u.mentions x = false)
      (hA : ¬ VFree x A) (hB : ¬ VFree x B) (hR : ¬ VFree x R) (hBn : NoThunkT B)
      (hRn : NoThunkT R) (hsc : VScoped Δ A)
      (hN1 : closedAt 1 N = true) (hK1 : closedAt 1 K = true) (hs0c : closedAt 0 s0 = true)
      (hN : CDerivesP (Δ.extend x Δ.meetOfDom) [⟨.tensor (.imm (.var x) A) S, true⟩] N
        (.comp (.ret (.sum B S))))
      (hK : CDerivesP (Δ.extend x Δ.meetOfDom) [⟨.tensor (.imm (.var x) A) S, true⟩] K
        (.comp (.ret R)))
      (hs0 : CDerivesP (Δ.extend x Δ.meetOfDom) [] s0 (.val S)) :
      CDerivesP Δ [⟨.ref A, true⟩] (lendLoopApp A B R N K s0)
        (.comp (CTy.loop (.tensor (.ref A) B) (.tensor (.ref A) R)))
  /-- **A derivation at the empty context is one at every consumed context.** R1 and R2 conclude
  at `r : Ref T` alone; under binders they are `(λr. lend) x`, the λ typed at `[]` and placed
  here.  `[spec §29]` -/
  | nilDead {Δ : LifeCtx} {Γ : Ctx VTy} {e : Expr} {j : Jdg} (hΓ : Ctx.Dead Γ)
      (h : CDerivesP Δ [] e j) : CDerivesP Δ Γ e j

--@CORE_DERIVED@

end BoCa.Fig16.LogRel.Core

