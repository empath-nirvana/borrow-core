/-- **R1's compatibility lemma, from `LendFrame` at `ref`.** The callback's relation is the
Fundamental Property at its derivation. -/
theorem PinLaw.stop (hPin : PinLaw (ℍ := ℍ)) : PinStop (ℍ := ℍ) :=
  fun _ _ _ _ _ _ _ _ hb hx hbx hΔx hT hB hBn hside hS hM1 hcb hdc hd hM =>
    hPin.lendFrame _ _ _ _ _ _ _ _ _ _ (.ref hT hside) hb hx hbx hΔx hB hBn hS hM1 hcb hdc hd hM
      (fundamentalC_pin hPin hM)

/-- **R2's compatibility lemma, from `LoopFrame`.** The steps' and first state's relations are
the Fundamental Property at their derivations. -/
theorem PinLaw.loop (hPin : PinLaw (ℍ := ℍ)) : PinLoop (ℍ := ℍ) :=
  fun _ _ _ _ _ _ _ _ _ hx hbx hΔx hA hB hR hBn hRn hsc hN1 hK1 hs0c hN hK hs0 =>
    hPin.loopFrame _ _ _ _ _ _ _ _ _ hx hbx hΔx hA hB hR hBn hRn hsc hN1 hK1 hs0c hN hK hs0
      (fundamentalC_pin hPin hN) (fundamentalC_pin hPin hK) (fundamentalC_pin hPin hs0)

/-- **The schemas from the two compatibility lemmas**: at `ref`, `LendFrame` is `PinStop` with the
callback's relation unused, and `LoopFrame` is `PinLoop` with the steps' unused. -/
theorem PinLaw.of_stop_loop (hS : PinStop (ℍ := ℍ)) (hL : PinLoop (ℍ := ℍ)) :
    PinLaw (ℍ := ℍ) where
  lendFrame := by
    intro Δ x b P V B Δb d M S hf hb hx hbx hΔx hB hBn hS' hM1 hcb hdc hd hM _
    cases hf with
    | ref hT hside =>
      exact hS Δ x b _ B d M S hb hx hbx hΔx hT hB hBn hside hS' hM1 hcb hdc hd hM
  loopFrame :=
    fun Δ x A S B R N K s0 hx hbx hΔx hA hB hR hBn hRn hsc hN1 hK1 hs0c hN hK hs0 _ _ _ =>
    hL Δ x A S B R N K s0 hx hbx hΔx hA hB hR hBn hRn hsc hN1 hK1 hs0c hN hK hs0

/-- **`PinLaw`, as two schemas, says what `PinStop` and `PinLoop` together say.** -/
theorem pinLaw_iff : PinLaw (ℍ := ℍ) ↔ PinStop (ℍ := ℍ) ∧ PinLoop (ℍ := ℍ) :=
  ⟨fun h => ⟨h.stop, h.loop⟩, fun h => PinLaw.of_stop_loop h.1 h.2⟩

/-- **Adequacy under `PinLaw`**: a closed `CDerivesP` computation of `F 1` runs from the empty
memory to `()` and the empty memory. -/
theorem adequacyC_pin (hPin : PinLaw (ℍ := ℍ)) {e : Expr}
    (h : CDerivesP LifeCtx.empty [] e (.comp (.ret .unit))) :
    BoCa.BoLo.Steps Adequacy.emptyMem e Adequacy.emptyMem (.val .unit) :=
  corollary33 e (fundamentalC_pin hPin h)

/-- **Adequacy on every run, under `PinLaw`**: every run of a closed `CDerivesP` computation of
`F 1` from the empty memory continues to `()` at the empty memory. -/
theorem adequacyD_pin (hPin : PinLaw (ℍ := ℍ)) {e : Expr}
    (h : CDerivesP LifeCtx.empty [] e (.comp (.ret .unit)))
    {μ₁ : Heap} {e₁ : Expr} (hs : Steps Adequacy.emptyMem e μ₁ e₁) :
    Steps μ₁ e₁ Adequacy.emptyMem (.val .unit) := by
  have hwp := fundamentalC_pin hPin h LSub.empty [] [] PMap.empty Adequacy.models_empty
    (gDenC_nil _ _)
  have hwp' : wpTS [] e (fun _ v => Fig16.BoLo.pure (v = Val.unit)) (PMap.empty : WRes) := by
    have he : substAll [] e = e := Adequacy.psub_nil 0 e
    rw [he] at hwp
    exact hwp
  obtain ⟨v, hsteps, rfl⟩ := theorem32D e (· = Val.unit) hwp' hs
  exact hsteps

/-- **No stuck state, under `PinLaw`.** -/
theorem adequacyD_pin_safe (hPin : PinLaw (ℍ := ℍ)) {e : Expr}
    (h : CDerivesP LifeCtx.empty [] e (.comp (.ret .unit)))
    {μ₁ : Heap} {e₁ : Expr} (hs : Steps Adequacy.emptyMem e μ₁ e₁) :
    IsVal e₁ ∨ ∃ μ₂ e₂, Step1 μ₁ e₁ μ₂ e₂ := by
  cases adequacyD_pin hPin h hs with
  | refl => exact .inl Val.unit.2
  | more h _ => exact .inr ⟨_, _, h⟩

