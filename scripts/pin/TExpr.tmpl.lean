import Frontend.Syntax
import Core.PinDerives
import Core.ClauseKinds
import Core.HandledNames
import Core.BlockBorrow
import Core.Dtor
import Frontend.Check.Masks
import Core.LetCopy
import Support.Dynamics.Interpreter

/-!
# Frontend — Check — the typed term  `[spec §3, §29]`

GENERATED by `scripts/gen-pin.py` from `Core/PinDerives.lean` and
`scripts/pin/TExpr.tmpl.lean`. Edit the template, not this file.

The checker returns a typed term `t : TExpr` with its derivation (`docs/compiler.md` §2.3). A node
is one rule application: one constructor per `CDerivesP` rule, of the same name, holding

* its `TInfo`: the span of the source it was checked from; at a variable, the variable's name and
  whether it is written `clone(x)` (SPEC §10); at a binding, the names it binds;
* its judgment `jdg`, a value type or a computation type;
* the rule's arguments other than its contexts, its proofs and the terms its premises type:
  binder types, rows, operation signatures, lifetimes, the handler's qualifiers and cancel rows,
  constants' type arguments;
* at a split, the use masks of its two parts (`u : Masks`, `Frontend/Check/Masks.lean`), which
  the typed rule relates to the parts' contexts;
* at `[handle]`, each operation's qualifier and the kind of its clause, as the checker classifies
  it (`ks`, `Frontend/Check/Kinds.lean`), and what the elaboration of effects records of the site
  (`site`, `HSite`), facts the derivation does not constrain; and the frames the handled
  computation holds (`inside`, `Core/HandledNames.lean`), which the typed rule pins to its
  erasure's;
* one child per premise, in the rule's order.

`TExpr.erase` gives the term the rule concludes with, from its children's erasures. The checked
term of a program is `t.erase` (`Checked.e`), so the compiled term is the checked one by
definition. `TDerivesAt`/`TDerivesP` (`Frontend/Check/TDerives.lean`) are the derivations over
`TExpr`, and project to `CDerivesAt`/`CDerivesP` at `t.erase`.

The nodes that are not rules:

* **derived nodes**, one per fixed scheme that `Core/` types by a lemma at a consumed context: a
  destructor (`dtor`, `dtor_wf`), a block's allocation and release (`allocS`, `freeS`,
  `d_allocS`, `d_freeS`), a block borrow (`withborSM`, `withborSI`, `withborSM_wf`,
  `withborSI_wf`) and a family's two-lifetime borrow (`withborF2M`, `withborF2I`,
  `withborM2_wf`, `withborI2_wf`). Each erases to the scheme's term, and its typed rule's premises
  are its lemma's (`Frontend/Check/TDerives.lean`); and one per fixed scheme the elaborator writes
  and marks (`Frontend.Val.mark`): a string literal's table (`litFn`). Such a node is over the
  marked value's typed term, and its rule says what scheme that term's erasure is (`litFnE`);
* `use`: a use of a `def` (SPEC §10): the definition's name, its type arguments, and its body `t`,
  checked once per key and placed at the use (`Frontend/Check/TShift.lean`); it erases to `t`'s
  erasure. Its field `ab` is the body's absorption (`TExpr.absF`): which unused live slots the
  body's derivation can be given at the use.
-/

namespace BoCa.Fig16.LogRel.Core.Check
open BoCa
open BoCa.Fig16
open BoCa.Fig16.BoLo
open BoCa.Fig16.LogRel.Core
open BoCa.Lifetime (LifeCtx LifeVar)

/-- What a node records of its source: the span it was checked from; at a variable (and at the
argument of `M x`), the variable's name, and whether the program writes the use `clone(x)`; at a
binding (`x <- M`, `let (x, y) = V`, a `case`'s arms), the names it binds, in the source's order;
at a `use`, the elaborator's key of the `def` it uses. -/
structure TInfo where
  sp : Frontend.Span
  name : String := ""
  clone : Bool := false
  binders : List String := []
  /-- At a `use` of a `def` the elaboration generates, its key (`Frontend.DefKey`). -/
  key : Option Frontend.DefKey := none
  deriving Inhabited

/-- What an unused live slot of a type must satisfy for a derivation to be given it: one atom of a
premise on the context's live slots.  `[spec §10]` -/
inductive Atom where
  /-- The type is persistent (`Ctx.DeadP`, `Ctx.SoloP`, `Ctx.SplitP`'s `dup`). -/
  | pers
  /-- A `!` type (`Persistent`). -/
  | bang
  /-- `VTy.Drop`, as `dropB` decides it (`Ctx.Drops`). -/
  | drop
  /-- The lifetime variable is not free in it (`∀I`'s premise). -/
  | nfree (x : LifeVar)
  /-- It outlives `@a` under `Δ`, as `outlivesB` decides it (`CtxOutlives`). -/
  | outl (Δ : LifeCtx) (a : Lifetime.Life)
  deriving DecidableEq, Inhabited

/-- A disjunction of conjunctions of atoms: `[]` is false, `[[]]` true. -/
abbrev AbsF := List (List Atom)

/-! ### The schemes the elaborator writes -/

/-- A byte of a literal: `u8[b]`. -/
def litByteE (b : Nat) : Expr := .val ⟨.prim (.lit (.u8 (UInt8.ofNat b))), .prim⟩

/-- `lt_u32 (i, k)`, the index `i` the variable at depth `d`. -/
def litLtE (d k : Nat) : Expr :=
  .app (.val (.prim (.host (.rel .w32 .lt_u)))) (.pair (.var d) (.val ⟨.prim (.lit (.i32 (UInt32.ofNat k))), .prim⟩))

/-- The bytes at the indices `[lo, hi)`, under `d` binders: a search on the index, halving the
range down to one byte. -/
def litTreeE (bs : Array Nat) : Nat → Nat → Nat → Nat → Expr
  | 0, _, lo, _ => litByteE (bs.getD lo 0)
  | f + 1, d, lo, hi =>
    if hi ≤ lo + 1 then litByteE (bs.getD lo 0)
    else
      let mid := (lo + hi) / 2
      .case (litLtE d mid) (litTreeE bs f (d + 1) mid hi) (litTreeE bs f (d + 1) lo mid)

/-- **A string literal's table** (SPEC §17): the erasure of the `!` function from an index to the
bytes `bs`, `0` past the end, that the elaborator writes for the literal
(`Frontend.Sugar.litValue`). -/
def litFnE (bs : List Nat) : Expr :=
  let n := bs.length
  .val (.lam (if n == 0 then litByteE 0
    else .case (litLtE 0 n) (litByteE 0) (litTreeE bs.toArray n 1 0 n)))

/-- What the elaboration of effects records of a handler site (`Frontend.SiteRec`), at its `handle`
node: the effect it serves and its type arguments there, the handler (a control handler's name,
or the function a `for` or a stored generator runs), the name the `with` gives it (SPEC §38), the
kind of site the elaboration claims, and the handler's state: the parameters its clauses are
passed as a state (SPEC §19, *Handler state*), each with its type, none when it has no state;
and each operation's count as the effect declares it, `ctl` (inferred) or `linear ctl` (SPEC §53).
The types are core types, elaborated by the checker at the node from the record the node carries
(`Frontend/Check/Checker.lean`, `siteOf`), which also checks that the record's operations are the
node's `E`.  `[spec §19, §53]` -/
structure HSite where
  eff : String
  args : List VTy
  handler : String
  slot : Option String
  kind : Frontend.SiteKind
  state : List (String × VTy)
  decl : List Frontend.Qual := []
  deriving Inhabited

/-! ### The schemes of the marked derived nodes

Each recognises the erasure of the value the elaborator marks (`Frontend.Val.mark`), and is kept by
moving the term's variables (`TExpr.shift`), so a `def`'s body keeps its marked nodes at a use. -/

/-- The body of a division by the literal `c` by the host operation `op` whose error arm is never
taken, under the dividend's binder (`Frontend.Sugar.divUnchecked`): the divisor bound, the
operation at both (a byte's widened by `extend8_u`), the quotient or remainder (a byte's
narrowed by `wrap8`), and `0` in the arm that is not taken.  `[spec §39]` -/
def divLitBody (op : HostOp) (c : IntLit) : Expr :=
  let u8 := match c with | .u8 _ => true | _ => false
  let wide (i : Nat) : Expr := if u8 then .app (.prim (.host .extend8_u)) (.var i) else .var i
  let q : Expr := if u8 then .app (.prim (.host .wrap8)) (.var 0) else .var 0
  let z : IntLit := match c with | .u8 _ => .u8 0 | .i64 _ => .i64 0 | _ => .i32 0
  .app (.lam (.case (.app (.prim (.host op)) (.pair (wide 1) (wide 0))) q (.prim (.lit z))))
    (.prim (.lit c))

/-- The term is a division by the literal `c` by `op`: `(λa. divLitBody op c) e`. -/
def divLitB (op : HostOp) (c : IntLit) : Expr → Bool
  | .app (.lam B) _ => B == divLitBody op c
  | _ => false

/-- The literal is one at which `op` cannot fail: nonzero, and not `-1` for a signed `/` (a byte's
division is the unsigned one at `i32`, on the widened operands).  `[spec §39]` -/
def safeDivB : HostOp → IntLit → Bool
  | .div .w32 o, .i32 n => n != 0 && (o != .div_s || n != 0xFFFFFFFF)
  | .div .w64 o, .i64 n => n != 0 && (o != .div_s || n != 0xFFFFFFFFFFFFFFFF)
  | .div .w32 .div_u, .u8 n | .div .w32 .rem_u, .u8 n => n != 0
  | _, _ => false

/-- The term is a `count_fold` or a `count_try` at a step, a bound, a first index and a state; at
a shared view, after the view's copy (`let (v, c) = array_copy v₀; count_try (f, (len c, …))`,
SPEC §46). -/
def walkB : Expr → Bool
  | .app (.prim .count) (.pair _ (.pair _ (.pair _ _))) => true
  | .app (.prim .countTry) (.pair _ (.pair _ (.pair _ _))) => true
  | .letpair _ (.app (.prim .count) (.pair _ (.pair _ (.pair _ _)))) => true
  | .letpair _ (.app (.prim .countTry) (.pair _ (.pair _ (.pair _ _)))) => true
  | _ => false

/-- The term is the variable `k`. -/
def walkVarB (k : Nat) : Expr → Bool
  | .var j => j == k
  | _ => false

/-- The term is the variable `k`, or a pair whose first component is. -/
def headVarB (k : Nat) : Expr → Bool
  | .var j => j == k
  | .pair a _ => walkVarB k a
  | _ => false

/-- Every tail of a walk's step hands on the variable `k` as its state's first component: `k` or
`(k, _)` at `count_fold` (`fold`), `inj₁` of one at `count_try`, or at `count_try` any `inj₂`
(an exit); through `case`s, `let`s, `x <- M; N`'s `N` and `;`.  `[spec §46]` -/
def walkTailsB (fold : Bool) : Nat → Expr → Bool
  | k, .var j => fold && j == k
  | k, .pair a _ => fold && walkVarB k a
  | k, .inj₁ a => !fold && headVarB k a
  | _, .inj₂ _ => !fold
  | k, .case _ a b => walkTailsB fold (k + 1) a && walkTailsB fold (k + 1) b
  | k, .letpair _ b => walkTailsB fold (k + 2) b
  | k, .app (.lam b) _ => walkTailsB fold (k + 1) b
  | k, .seq _ b => walkTailsB fold k b
  | _, _ => false

/-- A variable's place in a walk step's argument `(i, (v, …))`: `(true, p)` the rest from
position `p`, `(false, p)` the element at `p`. -/
abbrev WalkRole := Option (Bool × Nat)

/-- The variable `v` is the step's view: the element `1`, or the rest from `1`. -/
def walkViewB (roles : List WalkRole) (v : Nat) : Bool :=
  roles[v]? == some (some (false, 1)) || roles[v]? == some (some (true, 1))

/-- **The read of a walk's step**  `[spec §46]`: after the step's argument is taken apart
(`let (i, t) = q; let (v, t') = t; …`, `roles` each variable's place), at a shared view (`m`
false) `let (v, g) = array_copy v; case array_get (g, i) {…}`, `v` the view and `i` the counter,
each arm's every tail handing on the copy's `v` (`walkTailsB`); at a unique view
`case slice_split_mut (v, 1) {inl p. let (h, v) = p; case slice_get_mut (h, 0) {…} | …}`. -/
def walkStepB (m fold : Bool) : List WalkRole → Expr → Bool
  | roles, .letpair (.var j) b =>
    match roles[j]? with
    | some (some (true, p)) => walkStepB m fold (some (true, p + 1) :: some (false, p) :: roles) b
    | _ => false
  | roles, .letpair (.app c (.var v)) (.case (.app (.prim .idx) (.pair (.var 0) (.var k))) x y) =>
    !m && c == .val copyV && walkViewB roles v && 2 ≤ k && roles[k - 2]? == some (some (false, 0)) &&
      walkTailsB fold 2 x && walkTailsB fold 2 y
  | roles, .case (.app (.prim .split) (.pair (.var v) (.prim (.lit (.i32 a)))))
      (.letpair (.var 0) (.case (.app (.prim .idx) (.pair (.var 1) (.prim (.lit (.i32 b))))) _ _)) _ =>
    m && walkViewB roles v && a == 1 && b == 0
  | _, _ => false

/-- The loop is a counted one: `count_fold` (`some true`) or `count_try` (`some false`). -/
def walkCntB : Prim → Option Bool
  | .count => some true
  | .countTry => some false
  | _ => none

/-- **A walk whose read is in range**  `[spec §46]`: at a shared view, the loop is
`let (v, c) = array_copy v₀; count (λq. S, (len c, (i, s)))`, its bound the view's length and its
state's first component the view; at either view the step reads the view at its index
(`walkStepB`). -/
def walkReadRaw (m : Bool) : Expr → Bool
  | .letpair (.app c (.var _)) (.app (.prim p) (.pair (.lam st) (.pair (.app l (.var 0)) (.pair _ s)))) =>
    match walkCntB p with
    | some fold => !m && c == .val copyV && l == .val arrLenV &&
        (s matches .var 1 || s matches .pair (.var 1) _) && walkStepB false fold [some (true, 0)] st
    | none => false
  | .app (.prim p) (.pair (.lam st) (.pair _ (.pair _ _))) =>
    match walkCntB p with
    | some fold => m && walkStepB true fold [some (true, 0)] st
    | none => false
  | _ => false

/-- The term with every variable at or above `k` (free, under the term's `k` binders) made `k`:
what a scheme that reads only its own binders sees of a term. -/
def normAt : Nat → Expr → Expr
  | k, .var j => .var (if j < k then j else k)
  | _, .unit => .unit
  | k, .pair a b => .pair (normAt k a) (normAt k b)
  | k, .inj₁ a => .inj₁ (normAt k a)
  | k, .inj₂ a => .inj₂ (normAt k a)
  | k, .lam b => .lam (normAt (k + 1) b)
  | _, .loc ℓ => .loc ℓ
  | _, .prim p => .prim p
  | k, .seq a b => .seq (normAt k a) (normAt k b)
  | k, .letpair a b => .letpair (normAt k a) (normAt (k + 2) b)
  | k, .case a b c => .case (normAt k a) (normAt (k + 1) b) (normAt (k + 1) c)
  | k, .app f a => .app (normAt k f) (normAt k a)

/-- **A walk whose read is in range**, of the term as its binders see it (`normAt`), so that the
fact is kept by moving the term's variables (`walkReadB_shift`).  `[spec §46]` -/
def walkReadB (m : Bool) (e : Expr) : Bool := walkReadRaw m (normAt 0 e)

/-- The term is a read of a walk's view at its index: `array_get (g, i)`, or `slice_get_mut (h, 0)`
when `m`.  `[spec §46]` -/
def walkGetB (m : Bool) : Expr → Bool
  | .app (.prim .idx) (.pair (.var _) (.var _)) => !m
  | .app (.prim .idx) (.pair (.var _) (.prim (.lit (.i32 b)))) => m && b == 0
  | _ => false

/-- The term is a variable. -/
def selfCallB : Expr → Bool
  | .var _ => true
  | _ => false

/-- The term is a borrow of a cell it allocates: `withbor (alloc v) cb`. -/
def lendCellB : Expr → Bool
  | .app (.app _ (.app (.prim .alloc) _)) _ => true
  | _ => false

theorem divLitBody_closed (op : HostOp) (c : IntLit) : closedAt 1 (divLitBody op c) = true := by
  cases c <;> simp [divLitBody, closedAt]

theorem divLitB_shift {op : HostOp} {c : IntLit} {e : Expr} (h : divLitB op c e = true)
    (d k : Nat) : divLitB op c (e.shift d k) = true := by
  match e, h with
  | .app (.lam B) a, h =>
      simp only [divLitB, beq_iff_eq] at h
      subst h
      simp only [Expr.shift, divLitB, beq_iff_eq]
      exact shift_closedAt (k := 1) _ _ (divLitBody_closed op c) (Nat.le_add_left 1 _)

theorem walkB_shift {e : Expr} (h : walkB e = true) (d k : Nat) : walkB (e.shift d k) = true := by
  match e, h with
  | .app (.prim .count) (.pair _ (.pair _ (.pair _ _))), _ => rfl
  | .app (.prim .countTry) (.pair _ (.pair _ (.pair _ _))), _ => rfl
  | .letpair _ (.app (.prim .count) (.pair _ (.pair _ (.pair _ _)))), _ => rfl
  | .letpair _ (.app (.prim .countTry) (.pair _ (.pair _ (.pair _ _)))), _ => rfl

theorem walkGetB_shift {m : Bool} {e : Expr} (h : walkGetB m e = true) (d k : Nat) :
    walkGetB m (e.shift d k) = true := by
  match e, h with
  | .app (.prim .idx) (.pair (.var i) (.var j)), h =>
    simp only [Expr.shift]; split <;> split <;> exact h
  | .app (.prim .idx) (.pair (.var i) (.prim (.lit (.i32 b)))), h =>
    simp only [Expr.shift]; split <;> exact h

/-- A shift above `k` leaves what `normAt k` sees unchanged. -/
theorem normAt_shift (d : Nat) : ∀ (e : Expr) (k c : Nat), k ≤ c → normAt k (e.shift d c) = normAt k e
  | .var j, k, c, h => by
    simp only [Expr.shift]; split <;> simp only [normAt] <;> congr 1 <;> split <;> split <;> omega
  | .unit, _, _, _ | .loc _, _, _, _ | .prim _, _, _, _ => rfl
  | .pair a b, k, c, h => by simp only [Expr.shift, normAt, normAt_shift d a k c h, normAt_shift d b k c h]
  | .inj₁ a, k, c, h => by simp only [Expr.shift, normAt, normAt_shift d a k c h]
  | .inj₂ a, k, c, h => by simp only [Expr.shift, normAt, normAt_shift d a k c h]
  | .lam b, k, c, h => by simp only [Expr.shift, normAt, normAt_shift d b (k + 1) (c + 1) (by omega)]
  | .seq a b, k, c, h => by simp only [Expr.shift, normAt, normAt_shift d a k c h, normAt_shift d b k c h]
  | .letpair a b, k, c, h => by
    simp only [Expr.shift, normAt, normAt_shift d a k c h, normAt_shift d b (k + 2) (c + 2) (by omega)]
  | .case a b e, k, c, h => by
    simp only [Expr.shift, normAt, normAt_shift d a k c h, normAt_shift d b (k + 1) (c + 1) (by omega),
      normAt_shift d e (k + 1) (c + 1) (by omega)]
  | .app f a, k, c, h => by simp only [Expr.shift, normAt, normAt_shift d f k c h, normAt_shift d a k c h]

theorem walkReadB_shift {m : Bool} {e : Expr} (h : walkReadB m e = true) (d k : Nat) :
    walkReadB m (e.shift d k) = true := by
  simp only [walkReadB, normAt_shift d e 0 k (Nat.zero_le _)] at h ⊢; exact h

theorem selfCallB_shift {e : Expr} (h : selfCallB e = true) (d k : Nat) :
    selfCallB (e.shift d k) = true := by
  match e, h with
  | .var i, _ => simp only [Expr.shift]; split <;> rfl

theorem lendCellB_shift {e : Expr} (h : lendCellB e = true) (d k : Nat) :
    lendCellB (e.shift d k) = true := by
  match e, h with
  | .app (.app _ (.app (.prim .alloc) _)) _, _ => rfl

/-- An observation of codata through its variables, at the projection `o`: `f s o` (the state
`s`), or `f o` with no state.  `[spec §45]` -/
def nuObsE (f : Nat) (s : Option Nat) (o : Val) : Expr :=
  match s with
  | some s => .app (.app (.var f) (.var s)) (.val o)
  | none => .app (.var f) (.val o)

/-- An observation through `g`, bound to `f` first (`g <- return (unbang f); …`): `(λg. g s o) f`,
or with no state `(λg. g o) f`.  `[spec §45]` -/
def nuObsRE (f : Nat) (s : Option Nat) (o : Val) : Expr :=
  .app (.val (.lam (nuObsE 0 (s.map (· + 1)) o))) (.var f)

/-- **The η-thunk of codata**  `[spec §45]`: the erasure of
`thunkv nu_in < (nu_out (force f s)).1, (nu_out (force f s)).2 >` (and with no `s`,
`< (nu_out (force f)).1, (nu_out (force f)).2 >`): the `&` of the two observations, under its two
binders; with `rb`, each arm binds `f` to a name of its own first
(`g <- return (unbang f); (nu_out (force g s)).k`). -/
def nuEtaE (f : Nat) (s : Option Nat) (rb : Bool) : Expr :=
  let obs := if rb then nuObsRE else nuObsE
  withPair (obs (f + 2) (s.map (· + 2)) (.inj₁ .unit)) (obs (f + 2) (s.map (· + 2)) (.inj₂ .unit))

/-- The term is the η-thunk of codata at the variables `f` and `s`, in either form. -/
def nuEtaB (f : Nat) (s : Option Nat) (e : Expr) : Bool :=
  e == nuEtaE f s false || e == nuEtaE f s true

theorem nuEtaE_shift (f : Nat) (s : Option Nat) (rb : Bool) (d k : Nat) :
    (nuEtaE f s rb).shift d k = nuEtaE (sIdx d k f) (s.map (sIdx d k)) rb := by
  have hv (i : Nat) : (if i < k then Expr.var (i + 2) else Expr.var (i + 2 + d)) =
      Expr.var (sIdx d k i + 2) := by
    unfold sIdx; split <;> simp <;> omega
  cases rb <;> cases s <;> simp [nuEtaE, nuObsE, nuObsRE, withPair, Expr.shift, hv] <;>
    (try rfl) <;> (unfold sIdx; split <;> simp <;> omega)

theorem nuEtaB_shift {f : Nat} {s : Option Nat} {e : Expr} (h : nuEtaB f s e = true) (d k : Nat) :
    nuEtaB (sIdx d k f) (s.map (sIdx d k)) (e.shift d k) = true := by
  simp only [nuEtaB, Bool.or_eq_true, beq_iff_eq] at h ⊢
  rcases h with h | h <;> rw [h, nuEtaE_shift] <;> simp

/-! ### Terms a node's erasure reads off a child's

A rule argument that is a term determined by an equation on a child's erasure (`effHandleT`'s
clause pair, `reify`'s residual, `[let-poly]`'s value and body) is not a field: the erasure reads
it off the child's (`scripts/gen-pin.py`, `DERIVED`), so no node holds an untyped term. -/

/-- The left of a pair, a term otherwise itself. -/
def Expr.pairL : Expr → Expr
  | .pair a _ => a
  | e => e

/-- The right of a pair, a term otherwise itself. -/
def Expr.pairR : Expr → Expr
  | .pair _ b => b
  | e => e

theorem isValB_of_isVal : ∀ {e : Expr}, IsVal e → isValB e = true
  | _, .unit => rfl
  | _, .pair h₁ h₂ => by simp [isValB, isValB_of_isVal h₁, isValB_of_isVal h₂]
  | _, .inj₁ h => by simp [isValB, isValB_of_isVal h]
  | _, .inj₂ h => by simp [isValB, isValB_of_isVal h]
  | _, .lam => rfl
  | _, .loc => rfl
  | _, .prim => rfl
  | _, .storeV h => by simp [isValB, isValB_of_isVal h]

/-- A term as a value; `()` at a term that is not one. -/
def Expr.toVal (e : Expr) : Val :=
  if h : isValB e = true then ⟨e, isVal_of_isValB e h⟩ else Val.unit

theorem Expr.toVal_val (v : Val) : Expr.toVal v.1 = v := by
  unfold Expr.toVal
  rw [dif_pos (isValB_of_isVal v.2)]

/-- The body of a λ, a term otherwise itself. -/
def Expr.lamBody : Expr → Expr
  | .lam b => b
  | e => e

theorem Expr.lamBody_lam (b : Expr) : Expr.lamBody ((.val (.lam b)) : Expr) = b := rfl

/-- `[let-poly]`'s body, from its premise's term `eN` (the copy, under the bound slot) and the
λ-value `eV`: the copy with the slot dropped and the λ-value's occurrences replaced by the bound
variable (`Expr.unfill`). -/
def Expr.letBody (eN eV : Expr) : Expr := (eN.subst 0 Val.unit).unfill (Expr.lamBody eV) 0

theorem Expr.letBody_shift (M b : Expr) :
    Expr.letBody (M.shift 1 0) ((.val (.lam b)) : Expr) = M.unfill b 0 := by
  simp only [Expr.letBody, subst_shift_one]
  rfl

/-- **The typed term**: one node per rule application of the checked derivation.  `[spec §3]` -/
inductive TExpr where
--@TEXPR_CTORS@
  /-- **Derived**: the destructor of `A` (`dtorE`, SPEC §12), a finaliser or a drop. -/
  | dtor (info : TInfo) (jdg : Jdg) (A : VTy)
  /-- **Derived**: a block's allocation at the shape `σ` (`allocS`, SPEC §5). -/
  | allocS (info : TInfo) (jdg : Jdg) (σ : Shape)
  /-- **Derived**: a block's release at the shape `σ` (`freeS`, SPEC §5). -/
  | freeS (info : TInfo) (jdg : Jdg) (σ : Shape)
  /-- **Derived**: a block borrow at the shape `σ`, `mut`, at the lifetime `c`, its result `T`
  (`withborS`, SPEC §5). -/
  | withborSM (info : TInfo) (jdg : Jdg) (σ : Shape) (c : LifeVar) (T : VTy)
  /-- **Derived**: a block borrow at the shape `σ`, `imm`. -/
  | withborSI (info : TInfo) (jdg : Jdg) (σ : Shape) (c : LifeVar) (T : VTy)
  /-- **Derived**: a family's borrow at two lifetimes, `mut` (`withborF2`, SPEC §5). -/
  | withborF2M (info : TInfo) (jdg : Jdg) (c x y : LifeVar) (A B T : VTy)
  /-- **Derived**: a family's borrow at two lifetimes, `imm`. -/
  | withborF2I (info : TInfo) (jdg : Jdg) (c x y : LifeVar) (A B T : VTy)
  /-- **Derived**: a string literal's table at the bytes `bs` (`litFnE`), over its typed term. -/
  | litFn (info : TInfo) (jdg : Jdg) (bs : List Nat) (t : TExpr)
  /-- **Derived**: a division by the literal `c` by the host operation `op` at which it cannot
  fail (`divLitB`, `safeDivB`), over its typed term. -/
  | divLit (info : TInfo) (jdg : Jdg) (op : HostOp) (c : IntLit) (t : TExpr)
  /-- **Derived**: a counted walk of a view, `mut` when `m` (`walkB`), over its typed term; `read`
  when its step reads its view at its index (`walkReadB`, SPEC §46). -/
  | walk (info : TInfo) (jdg : Jdg) (m read : Bool) (t : TExpr)
  /-- **Derived**: a counted walk's read of its view at its index (`walkGetB`), over its typed term.
  `[spec §46]` -/
  | walkGet (info : TInfo) (jdg : Jdg) (m : Bool) (t : TExpr)
  /-- **Derived**: a recursive group's self-reference read to call member `j` of `n`
  (`selfCallB`), over its typed term. -/
  | selfCall (info : TInfo) (jdg : Jdg) (j n : Nat) (t : TExpr)
  /-- **Derived**: the lend of a cell allocated for it, `mut` when `m` (`lendCellB`), over its
  typed term. -/
  | lendCell (info : TInfo) (jdg : Jdg) (m : Bool) (t : TExpr)
  /-- **Derived**: codata written as the η-thunk of an observation of `f s` (of `f`, with no `s`)
  (`nuEtaB`), over its typed term.  `[spec §45]` -/
  | nuEta (info : TInfo) (jdg : Jdg) (f : Nat) (s : Option Nat) (t : TExpr)
  /-- A use of the `def` `name`, the declaration `decl` of the program, at the type arguments
  `targs`: its body `t`, at the use's context, and the body's absorption `ab`. -/
  | use (info : TInfo) (jdg : Jdg) (name : String) (decl : Nat) (targs : List VTy) (ab : Option AbsF)
      (t : TExpr)

/-- **The erasure**: the term the node's rule concludes with. -/
def TExpr.erase : TExpr → Expr
--@ERASE_CASES@
  | .dtor _ _ A => dtorE A
  | .allocS _ _ σ => BoCa.Fig16.LogRel.Core.allocS σ
  | .freeS _ _ σ => BoCa.Fig16.LogRel.Core.freeS σ
  | .withborSM _ _ σ _ _ | .withborSI _ _ σ _ _ => withborS σ
  | .withborF2M .. | .withborF2I .. => withborF2
  | .litFn _ _ _ t => t.erase
  | .divLit _ _ _ _ t | .walk _ _ _ _ t | .walkGet _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t | .nuEta _ _ _ _ t => t.erase
  | .use _ _ _ _ _ _ t => t.erase

/-- The node's source. -/
def TExpr.info : TExpr → TInfo
--@INFO_CASES@
  | .dtor i _ _ | .allocS i _ _ | .freeS i _ _ | .withborSM i _ _ _ _ | .withborSI i _ _ _ _
  | .withborF2M i _ _ _ _ _ _ _ | .withborF2I i _ _ _ _ _ _ _ | .litFn i _ _ _ => i
  | .divLit i _ _ _ _ | .walk i _ _ _ _ | .walkGet i _ _ _ | .selfCall i _ _ _ _ | .lendCell i _ _ _ | .nuEta i _ _ _ _ => i
  | .use i _ _ _ _ _ _ => i

/-- The node's judgment. -/
def TExpr.jdg : TExpr → Jdg
--@JDG_CASES@
  | .dtor _ j _ | .allocS _ j _ | .freeS _ j _ | .withborSM _ j _ _ _ | .withborSI _ j _ _ _
  | .withborF2M _ j _ _ _ _ _ _ | .withborF2I _ j _ _ _ _ _ _ | .litFn _ j _ _ => j
  | .divLit _ j _ _ _ | .walk _ j _ _ _ | .walkGet _ j _ _ | .selfCall _ j _ _ _ | .lendCell _ j _ _ | .nuEta _ j _ _ _ => j
  | .use _ j _ _ _ _ _ => j

/-- How a child's context is formed from its node's, as the child's premise has it. -/
inductive TScope where
  /-- The node's context, or a part of a split of it, with `n` slots pushed: the binders. -/
  | push (n : Nat)
  /-- A context of `n` slots of the child's own (`letPoly`'s value, R1's callback). -/
  | fresh (n : Nat)
  deriving DecidableEq, Repr, Inhabited

/-- The node's children, in the rule's order, each with the context its premise is at. -/
def TExpr.children : TExpr → List (TScope × TExpr)
--@CHILDREN_CASES@
  | .dtor .. | .allocS .. | .freeS .. | .withborSM .. | .withborSI .. | .withborF2M ..
  | .withborF2I .. => []
  | .litFn _ _ _ t => [(.push 0, t)]
  | .divLit _ _ _ _ t | .walk _ _ _ _ t | .walkGet _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t | .nuEta _ _ _ _ t => [(.push 0, t)]
  | .use _ _ _ _ _ _ t => [(.push 0, t)]

/-- The use masks of a node at a split: its two parts' (`Masks`). -/
def TExpr.masks? : TExpr → Option Masks
--@MASKS_CASES@
  | _ => none

/-- Whether the node erases to a `λ` (`thunkv N`'s premise): read off the rule's term where its
head is a constructor, and through the child where the rule keeps its premise's term, so that the
erasure is computed only where the rule's term is a definition's. -/
def TExpr.isLam : TExpr → Bool
--@ISLAM_CASES@
  | .dtor _ _ A => (dtorE A matches .lam _)
  | .allocS _ _ σ => (BoCa.Fig16.LogRel.Core.allocS σ matches .lam _)
  | .freeS _ _ σ => (BoCa.Fig16.LogRel.Core.freeS σ matches .lam _)
  | .withborSM _ _ σ _ _ | .withborSI _ _ σ _ _ => (withborS σ matches .lam _)
  | .withborF2M .. | .withborF2I .. => (withborF2 matches .lam _)
  | .litFn _ _ _ t => t.isLam
  | .divLit _ _ _ _ t | .walk _ _ _ _ t | .walkGet _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t | .nuEta _ _ _ _ t => t.isLam
  | .use _ _ _ _ _ _ t => t.isLam

/-- `isLam` is the erasure's head. -/
theorem TExpr.isLam_eq : ∀ (t : TExpr), t.isLam = (t.erase matches .lam _)
--@ISLAM_EQ@
  | .dtor .. | .allocS .. | .freeS .. | .withborSM .. | .withborSI .. | .withborF2M ..
  | .withborF2I .. => rfl
  | .litFn _ _ _ t => isLam_eq t
  | .divLit _ _ _ _ t | .walk _ _ _ _ t | .walkGet _ _ _ t | .selfCall _ _ _ _ t | .lendCell _ _ _ t | .nuEta _ _ _ _ t => isLam_eq t
  | .use _ _ _ _ _ _ t => isLam_eq t

theorem TExpr.isLam_sound (t : TExpr) (h : t.isLam = true) : ∃ N, t.erase = .val (.lam N) := by
  rw [isLam_eq] at h
  match he : t.erase, h with
  | .lam N, _ => exact ⟨N, rfl⟩

end BoCa.Fig16.LogRel.Core.Check
